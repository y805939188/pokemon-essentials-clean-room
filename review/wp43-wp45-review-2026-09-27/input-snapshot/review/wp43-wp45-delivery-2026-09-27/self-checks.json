          "expected": "清为空后恢复青草−1；通知调用分别为能力3批、道具2批，不保证每批都有实际效果"
        },
        {
          "id": "T03",
          "input": "默认青草、临时电气2；铁滚轮直接移除",
          "expected": "当前无、期限仍2；后两次变1、0，均不恢复默认；没有自然到期通知链"
        },
        {
          "id": "T04",
          "input": "飞行型携有效铁球／半无敌的接地者",
          "expected": "前者可受场地；后者仍不受；只问“是否飞行型”不足以替代查询"
        },
        {
          "id": "F01",
          "input": "重力0→建立；场上飞空且未行动成员",
          "expected": "重力5；该飞空状态清除并清未动选择；磁浮／意念移物／天空摔投相关状态被解除；重复制重力失败不刷新"
        },
        {
          "id": "F02",
          "input": "戏法／奇妙／魔法空间计数2，再对应招式",
          "expected": "直接变0，不刷新5；魔法空间自然2→1→0会检查场地道具，直接取消无同一显式通知"
        },
        {
          "id": "F03",
          "input": "新式全场玩水5，创建者换下；旧式成员玩水真对照",
          "expected": "新式仍5并按回合递减；旧式该成员初始化时清，不能由换下清所有全场值"
        },
        {
          "id": "S01",
          "input": "反射壁5；光之黏土有效建立新光墙；极光幕建立后冰雹结束",
          "expected": "壁重复失败；光墙8；极光幕仍依自己的计时，不随冰雹即时清"
        },
        {
          "id": "S02",
          "input": "誓约火海4、可受间接伤害非火成员总HP160",
          "expected": "第一次4→3伤20→2；下一次2→1伤20→0并到期消息；火型／魔法防守对照不扣，但计时仍推进"
        },
        {
          "id": "S03",
          "input": "火海1，完整回合末",
          "expected": "较早减0无伤害；较后不再递减或发该结束消息"
        },
        {
          "id": "S04",
          "input": "本方撒菱2、对方光墙3／幸运咒语4，换场",
          "expected": "撒菱2与光墙3换侧，幸运咒语4原侧；两个被交换值都保留，不重新赋默认时长"
        },
        {
          "id": "S05",
          "input": "回声计数2、本轮未用→一次／两次使用，再尾清",
          "expected": "第一次计数3／Used真；第二次不加；尾保3清Used；下一轮不用→尾计数0"
        },
        {
          "id": "H01",
          "input": "接地、总HP120，无免疫，撒菱1/2/3",
          "expected": "名义15／20／30；相应扣HP并按当前剩余截断"
        },
        {
          "id": "H02",
          "input": "隐形岩，总HP101、岩相性2；无免疫",
          "expected": "名义25.25，HP入口四舍五入25；与撒菱的先整数商不同"
        },
        {
          "id": "H03",
          "input": "接地毒成员穿有效厚底靴、毒菱2",
          "expected": "吸收清0；非毒靴成员层数仍2且不施毒；漂浮毒成员层数仍2"
        },
        {
          "id": "H04",
          "input": "黏黏网、接地无靴、速度0阶／有效唱反调",
          "expected": "查询正常过时−1；唱反调情况下按WP44转＋1；侧网不被消耗"
        },
        {
          "id": "P01",
          "input": "创建者总HP101建立祈愿，随后换成缺HP继任者",
          "expected": "保存恢复量round(50.5)=51，计时2→1→0，治当前位置成员，按其HP上限截断"
        },
        {
          "id": "P02",
          "input": "祈愿到0时空位／不能治",
          "expected": "不回血、计数0不重试；辅助量和来源仍可留存"
        },
        {
          "id": "P03",
          "input": "治愈之愿真，完全健康但缺PP；新月舞真对照",
          "expected": "当前世代前者保留；后者消费并回PP；旧世代无收益可消耗前者"
        },
        {
          "id": "P04",
          "input": "延迟攻击计数1，到期来源不能战斗／目标无人",
          "expected": "计数0，不攻击，辅助记录可保留；不是延期等待"
        },
        {
          "id": "P05",
          "input": "位置0祈愿1，Shift使另一成员到0；另测交换场地进入治愈之愿位置",
          "expected": "原位置0计时不换，当前占位者到期受益；Shift无即时恢复；交换场地会调用位置恢复、可即时消费治愈之愿"
        },
        {
          "id": "C01",
          "input": "目标闪避−6但有光墙／四危害／场地，世代8除雾",
          "expected": "不因不能降闪避整招失败；按§7.3具名范围清，场地只直接置无；顺风／幸运咒语不被泛清"
        }
