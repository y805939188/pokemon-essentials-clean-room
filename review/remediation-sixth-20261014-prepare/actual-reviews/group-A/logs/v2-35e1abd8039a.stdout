17:     SCHEMA = {
18:       "SectionName"         => [:id,                    "eV", :Species],
19:       "BackSprite"          => [:back_sprite,           "ii"],
20:       "FrontSprite"         => [:front_sprite,          "ii"],
21:       "FrontSpriteAltitude" => [:front_sprite_altitude, "i"],
