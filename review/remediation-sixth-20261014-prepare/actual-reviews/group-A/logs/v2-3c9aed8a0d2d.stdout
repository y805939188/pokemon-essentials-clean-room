522: # Runs a common event and waits until the common event is finished.
523: # Requires the script "Messages"
524: def pbCommonEvent(id)
525:   return false if id < 0
526:   ce = $data_common_events[id]
527:   return false if !ce
528:   celist = ce.list
529:   interp = Interpreter.new
530:   interp.setup(celist, 0)
531:   loop do
532:     Graphics.update
533:     Input.update
534:     interp.update
535:     pbUpdateSceneMap
536:     break unless interp.running?
537:   end
538:   return true
539: end
