276: ItemHandlers::UseInField.add(:OLDROD, proc { |item|
277:   notCliff = $game_map.passable?($game_player.x, $game_player.y, $game_player.direction, $game_player)
278:   if !$game_player.pbFacingTerrainTag.can_fish || (!$PokemonGlobal.surfing && !notCliff)
279:     pbMessage(_INTL("Can't use that here."))
280:     next false
281:   end
282:   encounter = $PokemonEncounters.has_encounter_type?(:OldRod)
283:   if pbFishing(encounter, 1)
284:     $stats.fishing_battles += 1
285:     pbEncounter(:OldRod)
286:   end
287:   next true
288: })
