1: #===============================================================================
2: # ** Interpreter
3: #-------------------------------------------------------------------------------
4: #  This interpreter runs event commands. This class is used within the
5: #  Game_System class and the Game_Event class.
6: #===============================================================================
7: class Interpreter
8:   #-----------------------------------------------------------------------------
9:   # * Event Command Execution
10:   #-----------------------------------------------------------------------------
11:   def execute_command
12:     # Reached end of list of commands
13:     if @index >= @list.size - 1
14:       command_end
15:       return true
16:     end
17:     # Make current command's parameters available for reference via @parameters
18:     @parameters = @list[@index].parameters
19:     # Branch by command code
20:     case @list[@index].code
21:     when 101 then return command_101   # Show Text
22:     when 102 then return command_102   # Show Choices
23:     when 402 then return command_402   # When [**]
24:     when 403 then return command_403   # When Cancel
25:     when 103 then return command_103   # Input Number
26:     when 104 then return command_104   # Change Text Options
27:     when 105 then return command_105   # Button Input Processing
28:     when 106 then return command_106   # Wait
29:     when 111 then return command_111   # Conditional Branch
30:     when 411 then return command_411   # Else
31:     when 112 then return command_112   # Loop
32:     when 413 then return command_413   # Repeat Above
33:     when 113 then return command_113   # Break Loop
34:     when 115 then return command_115   # Exit Event Processing
35:     when 116 then return command_116   # Erase Event
36:     when 117 then return command_117   # Call Common Event
37:     when 118 then return command_118   # Label
38:     when 119 then return command_119   # Jump to Label
39:     when 121 then return command_121   # Control Switches
40:     when 122 then return command_122   # Control Variables
41:     when 123 then return command_123   # Control Self Switch
42:     when 124 then return command_124   # Control Timer
43:     when 125 then return command_125   # Change Gold
44:     when 126 then return command_126   # Change Items
45:     when 127 then return command_127   # Change Weapons
46:     when 128 then return command_128   # Change Armor
47:     when 129 then return command_129   # Change Party Member
48:     when 131 then return command_131   # Change Windowskin
49:     when 132 then return command_132   # Change Battle BGM
50:     when 133 then return command_133   # Change Battle End ME
51:     when 134 then return command_134   # Change Save Access
52:     when 135 then return command_135   # Change Menu Access
53:     when 136 then return command_136   # Change Encounter
54:     when 201 then return command_201   # Transfer Player
55:     when 202 then return command_202   # Set Event Location
56:     when 203 then return command_203   # Scroll Map
57:     when 204 then return command_204   # Change Map Settings
58:     when 205 then return command_205   # Change Fog Color Tone
59:     when 206 then return command_206   # Change Fog Opacity
60:     when 207 then return command_207   # Show Animation
61:     when 208 then return command_208   # Change Transparent Flag
62:     when 209 then return command_209   # Set Move Route
63:     when 210 then return command_210   # Wait for Move's Completion
64:     when 221 then return command_221   # Prepare for Transition
65:     when 222 then return command_222   # Execute Transition
66:     when 223 then return command_223   # Change Screen Color Tone
67:     when 224 then return command_224   # Screen Flash
68:     when 225 then return command_225   # Screen Shake
69:     when 231 then return command_231   # Show Picture
70:     when 232 then return command_232   # Move Picture
71:     when 233 then return command_233   # Rotate Picture
72:     when 234 then return command_234   # Change Picture Color Tone
73:     when 235 then return command_235   # Erase Picture
74:     when 236 then return command_236   # Set Weather Effects
75:     when 241 then return command_241   # Play BGM
76:     when 242 then return command_242   # Fade Out BGM
77:     when 245 then return command_245   # Play BGS
78:     when 246 then return command_246   # Fade Out BGS
79:     when 247 then return command_247   # Memorize BGM/BGS
80:     when 248 then return command_248   # Restore BGM/BGS
81:     when 249 then return command_249   # Play ME
82:     when 250 then return command_250   # Play SE
83:     when 251 then return command_251   # Stop SE
84:     when 301 then return command_301   # Battle Processing
85:     when 601 then return command_601   # If Win
86:     when 602 then return command_602   # If Escape
87:     when 603 then return command_603   # If Lose
88:     when 302 then return command_302   # Shop Processing
89:     when 303 then return command_303   # Name Input Processing
90:     when 311 then return command_311   # Change HP
91:     when 312 then return command_312   # Change SP
92:     when 313 then return command_313   # Change State
93:     when 314 then return command_314   # Recover All
94:     when 315 then return command_315   # Change EXP
95:     when 316 then return command_316   # Change Level
96:     when 317 then return command_317   # Change Parameters
97:     when 318 then return command_318   # Change Skills
98:     when 319 then return command_319   # Change Equipment
99:     when 320 then return command_320   # Change Actor Name
100:     when 321 then return command_321   # Change Actor Class
101:     when 322 then return command_322   # Change Actor Graphic
102:     when 331 then return command_331   # Change Enemy HP
103:     when 332 then return command_332   # Change Enemy SP
104:     when 333 then return command_333   # Change Enemy State
105:     when 334 then return command_334   # Enemy Recover All
106:     when 335 then return command_335   # Enemy Appearance
107:     when 336 then return command_336   # Enemy Transform
108:     when 337 then return command_337   # Show Battle Animation
109:     when 338 then return command_338   # Deal Damage
110:     when 339 then return command_339   # Force Action
111:     when 340 then return command_340   # Abort Battle
112:     when 351 then return command_351   # Call Menu Screen
113:     when 352 then return command_352   # Call Save Screen
114:     when 353 then return command_353   # Game Over
115:     when 354 then return command_354   # Return to Title Screen
116:     when 355 then return command_355   # Script
117:     else          return true          # Other
118:     end
119:   end
120: 
121:   def command_dummy
122:     return true
123:   end
124: 
125:   #-----------------------------------------------------------------------------
126:   # * End Event
127:   #-----------------------------------------------------------------------------
128:   def command_end
129:     @list = nil
130:     end_follower_overrides
131:     # If main map event and event ID are valid, unlock event
132:     if @main && @event_id > 0 && $game_map.events[@event_id]
133:       $game_map.events[@event_id].unlock
134:     end
135:   end
