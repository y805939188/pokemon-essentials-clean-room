402: #===============================================================================
403: # Main message-displaying function
404: #===============================================================================
405: def pbMessageDisplay(msgwindow, message, letterbyletter = true, commandProc = nil)
406:   return if !msgwindow
407:   oldletterbyletter = msgwindow.letterbyletter
408:   msgwindow.letterbyletter = (letterbyletter) ? true : false
409:   ret = nil
410:   commands = nil
411:   facewindow = nil
412:   goldwindow = nil
413:   coinwindow = nil
414:   battlepointswindow = nil
415:   cmdvariable = 0
416:   cmdIfCancel = 0
417:   msgwindow.waitcount = 0
418:   autoresume = false
419:   text = message.clone
420:   linecount = (Graphics.height > 400) ? 3 : 2
421:   ### Text replacement
422:   text.gsub!(/\\sign\[([^\]]*)\]/i) do      # \sign[something] gets turned into
423:     next "\\op\\cl\\ts[]\\w[" + $1 + "]"    # \op\cl\ts[]\w[something]
424:   end
425:   text.gsub!(/\\\\/, "\5")
426:   text.gsub!(/\\1/, "\1")
427:   if $game_actors
428:     text.gsub!(/\\n\[([1-8])\]/i) { next $game_actors[$1.to_i].name }
429:   end
430:   text.gsub!(/\\pn/i,  $player.name) if $player
431:   text.gsub!(/\\pm/i,  _INTL("${1}", $player.money.to_s_formatted)) if $player
432:   text.gsub!(/\\n/i,   "\n")
433:   text.gsub!(/\\\[([0-9a-f]{8,8})\]/i) { "<c2=" + $1 + ">" }
434:   text.gsub!(/\\pg/i,  "\\b") if $player&.male?
435:   text.gsub!(/\\pg/i,  "\\r") if $player&.female?
436:   text.gsub!(/\\pog/i, "\\r") if $player&.male?
437:   text.gsub!(/\\pog/i, "\\b") if $player&.female?
438:   text.gsub!(/\\pg/i,  "")
439:   text.gsub!(/\\pog/i, "")
440:   male_text_tag = shadowc3tag(MessageConfig::MALE_TEXT_MAIN_COLOR, MessageConfig::MALE_TEXT_SHADOW_COLOR)
