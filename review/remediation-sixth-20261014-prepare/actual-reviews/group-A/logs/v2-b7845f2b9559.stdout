252: EventHandlers.add(:on_player_step_taken, :hatch_eggs,
253:   proc {
254:     $player.party.each do |egg|
255:       next if egg.steps_to_hatch <= 0
256:       egg.steps_to_hatch -= 1
257:       $player.pokemon_party.each do |pkmn|
258:         next if !pkmn.ability&.has_flag?("FasterEggHatching")
259:         egg.steps_to_hatch -= 1
260:         break
261:       end
262:       if egg.steps_to_hatch <= 0
263:         egg.steps_to_hatch = 0
264:         pbHatch(egg)
265:       end
266:     end
267:   }
268: )
