72:   def prepline(line)
73:     line.sub!(/\s*\#.*$/, "")
74:     line.sub!(/^\s+/, "")
75:     line.sub!(/\s+$/, "")
76:     return line
77:   end
78: 
79:   def csvQuote(str, always = false)
80:     return "" if nil_or_empty?(str)
81:     if always || str[/[,\"]/]   # || str[/^\s/] || str[/\s$/] || str[/^#/]
82:       str = str.gsub(/\"/, "\\\"")
83:       str = "\"#{str}\""
84:     end
85:     return str
86:   end
87: 
88:   def csvQuoteAlways(str)
89:     return csvQuote(str, true)
90:   end
