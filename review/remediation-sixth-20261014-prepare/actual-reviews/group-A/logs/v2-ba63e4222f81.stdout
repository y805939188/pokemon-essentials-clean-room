675: module MessageTypes
676:   # NOTE: These constants aren't numbered in any particular order, but these
677:   #       numbers are retained for backwards compatibility with older extracted
678:   #       text files.
679:   EVENT_TEXTS                  = 0   # Used for text in both common events and map events
680:   SPECIES_NAMES                = 1
681:   SPECIES_CATEGORIES           = 2
682:   POKEDEX_ENTRIES              = 3
683:   SPECIES_FORM_NAMES           = 4
684:   MOVE_NAMES                   = 5
685:   MOVE_DESCRIPTIONS            = 6
686:   ITEM_NAMES                   = 7
687:   ITEM_NAME_PLURALS            = 8
688:   ITEM_DESCRIPTIONS            = 9
689:   ABILITY_NAMES                = 10
690:   ABILITY_DESCRIPTIONS         = 11
691:   TYPE_NAMES                   = 12
692:   TRAINER_TYPE_NAMES           = 13
693:   TRAINER_NAMES                = 14
694:   FRONTIER_INTRO_SPEECHES      = 15
695:   FRONTIER_END_SPEECHES_WIN    = 16
696:   FRONTIER_END_SPEECHES_LOSE   = 17
697:   REGION_NAMES                 = 18
698:   REGION_LOCATION_NAMES        = 19
699:   REGION_LOCATION_DESCRIPTIONS = 20
700:   MAP_NAMES                    = 21
701:   PHONE_MESSAGES               = 22
702:   TRAINER_SPEECHES_LOSE        = 23
703:   SCRIPT_TEXTS                 = 24
704:   RIBBON_NAMES                 = 25
705:   RIBBON_DESCRIPTIONS          = 26
706:   STORAGE_CREATOR_NAME         = 27
707:   ITEM_PORTION_NAMES           = 28
708:   ITEM_PORTION_NAME_PLURALS    = 29
709:   POKEMON_NICKNAMES            = 30
710:   @@messages = Translation.new
