772: # Replaces first argument with a localized version and formats the other
773: # parameters by replacing {1}, {2}, etc. with those placeholders.
774: def _INTL(*arg)
775:   begin
776:     string = MessageTypes.getFromHash(MessageTypes::SCRIPT_TEXTS, arg[0])
777:   rescue
778:     string = arg[0]
779:   end
780:   string = string.clone
781:   (1...arg.length).each do |i|
782:     string.gsub!(/\{#{i}\}/, arg[i].to_s)
783:   end
784:   return string
785: end
786: 
787: # Replaces first argument with a localized version and formats the other
788: # parameters by replacing {1}, {2}, etc. with those placeholders.
789: # This version acts more like sprintf, supports e.g. {1:d} or {2:s}
790: def _ISPRINTF(*arg)
791:   begin
792:     string = MessageTypes.getFromHash(MessageTypes::SCRIPT_TEXTS, arg[0])
793:   rescue
794:     string = arg[0]
795:   end
796:   string = string.clone
797:   (1...arg.length).each do |i|
798:     string.gsub!(/\{#{i}\:([^\}]+?)\}/) { |m| next sprintf("%" + $1, arg[i]) }
799:   end
800:   return string
801: end
802: 
803: def _I(str, *arg)
804:   return _MAPINTL($game_map.map_id, str, *arg)
805: end
806: 
807: def _MAPINTL(mapid, *arg)
808:   string = MessageTypes.getFromMapHash(mapid, arg[0])
809:   string = string.clone
810:   (1...arg.length).each do |i|
811:     string.gsub!(/\{#{i}\}/, arg[i].to_s)
812:   end
813:   return string
814: end
815: 
816: def _MAPISPRINTF(mapid, *arg)
817:   string = MessageTypes.getFromMapHash(mapid, arg[0])
818:   string = string.clone
819:   (1...arg.length).each do |i|
820:     string.gsub!(/\{#{i}\:([^\}]+?)\}/) { |m| next sprintf("%" + $1, arg[i]) }
821:   end
822:   return string
823: end
