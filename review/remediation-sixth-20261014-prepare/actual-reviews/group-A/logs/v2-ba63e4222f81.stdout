589:   def get(type, id)
590:     delayed_load_message_files
591:     if @game_messages && @game_messages[type] && @game_messages[type][id]
592:       return @game_messages[type][id]
593:     end
594:     if @core_messages && @core_messages[type] && @core_messages[type][id]
595:       return @core_messages[type][id]
596:     end
597:     return ""
598:   end
599: 
600:   def getFromHash(type, text)
601:     delayed_load_message_files
602:     key = Translation.stringToKey(text)
603:     return text if nil_or_empty?(key)
604:     if @game_messages && @game_messages[type] && @game_messages[type][key]
605:       return @game_messages[type][key]
606:     end
607:     if @core_messages && @core_messages[type] && @core_messages[type][key]
608:       return @core_messages[type][key]
609:     end
610:     return text
611:   end
612: 
613:   def getFromMapHash(map_id, text)
614:     delayed_load_message_files
615:     key = Translation.stringToKey(text)
616:     return text if nil_or_empty?(key)
617:     if @game_messages && @game_messages[MessageTypes::EVENT_TEXTS]
618:       if @game_messages[MessageTypes::EVENT_TEXTS][map_id] && @game_messages[MessageTypes::EVENT_TEXTS][map_id][key]
619:         return @game_messages[MessageTypes::EVENT_TEXTS][map_id][key]
620:       elsif @game_messages[MessageTypes::EVENT_TEXTS][0] && @game_messages[MessageTypes::EVENT_TEXTS][0][key]
621:         return @game_messages[MessageTypes::EVENT_TEXTS][0][key]
622:       end
623:     end
624:     if @core_messages && @core_messages[MessageTypes::EVENT_TEXTS]
625:       if @core_messages[MessageTypes::EVENT_TEXTS][map_id] && @core_messages[MessageTypes::EVENT_TEXTS][map_id][key]
626:         return @core_messages[MessageTypes::EVENT_TEXTS][map_id][key]
627:       elsif @core_messages[MessageTypes::EVENT_TEXTS][0] && @core_messages[MessageTypes::EVENT_TEXTS][0][key]
628:         return @core_messages[MessageTypes::EVENT_TEXTS][0][key]
629:       end
630:     end
631:     return text
632:   end
633: 
634:   #-----------------------------------------------------------------------------
635: 
636:   private
637: 
638:   def delayed_load_message_files
639:     return if !@filename || @core_messages
640:     load_message_files(@filename)
641:     @filename = nil
642:   end
643: 
644:   def priv_add_to_array(type, array, ret)
645:     @default_core_messages[type] ||= []
646:     ret = [] if !ret
647:     array.each_with_index do |text, i|
648:       ret[i] = text if !nil_or_empty?(text) && @default_core_messages[type][i] != text
649:     end
650:     return ret
651:   end
652: 
653:   def priv_add_to_hash(type, array, ret, map_id = 0)
654:     if type == MessageTypes::EVENT_TEXTS
655:       @default_core_messages[type] ||= []
656:       @default_core_messages[type][map_id] ||= {}
657:       default_keys = @default_core_messages[type][map_id].keys
658:     else
659:       @default_core_messages[type] ||= {}
660:       default_keys = @default_core_messages[type].keys
661:     end
662:     ret = {} if !ret
663:     array.each do |text|
664:       next if !text
665:       key = Translation.stringToKey(text)
666:       ret[key] = text if !default_keys.include?(key)
667:     end
668:     return ret
669:   end
670: end
