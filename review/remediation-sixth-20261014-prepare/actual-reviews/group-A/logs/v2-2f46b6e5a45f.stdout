122:     @msgBox.baseColor   = TEXT_BASE_COLOR
123:     @msgBox.shadowColor = TEXT_SHADOW_COLOR
124:     @msgBox.windowskin  = nil
125:     addSprite("msgBox", @msgBox)
126:     if USE_GRAPHICS
127:       # Create background graphic
128:       background = IconSprite.new(self.x, self.y, viewport)
129:       background.setBitmap("Graphics/UI/Battle/overlay_command")
130:       addSprite("background", background)
131:       # Create bitmaps
132:       @buttonBitmap = AnimatedBitmap.new(_INTL("Graphics/UI/Battle/cursor_command"))
133:       # Create action buttons
134:       @buttons = Array.new(4) do |i|   # 4 command options, therefore 4 buttons
135:         button = Sprite.new(viewport)
136:         button.bitmap = @buttonBitmap.bitmap
137:         button.x = self.x + Graphics.width - 260
138:         button.x += (i.even? ? 0 : (@buttonBitmap.width / 2) - 4)
139:         button.y = self.y + 6
140:         button.y += (((i / 2) == 0) ? 0 : BUTTON_HEIGHT - 4)
141:         button.src_rect.width  = @buttonBitmap.width / 2
142:         button.src_rect.height = BUTTON_HEIGHT
143:         addSprite("button_#{i}", button)
144:         next button
145:       end
146:     else
147:       # Create command window (shows Fight/Bag/Pokémon/Run)
148:       @cmdWindow = Window_CommandPokemon.newWithSize(
149:         [], self.x + Graphics.width - 240, self.y, 240, Graphics.height - self.y, viewport
150:       )
