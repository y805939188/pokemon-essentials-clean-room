nimum_counterexample":[{"raw_id":"RUN-A-022","report":"agents/A/A-03/findings.json","value":{"premises":["无插件；UNOWN基形态0、合法等级；启用创建复检；所需数据和玩家/图鉴依赖有效，所有回调正常返回。","两次静态对照的六IV与personalID随机结果相同，环境和其它输入相同；仅创建处理器的后续随机结果分别为0和1。"],"input_and_static_expectation":["两次创建返回形态分别为0和1；还存在第三类生成期随机输入。","关闭复检或不存在额外随机回调时，基础初始化仍只有所列IV与personalID两类。"],"execution":"NOT_EXECUTED_STATIC_DERIVATION"}},{"raw_id":"RUN-D-009","report":"agents/D/findings.json","value":["把WP18的只有两类作为完整创建合同，所有其它创建结果由PID/IV和上下文确定，不另作形态随机抽样。","按WP21正常创建复检，对具名物种另取随机形态；创建合同必须包含该随机输入。"]}],"evidence_limits":"Static text/data/caller or audit evidence only; runtime observations=0, proven demo event chains=0. Reading-log ranges are navigation, not branch coverage.","extension_decisions":[]},"qualification_details_binding":{"commit":"c2bc1a341ba6acdf7c8c111dc88d39a162a093d6","path":"review/remediation/20261003-prepare/FINAL-1/independent-review-cloud-20261011-1/all229-dispositions.json","pointer":"/records/23"},"reuse_boundary":"Identity and qualified original control only; no historical semantic verdict transfer."}}
