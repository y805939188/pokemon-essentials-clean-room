行/真实Demo/宿主与插件组合未证边界"]}],"premises":[{"raw_id":"RUN-C-114","report":"agents/C/C-06/findings.json","value":["默认参数、合法素材和场景、无提前确认，时间按固定名义值；真实宿主呈现未运行。"]}],"minimum_counterexample":[{"raw_id":"RUN-C-114","report":"agents/C/C-06/findings.json","value":"T01一张完整开场名义2.8秒而非2秒总时长；帮助换页中第0.25秒确认不会再推进一页。标题40tick并非40个宿主渲染帧。"}],"evidence_limits":"Static text/data/caller or audit evidence only; runtime observations=0, proven demo event chains=0. Reading-log ranges are navigation, not branch coverage.","extension_decisions":[]},"qualification_details_binding":{"commit":"c2bc1a341ba6acdf7c8c111dc88d39a162a093d6","path":"review/remediation/20261003-prepare/FINAL-1/independent-review-cloud-20261011-1/all229-dispositions.json","pointer":"/records/203"},"reuse_boundary":"Identity and qualified original control only; no historical semantic verdict transfer."}}
