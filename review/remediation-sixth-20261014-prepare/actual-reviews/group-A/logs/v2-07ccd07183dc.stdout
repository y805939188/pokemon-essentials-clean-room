738: #===============================================================================
739: # Buying a prize item from the Game Corner
740: #===============================================================================
741: def pbBuyPrize(item, quantity = 1)
742:   item = GameData::Item.get(item)
743:   return false if !item || quantity < 1
744:   item_name = (quantity > 1) ? item.portion_name_plural : item.portion_name
745:   pocket = item.pocket
746:   return false if !$bag.add(item, quantity)
747:   pbMessage("\\CN" + _INTL("You put the {1} in\\nyour Bag's <icon=bagPocket{2}>\\c[1]{3}\\c[0] pocket.",
748:                            item_name, pocket, PokemonBag.pocket_names[pocket - 1]))
749:   return true
750: end
