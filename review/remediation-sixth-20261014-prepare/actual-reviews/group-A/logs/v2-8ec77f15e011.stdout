38:     extend ClassMethodsSymbols
39:     include InstanceMethods
40: 
41:     def initialize(hash)
42:       @id               = hash[:id]
43:       @real_name        = hash[:real_name]        || "Unnamed"
44:       @type             = hash[:type]             || :NONE
45:       @category         = hash[:category]         || 2
46:       @power            = hash[:power]            || 0
47:       @accuracy         = hash[:accuracy]         || 100
48:       @total_pp         = hash[:total_pp]         || 5
49:       @target           = hash[:target]           || :None
50:       @priority         = hash[:priority]         || 0
51:       @function_code    = hash[:function_code]    || "None"
52:       @flags            = hash[:flags]            || []
53:       @flags            = [@flags] if !@flags.is_a?(Array)
54:       @effect_chance    = hash[:effect_chance]    || 0
55:       @real_description = hash[:real_description] || "???"
56:       @pbs_file_suffix  = hash[:pbs_file_suffix]  || ""
57:     end
58: 
59:     # @deprecated This method is slated to be removed in v22.
60:     def base_damage
61:       Deprecation.warn_method("base_damage", "v22", "power")
62:       return @power
63:     end
64: 
65:     # @return [String] the translated name of this move
66:     def name
67:       return pbGetMessageFromHash(MessageTypes::MOVE_NAMES, @real_name)
68:     end
69: 
70:     # @return [String] the translated description of this move
71:     def description
72:       return pbGetMessageFromHash(MessageTypes::MOVE_DESCRIPTIONS, @real_description)
73:     end
74: 
75:     def has_flag?(flag)
76:       return @flags.any? { |f| f.downcase == flag.downcase }
77:     end
78: 
79:     def physical?
80:       return false if @power == 0
81:       return @category == 0 if Settings::MOVE_CATEGORY_PER_MOVE
82:       return GameData::Type.get(@type).physical?
83:     end
84: 
85:     def special?
86:       return false if @power == 0
87:       return @category == 1 if Settings::MOVE_CATEGORY_PER_MOVE
88:       return GameData::Type.get(@type).special?
89:     end
90: 
91:     def damaging?
92:       return @category != 2
93:     end
94: 
95:     def status?
96:       return @category == 2
97:     end
98: 
99:     def hidden_move?
100:       GameData::Item.each do |i|
101:         return true if i.is_HM? && i.move == @id
102:       end
103:       return false
104:     end
105: 
