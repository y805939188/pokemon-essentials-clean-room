136: 
137:   # Used for types.txt, abilities.txt, moves.txt, items.txt, berry_plants.txt,
138:   # pokemon.txt, pokemon_forms.txt, pokemon_metrics.txt, shadow_pokemon.txt,
139:   # ribbons.txt, trainer_types.txt, battle_facility_lists.txt, Battle Tower
140:   # trainers PBS files and dungeon_parameters.txt
141:   def pbEachFileSection(f, schema = nil)
142:     pbEachFileSectionEx(f, schema) do |section, name|
143:       yield section, name if block_given? && name[/^.+$/]
144:     end
145:   end
146: 
147:   # Used for metadata.txt and map_metadata.txt
148:   def pbEachFileSectionNumbered(f, schema = nil)
149:     pbEachFileSectionEx(f, schema) do |section, name|
150:       yield section, name.to_i if block_given? && name[/^\d+$/]
151:     end
152:   end
153: 
154:   # Used by translated text compiler
155:   def pbEachSection(f)
156:     lineno      = 1
157:     havesection = false
158:     sectionname = nil
159:     lastsection = []
160:     f.each_line do |line|
161:       if lineno == 1 && line[0].ord == 0xEF && line[1].ord == 0xBB && line[2].ord == 0xBF
162:         line = line[3, line.length - 3]
163:       end
164:       line.force_encoding(Encoding::UTF_8)
165:       if !line[/^\#/] && !line[/^\s*$/]
166:         if line[/^\s*\[\s*(.+?)\s*\]\s*$/]
167:           yield lastsection, sectionname if havesection
168:           lastsection.clear
169:           sectionname = $~[1]
170:           havesection = true
171:         else
172:           if sectionname.nil?
173:             raise _INTL("Expected a section at the beginning of the file (line {1}). Sections begin with '[name of section]'.", lineno)
174:           end
175:           lastsection.push(line.strip)
176:         end
177:       end
178:       lineno += 1
179:       Graphics.update if lineno % 500 == 0
180:     end
181:     yield lastsection, sectionname if havesection
182:   end
