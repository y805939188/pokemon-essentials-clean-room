197:   # Used for town_map.txt and Battle Tower Pokémon PBS files
198:   def pbCompilerEachCommentedLine(filename)
199:     File.open(filename, "rb") do |f|
200:       FileLineData.file = filename
201:       lineno = 1
202:       f.each_line do |line|
203:         if lineno == 1 && line[0].ord == 0xEF && line[1].ord == 0xBB && line[2].ord == 0xBF
204:           line = line[3, line.length - 3]
205:         end
206:         line.force_encoding(Encoding::UTF_8)
207:         if !line[/^\#/] && !line[/^\s*$/]
208:           FileLineData.setLine(line, lineno)
209:           yield line, lineno
210:         end
211:         lineno += 1
212:       end
213:     end
214:   end
