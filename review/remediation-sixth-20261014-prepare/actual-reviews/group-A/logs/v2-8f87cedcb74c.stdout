244:   def validate_all_compiled_items
245:     # Get item names/descriptions for translating
246:     item_names = []
247:     item_names_plural = []
248:     item_portion_names = []
249:     item_portion_names_plural = []
250:     item_descriptions = []
251:     GameData::Item.each do |item|
252:       item_names.push(item.real_name)
253:       item_names_plural.push(item.real_name_plural)
254:       item_portion_names.push(item.real_portion_name)
255:       item_portion_names_plural.push(item.real_portion_name_plural)
256:       item_descriptions.push(item.real_description)
