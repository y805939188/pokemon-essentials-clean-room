205:   def compile_moves(*paths)
206:     compile_PBS_file_generic(GameData::Move, *paths) do |final_validate, hash|
207:       (final_validate) ? validate_all_compiled_moves : validate_compiled_move(hash)
208:     end
209:   end
210: 
211:   def validate_compiled_move(hash)
212:     if (hash[:category] || 2) == 2 && (hash[:power] || 0) != 0
213:       raise _INTL("Move {1} is defined as a Status move with a non-zero base damage.", hash[:real_name]) + "\n" + FileLineData.linereport
214:     elsif (hash[:category] || 2) != 2 && (hash[:power] || 0) == 0
215:       print _INTL("Warning: Move {1} is defined as Physical or Special but has a base damage of 0. Changing it to a Status move.", hash[:real_name]) + "\n" + FileLineData.linereport
216:       hash[:category] = 2
217:     end
218:   end
219: 
220:   def validate_all_compiled_moves
221:     # Get move names/descriptions for translating
222:     move_names = []
223:     move_descriptions = []
224:     GameData::Move.each do |move|
225:       move_names.push(move.real_name)
226:       move_descriptions.push(move.real_description)
227:     end
228:     MessageTypes.setMessagesAsHash(MessageTypes::MOVE_NAMES, move_names)
229:     MessageTypes.setMessagesAsHash(MessageTypes::MOVE_DESCRIPTIONS, move_descriptions)
230:   end
