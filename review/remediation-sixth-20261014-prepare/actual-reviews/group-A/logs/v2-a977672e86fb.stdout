478: class Translation
479:   attr_reader :core_messages, :game_messages
480: 
481:   def self.stringToKey(str)
482:     if str && str[/[\r\n\t\1]|^\s+|\s+$|\s{2,}/]
483:       key = str.clone
484:       key.gsub!(/^\s+/, "")
485:       key.gsub!(/\s+$/, "")
486:       key.gsub!(/\s{2,}/, " ")
487:       return key
488:     end
489:     return str
490:   end
491: 
492:   def initialize(filename = nil, delay_load = false)
493:     @default_core_messages = nil
494:     @default_game_messages = nil
495:     @core_messages = nil   # A translation file
496:     @game_messages = nil   # A translation file
497:     @filename = filename
498:     load_message_files(@filename) if @filename && !delay_load
499:   end
500: 
501:   def default_core_messages
502:     load_default_messages
503:     return @default_core_messages
504:   end
505: 
506:   def default_game_messages
507:     load_default_messages
508:     return @default_game_messages
509:   end
510: 
511:   def load_message_files(filename)
512:     @core_messages = nil
513:     @game_messages = nil
514:     begin
515:       core_filename = sprintf("Data/messages_%s_core.dat", filename)
516:       if FileTest.exist?(core_filename)
517:         @core_messages = load_data(core_filename)
518:         @core_messages = nil if !@core_messages.is_a?(Array)
519:       end
520:       game_filename = sprintf("Data/messages_%s_game.dat", filename)
521:       if FileTest.exist?(game_filename)
522:         @game_messages = load_data(game_filename)
523:         @game_messages = nil if !@game_messages.is_a?(Array)
524:       end
525:     rescue
526:       @core_messages = nil
527:       @game_messages = nil
528:     end
529:   end
530: 
531:   def load_default_messages
532:     return if @default_core_messages
533:     begin
534:       if FileTest.exist?("Data/messages_core.dat")
535:         pbRgssOpen("Data/messages_core.dat", "rb") { |f| @default_core_messages = Marshal.load(f) }
536:       end
537:       @default_core_messages = [] if !@default_core_messages.is_a?(Array)
538:       if FileTest.exist?("Data/messages_game.dat")
539:         pbRgssOpen("Data/messages_game.dat", "rb") { |f| @default_game_messages = Marshal.load(f) }
540:       end
541:       @default_game_messages = [] if !@default_game_messages.is_a?(Array)
542:     rescue
543:       @default_core_messages = []
544:       @default_game_messages = []
545:     end
546:   end
547: 
548:   def save_default_messages
549:     File.open("Data/messages_core.dat", "wb") { |f| Marshal.dump(@default_core_messages, f) }
550:     File.open("Data/messages_game.dat", "wb") { |f| Marshal.dump(@default_game_messages, f) }
