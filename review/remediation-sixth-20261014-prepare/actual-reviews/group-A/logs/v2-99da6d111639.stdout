165:     def self.each_species
166:       DATA.each_value { |species| yield species if species.form == 0 }
167:     end
168: 
169:     def self.species_count
170:       ret = 0
171:       self.each_species { |species| ret += 1 }
172:       return ret
173:     end
174: 
175:     def initialize(hash)
176:       @id                 = hash[:id]
177:       @species            = hash[:species]            || @id
178:       @form               = hash[:form]               || 0
179:       @real_name          = hash[:real_name]          || "Unnamed"
180:       @real_form_name     = hash[:real_form_name]
181:       @real_category      = hash[:real_category]      || "???"
182:       @real_pokedex_entry = hash[:real_pokedex_entry] || "???"
183:       @pokedex_form       = hash[:pokedex_form]       || @form
184:       @types              = hash[:types]              || [:NORMAL]
185:       @base_stats         = hash[:base_stats]         || {}
186:       @evs                = hash[:evs]                || {}
187:       GameData::Stat.each_main do |s|
188:         @base_stats[s.id] = 1 if !@base_stats[s.id] || @base_stats[s.id] <= 0
189:         @evs[s.id]        = 0 if !@evs[s.id] || @evs[s.id] < 0
190:       end
191:       @base_exp           = hash[:base_exp]           || 100
192:       @growth_rate        = hash[:growth_rate]        || :Medium
193:       @gender_ratio       = hash[:gender_ratio]       || :Female50Percent
194:       @catch_rate         = hash[:catch_rate]         || 255
195:       @happiness          = hash[:happiness]          || 70
196:       @moves              = hash[:moves]              || []
197:       @tutor_moves        = hash[:tutor_moves]        || []
198:       @egg_moves          = hash[:egg_moves]          || []
199:       @abilities          = hash[:abilities]          || []
200:       @hidden_abilities   = hash[:hidden_abilities]   || []
201:       @wild_item_common   = hash[:wild_item_common]   || []
202:       @wild_item_uncommon = hash[:wild_item_uncommon] || []
203:       @wild_item_rare     = hash[:wild_item_rare]     || []
204:       @egg_groups         = hash[:egg_groups]         || [:Undiscovered]
205:       @hatch_steps        = hash[:hatch_steps]        || 1
206:       @incense            = hash[:incense]
207:       @offspring          = hash[:offspring]          || []
208:       @evolutions         = hash[:evolutions]         || []
209:       @height             = hash[:height]             || 1
210:       @weight             = hash[:weight]             || 1
211:       @color              = hash[:color]              || :Red
212:       @shape              = hash[:shape]              || :Head
213:       @habitat            = hash[:habitat]            || :None
214:       @generation         = hash[:generation]         || 0
215:       @flags              = hash[:flags]              || []
216:       @mega_stone         = hash[:mega_stone]
217:       @mega_move          = hash[:mega_move]
218:       @unmega_form        = hash[:unmega_form]        || 0
219:       @mega_message       = hash[:mega_message]       || 0
220:       @pbs_file_suffix    = hash[:pbs_file_suffix]    || ""
221:     end
