322:   # Sets another event's self switch (eg. pbSetSelfSwitch(20, "A", true) ).
323:   def pbSetSelfSwitch(eventid, switch_name, value, mapid = -1)
324:     mapid = @map_id if mapid < 0
325:     old_value = $game_self_switches[[mapid, eventid, switch_name]]
326:     $game_self_switches[[mapid, eventid, switch_name]] = value
327:     if value != old_value && $map_factory.hasMap?(mapid)
328:       $map_factory.getMap(mapid, false).need_refresh = true
329:     end
330:   end
