426:   def pbTrainerIntro(symbol)
427:     return true if $DEBUG && !GameData::TrainerType.exists?(symbol)
428:     tr_type = GameData::TrainerType.get(symbol).id
429:     pbGlobalLock
430:     pbPlayTrainerIntroBGM(tr_type)
431:     return true
432:   end
