350:   def getVariable(*arg)
351:     if arg.length == 0
352:       return nil if !$PokemonGlobal.eventvars
353:       return $PokemonGlobal.eventvars[[@map_id, @event_id]]
354:     else
355:       return $game_variables[arg[0]]
356:     end
357:   end
358: 
359:   def setVariable(*arg)
360:     if arg.length == 1
361:       $PokemonGlobal.eventvars = {} if !$PokemonGlobal.eventvars
362:       $PokemonGlobal.eventvars[[@map_id, @event_id]] = arg[0]
363:     else
364:       $game_variables[arg[0]] = arg[1]
365:       $game_map.need_refresh = true
366:     end
367:   end
