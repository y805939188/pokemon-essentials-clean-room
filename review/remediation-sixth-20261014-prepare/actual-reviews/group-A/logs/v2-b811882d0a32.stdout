286:   # Helper function that shows a picture in a script.
287:   def pbShowPicture(number, name, origin, x, y, zoomX = 100, zoomY = 100, opacity = 255, blendType = 0)
288:     number += ($game_temp.in_battle ? 50 : 0)
289:     $game_screen.pictures[number].show(name, origin, x, y, zoomX, zoomY, opacity, blendType)
290:   end
