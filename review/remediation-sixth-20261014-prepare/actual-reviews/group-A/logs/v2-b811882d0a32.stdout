292:   # Erases an event and adds it to the list of erased events so that
293:   # it can stay erased when the game is saved then loaded again.
294:   def pbEraseThisEvent
295:     if $game_map.events[@event_id]
296:       $game_map.events[@event_id].erase
297:       $PokemonMap&.addErasedEvent(@event_id)
298:     end
299:     @index += 1
300:     return true
301:   end
302: 
303:   # Runs a common event.
304:   def pbCommonEvent(id)
305:     common_event = $data_common_events[id]
306:     return if !common_event
307:     if $game_temp.in_battle
308:       $game_system.battle_interpreter.setup(common_event.list, 0)
309:     else
310:       interp = Interpreter.new
311:       interp.setup(common_event.list, 0)
312:       loop do
313:         Graphics.update
314:         Input.update
315:         interp.update
316:         pbUpdateSceneMap
317:         break if !interp.running?
318:       end
319:     end
320:   end
