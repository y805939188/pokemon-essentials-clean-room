440:   def setPrice(item, buy_price = -1, sell_price = -1)
441:     item = GameData::Item.get(item).id
442:     $game_temp.mart_prices[item] = [-1, -1] if !$game_temp.mart_prices[item]
443:     $game_temp.mart_prices[item][0] = buy_price if buy_price > 0
444:     if sell_price >= 0   # 0=can't sell
445:       $game_temp.mart_prices[item][1] = sell_price * 2
446:     elsif buy_price > 0
447:       $game_temp.mart_prices[item][1] = buy_price
448:     end
449:   end
450: 
451:   def setSellPrice(item, sell_price)
452:     setPrice(item, -1, sell_price)
453:   end
454: end
