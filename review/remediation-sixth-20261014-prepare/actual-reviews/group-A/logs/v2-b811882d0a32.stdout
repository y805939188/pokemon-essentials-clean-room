385:   # Used in boulder events. Allows an event to be pushed.
386:   def pbPushThisEvent(strength = false)
387:     event = get_self
388:     old_x  = event.x
389:     old_y  = event.y
390:     # Apply strict version of passable, which treats tiles that are passable
391:     # only from certain directions as fully impassible
392:     return if !event.can_move_in_direction?($game_player.direction, true)
393:     $stats.strength_push_count += 1
394:     case $game_player.direction
395:     when 2 then event.move_down
396:     when 4 then event.move_left
397:     when 6 then event.move_right
398:     when 8 then event.move_up
399:     end
400:     $PokemonMap&.addMovedEvent(@event_id)
401:     if old_x != event.x || old_y != event.y
402:       pbSEPlay("Strength push") if strength
403:       $game_player.lock
404:       loop do
405:         Graphics.update
406:         Input.update
407:         pbUpdateSceneMap
408:         break if !event.moving?
409:       end
410:       $game_player.unlock
411:     end
412:   end
413: 
414:   def pbPushThisBoulder
415:     pbPushThisEvent(true) if $PokemonMap.strengthUsed
416:     return true
417:   end
