373:   def pbSetEventTime(*arg)
374:     $PokemonGlobal.eventvars = {} if !$PokemonGlobal.eventvars
375:     time = pbGetTimeNow
376:     time = time.to_i
377:     pbSetSelfSwitch(@event_id, "A", true)
378:     $PokemonGlobal.eventvars[[@map_id, @event_id]] = time
379:     arg.each do |otherevt|
380:       pbSetSelfSwitch(otherevt, "A", true)
381:       $PokemonGlobal.eventvars[[@map_id, otherevt]] = time
382:     end
383:   end
