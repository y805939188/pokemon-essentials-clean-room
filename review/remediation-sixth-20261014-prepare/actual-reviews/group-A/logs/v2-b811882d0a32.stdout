248:   def pbBreakLoop(index)
249:     indent = @list[index].indent
250:     temp_index = index
251:     loop do
252:       temp_index += 1
253:       return index + 1 if temp_index >= @list.size - 1
254:       return temp_index + 1 if @list[temp_index].code == 413 &&
255:                                @list[temp_index].indent < indent
256:     end
257:   end
258: 
259:   def pbJumpToLabel(index, label_name)
260:     temp_index = 0
261:     loop do
262:       return index + 1 if temp_index >= @list.size - 1
263:       return temp_index + 1 if @list[temp_index].code == 118 &&
264:                                @list[temp_index].parameters[0] == label_name
265:       temp_index += 1
266:     end
267:   end
