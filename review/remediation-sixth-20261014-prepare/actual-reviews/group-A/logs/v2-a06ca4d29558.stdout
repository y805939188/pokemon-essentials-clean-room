540:   #=============================================================================
541:   # Compile Pokémon metrics data
542:   #=============================================================================
543:   def compile_pokemon_metrics(*paths)
544:     compile_PBS_file_generic(GameData::SpeciesMetrics, *paths) do |final_validate, hash|
545:       (final_validate) ? validate_all_compiled_pokemon_metrics : validate_compiled_pokemon_metrics(hash)
546:     end
547:   end
548: 
549:   def validate_compiled_pokemon_metrics(hash)
550:     # Split species and form into their own values, generate compound ID from them
551:     if hash[:id].is_a?(Array)
552:       hash[:species] = hash[:id][0]
553:       hash[:form] = hash[:id][1] || 0
554:       if hash[:form] == 0
555:         hash[:id] = hash[:species]
556:       else
557:         hash[:id] = sprintf("%s_%d", hash[:species].to_s, hash[:form]).to_sym
558:       end
559:     end
560:   end
561: 
562:   def validate_all_compiled_pokemon_metrics
563:   end
564: 
