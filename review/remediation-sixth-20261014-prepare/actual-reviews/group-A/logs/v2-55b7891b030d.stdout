207: SaveData.register_conversion(:v20_rename_bag_variables) do
208:   essentials_version 20
209:   display_title "Renaming Bag variables"
210:   to_value :bag do |bag|
211:     bag.instance_eval do
212:       if !@lastpocket.nil?
213:         @last_viewed_pocket = @lastpocket
214:         @lastPocket = nil
215:       end
216:       if !@choices.nil?
217:         @last_pocket_selections = @choices.clone
218:         @choices = nil
219:       end
220:       if !@registeredItems.nil?
221:         @registered_items = @registeredItems || []
222:         @registeredItems = nil
223:       end
224:       if !@registeredIndex.nil?
225:         @ready_menu_selection = @registeredIndex || [0, 0, 1]
226:         @registeredIndex = nil
227:       end
228:     end
229:   end
230: end
231: 
