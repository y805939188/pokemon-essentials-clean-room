INPUT source Data/Scripts/021_Compiler/001_Compiler.rb TOTAL_LINES 1117 READ 742-830
742:   def pbWriteCsvRecord(record, file, schema)
743:     rec = (record.is_a?(Array)) ? record.flatten : [record]
744:     start = (["*", "^"].include?(schema[1][0, 1])) ? 1 : 0
745:     index = -1
746:     loop do
747:       (start...schema[1].length).each do |i|
748:         index += 1
749:         value = rec[index]
750:         if schema[1][i, 1][/[A-Z]/]   # Optional
751:           # Check the rest of the values for non-nil things
752:           later_value_found = false
753:           (index...rec.length).each do |j|
754:             later_value_found = true if !rec[j].nil?
755:             break if later_value_found
756:           end
757:           if !later_value_found
758:             start = -1
759:             break
760:           end
761:         end
762:         file.write(",") if index > 0
763:         next if value.nil?
764:         case schema[1][i, 1]
765:         when "e", "E"   # Enumerable
766:           enumer = schema[2 + i - start]
767:           case enumer
768:           when Array
769:             file.write((value.is_a?(Integer) && !enumer[value].nil?) ? enumer[value] : value)
770:           when Symbol, String
771:             if GameData.const_defined?(enumer.to_sym)
772:               mod = GameData.const_get(enumer.to_sym)
773:               file.write(mod.get(value).id.to_s)
774:             else
775:               mod = Object.const_get(enumer.to_sym)
776:               file.write(getConstantName(mod, value))
777:             end
778:           when Module
779:             file.write(getConstantName(enumer, value))
780:           when Hash
781:             if value.is_a?(String)
782:               file.write(value)
783:             else
784:               enumer.each_key do |key|
785:                 next if enumer[key] != value
786:                 file.write(key)
787:                 break
788:               end
789:             end
790:           end
791:         when "y", "Y"   # Enumerable or integer
792:           enumer = schema[2 + i - start]
793:           case enumer
794:           when Array
795:             file.write((value.is_a?(Integer) && !enumer[value].nil?) ? enumer[value] : value)
796:           when Symbol, String
797:             if !Kernel.const_defined?(enumer.to_sym) && GameData.const_defined?(enumer.to_sym)
798:               mod = GameData.const_get(enumer.to_sym)
799:               if mod.exists?(value)
800:                 file.write(mod.get(value).id.to_s)
801:               else
802:                 file.write(value.to_s)
803:               end
804:             else
805:               mod = Object.const_get(enumer.to_sym)
806:               file.write(getConstantNameOrValue(mod, value))
807:             end
808:           when Module
809:             file.write(getConstantNameOrValue(enumer, value))
810:           when Hash
811:             if value.is_a?(String)
812:               file.write(value)
813:             else
814:               has_enum = false
815:               enumer.each_key do |key|
816:                 next if enumer[key] != value
817:                 file.write(key)
818:                 has_enum = true
819:                 break
820:               end
821:               file.write(value) if !has_enum
822:             end
823:           end
824:         else
825:           if value.is_a?(String)
826:             file.write((schema[1][i, 1].downcase == "q") ? value : csvQuote(value))
827:           elsif value.is_a?(Symbol)
828:             file.write(csvQuote(value.to_s))
829:           elsif value == true
830:             file.write("true")
