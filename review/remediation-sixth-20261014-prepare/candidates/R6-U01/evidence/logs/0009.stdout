4: class Window_PokemonBag < Window_DrawableCommand
5:   attr_reader :pocket
6:   attr_accessor :sorting
7: 
8:   def initialize(bag, filterlist, pocket, x, y, width, height)
9:     @bag        = bag
10:     @filterlist = filterlist
11:     @pocket     = pocket
12:     @sorting = false
13:     @adapter = PokemonMartAdapter.new
14:     super(x, y, width, height)
15:     @selarrow  = AnimatedBitmap.new("Graphics/UI/Bag/cursor")
16:     @swaparrow = AnimatedBitmap.new("Graphics/UI/Bag/cursor_swap")
17:     self.windowskin = nil
18:   end
19: 
20:   def dispose
21:     @swaparrow.dispose
22:     super
23:   end
24: 
25:   def pocket=(value)
26:     @pocket = value
27:     @item_max = (@filterlist) ? @filterlist[@pocket].length + 1 : @bag.pockets[@pocket].length + 1
28:     self.index = @bag.last_viewed_index(@pocket)
29:   end
30: 
31:   def page_row_max; return PokemonBag_Scene::ITEMSVISIBLE; end
32:   def page_item_max; return PokemonBag_Scene::ITEMSVISIBLE; end
33: 
34:   def item
35:     return nil if @filterlist && !@filterlist[@pocket][self.index]
36:     thispocket = @bag.pockets[@pocket]
37:     item = (@filterlist) ? thispocket[@filterlist[@pocket][self.index]] : thispocket[self.index]
38:     return (item) ? item[0] : nil
39:   end
40: 
41:   def itemCount
42:     return (@filterlist) ? @filterlist[@pocket].length + 1 : @bag.pockets[@pocket].length + 1
43:   end
44: 
45:   def itemRect(item)
46:     if item < 0 || item >= @item_max || item < self.top_item - 1 ||
47:        item > self.top_item + self.page_item_max
48:       return Rect.new(0, 0, 0, 0)
49:     else
50:       cursor_width = (self.width - self.borderX - ((@column_max - 1) * @column_spacing)) / @column_max
51:       x = item % @column_max * (cursor_width + @column_spacing)
52:       y = (item / @column_max * @row_height) - @virtualOy
53:       return Rect.new(x, y, cursor_width, @row_height)
54:     end
55:   end
56: 
57:   def drawCursor(index, rect)
58:     if self.index == index
59:       bmp = (@sorting) ? @swaparrow.bitmap : @selarrow.bitmap
60:       pbCopyBitmap(self.contents, bmp, rect.x, rect.y + 2)
61:     end
62:   end
63: 
64:   def drawItem(index, _count, rect)
65:     textpos = []
66:     rect = Rect.new(rect.x + 16, rect.y + 16, rect.width - 16, rect.height)
67:     thispocket = @bag.pockets[@pocket]
68:     if index == self.itemCount - 1
69:       textpos.push([_INTL("CLOSE BAG"), rect.x, rect.y + 2, :left, self.baseColor, self.shadowColor])
70:     else
71:       item = (@filterlist) ? thispocket[@filterlist[@pocket][index]][0] : thispocket[index][0]
72:       baseColor   = self.baseColor
73:       shadowColor = self.shadowColor
74:       if @sorting && index == self.index
75:         baseColor   = Color.new(224, 0, 0)
76:         shadowColor = Color.new(248, 144, 144)
77:       end
78:       textpos.push(
79:         [@adapter.getDisplayName(item), rect.x, rect.y + 2, :left, baseColor, shadowColor]
80:       )
81:       item_data = GameData::Item.get(item)
82:       showing_register_icon = false
83:       if item_data.is_important?
84:         if @bag.registered?(item)
85:           pbDrawImagePositions(
86:             self.contents,
87:             [[_INTL("Graphics/UI/Bag/icon_register"), rect.x + rect.width - 72, rect.y + 8, 0, 0, -1, 24]]
88:           )
89:           showing_register_icon = true
90:         elsif pbCanRegisterItem?(item)
91:           pbDrawImagePositions(
92:             self.contents,
93:             [[_INTL("Graphics/UI/Bag/icon_register"), rect.x + rect.width - 72, rect.y + 8, 0, 24, -1, 24]]
94:           )
95:           showing_register_icon = true
96:         end
97:       end
98:       if item_data.show_quantity? && !showing_register_icon
99:         qty = (@filterlist) ? thispocket[@filterlist[@pocket][index]][1] : thispocket[index][1]
100:         qtytext = _ISPRINTF("x{1: 3d}", qty)
101:         xQty    = rect.x + rect.width - self.contents.text_size(qtytext).width - 16
102:         textpos.push([qtytext, xQty, rect.y + 2, :left, baseColor, shadowColor])
103:       end
104:     end
105:     pbDrawTextPositions(self.contents, textpos)
106:   end
107: 
108:   def refresh
109:     @item_max = itemCount
110:     self.update_cursor_rect
111:     dwidth  = self.width - self.borderX
112:     dheight = self.height - self.borderY
113:     self.contents = pbDoEnsureBitmap(self.contents, dwidth, dheight)
114:     self.contents.clear
115:     @item_max.times do |i|
116:       next if i < self.top_item - 1 || i > self.top_item + self.page_item_max
117:       drawItem(i, @item_max, itemRect(i))
118:     end
119:     drawCursor(self.index, itemRect(self.index))
120:   end
121: 
122:   def update
123:     super
124:     @uparrow.visible   = false
125:     @downarrow.visible = false
126:   end
127: end
