422: MultipleForms.register(:FURFROU, {
423:   "getForm" => proc { |pkmn|
424:     if !pkmn.time_form_set ||
425:        pbGetTimeNow.to_i > pkmn.time_form_set.to_i + (60 * 60 * 24 * 5)   # 5 days
426:       next 0
427:     end
428:   },
429:   "onSetForm" => proc { |pkmn, form, oldForm|
430:     pkmn.time_form_set = (form > 0) ? pbGetTimeNow.to_i : nil
431:   }
432: })
433: 
