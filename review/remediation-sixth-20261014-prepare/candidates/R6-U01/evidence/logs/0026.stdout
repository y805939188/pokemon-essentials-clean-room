267: MultipleForms.register(:GIRATINA, {
268:   "getForm" => proc { |pkmn|
269:     next 1 if pkmn.hasItem?(:GRISEOUSORB)
270:     next 1 if $game_map&.metadata&.has_flag?("DistortionWorld")
271:     next 0
272:   }
273: })
274: 
275: MultipleForms.register(:SHAYMIN, {
276:   "getForm" => proc { |pkmn|
277:     next 0 if pkmn.fainted? || pkmn.status == :FROZEN || PBDayNight.isNight?
278:   }
279: })
280: 
281: MultipleForms.register(:ARCEUS, {
282:   "getForm" => proc { |pkmn|
283:     next nil if !pkmn.hasAbility?(:MULTITYPE)
284:     typeArray = {
285:       1  => [:FISTPLATE,   :FIGHTINIUMZ],
286:       2  => [:SKYPLATE,    :FLYINIUMZ],
287:       3  => [:TOXICPLATE,  :POISONIUMZ],
288:       4  => [:EARTHPLATE,  :GROUNDIUMZ],
289:       5  => [:STONEPLATE,  :ROCKIUMZ],
290:       6  => [:INSECTPLATE, :BUGINIUMZ],
291:       7  => [:SPOOKYPLATE, :GHOSTIUMZ],
292:       8  => [:IRONPLATE,   :STEELIUMZ],
293:       10 => [:FLAMEPLATE,  :FIRIUMZ],
294:       11 => [:SPLASHPLATE, :WATERIUMZ],
295:       12 => [:MEADOWPLATE, :GRASSIUMZ],
296:       13 => [:ZAPPLATE,    :ELECTRIUMZ],
297:       14 => [:MINDPLATE,   :PSYCHIUMZ],
298:       15 => [:ICICLEPLATE, :ICIUMZ],
299:       16 => [:DRACOPLATE,  :DRAGONIUMZ],
300:       17 => [:DREADPLATE,  :DARKINIUMZ],
301:       18 => [:PIXIEPLATE,  :FAIRIUMZ]
302:     }
303:     ret = 0
304:     typeArray.each do |f, items|
305:       items.each do |item|
306:         next if !pkmn.hasItem?(item)
307:         ret = f
308:         break
309:       end
310:       break if ret > 0
311:     end
312:     next ret
313:   }
314: })
315: 
