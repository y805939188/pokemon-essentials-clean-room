FILE /tmp/r6-u01-frozen/Maruno17/pokemon-essentials/8c5911e4a4b07b07e832e4bb0d5d8859e88b4a9b/Data/Scripts/016_UI/007_UI_Bag.rb LINES 351-704/704
351:   def pbChooseItem
352:     @sprites["helpwindow"].visible = false
353:     itemwindow = @sprites["itemlist"]
354:     thispocket = @bag.pockets[itemwindow.pocket]
355:     swapinitialpos = -1
356:     pbActivateWindow(@sprites, "itemlist") do
357:       loop do
358:         oldindex = itemwindow.index
359:         Graphics.update
360:         Input.update
361:         pbUpdate
362:         if itemwindow.sorting && itemwindow.index >= thispocket.length
363:           itemwindow.index = (oldindex == thispocket.length - 1) ? 0 : thispocket.length - 1
364:         end
365:         if itemwindow.index != oldindex
366:           # Move the item being switched
367:           if itemwindow.sorting
368:             thispocket.insert(itemwindow.index, thispocket.delete_at(oldindex))
369:           end
370:           # Update selected item for current pocket
371:           @bag.set_last_viewed_index(itemwindow.pocket, itemwindow.index)
372:           pbRefresh
373:         end
374:         if itemwindow.sorting
375:           if Input.trigger?(Input::ACTION) ||
376:              Input.trigger?(Input::USE)
377:             itemwindow.sorting = false
378:             pbPlayDecisionSE
379:             pbRefresh
380:           elsif Input.trigger?(Input::BACK)
381:             thispocket.insert(swapinitialpos, thispocket.delete_at(itemwindow.index))
382:             itemwindow.index = swapinitialpos
383:             itemwindow.sorting = false
384:             pbPlayCancelSE
385:             pbRefresh
386:           end
387:         else   # Change pockets
388:           if Input.trigger?(Input::LEFT)
389:             newpocket = itemwindow.pocket
390:             loop do
391:               newpocket = (newpocket == 1) ? PokemonBag.pocket_count : newpocket - 1
392:               break if !@choosing || newpocket == itemwindow.pocket
393:               if @filterlist
394:                 break if @filterlist[newpocket].length > 0
395:               elsif @bag.pockets[newpocket].length > 0
396:                 break
397:               end
398:             end
399:             if itemwindow.pocket != newpocket
400:               itemwindow.pocket = newpocket
401:               @bag.last_viewed_pocket = itemwindow.pocket
402:               thispocket = @bag.pockets[itemwindow.pocket]
403:               pbPlayCursorSE
404:               pbRefresh
405:             end
406:           elsif Input.trigger?(Input::RIGHT)
407:             newpocket = itemwindow.pocket
408:             loop do
409:               newpocket = (newpocket == PokemonBag.pocket_count) ? 1 : newpocket + 1
410:               break if !@choosing || newpocket == itemwindow.pocket
411:               if @filterlist
412:                 break if @filterlist[newpocket].length > 0
413:               elsif @bag.pockets[newpocket].length > 0
414:                 break
415:               end
416:             end
417:             if itemwindow.pocket != newpocket
418:               itemwindow.pocket = newpocket
419:               @bag.last_viewed_pocket = itemwindow.pocket
420:               thispocket = @bag.pockets[itemwindow.pocket]
421:               pbPlayCursorSE
422:               pbRefresh
423:             end
424: #          elsif Input.trigger?(Input::SPECIAL)   # Register/unregister selected item
425: #            if !@choosing && itemwindow.index<thispocket.length
426: #              if @bag.registered?(itemwindow.item)
427: #                @bag.unregister(itemwindow.item)
428: #              elsif pbCanRegisterItem?(itemwindow.item)
429: #                @bag.register(itemwindow.item)
430: #              end
431: #              pbPlayDecisionSE
432: #              pbRefresh
433: #            end
434:           elsif Input.trigger?(Input::ACTION)   # Start switching the selected item
435:             if !@choosing && thispocket.length > 1 && itemwindow.index < thispocket.length &&
436:                !Settings::BAG_POCKET_AUTO_SORT[itemwindow.pocket - 1]
437:               itemwindow.sorting = true
438:               swapinitialpos = itemwindow.index
439:               pbPlayDecisionSE
440:               pbRefresh
441:             end
442:           elsif Input.trigger?(Input::BACK)   # Cancel the item screen
443:             pbPlayCloseMenuSE
444:             return nil
445:           elsif Input.trigger?(Input::USE)   # Choose selected item
446:             (itemwindow.item) ? pbPlayDecisionSE : pbPlayCloseMenuSE
447:             return itemwindow.item
448:           end
449:         end
450:       end
451:     end
452:   end
453: end
