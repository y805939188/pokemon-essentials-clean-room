1061:   #=============================================================================
1062:   # Stat calculations
1063:   #=============================================================================
1064: 
1065:   # @return [Hash<Integer>] this Pokémon's base stats, a hash with six key/value pairs
1066:   def baseStats
1067:     this_base_stats = species_data.base_stats
1068:     ret = {}
1069:     GameData::Stat.each_main { |s| ret[s.id] = this_base_stats[s.id] }
1070:     return ret
1071:   end
1072: 
1073:   # Returns this Pokémon's effective IVs, taking into account Hyper Training.
1074:   # Only used for calculating stats.
1075:   # @return [Hash<Integer>] hash containing this Pokémon's effective IVs
1076:   def calcIV
1077:     this_ivs = self.iv
1078:     ret = {}
1079:     GameData::Stat.each_main do |s|
1080:       ret[s.id] = (@ivMaxed[s.id]) ? IV_STAT_LIMIT : this_ivs[s.id]
1081:     end
1082:     return ret
1083:   end
1084: 
1085:   # @return [Integer] the maximum HP of this Pokémon
1086:   def calcHP(base, level, iv, ev)
1087:     return 1 if base == 1   # For Shedinja
1088:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
1089:     return (((base * 2) + iv + (ev / 4)) * level / 100).floor + level + 10
1090:   end
1091: 
1092:   # @return [Integer] the specified stat of this Pokémon (not used for total HP)
1093:   def calcStat(base, level, iv, ev, nat)
1094:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
1095:     return (((((base * 2) + iv + (ev / 4)) * level / 100).floor + 5) * nat / 100).floor
1096:   end
1097: 
1098:   # Recalculates this Pokémon's stats.
1099:   def calc_stats
1100:     base_stats = self.baseStats
1101:     this_level = self.level
1102:     this_IV    = self.calcIV
1103:     # Format stat multipliers due to nature
1104:     nature_mod = {}
1105:     GameData::Stat.each_main { |s| nature_mod[s.id] = 100 }
1106:     this_nature = self.nature_for_stats
1107:     if this_nature
1108:       this_nature.stat_changes.each { |change| nature_mod[change[0]] += change[1] }
1109:     end
1110:     # Calculate stats
1111:     stats = {}
1112:     GameData::Stat.each_main do |s|
1113:       if s.id == :HP
1114:         stats[s.id] = calcHP(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id])
1115:       else
1116:         stats[s.id] = calcStat(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id], nature_mod[s.id])
1117:       end
1118:     end
1119:     hp_difference = stats[:HP] - @totalhp
1120:     @totalhp = stats[:HP]
1121:     self.hp = [@hp + hp_difference, 1].max if @hp > 0 || hp_difference > 0
1122:     @attack  = stats[:ATTACK]
1123:     @defense = stats[:DEFENSE]
1124:     @spatk   = stats[:SPECIAL_ATTACK]
1125:     @spdef   = stats[:SPECIAL_DEFENSE]
1126:     @speed   = stats[:SPEED]
1127:   end
1128: 
1129:   #=============================================================================
1130:   # Pokémon creation
1131:   #=============================================================================
1132: 
1133:   # Creates a copy of this Pokémon and returns it.
1134:   # @return [Pokemon] a copy of this Pokémon
1135:   def clone
1136:     ret = super
1137:     ret.iv          = {}
1138:     ret.ivMaxed     = {}
1139:     ret.ev          = {}
1140:     GameData::Stat.each_main do |s|
1141:       ret.iv[s.id]      = @iv[s.id]
1142:       ret.ivMaxed[s.id] = @ivMaxed[s.id]
1143:       ret.ev[s.id]      = @ev[s.id]
1144:     end
1145:     ret.moves       = []
1146:     @moves.each_with_index { |m, i| ret.moves[i] = m.clone }
1147:     ret.first_moves = @first_moves.clone
1148:     ret.owner       = @owner.clone
1149:     ret.ribbons     = @ribbons.clone
1150:     return ret
1151:   end
1152: 
1153:   # Creates a new Pokémon object.
1154:   # @param species [Symbol, String, GameData::Species] Pokémon species
1155:   # @param level [Integer] Pokémon level
1156:   # @param owner [Owner, Player, NPCTrainer] Pokémon owner (the player by default)
1157:   # @param withMoves [Boolean] whether the Pokémon should have moves
1158:   # @param recheck_form [Boolean] whether to auto-check the form
1159:   def initialize(species, level, owner = $player, withMoves = true, recheck_form = true)
1160:     species_data = GameData::Species.get(species)
1161:     @species          = species_data.species
1162:     @form             = species_data.base_form
1163:     @forced_form      = nil
1164:     @time_form_set    = nil
1165:     self.level        = level
1166:     @steps_to_hatch   = 0
1167:     heal_status
1168:     @gender           = nil
1169:     @shiny            = nil
1170:     @ability_index    = nil
1171:     @ability          = nil
1172:     @nature           = nil
1173:     @nature_for_stats = nil
1174:     @item             = nil
1175:     @mail             = nil
1176:     @moves            = []
1177:     reset_moves if withMoves
1178:     @first_moves      = []
1179:     @ribbons          = []
1180:     @cool             = 0
1181:     @beauty           = 0
1182:     @cute             = 0
1183:     @smart            = 0
1184:     @tough            = 0
1185:     @sheen            = 0
1186:     @pokerus          = 0
1187:     @name             = nil
1188:     @happiness        = species_data.happiness
1189:     @poke_ball        = :POKEBALL
1190:     @markings         = []
1191:     @iv               = {}
1192:     @ivMaxed          = {}
1193:     @ev               = {}
1194:     GameData::Stat.each_main do |s|
1195:       @iv[s.id]       = rand(IV_STAT_LIMIT + 1)
1196:       @ev[s.id]       = 0
1197:     end
1198:     case owner
1199:     when Owner
1200:       @owner = owner
1201:     when Player, NPCTrainer
1202:       @owner = Owner.new_from_trainer(owner)
1203:     else
1204:       @owner = Owner.new(0, "", 2, 2)
1205:     end
1206:     @obtain_method    = 0   # Met
1207:     @obtain_method    = 4 if $game_switches && $game_switches[Settings::FATEFUL_ENCOUNTER_SWITCH]
1208:     @obtain_map       = ($game_map) ? $game_map.map_id : 0
1209:     @obtain_text      = nil
1210:     @obtain_level     = level
1211:     @hatched_map      = 0
1212:     @timeReceived     = Time.now.to_i
1213:     @timeEggHatched   = nil
1214:     @fused            = nil
1215:     @personalID       = rand(2**16) | (rand(2**16) << 16)
1216:     @hp               = 1
1217:     @totalhp          = 1
1218:     calc_stats
1219:     if @form == 0 && recheck_form
1220:       f = MultipleForms.call("getFormOnCreation", self)
1221:       if f
1222:         self.form = f
1223:         reset_moves if withMoves
1224:       end
1225:     end
1226:   end
1227: end
