971:   #=============================================================================
972:   # Evolution checks
973:   #=============================================================================
974:   # Checks whether this Pokemon can evolve because of levelling up.
975:   # @return [Symbol, nil] the ID of the species to evolve into
976:   def check_evolution_on_level_up
977:     return check_evolution_internal do |pkmn, new_species, method, parameter|
978:       success = GameData::Evolution.get(method).call_level_up(pkmn, parameter)
979:       next (success) ? new_species : nil
980:     end
981:   end
982: 
983:   # Checks whether this Pokemon can evolve because of using an item on it.
984:   # @param item_used [Symbol, GameData::Item, nil] the item being used
985:   # @return [Symbol, nil] the ID of the species to evolve into
986:   def check_evolution_on_use_item(item_used)
987:     return check_evolution_internal do |pkmn, new_species, method, parameter|
988:       success = GameData::Evolution.get(method).call_use_item(pkmn, parameter, item_used)
989:       next (success) ? new_species : nil
990:     end
991:   end
992: 
993:   # Checks whether this Pokemon can evolve because of being traded.
994:   # @param other_pkmn [Pokemon] the other Pokémon involved in the trade
995:   # @return [Symbol, nil] the ID of the species to evolve into
996:   def check_evolution_on_trade(other_pkmn)
997:     return check_evolution_internal do |pkmn, new_species, method, parameter|
998:       success = GameData::Evolution.get(method).call_on_trade(pkmn, parameter, other_pkmn)
999:       next (success) ? new_species : nil
1000:     end
1001:   end
1002: 
1003:   # Checks whether this Pokemon can evolve after a battle.
1004:   # @return [Symbol, nil] the ID of the species to evolve into
1005:   def check_evolution_after_battle(party_index)
1006:     return check_evolution_internal do |pkmn, new_species, method, parameter|
1007:       success = GameData::Evolution.get(method).call_after_battle(pkmn, party_index, parameter)
1008:       next (success) ? new_species : nil
1009:     end
1010:   end
1011: 
1012:   # Checks whether this Pokemon can evolve by a triggered event.
1013:   # @param value [Integer] a value that may be used by the evolution method
1014:   # @return [Symbol, nil] the ID of the species to evolve into
1015:   def check_evolution_by_event(value = 0)
1016:     return check_evolution_internal do |pkmn, new_species, method, parameter|
1017:       success = GameData::Evolution.get(method).call_event(pkmn, parameter, value)
1018:       next (success) ? new_species : nil
1019:     end
1020:   end
1021: 
1022:   # Called after this Pokémon evolves, to remove its held item (if the evolution
1023:   # required it to have a held item) or duplicate this Pokémon (Shedinja only).
1024:   # @param new_species [Symbol] the species that this Pokémon evolved into
1025:   def action_after_evolution(new_species)
1026:     species_data.get_evolutions(true).each do |evo|   # [new_species, method, parameter]
1027:       break if GameData::Evolution.get(evo[1]).call_after_evolution(self, evo[0], evo[2], new_species)
1028:     end
1029:   end
1030: 
1031:   # The core method that performs evolution checks. Needs a block given to it,
1032:   # which will provide either a GameData::Species ID (the species to evolve
1033:   # into) or nil (keep checking).
1034:   # @return [Symbol, nil] the ID of the species to evolve into
1035:   def check_evolution_internal
1036:     return nil if egg? || shadowPokemon?
1037:     return nil if hasItem?(:EVERSTONE)
1038:     return nil if hasAbility?(:BATTLEBOND)
1039:     species_data.get_evolutions(true).each do |evo|   # [new_species, method, parameter, boolean]
1040:       next if evo[3]   # Prevolution
1041:       ret = yield self, evo[0], evo[1], evo[2]   # pkmn, new_species, method, parameter
1042:       return ret if ret
1043:     end
1044:     return nil
1045:   end
1046: 
1047:   def trigger_event_evolution(number)
1048:     new_species = check_evolution_by_event(number)
1049:     if new_species
1050:       pbFadeOutInWithMusic do
1051:         evo = PokemonEvolutionScene.new
1052:         evo.pbStartScreen(self, new_species)
1053:         evo.pbEvolution
1054:         evo.pbEndScreen
1055:       end
1056:       return true
1057:     end
1058:     return false
1059:   end
