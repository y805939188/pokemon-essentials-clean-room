275:     #---------------------------------------------------------------------------
276: 
277:     # Unlocks the given Dex, -1 being the National Dex.
278:     # @param dex [Integer] Dex ID (-1 is the National Dex)
279:     def unlock(dex)
280:       validate dex => Integer
281:       dex = @unlocked_dexes.length - 1 if dex < 0 || dex > @unlocked_dexes.length - 1
282:       @unlocked_dexes[dex] = true
283:       self.refresh_accessible_dexes
284:     end
285: 
286:     # Locks the given Dex, -1 being the National Dex.
287:     # @param dex [Integer] Dex ID (-1 is the National Dex)
288:     def lock(dex)
289:       validate dex => Integer
290:       dex = @unlocked_dexes.length - 1 if dex < 0 || dex > @unlocked_dexes.length - 1
291:       @unlocked_dexes[dex] = false
292:       self.refresh_accessible_dexes
293:     end
294: 
295:     # @param dex [Integer] Dex ID (-1 is the National Dex)
296:     # @return [Boolean] whether the given Dex is unlocked
297:     def unlocked?(dex)
298:       validate dex => Integer
299:       dex = @unlocked_dexes.length - 1 if dex == -1
300:       return @unlocked_dexes[dex] == true
301:     end
302: 
303:     # @return [Integer] the number of defined Dexes (including the National Dex)
304:     def dexes_count
305:       return @unlocked_dexes.length
306:     end
307: 
308:     # Decides which Dex lists are able to be viewed (i.e. they are unlocked and
309:     # have at least 1 seen species in them), and saves all accessible Dex region
310:     # numbers into {#accessible_dexes}. National Dex comes after all regional
311:     # Dexes.
312:     # If the Dex list shown depends on the player's location, this just decides
313:     # if a species in the current region has been seen - doesn't look at other
314:     # regions.
315:     def refresh_accessible_dexes
316:       @accessible_dexes = []
317:       if Settings::USE_CURRENT_REGION_DEX
318:         region = pbGetCurrentRegion
319:         region = -1 if region >= dexes_count - 1
320:         @accessible_dexes[0] = region if self.seen_any?(region)
321:         return
322:       end
323:       if dexes_count == 1   # Only National Dex is defined
324:         @accessible_dexes.push(-1) if self.unlocked?(0) && self.seen_any?
325:       else   # Regional Dexes + National Dex
326:         dexes_count.times do |i|
327:           dex_list_to_check = (i == dexes_count - 1) ? -1 : i
328:           if self.unlocked?(i) && self.seen_any?(dex_list_to_check)
329:             @accessible_dexes.push(dex_list_to_check)
330:           end
331:         end
332:       end
333:     end
334: 
335:     def species_in_unlocked_dex?(species)
336:       return true if @unlocked_dexes.last
337:       (@unlocked_dexes.length - 1).times do |i|
338:         next if !self.unlocked?(i)
339:         return true if pbGetRegionalNumber(i, species) > 0
340:       end
341:       return false
342:     end
343: 
344:     #---------------------------------------------------------------------------
345: 
346:     private
347: 
348:     # @param hash [Hash]
349:     # @param region [Integer]
350:     # @return [Integer]
351:     def count_species(hash, region = -1)
352:       ret = 0
353:       if region == -1
354:         GameData::Species.each_species { |s| ret += 1 if hash[s.species] }
355:       else
356:         pbAllRegionalSpecies(region).each { |s| ret += 1 if s && hash[s] }
357:       end
358:       return ret
359:     end
360:   end
361: end
