179:     # Returns the amount of owned Pokémon.
180:     # If a region ID is given, returns the amount of owned Pokémon
181:     # in that region.
182:     # @param dex [Integer] region ID
183:     def owned_count(dex = -1)
184:       validate dex => Integer
185:       return self.count_species(@owned, dex)
186:     end
