FILE /tmp/r6-u01-frozen/Maruno17/pokemon-essentials/8c5911e4a4b07b07e832e4bb0d5d8859e88b4a9b/Data/Scripts/015_Trainers and player/005_Player_Pokedex.rb LINES 1-361/361
1: class Player < Trainer
2:   # Represents the player's Pokédex.
3:   class Pokedex
4:     # @return [Array<Integer>] an array of accessible Dexes
5:     # @see #refresh_accessible_dexes
6:     attr_reader :accessible_dexes
7: 
8:     def inspect
9:       str = super.chop
10:       str << sprintf(" seen: %d, owned: %d>", self.seen_count, self.owned_count)
11:       return str
12:     end
13: 
14:     # Creates an empty Pokédex.
15:     def initialize
16:       @unlocked_dexes = []
17:       0.upto(pbLoadRegionalDexes.length) do |i|
18:         @unlocked_dexes[i] = (i == 0)
19:       end
20:       self.clear
21:     end
22: 
23:     # Clears the Pokédex.
24:     def clear
25:       @seen            = {}
26:       @owned           = {}
27:       @seen_forms      = {}   # Gender (0 or 1), shiny (0 or 1), form number
28:       @seen_eggs       = {}
29:       @last_seen_forms = {}
30:       @owned_shadow    = {}
31:       @caught_counts   = {}
32:       @defeated_counts = {}
33:       self.refresh_accessible_dexes
34:     end
35: 
36:     #===========================================================================
37: 
38:     # Sets the given species as seen in the Pokédex.
39:     # @param species [Symbol, GameData::Species] species to set as seen
40:     # @param should_refresh_dexes [Boolean] whether Dex accessibility should be recalculated
41:     def set_seen(species, should_refresh_dexes = true)
42:       species_id = GameData::Species.try_get(species)&.species
43:       return if species_id.nil?
44:       @seen[species_id] = true
45:       self.refresh_accessible_dexes if should_refresh_dexes
46:     end
47: 
48:     # @param species [Symbol, GameData::Species] species to check
49:     # @return [Boolean] whether the species is seen
50:     def seen?(species)
51:       species_id = GameData::Species.try_get(species)&.species
52:       return false if species_id.nil?
53:       return @seen[species_id] == true
54:     end
55: 
56:     # @param species [Symbol, GameData::Species] species to check
57:     # @param gender [Integer] gender to check
58:     # @param form [Integer] form to check
59:     # @param shiny [Boolean, nil] shininess to check (checks both if nil)
60:     # @return [Boolean] whether the species of the given gender/form/shininess is seen
61:     def seen_form?(species, gender, form, shiny = nil)
62:       species_id = GameData::Species.try_get(species)&.species
63:       return false if species_id.nil?
64:       @seen_forms[species_id] ||= [[[], []], [[], []]]
65:       if shiny.nil?
66:         return @seen_forms[species_id][gender][0][form] || @seen_forms[species_id][gender][1][form]
67:       end
68:       shin = (shiny) ? 1 : 0
69:       return @seen_forms[species_id][gender][shin][form] == true
70:     end
71: 
72:     # Sets the egg for the given species as seen.
73:     # @param species [Symbol, GameData::Species] species to set as seen
74:     def set_seen_egg(species)
75:       species_id = GameData::Species.try_get(species)&.species
76:       return if species_id.nil?
77:       @seen_eggs[species_id] = true
78:     end
79: 
80:     # @param species [Symbol, GameData::Species] species to check
81:     # @return [Boolean] whether the egg for the given species is seen
82:     def seen_egg?(species)
83:       species_id = GameData::Species.try_get(species)&.species
84:       return false if species_id.nil?
85:       return @seen_eggs[species_id] == true
86:     end
87: 
88:     # Returns the amount of seen Pokémon.
89:     # If a region ID is given, returns the amount of seen Pokémon
90:     # in that region.
91:     # @param dex [Integer] region ID
92:     def seen_count(dex = -1)
93:       validate dex => Integer
94:       return self.count_species(@seen, dex)
95:     end
96: 
97:     # Returns whether there are any seen Pokémon.
98:     # If a region is given, returns whether there are seen Pokémon
99:     # in that region.
100:     # @param dex [Integer] region ID
101:     # @return [Boolean] whether there are any seen Pokémon
102:     def seen_any?(dex = -1)
103:       validate dex => Integer
104:       if dex == -1
105:         GameData::Species.each_species { |s| return true if @seen[s.species] }
106:       else
107:         pbAllRegionalSpecies(dex).each { |s| return true if s && @seen[s] }
108:       end
109:       return false
110:     end
111: 
112:     # Returns the amount of seen forms for the given species.
113:     # @param species [Symbol, GameData::Species] Pokémon species
114:     # @return [Integer] amount of seen forms
115:     def seen_forms_count(species)
116:       species_id = GameData::Species.try_get(species)&.species
117:       return 0 if species_id.nil?
118:       ret = 0
119:       @seen_forms[species_id] ||= [[[], []], [[], []]]
120:       array = @seen_forms[species_id]
121:       [array[0].length, array[1].length].max.times do |i|
122:         ret += 1 if array[0][0][i] || array[0][1][i] ||   # male or genderless shiny/non-shiny
123:                     array[1][0][i] || array[1][1][i]      # female shiny/non-shiny
124:       end
125:       return ret
126:     end
127: 
128:     # @param species [Symbol, GameData::Species] Pokémon species
129:     def last_form_seen(species)
130:       @last_seen_forms[species] ||= []
131:       return @last_seen_forms[species][0] || 0, @last_seen_forms[species][1] || 0, @last_seen_forms[species][2] || false
132:     end
133: 
134:     # @param species [Symbol, GameData::Species] Pokémon species
135:     # @param gender [Integer] gender (0=male, 1=female, 2=genderless)
136:     # @param form [Integer] form number
137:     # @param shiny [Boolean] shininess
138:     def set_last_form_seen(species, gender = 0, form = 0, shiny = false)
139:       @last_seen_forms[species] = [gender, form, shiny]
140:     end
