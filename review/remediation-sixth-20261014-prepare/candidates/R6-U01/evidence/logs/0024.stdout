232:     # @param species [Symbol, GameData::Species] species to check
233:     # @return [Integer] the number of Pokémon of the given species that have
234:     #   been caught by the player
235:     def caught_count(species)
236:       species_id = GameData::Species.try_get(species)&.species
237:       return 0 if species_id.nil?
238:       return @caught_counts[species_id] || 0
239:     end
240: 
241:     # @param species [Symbol, GameData::Species] species to check
242:     # @return [Integer] the number of Pokémon of the given species that have
243:     #   been defeated by the player
244:     def defeated_count(species)
245:       species_id = GameData::Species.try_get(species)&.species
246:       return 0 if species_id.nil?
247:       return @defeated_counts[species_id] || 0
248:     end
249: 
250:     # @param species [Symbol, GameData::Species] species to check
251:     # @return [Integer] the number of Pokémon of the given species that have
252:     #   been defeated or caught by the player
253:     def battled_count(species)
254:       species_id = GameData::Species.try_get(species)&.species
255:       return 0 if species_id.nil?
256:       return (@defeated_counts[species_id] || 0) + (@caught_counts[species_id] || 0)
257:     end
258: 
259:     # @param species [Symbol, GameData::Species] species to count as caught
260:     def register_caught(species)
261:       species_id = GameData::Species.try_get(species)&.species
262:       return if species_id.nil?
263:       @caught_counts[species_id] = 0 if @caught_counts[species_id].nil?
264:       @caught_counts[species_id] += 1
265:     end
266: 
267:     # @param species [Symbol, GameData::Species] species to count as defeated
268:     def register_defeated(species)
269:       species_id = GameData::Species.try_get(species)&.species
270:       return if species_id.nil?
271:       @defeated_counts[species_id] = 0 if @defeated_counts[species_id].nil?
272:       @defeated_counts[species_id] += 1
273:     end
