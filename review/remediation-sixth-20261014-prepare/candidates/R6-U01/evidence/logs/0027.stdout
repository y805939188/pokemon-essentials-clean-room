614: # A Milcery will always have the same flavor, but it is randomly chosen.
615: MultipleForms.register(:MILCERY, {
616:   "getForm" => proc { |pkmn|
617:     num_flavors = 9
618:     sweets = [:STRAWBERRYSWEET, :BERRYSWEET, :LOVESWEET, :STARSWEET,
619:               :CLOVERSWEET, :FLOWERSWEET, :RIBBONSWEET]
620:     if sweets.include?(pkmn.item_id)
621:       next sweets.index(pkmn.item_id) + ((pkmn.personalID % num_flavors) * sweets.length)
622:     end
623:     next 0
624:   }
625: })
626: 
627: MultipleForms.register(:ALCREMIE, {
628:   "getFormOnCreation" => proc { |pkmn|
629:     num_flavors = 9
630:     num_sweets = 7
631:     next rand(num_flavors * num_sweets)
632:   }
633: })
634: 
