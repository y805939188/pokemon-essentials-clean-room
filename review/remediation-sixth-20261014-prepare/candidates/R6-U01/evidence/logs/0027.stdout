731: #===============================================================================
732: # Regional forms
733: # This code is for determining the form of a Pokémon in an egg created at the
734: # Day Care, where that Pokémon's species has regional forms. The regional form
735: # chosen depends on the region in which the egg was produced (not where it
736: # hatches).
737: #===============================================================================
738: 
739: # The code in this proc assumes that the appropriate regional form for a Pokémon
740: # is equal to the region's number. This may not be true in your game.
741: # Note that this proc only produces a non-zero form number if the species has a
742: # defined form with that number, which means it can be used for both Alolan and
743: # Galarian forms separately (and for Meowth which has both).
744: MultipleForms.register(:RATTATA, {
745:   "getFormOnEggCreation" => proc { |pkmn|
746:     if $game_map
747:       map_pos = $game_map.metadata&.town_map_position
748:       next map_pos[0] if map_pos &&
749:                          GameData::Species.get_species_form(pkmn.species, map_pos[0]).form == map_pos[0]
750:     end
751:     next 0
752:   }
753: })
754: 
755: MultipleForms.copy(:RATTATA, :SANDSHREW, :VULPIX, :DIGLETT, :MEOWTH, :GEODUDE,
756:                    :GRIMER, :PONYTA, :FARFETCHD, :CORSOLA, :ZIGZAGOON,
757:                    :DARUMAKA, :YAMASK, :STUNFISK, :SLOWPOKE, :ARTICUNO, :ZAPDOS,
758:                    :MOLTRES)
759: 
760: #===============================================================================
761: # Regional forms
762: # These species don't have visually different regional forms, but they need to
763: # evolve into different forms depending on the location where they evolve.
764: #===============================================================================
765: 
766: # Alolan forms
767: MultipleForms.register(:PIKACHU, {
768:   "getForm" => proc { |pkmn|
769:     next if pkmn.form_simple >= 2
770:     if $game_map
771:       map_pos = $game_map.metadata&.town_map_position
772:       next 1 if map_pos && map_pos[0] == 1   # Tiall region
773:     end
774:     next 0
775:   }
776: })
777: 
778: MultipleForms.copy(:PIKACHU, :EXEGGCUTE, :CUBONE)
779: 
780: # Galarian forms
781: MultipleForms.register(:KOFFING, {
782:   "getForm" => proc { |pkmn|
783:     next if pkmn.form_simple >= 2
784:     if $game_map
785:       map_pos = $game_map.metadata&.town_map_position
786:       next 1 if map_pos && map_pos[0] == 2   # Galar region
787:     end
788:     next 0
789:   }
790: })
791: 
792: MultipleForms.copy(:KOFFING, :MIMEJR)
