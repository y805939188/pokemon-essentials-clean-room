653: MultipleForms.register(:ZACIAN, {
654:   "getFormOnStartingBattle" => proc { |pkmn, wild|
655:     next 1 if pkmn.hasItem?(:RUSTEDSWORD)
656:     next 0
657:   },
658:   "changePokemonOnStartingBattle" => proc { |pkmn, battle|
659:     if GameData::Move.exists?(:BEHEMOTHBLADE) && pkmn.hasItem?(:RUSTEDSWORD)
660:       pkmn.moves.each { |move| move.id = :BEHEMOTHBLADE if move.id == :IRONHEAD }
661:     end
662:   },
663:   "getFormOnLeavingBattle" => proc { |pkmn, battle, usedInBattle, endBattle|
664:     next 0 if endBattle
665:   },
666:   "changePokemonOnLeavingBattle" => proc { |pkmn, battle, usedInBattle, endBattle|
667:     if endBattle
668:       pkmn.moves.each { |move| move.id = :IRONHEAD if move.id == :BEHEMOTHBLADE }
669:     end
670:   }
671: })
672: 
