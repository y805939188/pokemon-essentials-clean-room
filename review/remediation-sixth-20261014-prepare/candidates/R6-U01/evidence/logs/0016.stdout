88:   # Max total IVs
89:   IV_STAT_LIMIT = 31
90:   # Max total EVs
91:   EV_LIMIT      = 510
92:   # Max EVs that a single stat can have
93:   EV_STAT_LIMIT = 252
94:   # Maximum length a Pokémon's nickname can be
