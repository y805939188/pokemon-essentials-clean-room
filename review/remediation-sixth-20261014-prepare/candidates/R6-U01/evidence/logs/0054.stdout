299:     def get_previous_species
300:       return @species if @evolutions.length == 0
301:       @evolutions.each { |evo| return evo[0] if evo[3] }   # Is the prevolution
302:       return @species
303:     end
304: 
305:     def get_baby_species(check_items = false, item1 = nil, item2 = nil)
306:       ret = @species
307:       return ret if @evolutions.length == 0
308:       @evolutions.each do |evo|
309:         next if !evo[3]   # Check only the prevolution
310:         if check_items
311:           incense = GameData::Species.get(evo[0]).incense
312:           ret = evo[0] if !incense || item1 == incense || item2 == incense
313:         else
314:           ret = evo[0]   # Species of prevolution
315:         end
316:         break
317:       end
318:       ret = GameData::Species.get(ret).get_baby_species(check_items, item1, item2) if ret != @species
319:       return ret
320:     end
321: 
322:     # Returns an array of all the species in this species' evolution family.
323:     def get_family_species
324:       sp = get_baby_species
325:       evos = GameData::Species.get(sp).get_family_evolutions(false)
326:       return [sp] if evos.length == 0
327:       return [sp].concat(evos.map { |e| e[1] }).uniq
328:     end
329: 
330:     # This takes into account whether other_species is evolved.
331:     def breeding_can_produce?(other_species)
332:       other_family = GameData::Species.get(other_species).get_family_species
333:       if @offspring.length > 0
334:         return (other_family & @offspring).length > 0
335:       end
336:       return other_family.include?(@species)
337:     end
338: 
339:     # If this species doesn't have egg moves, looks at prevolutions one at a
340:     # time and returns theirs instead.
341:     def get_egg_moves
342:       return @egg_moves if !@egg_moves.empty?
343:       prevo = get_previous_species
344:       return GameData::Species.get_species_form(prevo, @form).get_egg_moves if prevo != @species
345:       return @egg_moves
346:     end
347: 
348:     def family_evolutions_have_method?(check_method, check_param = nil)
349:       sp = get_baby_species
350:       evos = GameData::Species.get(sp).get_family_evolutions
351:       return false if evos.length == 0
352:       evos.each do |evo|
353:         if check_method.is_a?(Array)
354:           next if !check_method.include?(evo[2])
355:         elsif evo[2] != check_method
356:           next
357:         end
358:         return true if check_param.nil? || evo[3] == check_param
359:       end
360:       return false
361:     end
362: 
363:     # Used by the Moon Ball when checking if a Pokémon's evolution family
364:     # includes an evolution that uses the Moon Stone.
365:     def family_item_evolutions_use_item?(check_item = nil)
366:       sp = get_baby_species
367:       evos = GameData::Species.get(sp).get_family_evolutions
368:       return false if !evos || evos.length == 0
369:       evos.each do |evo|
370:         next if GameData::Evolution.get(evo[2]).use_item_proc.nil?
371:         return true if check_item.nil? || evo[3] == check_item
372:       end
373:       return false
374:     end
375: 
376:     def minimum_level
377:       return 1 if @evolutions.length == 0
378:       @evolutions.each do |evo|
379:         next if !evo[3]   # Check only the prevolution
380:         prevo_data = GameData::Species.get_species_form(evo[0], base_form)
381:         return 1 if !prevo_data.incense.nil?
382:         prevo_min_level = prevo_data.minimum_level
383:         evo_method_data = GameData::Evolution.get(evo[1])
384:         return prevo_min_level if evo_method_data.level_up_proc.nil? && evo_method_data.id != :Shedinja
385:         any_level_up = evo_method_data.any_level_up
386:         return (any_level_up) ? prevo_min_level + 1 : evo[2]
387:       end
388:       return 1
389:     end
