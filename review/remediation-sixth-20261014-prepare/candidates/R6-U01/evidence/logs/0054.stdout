391:     alias __orig__get_property_for_PBS get_property_for_PBS unless method_defined?(:__orig__get_property_for_PBS)
392:     def get_property_for_PBS(key, writing_form = false)
393:       key = "SectionName" if key == "ID"
394:       ret = nil
395:       if self.class.schema(writing_form).include?(key)
396:         ret = self.send(self.class.schema(writing_form)[key][0])
397:         ret = nil if ret == false || (ret.is_a?(Array) && ret.length == 0)
398:       end
399:       case key
400:       when "SectionName"
401:         ret = [@species, @form] if writing_form
402:       when "FormName"
403:         ret = nil if nil_or_empty?(ret)
404:       when "PokedexForm"
405:         ret = nil if ret == @form
406:       when "UnmegaForm", "MegaMessage", "Generation"
407:         ret = nil if ret == 0
408:       when "BaseStats"
409:         new_ret = []
410:         GameData::Stat.each_main do |s|
411:           new_ret[s.pbs_order] = ret[s.id] if s.pbs_order >= 0
412:         end
413:         ret = new_ret
414:       when "EVs"
415:         new_ret = []
416:         GameData::Stat.each_main do |s|
417:           new_ret.push([s.id, ret[s.id]]) if ret[s.id] > 0 && s.pbs_order >= 0
418:         end
419:         ret = new_ret
420:       when "Height", "Weight"
421:         ret = ret.to_f / 10
422:       when "Habitat"
423:         ret = nil if ret == :None
424:       when "Evolutions"
425:         ret = nil   # Want to use "Evolution" instead
426:       when "Evolution"
427:         if ret
428:           ret = ret.reject { |evo| evo[3] }   # Remove prevolutions
429:           ret.each do |evo|
430:             param_type = GameData::Evolution.get(evo[1]).parameter
431:             if !param_type.nil?
432:               if param_type.is_a?(Symbol) && !GameData.const_defined?(param_type)
433:                 evo[2] = getConstantName(param_type, evo[2])
434:               else
435:                 evo[2] = evo[2].to_s
436:               end
437:             end
438:           end
439:           ret.each_with_index { |evo, i| ret[i] = evo[0, 3] }
440:           ret = nil if ret.length == 0
441:         end
442:       end
443:       if writing_form && !ret.nil?
444:         base_form = GameData::Species.get(@species)
445:         if !["WildItemCommon", "WildItemUncommon", "WildItemRare"].include?(key) ||
446:            (base_form.wild_item_common == @wild_item_common &&
447:            base_form.wild_item_uncommon == @wild_item_uncommon &&
448:            base_form.wild_item_rare == @wild_item_rare)
449:           ret = nil if base_form.get_property_for_PBS(key) == ret
450:         end
451:       end
452:       return ret
453:     end
454:   end
455: end
