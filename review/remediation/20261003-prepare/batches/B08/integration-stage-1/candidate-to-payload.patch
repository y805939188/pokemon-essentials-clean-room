+
+def identity(commit, path):
+    data = contents(commit, path)
+    return {'git_blob': git('rev-parse', commit + ':' + path, ref=commit == REF).decode().strip(),
+            'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}
