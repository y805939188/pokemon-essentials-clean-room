  "status": "ALL_STATIC_DESIGNS_UNEXECUTED_CURRENT_COMPLETED_REVIEW",
  "executed": false,
  "designs": [
    {
      "id": "B03-ACT-WEATHER",
      "catalog": "WT07/09",
      "legal_minimal_input": "Stable None, valid different-ID connected Rain100 map and successful movement/enter callback; no competing writes/fade.",
      "ordered_static_expected_result": [
        "Enter writes Rain/60/0.",
        "Connected caller writes duration20.",
        "Later type-difference consumer selects fixed transition only when in-flight guard allows."
      ],
      "reverse_contrast_and_limits": "Same legal explicit transfer to an interior target has no connected post-write and retains0; same weather enter skips type/strength but connected duration20 can still be written.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-WATERFALL",
      "catalog": "WT33",
      "legal_minimal_input": "Legal badge/member/terrain/resource inputs; no direction or terrain rewrite; initial ascent/through false.",
      "ordered_static_expected_result": [
        "Facing-right waterfall can pass menu qualification and return true without ascent/count/through writes.",
        "Facing-up crest direct confirmed use activates count/ascent/through."
      ],
      "reverse_contrast_and_limits": "Crest menu qualification rejects; ordinary crest interaction only describes. Activation itself does not immediately move; existing WP12 step cleanup remains.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-STEP",
      "catalog": "FP01/02/33",
      "legal_minimal_input": "Normal map; actual completed player translation, route remains forcing with following WAIT; no ice/waterfall automatic movement/interruption/transfer; two soot layers, bag and soot≤9997.",
      "ordered_static_expected_result": [
        "First general completion notification clears first soot layer.",
        "Player post-step forcing branch gives second general notification, clears second layer, then returns.",
        "Resource/statistic increases2; global/player-period counters do not advance."
      ],
      "reverse_contrast_and_limits": "Ordinary completed step gives one general notification then player/global progression; NPC gives one; direct post-step entry only its one; an ended route does not justify two.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-FLY",
      "catalog": "WT39/40",
      "legal_minimal_input": "Direct FLY D=(M,7,5), valid creature/scene/target/resources/transfer/BGM/refresh; E nonempty,countN; optional callback has no domain/position writes; fade cleanup normal.",
      "ordered_static_expected_result": [
        "Throwing callback occurs after countN+1 and landing(M,7,5,down)/music-refresh prefix.",
        "Wait .25 and E/D clears/normaltrue are unreached; E/D remain; error propagates."
      ],
      "reverse_contrast_and_limits": "Absent/nonmutating normal callback and normal later dependencies reach wait→fade cleanup→clearE→clearD→tooltrue. Later window update is separately lawful, not continued-gameplay proof.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-BERRY",
      "catalog": "BP18",
      "legal_minimal_input": "Planted OLD first life,3h base, storedGROWTHMULCH, original lifetime0/stage1/lastT−32400, current integerT, valid Rain category, no replant/other writes.",
      "ordered_static_expected_result": [
        "Effective stage duration8100.",
        "Lifetime32400→stage5→timestampT precedes old watering; timestamp also precedes new drying."
      ],
      "reverse_contrast_and_limits": "Without mulch9h givesstage4; unplanted/nonpositive returns before common writes; replant-limit reset is separate. OLD regular display does not settle.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-SPLASH",
      "catalog": "WT31/32",
      "legal_minimal_input": "Default Rain category four-image data; valid visible odd index1, stable60/no fade; expiry reset samples .40.",
      "ordered_static_expected_result": [
        "Reset sets opacity255 then returns; ordinary hidden gate is not reached in that call."
      ],
      "reverse_contrast_and_limits": "Separate nonreset remaining .30→0/.19→255; even index0 uses droplet behavior. No actual frame/pixel claim.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    },
    {
      "id": "B03-ACT-TIME",
      "catalog": "WT41–44",
      "legal_minimal_input": "Ordinary valid new core battle; able player/nonempty valid parties/opponents/scene and preparation dependencies; separate legal map-scene tint target; stable sampled clock; no skip/interception/plugin/external rewrite/explicit time mutation.",
      "ordered_static_expected_result": [
        "Indoor nonCave shadingtrue20:00: tintneutral, new battle2.",
        "Outdoor toggle only changes tint eligibility.",
        "NonCave shadingfalse: retain new-battle default0.",
        "Map Cave forces2 before shading even with explicit validGrass environment.",
        "NonCave shadingtrue17:00/12:00 yields1/0 under either outdoor flag."
      ],
      "reverse_contrast_and_limits": "Reverse Cave metadata to Grass with shadingfalse keeps0. Tint eligibility/value and battle time are separate observations; no successful background asset/capture/pixel inference.",
      "scope_disposition": "SUPPORTED_STATIC_DESIGN_NOT_ACTUAL_PASS"
    }
  ],
