    {
      "id": "GIR-FD82-A058",
      "aggregate": [
        {
          "raw_id": "RUN-A-058",
          "confirmed_source_behavior": "正常训练家行走预览按4×4资源取首行四帧，循环0.5秒；箱名预览按单行四帧，两个命名场景均明确改循环为0.4秒。帧由运行时钟在周期内的位置决定，非从场景开启时重新计时。正常命名与载入更新确实推进预览，不只是未消费的辅助定义。",
          "confirmed_premises_and_vector": [
            {
              "premises": "有效玩家元数据、可解析且正常加载的128×128四行四列行走图；已进入玩家/NPC命名或有效继续面板；正常画面更新；运行时钟读数为0.20秒的静态时点。无插件替换。",
              "expected": "显示首行零基帧1，帧宽/高均32；普通循环0.5秒。全程静止的预览仍能满足现稿“显示行走图”，但不符合来源。"
            },
            {
              "premises": "相同正常命名环境，主题改为存储箱；有效128×32单行四帧箱图；观察同一运行时钟0.20秒。键盘模式与光标模式分开给定。",
              "expected": "两模式均显示零基帧2，循环0.4秒，帧高为整图32；不能照搬行走图高除4而切成8像素。"
            },
            {
              "premises": "以上预览在同一时钟相位新打开，正常完成第一次更新。",
              "expected": "更新按全局运行时钟取相位；不能保证每次从本次打开开始经历完整第一帧时长。实际宿主时间与像素未观察。"
            }
          ],
          "minimum_revision": "在WP17/WP65补一个实现独立的预览表：玩家/NPC/载入的4×4首行四帧、0.5秒；箱名的单行四帧、0.4秒；运行时钟相位及资源失败由各调用者另列。原NA改为明确消费者已覆盖/待补，避免要求未来采用参考精灵类。保留WP65既有缺图报错，不与本缺口混成新的资源失败问题。",
          "determinate_recheck": [
            "用有效128×128及128×32资源夹具，在时钟0.00/0.20/0.40/0.50的静态向量核对帧号与裁取高宽。",
            "核两种命名模式和载入预览确实分别使用指定周期；测试目录加正常资源对照，不能只有T35缺图例。",
            "读取修订与来源即可，不执行参考/UI；U01–U10、G01–G12、20AX保持。"
          ]
        }
      ],
