  "candidate_source_interfaces": [
    {
      "interface": "电话消费者与普通遭遇数据读取",
      "disposition": "PASS_SCOPED",
      "semantic_impact": true,
      "clauses": "WP63§5.3/§4.6 PL16、P41/P42；C112；WP36§3.1/§5.1",
      "independent_reason": "每通播放开始各取一次TP/TE，所有分段复用；电话TE在Land→Cave→Water首非空表前至多四槽均匀抽槽。直接记录查询缺请求版本退0，没有把枚举版本0/指定版本重复的既有缺陷传播到单次查询。TP合法非空队伍按成员抽样、取max当前/起始版本；空队伍与非法物种未被伪造保护。",
      "legal_positive_static_design": "合法队伍与记录，两分段重复TP/TE：同通各自固定。前四A/B/C/D权重97/1/1/1，每槽仍1/4，第五E为0；A/A/B/C使A为1/2。",
      "neighboring_reverse_static_design": "Land空取Cave，再空取Water；三表空或版本及0均无记录为空文字。普通野生选择仍按权重且独立掷数/过滤；无占位文本也不跳过电话两次采样，独立PL16调用可重抽。",
      "source_keys": [
        "phone",
        "encdata",
        "wild"
      ],
      "designs_executed": false,
      "old_disposition_at_OLD": "PASS_SCOPED",
      "old_reason_retained_only_after_NEW_delta_checks": true,
      "new_delta_impact": "No new clause/caller/data/condition in this subinterface, except repaired C109 first subinterface for B03"
    },
    {
      "interface": "普通遭遇率旗标消费者",
      "disposition": "PASS_SCOPED",
      "semantic_impact": true,
      "clauses": "WP63§6/P29/P44；C113；WP36§4.2",
      "independent_reason": "WP36继续先消费lower，再消费higher，改变概率与宽限门；本候选修正旗标生命周期为当前地图期间保存、新图设置清false。率清理与重装遭遇表、累加器保留分开，没有改变权重/缺表R07或主动请求返回合同。",
      "legal_positive_static_design": "普通March后lower=false/higher=true，正常消费者可读该修正；进入另一图新图设置完成且无再写，两者false，消费者不再套March的higher倍率。",
      "neighboring_reverse_static_design": "Custom全局覆盖A可保留而率效果清；其他道具/特性修正依旧独立。表存在和倍率变化均不证明下一次遭遇一定发生，也不证明地图媒体。",
      "source_keys": [
        "jukebox",
        "newmap",
        "mapstate",
        "wild"
      ],
      "designs_executed": false,
