        "facts": [
          "Deletion first removes the default primary;only after success checks/removes its single adjacent .bak.",
          "The UI catches SystemCallError raised by that sequence and requests its failure message;it has no restoration step.",
          "Explicit title deletion returns to title after handled failure. Its next load-object construction checks only the primary path. A remaining .bak alone is not discovered from an absent primary.",
          "No claim that every failure leaves a particular state:the second-delete failure vector explicitly fixes each completed I/O result."
        ],
        "finite_premises": [
          "Default primary P and P.bak are ordinary files;main valid/current-format/current-version so the loader constructor reaches the explicit deletion screen without earlier conversion or invalid-save prompt.",
          "User approves both serious confirmations;stat says P.bak exists;all prompts/title operations succeed.",
          "No concurrent changes,plugin override,extra .bak.bak deletion,or implicit host recovery.",
          "First removal succeeds and makes P absent;second removal raises SystemCallError without removing P.bak."
        ],
        "vectors": [
          {
            "id": "KER001-CANCEL",
            "input": "Reject either explicit title confirmation.",
            "expected": "No deletion attempt;P and P.bak remain;return title.",
            "status": "DERIVED_VECTOR / NOT_EXECUTED"
          },
          {
            "id": "KER001-ALL-OK",
            "input": "Both removals succeed.",
            "expected": "P and P.bak absent;success message;return title;next loader has empty data.",
            "status": "DERIVED_VECTOR / NOT_EXECUTED"
          },
          {
            "id": "KER001-FIRST-FAIL",
            "input": "First removal raises without removing P.",
            "expected": "P and P.bak remain;backup removal not reached;failure message;next primary gate remains true.",
            "status": "DERIVED_VECTOR / NOT_EXECUTED"
          },
          {
            "id": "KER001-SECOND-FAIL",
            "input": "First success,second failure as premises.",
            "expected": "P absent/P.bak present;failure message;no retry/rollback;next primary gate false,so no backup read and no continue.",
            "status": "DERIVED_VECTOR / NOT_EXECUTED"
          },
          {
            "id": "KER001-NO-BAK",
            "input": "Primary removal succeeds,adjacent .bak absent.",
            "expected": "No backup removal;success message.",
            "status": "DERIVED_VECTOR / NOT_EXECUTED"
          }
        ],
        "cancel_exception_partial_commit": "The invalid-save prompt is a distinct caller:refusal invokes exit;consent calls deletion then resets game/options objects even after handled SystemCallError and returns empty data. A failure of the message or a non-SystemCallError is outside this catch;postfailure title/reset is not guaranteed then.",
        "preserve_scope": [
          "Deletion confirmations/refusal/title return,error class,message requests,and single adjacent backup only.",
          "Recursive invalid-save backup reading is a different operation;do not invent recursive deletion or universal backup recovery.",
          "Future implementation atomicity policy is not decided by documenting fixed reference behavior.",
          "Emergency-save double-message and new-game overwrite-flag facets are distinct and not part of this finding."
        ],
        "no_required_rewrite": [
          "UI65:65/245 are already correct;only add a primary reference if navigation needs it.",
          "No blanket rewrite of WP09/10 or every UI save test."
        ],
        "acceptance": [
          "At least bothsuccess,firstfailure,secondfailure,cancel and no-backup controls name file states and UI requests separately.",
          "Secondfailure specifically says absent primary/present backup and no primary-based reload;do not claim disk rollback.",
          "All new vectors remain DERIVED_VECTOR/NOT_EXECUTED until actual scoped run."
        ],
        "excluded_claims": [
          "No actual filesystem failure reproduction",
          "No entire-system or complete-host verification",
          "No requirement to reproduce a reference defect in future architecture"
        ]
