      "id": "GR3-M10-001",
      "premises": [
        "正常队伍[A,B]，二者非蛋非Shadow，A索引0持POTION，B索引1无持物；均存活。",
        "Box Link三门成立；普通菜单Item→Move来源A；背包POTION起始0且可添加1；正常资源/媒体/世界上下文、无插件改写。",
        "目标选择中SPECIAL进入盒子整理，不移动队伍位置。在队伍面板选A→Item→确认取回；成功后正常离开盒子。"
      ],
      "scenarios": [
        {
          "input": "返回原移位目标选择后确认B索引1。",
          "expected": "背包POTION=1；A无持物；B持POTION。总POTION从1成为2。来源对象与队伍索引均没改变，故不依赖缩队/失效索引。"
        },
        {
          "input": "独立同初态，取回后返回原目标选择按BACK。",
          "expected": "背包POTION=1；A/B均无持物。取回不回滚，尚无旧物品提交。"
        },
        {
          "input": "独立同初态，不进入盒子，直接选B。",
          "expected": "背包POTION=0；A空；B持POTION，总量仍1。"
        }
      ],
      "acceptance_criteria": [
