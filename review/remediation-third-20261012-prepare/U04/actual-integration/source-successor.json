      "premises": [
        "合法默认NaturalGift槽、PP正、可行动；实际伤害且单目标，U持有效ORAN、有效PARENTALBOND；没有抢夺、反射、压制、替身、画皮/冰脸、保护、其它免疫/失手/异常/共生。",
        "该状态可由普通技能交换从盟友取得PARENTALBOND；不依赖执行参考或改参考字节。静态夹具只假定当前合法战斗状态，不声称已操作获得链。",
        "U总HP160、当前81，目标持有效JABO、可食果且首击后仍存活；U可间伤/恢复；没有RIPEN/CHEEKPOUCH等额外改写；双方零阶，当前代。"
      ],
      "scenarios": [
        {
          "name": "self_consumption_then_second_hit",
          "input": "U H160/h81持ORAN；目标JABO且耐久足以生存首击；两击计划",
          "expected_static": [
            "首击正常基底80，目标损失已提交。",
            "目标JABO扣U20：81→61；U半血ORAN回复10：61→71并消费当前ORAN，C空，I若相同清，R/P写ORAN。",
            "第二击普通基底查询遇空当前物品身份，产生NoMethodError类异常，尚未调用物品get或默认1分支；首击伤害/树果反应/持久写回不回滚。"
          ],
          "execution": "NOT_EXECUTED"
        },
        {
          "name": "no_self_consumption_boundary",
          "input": "仅将U当前HP改101，其余不变",
          "expected_static": [
            "JABO扣20后81>80，ORAN不触发；第二击仍以ORAN基底80完成；正常后段才消费此时ORAN。"
          ],
          "execution": "NOT_EXECUTED"
        },
        {
          "name": "one_hit_control",
          "input": "仅移除有效PARENTALBOND，其余同主夹具",
          "expected_static": [
            "首击仍自耗至71，计划单击不再访问基底；正常使用结束看到空物品，局部守卫跳消费。"
          ],
          "execution": "NOT_EXECUTED"
        }
      ],
      "acceptance_criteria": [
        "仅最终规格即可确定主夹具的首击提交、U71/160且空持物以及续击首次失败位置。",
        "高HP对照和单击对照可分别推出正常第二击/没有再次基底访问。",
        "不把失败写为必然进程崩溃，不声称运行验证，不把空持物送get后才失败。"
      ],
      "unknowns": [
        "外层诊断呈现及后续宿主恢复没有执行；不从局部异常保证继续/崩溃。",
        "未来实现选择兼容异常或采取有记录的差异由用户决定。"
      ],
