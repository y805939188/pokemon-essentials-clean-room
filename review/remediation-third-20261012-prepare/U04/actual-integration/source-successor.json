          "commit": "167296dbe9e2384627b0ed696e87aeb01f211252",
          "tree": "33598d8a2a3acdd093cc4fe23f48eea8666100f3",
          "path": "deliverables/final-specification-set/test-catalog/combat-requirements-wp39-40-41-42-45.md",
          "git_blob": "a0b11926f6dcfc601004852b86adaa0c314be75e",
          "loci": "CM-20 L58；E04 L148；无失败保留身份→晚终局再退款库存的组合设计",
          "note": "既有单阶段退款与正常终局设计不能区别一次与重复退款的整链输出"
        }
      ],
      "premises": [
        "普通内部野生2v1、无伙伴、两名玩家活跃成员可选物品且一直存活；同队非在场可战斗成员T的HP=总HP−1，无蛋/查封/超频；背包Potion恰2且可接收退款。",
        "两名玩家分别正常登记Potion到同一T；所有登记资格通过；无插件、额外处理器、重入或取消。两者按物品阶段顺序执行，第一件把T治满，第二件资格失败。",
        "唯一野生成员已普通中毒且当前HP1，原始状态毒计数0，无毒疗/魔法防守或其它治疗；本轮合法非伤害行动不伤玩家、不清毒、不改变背包；本轮回合末毒伤后正常终局。",
        "保持第二件的玩家使用者存活、没有其换人/失能/选择撤销或新命令阶段；容量足够，普通诊断/演出正常返回。"
      ],
      "scenarios": [
        {
          "kind": "normal_late_terminal",
          "steps": [
            "库存2→登记两件→0；T仍缺1HP",
            "第一件补T至满HP并清其消费身份",
            "第二件失败退款：库存0→1；消费身份仍存在",
            "回合末唯一野生因毒伤倒下；裁判胜利，进入正常终局",
            "撤销第二件的选择，再次退Potion：库存1→2"
          ],
          "expected_reference_static": {
            "Potion_final": 2,
            "successful_healing_items": 1,
            "target_HP": "full",
            "decision": 1
          },
          "execution": "NOT_EXECUTED"
        },
        {
          "kind": "continues_reverse",
          "change": "唯一野生能撑过回合末且没有其它终局源，进入下一命令阶段",
          "expected_reference_static": "库存保持1；新命令阶段直接清选择，不再退款",
          "execution": "NOT_EXECUTED"
        },
        {
          "kind": "faint_boundary",
          "change": "第二件使用者在终局前正式失能，其选择由濒死清除",
          "expected_reference_static": "本条重复退款消费者不再命中，不能统一称所有失败物品都重复退款",
          "execution": "NOT_EXECUTED"
        }
      ],
      "acceptance_criteria": [
        "正式参考行为层明确资格失败退款后该消费身份仍保留。",
        "静态整链向量能唯一推出本例终局Potion2，继续到下一命令期对照Potion1。",
        "限定使用者存活、无中间清选择、正常终局和退款容量，失能反例不得误套。",
        "WP28/WP40/WP42和对应测试一致；未来是否修正历史缺陷单列用户裁决。"
      ],
      "unknowns": [
        "未运行宿主/菜单/战斗；实际输入交互与演出资源未认证。",
        "其它处理器重入/异常/满背包退款不纳入本例。"
      ],
