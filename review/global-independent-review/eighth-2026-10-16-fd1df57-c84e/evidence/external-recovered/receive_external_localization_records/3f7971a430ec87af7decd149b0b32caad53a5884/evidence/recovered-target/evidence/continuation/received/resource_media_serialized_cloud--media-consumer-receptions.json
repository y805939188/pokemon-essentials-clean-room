        "facts": [
          {
            "id": "UI17-F052-01",
            "assertion": "合法bitmap/正width/非零height/非空text通过早返门后才解析controls。"
          },
          {
            "id": "UI17-F052-02",
            "assertion": "controls位置按解实体后的普通字符长度计算。"
          },
          {
            "id": "UI17-F052-03",
            "assertion": "主循环条件position<textchars.length。"
          },
          {
            "id": "UI17-F052-04",
            "assertion": "纯独img或文尾img没有后续普通字符，因此该位置控制不消费，不发该图加载请求。"
          },
          {
            "id": "UI17-F052-05",
            "assertion": "文尾icon同样不消费；不能把图像资源失败套无请求分支。"
          },
          {
            "id": "UI17-F052-06",
            "assertion": "有后续普通字符的位置，开icon拼Graphics/Icons/参数，去尾空白。"
          },
          {
            "id": "UI17-F052-07",
            "assertion": "开img只取参数0为身份，去尾空白再split管线。"
          },
          {
            "id": "UI17-F052-08",
            "assertion": "img带附参时按参数1..4分别to_i作为源矩形。"
          },
          {
            "id": "UI17-F052-09",
            "assertion": "无附参每次图形局部默认graphicX0/graphicY4。"
          },
          {
            "id": "UI17-F052-10",
            "assertion": "无显式宽时直接Bitmap.new(graphic)测量宽高；此语义单位没有显式RPG::Cache调用。"
          },
          {
            "id": "UI17-F052-11",
            "assertion": "测量加载成功才读宽高并dispose临时bitmap。"
          },
          {
            "id": "UI17-F052-12",
            "assertion": "测量无本地rescue/ensure，异常不承诺旧font恢复或清理临时对象。"
          },
          {
            "id": "UI17-F052-13",
            "assertion": "图像生成格式项含身份/位置/源矩形/颜色alpha，仍不代表真实像素。"
          },
          {
            "id": "UI17-F052-14",
            "assertion": "图像项不增加普通字符position，后续同位置其它控制及该字符仍处理。"
          },
          {
            "id": "UI17-F052-15",
            "assertion": "drawSingleFormattedChar图形分支直接Bitmap.new(ch[0])，不是AnimatedBitmap或显式Cache调用。"
          },
          {
            "id": "UI17-F052-16",
            "assertion": "加载成功才blt源矩形并按ch8.alpha，再dispose。"
          },
          {
            "id": "UI17-F052-17",
            "assertion": "draw图形分支无本地rescue/ensure；drawFormattedChars正常末尾才恢复font。"
          },
          {
            "id": "UI17-F052-18",
            "assertion": "实际宿主Bitmap资源搜索、解码与像素结果保持未执行/具名接口，不由这里证明。"
          }
