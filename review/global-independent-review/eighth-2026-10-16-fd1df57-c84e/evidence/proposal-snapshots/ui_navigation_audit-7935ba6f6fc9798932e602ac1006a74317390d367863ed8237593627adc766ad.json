      "premises": [
        "合法地图与可变非空地图元数据原名，含一个大写玩家名称占位；不是冻结字符串。",
        "当前语言game/core MAP_NAMES域均为空，无替代字符串；无缓存别名、外部写入、插件、重载或回调改名。",
        "全局玩家名Alice，保存前该原名尚未展开；地图/UI/消息依赖正常返回。",
        "通过脚本保存画面入口，或满足Save菜单可见门的暂停保存入口；普通首次保存确认选No。"
      ],
      "ordinary_control": [
        "原名为不含占位的Town时，打开再拒绝不会因该替换改变名称文本。",
        "含占位例若地图名已先读过并展开，同次保存拒绝无新的可见名称替换；不能用这一对照否认首次读取前提。"
      ],
      "minimal_counterexample": {
        "before": {
          "player_name": "Alice",
          "map_real_name": "\\PN Place",
          "map_name_tables": "game/core空",
          "save_called": false
        },
        "steps": [
          "从未读过该名称的合法状态打开共享保存画面。",
          "信息窗创建时读取当前地图名；该查询先于首次保存确认。",
          "在普通保存确认选择No，正常收尾返回false。",
          "检查同一地图名称材料或随后同材料读名。"
        ],
        "reference_expected": "同一原名材料已为Alice Place，返回false且未调用Game.save；名称修改不因拒绝回撤。",
        "current_spec_claim": "§4.1普通确认拒绝返回false后括注无副作用；该绝对限定排除了已经发生的显示读取修改。",
        "difference": "回滚/纯读取保证过强；内存名称材料变化和文件持久写入必须分开。"
      },
      "branches": {
        "normal_success": "确认通过仍先完成同一名称读取，再走既有持久层保存；不重写保存成功合同。",
        "ordinary_refusal": "展示读取已提交，普通No只跳过保存，返回false。",
        "overwrite_refusal": "展示读取亦早于覆盖确认；拒绝覆盖不回撤该前缀。",
        "save_false": "已先读取并可能改名，保存失败也不由UI恢复；现有不回滚限定保留。",
        "exception": "名称读取前失败不套成功反例；读取后显示/确认/收尾异常只保已发生前缀，不保证收尾/外层恢复。",
        "partial_commit": "唯一新增刻画是共享名称内存替换已发生而文件保存未发生；不声称其它状态必须变化。"
      },
      "negative_evidence": {
        "inspected": "全文Save.rb1–139/Pause1–321/StartGame1–126/SceneMap1–252、固定名称完整getter与消息查找单元，及WP65全263行。",
        "searched": "所有Data/Scripts的pbSaveScreen调用、保存入口与名称定义；没有在该UI拒绝分支发现名称副本或恢复逻辑。",
        "counterargument": "§4.1末句已有取消不代表回滚、确认前更改不回滚；该句正确且必须保留，但与同节无副作用未限定到仅保存动作的文字冲突。",
        "unknown": "真实地图事件/Demo是否在首次保存前已读名称不作保证；最小例为合法可审有限入口夹具，无运行观察。"
      },
      "minimal_revision": {
        "rule": "普通保存确认拒绝时返回false且不调用持久层保存；不撤销确认前由信息展示等已发生的状态变化，地图名共享读取遵循WP11§5.3.1。",
        "preserve": [
          "原确认顺序、false返回、选择音、资源正常收尾与暂停菜单重显。",
          "覆盖拒绝/保存失败不回滚既有修改的正确限定。",
          "WP11共享名称替换的有限输入前提及不自动落盘边界。",
          "已有普通短名T11/T12/T13、退出保存结果不检查T14、语言整体直写T06b等不相关正确合同。"
        ],
