  {
    "id": "GR3-M01-002",
    "source_pointer": "/R3_R4/qualification/records/1",
    "meaning": {
      "round": "R3",
      "batch_owner": "GR3-U01",
      "original_effective_scope": {
        "historical_relation": "新能力分支，区别于 A006 导出目标语言和 A013/A018 导入节识别；无旧 ID 重开。",
        "premises": [
          "默认 game 消息已有效载入，事件域按地图编号分桶；共享桶0为空，地图1桶缺席，地图5桶含一个非空哈希条目；不存在更早非空桶。",
          "目标导出路径可写，默认语料及宿主调用正常；完整提取会先按既有确认流程清除旧文件。",
          "逐地图导出对照另假定 MapInfos 可读；本轮快照没有真实地图，不假定该夹具默认启用。"
        ],
        "unknowns": [
          "随附编译默认消息未反序列化，无法判断实际内容是否满足；真实地图和宿主执行=0。"
        ]
      },
      "B5_result": "supported",
      "criteria": [
        {
          "B5_qualification": {
            "assessment": "R313–319检查遇nil停止，零长桶不停；R322–326写出遍历会跳空后继续。WP08§6.2.1/LZ23–25保留区别。",
            "boundary": "Static source/specification regression only; no reference/model/host execution, no transfer of historical acceptance.",
            "evidence_level": "supported_static",
            "status": "supported"
          },
          "B5_status": "supported",
          "criterion": "空0、缺1、有效5合并不产 EVENT_TEXTS，逐图对照可产 Map005，前置非空桶使合并写出较晚5。",
          "id": "GR3-M01-002/C01",
          "kind": "static_or_boundary",
          "use": "Historical B5 finite static comparison; not an R7 source or runtime signoff"
        },
        {
          "B5_qualification": {
            "assessment": "R266–280先确认并删除文件，随后才检查稀疏桶；R300–310分文件跳过空桶继续。LZ23旧文件不重建与LZ24 Map005条件输出成立。",
            "boundary": "Static source/specification regression only; no reference/model/host execution, no transfer of historical acceptance.",
            "evidence_level": "supported_static",
            "status": "supported"
          },
          "B5_status": "supported",
          "criterion": "确认覆盖后旧文件可能已删而新事件域未重建，保持先删除时序。",
          "id": "GR3-M01-002/C02",
          "kind": "static_or_boundary",
