    "meaning": {
      "round": "R3",
      "batch_owner": "GR3-U01",
      "original_effective_scope": {
        "historical_relation": "与 GIR-FD82-A013/A018 的节名和数字首键问题相邻但不同根因；不重开 LZ08–LZ11 已明示失败。",
        "premises": [
          "使用成功的作者导出/导入调用；明确非地图 SCRIPT_TEXTS 节；原始键为非空非数字 K，原文有效且默认语料存在。",
          "首例语言译文已为有效空字符串；完整导入另要求旧产物存在且输出成功以覆盖模式打开。",
          "井号例译文首字符为 U+0023；空格例译文为前后各一个 ASCII 空格的非空词。"
        ],
        "unknowns": [
          "真实宿主异常提示、文件系统失败及全量语料受影响数量未验证。"
        ]
      },
      "B5_result": "supported",
      "criteria": [
        {
          "B5_qualification": {
            "assessment": "导出350–371保留有效空译；分节154–181删除空行后，397–435按非数字K哈希奇数拒绝。WP08§6.3.1/LZ18及先截断边界准确。",
            "boundary": "Static source/specification regression only; no reference/model/host execution, no transfer of historical acceptance.",
            "evidence_level": "supported_static",
            "status": "supported"
          },
          "B5_status": "supported",
          "criterion": "正文、测试目录和追溯一致；空译单条哈希先删除空行再因奇数拒绝，完整导入已截断输出。",
          "id": "GR3-M01-001/C01",
          "kind": "static_or_boundary",
          "use": "Historical B5 finite static comparison; not an R7 source or runtime signoff"
        },
        {
          "B5_qualification": {
            "assessment": "原列首#删，前置空格#保留后strip；普通边空格未受214–240转义保护，制表符先转义再恢复。LZ19–22逐项相符。",
            "boundary": "Static source/specification regression only; no reference/model/host execution, no transfer of historical acceptance.",
            "evidence_level": "supported_static",
            "status": "supported"
          },
          "B5_status": "supported",
          "criterion": "井号列首与前置空格井号对照保留，普通端部空格与转义控制字符对照保留。",
          "id": "GR3-M01-001/C02",
          "kind": "static_or_boundary",
          "use": "Historical B5 finite static comparison; not an R7 source or runtime signoff"
        },
        {
          "B5_qualification": {
            "assessment": "LZ03空译运行命中、LZ08–11数字形态/Map门仍准确。所有新向量明确NOT_EXECUTED，未宣称往返实测。",
            "boundary": "Static source/specification regression only; no reference/model/host execution, no transfer of historical acceptance.",
            "evidence_level": "supported_static",
            "status": "supported"
          },
          "B5_status": "supported",
          "criterion": "不将本轮静态推导标为已运行往返；保留原 LZ03、LZ08–LZ11 的有效前提与结果。",
          "id": "GR3-M01-001/C03",
          "kind": "static_or_boundary",
          "use": "Historical B5 finite static comparison; not an R7 source or runtime signoff"
        }
