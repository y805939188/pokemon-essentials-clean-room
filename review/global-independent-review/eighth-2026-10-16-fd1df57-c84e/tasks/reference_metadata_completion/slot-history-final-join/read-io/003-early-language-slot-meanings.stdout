    {
      "id": "GR3-M01-001",
      "source_pointer": "/R3_R4/qualification/records/0",
      "meaning": {
        "round": "R3",
        "batch_owner": "GR3-U01",
        "original_effective_scope": {
          "historical_relation": "与 GIR-FD82-A013/A018 的节名和数字首键问题相邻但不同根因；不重开 LZ08–LZ11 已明示失败。",
          "premises": [
            "使用成功的作者导出/导入调用；明确非地图 SCRIPT_TEXTS 节；原始键为非空非数字 K，原文有效且默认语料存在。",
            "首例语言译文已为有效空字符串；完整导入另要求旧产物存在且输出成功以覆盖模式打开。",
            "井号例译文首字符为 U+0023；空格例译文为前后各一个 ASCII 空格的非空词。"
          ],
