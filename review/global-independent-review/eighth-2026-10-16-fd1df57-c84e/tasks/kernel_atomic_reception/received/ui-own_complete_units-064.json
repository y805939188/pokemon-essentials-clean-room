        },
        {
          "id": "UILC-F024-12",
          "assertion": "get_text先取Settings.game_credits或新空数组。"
        },
        {
          "id": "UILC-F024-13",
          "assertion": "当前Settings.game_credits每次返回新建11行数组；不是共享常量。"
        },
        {
          "id": "UILC-F024-14",
          "assertion": "默认游戏署名含可翻译标题和Maruno/Pizza等字面配置。"
        },
        {
          "id": "UILC-F024-15",
          "assertion": "存在插件时先追加三个空行。"
        },
        {
          "id": "UILC-F024-16",
          "assertion": "插件枚举沿PluginManager.plugins的注册keys。"
        },
        {
          "id": "UILC-F024-17",
          "assertion": "各插件标题含名称和版本。"
        },
        {
          "id": "UILC-F024-18",
          "assertion": "各插件作者由PluginManager.credits返回后交给分栏辅助。"
        },
        {
          "id": "UILC-F024-19",
          "assertion": "随后追加固定Essentials创建者/贡献者段。"
        },
        {
          "id": "UILC-F024-20",
          "assertion": "固定段还含mkxp-z、RPG Maker XP与Pokémon权利人。"
        },
        {
          "id": "UILC-F024-21",
          "assertion": "最终含非营利/版权/支持正版三行文案。"
        },
        {
          "id": "UILC-F024-22",
          "assertion": "main先@quit=false并记录System.uptime。"
        },
        {
          "id": "UILC-F024-23",
          "assertion": "初始背景索引0。"
        },
        {
          "id": "UILC-F024-24",
          "assertion": "trim为画面高度整除10。"
        },
        {
          "id": "UILC-F024-25",
          "assertion": "初始滚动原点为负画面高度加trim。"
        },
        {
          "id": "UILC-F024-26",
          "assertion": "完整文字生成先于视口和文字精灵分配。"
        },
        {
          "id": "UILC-F024-27",
          "assertion": "背景首图经IconSprite.setBitmap直接请求。"
        },
        {
          "id": "UILC-F024-28",
          "assertion": "文字总高度为行数乘32。"
        },
        {
          "id": "UILC-F024-29",
          "assertion": "每文字位图容纳画面高度整除32行；位图本身额外16高。"
        },
        {
          "id": "UILC-F024-30",
          "assertion": "尾部<s>先补空格再分割，保留空第二栏。"
        },
        {
          "id": "UILC-F024-31",
          "assertion": "单列居中。"
        },
        {
          "id": "UILC-F024-32",
          "assertion": "分栏左段右对齐、右段左对齐，中缝20像素。"
        },
        {
          "id": "UILC-F024-33",
          "assertion": "各段先影字、再八次描边、再正字。"
        },
        {
          "id": "UILC-F024-34",
          "assertion": "先存previousBGM，再停ME/BGS/SE。"
        },
        {
          "id": "UILC-F024-35",
          "assertion": "先请求BGM淡出2秒，再请求Credits BGM。"
        },
        {
          "id": "UILC-F024-36",
          "assertion": "进入循环前Graphics.transition。"
        },
        {
          "id": "UILC-F024-37",
          "assertion": "每轮Graphics.update、Input.update、update后检查@quit。"
        },
        {
          "id": "UILC-F024-38",
          "assertion": "update先按已过时间/11取背景索引再检查取消。"
        },
        {
          "id": "UILC-F024-39",
          "assertion": "背景变化先写索引后加载新图，失败保留该索引前缀。"
