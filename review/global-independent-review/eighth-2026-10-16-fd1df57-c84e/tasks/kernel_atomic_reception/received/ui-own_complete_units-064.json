      "facts": [
        {
          "id": "UILC-F024-01",
          "assertion": "默认背景依次credits1到credits5，共5张。"
        },
        {
          "id": "UILC-F024-02",
          "assertion": "默认BGM为Credits。"
        },
        {
          "id": "UILC-F024-03",
          "assertion": "默认滚速40像素每秒。"
        },
        {
          "id": "UILC-F024-04",
          "assertion": "每背景名义11秒。"
        },
        {
          "id": "UILC-F024-05",
          "assertion": "文字色白255/255/255/255。"
        },
        {
          "id": "UILC-F024-06",
          "assertion": "描边色0/0/128/255。"
        },
        {
          "id": "UILC-F024-07",
          "assertion": "影色0/0/0/100。"
        },
        {
          "id": "UILC-F024-08",
          "assertion": "add_names长度至少5时每相邻两名以<s>合并。"
        },
        {
          "id": "UILC-F024-09",
          "assertion": "奇数末名第二列为空字符串。"
        },
        {
          "id": "UILC-F024-10",
          "assertion": "不足5名逐名独行。"
        },
        {
          "id": "UILC-F024-11",
