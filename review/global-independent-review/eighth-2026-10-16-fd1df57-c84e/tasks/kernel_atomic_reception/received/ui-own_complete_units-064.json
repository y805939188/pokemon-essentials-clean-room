        },
        {
          "id": "UILC-F024-41",
          "assertion": "BACK没有片尾跳过分支。"
        },
        {
          "id": "UILC-F024-42",
          "assertion": "取消成立该轮不做last?与滚动写入。"
        },
        {
          "id": "UILC-F024-43",
          "assertion": "last?以旧@realOY大于总高度加trim为结束门。"
        },
        {
          "id": "UILC-F024-44",
          "assertion": "自然结束检查通过时不再滚动更新。"
        },
        {
          "id": "UILC-F024-45",
          "assertion": "否则@realOY由40乘总已过时间计算，不累加帧常数。"
        },
        {
          "id": "UILC-F024-46",
          "assertion": "每个文字精灵原点由公共滚动值减位图索引高度。"
        },
        {
          "id": "UILC-F024-47",
          "assertion": "循环结束先快照写game_temp.background_bitmap。"
        },
        {
          "id": "UILC-F024-48",
          "assertion": "随后BGM淡出2秒与Graphics.freeze。"
        },
        {
          "id": "UILC-F024-49",
          "assertion": "两个视口先置黑，再Graphics.transition(8,fadetoblack)。"
        },
        {
          "id": "UILC-F024-50",
          "assertion": "正常过渡返回才释放快照、背景、各文字精灵、两视口。"
        },
        {
          "id": "UILC-F024-51",
          "assertion": "释放之后才写creditsPlayed=true。"
        },
        {
          "id": "UILC-F024-52",
          "assertion": "之后恢复previousBGM。"
        },
        {
          "id": "UILC-F024-53",
          "assertion": "之后有game_map则新建Scene_Map，否则scene=nil。"
        },
        {
          "id": "UILC-F024-54",
          "assertion": "没有SaveData/Game.save调用，内存标记不等于持久保存。"
        },
        {
          "id": "UILC-F024-55",
          "assertion": "没有ensure，任何异常只保留已执行前缀。"
