      "facts": [
        {
          "id": "UI65-F023-01",
          "assertion": "initialize先newGame_Temp与Game_System。"
        },
        {
          "id": "UI65-F023-02",
          "assertion": "依次load animations/tilesets/common_events/system。"
        },
        {
          "id": "UI65-F023-03",
          "assertion": "再battleanimations与GameData.load_all。"
        },
        {
          "id": "UI65-F023-04",
          "assertion": "起点ID0或地图不存在抛起点错误。"
        },
        {
          "id": "UI65-F023-05",
          "assertion": "set_up_system有文件才read_from_file。"
        },
        {
          "id": "UI65-F023-06",
          "assertion": "无文件数据空Hash。"
        },
        {
          "id": "UI65-F023-07",
          "assertion": "成功读取后empty?真initialize_bootup_values。"
        },
        {
          "id": "UI65-F023-08",
          "assertion": "非空load_bootup_values。"
        },
        {
          "id": "UI65-F023-09",
          "assertion": "同一有文件可读旧序列也可为空，必须走默认。"
        },
        {
          "id": "UI65-F023-10",
          "assertion": "再pbSetResizeFactor min(stored,4)。"
        },
        {
          "id": "UI65-F023-11",
          "assertion": "LANGUAGES空不加载语言消息。"
        },
        {
          "id": "UI65-F023-12",
          "assertion": "配置非空且数据空且候选至少2才chooseLanguage。"
        },
        {
          "id": "UI65-F023-13",
          "assertion": "选择后或非空数据按当前索引load_message_files。"
        },
        {
          "id": "UI65-F023-14",
          "assertion": "start_new先清事件starting和common_event_id。"
        },
        {
          "id": "UI65-F023-15",
          "assertion": "写begun_new_game=true后清解释器。"
        },
        {
          "id": "UI65-F023-16",
          "assertion": "先scene=Scene_Map再load_new_game_values。"
        },
        {
          "id": "UI65-F023-17",
          "assertion": "会话计时/计数再地图工厂/玩家坐标与encounter/autoplay/update。"
        },
        {
          "id": "UI65-F023-18",
          "assertion": "load先验证Hash。"
        },
        {
          "id": "UI65-F023-19",
          "assertion": "load_all_values之后才更新时间/会话计数/load_map。"
        },
        {
          "id": "UI65-F023-20",
          "assertion": "load_map后autoplay/update/mapcache，再scene=Scene_Map。"
        },
        {
          "id": "UI65-F023-21",
          "assertion": "save先验证path与safe型。"
        },
        {
          "id": "UI65-F023-22",
          "assertion": "写safesave。"
        },
        {
          "id": "UI65-F023-23",
          "assertion": "再save_count+1。"
        },
        {
          "id": "UI65-F023-24",
          "assertion": "再magic_number。"
        },
        {
          "id": "UI65-F023-25",
          "assertion": "再set_time_last_saved。"
        },
        {
          "id": "UI65-F023-26",
          "assertion": "上述字段准备先于begin里的磁盘写。"
        },
        {
          "id": "UI65-F023-27",
          "assertion": "save_to_file成功后frame_reset。"
        },
        {
          "id": "UI65-F023-28",
          "assertion": "仅IOError/SystemCallError被捕获。"
        },
        {
          "id": "UI65-F023-29",
          "assertion": "捕获时仅save_count减1后false。"
        },
        {
          "id": "UI65-F023-30",
          "assertion": "magic/time/safesave不被该局部恢复。"
        },
        {
          "id": "UI65-F023-31",
          "assertion": "其它异常向外。"
        },
        {
          "id": "UI65-F023-32",
          "assertion": "正常返回true。"
        }
