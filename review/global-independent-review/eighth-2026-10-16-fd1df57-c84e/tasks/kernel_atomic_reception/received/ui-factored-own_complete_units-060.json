        },
        {
          "id": "UI65-F024-06",
          "assertion": "旧适配每registration调用get_from_old_format。"
        },
        {
          "id": "UI65-F024-07",
          "assertion": "nil结果不加入Hash。"
        },
        {
          "id": "UI65-F024-08",
          "assertion": "默认17注册没有old extraction，所以合法可读旧序列可适配空。"
        },
        {
          "id": "UI65-F024-09",
          "assertion": "空数据跳过run_conversions及写回。"
        },
        {
          "id": "UI65-F024-10",
          "assertion": "非空且conversion真才wb写回。"
        },
        {
          "id": "UI65-F024-11",
          "assertion": "正常save先compile_save_hash。"
        },
        {
          "id": "UI65-F024-12",
          "assertion": "再wb打开截断并Marshal.dump。"
        },
        {
          "id": "UI65-F024-13",
          "assertion": "delete先主档File.delete。"
        },
        {
          "id": "UI65-F024-14",
          "assertion": "再backup存在才File.delete。"
        },
        {
          "id": "UI65-F024-15",
          "assertion": "backup失败不恢复已删主档。"
        },
        {
          "id": "UI65-F024-16",
          "assertion": "UI捕获/提示与此顺序不得提升原子性。"
        }
