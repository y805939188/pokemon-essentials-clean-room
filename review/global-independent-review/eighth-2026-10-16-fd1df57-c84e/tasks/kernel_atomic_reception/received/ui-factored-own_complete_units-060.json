          "id": "UI65-F024-01",
          "assertion": "FILE_PATH依data_directory存在取该目录或相对Game.rxdata。"
        },
        {
          "id": "UI65-F024-02",
          "assertion": "exists?只File.file?主档。"
        },
        {
          "id": "UI65-F024-03",
          "assertion": "首个Marshal对象Hash时直接用该Hash。"
        },
        {
          "id": "UI65-F024-04",
          "assertion": "首个非Hash则持续读至EOF收旧序列。"
        },
        {
