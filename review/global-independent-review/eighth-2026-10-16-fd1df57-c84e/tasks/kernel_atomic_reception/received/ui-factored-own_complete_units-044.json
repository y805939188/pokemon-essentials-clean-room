          "assertion": "先记oldscene。"
        },
        {
          "id": "UI65-F006-02",
          "assertion": "立即scene=nil。"
        },
        {
          "id": "UI65-F006-03",
          "assertion": "先显示脚本过久消息。"
        },
        {
          "id": "UI65-F006-04",
          "assertion": "无player直接return，不能搬用正常尾部恢复。"
        },
        {
          "id": "UI65-F006-05",
          "assertion": "有player且SaveData.exists?才复制旧档。"
        },
        {
          "id": "UI65-F006-06",
          "assertion": "按4096字节读取并写.bak。"
        },
        {
          "id": "UI65-F006-07",
          "assertion": "备份复制先于Game.save。"
        },
        {
          "id": "UI65-F006-08",
          "assertion": "Game.save真先已保存提示。"
        },
        {
          "id": "UI65-F006-09",
          "assertion": "真分支再之前存档已备份提示，即便初始不存在旧档。"
        },
        {
          "id": "UI65-F006-10",
          "assertion": "Game.save假只失败提示。"
        },
        {
          "id": "UI65-F006-11",
          "assertion": "正常尾部恢复oldscene。"
        },
        {
          "id": "UI65-F006-12",
          "assertion": "无本地ensure覆盖异常或早退。"
        }
