      "name": "默认皮肤/文字速度/字体配置",
      "reader": "/root/ui_full",
      "facts": [
        {
          "id": "UI17-F004-01",
          "assertion": "普通/小/窄字体27/21/27、纵向偏移8；消息不透明度255；性别正文/阴影取精确配置。"
        },
        {
          "id": "UI17-F004-02",
          "assertion": "菜单/消息默认缓存分别首取选项对应皮肤，未命中依次系统登记、System/Window、001-Blue01；空缓存是有效最终结果。"
        },
        {
          "id": "UI17-F004-03",
          "assertion": "显式逻辑皮肤设置解析一次，未命中缓存空；后读不重走默认。"
        },
        {
          "id": "UI17-F004-04",
          "assertion": "文字速度0/1/2/3映射.05/.025/.0125/0，未识别取配置或.025；显式设置可改变缓存。"
        },
        {
          "id": "UI17-F004-05",
          "assertion": "字体候选递归按参数和数组次序选首个宿主存在者；无候选得到空名；显式无效候选回默认字体。"
        }
      ],
      "formal_targets": [
        "WP17§3.1/3.3/3.4",
        "WP15§3.3"
      ],
      "premise": "固定默认定义；普通分配及宿主基础接口正常；实际媒体/像素/物理输入未观察。",
