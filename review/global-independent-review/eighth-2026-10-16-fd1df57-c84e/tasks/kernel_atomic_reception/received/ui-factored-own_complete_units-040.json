              ]
            ]
          }
        }
      ],
      "facts": [
        {
          "id": "UI65-F002-01",
          "assertion": "继续大面板消费存档trainer/stats/map_id。"
        },
        {
          "id": "UI65-F002-02",
          "assertion": "非继续项为命令名窄面板。"
        },
        {
          "id": "UI65-F002-03",
          "assertion": "继续预览显示玩家名。"
        },
        {
          "id": "UI65-F002-04",
          "assertion": "继续预览显示徽章数。"
        },
        {
          "id": "UI65-F002-05",
          "assertion": "继续预览显示seen_count。"
        },
        {
          "id": "UI65-F002-06",
          "assertion": "时间取play_time.to_i。"
        },
        {
          "id": "UI65-F002-07",
          "assertion": "小时大于0显示小时与分钟。"
        },
        {
          "id": "UI65-F002-08",
          "assertion": "不足1小时仅分钟。"
        },
        {
          "id": "UI65-F002-09",
          "assertion": "性别为男取蓝色。"
        },
        {
          "id": "UI65-F002-10",
          "assertion": "性别为女取红色。"
        },
        {
          "id": "UI65-F002-11",
          "assertion": "其它取默认色。"
        },
        {
          "id": "UI65-F002-12",
          "assertion": "地图先pbGetMapNameFromId再对返回文本gsub!大写PN为存档trainer.name。"
        },
        {
          "id": "UI65-F002-13",
          "assertion": "全局命名服务已消耗占位时面板不再覆盖。"
        },
        {
          "id": "UI65-F002-14",
          "assertion": "地图共享材料更改可先于用户选命令。"
        },
        {
          "id": "UI65-F002-15",
          "assertion": "玩家元数据存在才构造walking预览。"
        },
        {
          "id": "UI65-F002-16",
          "assertion": "walking文件解析后bitmapnil抛具名玩家图集错误。"
        },
        {
          "id": "UI65-F002-17",
          "assertion": "合法4x4图集首行四格。"
        },
        {
          "id": "UI65-F002-18",
          "assertion": "0.5秒一周按绝对uptime取帧。"
        },
        {
          "id": "UI65-F002-19",
          "assertion": "party图标按两列定位。"
        },
        {
          "id": "UI65-F002-20",
          "assertion": "选择变化刷新旧面板selectedfalse。"
        },
        {
          "id": "UI65-F002-21",
          "assertion": "选择变化刷新新面板selectedtrue。"
        },
        {
          "id": "UI65-F002-22",
          "assertion": "越上下可视范围按48整体滚动。"
        },
        {
          "id": "UI65-F002-23",
          "assertion": "pbChoose循环仅USE返回下标。"
        },
        {
          "id": "UI65-F002-24",
          "assertion": "本选择循环没有BACK分支。"
        },
        {
          "id": "UI65-F002-25",
          "assertion": "end先淡出后dispose精灵和viewport。"
        },
        {
          "id": "UI65-F002-26",
          "assertion": "close直接dispose不淡出。"
        }
      ],
      "reader": "/root/ui_full",
      "premise": "固定B8/R无插件并发，具名普通依赖正常；源请求不证明宿主/资源/执行，后段失败保留前缀且不补造ensure。",
      "disposition": "OWN_FULL_PRIMARY_SOURCE_READ",
      "execution": "NOT_EXECUTED"
    },
    {
      "id": "UI65-U003",
      "name": "载入对象读取/无效/删除",
      "sources": [
        {
          "lossless_identity_base_ref": "IDENTITY-11",
          "per_unit_reading_and_range_fields": {
            "semantic_status": "UNREAD_BY_UI_FULL",
            "read_range": null,
            "primary_task": "ui_full",
            "reader": "/root/ui_full",
            "status": "FULL_READ",
            "ranges": [
              [
                1,
                356
              ]
            ]
          }
        }
      ],
      "facts": [
        {
          "id": "UI65-F003-01",
          "assertion": "对象构造有文件调用load_save_file。"
        },
        {
          "id": "UI65-F003-02",
          "assertion": "无文件用空Hash。"
        },
        {
          "id": "UI65-F003-03",
          "assertion": "read_from_file正常返回后才valid?。"
        },
        {
          "id": "UI65-F003-04",
          "assertion": "valid真直接返回数据。"
        },
        {
          "id": "UI65-F003-05",
          "assertion": "invalid且当前路径.bak为文件先提示备份。"
        },
        {
          "id": "UI65-F003-06",
          "assertion": "再递归读取该.bak。"
        },
        {
          "id": "UI65-F003-07",
          "assertion": "递归路径可继续追加.bak。"
        },
        {
          "id": "UI65-F003-08",
          "assertion": "invalid无备份进入删除提示。"
        },
        {
          "id": "UI65-F003-09",
          "assertion": "删除提示返回后load_save_file返回空Hash。"
        },
        {
          "id": "UI65-F003-10",
          "assertion": "更早读取异常不被本方法捕获。"
        },
        {
          "id": "UI65-F003-11",
          "assertion": "损坏提示严肃确认拒绝调用exit。"
        },
        {
          "id": "UI65-F003-12",
          "assertion": "同意先delete_save_data。"
        },
        {
          "id": "UI65-F003-13",
          "assertion": "删除调用正常返回再new Game_System。"
        },
        {
          "id": "UI65-F003-14",
          "assertion": "再new PokemonSystem。"
        },
        {
          "id": "UI65-F003-15",
          "assertion": "delete_save_data捕获SystemCallError。"
        },
        {
          "id": "UI65-F003-16",
          "assertion": "成功删除后消息若发生SystemCallError也落失败消息分支。"
        },
        {
          "id": "UI65-F003-17",
          "assertion": "失败消息不提供重试/回滚。"
        },
        {
          "id": "UI65-F003-18",
          "assertion": "隐藏删除画面无存档仅无文件提示。"
        },
        {
          "id": "UI65-F003-19",
          "assertion": "有文件第一次严肃确认拒绝不调删除。"
        },
        {
          "id": "UI65-F003-20",
          "assertion": "第一次同意先不可恢复警告。"
        },
        {
          "id": "UI65-F003-21",
          "assertion": "第二次严肃确认拒绝不调删除。"
        },
        {
          "id": "UI65-F003-22",
          "assertion": "第二次同意先正在删除消息再delete。"
        },
        {
          "id": "UI65-F003-23",
          "assertion": "流程正常结束场景后pbCallTitle。"
        },
        {
          "id": "UI65-F003-24",
          "assertion": "删除失败可能已完成部分持久层顺序，不假全事务。"
        }
      ],
      "reader": "/root/ui_full",
      "premise": "固定B8/R无插件并发，具名普通依赖正常；源请求不证明宿主/资源/执行，后段失败保留前缀且不补造ensure。",
      "disposition": "OWN_FULL_PRIMARY_SOURCE_READ",
      "execution": "NOT_EXECUTED"
    },
    {
      "id": "UI65-U004",
      "name": "载入命令集合与效果",
      "sources": [
        {
          "lossless_identity_base_ref": "IDENTITY-12",
          "per_unit_reading_and_range_fields": {
            "semantic_status": "UNREAD_BY_UI_FULL",
            "read_range": null,
            "primary_task": "ui_full",
            "reader": "/root/ui_full",
            "status": "FULL_READ",
            "ranges": [
              [
                1,
                356
              ]
            ]
          }
        }
      ],
      "facts": [
        {
          "id": "UI65-F004-01",
          "assertion": "跳过仅DEBUG且非Game.rgssad且SKIP_CONTINUE_SCREEN三真。"
        },
        {
          "id": "UI65-F004-02",
          "assertion": "跳过后按@save_data.empty?决定新游戏或load。"
        },
        {
          "id": "UI65-F004-03",
          "assertion": "文件存在不推出数据非空。"
        },
        {
          "id": "UI65-F004-04",
          "assertion": "未跳过时show_continue同按非空。"
        },
        {
          "id": "UI65-F004-05",
          "assertion": "非空才有Continue。"
        },
        {
          "id": "UI65-F004-06",
          "assertion": "非空且存档player解锁gift才有MysteryGift。"
        },
        {
          "id": "UI65-F004-07",
          "assertion": "NewGame总加入。"
        },
        {
          "id": "UI65-F004-08",
          "assertion": "Options总加入。"
        },
        {
          "id": "UI65-F004-09",
          "assertion": "LANGUAGES.length至少2才Language。"
        },
        {
          "id": "UI65-F004-10",
          "assertion": "DEBUG真才Debug。"
        },
        {
          "id": "UI65-F004-11",
          "assertion": "Quit总加入。"
        },
        {
          "id": "UI65-F004-12",
          "assertion": "命令按上述执行顺序追加并保存各下标。"
        },
        {
          "id": "UI65-F004-13",
          "assertion": "显示前从存档map_factory.map取当前地图ID。"
        },
        {
          "id": "UI65-F004-14",
          "assertion": "继续项才setParty。"
        },
        {
          "id": "UI65-F004-15",
          "assertion": "除Quit外先决定音。"
        },
        {
          "id": "UI65-F004-16",
          "assertion": "Continue先endScene再Game.load并return。"
        },
        {
          "id": "UI65-F004-17",
          "assertion": "NewGame先endScene再Game.start_new并return。"
        },
        {
          "id": "UI65-F004-18",
          "assertion": "MysteryGift淡入淡出下载后留本循环。"
        },
        {
          "id": "UI65-F004-19",
          "assertion": "Options以true标记打开后留本循环。"
        },
        {
          "id": "UI65-F004-20",
          "assertion": "Language先endScene。"
        },
        {
          "id": "UI65-F004-21",
          "assertion": "语言选择写$PokemonSystem.language。"
        },
        {
          "id": "UI65-F004-22",
          "assertion": "随后按新索引load_message_files。"
        },
        {
          "id": "UI65-F004-23",
          "assertion": "show_continue真才把整个当前PokemonSystem替换到保存副本。"
        },
        {
          "id": "UI65-F004-24",
          "assertion": "直写FILE_PATH以Marshal.dump，不经Game.save。"
        },
        {
          "id": "UI65-F004-25",
          "assertion": "此前载入Options其它字段改动一并随对象写。"
        },
        {
          "id": "UI65-F004-26",
          "assertion": "show_continue假无直写。"
        },
        {
          "id": "UI65-F004-27",
          "assertion": "语言完成置pbCallTitle并return。"
        },
        {
          "id": "UI65-F004-28",
          "assertion": "Debug正常返回留本循环。"
        },
        {
          "id": "UI65-F004-29",
          "assertion": "Quit先关闭音/endScene再scene=nil并return。"
        },
        {
          "id": "UI65-F004-30",
          "assertion": "不可达其它下标蜂鸣。"
        },
        {
          "id": "UI65-F004-31",
          "assertion": "异常发生在哪一步只保留已完成前缀。"
        }
      ],
      "reader": "/root/ui_full",
      "premise": "固定B8/R无插件并发，具名普通依赖正常；源请求不证明宿主/资源/执行，后段失败保留前缀且不补造ensure。",
      "disposition": "OWN_FULL_PRIMARY_SOURCE_READ",
      "execution": "NOT_EXECUTED"
    },
