      "id": "UI65-U002",
      "name": "载入面板预览与选择",
      "sources": [
        {
          "lossless_identity_base_ref": "IDENTITY-10",
          "per_unit_reading_and_range_fields": {
            "semantic_status": "UNREAD_BY_UI_FULL",
