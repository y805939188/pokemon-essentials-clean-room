      "facts": [
        {
          "id": "UI65-F005-01",
          "assertion": "构造信息窗先取当前map.name。"
        },
        {
          "id": "UI65-F005-02",
          "assertion": "信息含地图名。"
        },
        {
          "id": "UI65-F005-03",
          "assertion": "信息含玩家名按性别着色。"
        },
        {
          "id": "UI65-F005-04",
          "assertion": "信息含游戏时间小时/分钟。"
        },
        {
          "id": "UI65-F005-05",
          "assertion": "信息含badge_count。"
        },
        {
          "id": "UI65-F005-06",
          "assertion": "持有pokedex才含owned/seen。"
        },
        {
          "id": "UI65-F005-07",
          "assertion": "窗口至少宽228。"
        },
        {
          "id": "UI65-F005-08",
          "assertion": "先startScreen再普通保存确认。"
        },
        {
          "id": "UI65-F005-09",
          "assertion": "初始ret=false。"
        },
        {
          "id": "UI65-F005-10",
          "assertion": "普通拒绝只播放save choice，正常end返回false。"
        },
        {
          "id": "UI65-F005-11",
          "assertion": "不同存档覆盖门为exists?且begun_new_game。"
        },
        {
          "id": "UI65-F005-12",
          "assertion": "门真连续三条警告。"
        },
        {
          "id": "UI65-F005-13",
          "assertion": "严肃覆盖拒绝先选择音再endScreen直接false。"
        },
        {
          "id": "UI65-F005-14",
          "assertion": "覆盖接受后begun_new_game=false。"
        },
        {
          "id": "UI65-F005-15",
          "assertion": "不经过覆盖门的接受也把begun_new_game=false。"
        },
        {
          "id": "UI65-F005-16",
          "assertion": "清标记早于选择音与Game.save。"
        },
        {
          "id": "UI65-F005-17",
          "assertion": "Game.save真先成功消息，消息正常返回后ret=true。"
        },
        {
          "id": "UI65-F005-18",
          "assertion": "Game.save假失败消息后ret=false。"
        },
        {
          "id": "UI65-F005-19",
          "assertion": "正常尾部endScreen。"
        },
        {
          "id": "UI65-F005-20",
          "assertion": "wrapper返回布尔。"
        },
        {
          "id": "UI65-F005-21",
          "assertion": "确认前命名getter等副作用不回滚。"
        },
        {
          "id": "UI65-F005-22",
          "assertion": "保存失败不回滚已清的新游戏标记。"
        },
        {
          "id": "UI65-F005-23",
          "assertion": "本层无异常ensure清理。"
        }
      ],
