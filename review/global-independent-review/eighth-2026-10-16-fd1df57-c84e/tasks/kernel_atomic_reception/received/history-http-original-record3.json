    "record": {
      "id": "GR4-M02-002",
      "title": "POST请求前表单构造失败与便利包装吞没缺少输入边界",
      "severity": "P3",
      "disposition": "REQUIRED",
      "preconditions": [
        "固定原始HTTP文件在Ruby2.6.10p210加载，无网络方法覆写之外的改变",
        "http://example.invalid/，HTTPLite假方法仅记录参数并返回200/OK",
        "字符串键或符号键的普通表单输入；无文件目标"
      ],
      "expected_reference_behavior": "在已验证Ruby2.6语义下，普通字符串散列表键在原地处理前已冻结，基础POST抛FrozenError且宿主调用0次。使用符号键可隔离该问题：安全ASCII值正常构造并调用宿主；值含空格则编码数值转换抛ArgumentError，仍为0次宿主调用。便利到字符串入口捕获并返回空字符串。HTTPS在上述构造前被前缀门挡下。 源静态事实是构造阶段位于宿主调用的局部捕获之外；FrozenError/ArgumentError等精确异常和返回值只按Ruby2.6隔离回执确认，随附3.1宿主仍未执行。",
      "minimal_counterexample": {
        "input": "http地址，符号键k，值a b；基础POST/便利到字符串分别调用",
        "reference": "基础ArgumentError、HTTP调用0；便利空字符串、HTTP调用0",
        "normal_control": "符号键k，值a_b.-9：正文k=a_b.-9，HTTP调用1，返回OK"
      },
      "normal_case": "符号键与安全ASCII值触达假宿主，Content-Length为8；真实服务器可达性未测。",
      "failure_or_boundary_case": "字符串键k即使安全值也FrozenError；空格值在符号键对照中ArgumentError；两种便利输入均空串。https地址即使含空格也直接空串，不走构造或网络。",
      "acceptance_criteria": {
        "static": [
          "明确安全对照、字符串键冻结、符号键空格三类输入及宿主调用次数",
          "便利包装的空串不能证明已发出HTTP请求",
          "保留HTTPS提前拒绝和GET既有合同",
          "清楚区分SOURCE_STATIC、隔离EXECUTED_REFERENCE和未执行游戏宿主"
        ],
        "runtime": "不要求联网；可用只记录调用的假宿主复核隔离向量。不得用Ruby2.6回执声称目标宿主实测。"
      },
      "unknowns": [
        "目标游戏宿主运行时的实测",
        "非ASCII全部编码路径",
        "调用方是否采用被冻结的字符串键",
        "没有默认POST消费者样本",
        "随附3.1宿主结果UNVERIFIED；原生HTTP实现、实际服务器、非ASCII、实际POST调用数据形态未证。"
      ],
      "excluded_claims": [
        "不声称真实线上POST全部不可用",
        "不声称GET受相同问题影响",
        "不要求新实现保留该缺陷"
      ],
