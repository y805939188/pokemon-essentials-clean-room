  "facts": [
    {
      "id": "UI-MINI-MSG01",
      "assertion": "pbMessage带commands时以commandProc调用pbShowCommands，并保留cmdIfCancel/defaultCmd；缺commands只显示，返回初始0。"
    },
    {
      "id": "UI-MINI-MSG02",
      "assertion": "pbShowCommands缺commands直接0。"
    },
    {
      "id": "UI-MINI-MSG03",
      "assertion": "列表正常每轮Graphics.update/Input.update/cmdwindow.update/msgwindow.update/yield后才处理出口。"
    },
    {
      "id": "UI-MINI-MSG04",
      "assertion": "BACK时cancel>0返回cancel−1并break。"
    },
    {
      "id": "UI-MINI-MSG05",
      "assertion": "BACK时cancel<0返回该负数并break。"
    },
    {
      "id": "UI-MINI-MSG06",
      "assertion": "cancel=0且只有BACK不结束列表。"
    },
    {
      "id": "UI-MINI-MSG07",
      "assertion": "BACK检查是独立if，cancel=0时同轮USE仍可返回当前下标。"
    },
    {
      "id": "UI-MINI-MSG08",
      "assertion": "cancel非0同轮BACK+USE先BACK的break，所以不再确认。"
    },
    {
      "id": "UI-MINI-MSG09",
      "assertion": "正常返回前dispose列表并Input.update；异常没有本地ensure。"
    },
    {
      "id": "UI-MINI-CONF01",
      "assertion": "普通确认候选[Yes,No]、cancel=2，只有结果0为true。"
    },
    {
      "id": "UI-MINI-CONF02",
      "assertion": "普通确认No索引1为false。"
    },
    {
      "id": "UI-MINI-CONF03",
      "assertion": "普通确认BACK映射2−1=1所以false。"
    },
    {
      "id": "UI-MINI-CONF04",
      "assertion": "严肃确认候选[No,Yes]、cancel=1，只有结果1为true。"
    },
    {
      "id": "UI-MINI-CONF05",
      "assertion": "严肃确认No索引0和BACK映射0均false。"
    },
    {
      "id": "UI-MINI-CONF06",
      "assertion": "两确认默认选择位0；普通默认Yes，严肃默认No。"
    },
    {
      "id": "UI-MINI-NUM01",
      "assertion": "ChooseNumberParams初始范围0..0/初值0/cancel=nil。"
    },
    {
      "id": "UI-MINI-NUM02",
      "assertion": "setRange倒置时先把max升为min，再清maxDigits；不改当前initial/cancel。"
    },
    {
      "id": "UI-MINI-NUM03",
      "assertion": "setDefaultValue同时写initial并清cancel=nil。"
    },
    {
      "id": "UI-MINI-NUM04",
      "assertion": "setInitialValue只写initial不清cancel。"
    },
    {
      "id": "UI-MINI-NUM05",
      "assertion": "setCancelValue直接写cancel。"
    },
    {
      "id": "UI-MINI-NUM06",
      "assertion": "initialNumber夹到计算min/max。"
    },
    {
      "id": "UI-MINI-NUM07",
      "assertion": "cancelNumber采用cancel||initial；Ruby整数0为真，所以显式cancel0保留且不被范围夹限。"
    },
    {
      "id": "UI-MINI-NUM08",
      "assertion": "setMaxDigits至少1；正maxDigits以10^n−1给对称域，负数门假时最小钳0。"
    },
    {
      "id": "UI-MINI-NUM09",
      "assertion": "pbChooseNumber缺params返回0。"
    },
    {
      "id": "UI-MINI-NUM10",
      "assertion": "正常先读max/min/initial/cancel，先设sign再number，再显示数位窗。"
    },
    {
      "id": "UI-MINI-NUM11",
      "assertion": "每轮Graphics/Input/map/cmd/msg/yield后先USE再elsifBACK。"
    },
    {
      "id": "UI-MINI-NUM12",
      "assertion": "USE超域只蜂鸣且继续；同轮BACK被USE分支抑制。"
    },
    {
      "id": "UI-MINI-NUM13",
      "assertion": "USE合法播放决定音后返回所选数字。"
    },
    {
      "id": "UI-MINI-NUM14",
      "assertion": "单独BACK播放取消音后返回cancelNumber，哪怕该值超选择域。"
    },
    {
      "id": "UI-MINI-NUM15",
      "assertion": "正常尾dispose数字窗再Input.update。"
    },
    {
      "id": "UI-MINI-CMD01",
      "assertion": "Window_CommandPokemon继承Window_DrawableCommand→SpriteWindow_Selectable导航；命令窗自身没覆盖导航优先。"
    },
    {
      "id": "UI-MINI-CMD02",
      "assertion": "导航仅active/item_max>0/index>=0/ignore_inputfalse时执行。"
    },
    {
      "id": "UI-MINI-CMD03",
      "assertion": "repeat UP→DOWN→LEFT→RIGHT→JUMPUP→JUMPDOWN是elsif优先；较早方向存在即抑制后项，即便其内部不能移动。"
    },
    {
      "id": "UI-MINI-CMD04",
      "assertion": "UP在非首行可减columns；首行仅trigger且总数可被columns整除时循环至末对应行。"
    },
    {
      "id": "UI-MINI-CMD05",
      "assertion": "DOWN在非末行可加columns；末行仅trigger且总数整除时循环。"
    },
    {
      "id": "UI-MINI-CMD06",
      "assertion": "LEFT/RIGHT仅columns>=2且未相应边界才改index，不横向循环。"
    },
    {
      "id": "UI-MINI-CMD07",
      "assertion": "JUMPUP减少page_item_max钳0并top_row减页行。"
    },
    {
      "id": "UI-MINI-CMD08",
      "assertion": "JUMPDOWN增加page_item_max钳末项并top_row加页行。"
    },
    {
      "id": "UI-MINI-CMD09",
      "assertion": "只有实际index变化才光标音/update_cursor_rect；DrawableCommand随后按索引变化refresh。"
    },
    {
      "id": "UI-MINI-CMD10",
      "assertion": "这些为逻辑Input查询及源静态请求，不证明物理同键、宿主重复频率或可见像素。"
    }
  ],
