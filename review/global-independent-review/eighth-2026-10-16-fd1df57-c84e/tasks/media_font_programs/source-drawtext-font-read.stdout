      when "al"   # Left align
        if endtag
          alignstack.pop
        else
          alignstack.push(0)
        end
        nextline = 1 if x > 0 && nextline == 0
      when "ac"   # Center align
        if endtag
          alignstack.pop
        else
          alignstack.push(2)
        end
