        boldcount += (endtag ? -1 : 1)
      when "i"
        italiccount += (endtag ? -1 : 1)
      when "u"
        underlinecount += (endtag ? -1 : 1)
      when "s"
        strikecount += (endtag ? -1 : 1)
      when "outln"
        outlinecount += (endtag ? -1 : 1)
      when "outln2"
        outline2count += (endtag ? -1 : 1)
