          fontnamestack.push(Font.exist?(fontname) ? fontname : "Arial")
        end
        fontname = getLastParam(fontnamestack, defaultfontname)
        bitmap.font.name = fontname
      when "ar"   # Right align
        if endtag
          alignstack.pop
        else
          alignstack.push(1)
        end
