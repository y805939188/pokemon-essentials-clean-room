00263: 
00264:   def pbPriority(onlySpeedSort = false)
00265:     ret = []
00266:     if onlySpeedSort
00267:       # Sort battlers by their speed stats and tie-breaker order only.
00268:       tempArray = []
00269:       @priority.each { |pArray| tempArray.push([pArray[0], pArray[1], pArray[6]]) }
00270:       tempArray.sort! { |a, b| (a[1] == b[1]) ? b[2] <=> a[2] : b[1] <=> a[1] }
00271:       tempArray.each { |tArray| ret.push(tArray[0]) }
00272:     else
00273:       # Sort battlers by priority, sub-priority and their speed. Ties are
00274:       # resolved in the same way each time this method is called in a round.
00275:       @priority.each { |pArray| ret.push(pArray[0]) if !pArray[0].fainted? }
00276:     end
00277:     return ret
00278:   end
00279: end
