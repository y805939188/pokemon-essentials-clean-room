00141:       pbDisplay(_INTL("The Trainer blocked your Poké Ball! Don't be a thief!"))
00142:       return
00143:     end
00144:     # Calculate the number of shakes (4=capture)
00145:     pkmn = battler.pokemon
00146:     @criticalCapture = false
00147:     numShakes = pbCaptureCalc(pkmn, battler, catch_rate, ball)
00148:     PBDebug.log("[Threw Poké Ball] #{itemName}, #{numShakes} shakes (4=capture)")
00149:     # Animation of Ball throw, absorb, shake and capture/burst out
00150:     @scene.pbThrow(ball, numShakes, @criticalCapture, battler.index, showPlayer)
00151:     # Outcome message
00152:     case numShakes
00153:     when 0
00154:       pbDisplay(_INTL("Oh no! The Pokémon broke free!"))
00155:       Battle::PokeBallEffects.onFailCatch(ball, self, battler)
00156:     when 1
00157:       pbDisplay(_INTL("Aww! It appeared to be caught!"))
00158:       Battle::PokeBallEffects.onFailCatch(ball, self, battler)
00159:     when 2
00160:       pbDisplay(_INTL("Aargh! Almost had it!"))
00161:       Battle::PokeBallEffects.onFailCatch(ball, self, battler)
00162:     when 3
00163:       pbDisplay(_INTL("Gah! It was so close, too!"))
00164:       Battle::PokeBallEffects.onFailCatch(ball, self, battler)
00165:     when 4
00166:       pbDisplayBrief(_INTL("Gotcha! {1} was caught!", pkmn.name))
00167:       @scene.pbThrowSuccess   # Play capture success jingle
00168:       pbRemoveFromParty(battler.index, battler.pokemonIndex)
00169:       # Gain Exp
00170:       if Settings::GAIN_EXP_FOR_CAPTURE
00171:         battler.captured = true
00172:         pbGainExp
00173:         battler.captured = false
00174:       end
00175:       battler.pbReset
00176:       if pbAllFainted?(battler.index)
00177:         @decision = (trainerBattle?) ? 1 : 4   # Battle ended by win/capture
00178:       end
00179:       # Modify the Pokémon's properties because of the capture
00180:       if GameData::Item.get(ball).is_snag_ball?
00181:         pkmn.owner = Pokemon::Owner.new_from_trainer(pbPlayer)
00182:       end
00183:       Battle::PokeBallEffects.onCatch(ball, self, pkmn)
00184:       pkmn.poke_ball = ball
00185:       pkmn.makeUnmega if pkmn.mega?
00186:       pkmn.makeUnprimal
00187:       pkmn.update_shadow_moves if pkmn.shadowPokemon?
00188:       pkmn.record_first_moves
00189:       # Reset form
00190:       pkmn.forced_form = nil if MultipleForms.hasFunction?(pkmn.species, "getForm")
00191:       @peer.pbOnLeavingBattle(self, pkmn, true, true)
00192:       # Make the Poké Ball and data box disappear
00193:       @scene.pbHideCaptureBall(idxBattler)
00194:       # Save the Pokémon for storage at the end of battle
00195:       @caughtPokemon.push(pkmn)
00196:     end
00197:     if numShakes != 4
00198:       @first_poke_ball = ball if !@poke_ball_failed
00199:       @poke_ball_failed = true
00200:     end
00201:   end
00202: 
00203:   #=============================================================================
00204:   # Calculate how many shakes a thrown Poké Ball will make (4 = capture)
00205:   #=============================================================================
00206:   def pbCaptureCalc(pkmn, battler, catch_rate, ball)
00207:     return 4 if $DEBUG && Input.press?(Input::CTRL)
00208:     # Get a catch rate if one wasn't provided
00209:     catch_rate = pkmn.species_data.catch_rate if !catch_rate
00210:     # Modify catch_rate depending on the Poké Ball's effect
00211:     if !pkmn.species_data.has_flag?("UltraBeast") || ball == :BEASTBALL
00212:       catch_rate = Battle::PokeBallEffects.modifyCatchRate(ball, catch_rate, self, battler)
00213:     else
00214:       catch_rate /= 10
00215:     end
00216:     # First half of the shakes calculation
00217:     a = battler.totalhp
00218:     b = battler.hp
00219:     x = (((3 * a) - (2 * b)) * catch_rate.to_f) / (3 * a)
00220:     # Calculation modifiers
00221:     if battler.status == :SLEEP || battler.status == :FROZEN
00222:       x *= 2.5
00223:     elsif battler.status != :NONE
00224:       x *= 1.5
00225:     end
00226:     x = x.floor
00227:     x = 1 if x < 1
00228:     # Definite capture, no need to perform randomness checks
00229:     return 4 if x >= 255 || Battle::PokeBallEffects.isUnconditional?(ball, self, battler)
00230:     # Second half of the shakes calculation
00231:     y = (65_536 / ((255.0 / x)**0.1875)).floor
00232:     # Critical capture check
00233:     if Settings::ENABLE_CRITICAL_CAPTURES
00234:       dex_modifier = 0
00235:       numOwned = $player.pokedex.owned_count
00236:       if numOwned > 600
00237:         dex_modifier = 5
00238:       elsif numOwned > 450
00239:         dex_modifier = 4
00240:       elsif numOwned > 300
00241:         dex_modifier = 3
00242:       elsif numOwned > 150
00243:         dex_modifier = 2
00244:       elsif numOwned > 30
00245:         dex_modifier = 1
00246:       end
00247:       dex_modifier *= 2 if $bag.has?(:CATCHINGCHARM)
00248:       c = x * dex_modifier / 12
00249:       # Calculate the number of shakes
00250:       if c > 0 && pbRandom(256) < c
00251:         @criticalCapture = true
00252:         return 4 if pbRandom(65_536) < y
00253:         return 0
00254:       end
00255:     end
00256:     # Calculate the number of shakes
00257:     numShakes = 0
00258:     4.times do |i|
00259:       break if numShakes < i
00260:       numShakes += 1 if pbRandom(65_536) < y
00261:     end
00262:     return numShakes
00263:   end
00264: end
00265: 
00266: #===============================================================================
00267: #
00268: #===============================================================================
00269: class Battle
00270:   include Battle::CatchAndStoreMixin
00271: end
