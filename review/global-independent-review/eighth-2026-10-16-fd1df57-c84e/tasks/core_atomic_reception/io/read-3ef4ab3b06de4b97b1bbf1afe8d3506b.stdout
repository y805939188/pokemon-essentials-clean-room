00312:   def pbEORCountDownBattlerEffect(priority, effect)
00313:     priority.each do |battler|
00314:       next if battler.fainted? || battler.effects[effect] == 0
00315:       battler.effects[effect] -= 1
00316:       yield battler if block_given? && battler.effects[effect] == 0
00317:     end
00318:   end
00319: 
00320:   def pbEOREndBattlerEffects(priority)
00321:     # Taunt
00322:     pbEORCountDownBattlerEffect(priority, PBEffects::Taunt) do |battler|
00323:       pbDisplay(_INTL("{1}'s taunt wore off!", battler.pbThis))
00324:     end
00325:     # Encore
00326:     priority.each do |battler|
00327:       next if battler.fainted? || battler.effects[PBEffects::Encore] == 0
00328:       idxEncoreMove = battler.pbEncoredMoveIndex
00329:       if idxEncoreMove >= 0
00330:         battler.effects[PBEffects::Encore] -= 1
00331:         if battler.effects[PBEffects::Encore] == 0 || battler.moves[idxEncoreMove].pp == 0
00332:           battler.effects[PBEffects::Encore] = 0
00333:           pbDisplay(_INTL("{1}'s encore ended!", battler.pbThis))
00334:         end
00335:       else
00336:         PBDebug.log("[End of effect] #{battler.pbThis}'s encore ended (encored move no longer known)")
00337:         battler.effects[PBEffects::Encore]     = 0
00338:         battler.effects[PBEffects::EncoreMove] = nil
00339:       end
00340:     end
00341:     # Disable/Cursed Body
00342:     pbEORCountDownBattlerEffect(priority, PBEffects::Disable) do |battler|
00343:       battler.effects[PBEffects::DisableMove] = nil
00344:       pbDisplay(_INTL("{1} is no longer disabled!", battler.pbThis))
00345:     end
00346:     # Magnet Rise
