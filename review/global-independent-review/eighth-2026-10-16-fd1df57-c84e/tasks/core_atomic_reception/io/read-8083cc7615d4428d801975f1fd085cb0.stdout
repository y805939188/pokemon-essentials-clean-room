00196:   def pbPredictMoveFailureAgainstTarget
00197:     # Move effect-specific checks
00198:     return true if Battle::AI::Handlers.move_will_fail_against_target?(@move.function_code, @move, @user, @target, self, @battle)
00199:     # Immunity to priority moves because of Psychic Terrain
00200:     return true if @battle.field.terrain == :Psychic && @target.battler.affectedByTerrain? &&
00201:                    @target.opposes?(@user) && @move.rough_priority(@user) > 0
00202:     # Immunity because of ability
00203:     return true if @move.move.pbImmunityByAbility(@user.battler, @target.battler, false)
00204:     # Immunity because of Dazzling/Queenly Majesty
00205:     if @move.rough_priority(@user) > 0 && @target.opposes?(@user)
00206:       each_same_side_battler(@target.side) do |b, i|
00207:         return true if b.has_active_ability?([:DAZZLING, :QUEENLYMAJESTY])
00208:       end
00209:     end
00210:     # Type immunity
00211:     calc_type = @move.rough_type
00212:     typeMod = @move.move.pbCalcTypeMod(calc_type, @user.battler, @target.battler)
00213:     return true if @move.move.pbDamagingMove? && Effectiveness.ineffective?(typeMod)
00214:     # Dark-type immunity to moves made faster by Prankster
00215:     return true if Settings::MECHANICS_GENERATION >= 7 && @move.statusMove? &&
00216:                    @user.has_active_ability?(:PRANKSTER) && @target.has_type?(:DARK) && @target.opposes?(@user)
00217:     # Airborne-based immunity to Ground moves
00218:     return true if @move.damagingMove? && calc_type == :GROUND &&
00219:                    @target.battler.airborne? && !@move.move.hitsFlyingTargets?
00220:     # Immunity to powder-based moves
00221:     return true if @move.move.powderMove? && !@target.battler.affectedByPowder?
00222:     # Substitute
00223:     return true if @target.effects[PBEffects::Substitute] > 0 && @move.statusMove? &&
00224:                    !@move.move.ignoresSubstitute?(@user.battler) && @user.index != @target.index
00225:     return false
00226:   end
00227: 
00228:   #-----------------------------------------------------------------------------
00229: 
00230:   # Get a score for the given move being used against the given target.
00231:   # Assumes def set_up_move_check has previously been called.
00232:   def pbGetMoveScore(targets = nil)
00233:     # Get the base score for the move
00234:     score = MOVE_BASE_SCORE
00235:     # Scores for each target in turn
00236:     if targets
00237:       # Reset the base score for the move (each target will add its own score)
00238:       score = 0
00239:       affected_targets = 0
00240:       # Get a score for the move against each target in turn
00241:       orig_move = @move.move   # In case move is Mirror Move and changes depending on the target
00242:       targets.each do |target|
00243:         set_up_move_check(orig_move)
00244:         set_up_move_check_target(target)
00245:         t_score = pbGetMoveScoreAgainstTarget
00246:         next if t_score < 0
00247:         score += t_score
00248:         affected_targets += 1
00249:       end
00250:       # Set the default score if no targets were affected
00251:       if affected_targets == 0
00252:         score = (@trainer.has_skill_flag?("PredictMoveFailure")) ? MOVE_USELESS_SCORE : MOVE_BASE_SCORE
00253:       end
00254:       # Score based on how many targets were affected
00255:       if affected_targets == 0 && @trainer.has_skill_flag?("PredictMoveFailure")
00256:         if !@move.move.worksWithNoTargets?
00257:           PBDebug.log_score_change(MOVE_FAIL_SCORE - MOVE_BASE_SCORE, "move will fail")
00258:           return MOVE_FAIL_SCORE
00259:         end
00260:       else
00261:         score /= affected_targets if affected_targets > 1   # Average the score against multiple targets
00262:         # Bonus for affecting multiple targets
00263:         if @trainer.has_skill_flag?("PreferMultiTargetMoves") && affected_targets > 1
00264:           old_score = score
00265:           score += (affected_targets - 1) * 10
00266:           PBDebug.log_score_change(score - old_score, "affects multiple battlers")
00267:         end
00268:       end
00269:     end
00270:     # If we're here, the move either has no targets or at least one target will
00271:     # be affected (or the move is usable even if no targets are affected, e.g.
00272:     # Self-Destruct)
00273:     if @trainer.has_skill_flag?("ScoreMoves")
00274:       # Modify the score according to the move's effect
00275:       old_score = score
00276:       score = Battle::AI::Handlers.apply_move_effect_score(@move.function_code,
00277:          score, @move, @user, self, @battle)
00278:       PBDebug.log_score_change(score - old_score, "function code modifier (generic)")
00279:       # Modify the score according to various other effects
00280:       score = Battle::AI::Handlers.apply_general_move_score_modifiers(
00281:         score, @move, @user, self, @battle)
00282:     end
00283:     score = score.to_i
00284:     score = 0 if score < 0
00285:     return score
00286:   end
00287: 
00288:   #-----------------------------------------------------------------------------
00289: 
00290:   # Returns the score of @move being used against @target. A return value of -1
00291:   # means the move will fail or do nothing against the target.
00292:   # Assumes def set_up_move_check and def set_up_move_check_target have
00293:   # previously been called.
00294:   def pbGetMoveScoreAgainstTarget
00295:     # Predict whether the move will fail against the target
00296:     if @trainer.has_skill_flag?("PredictMoveFailure") && pbPredictMoveFailureAgainstTarget
00297:       PBDebug.log("     move will not affect #{@target.name}")
00298:       return -1
00299:     end
00300:     # Score the move
00301:     score = MOVE_BASE_SCORE
00302:     if @trainer.has_skill_flag?("ScoreMoves")
00303:       # Modify the score according to the move's effect against the target
00304:       old_score = score
00305:       score = Battle::AI::Handlers.apply_move_effect_against_target_score(@move.function_code,
00306:          MOVE_BASE_SCORE, @move, @user, @target, self, @battle)
00307:       PBDebug.log_score_change(score - old_score, "function code modifier (against target)")
00308:       # Modify the score according to various other effects against the target
00309:       score = Battle::AI::Handlers.apply_general_move_against_target_score_modifiers(
00310:         score, @move, @user, @target, self, @battle)
00311:     end
00312:     # Add the score against the target to the overall score
00313:     target_data = @move.pbTarget(@user.battler)
00314:     if target_data.targets_foe && !@target.opposes?(@user) && @target.index != @user.index
00315:       if score == MOVE_USELESS_SCORE
00316:         PBDebug.log("     move is useless against #{@target.name}")
00317:         return -1
00318:       end
00319:       old_score = score
00320:       score = ((1.85 * MOVE_BASE_SCORE) - score).to_i
00321:       PBDebug.log_score_change(score - old_score, "score inverted (move targets ally but can target foe)")
00322:     end
00323:     return score
00324:   end
00325: 
00326:   #-----------------------------------------------------------------------------
00327: 
00328:   # Make the final choice of which move to use depending on the calculated
00329:   # scores for each move. Moves with higher scores are more likely to be chosen.
00330:   def pbChooseMove(choices)
00331:     user_battler = @user.battler
00332:     # If no moves can be chosen, auto-choose a move or Struggle
00333:     if choices.length == 0
00334:       @battle.pbAutoChooseMove(user_battler.index)
00335:       PBDebug.log_ai("#{@user.name} will auto-use a move or Struggle")
00336:       return
00337:     end
00338:     # Figure out useful information about the choices
00339:     max_score = 0
00340:     choices.each { |c| max_score = c[1] if max_score < c[1] }
00341:     # Decide whether all choices are bad, and if so, try switching instead
00342:     if @trainer.high_skill? && @user.can_switch_lax?
00343:       badMoves = false
00344:       if max_score <= MOVE_USELESS_SCORE
00345:         badMoves = user.can_attack?
00346:         badMoves = true if !badMoves && pbAIRandom(100) < 25
00347:       elsif max_score < MOVE_BASE_SCORE * move_score_threshold && user_battler.turnCount > 2
00348:         badMoves = true if pbAIRandom(100) < 80
00349:       end
00350:       if badMoves
00351:         PBDebug.log_ai("#{@user.name} wants to switch due to terrible moves")
00352:         if pbChooseToSwitchOut(true)
00353:           @battle.pbUnregisterMegaEvolution(@user.index)
00354:           return
00355:         end
00356:         PBDebug.log_ai("#{@user.name} won't switch after all")
00357:       end
00358:     end
00359:     # Calculate a minimum score threshold and reduce all move scores by it
00360:     threshold = (max_score * move_score_threshold.to_f).floor
00361:     choices.each { |c| c[3] = [c[1] - threshold, 0].max }
00362:     total_score = choices.sum { |c| c[3] }
00363:     # Log the available choices
00364:     if $INTERNAL
00365:       PBDebug.log_ai("Move choices for #{@user.name}:")
00366:       choices.each_with_index do |c, i|
00367:         chance = sprintf("%5.1f", (c[3] > 0) ? 100.0 * c[3] / total_score : 0)
00368:         log_msg = "   * #{chance}% to use #{user_battler.moves[c[0]].name}"
00369:         log_msg += " (target #{c[2]})" if c[2] >= 0
00370:         log_msg += ": score #{c[1]}"
00371:         PBDebug.log(log_msg)
00372:       end
00373:     end
00374:     # Pick a move randomly from choices weighted by their scores
00375:     randNum = pbAIRandom(total_score)
00376:     choices.each do |c|
00377:       randNum -= c[3]
00378:       next if randNum >= 0
00379:       @battle.pbRegisterMove(user_battler.index, c[0], false)
00380:       @battle.pbRegisterTarget(user_battler.index, c[2]) if c[2] >= 0
00381:       break
00382:     end
00383:     # Log the result
00384:     if @battle.choices[user_battler.index][2]
00385:       move_name = @battle.choices[user_battler.index][2].name
00386:       if @battle.choices[user_battler.index][3] >= 0
00387:         PBDebug.log("   => will use #{move_name} (target #{@battle.choices[user_battler.index][3]})")
00388:       else
00389:         PBDebug.log("   => will use #{move_name}")
00390:       end
00391:     end
00392:   end
00393: end
