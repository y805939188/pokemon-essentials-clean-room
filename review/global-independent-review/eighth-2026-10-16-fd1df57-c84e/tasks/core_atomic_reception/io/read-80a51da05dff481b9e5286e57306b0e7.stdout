01208:   def pbEffectGeneral(user)
01209:     user.effects[PBEffects::MagicCoat] = true
01210:     @battle.pbDisplay(_INTL("{1} shrouded itself with Magic Coat!", user.pbThis))
01211:   end
01212: end
01213: 
01214: #===============================================================================
01215: # This round, snatches all used moves that can be Snatched. (Snatch)
01216: #===============================================================================
01217: class Battle::Move::StealAndUseBeneficialStatusMove < Battle::Move
01218:   def pbEffectGeneral(user)
01219:     user.effects[PBEffects::Snatch] = 1
01220:     @battle.allBattlers.each do |b|
01221:       next if b.effects[PBEffects::Snatch] < user.effects[PBEffects::Snatch]
01222:       user.effects[PBEffects::Snatch] = b.effects[PBEffects::Snatch] + 1
01223:     end
01224:     @battle.pbDisplay(_INTL("{1} waits for a target to make a move!", user.pbThis))
01225:   end
01226: end
01227: 
01228: #===============================================================================
01229: # This move turns into the last move used by the target, until user switches
01230: # out. (Mimic)
01231: #===============================================================================
01232: class Battle::Move::ReplaceMoveThisBattleWithTargetLastMoveUsed < Battle::Move
01233:   attr_reader :moveBlacklist
01234: 
01235:   def ignoresSubstitute?(user); return true; end
