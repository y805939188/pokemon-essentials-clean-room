00283:   def pbCalcDamageMultipliers(user, target, numTargets, type, baseDmg, multipliers)
00284:     # Global abilities
00285:     if (@battle.pbCheckGlobalAbility(:DARKAURA) && type == :DARK) ||
00286:        (@battle.pbCheckGlobalAbility(:FAIRYAURA) && type == :FAIRY)
00287:       if @battle.pbCheckGlobalAbility(:AURABREAK)
00288:         multipliers[:power_multiplier] *= 3 / 4.0
00289:       else
00290:         multipliers[:power_multiplier] *= 4 / 3.0
00291:       end
00292:     end
00293:     # Ability effects that alter damage
00294:     if user.abilityActive?
00295:       Battle::AbilityEffects.triggerDamageCalcFromUser(
00296:         user.ability, user, target, self, multipliers, baseDmg, type
00297:       )
00298:     end
00299:     if !@battle.moldBreaker
00300:       # NOTE: It's odd that the user's Mold Breaker prevents its partner's
00301:       #       beneficial abilities (i.e. Flower Gift boosting Atk), but that's
00302:       #       how it works.
00303:       user.allAllies.each do |b|
00304:         next if !b.abilityActive?
00305:         Battle::AbilityEffects.triggerDamageCalcFromAlly(
00306:           b.ability, user, target, self, multipliers, baseDmg, type
00307:         )
00308:       end
00309:       if target.abilityActive?
00310:         Battle::AbilityEffects.triggerDamageCalcFromTarget(
00311:           target.ability, user, target, self, multipliers, baseDmg, type
00312:         )
00313:       end
00314:     end
00315:     if target.abilityActive?
00316:       Battle::AbilityEffects.triggerDamageCalcFromTargetNonIgnorable(
00317:         target.ability, user, target, self, multipliers, baseDmg, type
00318:       )
00319:     end
00320:     if !@battle.moldBreaker
00321:       target.allAllies.each do |b|
00322:         next if !b.abilityActive?
00323:         Battle::AbilityEffects.triggerDamageCalcFromTargetAlly(
00324:           b.ability, user, target, self, multipliers, baseDmg, type
00325:         )
00326:       end
00327:     end
00328:     # Item effects that alter damage
00329:     if user.itemActive?
00330:       Battle::ItemEffects.triggerDamageCalcFromUser(
00331:         user.item, user, target, self, multipliers, baseDmg, type
00332:       )
00333:     end
00334:     if target.itemActive?
00335:       Battle::ItemEffects.triggerDamageCalcFromTarget(
00336:         target.item, user, target, self, multipliers, baseDmg, type
00337:       )
00338:     end
00339:     # Parental Bond's second attack
00340:     if user.effects[PBEffects::ParentalBond] == 1
00341:       multipliers[:power_multiplier] /= (Settings::MECHANICS_GENERATION >= 7) ? 4 : 2
00342:     end
00343:     # Other
00344:     if user.effects[PBEffects::MeFirst]
