00686: ItemHandlers::BattleUseOnBattler.add(:MAXMUSHROOMS, proc { |item, battler, scene|
00687:   show_anim = true
00688:   GameData::Stat.each_main_battle do |stat|
00689:     next if !battler.pbCanRaiseStatStage?(stat.id, battler)
00690:     battler.pbRaiseStatStage(stat.id, 1, battler, show_anim)
00691:     show_anim = false
00692:   end
00693:   battler.pokemon.changeHappiness("battleitem")
00694: })
