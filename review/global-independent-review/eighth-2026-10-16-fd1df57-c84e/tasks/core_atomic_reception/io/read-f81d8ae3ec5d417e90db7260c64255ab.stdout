00483: ItemHandlers::BattleUseOnPokemon.add(:HEALPOWDER, proc { |item, pokemon, battler, choices, scene|
00484:   pokemon.heal_status
00485:   battler&.pbCureStatus(false)
00486:   battler&.pbCureConfusion
00487:   pokemon.changeHappiness("powder")
00488:   name = (battler) ? battler.pbThis : pokemon.name
00489:   scene.pbRefresh
00490:   scene.pbDisplay(_INTL("{1} became healthy.", name))
00491: })
00492: 
00493: ItemHandlers::BattleUseOnPokemon.add(:REVIVALHERB, proc { |item, pokemon, battler, choices, scene|
