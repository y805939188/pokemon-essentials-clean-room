00474:   def pbEffectGeneral(user)
00475:     if @sidedEffect
00476:       user.pbOwnSide.effects[@effect] = true
00477:     else
00478:       user.effects[@effect] = true
00479:     end
00480:     user.effects[PBEffects::ProtectRate] *= (Settings::MECHANICS_GENERATION >= 6) ? 3 : 2
00481:     pbProtectMessage(user)
00482:   end
00483: 
00484:   def pbProtectMessage(user)
00485:     if @sidedEffect
00486:       @battle.pbDisplay(_INTL("{1} protected {2}!", @name, user.pbTeam(true)))
00487:     else
00488:       @battle.pbDisplay(_INTL("{1} protected itself!", user.pbThis))
00489:     end
00490:   end
00491: end
00492: 
00493: #===============================================================================
00494: # Weather-inducing move.
00495: #===============================================================================
00496: class Battle::Move::WeatherMove < Battle::Move
00497:   attr_reader :weatherType
00498: 
00499:   def initialize(battle, move)
00500:     super
