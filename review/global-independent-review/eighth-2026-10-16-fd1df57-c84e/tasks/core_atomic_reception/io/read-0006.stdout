00101:   #=============================================================================
00102:   # Ability curing
00103:   #=============================================================================
00104:   # Cures status conditions, confusion and infatuation.
00105:   def pbAbilityStatusCureCheck
00106:     if abilityActive?
00107:       Battle::AbilityEffects.triggerStatusCure(self.ability, self)
00108:     end
00109:   end
00110: 
00111:   #=============================================================================
00112:   # Ability effects
00113:   #=============================================================================
00114:   # For abilities that grant immunity to moves of a particular type, and raises
00115:   # one of the ability's bearer's stats instead.
00116:   def pbMoveImmunityStatRaisingAbility(user, move, moveType, immuneType, stat, increment, show_message)
00117:     return false if user.index == @index
00118:     return false if moveType != immuneType
00119:     # NOTE: If show_message is false (Dragon Darts only), the stat will not be
00120:     #       raised. This is not how the official games work, but I'm considering
00121:     #       that a bug because Dragon Darts won't be fired at self in the first
00122:     #       place if it's immune, so why would this ability be triggered by them?
00123:     if show_message
00124:       @battle.pbShowAbilitySplash(self)
00125:       if pbCanRaiseStatStage?(stat, self)
00126:         if Battle::Scene::USE_ABILITY_SPLASH
00127:           pbRaiseStatStage(stat, increment, self)
00128:         else
00129:           pbRaiseStatStageByCause(stat, increment, self, abilityName)
00130:         end
00131:       elsif Battle::Scene::USE_ABILITY_SPLASH
00132:         @battle.pbDisplay(_INTL("It doesn't affect {1}...", pbThis(true)))
00133:       else
00134:         @battle.pbDisplay(_INTL("{1}'s {2} made {3} ineffective!", pbThis, abilityName, move.name))
00135:       end
00136:       @battle.pbHideAbilitySplash(self)
00137:     end
00138:     return true
00139:   end
00140: 
00141:   # For abilities that grant immunity to moves of a particular type, and heals
00142:   # the ability's bearer by 1/4 of its total HP instead.
00143:   def pbMoveImmunityHealingAbility(user, move, moveType, immuneType, show_message)
00144:     return false if user.index == @index
00145:     return false if moveType != immuneType
00146:     # NOTE: If show_message is false (Dragon Darts only), HP will not be healed.
00147:     #       This is not how the official games work, but I'm considering that a
00148:     #       bug because Dragon Darts won't be fired at self in the first place
00149:     #       if it's immune, so why would this ability be triggered by them?
00150:     if show_message
00151:       @battle.pbShowAbilitySplash(self)
00152:       if canHeal? && pbRecoverHP(@totalhp / 4) > 0
00153:         if Battle::Scene::USE_ABILITY_SPLASH
00154:           @battle.pbDisplay(_INTL("{1}'s HP was restored.", pbThis))
00155:         else
00156:           @battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", pbThis, abilityName))
00157:         end
00158:       elsif Battle::Scene::USE_ABILITY_SPLASH
00159:         @battle.pbDisplay(_INTL("It doesn't affect {1}...", pbThis(true)))
00160:       else
00161:         @battle.pbDisplay(_INTL("{1}'s {2} made {3} ineffective!", pbThis, abilityName, move.name))
00162:       end
00163:       @battle.pbHideAbilitySplash(self)
00164:     end
00165:     return true
00166:   end
00167: 
00168:   #=============================================================================
00169:   # Ability change
00170:   #=============================================================================
00171:   def pbOnLosingAbility(oldAbil, suppressed = false)
00172:     if oldAbil == :NEUTRALIZINGGAS && (suppressed || !@effects[PBEffects::GastroAcid])
00173:       pbAbilitiesOnNeutralizingGasEnding
00174:     elsif [:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH].include?(oldAbil) &&
00175:           (suppressed || !@effects[PBEffects::GastroAcid])
00176:       pbItemsOnUnnerveEnding
00177:     elsif oldAbil == :ILLUSION && @effects[PBEffects::Illusion]
00178:       @effects[PBEffects::Illusion] = nil
00179:       if !@effects[PBEffects::Transform]
00180:         @battle.scene.pbChangePokemon(self, @pokemon)
00181:         @battle.pbDisplay(_INTL("{1}'s {2} wore off!", pbThis, GameData::Ability.get(oldAbil).name))
00182:         @battle.pbSetSeen(self)
00183:       end
00184:     end
00185:     @effects[PBEffects::GastroAcid] = false if unstoppableAbility?
00186:     @effects[PBEffects::SlowStart]  = 0 if self.ability != :SLOWSTART
00187:     @effects[PBEffects::Truant]     = false if self.ability != :TRUANT
00188:     # Check for end of primordial weather
00189:     @battle.pbEndPrimordialWeather
00190:     # Revert form if Flower Gift/Forecast was lost
00191:     pbCheckFormOnWeatherChange(true)
00192:     # Abilities that trigger when the terrain changes
00193:     pbAbilityOnTerrainChange(true)
00194:   end
00195: 
00196:   def pbTriggerAbilityOnGainingIt
00197:     # Ending primordial weather, checking Trace
00198:     pbContinualAbilityChecks(true)   # Don't trigger Traced ability as it's triggered below
00199:     # Abilities that trigger upon switching in
00200:     if (!fainted? && unstoppableAbility?) || abilityActive?
00201:       Battle::AbilityEffects.triggerOnSwitchIn(self.ability, self, @battle)
00202:     end
00203:     # Status-curing ability check
00204:     pbAbilityStatusCureCheck
00205:     # Check for end of primordial weather
00206:     @battle.pbEndPrimordialWeather
00207:   end
00208: 
00209:   #=============================================================================
00210:   # Held item consuming/removing
00211:   #=============================================================================
00212:   def canConsumeBerry?
00213:     return false if @battle.pbCheckOpposingAbility([:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH], @index)
00214:     return true
00215:   end
00216: 
00217:   def canConsumePinchBerry?(check_gluttony = true)
00218:     return false if !canConsumeBerry?
00219:     return true if @hp <= @totalhp / 4
00220:     return true if @hp <= @totalhp / 2 && (!check_gluttony || hasActiveAbility?(:GLUTTONY))
00221:     return false
00222:   end
00223: 
00224:   # permanent is whether the item is lost even after battle. Is false for Knock
00225:   # Off.
00226:   def pbRemoveItem(permanent = true)
00227:     @effects[PBEffects::ChoiceBand] = nil if !hasActiveAbility?(:GORILLATACTICS)
00228:     @effects[PBEffects::Unburden]   = true if self.item && hasActiveAbility?(:UNBURDEN)
00229:     setInitialItem(nil) if permanent && self.item == self.initialItem
00230:     self.item = nil
00231:   end
00232: 
00233:   def pbConsumeItem(recoverable = true, symbiosis = true, belch = true)
00234:     PBDebug.log("[Item consumed] #{pbThis} consumed its held #{itemName}")
00235:     if recoverable
00236:       setRecycleItem(@item_id)
00237:       @effects[PBEffects::PickupItem] = @item_id
00238:       @effects[PBEffects::PickupUse]  = @battle.nextPickupUse
00239:     end
00240:     setBelched if belch && self.item.is_berry?
00241:     pbRemoveItem
00242:     pbSymbiosis if symbiosis
00243:   end
00244: 
00245:   def pbSymbiosis
00246:     return if fainted?
00247:     return if self.item
00248:     @battle.pbPriority(true).each do |b|
00249:       next if b.opposes?(self)
00250:       next if !b.hasActiveAbility?(:SYMBIOSIS)
00251:       next if !b.item || b.unlosableItem?(b.item)
00252:       next if unlosableItem?(b.item)
00253:       @battle.pbShowAbilitySplash(b)
00254:       if Battle::Scene::USE_ABILITY_SPLASH
00255:         @battle.pbDisplay(_INTL("{1} shared its {2} with {3}!",
00256:                                 b.pbThis, b.itemName, pbThis(true)))
00257:       else
00258:         @battle.pbDisplay(_INTL("{1}'s {2} let it share its {3} with {4}!",
00259:                                 b.pbThis, b.abilityName, b.itemName, pbThis(true)))
00260:       end
00261:       self.item = b.item
00262:       b.item = nil
00263:       b.effects[PBEffects::Unburden] = true if b.hasActiveAbility?(:UNBURDEN)
00264:       @battle.pbHideAbilitySplash(b)
00265:       pbHeldItemTriggerCheck
00266:       break
00267:     end
00268:   end
00269: 
00270:   # item_to_use is an item ID or GameData::Item object. own_item is whether the
00271:   # item is held by self. fling is for Fling only.
00272:   def pbHeldItemTriggered(item_to_use, own_item = true, fling = false)
00273:     # Cheek Pouch
00274:     if hasActiveAbility?(:CHEEKPOUCH) && GameData::Item.get(item_to_use).is_berry? && canHeal?
00275:       @battle.pbShowAbilitySplash(self)
00276:       pbRecoverHP(@totalhp / 3)
00277:       if Battle::Scene::USE_ABILITY_SPLASH
00278:         @battle.pbDisplay(_INTL("{1}'s HP was restored.", pbThis))
00279:       else
00280:         @battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", pbThis, abilityName))
00281:       end
00282:       @battle.pbHideAbilitySplash(self)
00283:     end
00284:     pbConsumeItem if own_item
00285:     pbSymbiosis if !own_item && !fling   # Bug Bite/Pluck users trigger Symbiosis
00286:   end
00287: 
00288:   #=============================================================================
00289:   # Held item trigger checks
00290:   #=============================================================================
00291:   # NOTE: A Pokémon using Bug Bite/Pluck, and a Pokémon having an item thrown at
00292:   #       it via Fling, will gain the effect of the item even if the Pokémon is
00293:   #       affected by item-negating effects.
00294:   # item_to_use is an item ID for Stuff Cheeks, Teatime, Bug Bite/Pluck and
00295:   # Fling, and nil otherwise.
00296:   # fling is for Fling only.
00297:   def pbHeldItemTriggerCheck(item_to_use = nil, fling = false)
00298:     return if fainted?
00299:     return if !item_to_use && !itemActive?
00300:     pbItemHPHealCheck(item_to_use, fling)
00301:     pbItemStatusCureCheck(item_to_use, fling)
00302:     pbItemEndOfMoveCheck(item_to_use, fling)
00303:     # For Enigma Berry, Kee Berry and Maranga Berry, which have their effects
00304:     # when forcibly consumed by Pluck/Fling.
00305:     if item_to_use
00306:       itm = item_to_use || self.item
00307:       if Battle::ItemEffects.triggerOnBeingHitPositiveBerry(itm, self, @battle, true)
00308:         pbHeldItemTriggered(itm, false, fling)
00309:       end
00310:     end
00311:   end
00312: 
00313:   # item_to_use is an item ID for Bug Bite/Pluck and Fling, and nil otherwise.
00314:   # fling is for Fling only.
00315:   def pbItemHPHealCheck(item_to_use = nil, fling = false)
00316:     return if !item_to_use && !itemActive?
00317:     itm = item_to_use || self.item
00318:     if Battle::ItemEffects.triggerHPHeal(itm, self, @battle, !item_to_use.nil?)
00319:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00320:     elsif !item_to_use
00321:       pbItemTerrainStatBoostCheck
00322:     end
00323:   end
00324: 
00325:   # Cures status conditions, confusion, infatuation and the other effects cured
00326:   # by Mental Herb.
00327:   # item_to_use is an item ID for Bug Bite/Pluck and Fling, and nil otherwise.
00328:   # fling is for Fling only.
00329:   def pbItemStatusCureCheck(item_to_use = nil, fling = false)
00330:     return if fainted?
00331:     return if !item_to_use && !itemActive?
00332:     itm = item_to_use || self.item
00333:     if Battle::ItemEffects.triggerStatusCure(itm, self, @battle, !item_to_use.nil?)
00334:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00335:     end
00336:   end
00337: 
00338:   # Called at the end of using a move.
00339:   # item_to_use is an item ID for Bug Bite/Pluck and Fling, and nil otherwise.
00340:   # fling is for Fling only.
00341:   def pbItemEndOfMoveCheck(item_to_use = nil, fling = false)
00342:     return if fainted?
00343:     return if !item_to_use && !itemActive?
00344:     itm = item_to_use || self.item
00345:     if Battle::ItemEffects.triggerOnEndOfUsingMove(itm, self, @battle, !item_to_use.nil?)
00346:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00347:     elsif Battle::ItemEffects.triggerOnEndOfUsingMoveStatRestore(itm, self, @battle, !item_to_use.nil?)
00348:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00349:     end
00350:   end
00351: 
00352:   # Used for White Herb (restore lowered stats). Only called by Moody and Sticky
00353:   # Web, as all other stat reduction happens because of/during move usage and
00354:   # this handler is also called at the end of each move's usage.
00355:   # item_to_use is an item ID for Bug Bite/Pluck and Fling, and nil otherwise.
00356:   # fling is for Fling only.
00357:   def pbItemStatRestoreCheck(item_to_use = nil, fling = false)
00358:     return if fainted?
00359:     return if !item_to_use && !itemActive?
00360:     itm = item_to_use || self.item
00361:     if Battle::ItemEffects.triggerOnEndOfUsingMoveStatRestore(itm, self, @battle, !item_to_use.nil?)
00362:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00363:     end
00364:   end
00365: 
00366:   # Called when the battle terrain changes and when a Pokémon loses HP.
00367:   def pbItemTerrainStatBoostCheck
00368:     return if !itemActive?
00369:     if Battle::ItemEffects.triggerTerrainStatBoost(self.item, self, @battle)
00370:       pbHeldItemTriggered(self.item)
00371:     end
00372:   end
00373: 
00374:   # Used for Adrenaline Orb. Called when Intimidate is triggered (even if
00375:   # Intimidate has no effect on the Pokémon).
00376:   def pbItemOnIntimidatedCheck
00377:     return if !itemActive?
00378:     if Battle::ItemEffects.triggerOnIntimidated(self.item, self, @battle)
00379:       pbHeldItemTriggered(self.item)
00380:     end
00381:   end
00382: 
00383:   # Used for Eject Pack. Returns whether self has switched out.
00384:   def pbItemOnStatDropped(move_user = nil)
00385:     return false if !@statsDropped
00386:     return false if !itemActive?
00387:     return Battle::ItemEffects.triggerOnStatLoss(self.item, self, move_user, @battle)
00388:   end
00389: 
00390:   def pbItemsOnUnnerveEnding
00391:     @battle.pbPriority(true).each do |b|
00392:       b.pbHeldItemTriggerCheck if b.item&.is_berry?
00393:     end
00394:   end
00395: 
00396:   #=============================================================================
00397:   # Item effects
00398:   #=============================================================================
00399:   def pbConfusionBerry(item_to_use, forced, confuse_stat, confuse_msg)
00400:     return false if !forced && !canHeal?
00401:     return false if !forced && !canConsumePinchBerry?(Settings::MECHANICS_GENERATION >= 7)
00402:     used_item_name = GameData::Item.get(item_to_use).name
00403:     fraction_to_heal = 8   # Gens 6 and lower
00404:     if Settings::MECHANICS_GENERATION == 7
00405:       fraction_to_heal = 2
00406:     elsif Settings::MECHANICS_GENERATION >= 8
00407:       fraction_to_heal = 3
00408:     end
00409:     amt = @totalhp / fraction_to_heal
00410:     ripening = false
00411:     if hasActiveAbility?(:RIPEN)
00412:       @battle.pbShowAbilitySplash(self, forced)
00413:       amt *= 2
00414:       ripening = true
00415:     end
00416:     @battle.pbCommonAnimation("EatBerry", self) if !forced
00417:     @battle.pbHideAbilitySplash(self) if ripening
00418:     amt = pbRecoverHP(amt)
00419:     if amt > 0
00420:       if forced
00421:         PBDebug.log("[Item triggered] Forced consuming of #{used_item_name}")
00422:         @battle.pbDisplay(_INTL("{1}'s HP was restored.", pbThis))
00423:       else
00424:         @battle.pbDisplay(_INTL("{1} restored its health using its {2}!", pbThis, used_item_name))
00425:       end
00426:     end
00427:     if self.nature.stat_changes.any? { |val| val[0] == confuse_stat && val[1] < 0 }
00428:       @battle.pbDisplay(confuse_msg)
00429:       pbConfuse if pbCanConfuseSelf?(false)
00430:     end
00431:     return true
00432:   end
00433: 
00434:   def pbStatIncreasingBerry(item_to_use, forced, stat, increment = 1)
00435:     return false if !forced && !canConsumePinchBerry?
00436:     return false if !pbCanRaiseStatStage?(stat, self)
00437:     used_item_name = GameData::Item.get(item_to_use).name
00438:     ripening = false
00439:     if hasActiveAbility?(:RIPEN)
00440:       @battle.pbShowAbilitySplash(self, forced)
00441:       increment *= 2
00442:       ripening = true
00443:     end
00444:     @battle.pbCommonAnimation("EatBerry", self) if !forced
00445:     @battle.pbHideAbilitySplash(self) if ripening
00446:     return pbRaiseStatStageByCause(stat, increment, self, used_item_name) if !forced
00447:     PBDebug.log("[Item triggered] Forced consuming of #{used_item_name}")
00448:     return pbRaiseStatStage(stat, increment, self)
00449:   end
00450: 
00451:   def pbMoveTypeWeakeningBerry(berry_type, move_type, mults)
00452:     return if move_type != berry_type
00453:     return if !Effectiveness.super_effective?(@damageState.typeMod) && move_type != :NORMAL
00454:     mults[:final_damage_multiplier] /= 2
00455:     @damageState.berryWeakened = true
00456:     ripening = false
00457:     if hasActiveAbility?(:RIPEN)
00458:       @battle.pbShowAbilitySplash(self)
00459:       mults[:final_damage_multiplier] /= 2
00460:       ripening = true
00461:     end
00462:     @battle.pbCommonAnimation("EatBerry", self)
00463:     @battle.pbHideAbilitySplash(self) if ripening
00464:   end
00465: 
00466:   def pbMoveTypePoweringUpGem(gem_type, move, move_type, mults)
00467:     return if move.is_a?(Battle::Move::PledgeMove)   # Pledge moves never consume Gems
00468:     return if move_type != gem_type
00469:     @effects[PBEffects::GemConsumed] = @item_id
00470:     if Settings::MECHANICS_GENERATION >= 6
00471:       mults[:power_multiplier] *= 1.3
00472:     else
00473:       mults[:power_multiplier] *= 1.5
00474:     end
00475:   end
00476: end
