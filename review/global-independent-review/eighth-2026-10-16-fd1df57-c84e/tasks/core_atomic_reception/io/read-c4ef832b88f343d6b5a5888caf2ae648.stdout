00929:   def changeHappiness(method)
00930:     gain = 0
00931:     happiness_range = @happiness / 100
00932:     case method
00933:     when "walking"
00934:       gain = [2, 2, 1][happiness_range]
00935:     when "levelup"
00936:       gain = [5, 4, 3][happiness_range]
00937:     when "groom"
00938:       gain = [10, 10, 4][happiness_range]
00939:     when "evberry"
00940:       gain = [10, 5, 2][happiness_range]
00941:     when "vitamin"
00942:       gain = [5, 3, 2][happiness_range]
00943:     when "wing"
00944:       gain = [3, 2, 1][happiness_range]
00945:     when "machine", "battleitem"
00946:       gain = [1, 1, 0][happiness_range]
00947:     when "faint"
00948:       gain = -1
00949:     when "faintbad"   # Fainted against an opponent that is 30+ levels higher
00950:       gain = [-5, -5, -10][happiness_range]
00951:     when "powder"
00952:       gain = [-5, -5, -10][happiness_range]
00953:     when "energyroot"
00954:       gain = [-10, -10, -15][happiness_range]
00955:     when "revivalherb"
00956:       gain = [-15, -15, -20][happiness_range]
00957:     else
00958:       raise _INTL("Unknown happiness-changing method: {1}", method.to_s)
00959:     end
00960:     if gain > 0
00961:       gain += 1 if @obtain_map == $game_map.map_id
00962:       gain += 1 if @poke_ball == :LUXURYBALL
00963:       gain = (gain * 1.5).floor if hasItem?(:SOOTHEBELL)
00964:       if Settings::APPLY_HAPPINESS_SOFT_CAP && method != "evberry"
00965:         gain = (@happiness >= 179) ? 0 : gain.clamp(0, 179 - @happiness)
00966:       end
00967:     end
00968:     @happiness = (@happiness + gain).clamp(0, 255)
00969:   end
