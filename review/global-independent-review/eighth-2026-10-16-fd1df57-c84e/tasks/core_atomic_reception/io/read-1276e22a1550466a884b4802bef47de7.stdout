00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Turn processing
00004:   #=============================================================================
00005:   def pbProcessTurn(choice, tryFlee = true)
00006:     return false if fainted?
00007:     # Wild roaming Pokémon always flee if possible
00008:     if tryFlee && wild? &&
00009:        @battle.rules["alwaysflee"] && @battle.pbCanRun?(@index)
00010:       pbBeginTurn(choice)
00011:       pbSEPlay("Battle flee")
00012:       @battle.pbDisplay(_INTL("{1} fled from battle!", pbThis))
00013:       @battle.decision = 3
00014:       pbEndTurn(choice)
00015:       return true
00016:     end
00017:     # Shift with the battler next to this one
00018:     if choice[0] == :Shift
00019:       idxOther = -1
00020:       case @battle.pbSideSize(@index)
00021:       when 2
00022:         idxOther = (@index + 2) % 4
00023:       when 3
00024:         if @index != 2 && @index != 3   # If not in middle spot already
00025:           idxOther = (@index.even?) ? 2 : 3
00026:         end
00027:       end
00028:       if idxOther >= 0
00029:         @battle.pbSwapBattlers(@index, idxOther)
00030:         case @battle.pbSideSize(@index)
00031:         when 2
00032:           @battle.pbDisplay(_INTL("{1} moved across!", pbThis))
00033:         when 3
00034:           @battle.pbDisplay(_INTL("{1} moved to the center!", pbThis))
00035:         end
00036:       end
00037:       pbBeginTurn(choice)
00038:       pbCancelMoves
00039:       @lastRoundMoved = @battle.turnCount   # Done something this round
00040:       return true
00041:     end
00042:     # If this battler's action for this round wasn't "use a move"
00043:     if choice[0] != :UseMove
00044:       # Clean up effects that end at battler's turn
00045:       pbBeginTurn(choice)
00046:       pbEndTurn(choice)
00047:       return false
00048:     end
00049:     # Use the move
00050:     PBDebug.log("[Use move] #{pbThis} (#{@index}) used #{choice[2].name}")
00051:     PBDebug.logonerr { pbUseMove(choice, choice[2] == @battle.struggle) }
00052:     @battle.pbJudge
00053:     # Update priority order
00054:     @battle.pbCalculatePriority if Settings::RECALCULATE_TURN_ORDER_AFTER_SPEED_CHANGES
00055:     return true
00056:   end
