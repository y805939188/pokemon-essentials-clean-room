00384:   def pbChooseTarget(idxBattler, target_data, visibleSprites = nil)
00385:     pbShowWindow(TARGET_BOX)
00386:     cw = @sprites["targetWindow"]
00387:     # Create an array of battler names (only valid targets are named)
00388:     texts = pbCreateTargetTexts(idxBattler, target_data)
00389:     # Determine mode based on target_data
00390:     mode = (target_data.num_targets == 1) ? 0 : 1
00391:     cw.setDetails(texts, mode)
00392:     cw.index = pbFirstTarget(idxBattler, target_data)
00393:     pbSelectBattler((mode == 0) ? cw.index : texts, 2)   # Select initial battler/data box
00394:     pbFadeInAndShow(@sprites, visibleSprites) if visibleSprites
00395:     ret = -1
00396:     loop do
00397:       oldIndex = cw.index
00398:       pbUpdate(cw)
00399:       # Update selected command
00400:       if mode == 0   # Choosing just one target, can change index
00401:         if Input.trigger?(Input::LEFT) || Input.trigger?(Input::RIGHT)
00402:           inc = (cw.index.even?) ? -2 : 2
00403:           inc *= -1 if Input.trigger?(Input::RIGHT)
00404:           indexLength = @battle.sideSizes[cw.index % 2] * 2
00405:           newIndex = cw.index
00406:           loop do
00407:             newIndex += inc
00408:             break if newIndex < 0 || newIndex >= indexLength
00409:             next if texts[newIndex].nil?
00410:             cw.index = newIndex
00411:             break
00412:           end
00413:         elsif (Input.trigger?(Input::UP) && cw.index.even?) ||
00414:               (Input.trigger?(Input::DOWN) && cw.index.odd?)
00415:           tryIndex = @battle.pbGetOpposingIndicesInOrder(cw.index)
00416:           tryIndex.each do |idxBattlerTry|
00417:             next if texts[idxBattlerTry].nil?
00418:             cw.index = idxBattlerTry
00419:             break
00420:           end
00421:         end
00422:         if cw.index != oldIndex
00423:           pbPlayCursorSE
00424:           pbSelectBattler(cw.index, 2)   # Select the new battler/data box
00425:         end
00426:       end
00427:       if Input.trigger?(Input::USE)   # Confirm
00428:         ret = cw.index
00429:         pbPlayDecisionSE
00430:         break
00431:       elsif Input.trigger?(Input::BACK)   # Cancel
00432:         ret = -1
00433:         pbPlayCancelSE
00434:         break
00435:       end
00436:     end
00437:     pbSelectBattler(-1)   # Deselect all battlers/data boxes
00438:     return ret
00439:   end
00440: 
00441:   #=============================================================================
