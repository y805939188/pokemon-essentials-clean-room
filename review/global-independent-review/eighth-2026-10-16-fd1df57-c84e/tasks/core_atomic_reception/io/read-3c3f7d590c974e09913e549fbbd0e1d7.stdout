00168:   #=============================================================================
00169:   # Critical hit check
00170:   #=============================================================================
00171:   # Return values:
00172:   #   -1: Never a critical hit.
00173:   #    0: Calculate normally.
00174:   #    1: Always a critical hit.
00175:   def pbCritialOverride(user, target); return 0; end
00176: 
00177:   # Returns whether the move will be a critical hit.
00178:   def pbIsCritical?(user, target)
00179:     return false if target.pbOwnSide.effects[PBEffects::LuckyChant] > 0
00180:     c = 0
00181:     # Ability effects that alter critical hit rate
00182:     if c >= 0 && user.abilityActive?
00183:       c = Battle::AbilityEffects.triggerCriticalCalcFromUser(user.ability, user, target, c)
00184:     end
00185:     if c >= 0 && target.abilityActive? && !@battle.moldBreaker
00186:       c = Battle::AbilityEffects.triggerCriticalCalcFromTarget(target.ability, user, target, c)
00187:     end
00188:     # Item effects that alter critical hit rate
00189:     if c >= 0 && user.itemActive?
00190:       c = Battle::ItemEffects.triggerCriticalCalcFromUser(user.item, user, target, c)
00191:     end
00192:     if c >= 0 && target.itemActive?
00193:       c = Battle::ItemEffects.triggerCriticalCalcFromTarget(target.item, user, target, c)
00194:     end
00195:     return false if c < 0
00196:     # Move-specific "always/never a critical hit" effects
00197:     case pbCritialOverride(user, target)
00198:     when 1  then return true
00199:     when -1 then return false
00200:     end
00201:     # Other effects
00202:     return true if c > 50   # Merciless
00203:     return true if user.effects[PBEffects::LaserFocus] > 0
00204:     c += 1 if highCriticalRate?
00205:     c += user.effects[PBEffects::FocusEnergy]
00206:     c += 1 if user.inHyperMode? && @type == :SHADOW
00207:     # Set up the critical hit ratios
00208:     ratios = CRITICAL_HIT_RATIOS
00209:     c = ratios.length - 1 if c >= ratios.length
00210:     # Calculation
00211:     return true if ratios[c] == 1
00212:     r = @battle.pbRandom(ratios[c])
00213:     return true if r == 0
00214:     if r == 1 && Settings::AFFECTION_EFFECTS && @battle.internalBattle &&
00215:        user.pbOwnedByPlayer? && user.affection_level == 5 && !target.mega?
00216:       target.damageState.affection_critical = true
00217:       return true
00218:     end
00219:     return false
00220:   end
00221: 
00222:   #=============================================================================
00223:   # Damage calculation
00224:   #=============================================================================
00225:   def pbBaseDamage(baseDmg, user, target);              return baseDmg;    end
00226:   def pbBaseDamageMultiplier(damageMult, user, target); return damageMult; end
00227:   def pbModifyDamage(damageMult, user, target);         return damageMult; end
00228: 
00229:   def pbGetAttackStats(user, target)
00230:     return user.spatk, user.stages[:SPECIAL_ATTACK] + Battle::Battler::STAT_STAGE_MAXIMUM if specialMove?
00231:     return user.attack, user.stages[:ATTACK] + Battle::Battler::STAT_STAGE_MAXIMUM
00232:   end
00233: 
00234:   def pbGetDefenseStats(user, target)
00235:     return target.spdef, target.stages[:SPECIAL_DEFENSE] + Battle::Battler::STAT_STAGE_MAXIMUM if specialMove?
00236:     return target.defense, target.stages[:DEFENSE] + Battle::Battler::STAT_STAGE_MAXIMUM
00237:   end
00238: 
00239:   def pbCalcDamage(user, target, numTargets = 1)
00240:     return if statusMove?
00241:     if target.damageState.disguise || target.damageState.iceFace
00242:       target.damageState.calcDamage = 1
00243:       return
00244:     end
00245:     max_stage = Battle::Battler::STAT_STAGE_MAXIMUM
00246:     stageMul = Battle::Battler::STAT_STAGE_MULTIPLIERS
00247:     stageDiv = Battle::Battler::STAT_STAGE_DIVISORS
00248:     # Get the move's type
00249:     type = @calcType   # nil is treated as physical
00250:     # Calculate whether this hit deals critical damage
00251:     target.damageState.critical = pbIsCritical?(user, target)
00252:     # Calcuate base power of move
00253:     baseDmg = pbBaseDamage(@power, user, target)
00254:     # Calculate user's attack stat
00255:     atk, atkStage = pbGetAttackStats(user, target)
00256:     if !target.hasActiveAbility?(:UNAWARE) || @battle.moldBreaker
00257:       atkStage = max_stage if target.damageState.critical && atkStage < max_stage
00258:       atk = (atk.to_f * stageMul[atkStage] / stageDiv[atkStage]).floor
00259:     end
00260:     # Calculate target's defense stat
