00077:   def pbUseItemMessage(item, trainerName)
00078:     itemName = GameData::Item.get(item).portion_name
00079:     if itemName.starts_with_vowel?
00080:       pbDisplayBrief(_INTL("{1} used an {2}.", trainerName, itemName))
00081:     else
00082:       pbDisplayBrief(_INTL("{1} used a {2}.", trainerName, itemName))
00083:     end
00084:   end
00085: 
00086:   # Uses an item on a Pokémon in the trainer's party.
00087:   def pbUseItemOnPokemon(item, idxParty, userBattler)
00088:     trainerName = pbGetOwnerName(userBattler.index)
00089:     pbUseItemMessage(item, trainerName)
00090:     pkmn = pbParty(userBattler.index)[idxParty]
00091:     battler = pbFindBattler(idxParty, userBattler.index)
00092:     ch = @choices[userBattler.index]
00093:     if ItemHandlers.triggerCanUseInBattle(item, pkmn, battler, ch[3], true, self, @scene, false)
00094:       ItemHandlers.triggerBattleUseOnPokemon(item, pkmn, battler, ch, @scene)
00095:       ch[1] = nil   # Delete item from choice
00096:       return
00097:     end
00098:     pbDisplay(_INTL("But it had no effect!"))
00099:     # Return unused item to Bag
00100:     pbReturnUnusedItemToBag(item, userBattler.index)
00101:   end
00102: 
00103:   # Uses an item on a Pokémon in battle that belongs to the trainer.
00104:   def pbUseItemOnBattler(item, idxParty, userBattler)
00105:     trainerName = pbGetOwnerName(userBattler.index)
00106:     pbUseItemMessage(item, trainerName)
00107:     battler = pbFindBattler(idxParty, userBattler.index)
00108:     ch = @choices[userBattler.index]
00109:     if battler
00110:       if ItemHandlers.triggerCanUseInBattle(item, battler.pokemon, battler, ch[3], true, self, @scene, false)
00111:         ItemHandlers.triggerBattleUseOnBattler(item, battler, @scene)
00112:         ch[1] = nil   # Delete item from choice
00113:         battler.pbItemOnStatDropped
00114:         return
00115:       else
00116:         pbDisplay(_INTL("But it had no effect!"))
00117:       end
00118:     else
00119:       pbDisplay(_INTL("But it's not where this item can be used!"))
00120:     end
00121:     # Return unused item to Bag
00122:     pbReturnUnusedItemToBag(item, userBattler.index)
00123:   end
00124: 
00125:   # Uses a Poké Ball in battle directly.
00126:   def pbUsePokeBallInBattle(item, idxBattler, userBattler)
00127:     idxBattler = userBattler.index if idxBattler < 0
00128:     battler = @battlers[idxBattler]
00129:     ItemHandlers.triggerUseInBattle(item, battler, self)
00130:     @choices[userBattler.index][1] = nil   # Delete item from choice
00131:   end
00132: 
00133:   # Uses an item in battle directly.
00134:   def pbUseItemInBattle(item, idxBattler, userBattler)
00135:     trainerName = pbGetOwnerName(userBattler.index)
00136:     pbUseItemMessage(item, trainerName)
00137:     battler = (idxBattler < 0) ? userBattler : @battlers[idxBattler]
00138:     pkmn = battler.pokemon
00139:     ch = @choices[userBattler.index]
00140:     if ItemHandlers.triggerCanUseInBattle(item, pkmn, battler, ch[3], true, self, @scene, false)
00141:       ItemHandlers.triggerUseInBattle(item, battler, self)
00142:       ch[1] = nil   # Delete item from choice
00143:       return
00144:     end
00145:     pbDisplay(_INTL("But it had no effect!"))
00146:     # Return unused item to Bag
00147:     pbReturnUnusedItemToBag(item, userBattler.index)
00148:   end
00149: end
