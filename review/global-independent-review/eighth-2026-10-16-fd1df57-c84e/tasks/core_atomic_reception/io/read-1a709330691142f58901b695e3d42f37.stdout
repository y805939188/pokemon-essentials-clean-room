00099:   end
00100: 
00101:   #=============================================================================
00102:   # Ability curing
00103:   #=============================================================================
00104:   # Cures status conditions, confusion and infatuation.
00105:   def pbAbilityStatusCureCheck
00106:     if abilityActive?
00107:       Battle::AbilityEffects.triggerStatusCure(self.ability, self)
00108:     end
00109:   end
00110: 
00111:   #=============================================================================
00112:   # Ability effects
00113:   #=============================================================================
00114:   # For abilities that grant immunity to moves of a particular type, and raises
00115:   # one of the ability's bearer's stats instead.
00116:   def pbMoveImmunityStatRaisingAbility(user, move, moveType, immuneType, stat, increment, show_message)
00117:     return false if user.index == @index
00118:     return false if moveType != immuneType
00119:     # NOTE: If show_message is false (Dragon Darts only), the stat will not be
00120:     #       raised. This is not how the official games work, but I'm considering
00121:     #       that a bug because Dragon Darts won't be fired at self in the first
00122:     #       place if it's immune, so why would this ability be triggered by them?
00123:     if show_message
00124:       @battle.pbShowAbilitySplash(self)
00125:       if pbCanRaiseStatStage?(stat, self)
00126:         if Battle::Scene::USE_ABILITY_SPLASH
00127:           pbRaiseStatStage(stat, increment, self)
00128:         else
00129:           pbRaiseStatStageByCause(stat, increment, self, abilityName)
00130:         end
