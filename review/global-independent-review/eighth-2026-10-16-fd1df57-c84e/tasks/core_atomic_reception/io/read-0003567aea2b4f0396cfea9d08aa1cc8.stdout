00190:     else      # specific event
00191:       events = $game_map.events
00192:       return (events) ? events[parameter] : nil
00193:     end
00194:   end
00195: 
00196:   def get_player
00197:     return get_character(-1)
00198:   end
00199: 
00200:   def get_self
00201:     return get_character(0)
00202:   end
00203: 
00204:   def get_event(parameter)
00205:     return get_character(parameter)
00206:   end
00207: 
00208:   # Freezes all events on the map (for use at the beginning of common events)
00209:   def pbGlobalLock
00210:     $game_map.events.each_value { |event| event.minilock }
00211:   end
00212: 
00213:   # Unfreezes all events on the map (for use at the end of common events)
00214:   def pbGlobalUnlock
00215:     $game_map.events.each_value { |event| event.unlock }
00216:   end
00217: 
00218:   # Gets the next index in the interpreter, ignoring certain commands between messages
