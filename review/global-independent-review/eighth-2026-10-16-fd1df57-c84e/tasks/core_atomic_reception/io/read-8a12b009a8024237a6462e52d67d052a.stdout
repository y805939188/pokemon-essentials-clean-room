00720: Battle::AbilityEffects::StatLossImmunity.add(:HYPERCUTTER,
00721:   proc { |ability, battler, stat, battle, showMessages|
00722:     next false if stat != :ATTACK
00723:     if showMessages
00724:       battle.pbShowAbilitySplash(battler)
00725:       if Battle::Scene::USE_ABILITY_SPLASH
00726:         battle.pbDisplay(_INTL("{1}'s {2} cannot be lowered!", battler.pbThis, GameData::Stat.get(stat).name))
00727:       else
00728:         battle.pbDisplay(_INTL("{1}'s {2} prevents {3} loss!", battler.pbThis,
00729:            battler.abilityName, GameData::Stat.get(stat).name))
00730:       end
00731:       battle.pbHideAbilitySplash(battler)
00732:     end
00733:     next true
00734:   }
00735: )
