00453:     # Aurora Veil, Reflect, Light Screen
00454:     if !ignoresReflect? && !target.damageState.critical &&
00455:        !user.hasActiveAbility?(:INFILTRATOR)
00456:       if target.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
00457:         if @battle.pbSideBattlerCount(target) > 1
00458:           multipliers[:final_damage_multiplier] *= 2 / 3.0
00459:         else
00460:           multipliers[:final_damage_multiplier] /= 2
00461:         end
00462:       elsif target.pbOwnSide.effects[PBEffects::Reflect] > 0 && physicalMove?
00463:         if @battle.pbSideBattlerCount(target) > 1
00464:           multipliers[:final_damage_multiplier] *= 2 / 3.0
00465:         else
00466:           multipliers[:final_damage_multiplier] /= 2
00467:         end
00468:       elsif target.pbOwnSide.effects[PBEffects::LightScreen] > 0 && specialMove?
00469:         if @battle.pbSideBattlerCount(target) > 1
00470:           multipliers[:final_damage_multiplier] *= 2 / 3.0
00471:         else
00472:           multipliers[:final_damage_multiplier] /= 2
00473:         end
00474:       end
00475:     end
00476:     # Minimize
00477:     if target.effects[PBEffects::Minimize] && tramplesMinimize?
00478:       multipliers[:final_damage_multiplier] *= 2
00479:     end
00480:     # Move-specific base damage modifiers
00481:     multipliers[:power_multiplier] = pbBaseDamageMultiplier(multipliers[:power_multiplier], user, target)
00482:     # Move-specific final damage modifiers
00483:     multipliers[:final_damage_multiplier] = pbModifyDamage(multipliers[:final_damage_multiplier], user, target)
00484:   end
00485: 
00486:   #=============================================================================
00487:   # Additional effect chance
00488:   #=============================================================================
00489:   def pbAdditionalEffectChance(user, target, effectChance = 0)
00490:     return 0 if target.hasActiveAbility?(:SHIELDDUST) && !@battle.moldBreaker
00491:     ret = (effectChance > 0) ? effectChance : @addlEffect
00492:     return ret if ret > 100
00493:     if (Settings::MECHANICS_GENERATION >= 6 || @function_code != "EffectDependsOnEnvironment") &&
00494:        (user.hasActiveAbility?(:SERENEGRACE) || user.pbOwnSide.effects[PBEffects::Rainbow] > 0)
00495:       ret *= 2
00496:     end
00497:     ret = 100 if $DEBUG && Input.press?(Input::CTRL)
00498:     return ret
00499:   end
00500: 
00501:   # NOTE: Flinching caused by a move's effect is applied in that move's code,
00502:   #       not here.
00503:   def pbFlinchChance(user, target)
00504:     return 0 if flinchingMove?
00505:     return 0 if target.hasActiveAbility?(:SHIELDDUST) && !@battle.moldBreaker
00506:     ret = 0
00507:     if user.hasActiveAbility?(:STENCH, true) ||
00508:        user.hasActiveItem?([:KINGSROCK, :RAZORFANG], true)
00509:       ret = 10
00510:     end
00511:     ret *= 2 if user.hasActiveAbility?(:SERENEGRACE) ||
00512:                 user.pbOwnSide.effects[PBEffects::Rainbow] > 0
00513:     return ret
00514:   end
00515: end
