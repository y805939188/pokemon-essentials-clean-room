00333:   def pbCreateTargetTexts(idxBattler, target_data)
00334:     texts = Array.new(@battle.battlers.length) do |i|
00335:       next nil if !@battle.battlers[i]
00336:       showName = false
00337:       # NOTE: Targets listed here are ones with num_targets of 0, plus
00338:       #       RandomNearFoe which should look like it targets the user. All
00339:       #       other targets are handled by the "else" part.
00340:       case target_data.id
00341:       when :None, :User, :RandomNearFoe
00342:         showName = (i == idxBattler)
00343:       when :UserSide
00344:         showName = !@battle.opposes?(i, idxBattler)
00345:       when :FoeSide
00346:         showName = @battle.opposes?(i, idxBattler)
00347:       when :BothSides
00348:         showName = true
00349:       else
00350:         showName = @battle.pbMoveCanTarget?(idxBattler, i, target_data)
00351:       end
00352:       next nil if !showName
00353:       next (@battle.battlers[i].fainted?) ? "" : @battle.battlers[i].name
00354:     end
00355:     return texts
00356:   end
00357: 
00358:   # Returns the initial position of the cursor when choosing a target for a move
00359:   # in a non-single battle.
00360:   def pbFirstTarget(idxBattler, target_data)
00361:     case target_data.id
00362:     when :NearAlly
00363:       @battle.allSameSideBattlers(idxBattler).each do |b|
00364:         next if b.index == idxBattler || !@battle.nearBattlers?(b, idxBattler)
00365:         next if b.fainted?
00366:         return b.index
00367:       end
00368:       @battle.allSameSideBattlers(idxBattler).each do |b|
00369:         next if b.index == idxBattler || !@battle.nearBattlers?(b, idxBattler)
00370:         return b.index
00371:       end
00372:     when :NearFoe, :NearOther
00373:       indices = @battle.pbGetOpposingIndicesInOrder(idxBattler)
00374:       indices.each { |i| return i if @battle.nearBattlers?(i, idxBattler) && !@battle.battlers[i].fainted? }
00375:       indices.each { |i| return i if @battle.nearBattlers?(i, idxBattler) }
00376:     when :Foe, :Other
00377:       indices = @battle.pbGetOpposingIndicesInOrder(idxBattler)
00378:       indices.each { |i| return i if !@battle.battlers[i].fainted? }
00379:       return indices.first if !indices.empty?
00380:     end
00381:     return idxBattler   # Target the user initially
00382:   end
00383: 
00384:   def pbChooseTarget(idxBattler, target_data, visibleSprites = nil)
00385:     pbShowWindow(TARGET_BOX)
00386:     cw = @sprites["targetWindow"]
00387:     # Create an array of battler names (only valid targets are named)
00388:     texts = pbCreateTargetTexts(idxBattler, target_data)
00389:     # Determine mode based on target_data
00390:     mode = (target_data.num_targets == 1) ? 0 : 1
00391:     cw.setDetails(texts, mode)
00392:     cw.index = pbFirstTarget(idxBattler, target_data)
00393:     pbSelectBattler((mode == 0) ? cw.index : texts, 2)   # Select initial battler/data box
00394:     pbFadeInAndShow(@sprites, visibleSprites) if visibleSprites
00395:     ret = -1
00396:     loop do
00397:       oldIndex = cw.index
