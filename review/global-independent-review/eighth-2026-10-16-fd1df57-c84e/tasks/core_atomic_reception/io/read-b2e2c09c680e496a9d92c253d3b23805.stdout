00758:   def allOpposing
00759:     return @battle.allOtherSideBattlers(@index)
00760:   end
00761: 
00762:   # Returns the battler that is most directly opposite to self. unfaintedOnly is
00763:   # whether it should prefer to return a non-fainted battler.
00764:   def pbDirectOpposing(unfaintedOnly = false)
00765:     @battle.pbGetOpposingIndicesInOrder(@index).each do |i|
00766:       next if !@battle.battlers[i]
00767:       break if unfaintedOnly && @battle.battlers[i].fainted?
00768:       return @battle.battlers[i]
00769:     end
00770:     # Wanted an unfainted battler but couldn't find one; make do with a fainted
00771:     # battler
00772:     @battle.pbGetOpposingIndicesInOrder(@index).each do |i|
00773:       return @battle.battlers[i] if @battle.battlers[i]
00774:     end
00775:     return @battle.battlers[(@index ^ 1)]
00776:   end
00777: end
