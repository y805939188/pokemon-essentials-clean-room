00780:   def defaultTerrain=(value)
00781:     @field.defaultTerrain  = value
00782:     @field.terrain         = value
00783:     @field.terrainDuration = -1
00784:   end
00785: 
00786:   def pbStartTerrain(user, newTerrain, fixedDuration = true)
00787:     return if @field.terrain == newTerrain
00788:     @field.terrain = newTerrain
00789:     duration = (fixedDuration) ? 5 : -1
00790:     if duration > 0 && user && user.itemActive?
00791:       duration = Battle::ItemEffects.triggerTerrainExtender(user.item, newTerrain,
00792:                                                             duration, user, self)
00793:     end
00794:     @field.terrainDuration = duration
00795:     terrain_data = GameData::BattleTerrain.try_get(@field.terrain)
00796:     pbCommonAnimation(terrain_data.animation) if terrain_data
00797:     pbHideAbilitySplash(user) if user
00798:     case @field.terrain
00799:     when :Electric
00800:       pbDisplay(_INTL("An electric current runs across the battlefield!"))
00801:     when :Grassy
00802:       pbDisplay(_INTL("Grass grew to cover the battlefield!"))
00803:     when :Misty
00804:       pbDisplay(_INTL("Mist swirled about the battlefield!"))
00805:     when :Psychic
00806:       pbDisplay(_INTL("The battlefield got weird!"))
00807:     end
00808:     # Check for abilities/items that trigger upon the terrain changing
00809:     allBattlers.each { |b| b.pbAbilityOnTerrainChange }
00810:     allBattlers.each { |b| b.pbItemTerrainStatBoostCheck }
00811:   end
00812: 
00813:   #=============================================================================
00814:   # Messages and animations
00815:   #=============================================================================
00816:   def pbDisplay(msg, &block)
00817:     @scene.pbDisplayMessage(msg, &block)
00818:   end
00819: 
00820:   def pbDisplayBrief(msg)
00821:     @scene.pbDisplayMessage(msg, true)
00822:   end
00823: 
00824:   def pbDisplayPaused(msg, &block)
00825:     @scene.pbDisplayPausedMessage(msg, &block)
00826:   end
00827: 
00828:   def pbDisplayConfirm(msg)
00829:     return @scene.pbDisplayConfirmMessage(msg)
00830:   end
00831: 
00832:   # defaultValue of -1 means "can't cancel". If it's 0 or greater, returns that
00833:   # value when pressing the "Back" button.
00834:   def pbShowCommands(msg, commands, defaultValue = -1)
00835:     return @scene.pbShowCommands(msg, commands, defaultValue)
00836:   end
00837: 
00838:   def pbAnimation(move, user, targets, hitNum = 0)
00839:     @scene.pbAnimation(move, user, targets, hitNum) if @showAnims
00840:   end
00841: 
00842:   def pbCommonAnimation(name, user = nil, targets = nil)
00843:     @scene.pbCommonAnimation(name, user, targets) if @showAnims
00844:   end
00845: 
00846:   def pbShowAbilitySplash(battler, delay = false, logTrigger = true)
00847:     PBDebug.log("[Ability triggered] #{battler.pbThis}'s #{battler.abilityName}") if logTrigger
00848:     return if !Scene::USE_ABILITY_SPLASH
00849:     @scene.pbShowAbilitySplash(battler)
00850:     if delay
00851:       timer_start = System.uptime
00852:       until System.uptime - timer_start >= 1   # 1 second
00853:         @scene.pbUpdate
00854:       end
00855:     end
00856:   end
00857: 
00858:   def pbHideAbilitySplash(battler)
00859:     return if !Scene::USE_ABILITY_SPLASH
00860:     @scene.pbHideAbilitySplash(battler)
00861:   end
00862: 
00863:   def pbReplaceAbilitySplash(battler)
00864:     return if !Scene::USE_ABILITY_SPLASH
00865:     @scene.pbReplaceAbilitySplash(battler)
00866:   end
00867: end
