00001: class Battle::Move
00002:   #=============================================================================
00003:   # Effect methods per move usage
00004:   #=============================================================================
00005:   def pbCanChooseMove?(user, commandPhase, showMessages); return true; end   # For Belch
00006:   def pbDisplayChargeMessage(user); end   # For Focus Punch/shell Trap/Beak Blast
00007:   def pbOnStartUse(user, targets); end
00008:   def pbAddTarget(targets, user); end   # For Counter, etc. and Bide
00009:   def pbModifyTargets(targets, user); end   # For Dragon Darts
00010: 
00011:   # Reset move usage counters (child classes can increment them).
00012:   def pbChangeUsageCounters(user, specialUsage)
00013:     user.effects[PBEffects::FuryCutter]   = 0
00014:     user.effects[PBEffects::ParentalBond] = 0
00015:     user.effects[PBEffects::ProtectRate]  = 1
00016:     @battle.field.effects[PBEffects::FusionBolt]  = false
00017:     @battle.field.effects[PBEffects::FusionFlare] = false
00018:   end
00019: 
00020:   def pbDisplayUseMessage(user)
00021:     @battle.pbDisplayBrief(_INTL("{1} used {2}!", user.pbThis, @name))
00022:   end
00023: 
00024:   def pbShowFailMessages?(targets); return true; end
00025:   def pbMissMessage(user, target); return false; end
00026: 
00027:   #=============================================================================
00028:   #
00029:   #=============================================================================
00030:   # Whether the move is currently in the "charging" turn of a two-turn move.
00031:   # Is false if Power Herb or another effect lets a two-turn move charge and
00032:   # attack in the same turn.
00033:   # user.effects[PBEffects::TwoTurnAttack] is set to the move's ID during the
00034:   # charging turn, and is nil during the attack turn.
00035:   def pbIsChargingTurn?(user); return false; end
00036:   def pbDamagingMove?; return damagingMove?; end
00037: 
00038:   def pbContactMove?(user)
00039:     return false if user.hasActiveAbility?(:LONGREACH)
00040:     return contactMove?
00041:   end
00042: 
00043:   # The maximum number of hits in a round this move will actually perform. This
00044:   # can be 1 for Beat Up, and can be 2 for any moves affected by Parental Bond.
00045:   def pbNumHits(user, targets)
00046:     if user.hasActiveAbility?(:PARENTALBOND) && pbDamagingMove? &&
00047:        !chargingTurnMove? && targets.length == 1
00048:       # Record that Parental Bond applies, to weaken the second attack
00049:       user.effects[PBEffects::ParentalBond] = 3
00050:       return 2
00051:     end
00052:     return 1
00053:   end
00054: 
00055:   # For two-turn moves when they charge and attack in the same turn.
00056:   def pbQuickChargingMove(user, targets); end
00057: 
00058:   #=============================================================================
00059:   # Effect methods per hit
00060:   #=============================================================================
00061:   def pbOverrideSuccessCheckPerHit(user, target); return false; end
00062:   def pbCrashDamage(user); end
00063:   def pbInitialEffect(user, targets, hitNum); end
00064:   def pbDesignateTargetsForHit(targets, hitNum); return targets; end   # For Dragon Darts
00065:   def pbRepeatHit?; return false; end   # For Dragon Darts
00066: 
00067:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00068:     return if !showAnimation
00069:     if user.effects[PBEffects::ParentalBond] == 1
00070:       @battle.pbCommonAnimation("ParentalBond", user, targets)
00071:     else
00072:       @battle.pbAnimation(id, user, targets, hitNum)
00073:     end
00074:   end
00075: 
00076:   def pbSelfKO(user); end
00077:   def pbEffectWhenDealingDamage(user, target); end
00078:   def pbEffectAgainstTarget(user, target); end
00079:   def pbEffectGeneral(user); end
00080:   def pbAdditionalEffect(user, target); end
00081:   def pbEffectAfterAllHits(user, target); end   # Move effects that occur after all hits
00082:   def pbSwitchOutTargetEffect(user, targets, numHits, switched_battlers); end
