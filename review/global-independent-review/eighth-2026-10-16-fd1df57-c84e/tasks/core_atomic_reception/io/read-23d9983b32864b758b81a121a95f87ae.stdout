00496:     # Skip battle if the player has no able Pokémon, or if holding Ctrl in Debug mode
00497:     if BattleCreationHelperMethods.skip_battle?
00498:       return BattleCreationHelperMethods.skip_battle(outcome_variable, true)
00499:     end
00500:     # Record information about party Pokémon to be used at the end of battle (e.g.
00501:     # comparing levels for an evolution check)
00502:     EventHandlers.trigger(:on_start_battle)
00503:     # Generate information for the foes
00504:     foe_trainers, foe_items, foe_party, foe_party_starts = TrainerBattle.generate_foes(*args)
00505:     # Generate information for the player and partner trainer(s)
00506:     player_trainers, ally_items, player_party, player_party_starts = BattleCreationHelperMethods.set_up_player_trainers(foe_party)
00507:     # Create the battle scene (the visual side of it)
00508:     scene = BattleCreationHelperMethods.create_battle_scene
00509:     # Create the battle class (the mechanics side of it)
00510:     battle = Battle.new(scene, player_party, foe_party, player_trainers, foe_trainers)
00511:     battle.party1starts = player_party_starts
00512:     battle.party2starts = foe_party_starts
00513:     battle.ally_items   = ally_items
00514:     battle.items        = foe_items
00515:     # Set various other properties in the battle class
00516:     setBattleRule("#{foe_trainers.length}v#{foe_trainers.length}") if $game_temp.battle_rules["size"].nil?
00517:     BattleCreationHelperMethods.prepare_battle(battle)
00518:     $game_temp.clear_battle_rules
00519:     # Perform the battle itself
00520:     outcome = 0
00521:     pbBattleAnimation(pbGetTrainerBattleBGM(foe_trainers), (battle.singleBattle?) ? 1 : 3, foe_trainers) do
00522:       pbSceneStandby { outcome = battle.pbStartBattle }
00523:       BattleCreationHelperMethods.after_battle(outcome, can_lose)
00524:     end
00525:     Input.update
00526:     # Save the result of the battle in a Game Variable (1 by default)
00527:     BattleCreationHelperMethods.set_outcome(outcome, outcome_variable, true)
00528:     return outcome
