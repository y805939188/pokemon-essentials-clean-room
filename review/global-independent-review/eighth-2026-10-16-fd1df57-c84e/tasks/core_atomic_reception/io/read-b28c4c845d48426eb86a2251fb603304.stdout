01299: class Battle::Move::StartGravity < Battle::Move
01300:   def pbMoveFailed?(user, targets)
01301:     if @battle.field.effects[PBEffects::Gravity] > 0
01302:       @battle.pbDisplay(_INTL("But it failed!"))
01303:       return true
01304:     end
01305:     return false
01306:   end
01307: 
01308:   def pbEffectGeneral(user)
01309:     @battle.field.effects[PBEffects::Gravity] = 5
01310:     @battle.pbDisplay(_INTL("Gravity intensified!"))
01311:     @battle.allBattlers.each do |b|
01312:       showMessage = false
01313:       if b.inTwoTurnAttack?("TwoTurnAttackInvulnerableInSky",
01314:                             "TwoTurnAttackInvulnerableInSkyParalyzeTarget",
01315:                             "TwoTurnAttackInvulnerableInSkyTargetCannotAct")
01316:         b.effects[PBEffects::TwoTurnAttack] = nil
01317:         @battle.pbClearChoice(b.index) if !b.movedThisRound?
01318:         showMessage = true
01319:       end
01320:       if b.effects[PBEffects::MagnetRise] > 0 ||
01321:          b.effects[PBEffects::Telekinesis] > 0 ||
01322:          b.effects[PBEffects::SkyDrop] >= 0
01323:         b.effects[PBEffects::MagnetRise]  = 0
01324:         b.effects[PBEffects::Telekinesis] = 0
01325:         b.effects[PBEffects::SkyDrop]     = -1
01326:         showMessage = true
01327:       end
01328:       if showMessage
01329:         @battle.pbDisplay(_INTL("{1} couldn't stay airborne because of gravity!", b.pbThis))
01330:       end
01331:     end
01332:   end
01333: end
01334: 
01335: #===============================================================================
01336: # User transforms into the target. (Transform)
01337: #===============================================================================
01338: class Battle::Move::TransformUserIntoTarget < Battle::Move
01339:   def pbMoveFailed?(user, targets)
01340:     if user.effects[PBEffects::Transform]
01341:       @battle.pbDisplay(_INTL("But it failed!"))
01342:       return true
01343:     end
01344:     return false
01345:   end
01346: 
01347:   def pbFailsAgainstTarget?(user, target, show_message)
01348:     if target.effects[PBEffects::Transform] ||
01349:        target.effects[PBEffects::Illusion]
01350:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
01351:       return true
01352:     end
01353:     return false
01354:   end
01355: 
01356:   def pbEffectAgainstTarget(user, target)
01357:     user.pbTransform(target)
01358:   end
01359: 
01360:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
01361:     super
01362:     @battle.scene.pbChangePokemon(user, targets[0].pokemon)
01363:   end
01364: end
