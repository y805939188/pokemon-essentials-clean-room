00045: 
00046:   def trainer_type_name; return GameData::TrainerType.get(self.trainer_type).name;            end
00047:   def base_money;        return GameData::TrainerType.get(self.trainer_type).base_money;      end
00048:   def gender;            return GameData::TrainerType.get(self.trainer_type).gender;          end
00049:   def male?;             return GameData::TrainerType.get(self.trainer_type).male?;           end
00050:   def female?;           return GameData::TrainerType.get(self.trainer_type).female?;         end
00051:   def skill_level;       return GameData::TrainerType.get(self.trainer_type).skill_level;     end
00052:   def flags;             return GameData::TrainerType.get(self.trainer_type).flags;           end
00053:   def has_flag?(flag);   return GameData::TrainerType.get(self.trainer_type).has_flag?(flag); end
00054: 
00055:   #=============================================================================
00056: 
00057:   def pokemon_party
00058:     return @party.find_all { |p| p && !p.egg? }
00059:   end
00060: 
00061:   def able_party
00062:     return @party.find_all { |p| p && !p.egg? && !p.fainted? }
00063:   end
00064: 
00065:   def party_count
00066:     return @party.length
00067:   end
00068: 
00069:   def pokemon_count
00070:     ret = 0
00071:     @party.each { |p| ret += 1 if p && !p.egg? }
00072:     return ret
00073:   end
00074: 
00075:   def able_pokemon_count
00076:     ret = 0
00077:     @party.each { |p| ret += 1 if p && !p.egg? && !p.fainted? }
00078:     return ret
00079:   end
00080: 
00081:   def party_full?
00082:     return party_count >= Settings::MAX_PARTY_SIZE
00083:   end
00084: 
00085:   # Returns true if there are no usable Pokémon in the player's party.
00086:   def all_fainted?
00087:     return able_pokemon_count == 0
00088:   end
00089: 
00090:   def first_party
00091:     return @party[0]
00092:   end
00093: 
00094:   def first_pokemon
00095:     return pokemon_party[0]
00096:   end
00097: 
00098:   def first_able_pokemon
00099:     return able_party[0]
00100:   end
00101: 
00102:   def last_party
00103:     return (@party.length > 0) ? @party[@party.length - 1] : nil
00104:   end
00105: 
00106:   def last_pokemon
00107:     p = pokemon_party
00108:     return (p.length > 0) ? p[p.length - 1] : nil
00109:   end
00110: 
00111:   def last_able_pokemon
00112:     p = able_party
00113:     return (p.length > 0) ? p[p.length - 1] : nil
00114:   end
