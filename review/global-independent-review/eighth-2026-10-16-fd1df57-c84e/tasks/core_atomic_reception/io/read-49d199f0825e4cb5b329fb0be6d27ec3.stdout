00108: def pbMissingTrainer(tr_type, tr_name, tr_version)
00109:   tr_type_data = GameData::TrainerType.try_get(tr_type)
00110:   raise _INTL("Trainer type {1} does not exist.", tr_type) if !tr_type_data
00111:   tr_type = tr_type_data.id
00112:   if !$DEBUG
00113:     raise _INTL("Can't find trainer ({1}, {2}, ID {3})", tr_type.to_s, tr_name, tr_version)
00114:   end
00115:   message = ""
00116:   if tr_version == 0
00117:     message = _INTL("Add new trainer ({1}, {2})?", tr_type.to_s, tr_name)
00118:   else
00119:     message = _INTL("Add new trainer ({1}, {2}, ID {3})?", tr_type.to_s, tr_name, tr_version)
00120:   end
00121:   cmd = pbMessage(message, [_INTL("Yes"), _INTL("No")], 2)
00122:   pbNewTrainer(tr_type, tr_name, tr_version) if cmd == 0
00123:   return cmd
00124: end
