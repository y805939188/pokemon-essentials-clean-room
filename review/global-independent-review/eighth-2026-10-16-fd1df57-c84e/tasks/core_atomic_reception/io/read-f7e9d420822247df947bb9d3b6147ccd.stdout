00570:   # @param check_item [Symbol, String, GameData::Item, nil] item ID to check
00571:   # @return [Boolean] whether the Pokémon is holding the specified item or
00572:   #   an item at all
00573:   def hasItem?(check_item = nil)
00574:     return !@item.nil? if check_item.nil?
00575:     held_item = self.item
00576:     return held_item && held_item == check_item
00577:   end
00578: 
00579:   # @return [Array<Array<Symbol>>] the items this species can be found holding in the wild
00580:   def wildHoldItems
00581:     sp_data = species_data
00582:     return [sp_data.wild_item_common, sp_data.wild_item_uncommon, sp_data.wild_item_rare]
00583:   end
00584: 
00585:   # @return [Mail, nil] mail held by this Pokémon (nil if there is none)
00586:   def mail
00587:     @mail = nil if @mail && (!@mail.item || !hasItem?(@mail.item))
00588:     return @mail
00589:   end
00590: 
00591:   # If mail is a Mail object, gives that mail to this Pokémon. If nil is given,
00592:   # removes the held mail.
00593:   # @param mail [Mail, nil] mail to be held by this Pokémon
00594:   def mail=(mail)
00595:     if !mail.nil? && !mail.is_a?(Mail)
00596:       raise ArgumentError, _INTL("Invalid value {1} given", mail.inspect)
00597:     end
00598:     @mail = mail
00599:   end
00600: 
00601:   #=============================================================================
00602:   # Moves
00603:   #=============================================================================
00604: 
00605:   # @return [Integer] the number of moves known by the Pokémon
00606:   def numMoves
00607:     return @moves.length
00608:   end
00609: 
00610:   # @param move_id [Symbol, String, GameData::Move] ID of the move to check
00611:   # @return [Boolean] whether the Pokémon knows the given move
00612:   def hasMove?(move_id)
00613:     move_data = GameData::Move.try_get(move_id)
00614:     return false if !move_data
00615:     return @moves.any? { |m| m.id == move_data.id }
00616:   end
00617: 
00618:   # Returns the list of moves this Pokémon can learn by levelling up.
00619:   # @return [Array<Array<Integer,Symbol>>] this Pokémon's move list, where every element is [level, move ID]
00620:   def getMoveList
00621:     return species_data.moves
00622:   end
00623: 
00624:   # Sets this Pokémon's movelist to the default movelist it originally had.
00625:   def reset_moves
00626:     this_level = self.level
00627:     # Find all level-up moves that self could have learned
