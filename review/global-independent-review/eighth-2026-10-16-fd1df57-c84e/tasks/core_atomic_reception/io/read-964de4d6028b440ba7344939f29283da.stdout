00284:   def pbTriggeredTrainerEvents(triggers, checkIfRunning = true, trainer_only = false)
00285:     result = []
00286:     # If event is running
00287:     return result if checkIfRunning && $game_system.map_interpreter.running?
00288:     # All event loops
00289:     $game_map.events.each_value do |event|
00290:       next if !triggers.include?(event.trigger)
00291:       next if !event.name[/trainer\((\d+)\)/i] && (trainer_only || !event.name[/sight\((\d+)\)/i])
00292:       distance = $~[1].to_i
00293:       next if !pbEventCanReachPlayer?(event, self, distance)
00294:       next if event.jumping? || event.over_trigger?
00295:       result.push(event)
00296:     end
00297:     return result
00298:   end
00299: 
00300:   def pbTriggeredCounterEvents(triggers, checkIfRunning = true)
00301:     result = []
00302:     # If event is running
00303:     return result if checkIfRunning && $game_system.map_interpreter.running?
00304:     # All event loops
00305:     $game_map.events.each_value do |event|
00306:       next if !triggers.include?(event.trigger)
00307:       next if !event.name[/counter\((\d+)\)/i]
00308:       distance = $~[1].to_i
00309:       next if !pbEventFacesPlayer?(event, self, distance)
00310:       next if event.jumping? || event.over_trigger?
00311:       result.push(event)
00312:     end
00313:     return result
00314:   end
