00108: end
00109: 
00110: # Record current levels of Pokémon in party, to see if they gain a level during
00111: # battle and may need to evolve afterwards
00112: EventHandlers.add(:on_start_battle, :record_party_status,
00113:   proc {
00114:     $game_temp.party_levels_before_battle = []
00115:     $game_temp.party_critical_hits_dealt = []
00116:     $game_temp.party_direct_damage_taken = []
00117:     $player.party.each_with_index do |pkmn, i|
00118:       $game_temp.party_levels_before_battle[i] = pkmn.level
00119:       $game_temp.party_critical_hits_dealt[i] = 0
00120:       $game_temp.party_direct_damage_taken[i] = 0
00121:     end
00122:   }
00123: )
00124: 
00125: def pbCanDoubleBattle?
00126:   return true if $player.able_pokemon_count >= 2
00127:   return $PokemonGlobal.partner && $player.able_pokemon_count >= 1
00128: end
00129: 
00130: def pbCanTripleBattle?
00131:   return true if $player.able_pokemon_count >= 3
00132:   return $PokemonGlobal.partner && $player.able_pokemon_count >= 2
00133: end
00134: 
00135: #===============================================================================
00136: # Helper methods for setting up and closing down battles
