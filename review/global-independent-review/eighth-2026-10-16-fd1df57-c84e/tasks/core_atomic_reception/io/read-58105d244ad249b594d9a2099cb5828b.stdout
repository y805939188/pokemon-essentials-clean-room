00901: 
00902: Battle::AbilityEffects::MoveImmunity.add(:BULLETPROOF,
00903:   proc { |ability, user, target, move, type, battle, show_message|
00904:     next false if !move.bombMove?
00905:     if show_message
00906:       battle.pbShowAbilitySplash(target)
00907:       if Battle::Scene::USE_ABILITY_SPLASH
00908:         battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true)))
00909:       else
00910:         battle.pbDisplay(_INTL("{1}'s {2} made {3} ineffective!",
00911:            target.pbThis, target.abilityName, move.name))
00912:       end
00913:       battle.pbHideAbilitySplash(target)
00914:     end
00915:     next true
00916:   }
00917: )
00918: 
00919: Battle::AbilityEffects::MoveImmunity.add(:FLASHFIRE,
00920:   proc { |ability, user, target, move, type, battle, show_message|
00921:     next false if user.index == target.index
00922:     next false if type != :FIRE
00923:     if show_message
00924:       battle.pbShowAbilitySplash(target)
00925:       if !target.effects[PBEffects::FlashFire]
00926:         target.effects[PBEffects::FlashFire] = true
00927:         if Battle::Scene::USE_ABILITY_SPLASH
00928:           battle.pbDisplay(_INTL("The power of {1}'s Fire-type moves rose!", target.pbThis(true)))
00929:         else
00930:           battle.pbDisplay(_INTL("The power of {1}'s Fire-type moves rose because of its {2}!",
00931:              target.pbThis(true), target.abilityName))
00932:         end
00933:       elsif Battle::Scene::USE_ABILITY_SPLASH
00934:         battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true)))
00935:       else
00936:         battle.pbDisplay(_INTL("{1}'s {2} made {3} ineffective!",
00937:                                target.pbThis, target.abilityName, move.name))
00938:       end
00939:       battle.pbHideAbilitySplash(target)
00940:     end
00941:     next true
00942:   }
00943: )
00944: 
00945: Battle::AbilityEffects::MoveImmunity.add(:LIGHTNINGROD,
00946:   proc { |ability, user, target, move, type, battle, show_message|
00947:     next target.pbMoveImmunityStatRaisingAbility(user, move, type,
00948:        :ELECTRIC, :SPECIAL_ATTACK, 1, show_message)
00949:   }
00950: )
00951: 
00952: Battle::AbilityEffects::MoveImmunity.add(:MOTORDRIVE,
00953:   proc { |ability, user, target, move, type, battle, show_message|
00954:     next target.pbMoveImmunityStatRaisingAbility(user, move, type,
00955:        :ELECTRIC, :SPEED, 1, show_message)
00956:   }
00957: )
00958: 
00959: Battle::AbilityEffects::MoveImmunity.add(:SAPSIPPER,
00960:   proc { |ability, user, target, move, type, battle, show_message|
