01022: Battle::AbilityEffects::MoveImmunity.add(:WONDERGUARD,
01023:   proc { |ability, user, target, move, type, battle, show_message|
01024:     next false if move.statusMove?
01025:     next false if !type || Effectiveness.super_effective?(target.damageState.typeMod)
01026:     if show_message
