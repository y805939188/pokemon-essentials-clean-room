00965: 
00966: Battle::AbilityEffects::MoveImmunity.add(:SOUNDPROOF,
00967:   proc { |ability, user, target, move, type, battle, show_message|
00968:     next false if !move.soundMove?
00969:     next false if Settings::MECHANICS_GENERATION >= 8 && user.index == target.index
00970:     if show_message
00971:       battle.pbShowAbilitySplash(target)
00972:       if Battle::Scene::USE_ABILITY_SPLASH
00973:         battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true)))
00974:       else
00975:         battle.pbDisplay(_INTL("{1}'s {2} blocks {3}!", target.pbThis, target.abilityName, move.name))
00976:       end
00977:       battle.pbHideAbilitySplash(target)
00978:     end
00979:     next true
00980:   }
00981: )
00982: 
00983: Battle::AbilityEffects::MoveImmunity.add(:STORMDRAIN,
00984:   proc { |ability, user, target, move, type, battle, show_message|
00985:     next target.pbMoveImmunityStatRaisingAbility(user, move, type,
00986:        :WATER, :SPECIAL_ATTACK, 1, show_message)
00987:   }
00988: )
00989: 
00990: Battle::AbilityEffects::MoveImmunity.add(:TELEPATHY,
00991:   proc { |ability, user, target, move, type, battle, show_message|
00992:     next false if move.statusMove?
00993:     next false if user.index == target.index || target.opposes?(user)
00994:     if show_message
00995:       battle.pbShowAbilitySplash(target)
00996:       if Battle::Scene::USE_ABILITY_SPLASH
00997:         battle.pbDisplay(_INTL("{1} avoids attacks by its ally Pokémon!", target.pbThis(true)))
00998:       else
00999:         battle.pbDisplay(_INTL("{1} avoids attacks by its ally Pokémon with {2}!",
01000:            target.pbThis, target.abilityName))
01001:       end
01002:       battle.pbHideAbilitySplash(target)
01003:     end
01004:     next true
01005:   }
01006: )
01007: 
01008: Battle::AbilityEffects::MoveImmunity.add(:VOLTABSORB,
01009:   proc { |ability, user, target, move, type, battle, show_message|
01010:     next target.pbMoveImmunityHealingAbility(user, move, type, :ELECTRIC, show_message)
01011:   }
01012: )
01013: 
01014: Battle::AbilityEffects::MoveImmunity.add(:WATERABSORB,
01015:   proc { |ability, user, target, move, type, battle, show_message|
