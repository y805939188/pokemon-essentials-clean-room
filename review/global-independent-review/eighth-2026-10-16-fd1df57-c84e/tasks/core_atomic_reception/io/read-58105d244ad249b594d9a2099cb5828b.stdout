00820: #===============================================================================
00821: 
00822: Battle::AbilityEffects::PriorityChange.add(:GALEWINGS,
00823:   proc { |ability, battler, move, pri|
00824:     next pri + 1 if (Settings::MECHANICS_GENERATION <= 6 || battler.hp == battler.totalhp) &&
00825:                     move.type == :FLYING
00826:   }
00827: )
00828: 
00829: Battle::AbilityEffects::PriorityChange.add(:PRANKSTER,
00830:   proc { |ability, battler, move, pri|
00831:     if move.statusMove?
00832:       battler.effects[PBEffects::Prankster] = true
00833:       next pri + 1
00834:     end
00835:   }
00836: )
00837: 
00838: Battle::AbilityEffects::PriorityChange.add(:TRIAGE,
00839:   proc { |ability, battler, move, pri|
00840:     next pri + 3 if move.healingMove?
00841:   }
00842: )
