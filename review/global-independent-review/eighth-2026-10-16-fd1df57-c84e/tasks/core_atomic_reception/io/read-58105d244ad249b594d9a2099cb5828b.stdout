01030:       else
01031:         battle.pbDisplay(_INTL("{1} avoided damage with {2}!", target.pbThis, target.abilityName))
01032:       end
01033:       battle.pbHideAbilitySplash(target)
01034:     end
01035:     next true
01036:   }
01037: )
