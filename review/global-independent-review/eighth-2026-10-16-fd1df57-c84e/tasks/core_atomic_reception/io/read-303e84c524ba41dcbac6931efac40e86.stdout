00120:   def pbEORWishHealing
00121:     @positions.each_with_index do |pos, idxPos|
00122:       next if !pos || pos.effects[PBEffects::Wish] == 0
00123:       pos.effects[PBEffects::Wish] -= 1
00124:       next if pos.effects[PBEffects::Wish] > 0
00125:       next if !@battlers[idxPos] || !@battlers[idxPos].canHeal?
00126:       wishMaker = pbThisEx(idxPos, pos.effects[PBEffects::WishMaker])
00127:       @battlers[idxPos].pbRecoverHP(pos.effects[PBEffects::WishAmount])
00128:       pbDisplay(_INTL("{1}'s wish came true!", wishMaker))
00129:     end
00130:   end
