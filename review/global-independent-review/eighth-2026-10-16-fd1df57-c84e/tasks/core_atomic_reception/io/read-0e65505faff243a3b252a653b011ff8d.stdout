00185: 
00186:   def pbInitPokemon(*arg)
00187:     self.pokemon.hyper_mode = false if self.pokemonIndex > 0 && inHyperMode?
00188:     __shadow__pbInitPokemon(*arg)
00189:     # Called into battle
00190:     if shadowPokemon?
00191:       self.types = [:SHADOW] if GameData::Type.exists?(:SHADOW)
00192:       self.pokemon.change_heart_gauge("battle") if pbOwnedByPlayer?
00193:     end
00194:   end
00195: 
00196:   def shadowPokemon?
00197:     p = self.pokemon
00198:     return p&.shadowPokemon?
00199:   end
00200: 
00201:   def inHyperMode?
00202:     return false if fainted?
00203:     p = self.pokemon
00204:     return p&.hyper_mode
00205:   end
00206: 
00207:   def pbHyperMode
00208:     return if fainted? || !shadowPokemon? || inHyperMode? || !pbOwnedByPlayer?
00209:     p = self.pokemon
00210:     if @battle.pbRandom(p.heart_gauge) <= p.max_gauge_size / 4
00211:       p.hyper_mode = true
00212:       @battle.pbDisplay(_INTL("{1}'s emotions rose to a fever pitch!\nIt entered Hyper Mode!", self.pbThis))
00213:     end
00214:   end
00215: 
00216:   def pbHyperModeObedience(move)
00217:     return true if !inHyperMode?
00218:     return true if !move || move.type == :SHADOW
00219:     return rand(100) < 20
00220:   end
