00005:   def pbReduceHP(amt, anim = true, registerDamage = true, anyAnim = true)
00006:     amt = amt.round
00007:     amt = @hp if amt > @hp
00008:     amt = 1 if amt < 1 && !fainted?
00009:     oldHP = @hp
00010:     self.hp -= amt
00011:     PBDebug.log("[HP change] #{pbThis} lost #{amt} HP (#{oldHP} -> #{@hp})") if amt > 0
00012:     raise _INTL("HP less than 0") if @hp < 0
00013:     raise _INTL("HP greater than total HP") if @hp > @totalhp
00014:     @battle.scene.pbHPChanged(self, oldHP, anim) if anyAnim && amt > 0
00015:     if amt > 0 && registerDamage
00016:       @droppedBelowHalfHP = true if @hp < @totalhp / 2 && @hp + amt >= @totalhp / 2
00017:       @tookDamageThisRound = true
00018:       @tookMoveDamageThisRound = true
00019:     end
00020:     return amt
00021:   end
