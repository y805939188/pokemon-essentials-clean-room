00268: #===============================================================================
00269: # For 5 rounds, creates an electric terrain which boosts Electric-type moves and
00270: # prevents Pokémon from falling asleep. Affects non-airborne Pokémon only.
00271: # (Electric Terrain)
00272: #===============================================================================
00273: class Battle::Move::StartElectricTerrain < Battle::Move
00274:   def pbMoveFailed?(user, targets)
00275:     if @battle.field.terrain == :Electric
00276:       @battle.pbDisplay(_INTL("But it failed!"))
00277:       return true
00278:     end
00279:     return false
00280:   end
00281: 
00282:   def pbEffectGeneral(user)
00283:     @battle.pbStartTerrain(user, :Electric)
00284:   end
00285: end
00286: 
