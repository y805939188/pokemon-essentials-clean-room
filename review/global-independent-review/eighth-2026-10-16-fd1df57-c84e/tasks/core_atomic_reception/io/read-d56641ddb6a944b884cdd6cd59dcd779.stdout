00001: class Battle
00002:   #=============================================================================
00003:   # Gaining Experience
00004:   #=============================================================================
00005:   def pbGainExp
00006:     # Play wild victory music if it's the end of the battle (has to be here)
00007:     @scene.pbWildBattleSuccess if wildBattle? && pbAllFainted?(1) && !pbAllFainted?(0)
00008:     return if !@internalBattle || !@expGain
00009:     # Go through each battler in turn to find the Pokémon that participated in
00010:     # battle against it, and award those Pokémon Exp/EVs
00011:     expAll = $player.has_exp_all || $bag.has?(:EXPALL)
00012:     p1 = pbParty(0)
00013:     @battlers.each do |b|
00014:       next unless b&.opposes?   # Can only gain Exp from fainted foes
00015:       next if b.participants.length == 0
00016:       next unless b.fainted? || b.captured
00017:       # Count the number of participants
00018:       numPartic = 0
00019:       b.participants.each do |partic|
00020:         next unless p1[partic]&.able? && pbIsOwner?(0, partic)
00021:         numPartic += 1
00022:       end
00023:       # Find which Pokémon have an Exp Share
00024:       expShare = []
00025:       if !expAll
00026:         eachInTeam(0, 0) do |pkmn, i|
00027:           next if !pkmn.able?
00028:           next if !pkmn.hasItem?(:EXPSHARE) && GameData::Item.try_get(@initialItems[0][i]) != :EXPSHARE
00029:           expShare.push(i)
00030:         end
00031:       end
00032:       # Calculate EV and Exp gains for the participants
00033:       if numPartic > 0 || expShare.length > 0 || expAll
00034:         # Gain EVs and Exp for participants
00035:         eachInTeam(0, 0) do |pkmn, i|
00036:           next if !pkmn.able?
00037:           next unless b.participants.include?(i) || expShare.include?(i)
00038:           pbGainEVsOne(i, b)
00039:           pbGainExpOne(i, b, numPartic, expShare, expAll, !pkmn.shadowPokemon?)
00040:         end
00041:         # Gain EVs and Exp for all other Pokémon because of Exp All
00042:         if expAll
00043:           showMessage = true
00044:           eachInTeam(0, 0) do |pkmn, i|
00045:             next if !pkmn.able?
00046:             next if b.participants.include?(i) || expShare.include?(i)
00047:             pbDisplayPaused(_INTL("Your other Pokémon also gained Exp. Points!")) if showMessage
00048:             showMessage = false
00049:             pbGainEVsOne(i, b)
00050:             pbGainExpOne(i, b, numPartic, expShare, expAll, false)
00051:           end
00052:         end
00053:       end
00054:       # Clear the participants array
00055:       b.participants = []
00056:     end
00057:   end
00058: 
00059:   def pbGainEVsOne(idxParty, defeatedBattler)
00060:     pkmn = pbParty(0)[idxParty]   # The Pokémon gaining EVs from defeatedBattler
00061:     evYield = defeatedBattler.pokemon.evYield
00062:     # Num of effort points pkmn already has
00063:     evTotal = 0
00064:     GameData::Stat.each_main { |s| evTotal += pkmn.ev[s.id] }
00065:     # Modify EV yield based on pkmn's held item
00066:     if !Battle::ItemEffects.triggerEVGainModifier(pkmn.item, pkmn, evYield)
00067:       Battle::ItemEffects.triggerEVGainModifier(@initialItems[0][idxParty], pkmn, evYield)
00068:     end
00069:     # Double EV gain because of Pokérus
00070:     if pkmn.pokerusStage >= 1   # Infected or cured
00071:       evYield.each_key { |stat| evYield[stat] *= 2 }
00072:     end
00073:     # Gain EVs for each stat in turn
00074:     if pkmn.shadowPokemon? && pkmn.heartStage <= 3 && pkmn.saved_ev
00075:       pkmn.saved_ev.each_value { |e| evTotal += e }
00076:       GameData::Stat.each_main do |s|
00077:         evGain = evYield[s.id].clamp(0, Pokemon::EV_STAT_LIMIT - pkmn.ev[s.id] - pkmn.saved_ev[s.id])
00078:         evGain = evGain.clamp(0, Pokemon::EV_LIMIT - evTotal)
00079:         pkmn.saved_ev[s.id] += evGain
00080:         evTotal += evGain
00081:       end
00082:     else
00083:       GameData::Stat.each_main do |s|
00084:         evGain = evYield[s.id].clamp(0, Pokemon::EV_STAT_LIMIT - pkmn.ev[s.id])
00085:         evGain = evGain.clamp(0, Pokemon::EV_LIMIT - evTotal)
00086:         pkmn.ev[s.id] += evGain
00087:         evTotal += evGain
00088:       end
00089:     end
00090:   end
00091: 
00092:   def pbGainExpOne(idxParty, defeatedBattler, numPartic, expShare, expAll, showMessages = true)
00093:     pkmn = pbParty(0)[idxParty]   # The Pokémon gaining Exp from defeatedBattler
00094:     growth_rate = pkmn.growth_rate
00095:     # Don't bother calculating if gainer is already at max Exp
00096:     if pkmn.exp >= growth_rate.maximum_exp
00097:       pkmn.calc_stats   # To ensure new EVs still have an effect
00098:       return
00099:     end
00100:     isPartic    = defeatedBattler.participants.include?(idxParty)
00101:     hasExpShare = expShare.include?(idxParty)
00102:     level = defeatedBattler.level
00103:     # Main Exp calculation
00104:     exp = 0
00105:     a = level * defeatedBattler.pokemon.base_exp
00106:     if expShare.length > 0 && (isPartic || hasExpShare)
00107:       if numPartic == 0   # No participants, all Exp goes to Exp Share holders
00108:         exp = a / (Settings::SPLIT_EXP_BETWEEN_GAINERS ? expShare.length : 1)
00109:       elsif Settings::SPLIT_EXP_BETWEEN_GAINERS   # Gain from participating and/or Exp Share
00110:         exp = a / (2 * numPartic) if isPartic
00111:         exp += a / (2 * expShare.length) if hasExpShare
00112:       else   # Gain from participating and/or Exp Share (Exp not split)
00113:         exp = (isPartic) ? a : a / 2
00114:       end
00115:     elsif isPartic   # Participated in battle, no Exp Shares held by anyone
00116:       exp = a / (Settings::SPLIT_EXP_BETWEEN_GAINERS ? numPartic : 1)
00117:     elsif expAll   # Didn't participate in battle, gaining Exp due to Exp All
00118:       # NOTE: Exp All works like the Exp Share from Gen 6+, not like the Exp All
00119:       #       from Gen 1, i.e. Exp isn't split between all Pokémon gaining it.
00120:       exp = a / 2
00121:     end
00122:     return if exp <= 0
00123:     # Pokémon gain more Exp from trainer battles
00124:     exp = (exp * 1.5).floor if Settings::MORE_EXP_FROM_TRAINER_POKEMON && trainerBattle?
00125:     # Scale the gained Exp based on the gainer's level (or not)
00126:     if Settings::SCALED_EXP_FORMULA
00127:       exp /= 5
00128:       levelAdjust = ((2 * level) + 10.0) / (pkmn.level + level + 10.0)
00129:       levelAdjust **= 5
00130:       levelAdjust = Math.sqrt(levelAdjust)
00131:       exp *= levelAdjust
00132:       exp = exp.floor
00133:       exp += 1 if isPartic || hasExpShare
00134:     else
00135:       exp /= 7
00136:     end
00137:     # Foreign Pokémon gain more Exp
00138:     isOutsider = (pkmn.owner.id != pbPlayer.id ||
00139:                  (pkmn.owner.language != 0 && pkmn.owner.language != pbPlayer.language))
00140:     if isOutsider
00141:       if pkmn.owner.language != 0 && pkmn.owner.language != pbPlayer.language
00142:         exp = (exp * 1.7).floor
00143:       else
00144:         exp = (exp * 1.5).floor
00145:       end
00146:     end
00147:     # Exp. Charm increases Exp gained
00148:     exp = exp * 3 / 2 if $bag.has?(:EXPCHARM)
00149:     # Modify Exp gain based on pkmn's held item
00150:     i = Battle::ItemEffects.triggerExpGainModifier(pkmn.item, pkmn, exp)
00151:     if i < 0
00152:       i = Battle::ItemEffects.triggerExpGainModifier(@initialItems[0][idxParty], pkmn, exp)
00153:     end
00154:     exp = i if i >= 0
00155:     # Boost Exp gained with high affection
00156:     if Settings::AFFECTION_EFFECTS && @internalBattle && pkmn.affection_level >= 4 && !pkmn.mega?
00157:       exp = exp * 6 / 5
00158:       isOutsider = true   # To show the "boosted Exp" message
00159:     end
00160:     # Make sure Exp doesn't exceed the maximum
00161:     expFinal = growth_rate.add_exp(pkmn.exp, exp)
00162:     expGained = expFinal - pkmn.exp
00163:     return if expGained <= 0
00164:     # "Exp gained" message
00165:     if showMessages
00166:       if isOutsider
00167:         pbDisplayPaused(_INTL("{1} got a boosted {2} Exp. Points!", pkmn.name, expGained))
00168:       else
00169:         pbDisplayPaused(_INTL("{1} got {2} Exp. Points!", pkmn.name, expGained))
00170:       end
00171:     end
00172:     curLevel = pkmn.level
00173:     newLevel = growth_rate.level_from_exp(expFinal)
00174:     if newLevel < curLevel
00175:       debugInfo = "Levels: #{curLevel}->#{newLevel} | Exp: #{pkmn.exp}->#{expFinal} | gain: #{expGained}"
00176:       raise _INTL("{1}'s new level is less than its current level, which shouldn't happen.", pkmn.name) + "\n[#{debugInfo}]"
00177:     end
00178:     # Give Exp
00179:     if pkmn.shadowPokemon?
00180:       if pkmn.heartStage <= 3
