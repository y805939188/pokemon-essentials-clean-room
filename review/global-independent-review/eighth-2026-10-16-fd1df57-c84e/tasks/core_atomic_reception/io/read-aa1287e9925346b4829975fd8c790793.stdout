00637: def pbRegisterPartner(tr_type, tr_name, tr_id = 0)
00638:   tr_type = GameData::TrainerType.get(tr_type).id
00639:   pbCancelVehicles
00640:   trainer = pbLoadTrainer(tr_type, tr_name, tr_id)
00641:   EventHandlers.trigger(:on_trainer_load, trainer)
00642:   trainer.party.each do |i|
00643:     i.owner = Pokemon::Owner.new_from_trainer(trainer)
00644:     i.calc_stats
00645:   end
00646:   $PokemonGlobal.partner = [tr_type, tr_name, trainer.id, trainer.party]
00647: end
00648: 
00649: def pbDeregisterPartner
00650:   $PokemonGlobal.partner = nil
00651: end
00652: 
