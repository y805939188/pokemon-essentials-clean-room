00067:   #=============================================================================
00068: 
00069:   def self.trigger(hash, *args, ret: false)
00070:     new_ret = hash.trigger(*args)
00071:     return (!new_ret.nil?) ? new_ret : ret
00072:   end
00073: 
00074:   #=============================================================================
00075: 
00076:   def self.triggerSpeedCalc(ability, battler, mult)
00077:     return trigger(SpeedCalc, ability, battler, mult, ret: mult)
00078:   end
00079: 
00080:   def self.triggerWeightCalc(ability, battler, weight)
