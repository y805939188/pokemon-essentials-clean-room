00687: def pbMessage(message, commands = nil, cmdIfCancel = 0, skin = nil, defaultCmd = 0, &block)
00688:   ret = 0
00689:   msgwindow = pbCreateMessageWindow(nil, skin)
00690:   if commands
00691:     ret = pbMessageDisplay(msgwindow, message, true,
00692:                            proc { |msgwndw|
00693:                              next Kernel.pbShowCommands(msgwndw, commands, cmdIfCancel, defaultCmd, &block)
00694:                            }, &block)
00695:   else
00696:     pbMessageDisplay(msgwindow, message, &block)
00697:   end
00698:   pbDisposeMessageWindow(msgwindow)
00699:   Input.update
00700:   return ret
00701: end
00702: 
00703: def pbConfirmMessage(message, &block)
00704:   return (pbMessage(message, [_INTL("Yes"), _INTL("No")], 2, &block) == 0)
00705: end
00706: 
00707: def pbConfirmMessageSerious(message, &block)
00708:   return (pbMessage(message, [_INTL("No"), _INTL("Yes")], 1, &block) == 1)
00709: end
00710: 
