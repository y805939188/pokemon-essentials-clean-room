00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Decide whether the trainer is allowed to tell the Pokémon to use the given
00004:   # move. Called when choosing a command for the round.
00005:   # Also called when processing the Pokémon's action, because these effects also
00006:   # prevent Pokémon action. Relevant because these effects can become active
00007:   # earlier in the same round (after choosing the command but before using the
00008:   # move) or an unusable move may be called by another move such as Metronome.
00009:   #=============================================================================
00010:   def pbCanChooseMove?(move, commandPhase, showMessages = true, specialUsage = false)
00011:     # Disable
00012:     if @effects[PBEffects::DisableMove] == move.id && !specialUsage
00013:       if showMessages
00014:         msg = _INTL("{1}'s {2} is disabled!", pbThis, move.name)
00015:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00016:       end
00017:       return false
00018:     end
00019:     # Heal Block
00020:     if @effects[PBEffects::HealBlock] > 0 && move.healingMove?
00021:       if showMessages
00022:         msg = _INTL("{1} can't use {2} because of Heal Block!", pbThis, move.name)
00023:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00024:       end
00025:       return false
00026:     end
00027:     # Gravity
00028:     if @battle.field.effects[PBEffects::Gravity] > 0 && move.unusableInGravity?
00029:       if showMessages
00030:         msg = _INTL("{1} can't use {2} because of gravity!", pbThis, move.name)
00031:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00032:       end
00033:       return false
00034:     end
00035:     # Throat Chop
00036:     if @effects[PBEffects::ThroatChop] > 0 && move.soundMove?
00037:       if showMessages
00038:         msg = _INTL("{1} can't use {2} because of Throat Chop!", pbThis, move.name)
00039:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00040:       end
00041:       return false
00042:     end
00043:     # Choice Band/Gorilla Tactics
00044:     @effects[PBEffects::ChoiceBand] = nil if !pbHasMove?(@effects[PBEffects::ChoiceBand])
00045:     if @effects[PBEffects::ChoiceBand] && move.id != @effects[PBEffects::ChoiceBand]
00046:       choiced_move = GameData::Move.try_get(@effects[PBEffects::ChoiceBand])
00047:       if choiced_move
00048:         if hasActiveItem?([:CHOICEBAND, :CHOICESPECS, :CHOICESCARF])
00049:           if showMessages
00050:             msg = _INTL("The {1} only allows the use of {2}!", itemName, choiced_move.name)
00051:             (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00052:           end
00053:           return false
00054:         elsif hasActiveAbility?(:GORILLATACTICS)
00055:           if showMessages
00056:             msg = _INTL("{1} can only use {2}!", pbThis, choiced_move.name)
00057:             (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00058:           end
00059:           return false
00060:         end
00061:       end
00062:     end
00063:     # Taunt
00064:     if @effects[PBEffects::Taunt] > 0 && move.statusMove? && !specialUsage
00065:       if showMessages
00066:         msg = _INTL("{1} can't use {2} after the taunt!", pbThis, move.name)
00067:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00068:       end
00069:       return false
00070:     end
00071:     # Torment
00072:     if @effects[PBEffects::Torment] && !@effects[PBEffects::Instructed] && !specialUsage &&
00073:        @lastMoveUsed && move.id == @lastMoveUsed && move.id != @battle.struggle.id
00074:       if showMessages
00075:         msg = _INTL("{1} can't use the same move twice in a row due to the torment!", pbThis)
00076:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00077:       end
00078:       return false
00079:     end
00080:     # Imprison
00081:     if @battle.allOtherSideBattlers(@index).any? { |b| b.effects[PBEffects::Imprison] && b.pbHasMove?(move.id) }
00082:       if showMessages
00083:         msg = _INTL("{1} can't use its sealed {2}!", pbThis, move.name)
00084:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00085:       end
00086:       return false
00087:     end
00088:     # Assault Vest (prevents choosing status moves but doesn't prevent
00089:     # executing them)
00090:     if hasActiveItem?(:ASSAULTVEST) && move.statusMove? && move.function_code != "UseMoveTargetIsAboutToUse" && commandPhase
00091:       if showMessages
00092:         msg = _INTL("The effects of the {1} prevent status moves from being used!", itemName)
00093:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00094:       end
00095:       return false
00096:     end
00097:     # Belch
00098:     return false if !move.pbCanChooseMove?(self, commandPhase, showMessages)
00099:     return true
00100:   end
00101: 
00102:   #=============================================================================
00103:   # Obedience check
00104:   #=============================================================================
00105:   # Return true if Pokémon continues attacking (although it may have chosen to
00106:   # use a different move in disobedience), or false if attack stops.
00107:   def pbObedienceCheck?(choice)
00108:     return true if usingMultiTurnAttack?
00109:     return true if choice[0] != :UseMove
00110:     return true if !@battle.internalBattle
00111:     return true if !@battle.pbOwnedByPlayer?(@index)
00112:     disobedient = false
00113:     # Pokémon may be disobedient; calculate if it is
00114:     badge_level = 10 * (@battle.pbPlayer.badge_count + 1)
00115:     badge_level = GameData::GrowthRate.max_level if @battle.pbPlayer.badge_count >= 8
00116:     if Settings::ANY_HIGH_LEVEL_POKEMON_CAN_DISOBEY ||
00117:        (Settings::FOREIGN_HIGH_LEVEL_POKEMON_CAN_DISOBEY && @pokemon.foreign?(@battle.pbPlayer))
00118:       if @level > badge_level
00119:         a = ((@level + badge_level) * @battle.pbRandom(256) / 256).floor
00120:         disobedient |= (a >= badge_level)
00121:       end
00122:     end
00123:     disobedient |= !pbHyperModeObedience(choice[2])
00124:     return true if !disobedient
00125:     # Pokémon is disobedient; make it do something else
00126:     return pbDisobey(choice, badge_level)
00127:   end
00128: 
00129:   def pbDisobey(choice, badge_level)
00130:     move = choice[2]
00131:     PBDebug.log("[Disobedience] #{pbThis} disobeyed")
00132:     @effects[PBEffects::Rage] = false
00133:     # Do nothing if using Snore/Sleep Talk
00134:     if @status == :SLEEP && move.usableWhenAsleep?
00135:       @battle.pbDisplay(_INTL("{1} ignored orders and kept sleeping!", pbThis))
00136:       return false
00137:     end
00138:     b = ((@level + badge_level) * @battle.pbRandom(256) / 256).floor
00139:     # Use another move
00140:     if b < badge_level
00141:       @battle.pbDisplay(_INTL("{1} ignored orders!", pbThis))
00142:       return false if !@battle.pbCanShowFightMenu?(@index)
00143:       otherMoves = []
00144:       eachMoveWithIndex do |_m, i|
00145:         next if i == choice[1]
00146:         otherMoves.push(i) if @battle.pbCanChooseMove?(@index, i, false)
00147:       end
00148:       return false if otherMoves.length == 0   # No other move to use; do nothing
00149:       newChoice = otherMoves[@battle.pbRandom(otherMoves.length)]
00150:       choice[1] = newChoice
00151:       choice[2] = @moves[newChoice]
00152:       choice[3] = -1
00153:       return true
00154:     end
00155:     c = @level - badge_level
00156:     r = @battle.pbRandom(256)
00157:     # Fall asleep
00158:     if r < c && pbCanSleep?(self, false)
00159:       pbSleepSelf(_INTL("{1} began to nap!", pbThis))
00160:       return false
00161:     end
00162:     # Hurt self in confusion
00163:     r -= c
00164:     if r < c && @status != :SLEEP
00165:       pbConfusionDamage(_INTL("{1} won't obey! It hurt itself in its confusion!", pbThis))
00166:       return false
00167:     end
00168:     # Show refusal message and do nothing
00169:     case @battle.pbRandom(4)
00170:     when 0 then @battle.pbDisplay(_INTL("{1} won't obey!", pbThis))
00171:     when 1 then @battle.pbDisplay(_INTL("{1} turned away!", pbThis))
00172:     when 2 then @battle.pbDisplay(_INTL("{1} is loafing around!", pbThis))
00173:     when 3 then @battle.pbDisplay(_INTL("{1} pretended not to notice!", pbThis))
00174:     end
00175:     return false
00176:   end
00177: 
00178:   #=============================================================================
00179:   # Check whether the user (self) is able to take action at all.
00180:   # If this returns true, and if PP isn't a problem, the move will be considered
00181:   # to have been used (even if it then fails for whatever reason).
00182:   #=============================================================================
00183:   def pbTryUseMove(choice, move, specialUsage, skipAccuracyCheck)
00184:     # Check whether it's possible for self to use the given move
00185:     # NOTE: Encore has already changed the move being used, no need to have a
00186:     #       check for it here.
00187:     if !pbCanChooseMove?(move, false, true, specialUsage)
00188:       @lastMoveFailed = true
00189:       return false
00190:     end
00191:     # Check whether it's possible for self to do anything at all
00192:     if @effects[PBEffects::SkyDrop] >= 0   # Intentionally no message here
00193:       PBDebug.log("[Move failed] #{pbThis} can't use #{move.name} because of being Sky Dropped")
00194:       return false
00195:     end
00196:     if @effects[PBEffects::HyperBeam] > 0   # Intentionally before Truant
00197:       PBDebug.log("[Move failed] #{pbThis} is recharging after using #{move.name}")
00198:       @battle.pbDisplay(_INTL("{1} must recharge!", pbThis))
00199:       @effects[PBEffects::Truant] = !@effects[PBEffects::Truant] if hasActiveAbility?(:TRUANT)
00200:       return false
00201:     end
00202:     if choice[1] == -2   # Battle Palace
00203:       PBDebug.log("[Move failed] #{pbThis} can't act in the Battle Palace somehow")
00204:       @battle.pbDisplay(_INTL("{1} appears incapable of using its power!", pbThis))
00205:       return false
00206:     end
00207:     # Skip checking all applied effects that could make self fail doing something
00208:     return true if skipAccuracyCheck
00209:     # Check status problems and continue their effects/cure them
00210:     case @status
00211:     when :SLEEP
00212:       self.statusCount -= 1
00213:       if @statusCount <= 0
00214:         pbCureStatus
00215:       else
00216:         pbContinueStatus
00217:         if !move.usableWhenAsleep?   # Snore/Sleep Talk
00218:           PBDebug.log("[Move failed] #{pbThis} is asleep")
00219:           @lastMoveFailed = true
00220:           return false
00221:         end
00222:       end
00223:     when :FROZEN
00224:       if !move.thawsUser?
00225:         if @battle.pbRandom(100) < 20
00226:           pbCureStatus
00227:         else
00228:           pbContinueStatus
00229:           PBDebug.log("[Move failed] #{pbThis} is frozen")
00230:           @lastMoveFailed = true
00231:           return false
00232:         end
00233:       end
00234:     end
00235:     # Obedience check
00236:     return false if !pbObedienceCheck?(choice)
00237:     # Truant
00238:     if hasActiveAbility?(:TRUANT)
00239:       @effects[PBEffects::Truant] = !@effects[PBEffects::Truant]
00240:       if !@effects[PBEffects::Truant]   # True means loafing, but was just inverted
00241:         @battle.pbShowAbilitySplash(self)
00242:         @battle.pbDisplay(_INTL("{1} is loafing around!", pbThis))
00243:         @lastMoveFailed = true
00244:         @battle.pbHideAbilitySplash(self)
00245:         PBDebug.log("[Move failed] #{pbThis} can't act because of #{abilityName}")
00246:         return false
00247:       end
00248:     end
00249:     # Flinching
00250:     if @effects[PBEffects::Flinch]
00251:       @battle.pbDisplay(_INTL("{1} flinched and couldn't move!", pbThis))
00252:       PBDebug.log("[Move failed] #{pbThis} flinched")
00253:       if abilityActive?
00254:         Battle::AbilityEffects.triggerOnFlinch(self.ability, self, @battle)
00255:       end
00256:       @lastMoveFailed = true
00257:       return false
00258:     end
00259:     # Confusion
00260:     if @effects[PBEffects::Confusion] > 0
00261:       @effects[PBEffects::Confusion] -= 1
00262:       if @effects[PBEffects::Confusion] <= 0
00263:         pbCureConfusion
00264:         @battle.pbDisplay(_INTL("{1} snapped out of its confusion.", pbThis))
00265:       else
00266:         @battle.pbCommonAnimation("Confusion", self)
00267:         @battle.pbDisplay(_INTL("{1} is confused!", pbThis))
00268:         threshold = (Settings::MECHANICS_GENERATION >= 7) ? 33 : 50   # % chance
00269:         if @battle.pbRandom(100) < threshold
00270:           pbConfusionDamage(_INTL("It hurt itself in its confusion!"))
00271:           PBDebug.log("[Move failed] #{pbThis} hurt itself in its confusion")
00272:           @lastMoveFailed = true
00273:           return false
00274:         end
00275:       end
00276:     end
00277:     # Paralysis
00278:     if @status == :PARALYSIS && @battle.pbRandom(100) < 25
00279:       pbContinueStatus
00280:       PBDebug.log("[Move failed] #{pbThis} is paralyzed")
00281:       @lastMoveFailed = true
00282:       return false
00283:     end
00284:     # Infatuation
00285:     if @effects[PBEffects::Attract] >= 0
00286:       @battle.pbCommonAnimation("Attract", self)
00287:       @battle.pbDisplay(_INTL("{1} is in love with {2}!", pbThis,
00288:                               @battle.battlers[@effects[PBEffects::Attract]].pbThis(true)))
00289:       if @battle.pbRandom(100) < 50
00290:         @battle.pbDisplay(_INTL("{1} is immobilized by love!", pbThis))
00291:         PBDebug.log("[Move failed] #{pbThis} is immobilized by love")
00292:         @lastMoveFailed = true
00293:         return false
00294:       end
00295:     end
00296:     return true
00297:   end
00298: 
00299:   #=============================================================================
00300:   # Initial success check against the target. Done once before the first hit.
