00085: class Battle::Move::StatUpMove < Battle::Move
00086:   attr_reader :statUp
00087: 
00088:   def canSnatch?; return true; end
00089: 
00090:   def pbMoveFailed?(user, targets)
00091:     return false if damagingMove?
00092:     return !user.pbCanRaiseStatStage?(@statUp[0], user, self, true)
00093:   end
00094: 
00095:   def pbEffectGeneral(user)
00096:     return if damagingMove?
00097:     user.pbRaiseStatStage(@statUp[0], @statUp[1], user)
00098:   end
00099: 
00100:   def pbAdditionalEffect(user, target)
00101:     if user.pbCanRaiseStatStage?(@statUp[0], user, self)
00102:       user.pbRaiseStatStage(@statUp[0], @statUp[1], user)
00103:     end
00104:   end
00105: end
00106: 
00107: #===============================================================================
00108: # Raise multiple of user's stats.
00109: #===============================================================================
00110: class Battle::Move::MultiStatUpMove < Battle::Move
00111:   attr_reader :statUp
00112: 
00113:   def canSnatch?; return true; end
00114: 
00115:   def pbMoveFailed?(user, targets)
00116:     return false if damagingMove?
00117:     failed = true
00118:     (@statUp.length / 2).times do |i|
00119:       next if !user.pbCanRaiseStatStage?(@statUp[i * 2], user, self)
00120:       failed = false
00121:       break
00122:     end
00123:     if failed
00124:       @battle.pbDisplay(_INTL("{1}'s stats won't go any higher!", user.pbThis))
00125:       return true
00126:     end
00127:     return false
00128:   end
00129: 
00130:   def pbEffectGeneral(user)
00131:     return if damagingMove?
00132:     showAnim = true
00133:     (@statUp.length / 2).times do |i|
00134:       next if !user.pbCanRaiseStatStage?(@statUp[i * 2], user, self)
00135:       if user.pbRaiseStatStage(@statUp[i * 2], @statUp[(i * 2) + 1], user, showAnim)
00136:         showAnim = false
00137:       end
00138:     end
00139:   end
00140: 
00141:   def pbAdditionalEffect(user, target)
00142:     showAnim = true
00143:     (@statUp.length / 2).times do |i|
00144:       next if !user.pbCanRaiseStatStage?(@statUp[i * 2], user, self)
00145:       if user.pbRaiseStatStage(@statUp[i * 2], @statUp[(i * 2) + 1], user, showAnim)
00146:         showAnim = false
00147:       end
00148:     end
00149:   end
00150: end
00151: 
00152: #===============================================================================
00153: # Lower multiple of user's stats.
00154: #===============================================================================
00155: class Battle::Move::StatDownMove < Battle::Move
00156:   attr_reader :statDown
00157: 
00158:   def pbEffectWhenDealingDamage(user, target)
00159:     return if @battle.pbAllFainted?(target.idxOwnSide)
00160:     showAnim = true
00161:     (@statDown.length / 2).times do |i|
00162:       next if !user.pbCanLowerStatStage?(@statDown[i * 2], user, self)
00163:       if user.pbLowerStatStage(@statDown[i * 2], @statDown[(i * 2) + 1], user, showAnim)
00164:         showAnim = false
00165:       end
00166:     end
00167:   end
00168: end
00169: 
00170: #===============================================================================
00171: # Lower one of target's stats.
00172: #===============================================================================
00173: class Battle::Move::TargetStatDownMove < Battle::Move
00174:   attr_reader :statDown
00175: 
00176:   def canMagicCoat?; return true; end
