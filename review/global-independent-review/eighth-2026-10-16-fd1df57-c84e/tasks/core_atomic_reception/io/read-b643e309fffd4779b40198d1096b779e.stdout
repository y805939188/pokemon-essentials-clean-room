00572:     end
00573:     if Settings::MECHANICS_GENERATION >= 6
00574:       if hasActiveAbility?(:OVERCOAT) && !@battle.moldBreaker
00575:         if showMsg
00576:           @battle.pbShowAbilitySplash(self)
00577:           if Battle::Scene::USE_ABILITY_SPLASH
00578:             @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis))
00579:           else
00580:             @battle.pbDisplay(_INTL("{1} is unaffected because of its {2}!", pbThis, abilityName))
00581:           end
00582:           @battle.pbHideAbilitySplash(self)
00583:         end
00584:         return false
00585:       end
00586:       if hasActiveItem?(:SAFETYGOGGLES)
00587:         if showMsg
00588:           @battle.pbDisplay(_INTL("{1} is unaffected because of its {2}!", pbThis, itemName))
00589:         end
00590:         return false
00591:       end
00592:     end
00593:     return true
00594:   end
00595: 
00596:   def canHeal?
00597:     return false if fainted? || @hp >= @totalhp
00598:     return false if @effects[PBEffects::HealBlock] > 0
00599:     return true
00600:   end
00601: 
00602:   def affectedByContactEffect?(showMsg = false)
00603:     return false if fainted?
00604:     if hasActiveItem?(:PROTECTIVEPADS)
00605:       @battle.pbDisplay(_INTL("{1} protected itself with the {2}!", pbThis, itemName)) if showMsg
00606:       return false
00607:     end
00608:     return true
00609:   end
00610: 
00611:   def trappedInBattle?
00612:     return true if @effects[PBEffects::Trapping] > 0
00613:     return true if @effects[PBEffects::MeanLook] >= 0
00614:     return true if @effects[PBEffects::JawLock] >= 0
00615:     return true if @battle.allBattlers.any? { |b| b.effects[PBEffects::JawLock] == @index }
00616:     return true if @effects[PBEffects::Octolock] >= 0
00617:     return true if @effects[PBEffects::Ingrain]
00618:     return true if @effects[PBEffects::NoRetreat]
00619:     return true if @battle.field.effects[PBEffects::FairyLock] > 0
00620:     return false
00621:   end
00622: 
00623:   def movedThisRound?
00624:     return @lastRoundMoved && @lastRoundMoved == @battle.turnCount
00625:   end
00626: 
00627:   def usingMultiTurnAttack?
00628:     return true if @effects[PBEffects::TwoTurnAttack]
00629:     return true if @effects[PBEffects::HyperBeam] > 0
00630:     return true if @effects[PBEffects::Rollout] > 0
00631:     return true if @effects[PBEffects::Outrage] > 0
00632:     return true if @effects[PBEffects::Uproar] > 0
00633:     return true if @effects[PBEffects::Bide] > 0
00634:     return false
00635:   end
