00654: class Battle::Move::GrassPledge < Battle::Move::PledgeMove
00655:   def initialize(battle, move)
00656:     super
00657:     # [Function code to combo with, effect, override type, override animation]
00658:     @combos = [["FirePledge",  :SeaOfFire, :FIRE, :FIREPLEDGE],
00659:                ["WaterPledge", :Swamp,     nil,   nil]]
00660:   end
00661: end
00662: 
00663: #===============================================================================
00664: # Combos with another Pledge move used by the ally. (Fire Pledge)
00665: # If the move is a combo, power is doubled and causes either a rainbow on the
00666: # user's side or a sea of fire on the opposing side.
00667: #===============================================================================
00668: class Battle::Move::FirePledge < Battle::Move::PledgeMove
00669:   def initialize(battle, move)
00670:     super
00671:     # [Function code to combo with, effect, override type, override animation]
00672:     @combos = [["WaterPledge", :Rainbow,   :WATER, :WATERPLEDGE],
00673:                ["GrassPledge", :SeaOfFire, nil,    nil]]
00674:   end
00675: end
00676: 
00677: #===============================================================================
00678: # Combos with another Pledge move used by the ally. (Water Pledge)
00679: # If the move is a combo, power is doubled and causes either a swamp on the
00680: # opposing side or a rainbow on the user's side.
00681: #===============================================================================
00682: class Battle::Move::WaterPledge < Battle::Move::PledgeMove
00683:   def initialize(battle, move)
00684:     super
00685:     # [Function code to combo with, effect, override type, override animation]
00686:     @combos = [["GrassPledge", :Swamp,   :GRASS, :GRASSPLEDGE],
00687:                ["FirePledge",  :Rainbow, nil,    nil]]
00688:   end
00689: end
00690: 
00691: #===============================================================================
00692: # Uses the last move that was used. (Copycat)
00693: #===============================================================================
00694: class Battle::Move::UseLastMoveUsed < Battle::Move
00695:   attr_reader :moveBlacklist
00696: 
00697:   def callsAnotherMove?; return true; end
