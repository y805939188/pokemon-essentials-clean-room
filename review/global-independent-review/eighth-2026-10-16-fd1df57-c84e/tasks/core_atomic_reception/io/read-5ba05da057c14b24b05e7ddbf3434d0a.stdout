00408:       d = b ^ c
00409:       @super_shiny = (d == 0)
00410:     end
00411:     return @super_shiny
00412:   end
00413: 
00414:   # @param value [Boolean] whether this Pokémon is super shiny
00415:   def super_shiny=(value)
00416:     @super_shiny = value
00417:     @shiny = true if @super_shiny
00418:   end
00419: 
00420:   #=============================================================================
00421:   # Ability
00422:   #=============================================================================
00423: 
00424:   # The index of this Pokémon's ability (0, 1 are natural abilities, 2+ are
00425:   # hidden abilities) as defined for its species/form. An ability may not be
00426:   # defined at this index. Is recalculated (as 0 or 1) if made nil.
00427:   # @return [Integer] the index of this Pokémon's ability
00428:   def ability_index
00429:     @ability_index = (@personalID & 1) if !@ability_index
00430:     return @ability_index
00431:   end
00432: 
00433:   # @param value [Integer, nil] forced ability index (nil if none is set)
00434:   def ability_index=(value)
00435:     @ability_index = value
00436:     @ability = nil
00437:   end
00438: 
00439:   # @return [GameData::Ability, nil] an Ability object corresponding to this Pokémon's ability
00440:   def ability
00441:     return GameData::Ability.try_get(ability_id)
00442:   end
00443: 
00444:   # @return [Symbol, nil] the ability symbol of this Pokémon's ability
00445:   def ability_id
00446:     if !@ability
00447:       sp_data = species_data
00448:       abil_index = ability_index
00449:       if abil_index >= 2   # Hidden ability
00450:         @ability = sp_data.hidden_abilities[abil_index - 2]
00451:         abil_index = (@personalID & 1) if !@ability
00452:       end
00453:       if !@ability   # Natural ability or no hidden ability defined
00454:         @ability = sp_data.abilities[abil_index] || sp_data.abilities[0]
00455:       end
00456:     end
00457:     return @ability
00458:   end
00459: 
00460:   # @param value [Symbol, String, GameData::Ability, nil] ability to set
00461:   def ability=(value)
00462:     return if value && !GameData::Ability.exists?(value)
00463:     @ability = (value) ? GameData::Ability.get(value).id : value
00464:   end
00465: 
