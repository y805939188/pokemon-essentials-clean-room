00004: module Settings
00005:   #-----------------------------------------------------------------------------
00006:   # Turn order and disobedience
00007:   #-----------------------------------------------------------------------------
00008: 
00009:   # Whether turn order is recalculated after a Pokémon Mega Evolves.
00010:   RECALCULATE_TURN_ORDER_AFTER_MEGA_EVOLUTION = (MECHANICS_GENERATION >= 7)
00011:   # Whether turn order is recalculated after a Pokémon's Speed stat changes.
00012:   RECALCULATE_TURN_ORDER_AFTER_SPEED_CHANGES  = (MECHANICS_GENERATION >= 8)
00013:   # Whether any Pokémon (originally owned by the player or foreign) can disobey
00014:   # the player's commands if the Pokémon is too high a level compared to the
00015:   # number of Gym Badges the player has.
00016:   ANY_HIGH_LEVEL_POKEMON_CAN_DISOBEY          = false
00017:   # Whether foreign Pokémon can disobey the player's commands if the Pokémon is
00018:   # too high a level compared to the number of Gym Badges the player has.
00019:   FOREIGN_HIGH_LEVEL_POKEMON_CAN_DISOBEY      = true
