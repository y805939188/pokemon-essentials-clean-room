00135:   def pbEORSeaOfFireDamage(priority)
00136:     2.times do |side|
00137:       next if sides[side].effects[PBEffects::SeaOfFire] == 0
00138:       sides[side].effects[PBEffects::SeaOfFire] -= 1
00139:       next if sides[side].effects[PBEffects::SeaOfFire] == 0
00140:       pbCommonAnimation("SeaOfFire") if side == 0
00141:       pbCommonAnimation("SeaOfFireOpp") if side == 1
00142:       priority.each do |battler|
00143:         next if battler.opposes?(side)
00144:         next if !battler.takesIndirectDamage? || battler.pbHasType?(:FIRE)
00145:         @scene.pbDamageAnimation(battler)
00146:         battler.pbTakeEffectDamage(battler.totalhp / 8, false) do |hp_lost|
00147:           pbDisplay(_INTL("{1} is hurt by the sea of fire!", battler.pbThis))
00148:         end
00149:       end
00150:     end
00151:   end
00152: 
00153:   #=============================================================================
00154:   # End Of Round healing from Grassy Terrain
00155:   #=============================================================================
00156:   def pbEORTerrainHealing(battler)
00157:     return if battler.fainted?
00158:     # Grassy Terrain (healing)
00159:     if @field.terrain == :Grassy && battler.affectedByTerrain? && battler.canHeal?
00160:       PBDebug.log("[Lingering effect] Grassy Terrain heals #{battler.pbThis(true)}")
00161:       battler.pbRecoverHP(battler.totalhp / 16)
00162:       pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
00163:     end
00164:   end
00165: 
00166:   #=============================================================================
00167:   # End Of Round various healing effects
