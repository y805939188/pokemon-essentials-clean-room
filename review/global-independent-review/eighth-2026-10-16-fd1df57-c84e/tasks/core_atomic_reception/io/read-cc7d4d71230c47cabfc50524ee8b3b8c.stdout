01657: #===============================================================================
01658: # OnBeingHit handlers
01659: #===============================================================================
01660: 
01661: Battle::AbilityEffects::OnBeingHit.add(:AFTERMATH,
01662:   proc { |ability, user, target, move, battle|
01663:     next if !target.fainted?
01664:     next if !move.pbContactMove?(user)
01665:     battle.pbShowAbilitySplash(target)
01666:     if !battle.moldBreaker
01667:       dampBattler = battle.pbCheckGlobalAbility(:DAMP)
01668:       if dampBattler
01669:         battle.pbShowAbilitySplash(dampBattler)
01670:         if Battle::Scene::USE_ABILITY_SPLASH
01671:           battle.pbDisplay(_INTL("{1} cannot use {2}!", target.pbThis, target.abilityName))
01672:         else
01673:           battle.pbDisplay(_INTL("{1} cannot use {2} because of {3}'s {4}!",
01674:              target.pbThis, target.abilityName, dampBattler.pbThis(true), dampBattler.abilityName))
01675:         end
01676:         battle.pbHideAbilitySplash(dampBattler)
01677:         battle.pbHideAbilitySplash(target)
01678:         next
01679:       end
01680:     end
01681:     if user.takesIndirectDamage?(Battle::Scene::USE_ABILITY_SPLASH) &&
01682:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01683:       battle.scene.pbDamageAnimation(user)
01684:       user.pbReduceHP(user.totalhp / 4, false)
01685:       battle.pbDisplay(_INTL("{1} was caught in the aftermath!", user.pbThis))
01686:     end
01687:     battle.pbHideAbilitySplash(target)
01688:   }
01689: )
01690: 
01691: Battle::AbilityEffects::OnBeingHit.add(:ANGERPOINT,
01692:   proc { |ability, user, target, move, battle|
01693:     next if !target.damageState.critical
01694:     next if !target.pbCanRaiseStatStage?(:ATTACK, target)
01695:     battle.pbShowAbilitySplash(target)
01696:     target.stages[:ATTACK] = Battle::Battler::STAT_STAGE_MAXIMUM
01697:     target.statsRaisedThisRound = true
01698:     battle.pbCommonAnimation("StatUp", target)
01699:     if Battle::Scene::USE_ABILITY_SPLASH
01700:       battle.pbDisplay(_INTL("{1} maxed its {2}!", target.pbThis, GameData::Stat.get(:ATTACK).name))
01701:     else
01702:       battle.pbDisplay(_INTL("{1}'s {2} maxed its {3}!",
01703:          target.pbThis, target.abilityName, GameData::Stat.get(:ATTACK).name))
01704:     end
01705:     battle.pbHideAbilitySplash(target)
01706:   }
01707: )
01708: 
01709: Battle::AbilityEffects::OnBeingHit.add(:COTTONDOWN,
01710:   proc { |ability, user, target, move, battle|
01711:     next if battle.allBattlers.none? { |b| b.index != target.index && b.pbCanLowerStatStage?(:SPEED, target) }
01712:     battle.pbShowAbilitySplash(target)
01713:     battle.allBattlers.each do |b|
01714:       b.pbLowerStatStageByAbility(:SPEED, 1, target, false) if b.index != target.index
01715:     end
01716:     battle.pbHideAbilitySplash(target)
01717:   }
01718: )
01719: 
01720: Battle::AbilityEffects::OnBeingHit.add(:CURSEDBODY,
01721:   proc { |ability, user, target, move, battle|
01722:     next if user.fainted?
01723:     next if user.effects[PBEffects::Disable] > 0
01724:     regularMove = nil
01725:     user.eachMove do |m|
01726:       next if m.id != user.lastRegularMoveUsed
01727:       regularMove = m
01728:       break
01729:     end
01730:     next if !regularMove || (regularMove.pp == 0 && regularMove.total_pp > 0)
01731:     next if battle.pbRandom(100) >= 30
01732:     battle.pbShowAbilitySplash(target)
01733:     if !move.pbMoveFailedAromaVeil?(target, user, Battle::Scene::USE_ABILITY_SPLASH)
01734:       user.effects[PBEffects::Disable]     = 3
01735:       user.effects[PBEffects::DisableMove] = regularMove.id
01736:       if Battle::Scene::USE_ABILITY_SPLASH
01737:         battle.pbDisplay(_INTL("{1}'s {2} was disabled!", user.pbThis, regularMove.name))
01738:       else
01739:         battle.pbDisplay(_INTL("{1}'s {2} was disabled by {3}'s {4}!",
01740:            user.pbThis, regularMove.name, target.pbThis(true), target.abilityName))
01741:       end
01742:       battle.pbHideAbilitySplash(target)
01743:       user.pbItemStatusCureCheck
01744:     end
01745:     battle.pbHideAbilitySplash(target)
01746:   }
01747: )
01748: 
01749: Battle::AbilityEffects::OnBeingHit.add(:CUTECHARM,
01750:   proc { |ability, user, target, move, battle|
01751:     next if target.fainted?
01752:     next if !move.pbContactMove?(user)
01753:     next if battle.pbRandom(100) >= 30
01754:     battle.pbShowAbilitySplash(target)
01755:     if user.pbCanAttract?(target, Battle::Scene::USE_ABILITY_SPLASH) &&
01756:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01757:       msg = nil
01758:       if !Battle::Scene::USE_ABILITY_SPLASH
01759:         msg = _INTL("{1}'s {2} made {3} fall in love!", target.pbThis,
01760:            target.abilityName, user.pbThis(true))
01761:       end
01762:       user.pbAttract(target, msg)
01763:     end
01764:     battle.pbHideAbilitySplash(target)
01765:   }
01766: )
01767: 
01768: Battle::AbilityEffects::OnBeingHit.add(:EFFECTSPORE,
01769:   proc { |ability, user, target, move, battle|
01770:     # NOTE: This ability has a 30% chance of triggering, not a 30% chance of
01771:     #       inflicting a status condition. It can try (and fail) to inflict a
01772:     #       status condition that the user is immune to.
01773:     next if !move.pbContactMove?(user)
01774:     next if battle.pbRandom(100) >= 30
01775:     r = battle.pbRandom(3)
01776:     next if r == 0 && user.asleep?
01777:     next if r == 1 && user.poisoned?
01778:     next if r == 2 && user.paralyzed?
01779:     battle.pbShowAbilitySplash(target)
01780:     if user.affectedByPowder?(Battle::Scene::USE_ABILITY_SPLASH) &&
01781:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01782:       case r
01783:       when 0
01784:         if user.pbCanSleep?(target, Battle::Scene::USE_ABILITY_SPLASH)
01785:           msg = nil
01786:           if !Battle::Scene::USE_ABILITY_SPLASH
01787:             msg = _INTL("{1}'s {2} made {3} fall asleep!", target.pbThis,
01788:                target.abilityName, user.pbThis(true))
01789:           end
01790:           user.pbSleep(msg)
01791:         end
01792:       when 1
01793:         if user.pbCanPoison?(target, Battle::Scene::USE_ABILITY_SPLASH)
01794:           msg = nil
01795:           if !Battle::Scene::USE_ABILITY_SPLASH
01796:             msg = _INTL("{1}'s {2} poisoned {3}!", target.pbThis,
01797:                target.abilityName, user.pbThis(true))
01798:           end
01799:           user.pbPoison(target, msg)
01800:         end
01801:       when 2
01802:         if user.pbCanParalyze?(target, Battle::Scene::USE_ABILITY_SPLASH)
01803:           msg = nil
01804:           if !Battle::Scene::USE_ABILITY_SPLASH
01805:             msg = _INTL("{1}'s {2} paralyzed {3}! It may be unable to move!",
01806:                target.pbThis, target.abilityName, user.pbThis(true))
01807:           end
01808:           user.pbParalyze(target, msg)
01809:         end
01810:       end
01811:     end
01812:     battle.pbHideAbilitySplash(target)
01813:   }
01814: )
01815: 
01816: Battle::AbilityEffects::OnBeingHit.add(:FLAMEBODY,
01817:   proc { |ability, user, target, move, battle|
01818:     next if !move.pbContactMove?(user)
01819:     next if user.burned? || battle.pbRandom(100) >= 30
01820:     battle.pbShowAbilitySplash(target)
01821:     if user.pbCanBurn?(target, Battle::Scene::USE_ABILITY_SPLASH) &&
01822:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01823:       msg = nil
01824:       if !Battle::Scene::USE_ABILITY_SPLASH
01825:         msg = _INTL("{1}'s {2} burned {3}!", target.pbThis, target.abilityName, user.pbThis(true))
01826:       end
01827:       user.pbBurn(target, msg)
01828:     end
01829:     battle.pbHideAbilitySplash(target)
01830:   }
01831: )
01832: 
01833: Battle::AbilityEffects::OnBeingHit.add(:GOOEY,
01834:   proc { |ability, user, target, move, battle|
01835:     next if !move.pbContactMove?(user)
01836:     user.pbLowerStatStageByAbility(:SPEED, 1, target, true, true)
01837:   }
01838: )
01839: 
