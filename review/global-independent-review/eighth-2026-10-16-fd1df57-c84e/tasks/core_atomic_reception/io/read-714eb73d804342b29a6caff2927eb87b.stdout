00457: #===============================================================================
00458: # All effects that apply to one side of the field are swapped to the opposite
00459: # side. (Court Change)
00460: #===============================================================================
00461: class Battle::Move::SwapSideEffects < Battle::Move
00462:   attr_reader :number_effects, :boolean_effects
00463: 
00464:   def initialize(battle, move)
00465:     super
00466:     @number_effects = [
00467:       PBEffects::AuroraVeil,
00468:       PBEffects::LightScreen,
00469:       PBEffects::Mist,
00470:       PBEffects::Rainbow,
00471:       PBEffects::Reflect,
00472:       PBEffects::Safeguard,
00473:       PBEffects::SeaOfFire,
00474:       PBEffects::Spikes,
00475:       PBEffects::Swamp,
00476:       PBEffects::Tailwind,
00477:       PBEffects::ToxicSpikes
00478:     ]
00479:     @boolean_effects = [
00480:       PBEffects::StealthRock,
00481:       PBEffects::StickyWeb
00482:     ]
00483:   end
00484: 
00485:   def pbMoveFailed?(user, targets)
00486:     has_effect = false
00487:     2.times do |side|
00488:       effects = @battle.sides[side].effects
00489:       @number_effects.each do |e|
00490:         next if effects[e] == 0
00491:         has_effect = true
00492:         break
00493:       end
00494:       break if has_effect
00495:       @boolean_effects.each do |e|
00496:         next if !effects[e]
00497:         has_effect = true
00498:         break
00499:       end
00500:       break if has_effect
00501:     end
00502:     if !has_effect
00503:       @battle.pbDisplay(_INTL("But it failed!"))
00504:       return true
00505:     end
00506:     return false
00507:   end
00508: 
00509:   def pbEffectGeneral(user)
00510:     side0 = @battle.sides[0]
00511:     side1 = @battle.sides[1]
00512:     @number_effects.each do |e|
00513:       side0.effects[e], side1.effects[e] = side1.effects[e], side0.effects[e]
00514:     end
00515:     @boolean_effects.each do |e|
00516:       side0.effects[e], side1.effects[e] = side1.effects[e], side0.effects[e]
00517:     end
00518:     @battle.pbDisplay(_INTL("{1} swapped the battle effects affecting each side of the field!", user.pbThis))
00519:   end
00520: end
