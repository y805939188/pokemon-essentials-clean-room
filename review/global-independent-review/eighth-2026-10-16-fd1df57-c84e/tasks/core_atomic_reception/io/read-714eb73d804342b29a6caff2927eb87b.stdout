00375: class Battle::Move::AddSpikesToFoeSide < Battle::Move
00376:   def canMagicCoat?; return true; end
00377: 
00378:   def pbMoveFailed?(user, targets)
00379:     if user.pbOpposingSide.effects[PBEffects::Spikes] >= 3
00380:       @battle.pbDisplay(_INTL("But it failed!"))
00381:       return true
00382:     end
00383:     return false
00384:   end
00385: 
00386:   def pbEffectGeneral(user)
00387:     user.pbOpposingSide.effects[PBEffects::Spikes] += 1
00388:     @battle.pbDisplay(_INTL("Spikes were scattered all around {1}'s feet!",
00389:                             user.pbOpposingTeam(true)))
00390:   end
00391: end
00392: 
