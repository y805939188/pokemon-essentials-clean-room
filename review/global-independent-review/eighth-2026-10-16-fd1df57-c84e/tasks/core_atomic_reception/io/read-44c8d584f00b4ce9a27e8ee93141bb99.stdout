00440:     )
00441:   }
00442: )
00443: 
00444: #===============================================================================
00445: # OnStatLoss handlers
00446: #===============================================================================
00447: Battle::ItemEffects::OnStatLoss.add(:EJECTPACK,
00448:   proc { |item, battler, move_user, battle|
00449:     next false if battler.effects[PBEffects::SkyDrop] >= 0 ||
00450:                   battler.inTwoTurnAttack?("TwoTurnAttackInvulnerableInSkyTargetCannotAct")   # Sky Drop
00451:     next false if battle.pbAllFainted?(battler.idxOpposingSide)
00452:     next false if battler.wild?   # Wild Pokémon can't eject
00453:     next false if !battle.pbCanSwitchOut?(battler.index)   # Battler can't switch out
00454:     next false if !battle.pbCanChooseNonActive?(battler.index)   # No Pokémon can switch in
00455:     battle.pbCommonAnimation("UseItem", battler)
00456:     battle.pbDisplay(_INTL("{1} is switched out by the {2}!", battler.pbThis, battler.itemName))
00457:     battler.pbConsumeItem(true, false)
00458:     if battle.endOfRound   # Just switch out
00459:       battle.scene.pbRecall(battler.index) if !battler.fainted?
00460:       battler.pbAbilitiesOnSwitchOut   # Inc. primordial weather check
00461:       next true
00462:     end
00463:     newPkmn = battle.pbGetReplacementPokemonIndex(battler.index)   # Owner chooses
00464:     next false if newPkmn < 0   # Shouldn't ever do this
00465:     battle.pbRecallAndReplace(battler.index, newPkmn)
00466:     battle.pbClearChoice(battler.index)   # Replacement Pokémon does nothing this round
00467:     battle.moldBreaker = false if move_user && battler.index == move_user.index
00468:     battle.pbOnBattlerEnteringBattle(battler.index)
00469:     next true
00470:   }
00471: )
00472: 
00473: #===============================================================================
00474: # StatusCure handlers
00475: #===============================================================================
00476: 
00477: Battle::ItemEffects::StatusCure.add(:ASPEARBERRY,
00478:   proc { |item, battler, battle, forced|
00479:     next false if !forced && !battler.canConsumeBerry?
00480:     next false if battler.status != :FROZEN
00481:     itemName = GameData::Item.get(item).name
00482:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00483:     battle.pbCommonAnimation("EatBerry", battler) if !forced
