00575: def pbUpdateVehicle
00576:   if $PokemonGlobal&.diving
00577:     $game_player.set_movement_type(:diving_stopped)
00578:   elsif $PokemonGlobal&.surfing
00579:     $game_player.set_movement_type(:surfing_stopped)
00580:   elsif $PokemonGlobal&.bicycle
00581:     $game_player.set_movement_type(:cycling_stopped)
00582:   else
00583:     $game_player.set_movement_type(:walking_stopped)
00584:   end
00585: end
00586: 
00587: def pbCancelVehicles(destination = nil, cancel_swimming = true)
00588:   $PokemonGlobal.surfing = false if cancel_swimming
00589:   $PokemonGlobal.diving  = false if cancel_swimming
00590:   $PokemonGlobal.bicycle = false if !destination || !pbCanUseBike?(destination)
00591:   pbUpdateVehicle
00592: end
