00315:         interp.update
00316:         pbUpdateSceneMap
00317:         break if !interp.running?
00318:       end
00319:     end
00320:   end
00321: 
00322:   # Sets another event's self switch (eg. pbSetSelfSwitch(20, "A", true) ).
00323:   def pbSetSelfSwitch(eventid, switch_name, value, mapid = -1)
00324:     mapid = @map_id if mapid < 0
00325:     old_value = $game_self_switches[[mapid, eventid, switch_name]]
00326:     $game_self_switches[[mapid, eventid, switch_name]] = value
00327:     if value != old_value && $map_factory.hasMap?(mapid)
00328:       $map_factory.getMap(mapid, false).need_refresh = true
00329:     end
00330:   end
00331: 
00332:   def tsOff?(c)
00333:     return get_self.tsOff?(c)
00334:   end
00335:   alias isTempSwitchOff? tsOff?
00336: 
00337:   def tsOn?(c)
00338:     return get_self.tsOn?(c)
