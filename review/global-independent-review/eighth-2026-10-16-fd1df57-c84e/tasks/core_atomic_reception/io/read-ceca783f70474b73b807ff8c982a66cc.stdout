00128:         next false
00129:       end
00130:       next false if !pkmn
00131:       next false if !ItemHandlers.triggerCanUseInBattle(item, pkmn, battler, idxMove,
00132:                                                         firstAction, self, itemScene)
00133:       next false if !pbRegisterItem(idxBattler, item, idxPkmn, idxMove)
00134:       ret = true
00135:       next true
00136:     end
00137:     return ret
00138:   end
00139: 
00140:   def pbPartyMenu(idxBattler)
00141:     ret = -1
00142:     if @debug
00143:       ret = @battleAI.pbDefaultChooseNewEnemy(idxBattler)
00144:     else
00145:       ret = pbPartyScreen(idxBattler, false, true, true)
00146:     end
00147:     return ret >= 0
00148:   end
00149: 
00150:   def pbRunMenu(idxBattler)
00151:     # Regardless of succeeding or failing to run, stop choosing actions
00152:     return pbRun(idxBattler) != 0
00153:   end
00154: 
00155:   def pbCallMenu(idxBattler)
00156:     return pbRegisterCall(idxBattler)
00157:   end
00158: 
00159:   def pbDebugMenu
00160:     pbBattleDebug(self)
00161:     @scene.pbRefreshEverything
00162:     allBattlers.each { |b| b.pbCheckFormOnWeatherChange }
00163:     pbEndPrimordialWeather
00164:     allBattlers.each { |b| b.pbAbilityOnTerrainChange }
00165:     allBattlers.each do |b|
00166:       b.pbCheckFormOnMovesetChange
00167:       b.pbCheckFormOnStatusChange
00168:     end
00169:   end
00170: 
00171:   #=============================================================================
00172:   # Command phase
00173:   #=============================================================================
00174:   def pbCommandPhase
00175:     @command_phase = true
00176:     @scene.pbBeginCommandPhase
00177:     # Reset choices if commands can be shown
00178:     @battlers.each_with_index do |b, i|
00179:       next if !b
00180:       pbClearChoice(i) if pbCanShowCommands?(i)
00181:     end
