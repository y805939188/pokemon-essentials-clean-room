00438:     return ret
00439:   end
00440: 
00441:   #=============================================================================
00442:   # Opens a Pokémon's summary screen to try to learn a new move
00443:   #=============================================================================
00444:   # Called whenever a Pokémon should forget a move. It should return -1 if the
00445:   # selection is canceled, or 0 to 3 to indicate the move to forget. It should
00446:   # not allow HM moves to be forgotten.
00447:   def pbForgetMove(pkmn, moveToLearn)
00448:     ret = -1
00449:     pbFadeOutIn do
00450:       scene = PokemonSummary_Scene.new
00451:       screen = PokemonSummaryScreen.new(scene)
00452:       ret = screen.pbStartForgetScreen([pkmn], 0, moveToLearn)
00453:     end
00454:     return ret
00455:   end
00456: 
00457:   #=============================================================================
00458:   # Opens the nicknaming screen for a newly caught Pokémon
00459:   #=============================================================================
00460:   def pbNameEntry(helpText, pkmn)
00461:     return pbEnterPokemonName(helpText, 0, Pokemon::MAX_NAME_SIZE, "", pkmn)
00462:   end
