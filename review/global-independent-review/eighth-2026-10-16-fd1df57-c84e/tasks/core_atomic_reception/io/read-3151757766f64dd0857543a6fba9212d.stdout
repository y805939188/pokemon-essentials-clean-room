00188:   def purifiable?
00189:     return false if !shadowPokemon? || self.heart_gauge > 0
00190:     return false if isSpecies?(:LUGIA)
00191:     return true
00192:   end
00193: 
00194:   def check_ready_to_purify
00195:     return if !shadowPokemon?
00196:     update_shadow_moves
00197:     pbMessage(_INTL("{1} can now be purified!", self.name)) if self.heart_gauge == 0
00198:   end
00199: 
00200:   def add_evs(added_evs)
00201:     total = 0
00202:     @ev.each_value { |e| total += e }
00203:     GameData::Stat.each_main do |s|
00204:       addition = added_evs[s.id].clamp(0, Pokemon::EV_STAT_LIMIT - @ev[s.id])
00205:       addition = addition.clamp(0, Pokemon::EV_LIMIT - total)
