00001: #===============================================================================
00002: # Pokémon class.
00003: #===============================================================================
00004: class Pokemon
00005:   attr_accessor :shadow
00006:   attr_writer   :heart_gauge
00007:   attr_writer   :hyper_mode
00008:   attr_accessor :saved_exp
00009:   attr_accessor :saved_ev
00010:   attr_accessor :shadow_moves
00011:   attr_accessor :heart_gauge_step_counter
00012: 
00013:   alias __shadow_expeq exp= unless method_defined?(:__shadow_expeq)
00014:   def exp=(value)
00015:     if shadowPokemon?
00016:       @saved_exp += value - @exp
00017:     else
00018:       __shadow_expeq(value)
00019:     end
00020:   end
00021: 
00022:   alias __shadow_hpeq hp= unless method_defined?(:__shadow_hpeq)
00023:   def hp=(value)
00024:     __shadow_hpeq(value)
00025:     @hyper_mode = false if @hp <= 0
00026:   end
00027: 
00028:   def heart_gauge
00029:     return @heart_gauge || 0
00030:   end
00031: 
00032:   def shadow_data
00033:     return GameData::ShadowPokemon.get_species_form(@species, form_simple)
00034:   end
00035: 
00036:   def max_gauge_size
00037:     data = shadow_data
00038:     return (data) ? data.gauge_size : GameData::ShadowPokemon::HEART_GAUGE_SIZE
00039:   end
00040: 
00041:   def adjustHeart(value)
00042:     return if !shadowPokemon?
00043:     @heart_gauge = (self.heart_gauge + value).clamp(0, max_gauge_size)
00044:   end
00045: 
00046:   def change_heart_gauge(method, multiplier = 1)
00047:     return if !shadowPokemon?
00048:     heart_amounts = {
00049:       # [sending into battle, call to, walking 256 steps, using scent]
00050:       :HARDY   => [110, 300, 100,  90],
00051:       :LONELY  => [ 70, 330, 100, 130],
00052:       :BRAVE   => [130, 270,  90,  80],
00053:       :ADAMANT => [110, 270, 110,  80],
00054:       :NAUGHTY => [120, 270, 110,  70],
00055:       :BOLD    => [110, 270,  90, 100],
00056:       :DOCILE  => [100, 360,  80, 120],
00057:       :RELAXED => [ 90, 270, 110, 100],
00058:       :IMPISH  => [120, 300, 100,  80],
00059:       :LAX     => [100, 270,  90, 110],
00060:       :TIMID   => [ 70, 330, 110, 120],
00061:       :HASTY   => [130, 300,  70, 100],
00062:       :SERIOUS => [100, 330, 110,  90],
00063:       :JOLLY   => [120, 300,  90,  90],
00064:       :NAIVE   => [100, 300, 120,  80],
00065:       :MODEST  => [ 70, 300, 120, 110],
00066:       :MILD    => [ 80, 270, 100, 120],
00067:       :QUIET   => [100, 300, 100, 100],
00068:       :BASHFUL => [ 80, 300,  90, 130],
00069:       :RASH    => [ 90, 300,  90, 120],
00070:       :CALM    => [ 80, 300, 110, 110],
00071:       :GENTLE  => [ 70, 300, 130, 100],
00072:       :SASSY   => [130, 240, 100,  70],
00073:       :CAREFUL => [ 90, 300, 100, 110],
00074:       :QUIRKY  => [130, 270,  80,  90]
00075:     }
00076:     amt = 100
00077:     case method
00078:     when "battle"
00079:       amt = (heart_amounts[@nature]) ? heart_amounts[@nature][0] : 100
00080:     when "call"
00081:       amt = (heart_amounts[@nature]) ? heart_amounts[@nature][1] : 300
00082:     when "walking"
00083:       amt = (heart_amounts[@nature]) ? heart_amounts[@nature][2] : 100
00084:     when "scent"
00085:       amt = (heart_amounts[@nature]) ? heart_amounts[@nature][3] : 100
00086:       amt *= multiplier
00087:     else
00088:       raise _INTL("Unknown heart gauge-changing method: {1}", method.to_s)
00089:     end
00090:     adjustHeart(-amt)
00091:   end
00092: 
00093:   def heartStage
00094:     return 0 if !shadowPokemon?
00095:     max_size = max_gauge_size
00096:     stage_size = max_size / 5.0
00097:     return ([self.heart_gauge, max_size].min / stage_size).ceil
00098:   end
00099: 
00100:   def shadowPokemon?
00101:     return @shadow && @heart_gauge && @heart_gauge >= 0
00102:   end
00103: 
00104:   def hyper_mode
00105:     return (self.heart_gauge == 0 || @hp == 0) ? false : @hyper_mode
00106:   end
00107: 
00108:   alias __shadow__changeHappiness changeHappiness unless method_defined?(:__shadow__changeHappiness)
00109:   def changeHappiness(method)
00110:     return if shadowPokemon? && heartStage >= 4
00111:     __shadow__changeHappiness(method)
00112:   end
00113: 
00114:   def makeShadow
00115:     @shadow       = true
