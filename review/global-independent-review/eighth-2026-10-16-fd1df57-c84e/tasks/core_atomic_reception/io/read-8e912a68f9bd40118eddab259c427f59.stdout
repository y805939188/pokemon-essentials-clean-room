00011: {"id":"UI67-U011","name":"数据框绘制/HP/EXP动画","sources":[{"repo":"/workspace/pokemon-essentials","commit":"8c5911e4a4b07b07e832e4bb0d5d8859e88b4a9b","tree":"7589c800b61ba13a13040ed0d686979b80a84fd0","path":"Data/Scripts/011_Battle/004_Scene/006_Battle_Scene_Objects.rb","mode":"100644","bytes":21656,"sha256":"70d34ae0195fa92fcb1a57d957044f280b8187764669d88b008f6af77a7bc917","blob":"907a796dfa02bd29da8e7772f3120399b33a048a","reader":"/root/ui_full","status":"FULL_READ","ranges":[[1,698]],"whole_file_read":true,"lines":698,"semantic_selector":"PokemonDataBox全部"}],"facts":[{"id":"UI67-F011-01","assertion":"构造初show_hp_numbersfalse/show_exp_barfalse。"},{"id":"UI67-F011-02","assertion":"单打玩家侧设两者true。"},{"id":"UI67-F011-03","assertion":"单打对方不设true。"},{"id":"UI67-F011-04","assertion":"多人侧用thin背景。"},{"id":"UI67-F011-05","assertion":"重新initializeDataBoxGraphic没有先归false，不能推运行时改尺寸自动关原true。"},{"id":"UI67-F011-06","assertion":"背景按玩家/对方/人数分位置。"},{"id":"UI67-F011-07","assertion":"HP/EXP/numbers为独立sprites。"},{"id":"UI67-F011-08","assertion":"visible时EXP另受show_exp_bar。"},{"id":"UI67-F011-09","assertion":"hp动画期间读anim_current否则领域hp。"},{"id":"UI67-F011-10","assertion":"exp动画期间用anim_current/range，range0返0。"},{"id":"UI67-F011-11","assertion":"否则读pokemon.exp_fraction。"},{"id":"UI67-F011-12","assertion":"HPold==new不启动。"},{"id":"UI67-F011-13","assertion":"HP变化固定目标1秒。"},{"id":"UI67-F011-14","assertion":"EXPold==new/range0/不show不启动。"},{"id":"UI67-F011-15","assertion":"EXPduration比例abs(delta)/range*1.75。"},{"id":"UI67-F011-16","assertion":"EXPgainSE在启动时。"},{"id":"UI67-F011-17","assertion":"数字按11格含/字。"},{"id":"UI67-F011-18","assertion":"长名宽>116向左偏移。"},{"id":"UI67-F011-19","assertion":"性别只0/1。"},{"id":"UI67-F011-20","assertion":"badpoison用Status.count−1图标。"},{"id":"UI67-F011-21","assertion":"mega图优先primal。"},{"id":"UI67-F011-22","assertion":"primal只Groudon/Kyogre具名。"},{"id":"UI67-F011-23","assertion":"owned仅对方已owned。"},{"id":"UI67-F011-24","assertion":"refresh无pokemon清后返回。"},{"id":"UI67-F011-25","assertion":"HP数字仅show门。"},{"id":"UI67-F011-26","assertion":"HP条比例素材宽*hp/totalhp。"},{"id":"UI67-F011-27","assertion":"正HP不足1先1再偶数round。"},{"id":"UI67-F011-28","assertion":"HP<=half黄。"},{"id":"UI67-F011-29","assertion":"HP<=quarter红。"},{"id":"UI67-F011-30","assertion":"EXP比例×素材宽偶数round。"},{"id":"UI67-F011-31","assertion":"HPlerp到end后清anim状态。"},{"id":"UI67-F011-32","assertion":"EXP满range后先0.2秒flash。"},{"id":"UI67-F011-33","assertion":"flashduration需frame_rate换帧数的请求。"},{"id":"UI67-F011-34","assertion":"满时stopSE/playexpfull/各spriteflash。"},{"id":"UI67-F011-35","assertion":"flash结束再清anim状态。"},{"id":"UI67-F011-36","assertion":"非满到end stopSE再清。"},{"id":"UI67-F011-37","assertion":"数据框选中1/2以0.6秒四相上下2。"},{"id":"UI67-F011-38","assertion":"update先super→HP→EXP→positions→childsprites。"}],"reader":"/root/ui_full","premise":"固定B8/R合法普通战斗对象与默认配置，无插件并发；源请求不证明媒体/宿主，后段失败保留前缀且无通用ensure。","disposition":"OWN_FULL_DEPENDENCY_READ; domain callers/receivers separately received","execution":"NOT_EXECUTED"}
