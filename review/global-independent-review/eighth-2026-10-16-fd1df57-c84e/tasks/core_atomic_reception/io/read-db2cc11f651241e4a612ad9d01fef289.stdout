01134: Battle::ItemEffects::DamageCalcFromTarget.add(:EVIOLITE,
01135:   proc { |item, user, target, move, mults, power, type|
01136:     # NOTE: Eviolite cares about whether the Pokémon itself can evolve, which
01137:     #       means it also cares about the Pokémon's form. Some forms cannot
01138:     #       evolve even if the species generally can, and such forms are not
01139:     #       affected by Eviolite.
01140:     if target.pokemon.species_data.get_evolutions(true).length > 0
01141:       mults[:defense_multiplier] *= 1.5
01142:     end
01143:   }
01144: )
01145: 
01146: Battle::ItemEffects::DamageCalcFromTarget.add(:HABANBERRY,
