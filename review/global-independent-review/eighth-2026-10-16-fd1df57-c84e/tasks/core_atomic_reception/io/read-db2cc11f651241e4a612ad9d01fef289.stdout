01024: Battle::ItemEffects::DamageCalcFromUser.add(:SOULDEW,
01025:   proc { |item, user, target, move, mults, power, type|
01026:     next if !user.isSpecies?(:LATIAS) && !user.isSpecies?(:LATIOS)
01027:     if Settings::SOUL_DEW_POWERS_UP_TYPES
01028:       mults[:final_damage_multiplier] *= 1.2 if [:DRAGON, :PSYCHIC].include?(type)
01029:     elsif move.specialMove? && !user.battle.rules["souldewclause"]
01030:       mults[:attack_multiplier] *= 1.5
01031:     end
01032:   }
01033: )
