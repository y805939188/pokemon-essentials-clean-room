00175:   end
00176: end
00177: 
00178: #===============================================================================
00179: # Trainer class for NPC trainers
00180: #===============================================================================
00181: class NPCTrainer < Trainer
00182:   attr_accessor :version
00183:   attr_accessor :items
00184:   attr_accessor :lose_text
00185:   attr_accessor :win_text
00186: 
00187:   def initialize(name, trainer_type, version = 0)
00188:     super(name, trainer_type)
00189:     @version   = version
00190:     @items     = []
00191:     @lose_text = nil
00192:     @win_text  = nil
00193:   end
00194: end
