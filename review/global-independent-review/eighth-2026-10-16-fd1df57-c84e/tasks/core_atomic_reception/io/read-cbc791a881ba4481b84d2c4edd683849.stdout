00521: 
00522: #===============================================================================
00523: # User turns 1/4 of max HP into a substitute. (Substitute)
00524: #===============================================================================
00525: class Battle::Move::UserMakeSubstitute < Battle::Move
00526:   def canSnatch?; return true; end
00527: 
00528:   def pbMoveFailed?(user, targets)
00529:     if user.effects[PBEffects::Substitute] > 0
00530:       @battle.pbDisplay(_INTL("{1} already has a substitute!", user.pbThis))
00531:       return true
00532:     end
00533:     @subLife = [user.totalhp / 4, 1].max
00534:     if user.hp <= @subLife
00535:       @battle.pbDisplay(_INTL("But it does not have enough HP left to make a substitute!"))
00536:       return true
00537:     end
00538:     return false
00539:   end
00540: 
00541:   def pbOnStartUse(user, targets)
00542:     user.pbReduceHP(@subLife, false, false)
00543:     user.pbItemHPHealCheck
00544:   end
00545: 
00546:   def pbEffectGeneral(user)
00547:     user.effects[PBEffects::Trapping]     = 0
00548:     user.effects[PBEffects::TrappingMove] = nil
00549:     user.effects[PBEffects::Substitute]   = @subLife
00550:     @battle.pbDisplay(_INTL("{1} put in a substitute!", user.pbThis))
00551:   end
00552: end
00553: 
00554: #===============================================================================
00555: # Removes trapping moves, entry hazards and Leech Seed on user/user's side.
00556: # Raises user's Speed by 1 stage (Gen 8+). (Rapid Spin)
00557: #===============================================================================
00558: class Battle::Move::RemoveUserBindingAndEntryHazards < Battle::Move::StatUpMove
00559:   def initialize(battle, move)
00560:     super
00561:     @statUp = [:SPEED, 1]
00562:   end
00563: 
00564:   def pbEffectAfterAllHits(user, target)
00565:     return if user.fainted? || target.damageState.unaffected
00566:     if user.effects[PBEffects::Trapping] > 0
00567:       trapMove = GameData::Move.get(user.effects[PBEffects::TrappingMove]).name
00568:       trapUser = @battle.battlers[user.effects[PBEffects::TrappingUser]]
00569:       @battle.pbDisplay(_INTL("{1} got free of {2}'s {3}!", user.pbThis, trapUser.pbThis(true), trapMove))
00570:       user.effects[PBEffects::Trapping]     = 0
00571:       user.effects[PBEffects::TrappingMove] = nil
00572:       user.effects[PBEffects::TrappingUser] = -1
00573:     end
00574:     if user.effects[PBEffects::LeechSeed] >= 0
00575:       user.effects[PBEffects::LeechSeed] = -1
00576:       @battle.pbDisplay(_INTL("{1} shed Leech Seed!", user.pbThis))
00577:     end
00578:     if user.pbOwnSide.effects[PBEffects::StealthRock]
00579:       user.pbOwnSide.effects[PBEffects::StealthRock] = false
00580:       @battle.pbDisplay(_INTL("{1} blew away stealth rocks!", user.pbThis))
00581:     end
00582:     if user.pbOwnSide.effects[PBEffects::Spikes] > 0
00583:       user.pbOwnSide.effects[PBEffects::Spikes] = 0
00584:       @battle.pbDisplay(_INTL("{1} blew away spikes!", user.pbThis))
00585:     end
00586:     if user.pbOwnSide.effects[PBEffects::ToxicSpikes] > 0
00587:       user.pbOwnSide.effects[PBEffects::ToxicSpikes] = 0
00588:       @battle.pbDisplay(_INTL("{1} blew away poison spikes!", user.pbThis))
00589:     end
00590:     if user.pbOwnSide.effects[PBEffects::StickyWeb]
00591:       user.pbOwnSide.effects[PBEffects::StickyWeb] = false
00592:       @battle.pbDisplay(_INTL("{1} blew away sticky webs!", user.pbThis))
00593:     end
00594:   end
00595: 
00596:   def pbAdditionalEffect(user, target)
00597:     super if Settings::MECHANICS_GENERATION >= 8
00598:   end
00599: end
