00601: #===============================================================================
00602: # Attacks 2 rounds in the future. (Doom Desire, Future Sight)
00603: #===============================================================================
00604: class Battle::Move::AttackTwoTurnsLater < Battle::Move
00605:   def targetsPosition?; return true; end
00606: 
00607:   # Stops damage being dealt in the setting-up turn.
00608:   def pbDamagingMove?
00609:     return false if !@battle.futureSight
00610:     return super
00611:   end
00612: 
00613:   def pbAccuracyCheck(user, target)
00614:     return true if !@battle.futureSight
00615:     return super
00616:   end
00617: 
00618:   def pbDisplayUseMessage(user)
00619:     super if !@battle.futureSight
00620:   end
00621: 
00622:   def pbFailsAgainstTarget?(user, target, show_message)
00623:     if !@battle.futureSight &&
00624:        @battle.positions[target.index].effects[PBEffects::FutureSightCounter] > 0
00625:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00626:       return true
00627:     end
00628:     return false
00629:   end
00630: 
00631:   def pbEffectAgainstTarget(user, target)
00632:     return if @battle.futureSight   # Attack is hitting
00633:     effects = @battle.positions[target.index].effects
00634:     effects[PBEffects::FutureSightCounter]        = 3
00635:     effects[PBEffects::FutureSightMove]           = @id
00636:     effects[PBEffects::FutureSightUserIndex]      = user.index
00637:     effects[PBEffects::FutureSightUserPartyIndex] = user.pokemonIndex
00638:     if @id == :DOOMDESIRE
00639:       @battle.pbDisplay(_INTL("{1} chose Doom Desire as its destiny!", user.pbThis))
00640:     else
00641:       @battle.pbDisplay(_INTL("{1} foresaw an attack!", user.pbThis))
00642:     end
00643:   end
00644: 
00645:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00646:     hitNum = 1 if !@battle.futureSight   # Charging anim
00647:     super
00648:   end
00649: end
00650: 
00651: #===============================================================================
00652: # User switches places with its ally. (Ally Switch)
00653: #===============================================================================
00654: class Battle::Move::UserSwapsPositionsWithAlly < Battle::Move
00655:   def pbMoveFailed?(user, targets)
00656:     numTargets = 0
00657:     @idxAlly = -1
00658:     idxUserOwner = @battle.pbGetOwnerIndexFromBattlerIndex(user.index)
00659:     user.allAllies.each do |b|
00660:       next if @battle.pbGetOwnerIndexFromBattlerIndex(b.index) != idxUserOwner
00661:       next if !b.near?(user)
00662:       numTargets += 1
00663:       @idxAlly = b.index
00664:     end
00665:     if numTargets != 1
00666:       @battle.pbDisplay(_INTL("But it failed!"))
00667:       return true
00668:     end
00669:     return false
00670:   end
00671: 
00672:   def pbEffectGeneral(user)
00673:     idxA = user.index
00674:     idxB = @idxAlly
00675:     if @battle.pbSwapBattlers(idxA, idxB)
00676:       @battle.pbDisplay(_INTL("{1} and {2} switched places!",
00677:                               @battle.battlers[idxB].pbThis, @battle.battlers[idxA].pbThis(true)))
00678:       [idxA, idxB].each { |idx| @battle.pbEffectsOnBattlerEnteringPosition(@battle.battlers[idx]) }
00679:     end
00680:   end
00681: end
00682: 
00683: #===============================================================================
00684: # If a Pokémon makes contact with the user before it uses this move, the
00685: # attacker is burned. (Beak Blast)
00686: #===============================================================================
00687: class Battle::Move::BurnAttackerBeforeUserActs < Battle::Move
00688:   def pbDisplayChargeMessage(user)
00689:     user.effects[PBEffects::BeakBlast] = true
00690:     @battle.pbCommonAnimation("BeakBlast", user)
00691:     @battle.pbDisplay(_INTL("{1} started heating up its beak!", user.pbThis))
00692:   end
00693: end
