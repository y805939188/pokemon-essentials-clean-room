00939: class Battle::Move::SetTargetAbilityToSimple < Battle::Move
00940:   def canMagicCoat?; return true; end
00941: 
00942:   def pbMoveFailed?(user, targets)
00943:     if !GameData::Ability.exists?(:SIMPLE)
00944:       @battle.pbDisplay(_INTL("But it failed!"))
00945:       return true
00946:     end
00947:     return false
00948:   end
00949: 
00950:   def pbFailsAgainstTarget?(user, target, show_message)
00951:     if target.unstoppableAbility? || [:TRUANT, :SIMPLE].include?(target.ability_id)
00952:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00953:       return true
00954:     end
00955:     return false
00956:   end
00957: 
00958:   def pbEffectAgainstTarget(user, target)
00959:     @battle.pbShowAbilitySplash(target, true, false)
00960:     oldAbil = target.ability
00961:     target.ability = :SIMPLE
00962:     @battle.pbReplaceAbilitySplash(target)
00963:     @battle.pbDisplay(_INTL("{1} acquired {2}!", target.pbThis, target.abilityName))
00964:     @battle.pbHideAbilitySplash(target)
00965:     target.pbOnLosingAbility(oldAbil)
00966:     target.pbTriggerAbilityOnGainingIt
00967:   end
00968: end
