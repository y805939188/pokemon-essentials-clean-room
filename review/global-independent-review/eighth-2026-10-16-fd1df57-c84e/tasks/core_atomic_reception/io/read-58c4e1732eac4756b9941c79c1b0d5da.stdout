00066: class NamedEvent
00067:   def initialize
00068:     @callbacks = {}
00069:   end
00070: 
00071:   # Adds an event handler procedure from the event.
00072:   def add(key, proc)
00073:     @callbacks[key] = proc
00074:   end
00075: 
00076:   # Removes an event handler procedure from the event.
00077:   def remove(key)
00078:     @callbacks.delete(key)
00079:   end
00080: 
00081:   # Clears the event of event handlers.
00082:   def clear
00083:     @callbacks.clear
00084:   end
00085: 
00086:   # Triggers the event and calls all its event handlers. Normally called only
00087:   # by the code where the event occurred.
00088:   def trigger(*args)
00089:     @callbacks.each_value { |callback| callback.call(*args) }
00090:   end
00091: end
00092: 
00093: #===============================================================================
00094: # A class that stores code that can be triggered. Each piece of code has an
00095: # associated ID, which can be anything that can be used as a key in a hash.
00096: #===============================================================================
