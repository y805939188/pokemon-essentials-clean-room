00646:   def learn_move(move_id)
00647:     move_data = GameData::Move.try_get(move_id)
00648:     return if !move_data
00649:     # Check if self already knows the move; if so, move it to the end of the array
00650:     @moves.each_with_index do |m, i|
00651:       next if m.id != move_data.id
00652:       @moves.push(m)
00653:       @moves.delete_at(i)
00654:       return
00655:     end
00656:     # Move is not already known; learn it
00657:     @moves.push(Pokemon::Move.new(move_data.id))
00658:     # Delete the first known move if self now knows more moves than it should
00659:     @moves.shift if numMoves > MAX_MOVES
00660:   end
00661: 
