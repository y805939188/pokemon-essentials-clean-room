00145:     pbJudge
00146:     return if @decision > 0
00147:     # Check through each fainted battler to see if that spot can be filled.
00148:     switched = []
00149:     loop do
00150:       switched.clear
00151:       @battlers.each do |b|
00152:         next if !b || !b.fainted?
00153:         idxBattler = b.index
00154:         next if !pbCanChooseNonActive?(idxBattler)
00155:         if !pbOwnedByPlayer?(idxBattler)   # Opponent/ally is switching in
00156:           next if b.wild?   # Wild Pokémon can't switch
00157:           idxPartyNew = pbSwitchInBetween(idxBattler)
00158:           opponent = pbGetOwnerFromBattlerIndex(idxBattler)
00159:           # NOTE: The player is only offered the chance to switch their own
00160:           #       Pokémon when an opponent replaces a fainted Pokémon in single
00161:           #       battles. In double battles, etc. there is no such offer.
00162:           if @internalBattle && @switchStyle && trainerBattle? && pbSideSize(0) == 1 &&
00163:              opposes?(idxBattler) && !@battlers[0].fainted? && !switched.include?(0) &&
00164:              pbCanChooseNonActive?(0) && @battlers[0].effects[PBEffects::Outrage] == 0
00165:             idxPartyForName = idxPartyNew
00166:             enemyParty = pbParty(idxBattler)
00167:             if enemyParty[idxPartyNew].ability == :ILLUSION && !pbCheckGlobalAbility(:NEUTRALIZINGGAS)
00168:               new_index = pbLastInTeam(idxBattler)
00169:               idxPartyForName = new_index if new_index >= 0 && new_index != idxPartyNew
00170:             end
00171:             if pbDisplayConfirm(_INTL("{1} is about to send out {2}. Will you switch your Pokémon?",
00172:                                       opponent.full_name, enemyParty[idxPartyForName].name))
00173:               idxPlayerPartyNew = pbSwitchInBetween(0, false, true)
00174:               if idxPlayerPartyNew >= 0
00175:                 pbMessageOnRecall(@battlers[0])
00176:                 pbRecallAndReplace(0, idxPlayerPartyNew)
00177:                 switched.push(0)
00178:               end
00179:             end
00180:           end
00181:           pbRecallAndReplace(idxBattler, idxPartyNew)
00182:           switched.push(idxBattler)
00183:         elsif trainerBattle?   # Player switches in in a trainer battle
00184:           idxPlayerPartyNew = pbGetReplacementPokemonIndex(idxBattler)   # Owner chooses
00185:           pbRecallAndReplace(idxBattler, idxPlayerPartyNew)
00186:           switched.push(idxBattler)
00187:         else   # Player's Pokémon has fainted in a wild battle
00188:           switch = false
00189:           if pbDisplayConfirm(_INTL("Use next Pokémon?"))
00190:             switch = true
00191:           else
00192:             switch = (pbRun(idxBattler, true) <= 0)
00193:           end
00194:           if switch
00195:             idxPlayerPartyNew = pbGetReplacementPokemonIndex(idxBattler)   # Owner chooses
00196:             pbRecallAndReplace(idxBattler, idxPlayerPartyNew)
00197:             switched.push(idxBattler)
00198:           end
00199:         end
00200:       end
00201:       break if switched.length == 0
00202:       pbOnBattlerEnteringBattle(switched)
00203:     end
00204:   end
00205: 
00206:   def pbGetReplacementPokemonIndex(idxBattler, random = false)
00207:     if random
00208:       choices = []   # Find all Pokémon that can switch in
00209:       eachInTeamFromBattlerIndex(idxBattler) do |_pkmn, i|
00210:         choices.push(i) if pbCanSwitchIn?(idxBattler, i)
00211:       end
00212:       return -1 if choices.length == 0
00213:       return choices[pbRandom(choices.length)]
00214:     else
00215:       return pbSwitchInBetween(idxBattler, true)
00216:     end
00217:   end
00218: 
00219:   # Actually performs the recalling and sending out in all situations.
00220:   def pbRecallAndReplace(idxBattler, idxParty, randomReplacement = false, batonPass = false)
00221:     @scene.pbRecall(idxBattler) if !@battlers[idxBattler].fainted?
00222:     @battlers[idxBattler].pbAbilitiesOnSwitchOut   # Inc. primordial weather check
00223:     @scene.pbShowPartyLineup(idxBattler & 1) if pbSideSize(idxBattler) == 1
00224:     pbMessagesOnReplace(idxBattler, idxParty) if !randomReplacement
00225:     pbReplace(idxBattler, idxParty, batonPass)
00226:   end
00227: 
00228:   def pbMessageOnRecall(battler)
00229:     if battler.pbOwnedByPlayer?
00230:       if battler.hp <= battler.totalhp / 4
00231:         pbDisplayBrief(_INTL("Good job, {1}! Come back!", battler.name))
00232:       elsif battler.hp <= battler.totalhp / 2
00233:         pbDisplayBrief(_INTL("OK, {1}! Come back!", battler.name))
00234:       elsif battler.turnCount >= 5
00235:         pbDisplayBrief(_INTL("{1}, that's enough! Come back!", battler.name))
00236:       elsif battler.turnCount >= 2
00237:         pbDisplayBrief(_INTL("{1}, come back!", battler.name))
00238:       else
00239:         pbDisplayBrief(_INTL("{1}, switch out! Come back!", battler.name))
00240:       end
00241:     else
00242:       owner = pbGetOwnerName(battler.index)
00243:       pbDisplayBrief(_INTL("{1} withdrew {2}!", owner, battler.name))
00244:     end
00245:   end
00246: 
00247:   # Only called from def pbRecallAndReplace and Battle Arena's def pbSwitch.
00248:   def pbMessagesOnReplace(idxBattler, idxParty)
00249:     party = pbParty(idxBattler)
00250:     newPkmnName = party[idxParty].name
00251:     if party[idxParty].ability == :ILLUSION && !pbCheckGlobalAbility(:NEUTRALIZINGGAS)
00252:       new_index = pbLastInTeam(idxBattler)
00253:       newPkmnName = party[new_index].name if new_index >= 0 && new_index != idxParty
00254:     end
00255:     if pbOwnedByPlayer?(idxBattler)
00256:       opposing = @battlers[idxBattler].pbDirectOpposing
00257:       if opposing.fainted? || opposing.hp == opposing.totalhp
00258:         pbDisplayBrief(_INTL("You're in charge, {1}!", newPkmnName))
00259:       elsif opposing.hp >= opposing.totalhp / 2
00260:         pbDisplayBrief(_INTL("Go for it, {1}!", newPkmnName))
00261:       elsif opposing.hp >= opposing.totalhp / 4
00262:         pbDisplayBrief(_INTL("Just a little more! Hang in there, {1}!", newPkmnName))
00263:       else
00264:         pbDisplayBrief(_INTL("Your opponent's weak! Get 'em, {1}!", newPkmnName))
00265:       end
00266:     else
00267:       owner = pbGetOwnerFromBattlerIndex(idxBattler)
00268:       pbDisplayBrief(_INTL("{1} sent out {2}!", owner.full_name, newPkmnName))
00269:     end
00270:   end
00271: 
00272:   # Only called from def pbRecallAndReplace above and Battle Arena's def
00273:   # pbSwitch.
00274:   def pbReplace(idxBattler, idxParty, batonPass = false)
00275:     party = pbParty(idxBattler)
00276:     idxPartyOld = @battlers[idxBattler].pokemonIndex
00277:     # Initialise the new Pokémon
00278:     @battlers[idxBattler].pbInitialize(party[idxParty], idxParty, batonPass)
00279:     # Reorder the party for this battle
00280:     partyOrder = pbPartyOrder(idxBattler)
00281:     partyOrder[idxParty], partyOrder[idxPartyOld] = partyOrder[idxPartyOld], partyOrder[idxParty]
00282:     # Send out the new Pokémon
00283:     pbSendOut([[idxBattler, party[idxParty]]])
00284:     pbCalculatePriority(false, [idxBattler]) if Settings::RECALCULATE_TURN_ORDER_AFTER_SPEED_CHANGES
00285:   end
00286: 
