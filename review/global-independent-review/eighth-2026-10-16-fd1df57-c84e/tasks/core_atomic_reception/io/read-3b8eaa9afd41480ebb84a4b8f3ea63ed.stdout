00093:   def pbInitEffects(batonPass)
00094:     if batonPass
00095:       # These effects are passed on if Baton Pass is used, but they need to be
00096:       # reapplied
00097:       @effects[PBEffects::LaserFocus] = (@effects[PBEffects::LaserFocus] > 0) ? 2 : 0
00098:       @effects[PBEffects::LockOn]     = (@effects[PBEffects::LockOn] > 0) ? 2 : 0
00099:       if @effects[PBEffects::PowerTrick]
00100:         @attack, @defense = @defense, @attack
00101:       end
00102:       # These effects are passed on if Baton Pass is used, but they need to be
00103:       # cancelled in certain circumstances anyway
00104:       @effects[PBEffects::Telekinesis] = 0 if isSpecies?(:GENGAR) && mega?
00105:       @effects[PBEffects::GastroAcid]  = false if unstoppableAbility?
00106:     else
00107:       # These effects are passed on if Baton Pass is used
00108:       GameData::Stat.each_battle { |stat| @stages[stat.id] = 0 }
00109:       @effects[PBEffects::AquaRing]          = false
00110:       @effects[PBEffects::Confusion]         = 0
00111:       @effects[PBEffects::Curse]             = false
00112:       @effects[PBEffects::Embargo]           = 0
00113:       @effects[PBEffects::FocusEnergy]       = 0
00114:       @effects[PBEffects::GastroAcid]        = false
00115:       @effects[PBEffects::HealBlock]         = 0
00116:       @effects[PBEffects::Ingrain]           = false
00117:       @effects[PBEffects::LaserFocus]        = 0
00118:       @effects[PBEffects::LeechSeed]         = -1
00119:       @effects[PBEffects::LockOn]            = 0
00120:       @effects[PBEffects::LockOnPos]         = -1
00121:       @effects[PBEffects::MagnetRise]        = 0
00122:       @effects[PBEffects::PerishSong]        = 0
00123:       @effects[PBEffects::PerishSongUser]    = -1
00124:       @effects[PBEffects::PowerTrick]        = false
00125:       @effects[PBEffects::Substitute]        = 0
00126:       @effects[PBEffects::Telekinesis]       = 0
00127:     end
