00512: class Battle::Move::StartUserSideImmunityToInflictedStatus < Battle::Move
00513:   def canSnatch?; return true; end
00514: 
00515:   def pbMoveFailed?(user, targets)
00516:     if user.pbOwnSide.effects[PBEffects::Safeguard] > 0
00517:       @battle.pbDisplay(_INTL("But it failed!"))
00518:       return true
00519:     end
00520:     return false
00521:   end
00522: 
00523:   def pbEffectGeneral(user)
00524:     user.pbOwnSide.effects[PBEffects::Safeguard] = 5
00525:     @battle.pbDisplay(_INTL("{1} became cloaked in a mystical veil!", user.pbTeam))
00526:   end
00527: end
00528: 
