00190:       @battlers[1].hp = 0
00191:       @battlers[1].pbFaint(false)
00192:     else
00193:       pbDisplay(_INTL("{1} lost to the opponent {2} in a referee's decision!",
00194:                       @battlers[0].name, @battlers[1].name))
00195:       @battlers[0].hp = 0
00196:       @battlers[0].pbFaint(false)
00197:     end
00198:     pbGainExp
00199:     pbEORSwitch
00200:   end
00201: end
00202: 
00203: #===============================================================================
00204: #
00205: #===============================================================================
00206: class Battle::AI
00207:   attr_accessor :battleArena
00208: 
00209:   unless method_defined?(:_battleArena_pbChooseToSwitchOut)
00210:     alias _battleArena_pbChooseToSwitchOut pbChooseToSwitchOut
00211:   end
00212: 
00213:   def pbChooseToSwitchOut(force_switch = false)
00214:     return _battleArena_pbChooseToSwitchOut(force_switch) if !@battleArena
00215:     return false
00216:   end
00217: end
00218: 
00219: #===============================================================================
00220: #
00221: #===============================================================================
00222: class Battle::Scene
00223:   def pbBattleArenaUpdate
00224:     pbGraphicsUpdate
00225:   end
00226: 
00227:   def updateJudgment(window, phase, battler1, battler2, ratings1, ratings2)
00228:     total1 = 0
00229:     total2 = 0
00230:     phase.times do |i|
00231:       total1 += ratings1[i]
00232:       total2 += ratings2[i]
00233:     end
00234:     window.contents.clear
00235:     pbSetSystemFont(window.contents)
