00001: class Battle
00002:   #=============================================================================
00003:   # Shifting a battler to another position in a battle larger than double
00004:   #=============================================================================
00005:   def pbCanShift?(idxBattler)
00006:     return false if pbSideSize(0) <= 2 && pbSideSize(1) <= 2   # Double battle or smaller
00007:     idxOther = -1
00008:     case pbSideSize(idxBattler)
00009:     when 1
00010:       return false   # Only one battler on that side
00011:     when 2
00012:       idxOther = (idxBattler + 2) % 4
00013:     when 3
00014:       return false if [2, 3].include?(idxBattler)   # In middle spot already
00015:       idxOther = (idxBattler.even?) ? 2 : 3
00016:     end
00017:     return false if pbGetOwnerIndexFromBattlerIndex(idxBattler) != pbGetOwnerIndexFromBattlerIndex(idxOther)
00018:     return true
00019:   end
00020: 
00021:   def pbRegisterShift(idxBattler)
00022:     @choices[idxBattler][0] = :Shift
00023:     @choices[idxBattler][1] = 0
00024:     @choices[idxBattler][2] = nil
00025:     return true
00026:   end
00027: 
00028:   #=============================================================================
00029:   # Calling at a battler
00030:   #=============================================================================
00031:   def pbRegisterCall(idxBattler)
00032:     @choices[idxBattler][0] = :Call
00033:     @choices[idxBattler][1] = 0
00034:     @choices[idxBattler][2] = nil
00035:     return true
00036:   end
00037: 
00038:   def pbCall(idxBattler)
00039:     # Debug ending the battle
00040:     return if pbDebugRun != 0
00041:     # Call the battler
00042:     battler = @battlers[idxBattler]
00043:     trainerName = pbGetOwnerName(idxBattler)
00044:     pbDisplay(_INTL("{1} called {2}!", trainerName, battler.pbThis(true)))
00045:     pbDisplay(_INTL("{1}!", battler.name))
00046:     if battler.shadowPokemon?
00047:       if battler.inHyperMode?
00048:         battler.pokemon.hyper_mode = false
00049:         battler.pokemon.change_heart_gauge("call")
00050:         pbDisplay(_INTL("{1} came to its senses from the Trainer's call!", battler.pbThis))
00051:       else
00052:         pbDisplay(_INTL("But nothing happened!"))
00053:       end
00054:     elsif battler.status == :SLEEP
00055:       battler.pbCureStatus
00056:     elsif battler.pbCanRaiseStatStage?(:ACCURACY, battler)
00057:       battler.pbRaiseStatStage(:ACCURACY, 1, battler)
00058:       battler.pbItemOnStatDropped
00059:     else
00060:       pbDisplay(_INTL("But nothing happened!"))
00061:     end
00062:   end
00063: 
