00100:   def pbItemMenu(idxBattler, firstAction)
00101:     if !@internalBattle
00102:       pbDisplay(_INTL("Items can't be used here."))
00103:       return false
00104:     end
00105:     ret = false
00106:     @scene.pbItemMenu(idxBattler, firstAction) do |item, useType, idxPkmn, idxMove, itemScene|
00107:       next false if !item
00108:       battler = pkmn = nil
00109:       case useType
00110:       when 1, 2   # Use on Pokémon/Pokémon's move
00111:         next false if !ItemHandlers.hasBattleUseOnPokemon(item)
00112:         battler = pbFindBattler(idxPkmn, idxBattler)
00113:         pkmn    = pbParty(idxBattler)[idxPkmn]
00114:         next false if !pbCanUseItemOnPokemon?(item, pkmn, battler, itemScene)
00115:       when 3   # Use on battler
00116:         next false if !ItemHandlers.hasBattleUseOnBattler(item)
00117:         battler = pbFindBattler(idxPkmn, idxBattler)
00118:         pkmn    = battler.pokemon if battler
00119:         next false if !pbCanUseItemOnPokemon?(item, pkmn, battler, itemScene)
00120:       when 4   # Poké Balls
00121:         next false if idxPkmn < 0
00122:         battler = @battlers[idxPkmn]
00123:         pkmn    = battler.pokemon if battler
00124:       when 5   # No target (Poké Doll, Guard Spec., Launcher items)
00125:         battler = @battlers[idxBattler]
00126:         pkmn    = battler.pokemon if battler
00127:       else
00128:         next false
00129:       end
00130:       next false if !pkmn
00131:       next false if !ItemHandlers.triggerCanUseInBattle(item, pkmn, battler, idxMove,
00132:                                                         firstAction, self, itemScene)
00133:       next false if !pbRegisterItem(idxBattler, item, idxPkmn, idxMove)
00134:       ret = true
00135:       next true
00136:     end
00137:     return ret
00138:   end
