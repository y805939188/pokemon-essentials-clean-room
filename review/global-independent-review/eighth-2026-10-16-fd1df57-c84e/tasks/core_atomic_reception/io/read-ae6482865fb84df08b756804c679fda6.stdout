00004: class Battle::AI::AIBattler
00005:   attr_reader :index, :side, :party_index
00006:   attr_reader :battler
00007: 
00008:   def initialize(ai, index)
00009:     @ai = ai
00010:     @index = index
00011:     @side = (@ai.battle.opposes?(@index)) ? 1 : 0
00012:     refresh_battler
00013:   end
00014: 
00015:   def refresh_battler
00016:     old_party_index = @party_index
