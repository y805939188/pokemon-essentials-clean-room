00215:   end
00216: 
00217:   def canConsumePinchBerry?(check_gluttony = true)
00218:     return false if !canConsumeBerry?
00219:     return true if @hp <= @totalhp / 4
00220:     return true if @hp <= @totalhp / 2 && (!check_gluttony || hasActiveAbility?(:GLUTTONY))
00221:     return false
00222:   end
00223: 
00224:   # permanent is whether the item is lost even after battle. Is false for Knock
00225:   # Off.
00226:   def pbRemoveItem(permanent = true)
00227:     @effects[PBEffects::ChoiceBand] = nil if !hasActiveAbility?(:GORILLATACTICS)
00228:     @effects[PBEffects::Unburden]   = true if self.item && hasActiveAbility?(:UNBURDEN)
00229:     setInitialItem(nil) if permanent && self.item == self.initialItem
00230:     self.item = nil
00231:   end
00232: 
00233:   def pbConsumeItem(recoverable = true, symbiosis = true, belch = true)
00234:     PBDebug.log("[Item consumed] #{pbThis} consumed its held #{itemName}")
00235:     if recoverable
00236:       setRecycleItem(@item_id)
00237:       @effects[PBEffects::PickupItem] = @item_id
00238:       @effects[PBEffects::PickupUse]  = @battle.nextPickupUse
00239:     end
00240:     setBelched if belch && self.item.is_berry?
00241:     pbRemoveItem
00242:     pbSymbiosis if symbiosis
00243:   end
00244: 
00245:   def pbSymbiosis
00246:     return if fainted?
00247:     return if self.item
00248:     @battle.pbPriority(true).each do |b|
00249:       next if b.opposes?(self)
00250:       next if !b.hasActiveAbility?(:SYMBIOSIS)
00251:       next if !b.item || b.unlosableItem?(b.item)
00252:       next if unlosableItem?(b.item)
00253:       @battle.pbShowAbilitySplash(b)
00254:       if Battle::Scene::USE_ABILITY_SPLASH
00255:         @battle.pbDisplay(_INTL("{1} shared its {2} with {3}!",
00256:                                 b.pbThis, b.itemName, pbThis(true)))
00257:       else
00258:         @battle.pbDisplay(_INTL("{1}'s {2} let it share its {3} with {4}!",
00259:                                 b.pbThis, b.abilityName, b.itemName, pbThis(true)))
00260:       end
00261:       self.item = b.item
00262:       b.item = nil
00263:       b.effects[PBEffects::Unburden] = true if b.hasActiveAbility?(:UNBURDEN)
00264:       @battle.pbHideAbilitySplash(b)
00265:       pbHeldItemTriggerCheck
