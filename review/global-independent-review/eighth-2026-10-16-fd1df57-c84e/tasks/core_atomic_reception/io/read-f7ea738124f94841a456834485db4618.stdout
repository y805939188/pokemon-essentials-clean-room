01105: Battle::AbilityEffects::AccuracyCalcFromUser.add(:KEENEYE,
01106:   proc { |ability, mods, user, target, move, type|
01107:     mods[:evasion_stage] = 0 if mods[:evasion_stage] > 0 && Settings::MECHANICS_GENERATION >= 6
01108:   }
01109: )
01110: 
01111: Battle::AbilityEffects::AccuracyCalcFromUser.add(:NOGUARD,
01112:   proc { |ability, mods, user, target, move, type|
01113:     mods[:base_accuracy] = 0
01114:   }
01115: )
01116: 
01117: Battle::AbilityEffects::AccuracyCalcFromUser.add(:UNAWARE,
01118:   proc { |ability, mods, user, target, move, type|
01119:     mods[:evasion_stage] = 0 if move.damagingMove?
01120:   }
01121: )
01122: 
01123: Battle::AbilityEffects::AccuracyCalcFromUser.add(:VICTORYSTAR,
01124:   proc { |ability, mods, user, target, move, type|
01125:     mods[:accuracy_multiplier] *= 1.1
01126:   }
01127: )
