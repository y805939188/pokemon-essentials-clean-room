00042:     MultipleForms.call("changePokemonOnStartingBattle", pkmn, battle)
00043:   end
00044: 
00045:   def pbOnEnteringBattle(battle, battler, pkmn, wild = false)
00046:     f = MultipleForms.call("getFormOnEnteringBattle", pkmn, wild)
00047:     pkmn.form = f if f
00048:     battler.form = pkmn.form if battler.form != pkmn.form
00049:     MultipleForms.call("changePokemonOnEnteringBattle", battler, pkmn, battle)
00050:   end
00051: 
00052:   # For switching out, including due to fainting, and for the end of battle
00053:   def pbOnLeavingBattle(battle, pkmn, usedInBattle, endBattle = false)
00054:     return if !pkmn
00055:     f = MultipleForms.call("getFormOnLeavingBattle", pkmn, battle, usedInBattle, endBattle)
00056:     pkmn.form = f if f && pkmn.form != f
00057:     pkmn.hp = pkmn.totalhp if pkmn.hp > pkmn.totalhp
00058:     MultipleForms.call("changePokemonOnLeavingBattle", pkmn, battle, usedInBattle, endBattle)
00059:   end
00060: end
00061: 
00062: #===============================================================================
00063: # Unused class.
00064: #===============================================================================
00065: class Battle::NullPeer
00066:   def pbOnEnteringBattle(battle, battler, pkmn, wild = false); end
00067:   def pbOnLeavingBattle(battle, pkmn, usedInBattle, endBattle = false); end
00068: 
00069:   def pbStorePokemon(player, pkmn)
00070:     player.party[player.party.length] = pkmn if !player.party_full?
00071:     return -1
00072:   end
00073: 
00074:   def pbGetStorageCreatorName; return nil; end
00075:   def pbCurrentBox;            return -1;  end
00076:   def pbBoxName(box);          return "";  end
