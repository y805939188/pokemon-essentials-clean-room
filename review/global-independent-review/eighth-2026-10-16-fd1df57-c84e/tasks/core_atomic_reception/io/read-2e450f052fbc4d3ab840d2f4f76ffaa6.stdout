00331:     next mult * 2 if battler.battle.field.terrain == :Electric
00332:   }
00333: )
00334: 
00335: Battle::AbilityEffects::SpeedCalc.add(:SWIFTSWIM,
00336:   proc { |ability, battler, mult|
00337:     next mult * 2 if [:Rain, :HeavyRain].include?(battler.effectiveWeather)
00338:   }
00339: )
00340: 
00341: Battle::AbilityEffects::SpeedCalc.add(:UNBURDEN,
