00666: #===============================================================================
00667: # StatLossImmunity handlers
00668: #===============================================================================
00669: 
00670: Battle::AbilityEffects::StatLossImmunity.add(:BIGPECKS,
00671:   proc { |ability, battler, stat, battle, showMessages|
00672:     next false if stat != :DEFENSE
00673:     if showMessages
00674:       battle.pbShowAbilitySplash(battler)
00675:       if Battle::Scene::USE_ABILITY_SPLASH
00676:         battle.pbDisplay(_INTL("{1}'s {2} cannot be lowered!", battler.pbThis, GameData::Stat.get(stat).name))
00677:       else
00678:         battle.pbDisplay(_INTL("{1}'s {2} prevents {3} loss!", battler.pbThis,
00679:            battler.abilityName, GameData::Stat.get(stat).name))
00680:       end
00681:       battle.pbHideAbilitySplash(battler)
00682:     end
00683:     next true
00684:   }
00685: )
00686: 
00687: Battle::AbilityEffects::StatLossImmunity.add(:CLEARBODY,
00688:   proc { |ability, battler, stat, battle, showMessages|
00689:     if showMessages
00690:       battle.pbShowAbilitySplash(battler)
00691:       if Battle::Scene::USE_ABILITY_SPLASH
00692:         battle.pbDisplay(_INTL("{1}'s stats cannot be lowered!", battler.pbThis))
00693:       else
00694:         battle.pbDisplay(_INTL("{1}'s {2} prevents stat loss!", battler.pbThis, battler.abilityName))
00695:       end
00696:       battle.pbHideAbilitySplash(battler)
00697:     end
00698:     next true
00699:   }
