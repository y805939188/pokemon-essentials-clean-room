00644:     else
00645:       battler.battle.pbDisplay(_INTL("{1}'s {2} snapped it out of its confusion!",
00646:          battler.pbThis, battler.abilityName))
00647:     end
00648:     battler.battle.pbHideAbilitySplash(battler)
00649:   }
00650: )
