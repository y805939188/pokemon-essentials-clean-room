00363: #===============================================================================
00364: # OnHPDroppedBelowHalf handlers
00365: #===============================================================================
00366: 
00367: Battle::AbilityEffects::OnHPDroppedBelowHalf.add(:EMERGENCYEXIT,
00368:   proc { |ability, battler, move_user, battle|
00369:     next false if battler.effects[PBEffects::SkyDrop] >= 0 ||
00370:                   battler.inTwoTurnAttack?("TwoTurnAttackInvulnerableInSkyTargetCannotAct")   # Sky Drop
00371:     # In wild battles
00372:     if battle.wildBattle?
00373:       next false if battler.opposes? && battle.pbSideBattlerCount(battler.index) > 1
00374:       next false if !battle.pbCanRun?(battler.index)
00375:       battle.pbShowAbilitySplash(battler, true)
00376:       battle.pbHideAbilitySplash(battler)
00377:       pbSEPlay("Battle flee")
00378:       battle.pbDisplay(_INTL("{1} fled from battle!", battler.pbThis))
00379:       battle.decision = 3   # Escaped
00380:       next true
00381:     end
00382:     # In trainer battles
00383:     next false if battle.pbAllFainted?(battler.idxOpposingSide)
00384:     next false if !battle.pbCanSwitchOut?(battler.index)   # Battler can't switch out
00385:     next false if !battle.pbCanChooseNonActive?(battler.index)   # No Pokémon can switch in
00386:     battle.pbShowAbilitySplash(battler, true)
00387:     battle.pbHideAbilitySplash(battler)
00388:     if !Battle::Scene::USE_ABILITY_SPLASH
00389:       battle.pbDisplay(_INTL("{1}'s {2} activated!", battler.pbThis, battler.abilityName))
00390:     end
00391:     battle.pbDisplay(_INTL("{1} went back to {2}!",
00392:        battler.pbThis, battle.pbGetOwnerName(battler.index)))
00393:     if battle.endOfRound   # Just switch out
00394:       battle.scene.pbRecall(battler.index) if !battler.fainted?
00395:       battler.pbAbilitiesOnSwitchOut   # Inc. primordial weather check
00396:       next true
00397:     end
00398:     newPkmn = battle.pbGetReplacementPokemonIndex(battler.index)   # Owner chooses
00399:     next false if newPkmn < 0   # Shouldn't ever do this
00400:     battle.pbRecallAndReplace(battler.index, newPkmn)
00401:     battle.pbClearChoice(battler.index)   # Replacement Pokémon does nothing this round
00402:     battle.moldBreaker = false if move_user && battler.index == move_user.index
00403:     battle.pbOnBattlerEnteringBattle(battler.index)
00404:     next true
00405:   }
00406: )
00407: 
00408: Battle::AbilityEffects::OnHPDroppedBelowHalf.copy(:EMERGENCYEXIT, :WIMPOUT)
00409: 
