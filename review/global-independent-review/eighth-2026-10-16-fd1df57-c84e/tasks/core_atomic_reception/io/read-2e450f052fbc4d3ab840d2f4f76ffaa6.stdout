00610: Battle::AbilityEffects::StatusCure.add(:OBLIVIOUS,
00611:   proc { |ability, battler|
00612:     next if battler.effects[PBEffects::Attract] < 0 &&
00613:             (battler.effects[PBEffects::Taunt] == 0 || Settings::MECHANICS_GENERATION <= 5)
00614:     battler.battle.pbShowAbilitySplash(battler)
00615:     if battler.effects[PBEffects::Attract] >= 0
00616:       battler.pbCureAttract
00617:       if Battle::Scene::USE_ABILITY_SPLASH
00618:         battler.battle.pbDisplay(_INTL("{1} got over its infatuation.", battler.pbThis))
00619:       else
00620:         battler.battle.pbDisplay(_INTL("{1}'s {2} cured its infatuation status!",
00621:            battler.pbThis, battler.abilityName))
00622:       end
00623:     end
00624:     if battler.effects[PBEffects::Taunt] > 0 && Settings::MECHANICS_GENERATION >= 6
00625:       battler.effects[PBEffects::Taunt] = 0
00626:       if Battle::Scene::USE_ABILITY_SPLASH
00627:         battler.battle.pbDisplay(_INTL("{1}'s Taunt wore off!", battler.pbThis))
00628:       else
00629:         battler.battle.pbDisplay(_INTL("{1}'s {2} made its taunt wear off!",
00630:            battler.pbThis, battler.abilityName))
00631:       end
00632:     end
00633:     battler.battle.pbHideAbilitySplash(battler)
00634:   }
00635: )
00636: 
00637: Battle::AbilityEffects::StatusCure.add(:OWNTEMPO,
00638:   proc { |ability, battler|
00639:     next if battler.effects[PBEffects::Confusion] == 0
