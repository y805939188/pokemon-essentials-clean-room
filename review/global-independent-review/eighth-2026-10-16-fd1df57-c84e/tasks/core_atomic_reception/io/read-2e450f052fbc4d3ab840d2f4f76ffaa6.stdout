00511: #===============================================================================
00512: # OnStatusInflicted handlers
00513: #===============================================================================
00514: 
00515: Battle::AbilityEffects::OnStatusInflicted.add(:SYNCHRONIZE,
00516:   proc { |ability, battler, user, status|
00517:     next if !user || user.index == battler.index
00518:     case status
00519:     when :POISON
00520:       if user.pbCanPoisonSynchronize?(battler)
00521:         battler.battle.pbShowAbilitySplash(battler)
00522:         msg = nil
00523:         if !Battle::Scene::USE_ABILITY_SPLASH
00524:           msg = _INTL("{1}'s {2} poisoned {3}!", battler.pbThis, battler.abilityName, user.pbThis(true))
00525:         end
00526:         user.pbPoison(nil, msg, (battler.statusCount > 0))
00527:         battler.battle.pbHideAbilitySplash(battler)
00528:       end
00529:     when :BURN
00530:       if user.pbCanBurnSynchronize?(battler)
00531:         battler.battle.pbShowAbilitySplash(battler)
00532:         msg = nil
00533:         if !Battle::Scene::USE_ABILITY_SPLASH
00534:           msg = _INTL("{1}'s {2} burned {3}!", battler.pbThis, battler.abilityName, user.pbThis(true))
00535:         end
00536:         user.pbBurn(nil, msg)
00537:         battler.battle.pbHideAbilitySplash(battler)
00538:       end
00539:     when :PARALYSIS
00540:       if user.pbCanParalyzeSynchronize?(battler)
00541:         battler.battle.pbShowAbilitySplash(battler)
00542:         msg = nil
00543:         if !Battle::Scene::USE_ABILITY_SPLASH
00544:           msg = _INTL("{1}'s {2} paralyzed {3}! It may be unable to move!",
00545:              battler.pbThis, battler.abilityName, user.pbThis(true))
00546:         end
00547:         user.pbParalyze(nil, msg)
00548:         battler.battle.pbHideAbilitySplash(battler)
00549:       end
00550:     end
00551:   }
00552: )
00553: 
