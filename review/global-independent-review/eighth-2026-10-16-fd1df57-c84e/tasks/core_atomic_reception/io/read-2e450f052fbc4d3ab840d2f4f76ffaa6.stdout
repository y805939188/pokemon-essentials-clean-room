00299: Battle::AbilityEffects::SpeedCalc.add(:CHLOROPHYLL,
00300:   proc { |ability, battler, mult|
00301:     next mult * 2 if [:Sun, :HarshSun].include?(battler.effectiveWeather)
00302:   }
00303: )
00304: 
00305: Battle::AbilityEffects::SpeedCalc.add(:QUICKFEET,
00306:   proc { |ability, battler, mult|
00307:     next mult * 1.5 if battler.pbHasAnyStatus?
00308:   }
00309: )
00310: 
00311: Battle::AbilityEffects::SpeedCalc.add(:SANDRUSH,
00312:   proc { |ability, battler, mult|
00313:     next mult * 2 if [:Sandstorm].include?(battler.effectiveWeather)
00314:   }
00315: )
00316: 
00317: Battle::AbilityEffects::SpeedCalc.add(:SLOWSTART,
00318:   proc { |ability, battler, mult|
00319:     next mult / 2 if battler.effects[PBEffects::SlowStart] > 0
00320:   }
00321: )
00322: 
00323: Battle::AbilityEffects::SpeedCalc.add(:SLUSHRUSH,
00324:   proc { |ability, battler, mult|
00325:     next mult * 2 if [:Hail].include?(battler.effectiveWeather)
00326:   }
00327: )
00328: 
00329: Battle::AbilityEffects::SpeedCalc.add(:SURGESURFER,
