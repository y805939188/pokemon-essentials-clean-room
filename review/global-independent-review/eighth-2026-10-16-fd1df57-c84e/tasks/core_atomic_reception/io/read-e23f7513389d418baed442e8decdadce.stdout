00172:     return false if !$PokemonGlobal.partner || $game_temp.battle_rules["noPartner"]
00173:     return true if foe_party.length > 1
00174:     if $game_temp.battle_rules["size"]
00175:       return false if $game_temp.battle_rules["size"] == "single" ||
00176:                       $game_temp.battle_rules["size"][/^1v/i]   # "1v1", "1v2", "1v3", etc.
00177:       return true
00178:     end
00179:     return false
00180:   end
00181: 
00182:   # Generate information for the player and partner trainer(s)
00183:   def set_up_player_trainers(foe_party)
00184:     trainer_array = [$player]
00185:     ally_items    = []
00186:     pokemon_array = $player.party
00187:     party_starts  = [0]
00188:     if partner_can_participate?(foe_party)
00189:       ally = NPCTrainer.new($PokemonGlobal.partner[1], $PokemonGlobal.partner[0])
00190:       ally.id    = $PokemonGlobal.partner[2]
00191:       ally.party = $PokemonGlobal.partner[3]
00192:       data = GameData::Trainer.try_get($PokemonGlobal.partner[0], $PokemonGlobal.partner[1], $PokemonGlobal.partner[2])
00193:       ally_items[1] = data&.items.clone || []
00194:       trainer_array.push(ally)
00195:       pokemon_array = []
00196:       $player.party.each { |pkmn| pokemon_array.push(pkmn) }
00197:       party_starts.push(pokemon_array.length)
00198:       ally.party.each { |pkmn| pokemon_array.push(pkmn) }
00199:       setBattleRule("double") if $game_temp.battle_rules["size"].nil?
00200:     end
00201:     return trainer_array, ally_items, pokemon_array, party_starts
00202:   end
00203: 
00204:   def create_battle_scene
00205:     return Battle::Scene.new
00206:   end
