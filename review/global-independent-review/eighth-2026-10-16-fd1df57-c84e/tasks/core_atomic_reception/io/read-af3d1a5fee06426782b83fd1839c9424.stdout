00158:   def self.triggerExpGainModifier(item, battler, exp)
00159:     return trigger(ExpGainModifier, item, battler, exp, ret: -1)
00160:   end
00161: 
00162:   def self.triggerEVGainModifier(item, battler, ev_array)
00163:     return false if !EVGainModifier[item]
00164:     EVGainModifier.trigger(item, battler, ev_array)
00165:     return true
00166:   end
00167: 
00168:   #=============================================================================
00169: 
00170:   def self.triggerWeatherExtender(item, weather, duration, battler, battle)
00171:     return trigger(WeatherExtender, item, weather, duration, battler, battle, ret: duration)
00172:   end
00173: 
00174:   def self.triggerTerrainExtender(item, terrain, duration, battler, battle)
00175:     return trigger(TerrainExtender, item, terrain, duration, battler, battle, ret: duration)
00176:   end
00177: 
00178:   def self.triggerTerrainStatBoost(item, battler, battle)
00179:     return trigger(TerrainStatBoost, item, battler, battle)
00180:   end
