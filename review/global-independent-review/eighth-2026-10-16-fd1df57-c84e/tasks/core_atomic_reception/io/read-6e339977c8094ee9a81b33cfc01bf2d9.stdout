01355:   def pbStartForgetScreen(party, partyindex, move_to_learn)
01356:     ret = -1
01357:     @scene.pbStartForgetScene(party, partyindex, move_to_learn)
01358:     loop do
01359:       ret = @scene.pbChooseMoveToForget(move_to_learn)
01360:       break if ret < 0 || !move_to_learn
01361:       break if $DEBUG || !party[partyindex].moves[ret].hidden_move?
01362:       pbMessage(_INTL("HM moves can't be forgotten now.")) { @scene.pbUpdate }
01363:     end
01364:     @scene.pbEndScene
01365:     return ret
01366:   end
01367: 
01368:   def pbStartChooseMoveScreen(party, partyindex, message)
01369:     ret = -1
01370:     @scene.pbStartForgetScene(party, partyindex, nil)
01371:     pbMessage(message) { @scene.pbUpdate }
01372:     loop do
01373:       ret = @scene.pbChooseMoveToForget(nil)
01374:       break if ret >= 0
01375:       pbMessage(_INTL("You must choose a move!")) { @scene.pbUpdate }
01376:     end
01377:     @scene.pbEndScene
01378:     return ret
01379:   end
01380: end
