00270:       showMirrorArmorSplash = false
00271:     end
00272:     @battle.pbHideAbilitySplash(target)   # To hide target's Mirror Armor splash
00273:   end
00274: 
00275:   def pbEffectAgainstTarget(user, target)
00276:     pbLowerTargetMultipleStats(user, target) if !damagingMove?
00277:   end
00278: 
00279:   def pbAdditionalEffect(user, target)
00280:     pbLowerTargetMultipleStats(user, target) if !target.damageState.substitute
00281:   end
00282: end
00283: 
00284: #===============================================================================
00285: # Fixed damage-inflicting move.
00286: #===============================================================================
00287: class Battle::Move::FixedDamageMove < Battle::Move
00288:   def pbFixedDamage(user, target); return 1; end
