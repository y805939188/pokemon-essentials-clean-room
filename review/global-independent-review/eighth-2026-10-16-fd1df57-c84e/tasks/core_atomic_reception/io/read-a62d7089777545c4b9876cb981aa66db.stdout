00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Get move's user
00004:   #=============================================================================
00005:   def pbFindUser(_choice, _move)
00006:     return self
00007:   end
00008: 
00009:   def pbChangeUser(choice, move, user)
00010:     # Snatch
00011:     move.snatched = false
00012:     if move.statusMove? && move.canSnatch?
00013:       newUser = nil
00014:       strength = 100
00015:       @battle.allBattlers.each do |b|
00016:         next if b.effects[PBEffects::Snatch] == 0 ||
00017:                 b.effects[PBEffects::Snatch] >= strength
00018:         next if b.effects[PBEffects::SkyDrop] >= 0
00019:         newUser = b
00020:         strength = b.effects[PBEffects::Snatch]
00021:       end
00022:       if newUser
00023:         user = newUser
00024:         user.effects[PBEffects::Snatch] = 0
00025:         move.snatched = true
00026:         @battle.moldBreaker = user.hasMoldBreaker?
00027:         choice[3] = -1   # Clear pre-chosen target
00028:       end
00029:     end
00030:     return user
00031:   end
00032: 
00033:   #=============================================================================
00034:   # Get move's default target(s)
00035:   #=============================================================================
00036:   def pbFindTargets(choice, move, user)
00037:     preTarget = choice[3]   # A target that was already chosen
00038:     targets = []
00039:     # Get list of targets
00040:     case move.pbTarget(user).id   # Curse can change its target type
00041:     when :NearAlly
00042:       targetBattler = (preTarget >= 0) ? @battle.battlers[preTarget] : nil
00043:       if !pbAddTarget(targets, user, targetBattler, move)
00044:         pbAddTargetRandomAlly(targets, user, move)
00045:       end
00046:     when :UserOrNearAlly
00047:       targetBattler = (preTarget >= 0) ? @battle.battlers[preTarget] : nil
00048:       if !pbAddTarget(targets, user, targetBattler, move, true, true)
00049:         pbAddTarget(targets, user, user, move, true, true)
00050:       end
00051:     when :AllAllies
00052:       @battle.allSameSideBattlers(user.index).each do |b|
00053:         pbAddTarget(targets, user, b, move, false, true) if b.index != user.index
00054:       end
00055:     when :UserAndAllies
00056:       pbAddTarget(targets, user, user, move, true, true)
00057:       @battle.allSameSideBattlers(user.index).each { |b| pbAddTarget(targets, user, b, move, false, true) }
00058:     when :NearFoe, :NearOther
00059:       targetBattler = (preTarget >= 0) ? @battle.battlers[preTarget] : nil
00060:       if !pbAddTarget(targets, user, targetBattler, move)
00061:         if preTarget >= 0 && !user.opposes?(preTarget)
00062:           pbAddTargetRandomAlly(targets, user, move)
00063:         else
00064:           pbAddTargetRandomFoe(targets, user, move)
00065:         end
00066:       end
00067:     when :RandomNearFoe
00068:       pbAddTargetRandomFoe(targets, user, move)
00069:     when :AllNearFoes
00070:       @battle.allOtherSideBattlers(user.index).each { |b| pbAddTarget(targets, user, b, move) }
00071:     when :Foe, :Other
00072:       targetBattler = (preTarget >= 0) ? @battle.battlers[preTarget] : nil
00073:       if !pbAddTarget(targets, user, targetBattler, move, false)
00074:         if preTarget >= 0 && !user.opposes?(preTarget)
00075:           pbAddTargetRandomAlly(targets, user, move, false)
00076:         else
00077:           pbAddTargetRandomFoe(targets, user, move, false)
00078:         end
00079:       end
00080:     when :AllFoes
00081:       @battle.allOtherSideBattlers(user.index).each { |b| pbAddTarget(targets, user, b, move, false) }
00082:     when :AllNearOthers
00083:       @battle.allBattlers.each { |b| pbAddTarget(targets, user, b, move) }
00084:     when :AllBattlers
00085:       @battle.allBattlers.each { |b| pbAddTarget(targets, user, b, move, false, true) }
00086:     else
00087:       # Used by Counter/Mirror Coat/Metal Burst/Bide
00088:       move.pbAddTarget(targets, user)   # Move-specific pbAddTarget, not the def below
00089:     end
00090:     return targets
00091:   end
00092: 
00093:   #=============================================================================
00094:   # Redirect attack to another target
00095:   #=============================================================================
00096:   def pbChangeTargets(move, user, targets)
00097:     target_data = move.pbTarget(user)
00098:     return targets if @battle.switching   # For Pursuit interrupting a switch
00099:     return targets if move.cannotRedirect? || move.targetsPosition?
00100:     return targets if !target_data.can_target_one_foe? || targets.length != 1
00101:     move.pbModifyTargets(targets, user)   # For Dragon Darts
00102:     return targets if user.hasActiveAbility?([:PROPELLERTAIL, :STALWART])
00103:     priority = @battle.pbPriority(true)
00104:     nearOnly = !target_data.can_choose_distant_target?
00105:     # Spotlight (takes priority over Follow Me/Rage Powder/Lightning Rod/Storm Drain)
00106:     newTarget = nil
00107:     strength = 100   # Lower strength takes priority
00108:     priority.each do |b|
00109:       next if b.fainted? || b.effects[PBEffects::SkyDrop] >= 0
00110:       next if b.effects[PBEffects::Spotlight] == 0 ||
00111:               b.effects[PBEffects::Spotlight] >= strength
00112:       next if !b.opposes?(user)
00113:       next if nearOnly && !b.near?(user)
00114:       newTarget = b
00115:       strength = b.effects[PBEffects::Spotlight]
00116:     end
00117:     if newTarget
00118:       PBDebug.log("[Move target changed] #{newTarget.pbThis}'s Spotlight made it the target")
00119:       targets = []
00120:       pbAddTarget(targets, user, newTarget, move, nearOnly)
00121:       return targets
00122:     end
00123:     # Follow Me/Rage Powder (takes priority over Lightning Rod/Storm Drain)
00124:     newTarget = nil
00125:     strength = 100   # Lower strength takes priority
00126:     priority.each do |b|
00127:       next if b.fainted? || b.effects[PBEffects::SkyDrop] >= 0
00128:       next if b.effects[PBEffects::RagePowder] && !user.affectedByPowder?
00129:       next if b.effects[PBEffects::FollowMe] == 0 ||
00130:               b.effects[PBEffects::FollowMe] >= strength
00131:       next if !b.opposes?(user)
00132:       next if nearOnly && !b.near?(user)
00133:       newTarget = b
00134:       strength = b.effects[PBEffects::FollowMe]
00135:     end
00136:     if newTarget
00137:       PBDebug.log("[Move target changed] #{newTarget.pbThis}'s Follow Me/Rage Powder made it the target")
00138:       targets = []
00139:       pbAddTarget(targets, user, newTarget, move, nearOnly)
00140:       return targets
00141:     end
00142:     # Lightning Rod
00143:     targets = pbChangeTargetByAbility(:LIGHTNINGROD, :ELECTRIC, move, user, targets, priority, nearOnly)
00144:     # Storm Drain
00145:     targets = pbChangeTargetByAbility(:STORMDRAIN, :WATER, move, user, targets, priority, nearOnly)
00146:     return targets
00147:   end
00148: 
00149:   def pbChangeTargetByAbility(drawingAbility, drawnType, move, user, targets, priority, nearOnly)
00150:     return targets if move.calcType != drawnType
00151:     return targets if targets[0].hasActiveAbility?(drawingAbility)
00152:     priority.each do |b|
00153:       next if b.index == user.index || b.index == targets[0].index
00154:       next if !b.hasActiveAbility?(drawingAbility)
00155:       next if nearOnly && !b.near?(user)
00156:       @battle.pbShowAbilitySplash(b)
00157:       targets.clear
00158:       pbAddTarget(targets, user, b, move, nearOnly)
00159:       if Battle::Scene::USE_ABILITY_SPLASH
00160:         @battle.pbDisplay(_INTL("{1} took the attack!", b.pbThis))
00161:       else
00162:         @battle.pbDisplay(_INTL("{1} took the attack with its {2}!", b.pbThis, b.abilityName))
00163:       end
00164:       @battle.pbHideAbilitySplash(b)
00165:       break
00166:     end
00167:     return targets
00168:   end
00169: 
00170:   #=============================================================================
00171:   # Register target
00172:   #=============================================================================
00173:   def pbAddTarget(targets, user, target, move, nearOnly = true, allowUser = false)
00174:     return false if !target || (target.fainted? && !move.targetsPosition?)
00175:     return false if !allowUser && target == user
00176:     return false if nearOnly && !user.near?(target) && target != user
00177:     targets.each { |b| return true if b.index == target.index }   # Already added
00178:     targets.push(target)
00179:     return true
00180:   end
00181: 
00182:   def pbAddTargetRandomAlly(targets, user, move, nearOnly = true)
00183:     choices = []
00184:     user.allAllies.each do |b|
00185:       next if nearOnly && !user.near?(b)
00186:       pbAddTarget(choices, user, b, move, nearOnly)
00187:     end
00188:     if choices.length > 0
00189:       pbAddTarget(targets, user, choices[@battle.pbRandom(choices.length)], move, nearOnly)
00190:     end
00191:   end
00192: 
00193:   def pbAddTargetRandomFoe(targets, user, move, nearOnly = true)
00194:     choices = []
00195:     user.allOpposing.each do |b|
00196:       next if nearOnly && !user.near?(b)
00197:       pbAddTarget(choices, user, b, move, nearOnly)
00198:     end
00199:     if choices.length > 0
00200:       pbAddTarget(targets, user, choices[@battle.pbRandom(choices.length)], move, nearOnly)
00201:     end
00202:   end
00203: end
