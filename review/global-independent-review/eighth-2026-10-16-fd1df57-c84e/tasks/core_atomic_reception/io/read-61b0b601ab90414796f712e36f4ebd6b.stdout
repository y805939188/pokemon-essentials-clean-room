00080: 
00081:   def pbChoseMove?(idxBattler, moveID)
00082:     return false if !@battlers[idxBattler] || @battlers[idxBattler].fainted?
00083:     if @choices[idxBattler][0] == :UseMove && @choices[idxBattler][1]
00084:       return @choices[idxBattler][2].id == moveID
00085:     end
00086:     return false
00087:   end
00088: 
00089:   def pbChoseMoveFunctionCode?(idxBattler, code)
00090:     return false if @battlers[idxBattler].fainted?
00091:     if @choices[idxBattler][0] == :UseMove && @choices[idxBattler][1]
00092:       return @choices[idxBattler][2].function_code == code
00093:     end
00094:     return false
00095:   end
00096: 
00097:   def pbRegisterTarget(idxBattler, idxTarget)
00098:     @choices[idxBattler][3] = idxTarget   # Set target of move
00099:   end
00100: 
00101:   # Returns whether the idxTarget will be targeted by a move with target_data
00102:   # used by a battler in idxUser.
00103:   def pbMoveCanTarget?(idxUser, idxTarget, target_data)
00104:     return false if target_data.num_targets == 0
00105:     case target_data.id
00106:     when :NearAlly
00107:       return false if opposes?(idxUser, idxTarget)
00108:       return false if !nearBattlers?(idxUser, idxTarget)
00109:     when :UserOrNearAlly
00110:       return true if idxUser == idxTarget
00111:       return false if opposes?(idxUser, idxTarget)
00112:       return false if !nearBattlers?(idxUser, idxTarget)
00113:     when :AllAllies
00114:       return false if idxUser == idxTarget
00115:       return false if opposes?(idxUser, idxTarget)
00116:     when :UserAndAllies
00117:       return false if opposes?(idxUser, idxTarget)
00118:     when :NearFoe, :RandomNearFoe, :AllNearFoes
00119:       return false if !opposes?(idxUser, idxTarget)
00120:       return false if !nearBattlers?(idxUser, idxTarget)
00121:     when :Foe
00122:       return false if !opposes?(idxUser, idxTarget)
00123:     when :AllFoes
00124:       return false if !opposes?(idxUser, idxTarget)
00125:     when :NearOther, :AllNearOthers
00126:       return false if !nearBattlers?(idxUser, idxTarget)
00127:     when :Other
00128:       return false if idxUser == idxTarget
00129:     end
00130:     return true
00131:   end
