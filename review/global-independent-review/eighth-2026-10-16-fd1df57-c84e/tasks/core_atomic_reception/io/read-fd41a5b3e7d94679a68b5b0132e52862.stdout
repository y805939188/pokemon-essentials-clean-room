00568:           PBDebug.logonerr { nextUser.pbUseMoveSimple(move.id, preTarget) }
00569:           nextUser.lastRoundMoved = oldLastRoundMoved
00570:           nextUser.effects[PBEffects::Outrage] = oldOutrage
00571:           nextUser.currentMove = oldCurrentMove
00572:           @battle.pbJudge
00573:           return if @battle.decision > 0
00574:         end
00575:         nextUser.effects[PBEffects::Dancer] = false
00576:       end
00577:     end
00578:   end
