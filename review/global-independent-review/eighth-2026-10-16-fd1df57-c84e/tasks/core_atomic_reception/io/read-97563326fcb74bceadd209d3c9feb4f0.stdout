00841:     validate new_owner => Owner
00842:     @owner = new_owner
00843:   end
00844: 
00845:   # @param trainer [Player, NPCTrainer, nil] the trainer to compare to the original trainer
00846:   # @return [Boolean] whether the given trainer is not this Pokémon's original trainer
00847:   def foreign?(trainer = $player)
00848:     return @owner.id != trainer.id || @owner.name != trainer.name
00849:   end
00850: 
00851:   # @return [Time] the time when this Pokémon was obtained
00852:   def timeReceived
00853:     return Time.at(@timeReceived)
00854:   end
00855: 
00856:   # Sets the time when this Pokémon was obtained.
00857:   # @param value [Integer, Time, #to_i] time in seconds since Unix epoch
00858:   def timeReceived=(value)
00859:     @timeReceived = value.to_i
