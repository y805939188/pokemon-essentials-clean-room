00001: class Battle
00002:   #=============================================================================
00003:   # Clear commands
00004:   #=============================================================================
00005:   def pbClearChoice(idxBattler)
00006:     @choices[idxBattler] = [] if !@choices[idxBattler]
00007:     @choices[idxBattler][0] = :None
00008:     @choices[idxBattler][1] = 0
00009:     @choices[idxBattler][2] = nil
00010:     @choices[idxBattler][3] = -1
00011:   end
00012: 
00013:   def pbCancelChoice(idxBattler)
00014:     # If idxBattler's choice was to use an item, return that item to the Bag
00015:     if @choices[idxBattler][0] == :UseItem
00016:       item = @choices[idxBattler][1]
00017:       pbReturnUnusedItemToBag(item, idxBattler) if item
00018:     end
00019:     # If idxBattler chose to Mega Evolve, cancel it
00020:     pbUnregisterMegaEvolution(idxBattler)
00021:     # Clear idxBattler's choice
00022:     pbClearChoice(idxBattler)
00023:   end
00024: 
00025:   #=============================================================================
00026:   # Use main command menu (Fight/Pokémon/Bag/Run)
00027:   #=============================================================================
00028:   def pbCommandMenu(idxBattler, firstAction)
00029:     return @scene.pbCommandMenu(idxBattler, firstAction)
00030:   end
00031: 
00032:   #=============================================================================
00033:   # Check whether actions can be taken
00034:   #=============================================================================
00035:   def pbCanShowCommands?(idxBattler)
00036:     battler = @battlers[idxBattler]
00037:     return false if !battler || battler.fainted?
00038:     return false if battler.usingMultiTurnAttack?
00039:     return true
00040:   end
00041: 
00042:   def pbCanShowFightMenu?(idxBattler)
00043:     battler = @battlers[idxBattler]
00044:     # Encore
00045:     return false if battler.effects[PBEffects::Encore] > 0
00046:     # No moves that can be chosen (will Struggle instead)
00047:     usable = false
00048:     battler.eachMoveWithIndex do |_m, i|
00049:       next if !pbCanChooseMove?(idxBattler, i, false)
00050:       usable = true
00051:       break
00052:     end
00053:     return usable
00054:   end
00055: 
00056:   #=============================================================================
00057:   # Use sub-menus to choose an action, and register it if is allowed
00058:   #=============================================================================
00059:   # Returns true if a choice was made, false if cancelled.
00060:   def pbFightMenu(idxBattler)
00061:     # Auto-use Encored move or no moves choosable, so auto-use Struggle
00062:     return pbAutoChooseMove(idxBattler) if !pbCanShowFightMenu?(idxBattler)
00063:     # Battle Palace only
00064:     return true if pbAutoFightMenu(idxBattler)
00065:     # Regular move selection
00066:     ret = false
00067:     @scene.pbFightMenu(idxBattler, pbCanMegaEvolve?(idxBattler)) do |cmd|
00068:       case cmd
00069:       when -1   # Cancel
00070:       when -2   # Toggle Mega Evolution
00071:         pbToggleRegisteredMegaEvolution(idxBattler)
00072:         next false
00073:       when -3   # Shift
00074:         pbUnregisterMegaEvolution(idxBattler)
00075:         pbRegisterShift(idxBattler)
