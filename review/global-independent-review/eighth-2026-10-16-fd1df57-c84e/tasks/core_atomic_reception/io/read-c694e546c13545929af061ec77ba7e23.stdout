00087:   def pbEffectsAfterMove(user, targets, move, numHits)
00088:     # Defrost
00089:     if move.damagingMove?
00090:       targets.each do |b|
00091:         next if b.damageState.unaffected || b.damageState.substitute
00092:         next if b.status != :FROZEN
00093:         # NOTE: Non-Fire-type moves that thaw the user will also thaw the
00094:         #       target (in Gen 6+).
00095:         if move.calcType == :FIRE || (Settings::MECHANICS_GENERATION >= 6 && move.thawsUser?)
00096:           b.pbCureStatus
00097:         end
00098:       end
00099:     end
00100:     # Destiny Bond
00101:     # NOTE: Although Destiny Bond is similar to Grudge, they don't apply at
00102:     #       the same time (however, Destiny Bond does check whether it's going
00103:     #       to trigger at the same time as Grudge).
00104:     if user.effects[PBEffects::DestinyBondTarget] >= 0 && !user.fainted?
00105:       dbName = @battle.battlers[user.effects[PBEffects::DestinyBondTarget]].pbThis
00106:       @battle.pbDisplay(_INTL("{1} took its attacker down with it!", dbName))
00107:       user.pbReduceHP(user.hp, false)
00108:       user.pbItemHPHealCheck
00109:       user.pbFaint
00110:       @battle.pbJudgeCheckpoint(user)
00111:     end
00112:     # User's ability
00113:     if user.abilityActive?
00114:       Battle::AbilityEffects.triggerOnEndOfUsingMove(user.ability, user, targets, move, @battle)
00115:     end
00116:     if !user.fainted? && !user.effects[PBEffects::Transform] &&
00117:        !@battle.pbAllFainted?(user.idxOpposingSide)
00118:       # Greninja - Battle Bond
00119:       if user.isSpecies?(:GRENINJA) && user.ability == :BATTLEBOND &&
00120:          !@battle.battleBond[user.index & 1][user.pokemonIndex]
00121:         numFainted = 0
00122:         targets.each { |b| numFainted += 1 if b.damageState.fainted }
00123:         if numFainted > 0 && user.form == 1
