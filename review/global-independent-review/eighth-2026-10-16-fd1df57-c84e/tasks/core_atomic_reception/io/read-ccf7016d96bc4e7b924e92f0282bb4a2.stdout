00753:                 Color.new(144, 72, 24),   # 1/4 of total PP or less
00754:                 Color.new(136, 48, 48)]   # Zero PP
00755:     # Set background image
00756:     if move_to_learn
00757:       @sprites["background"].setBitmap("Graphics/UI/Summary/bg_learnmove")
00758:     else
00759:       @sprites["background"].setBitmap("Graphics/UI/Summary/bg_movedetail")
00760:     end
00761:     # Write various bits of text
00762:     textpos = [
00763:       [_INTL("MOVES"), 26, 22, :left, base, shadow],
00764:       [_INTL("CATEGORY"), 20, 128, :left, base, shadow],
00765:       [_INTL("POWER"), 20, 160, :left, base, shadow],
00766:       [_INTL("ACCURACY"), 20, 192, :left, base, shadow]
00767:     ]
00768:     imagepos = []
00769:     # Write move names, types and PP amounts for each known move
00770:     yPos = 104
00771:     yPos -= 76 if move_to_learn
00772:     limit = (move_to_learn) ? Pokemon::MAX_MOVES + 1 : Pokemon::MAX_MOVES
00773:     limit.times do |i|
00774:       move = @pokemon.moves[i]
00775:       if i == Pokemon::MAX_MOVES
00776:         move = move_to_learn
00777:         yPos += 20
00778:       end
00779:       if move
00780:         type_number = GameData::Type.get(move.display_type(@pokemon)).icon_position
00781:         imagepos.push([_INTL("Graphics/UI/types"), 248, yPos - 4, 0, type_number * 28, 64, 28])
00782:         textpos.push([move.name, 316, yPos, :left, moveBase, moveShadow])
00783:         if move.total_pp > 0
00784:           textpos.push([_INTL("PP"), 342, yPos + 32, :left, moveBase, moveShadow])
00785:           ppfraction = 0
00786:           if move.pp == 0
00787:             ppfraction = 3
00788:           elsif move.pp * 4 <= move.total_pp
00789:             ppfraction = 2
00790:           elsif move.pp * 2 <= move.total_pp
00791:             ppfraction = 1
00792:           end
00793:           textpos.push([sprintf("%d/%d", move.pp, move.total_pp), 460, yPos + 32, :right,
00794:                         ppBase[ppfraction], ppShadow[ppfraction]])
00795:         end
00796:       else
00797:         textpos.push(["-", 316, yPos, :left, moveBase, moveShadow])
00798:         textpos.push(["--", 442, yPos + 32, :right, moveBase, moveShadow])
00799:       end
00800:       yPos += 64
00801:     end
00802:     # Draw all text and images
00803:     pbDrawTextPositions(overlay, textpos)
00804:     pbDrawImagePositions(overlay, imagepos)
00805:     # Draw Pokémon's type icon(s)
00806:     @pokemon.types.each_with_index do |type, i|
00807:       type_number = GameData::Type.get(type).icon_position
00808:       type_rect = Rect.new(0, type_number * 28, 64, 28)
00809:       type_x = (@pokemon.types.length == 1) ? 130 : 96 + (70 * i)
00810:       overlay.blt(type_x, 78, @typebitmap.bitmap, type_rect)
00811:     end
00812:   end
00813: 
00814:   def drawSelectedMove(move_to_learn, selected_move)
