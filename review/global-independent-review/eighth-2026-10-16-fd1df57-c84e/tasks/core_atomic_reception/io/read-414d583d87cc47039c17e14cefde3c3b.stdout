00628:       end
00629:     end
00630:   }
00631: )
00632: 
00633: def pbEvolutionCheck
00634:   $player.party.each_with_index do |pkmn, i|
00635:     next if !pkmn || pkmn.egg?
00636:     next if pkmn.fainted? && !Settings::CHECK_EVOLUTION_FOR_FAINTED_POKEMON
00637:     # Find an evolution
00638:     new_species = nil
00639:     if new_species.nil? && $game_temp.party_levels_before_battle &&
00640:        $game_temp.party_levels_before_battle[i] &&
00641:        $game_temp.party_levels_before_battle[i] < pkmn.level
00642:       new_species = pkmn.check_evolution_on_level_up
00643:     end
00644:     new_species = pkmn.check_evolution_after_battle(i) if new_species.nil?
00645:     next if new_species.nil?
