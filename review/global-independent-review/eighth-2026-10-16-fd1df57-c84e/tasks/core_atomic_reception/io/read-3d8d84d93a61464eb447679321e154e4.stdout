00351: 
00352:   # Used for White Herb (restore lowered stats). Only called by Moody and Sticky
00353:   # Web, as all other stat reduction happens because of/during move usage and
00354:   # this handler is also called at the end of each move's usage.
00355:   # item_to_use is an item ID for Bug Bite/Pluck and Fling, and nil otherwise.
00356:   # fling is for Fling only.
00357:   def pbItemStatRestoreCheck(item_to_use = nil, fling = false)
00358:     return if fainted?
00359:     return if !item_to_use && !itemActive?
00360:     itm = item_to_use || self.item
00361:     if Battle::ItemEffects.triggerOnEndOfUsingMoveStatRestore(itm, self, @battle, !item_to_use.nil?)
00362:       pbHeldItemTriggered(itm, item_to_use.nil?, fling)
00363:     end
00364:   end
00365: 
00366:   # Called when the battle terrain changes and when a Pokémon loses HP.
00367:   def pbItemTerrainStatBoostCheck
00368:     return if !itemActive?
00369:     if Battle::ItemEffects.triggerTerrainStatBoost(self.item, self, @battle)
00370:       pbHeldItemTriggered(self.item)
00371:     end
00372:   end
00373: 
00374:   # Used for Adrenaline Orb. Called when Intimidate is triggered (even if
00375:   # Intimidate has no effect on the Pokémon).
00376:   def pbItemOnIntimidatedCheck
00377:     return if !itemActive?
00378:     if Battle::ItemEffects.triggerOnIntimidated(self.item, self, @battle)
00379:       pbHeldItemTriggered(self.item)
00380:     end
00381:   end
00382: 
00383:   # Used for Eject Pack. Returns whether self has switched out.
00384:   def pbItemOnStatDropped(move_user = nil)
00385:     return false if !@statsDropped
00386:     return false if !itemActive?
00387:     return Battle::ItemEffects.triggerOnStatLoss(self.item, self, move_user, @battle)
00388:   end
