00197:   def refresh
00198:     new_page = nil
00199:     unless @erased
00200:       @event.pages.reverse.each do |page|
00201:         c = page.condition
00202:         next if c.switch1_valid && !switchIsOn?(c.switch1_id)
00203:         next if c.switch2_valid && !switchIsOn?(c.switch2_id)
00204:         next if c.variable_valid && $game_variables[c.variable_id] < c.variable_value
00205:         if c.self_switch_valid
00206:           key = [@map_id, @event.id, c.self_switch_ch]
00207:           next if $game_self_switches[key] != true
00208:         end
00209:         new_page = page
00210:         break
00211:       end
00212:     end
00213:     return if new_page == @page
00214:     @page = new_page
00215:     clear_starting
00216:     if @page.nil?
00217:       @tile_id        = 0
00218:       @character_name = ""
00219:       @character_hue  = 0
00220:       @move_type      = 0
00221:       @through        = true
00222:       @trigger        = nil
00223:       @list           = nil
00224:       @interpreter    = nil
00225:       return
00226:     end
00227:     @tile_id              = @page.graphic.tile_id
00228:     @character_name       = @page.graphic.character_name
00229:     @character_hue        = @page.graphic.character_hue
00230:     if @original_direction != @page.graphic.direction
00231:       @direction          = @page.graphic.direction
00232:       @original_direction = @direction
00233:       @prelock_direction  = 0
00234:     end
00235:     if @original_pattern != @page.graphic.pattern
00236:       @pattern            = @page.graphic.pattern
00237:       @original_pattern   = @pattern
00238:     end
00239:     @opacity              = @page.graphic.opacity
00240:     @blend_type           = @page.graphic.blend_type
00241:     @move_type            = @page.move_type
00242:     self.move_speed       = @page.move_speed
00243:     self.move_frequency   = @page.move_frequency
00244:     @move_route           = (@route_erased) ? RPG::MoveRoute.new : @page.move_route
00245:     @move_route_index     = 0
00246:     @move_route_forcing   = false
00247:     @walk_anime           = @page.walk_anime
00248:     @step_anime           = @page.step_anime
00249:     @direction_fix        = @page.direction_fix
00250:     @through              = @page.through
00251:     @always_on_top        = @page.always_on_top
00252:     calculate_bush_depth
00253:     @trigger              = @page.trigger
00254:     @list                 = @page.list
00255:     @interpreter          = nil
00256:     @interpreter          = Interpreter.new if @trigger == 4   # Parallel Process
00257:     check_event_trigger_auto
00258:   end
00259: 
00260:   def should_update?(recalc = false)
00261:     return @to_update if !recalc
