00311: {"assertion_index":309,"clause_id":"AI-REV-wp50-held-item-effect-coverage-L035","path":"deliverables/final-specification-set/pokemon-rules/wp50-held-item-effect-coverage.md","line":35,"full_assertion":"| EndOfRoundHealing（2） | BLACKSLUDGE、LEFTOVERS | WP50 §6 |"}
