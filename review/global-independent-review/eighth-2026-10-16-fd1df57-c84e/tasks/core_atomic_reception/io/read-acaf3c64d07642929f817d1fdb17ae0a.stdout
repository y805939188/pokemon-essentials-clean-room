00255:     @effects[PBEffects::Stockpile]           = 0
00256:     @effects[PBEffects::StockpileDef]        = 0
00257:     @effects[PBEffects::StockpileSpDef]      = 0
00258:     @effects[PBEffects::TarShot]             = false
00259:     @effects[PBEffects::Taunt]               = 0
00260:     @effects[PBEffects::ThroatChop]          = 0
00261:     @effects[PBEffects::Torment]             = false
00262:     @effects[PBEffects::Toxic]               = 0
