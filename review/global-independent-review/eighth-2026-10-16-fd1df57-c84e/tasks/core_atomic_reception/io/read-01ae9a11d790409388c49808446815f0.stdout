00647:   # Only used for Wish, as the Wishing Pokémon will no longer be in battle.
00648:   def pbThisEx(idxBattler, idxParty)
00649:     party = pbParty(idxBattler)
00650:     if opposes?(idxBattler)
00651:       return _INTL("The opposing {1}", party[idxParty].name) if trainerBattle?
00652:       return _INTL("The wild {1}", party[idxParty].name)
00653:     end
00654:     return _INTL("The ally {1}", party[idxParty].name) if !pbOwnedByPlayer?(idxBattler)
00655:     return party[idxParty].name
00656:   end
00657: 
00658:   def pbSetSeen(battler)
00659:     return if !battler || !@internalBattle
00660:     if battler.is_a?(Battler)
00661:       pbPlayer.pokedex.register(battler.displaySpecies, battler.displayGender,
00662:                                 battler.displayForm, battler.shiny?)
00663:     else
00664:       pbPlayer.pokedex.register(battler)
00665:     end
00666:   end
00667: 
00668:   def pbSetCaught(battler)
00669:     return if !battler || !@internalBattle
00670:     if battler.is_a?(Battler)
00671:       pbPlayer.pokedex.register_caught(battler.displaySpecies)
00672:     else
00673:       pbPlayer.pokedex.register_caught(battler.species)
00674:     end
00675:   end
00676: 
00677:   def pbSetDefeated(battler)
00678:     return if !battler || !@internalBattle
00679:     if battler.is_a?(Battler)
00680:       pbPlayer.pokedex.register_defeated(battler.displaySpecies)
00681:     else
00682:       pbPlayer.pokedex.register_defeated(battler.species)
00683:     end
00684:   end
00685: 
00686:   def nextPickupUse
00687:     @nextPickupUse += 1
00688:     return @nextPickupUse
00689:   end
