00068:   SOUL_DEW_POWERS_UP_TYPES            = (MECHANICS_GENERATION >= 7)
00069: 
00070:   #-----------------------------------------------------------------------------
00071:   # Affection
00072:   #-----------------------------------------------------------------------------
00073: 
00074:   # Whether Pokémon with high happiness will gain more Exp from battles, have a
00075:   # chance of avoiding/curing negative effects by themselves, resisting
00076:   # fainting, etc.
00077:   AFFECTION_EFFECTS        = false
00078:   # Whether a Pokémon's happiness is limited to 179, and can only be increased
00079:   # further with friendship-raising berries. Related to AFFECTION_EFFECTS by
00080:   # default because affection effects only start applying above a happiness of
00081:   # 179. Also lowers the happiness evolution threshold to 160.
00082:   APPLY_HAPPINESS_SOFT_CAP = AFFECTION_EFFECTS
00083: 
00084:   #-----------------------------------------------------------------------------
00085:   # Capturing Pokémon
00086:   #-----------------------------------------------------------------------------
00087: 
00088:   # Whether the critical capture mechanic applies. Note that its calculation is
00089:   # based on a total of 600+ species (i.e. that many species need to be caught
00090:   # to provide the greatest critical capture chance of 2.5x), and there may be
00091:   # fewer species in your game.
00092:   ENABLE_CRITICAL_CAPTURES             = (MECHANICS_GENERATION >= 5)
00093:   # Whether the player is asked what to do with a newly caught Pokémon if their
00094:   # party is full. If true, the player can toggle whether they are asked this in
00095:   # the Options screen.
00096:   NEW_CAPTURE_CAN_REPLACE_PARTY_MEMBER = (MECHANICS_GENERATION >= 7)
00097: 
00098:   #-----------------------------------------------------------------------------
00099:   # Exp and EV gain
00100:   #-----------------------------------------------------------------------------
00101: 
00102:   # Whether the Exp gained from beating a Pokémon should be scaled depending on
00103:   # the gainer's level.
00104:   SCALED_EXP_FORMULA            = (MECHANICS_GENERATION == 5 || MECHANICS_GENERATION >= 7)
00105:   # Whether the Exp gained from beating a Pokémon should be divided equally
00106:   # between each participant (true), or whether each participant should gain
00107:   # that much Exp (false). This also applies to Exp gained via the Exp Share
00108:   # (held item version) being distributed to all Exp Share holders.
00109:   SPLIT_EXP_BETWEEN_GAINERS     = (MECHANICS_GENERATION <= 5)
00110:   # Whether the Exp gained from beating a Pokémon is multiplied by 1.5 if that
00111:   # Pokémon is owned by another trainer.
00112:   MORE_EXP_FROM_TRAINER_POKEMON = (MECHANICS_GENERATION <= 6)
00113:   # Whether a Pokémon holding a Power item gains 8 (true) or 4 (false) EVs in
00114:   # the relevant stat.
00115:   MORE_EVS_FROM_POWER_ITEMS     = (MECHANICS_GENERATION >= 7)
00116:   # Whether Pokémon gain Exp for capturing a Pokémon.
00117:   GAIN_EXP_FOR_CAPTURE          = (MECHANICS_GENERATION >= 6)
00118: 
00119:   #-----------------------------------------------------------------------------
00120:   # End of battle
00121:   #-----------------------------------------------------------------------------
00122: 
00123:   # The Game Switch which, while ON, prevents the player from losing money if
00124:   # they lose a battle (they can still gain money from trainers for winning).
00125:   NO_MONEY_LOSS                       = 33
00126:   # Whether party Pokémon check whether they can evolve after all battles
00127:   # regardless of the outcome (true), or only after battles the player won (false).
00128:   CHECK_EVOLUTION_AFTER_ALL_BATTLES   = (MECHANICS_GENERATION >= 6)
00129:   # Whether fainted Pokémon can try to evolve after a battle.
00130:   CHECK_EVOLUTION_FOR_FAINTED_POKEMON = true
00131: 
00132:   #-----------------------------------------------------------------------------
00133:   # AI
00134:   #-----------------------------------------------------------------------------
00135: 
00136:   # Whether wild Pokémon with the "Legendary", "Mythical" or "UltraBeast" flag
00137:   # (as defined in pokemon.txt) have a smarter AI. Their skill level is set to
00138:   # 32, which is a medium skill level.
00139:   SMARTER_WILD_LEGENDARY_POKEMON = true
00140: end
