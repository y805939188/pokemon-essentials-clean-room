01305:     if Battle::ItemEffects.triggerOnBeingHitPositiveBerry(item, target, battle, false)
01306:       target.pbHeldItemTriggered(item)
01307:     end
01308:   }
01309: )
01310: 
01311: Battle::ItemEffects::OnBeingHit.add(:JABOCABERRY,
01312:   proc { |item, user, target, move, battle|
01313:     next if !target.canConsumeBerry?
01314:     next if !move.physicalMove?
01315:     next if !user.takesIndirectDamage?
01316:     amt = user.totalhp / 8
01317:     ripening = false
01318:     if target.hasActiveAbility?(:RIPEN)
01319:       battle.pbShowAbilitySplash(target)
01320:       amt *= 2
01321:       ripening = true
01322:     end
01323:     battle.pbCommonAnimation("EatBerry", target)
01324:     battle.pbHideAbilitySplash(target) if ripening
01325:     battle.scene.pbDamageAnimation(user)
01326:     user.pbReduceHP(amt, false)
01327:     battle.pbDisplay(_INTL("{1} consumed its {2} and hurt {3}!", target.pbThis,
01328:        target.itemName, user.pbThis(true)))
01329:     target.pbHeldItemTriggered(item)
01330:   }
01331: )
01332: 
