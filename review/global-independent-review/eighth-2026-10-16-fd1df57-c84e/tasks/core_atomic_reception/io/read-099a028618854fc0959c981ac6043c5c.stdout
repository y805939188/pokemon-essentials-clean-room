00904:   def weight
00905:     return species_data.weight
00906:   end
00907: 
00908:   # @return [Hash<Integer>] the EV yield of this Pokémon (a hash with six key/value pairs)
00909:   def evYield
00910:     this_evs = species_data.evs
00911:     ret = {}
00912:     GameData::Stat.each_main { |s| ret[s.id] = this_evs[s.id] }
00913:     return ret
00914:   end
00915: 
00916:   def affection_level
00917:     case @happiness
00918:     when 0...100   then return 0
00919:     when 100...150 then return 1
00920:     when 150...200 then return 2
