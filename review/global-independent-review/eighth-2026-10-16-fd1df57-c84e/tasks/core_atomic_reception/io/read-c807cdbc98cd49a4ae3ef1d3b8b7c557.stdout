00755:       battler.statsRaisedThisRound                 = false
00756:       battler.statsLoweredThisRound                = false
00757:       battler.canRestoreIceFace                    = false
00758:       battler.lastRoundMoveFailed                  = battler.lastMoveFailed
00759:       battler.lastAttacker.clear
00760:       battler.lastFoeAttacker.clear
00761:     end
00762:     # Reset/count down side-specific effects (no messages)
00763:     2.times do |side|
00764:       @sides[side].effects[PBEffects::CraftyShield]         = false
00765:       if !@sides[side].effects[PBEffects::EchoedVoiceUsed]
00766:         @sides[side].effects[PBEffects::EchoedVoiceCounter] = 0
00767:       end
00768:       @sides[side].effects[PBEffects::EchoedVoiceUsed]      = false
00769:       @sides[side].effects[PBEffects::MatBlock]             = false
00770:       @sides[side].effects[PBEffects::QuickGuard]           = false
00771:       @sides[side].effects[PBEffects::Round]                = false
00772:       @sides[side].effects[PBEffects::WideGuard]            = false
00773:     end
00774:     # Reset/count down field-specific effects (no messages)
00775:     @field.effects[PBEffects::IonDeluge]   = false
00776:     @field.effects[PBEffects::FairyLock]   -= 1 if @field.effects[PBEffects::FairyLock] > 0
00777:     @field.effects[PBEffects::FusionBolt]  = false
00778:     @field.effects[PBEffects::FusionFlare] = false
00779:     @endOfRound = false
00780:   end
00781: end
