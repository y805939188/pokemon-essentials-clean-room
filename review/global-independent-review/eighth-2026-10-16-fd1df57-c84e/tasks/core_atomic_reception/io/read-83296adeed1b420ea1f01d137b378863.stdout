00310:       @effects[PBEffects::FocusEnergy] = target.effects[PBEffects::FocusEnergy]
00311:       @effects[PBEffects::LaserFocus]  = target.effects[PBEffects::LaserFocus]
00312:     end
00313:     @moves.clear
00314:     target.moves.each_with_index do |m, i|
00315:       @moves[i] = Battle::Move.from_pokemon_move(@battle, Pokemon::Move.new(m.id))
00316:       @moves[i].pp       = 5
00317:       @moves[i].total_pp = 5
00318:     end
00319:     @effects[PBEffects::Disable]      = 0
00320:     @effects[PBEffects::DisableMove]  = nil
00321:     @effects[PBEffects::WeightChange] = target.effects[PBEffects::WeightChange]
00322:     @battle.scene.pbRefreshOne(@index)
00323:     @battle.pbDisplay(_INTL("{1} transformed into {2}!", pbThis, target.pbThis(true)))
00324:     pbOnLosingAbility(oldAbil)
00325:   end
00326: 
00327:   def pbHyperMode; end
00328: end
