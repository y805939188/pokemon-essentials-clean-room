01217: class Battle::Move::LowerTargetEvasion1RemoveSideEffects < Battle::Move::TargetStatDownMove
01218:   def ignoresSubstitute?(user); return true; end
01219: 
01220:   def initialize(battle, move)
01221:     super
01222:     @statDown = [:EVASION, 1]
01223:   end
01224: 
01225:   def pbFailsAgainstTarget?(user, target, show_message)
01226:     targetSide = target.pbOwnSide
01227:     targetOpposingSide = target.pbOpposingSide
01228:     return false if targetSide.effects[PBEffects::AuroraVeil] > 0 ||
01229:                     targetSide.effects[PBEffects::LightScreen] > 0 ||
01230:                     targetSide.effects[PBEffects::Reflect] > 0 ||
01231:                     targetSide.effects[PBEffects::Mist] > 0 ||
01232:                     targetSide.effects[PBEffects::Safeguard] > 0
01233:     return false if targetSide.effects[PBEffects::StealthRock] ||
01234:                     targetSide.effects[PBEffects::Spikes] > 0 ||
01235:                     targetSide.effects[PBEffects::ToxicSpikes] > 0 ||
01236:                     targetSide.effects[PBEffects::StickyWeb]
01237:     return false if Settings::MECHANICS_GENERATION >= 6 &&
01238:                     (targetOpposingSide.effects[PBEffects::StealthRock] ||
01239:                     targetOpposingSide.effects[PBEffects::Spikes] > 0 ||
01240:                     targetOpposingSide.effects[PBEffects::ToxicSpikes] > 0 ||
01241:                     targetOpposingSide.effects[PBEffects::StickyWeb])
01242:     return false if Settings::MECHANICS_GENERATION >= 8 && @battle.field.terrain != :None
01243:     return super
01244:   end
01245: 
01246:   def pbEffectAgainstTarget(user, target)
01247:     if target.pbCanLowerStatStage?(@statDown[0], user, self)
01248:       target.pbLowerStatStage(@statDown[0], @statDown[1], user)
01249:     end
01250:     if target.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
01251:       target.pbOwnSide.effects[PBEffects::AuroraVeil] = 0
01252:       @battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", target.pbTeam))
01253:     end
01254:     if target.pbOwnSide.effects[PBEffects::LightScreen] > 0
01255:       target.pbOwnSide.effects[PBEffects::LightScreen] = 0
01256:       @battle.pbDisplay(_INTL("{1}'s Light Screen wore off!", target.pbTeam))
01257:     end
01258:     if target.pbOwnSide.effects[PBEffects::Reflect] > 0
01259:       target.pbOwnSide.effects[PBEffects::Reflect] = 0
01260:       @battle.pbDisplay(_INTL("{1}'s Reflect wore off!", target.pbTeam))
01261:     end
01262:     if target.pbOwnSide.effects[PBEffects::Mist] > 0
01263:       target.pbOwnSide.effects[PBEffects::Mist] = 0
01264:       @battle.pbDisplay(_INTL("{1}'s Mist faded!", target.pbTeam))
01265:     end
01266:     if target.pbOwnSide.effects[PBEffects::Safeguard] > 0
01267:       target.pbOwnSide.effects[PBEffects::Safeguard] = 0
01268:       @battle.pbDisplay(_INTL("{1} is no longer protected by Safeguard!!", target.pbTeam))
01269:     end
01270:     if target.pbOwnSide.effects[PBEffects::StealthRock] ||
01271:        (Settings::MECHANICS_GENERATION >= 6 &&
01272:        target.pbOpposingSide.effects[PBEffects::StealthRock])
01273:       target.pbOwnSide.effects[PBEffects::StealthRock]      = false
01274:       target.pbOpposingSide.effects[PBEffects::StealthRock] = false if Settings::MECHANICS_GENERATION >= 6
01275:       @battle.pbDisplay(_INTL("{1} blew away stealth rocks!", user.pbThis))
01276:     end
01277:     if target.pbOwnSide.effects[PBEffects::Spikes] > 0 ||
01278:        (Settings::MECHANICS_GENERATION >= 6 &&
01279:        target.pbOpposingSide.effects[PBEffects::Spikes] > 0)
01280:       target.pbOwnSide.effects[PBEffects::Spikes]      = 0
01281:       target.pbOpposingSide.effects[PBEffects::Spikes] = 0 if Settings::MECHANICS_GENERATION >= 6
01282:       @battle.pbDisplay(_INTL("{1} blew away spikes!", user.pbThis))
01283:     end
01284:     if target.pbOwnSide.effects[PBEffects::ToxicSpikes] > 0 ||
01285:        (Settings::MECHANICS_GENERATION >= 6 &&
01286:        target.pbOpposingSide.effects[PBEffects::ToxicSpikes] > 0)
01287:       target.pbOwnSide.effects[PBEffects::ToxicSpikes]      = 0
01288:       target.pbOpposingSide.effects[PBEffects::ToxicSpikes] = 0 if Settings::MECHANICS_GENERATION >= 6
01289:       @battle.pbDisplay(_INTL("{1} blew away poison spikes!", user.pbThis))
01290:     end
01291:     if target.pbOwnSide.effects[PBEffects::StickyWeb] ||
01292:        (Settings::MECHANICS_GENERATION >= 6 &&
01293:        target.pbOpposingSide.effects[PBEffects::StickyWeb])
01294:       target.pbOwnSide.effects[PBEffects::StickyWeb]      = false
01295:       target.pbOpposingSide.effects[PBEffects::StickyWeb] = false if Settings::MECHANICS_GENERATION >= 6
01296:       @battle.pbDisplay(_INTL("{1} blew away sticky webs!", user.pbThis))
01297:     end
01298:     if Settings::MECHANICS_GENERATION >= 8 && @battle.field.terrain != :None
01299:       case @battle.field.terrain
01300:       when :Electric
01301:         @battle.pbDisplay(_INTL("The electricity disappeared from the battlefield."))
01302:       when :Grassy
01303:         @battle.pbDisplay(_INTL("The grass disappeared from the battlefield."))
01304:       when :Misty
01305:         @battle.pbDisplay(_INTL("The mist disappeared from the battlefield."))
01306:       when :Psychic
01307:         @battle.pbDisplay(_INTL("The weirdness disappeared from the battlefield."))
01308:       end
01309:       @battle.field.terrain = :None
01310:     end
01311:   end
01312: end
01313: 
01314: #===============================================================================
01315: # Decreases the target's evasion by 2 stages. (Sweet Scent (Gen 6+))
