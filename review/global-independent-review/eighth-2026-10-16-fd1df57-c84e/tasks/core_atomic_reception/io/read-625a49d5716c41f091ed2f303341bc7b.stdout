00520:   def refreshButtons
00521:     # Choose appropriate button graphics and z positions
00522:     @buttons.each_with_index do |button, i|
00523:       next if !button
00524:       sel = false
00525:       buttonType = 0
00526:       if @texts[i]
00527:         sel ||= (@mode == 0 && i == @index)
00528:         sel ||= (@mode == 1)
00529:         buttonType = (i.even?) ? 1 : 2
00530:       end
00531:       buttonType = (2 * buttonType) + ((@smallButtons) ? 1 : 0)
00532:       button.src_rect.x = (sel) ? @buttonBitmap.width / 2 : 0
00533:       button.src_rect.y = buttonType * BUTTON_HEIGHT
00534:       button.z          = self.z + ((sel) ? 3 : 2)
00535:     end
00536:     # Draw target names onto overlay
00537:     @overlay.bitmap.clear
00538:     textpos = []
00539:     @buttons.each_with_index do |button, i|
00540:       next if !button || nil_or_empty?(@texts[i])
00541:       x = button.x - self.x + (button.src_rect.width / 2)
00542:       y = button.y - self.y + 14
00543:       textpos.push([@texts[i], x, y, :center, TEXT_BASE_COLOR, TEXT_SHADOW_COLOR])
00544:     end
00545:     pbDrawTextPositions(@overlay.bitmap, textpos)
00546:   end
00547: 
00548:   def refresh
00549:     refreshButtons
00550:   end
