00001: #===============================================================================
00002: # Day and night system
00003: #===============================================================================
00004: def pbGetTimeNow
00005:   return Time.now
00006: end
00007: 
00008: #===============================================================================
00009: #
00010: #===============================================================================
00011: module PBDayNight
00012:   HOURLY_TONES = [
00013:     Tone.new(-70, -90,  15, 55),   # Night           # Midnight
00014:     Tone.new(-70, -90,  15, 55),   # Night
00015:     Tone.new(-70, -90,  15, 55),   # Night
00016:     Tone.new(-70, -90,  15, 55),   # Night
00017:     Tone.new(-60, -70,  -5, 50),   # Night
00018:     Tone.new(-40, -50, -35, 50),   # Day/morning
00019:     Tone.new(-40, -50, -35, 50),   # Day/morning     # 6AM
00020:     Tone.new(-40, -50, -35, 50),   # Day/morning
00021:     Tone.new(-40, -50, -35, 50),   # Day/morning
00022:     Tone.new(-20, -25, -15, 20),   # Day/morning
00023:     Tone.new(  0,   0,   0,  0),   # Day
00024:     Tone.new(  0,   0,   0,  0),   # Day
00025:     Tone.new(  0,   0,   0,  0),   # Day             # Noon
00026:     Tone.new(  0,   0,   0,  0),   # Day
00027:     Tone.new(  0,   0,   0,  0),   # Day/afternoon
00028:     Tone.new(  0,   0,   0,  0),   # Day/afternoon
00029:     Tone.new(  0,   0,   0,  0),   # Day/afternoon
00030:     Tone.new(  0,   0,   0,  0),   # Day/afternoon
00031:     Tone.new( -5, -30, -20,  0),   # Day/evening     # 6PM
00032:     Tone.new(-15, -60, -10, 20),   # Day/evening
00033:     Tone.new(-15, -60, -10, 20),   # Day/evening
00034:     Tone.new(-40, -75,   5, 40),   # Night
00035:     Tone.new(-70, -90,  15, 55),   # Night
00036:     Tone.new(-70, -90,  15, 55)    # Night
00037:   ]
00038:   CACHED_TONE_LIFETIME = 30   # In seconds; recalculates overworld tone once per this time
00039:   @cachedTone = nil
00040:   @dayNightToneLastUpdate = nil
00041:   @oneOverSixty = 1 / 60.0
00042: 
00043:   # Returns true if it's day.
00044:   def self.isDay?(time = nil)
00045:     time = pbGetTimeNow if !time
00046:     return (time.hour >= 5 && time.hour < 20)
00047:   end
00048: 
00049:   # Returns true if it's night.
00050:   def self.isNight?(time = nil)
00051:     time = pbGetTimeNow if !time
00052:     return (time.hour >= 20 || time.hour < 5)
00053:   end
00054: 
00055:   # Returns true if it's morning.
00056:   def self.isMorning?(time = nil)
00057:     time = pbGetTimeNow if !time
00058:     return (time.hour >= 5 && time.hour < 10)
00059:   end
00060: 
00061:   # Returns true if it's the afternoon.
00062:   def self.isAfternoon?(time = nil)
00063:     time = pbGetTimeNow if !time
00064:     return (time.hour >= 14 && time.hour < 17)
00065:   end
00066: 
00067:   # Returns true if it's the evening.
00068:   def self.isEvening?(time = nil)
00069:     time = pbGetTimeNow if !time
00070:     return (time.hour >= 17 && time.hour < 20)
00071:   end
00072: 
00073:   # Gets a number representing the amount of daylight (0=full night, 255=full day).
00074:   def self.getShade
00075:     time = pbGetDayNightMinutes
00076:     time = (24 * 60) - time if time > (12 * 60)
00077:     return 255 * time / (12 * 60)
00078:   end
00079: 
00080:   # Gets a Tone object representing a suggested shading
00081:   # tone for the current time of day.
00082:   def self.getTone
00083:     @cachedTone = Tone.new(0, 0, 0) if !@cachedTone
00084:     return @cachedTone if !Settings::TIME_SHADING
00085:     if !@dayNightToneLastUpdate || (System.uptime - @dayNightToneLastUpdate >= CACHED_TONE_LIFETIME)
00086:       getToneInternal
00087:       @dayNightToneLastUpdate = System.uptime
00088:     end
00089:     return @cachedTone
00090:   end
00091: 
00092:   def self.pbGetDayNightMinutes
00093:     now = pbGetTimeNow   # Get the current in-game time
00094:     return (now.hour * 60) + now.min
00095:   end
00096: 
00097:   def self.getToneInternal
00098:     # Calculates the tone for the current frame, used for day/night effects
00099:     realMinutes = pbGetDayNightMinutes
00100:     hour   = realMinutes / 60
00101:     minute = realMinutes % 60
00102:     tone         = PBDayNight::HOURLY_TONES[hour]
00103:     nexthourtone = PBDayNight::HOURLY_TONES[(hour + 1) % 24]
00104:     # Calculate current tint according to current and next hour's tint and
00105:     # depending on current minute
00106:     @cachedTone.red   = ((nexthourtone.red - tone.red) * minute * @oneOverSixty) + tone.red
00107:     @cachedTone.green = ((nexthourtone.green - tone.green) * minute * @oneOverSixty) + tone.green
00108:     @cachedTone.blue  = ((nexthourtone.blue - tone.blue) * minute * @oneOverSixty) + tone.blue
00109:     @cachedTone.gray  = ((nexthourtone.gray - tone.gray) * minute * @oneOverSixty) + tone.gray
00110:   end
00111: end
00112: 
00113: #===============================================================================
00114: #
00115: #===============================================================================
00116: def pbDayNightTint(object)
00117:   return if !$scene.is_a?(Scene_Map)
00118:   if Settings::TIME_SHADING && $game_map.metadata&.outdoor_map
00119:     tone = PBDayNight.getTone
00120:     object.tone.set(tone.red, tone.green, tone.blue, tone.gray)
00121:   else
00122:     object.tone.set(0, 0, 0, 0)
00123:   end
00124: end
00125: 
00126: #===============================================================================
00127: # Days of the week
00128: #===============================================================================
00129: def pbIsWeekday(wdayVariable, *arg)
00130:   timenow = pbGetTimeNow
00131:   wday = timenow.wday
00132:   ret = false
00133:   arg.each do |wd|
00134:     ret = true if wd == wday
00135:   end
00136:   if wdayVariable > 0
00137:     $game_variables[wdayVariable] = [
00138:       _INTL("Sunday"),
00139:       _INTL("Monday"),
00140:       _INTL("Tuesday"),
00141:       _INTL("Wednesday"),
00142:       _INTL("Thursday"),
00143:       _INTL("Friday"),
00144:       _INTL("Saturday")
00145:     ][wday]
00146:     $game_map.need_refresh = true if $game_map
00147:   end
00148:   return ret
00149: end
00150: 
00151: #===============================================================================
00152: # Months
00153: #===============================================================================
00154: def pbIsMonth(monVariable, *arg)
00155:   timenow = pbGetTimeNow
00156:   thismon = timenow.mon
00157:   ret = false
00158:   arg.each do |wd|
00159:     ret = true if wd == thismon
00160:   end
00161:   if monVariable > 0
00162:     $game_variables[monVariable] = pbGetMonthName(thismon)
00163:     $game_map.need_refresh = true if $game_map
00164:   end
00165:   return ret
00166: end
00167: 
00168: def pbGetMonthName(month)
00169:   return [_INTL("January"),
00170:           _INTL("February"),
00171:           _INTL("March"),
00172:           _INTL("April"),
00173:           _INTL("May"),
00174:           _INTL("June"),
00175:           _INTL("July"),
00176:           _INTL("August"),
00177:           _INTL("September"),
00178:           _INTL("October"),
00179:           _INTL("November"),
00180:           _INTL("December")][month - 1]
00181: end
00182: 
00183: def pbGetAbbrevMonthName(month)
00184:   return [_INTL("Jan."),
00185:           _INTL("Feb."),
00186:           _INTL("Mar."),
00187:           _INTL("Apr."),
00188:           _INTL("May"),
00189:           _INTL("Jun."),
00190:           _INTL("Jul."),
00191:           _INTL("Aug."),
00192:           _INTL("Sep."),
00193:           _INTL("Oct."),
00194:           _INTL("Nov."),
00195:           _INTL("Dec.")][month - 1]
00196: end
00197: 
00198: #===============================================================================
00199: # Seasons
00200: #===============================================================================
00201: def pbGetSeason
00202:   return (pbGetTimeNow.mon - 1) % 4
00203: end
00204: 
00205: def pbIsSeason(seasonVariable, *arg)
00206:   thisseason = pbGetSeason
00207:   ret = false
00208:   arg.each do |wd|
00209:     ret = true if wd == thisseason
00210:   end
00211:   if seasonVariable > 0
00212:     $game_variables[seasonVariable] = [_INTL("Spring"),
00213:                                        _INTL("Summer"),
00214:                                        _INTL("Autumn"),
00215:                                        _INTL("Winter")][thisseason]
00216:     $game_map.need_refresh = true if $game_map
00217:   end
00218:   return ret
00219: end
00220: 
00221: def pbIsSpring; return pbIsSeason(0, 0); end # Jan, May, Sep
00222: def pbIsSummer; return pbIsSeason(0, 1); end # Feb, Jun, Oct
00223: def pbIsAutumn; return pbIsSeason(0, 2); end # Mar, Jul, Nov
00224: def pbIsFall; return pbIsAutumn; end
00225: def pbIsWinter; return pbIsSeason(0, 3); end # Apr, Aug, Dec
00226: 
00227: def pbGetSeasonName(season)
00228:   return [_INTL("Spring"),
00229:           _INTL("Summer"),
00230:           _INTL("Autumn"),
00231:           _INTL("Winter")][season]
00232: end
00233: 
00234: #===============================================================================
00235: # Moon phases and Zodiac
00236: #===============================================================================
00237: # Calculates the phase of the moon. time is in UTC.
00238: # 0 - New Moon
00239: # 1 - Waxing Crescent
00240: # 2 - First Quarter
00241: # 3 - Waxing Gibbous
00242: # 4 - Full Moon
00243: # 5 - Waning Gibbous
00244: # 6 - Last Quarter
00245: # 7 - Waning Crescent
00246: def moonphase(time = nil)
00247:   time = pbGetTimeNow if !time
00248:   transitions = [
00249:     1.8456618033125,
00250:     5.5369854099375,
00251:     9.2283090165625,
00252:     12.9196326231875,
00253:     16.6109562298125,
00254:     20.3022798364375,
00255:     23.9936034430625,
00256:     27.6849270496875
00257:   ]
00258:   yy = time.year - ((12 - time.mon) / 10.0).floor
00259:   j = (365.25 * (4712 + yy)).floor + ((((time.mon + 9) % 12) * 30.6) + 0.5).floor + time.day + 59
00260:   j -= (((yy / 100.0) + 49).floor * 0.75).floor - 38 if j > 2_299_160
00261:   j += (((time.hour * 60) + (time.min * 60)) + time.sec) / 86_400.0
00262:   v = (j - 2_451_550.1) / 29.530588853
00263:   v = ((v - v.floor) + (v < 0 ? 1 : 0))
00264:   ag = v * 29.53
00265:   transitions.length.times do |i|
00266:     return i if ag <= transitions[i]
00267:   end
00268:   return 0
00269: end
00270: 
00271: # Calculates the zodiac sign based on the given month and day:
00272: # 0 is Aries, 11 is Pisces. Month is 1 if January, and so on.
00273: def zodiac(month, day)
00274:   time = [
00275:     3, 21, 4, 19,   # Aries
00276:     4, 20, 5, 20,   # Taurus
00277:     5, 21, 6, 20,   # Gemini
00278:     6, 21, 7, 20,   # Cancer
00279:     7, 23, 8, 22,   # Leo
00280:     8, 23, 9, 22,   # Virgo
00281:     9, 23, 10, 22,  # Libra
00282:     10, 23, 11, 21, # Scorpio
00283:     11, 22, 12, 21, # Sagittarius
00284:     12, 22, 1, 19,  # Capricorn
00285:     1, 20, 2, 18,   # Aquarius
00286:     2, 19, 3, 20    # Pisces
00287:   ]
00288:   (time.length / 4).times do |i|
00289:     return i if month == time[i * 4] && day >= time[(i * 4) + 1]
00290:     return i if month == time[(i * 4) + 2] && day <= time[(i * 4) + 3]
00291:   end
00292:   return 0
00293: end
00294: 
00295: # Returns the opposite of the given zodiac sign.
00296: # 0 is Aries, 11 is Pisces.
00297: def zodiacOpposite(sign)
00298:   return (sign + 6) % 12
00299: end
00300: 
00301: # 0 is Aries, 11 is Pisces.
00302: def zodiacPartners(sign)
00303:   return [(sign + 4) % 12, (sign + 8) % 12]
00304: end
00305: 
00306: # 0 is Aries, 11 is Pisces.
00307: def zodiacComplements(sign)
00308:   return [(sign + 1) % 12, (sign + 11) % 12]
00309: end
