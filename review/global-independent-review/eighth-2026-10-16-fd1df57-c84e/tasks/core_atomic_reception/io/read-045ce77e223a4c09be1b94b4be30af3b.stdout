00348: class Battle::Move::RemoveTerrain < Battle::Move
00349:   def pbMoveFailed?(user, targets)
00350:     if @battle.field.terrain == :None
00351:       @battle.pbDisplay(_INTL("But it failed!"))
00352:       return true
00353:     end
00354:     return false
00355:   end
00356: 
00357:   def pbEffectGeneral(user)
00358:     case @battle.field.terrain
00359:     when :Electric
00360:       @battle.pbDisplay(_INTL("The electricity disappeared from the battlefield."))
00361:     when :Grassy
00362:       @battle.pbDisplay(_INTL("The grass disappeared from the battlefield."))
00363:     when :Misty
00364:       @battle.pbDisplay(_INTL("The mist disappeared from the battlefield."))
00365:     when :Psychic
00366:       @battle.pbDisplay(_INTL("The weirdness disappeared from the battlefield."))
00367:     end
00368:     @battle.field.terrain = :None
00369:   end
00370: end
00371: 
00372: #===============================================================================
00373: # Entry hazard. Lays spikes on the opposing side (max. 3 layers). (Spikes)
00374: #===============================================================================
00375: class Battle::Move::AddSpikesToFoeSide < Battle::Move
00376:   def canMagicCoat?; return true; end
00377: 
00378:   def pbMoveFailed?(user, targets)
00379:     if user.pbOpposingSide.effects[PBEffects::Spikes] >= 3
00380:       @battle.pbDisplay(_INTL("But it failed!"))
00381:       return true
