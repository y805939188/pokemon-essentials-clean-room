00244: 
00245:   #=============================================================================
00246:   # Calculated properties
00247:   #=============================================================================
00248:   def pbSpeed
00249:     return 1 if fainted?
00250:     stage = @stages[:SPEED] + STAT_STAGE_MAXIMUM
00251:     speed = @speed * STAT_STAGE_MULTIPLIERS[stage] / STAT_STAGE_DIVISORS[stage]
00252:     speedMult = 1.0
00253:     # Ability effects that alter calculated Speed
00254:     if abilityActive?
00255:       speedMult = Battle::AbilityEffects.triggerSpeedCalc(self.ability, self, speedMult)
00256:     end
00257:     # Item effects that alter calculated Speed
00258:     if itemActive?
00259:       speedMult = Battle::ItemEffects.triggerSpeedCalc(self.item, self, speedMult)
00260:     end
00261:     # Other effects
00262:     speedMult *= 2 if pbOwnSide.effects[PBEffects::Tailwind] > 0
00263:     speedMult /= 2 if pbOwnSide.effects[PBEffects::Swamp] > 0
00264:     # Paralysis
00265:     if status == :PARALYSIS && !hasActiveAbility?(:QUICKFEET)
00266:       speedMult /= (Settings::MECHANICS_GENERATION >= 7) ? 2 : 4
00267:     end
00268:     # Badge multiplier
00269:     if @battle.internalBattle && pbOwnedByPlayer? &&
00270:        @battle.pbPlayer.badge_count >= Settings::NUM_BADGES_BOOST_SPEED
00271:       speedMult *= 1.1
00272:     end
00273:     # Calculation
