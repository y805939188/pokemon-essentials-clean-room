00146: class Battle::Move::ParalyzeTarget < Battle::Move
00147:   def canMagicCoat?; return true; end
00148: 
00149:   def pbFailsAgainstTarget?(user, target, show_message)
00150:     return false if damagingMove?
00151:     return !target.pbCanParalyze?(user, show_message, self)
00152:   end
00153: 
00154:   def pbEffectAgainstTarget(user, target)
00155:     return if damagingMove?
00156:     target.pbParalyze(user)
00157:   end
00158: 
00159:   def pbAdditionalEffect(user, target)
00160:     return if target.damageState.substitute
00161:     target.pbParalyze(user) if target.pbCanParalyze?(user, false, self)
00162:   end
00163: end
00164: 
00165: #===============================================================================
00166: # Paralyzes the target. Doesn't affect target if move's type has no effect on
00167: # it. (Thunder Wave)
00168: #===============================================================================
00169: class Battle::Move::ParalyzeTargetIfNotTypeImmune < Battle::Move::ParalyzeTarget
00170:   def pbFailsAgainstTarget?(user, target, show_message)
00171:     if Effectiveness.ineffective?(target.damageState.typeMod)
00172:       @battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true))) if show_message
00173:       return true
00174:     end
00175:     return super
00176:   end
00177: end
00178: 
00179: #===============================================================================
00180: # Paralyzes the target. Accuracy perfect in rain, 50% in sunshine. Hits some
00181: # semi-invulnerable targets. (Thunder)
00182: #===============================================================================
00183: class Battle::Move::ParalyzeTargetAlwaysHitsInRainHitsTargetInSky < Battle::Move::ParalyzeTarget
00184:   def hitsFlyingTargets?; return true; end
00185: 
00186:   def pbBaseAccuracy(user, target)
00187:     case target.effectiveWeather
00188:     when :Sun, :HarshSun
00189:       return 50
00190:     when :Rain, :HeavyRain
00191:       return 0
00192:     end
00193:     return super
00194:   end
00195: end
00196: 
00197: #===============================================================================
00198: # Paralyzes the target. May cause the target to flinch. (Thunder Fang)
