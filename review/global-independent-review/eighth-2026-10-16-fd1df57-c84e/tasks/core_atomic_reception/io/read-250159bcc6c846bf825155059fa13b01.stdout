01232:   def pbChooseMoveToForget(move_to_learn)
01233:     new_move = (move_to_learn) ? Pokemon::Move.new(move_to_learn) : nil
01234:     selmove = 0
01235:     maxmove = (new_move) ? Pokemon::MAX_MOVES : Pokemon::MAX_MOVES - 1
01236:     loop do
01237:       Graphics.update
01238:       Input.update
01239:       pbUpdate
01240:       if Input.trigger?(Input::BACK)
01241:         selmove = Pokemon::MAX_MOVES
01242:         pbPlayCloseMenuSE if new_move
01243:         break
01244:       elsif Input.trigger?(Input::USE)
01245:         pbPlayDecisionSE
01246:         break
01247:       elsif Input.trigger?(Input::UP)
01248:         selmove -= 1
01249:         selmove = maxmove if selmove < 0
01250:         if selmove < Pokemon::MAX_MOVES && selmove >= @pokemon.numMoves
01251:           selmove = @pokemon.numMoves - 1
01252:         end
01253:         @sprites["movesel"].index = selmove
01254:         selected_move = (selmove == Pokemon::MAX_MOVES) ? new_move : @pokemon.moves[selmove]
01255:         drawSelectedMove(new_move, selected_move)
01256:       elsif Input.trigger?(Input::DOWN)
01257:         selmove += 1
01258:         selmove = 0 if selmove > maxmove
01259:         if selmove < Pokemon::MAX_MOVES && selmove >= @pokemon.numMoves
01260:           selmove = (new_move) ? maxmove : 0
01261:         end
01262:         @sprites["movesel"].index = selmove
01263:         selected_move = (selmove == Pokemon::MAX_MOVES) ? new_move : @pokemon.moves[selmove]
01264:         drawSelectedMove(new_move, selected_move)
01265:       end
01266:     end
01267:     return (selmove == Pokemon::MAX_MOVES) ? -1 : selmove
01268:   end
01269: 
01270:   def pbScene
01271:     @pokemon.play_cry
01272:     loop do
01273:       Graphics.update
01274:       Input.update
01275:       pbUpdate
01276:       dorefresh = false
01277:       if Input.trigger?(Input::ACTION)
01278:         pbSEStop
01279:         @pokemon.play_cry
01280:       elsif Input.trigger?(Input::BACK)
01281:         pbPlayCloseMenuSE
01282:         break
01283:       elsif Input.trigger?(Input::USE)
01284:         if @page == 4
01285:           pbPlayDecisionSE
