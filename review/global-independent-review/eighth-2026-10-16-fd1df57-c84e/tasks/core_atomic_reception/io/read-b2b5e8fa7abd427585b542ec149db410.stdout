00141:   def pbPartyScreen(idxBattler, canCancel = false, mode = 0)
00142:     # Fade out and hide all sprites
00143:     visibleSprites = pbFadeOutAndHide(@sprites)
00144:     # Get player's party
00145:     partyPos = @battle.pbPartyOrder(idxBattler)
00146:     partyStart, _partyEnd = @battle.pbTeamIndexRangeFromBattlerIndex(idxBattler)
00147:     modParty = @battle.pbPlayerDisplayParty(idxBattler)
00148:     # Start party screen
00149:     scene = PokemonParty_Scene.new
00150:     switchScreen = PokemonPartyScreen.new(scene, modParty)
00151:     msg = _INTL("Choose a Pokémon.")
00152:     msg = _INTL("Send which Pokémon to Boxes?") if mode == 1
00153:     switchScreen.pbStartScene(msg, @battle.pbNumPositions(0, 0))
00154:     # Loop while in party screen
00155:     loop do
00156:       # Select a Pokémon
00157:       scene.pbSetHelpText(msg)
00158:       idxParty = switchScreen.pbChoosePokemon
00159:       if idxParty < 0
00160:         next if !canCancel
00161:         break
00162:       end
00163:       # Choose a command for the selected Pokémon
00164:       cmdSwitch  = -1
00165:       cmdBoxes   = -1
00166:       cmdSummary = -1
00167:       commands = []
00168:       commands[cmdSwitch  = commands.length] = _INTL("Switch In") if mode == 0 && modParty[idxParty].able? &&
00169:                                                                      (@battle.canSwitch || !canCancel)
00170:       commands[cmdBoxes   = commands.length] = _INTL("Send to Boxes") if mode == 1
00171:       commands[cmdSummary = commands.length] = _INTL("Summary")
00172:       commands[commands.length]              = _INTL("Cancel")
00173:       command = scene.pbShowCommands(_INTL("Do what with {1}?", modParty[idxParty].name), commands)
00174:       if (cmdSwitch >= 0 && command == cmdSwitch) ||   # Switch In
00175:          (cmdBoxes >= 0 && command == cmdBoxes)        # Send to Boxes
00176:         idxPartyRet = -1
00177:         partyPos.each_with_index do |pos, i|
00178:           next if pos != idxParty + partyStart
00179:           idxPartyRet = i
00180:           break
00181:         end
00182:         break if yield idxPartyRet, switchScreen
00183:       elsif cmdSummary >= 0 && command == cmdSummary   # Summary
00184:         scene.pbSummary(idxParty, true)
00185:       end
00186:     end
00187:     # Close party screen
00188:     switchScreen.pbEndScene
00189:     # Fade back into battle screen
00190:     pbFadeInAndShow(@sprites, visibleSprites)
