00004: def pbLoadTrainer(tr_type, tr_name, tr_version = 0)
00005:   tr_type_data = GameData::TrainerType.try_get(tr_type)
00006:   raise _INTL("Trainer type {1} does not exist.", tr_type) if !tr_type_data
00007:   tr_type = tr_type_data.id
00008:   trainer_data = GameData::Trainer.try_get(tr_type, tr_name, tr_version)
00009:   return (trainer_data) ? trainer_data.to_trainer : nil
00010: end
