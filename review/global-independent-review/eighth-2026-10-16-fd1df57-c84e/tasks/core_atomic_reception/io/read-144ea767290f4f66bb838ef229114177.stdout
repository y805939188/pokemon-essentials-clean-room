00368:     return if !itemActive?
00369:     if Battle::ItemEffects.triggerTerrainStatBoost(self.item, self, @battle)
00370:       pbHeldItemTriggered(self.item)
00371:     end
00372:   end
00373: 
00374:   # Used for Adrenaline Orb. Called when Intimidate is triggered (even if
00375:   # Intimidate has no effect on the Pokémon).
00376:   def pbItemOnIntimidatedCheck
00377:     return if !itemActive?
00378:     if Battle::ItemEffects.triggerOnIntimidated(self.item, self, @battle)
00379:       pbHeldItemTriggered(self.item)
00380:     end
00381:   end
00382: 
00383:   # Used for Eject Pack. Returns whether self has switched out.
00384:   def pbItemOnStatDropped(move_user = nil)
00385:     return false if !@statsDropped
00386:     return false if !itemActive?
00387:     return Battle::ItemEffects.triggerOnStatLoss(self.item, self, move_user, @battle)
00388:   end
00389: 
00390:   def pbItemsOnUnnerveEnding
00391:     @battle.pbPriority(true).each do |b|
00392:       b.pbHeldItemTriggerCheck if b.item&.is_berry?
00393:     end
00394:   end
00395: 
00396:   #=============================================================================
00397:   # Item effects
00398:   #=============================================================================
00399:   def pbConfusionBerry(item_to_use, forced, confuse_stat, confuse_msg)
00400:     return false if !forced && !canHeal?
00401:     return false if !forced && !canConsumePinchBerry?(Settings::MECHANICS_GENERATION >= 7)
00402:     used_item_name = GameData::Item.get(item_to_use).name
