02820: Battle::AbilityEffects::OnSwitchIn.add(:ICEFACE,
02821:   proc { |ability, battler, battle, switch_in|
02822:     next if !battler.isSpecies?(:EISCUE) || battler.form != 1
02823:     next if battler.effectiveWeather != :Hail
02824:     battle.pbShowAbilitySplash(battler)
02825:     if !Battle::Scene::USE_ABILITY_SPLASH
02826:       battle.pbDisplay(_INTL("{1}'s {2} activated!", battler.pbThis, battler.abilityName))
02827:     end
02828:     battler.pbChangeForm(0, _INTL("{1} transformed!", battler.pbThis))
02829:     battle.pbHideAbilitySplash(battler)
02830:   }
02831: )
02832: 
02833: Battle::AbilityEffects::OnSwitchIn.add(:IMPOSTER,
02834:   proc { |ability, battler, battle, switch_in|
02835:     next if !switch_in || battler.effects[PBEffects::Transform]
02836:     choice = battler.pbDirectOpposing
02837:     next if choice.fainted?
02838:     next if choice.effects[PBEffects::Transform] ||
02839:             choice.effects[PBEffects::Illusion] ||
02840:             choice.effects[PBEffects::Substitute] > 0 ||
02841:             choice.effects[PBEffects::SkyDrop] >= 0 ||
02842:             choice.semiInvulnerable?
02843:     battle.pbShowAbilitySplash(battler, true)
02844:     battle.pbHideAbilitySplash(battler)
02845:     battle.pbAnimation(:TRANSFORM, battler, choice)
02846:     battle.scene.pbChangePokemon(battler, choice.pokemon)
02847:     battler.pbTransform(choice)
02848:   }
02849: )
02850: 
02851: Battle::AbilityEffects::OnSwitchIn.add(:INTIMIDATE,
02852:   proc { |ability, battler, battle, switch_in|
02853:     battle.pbShowAbilitySplash(battler)
02854:     battle.allOtherSideBattlers(battler.index).each do |b|
02855:       next if !b.near?(battler)
02856:       check_item = true
02857:       if b.hasActiveAbility?(:CONTRARY)
02858:         check_item = false if b.statStageAtMax?(:ATTACK)
02859:       elsif b.statStageAtMin?(:ATTACK)
02860:         check_item = false
02861:       end
02862:       check_ability = b.pbLowerAttackStatStageIntimidate(battler)
02863:       b.pbAbilitiesOnIntimidated if check_ability
02864:       b.pbItemOnIntimidatedCheck if check_item
02865:     end
02866:     battle.pbHideAbilitySplash(battler)
02867:   }
02868: )
02869: 
02870: Battle::AbilityEffects::OnSwitchIn.add(:INTREPIDSWORD,
02871:   proc { |ability, battler, battle, switch_in|
02872:     battler.pbRaiseStatStageByAbility(:ATTACK, 1, battler)
02873:   }
02874: )
02875: 
