02900: Battle::AbilityEffects::OnSwitchIn.add(:NEUTRALIZINGGAS,
02901:   proc { |ability, battler, battle, switch_in|
02902:     battle.pbShowAbilitySplash(battler, true)
02903:     battle.pbHideAbilitySplash(battler)
02904:     battle.pbDisplay(_INTL("Neutralizing gas filled the area!"))
02905:     battle.allBattlers.each do |b|
02906:       # Slow Start - end all turn counts
02907:       b.effects[PBEffects::SlowStart] = 0
02908:       # Truant - let b move on its first turn after Neutralizing Gas disappears
02909:       b.effects[PBEffects::Truant] = false
02910:       # Gorilla Tactics - end choice lock
02911:       if !b.hasActiveItem?([:CHOICEBAND, :CHOICESPECS, :CHOICESCARF])
02912:         b.effects[PBEffects::ChoiceBand] = nil
02913:       end
02914:       # Illusion - end illusions
02915:       if b.effects[PBEffects::Illusion]
02916:         b.effects[PBEffects::Illusion] = nil
02917:         if !b.effects[PBEffects::Transform]
02918:           battle.scene.pbChangePokemon(b, b.pokemon)
02919:           battle.pbDisplay(_INTL("{1}'s {2} wore off!", b.pbThis, b.abilityName))
02920:           battle.pbSetSeen(b)
02921:         end
02922:       end
02923:     end
02924:     # Trigger items upon Unnerve being negated
02925:     battler.ability_id = nil   # Allows checking if Unnerve was active before
02926:     had_unnerve = battle.pbCheckGlobalAbility([:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH])
02927:     battler.ability_id = :NEUTRALIZINGGAS
02928:     if had_unnerve && !battle.pbCheckGlobalAbility([:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH])
02929:       battle.allBattlers.each { |b| b.pbItemsOnUnnerveEnding }
02930:     end
02931:   }
02932: )
02933: 
02934: Battle::AbilityEffects::OnSwitchIn.add(:PASTELVEIL,
02935:   proc { |ability, battler, battle, switch_in|
02936:     next if battler.allAllies.none? { |b| b.status == :POISON }
02937:     battle.pbShowAbilitySplash(battler)
02938:     battler.allAllies.each do |b|
02939:       next if b.status != :POISON
02940:       b.pbCureStatus(Battle::Scene::USE_ABILITY_SPLASH)
02941:       if !Battle::Scene::USE_ABILITY_SPLASH
02942:         battle.pbDisplay(_INTL("{1}'s {2} cured {3}'s poisoning!",
02943:            battler.pbThis, battler.abilityName, b.pbThis(true)))
02944:       end
02945:     end
02946:     battle.pbHideAbilitySplash(battler)
02947:   }
02948: )
