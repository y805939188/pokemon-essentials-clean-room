02738: Battle::AbilityEffects::OnSwitchIn.add(:FOREWARN,
02739:   proc { |ability, battler, battle, switch_in|
02740:     next if !battler.pbOwnedByPlayer?
02741:     highestPower = 0
02742:     forewarnMoves = []
02743:     battle.allOtherSideBattlers(battler.index).each do |b|
02744:       b.eachMove do |m|
02745:         power = m.power
02746:         power = 160 if ["OHKO", "OHKOIce", "OHKOHitsUndergroundTarget"].include?(m.function_code)
02747:         power = 150 if ["PowerHigherWithUserHP"].include?(m.function_code)    # Eruption
02748:         # Counter, Mirror Coat, Metal Burst
02749:         power = 120 if ["CounterPhysicalDamage",
02750:                         "CounterSpecialDamage",
02751:                         "CounterDamagePlusHalf"].include?(m.function_code)
02752:         # Sonic Boom, Dragon Rage, Night Shade, Endeavor, Psywave,
02753:         # Return, Frustration, Crush Grip, Gyro Ball, Hidden Power,
02754:         # Natural Gift, Trump Card, Flail, Grass Knot
02755:         power = 80 if ["FixedDamage20",
02756:                        "FixedDamage40",
02757:                        "FixedDamageUserLevel",
02758:                        "LowerTargetHPToUserHP",
02759:                        "FixedDamageUserLevelRandom",
02760:                        "PowerHigherWithUserHappiness",
02761:                        "PowerLowerWithUserHappiness",
02762:                        "PowerHigherWithUserHP",
02763:                        "PowerHigherWithTargetFasterThanUser",
02764:                        "TypeAndPowerDependOnUserBerry",
02765:                        "PowerHigherWithLessPP",
02766:                        "PowerLowerWithUserHP",
02767:                        "PowerHigherWithTargetWeight"].include?(m.function_code)
02768:         power = 80 if Settings::MECHANICS_GENERATION <= 5 && m.function_code == "TypeDependsOnUserIVs"
02769:         next if power < highestPower
02770:         forewarnMoves = [] if power > highestPower
02771:         forewarnMoves.push(m.name)
02772:         highestPower = power
02773:       end
02774:     end
02775:     if forewarnMoves.length > 0
02776:       battle.pbShowAbilitySplash(battler)
02777:       forewarnMoveName = forewarnMoves[battle.pbRandom(forewarnMoves.length)]
02778:       if Battle::Scene::USE_ABILITY_SPLASH
02779:         battle.pbDisplay(_INTL("{1} was alerted to {2}!",
02780:           battler.pbThis, forewarnMoveName))
02781:       else
02782:         battle.pbDisplay(_INTL("{1}'s Forewarn alerted it to {2}!",
02783:           battler.pbThis, forewarnMoveName))
02784:       end
02785:       battle.pbHideAbilitySplash(battler)
02786:     end
02787:   }
02788: )
02789: 
02790: Battle::AbilityEffects::OnSwitchIn.add(:FRISK,
02791:   proc { |ability, battler, battle, switch_in|
02792:     next if !battler.pbOwnedByPlayer?
02793:     foes = battle.allOtherSideBattlers(battler.index).select { |b| b.item }
02794:     if foes.length > 0
02795:       battle.pbShowAbilitySplash(battler)
02796:       if Settings::MECHANICS_GENERATION >= 6
02797:         foes.each do |b|
02798:           battle.pbDisplay(_INTL("{1} frisked {2} and found its {3}!",
02799:              battler.pbThis, b.pbThis(true), b.itemName))
02800:         end
02801:       else
02802:         foe = foes[battle.pbRandom(foes.length)]
02803:         battle.pbDisplay(_INTL("{1} frisked the foe and found one {2}!",
02804:            battler.pbThis, foe.itemName))
02805:       end
02806:       battle.pbHideAbilitySplash(battler)
02807:     end
02808:   }
02809: )
02810: 
