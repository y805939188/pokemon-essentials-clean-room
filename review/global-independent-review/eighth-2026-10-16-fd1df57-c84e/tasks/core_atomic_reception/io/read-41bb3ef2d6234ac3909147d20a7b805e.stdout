00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: class SafariState
00005:   attr_accessor :ballcount
00006:   attr_accessor :captures
00007:   attr_accessor :decision
00008:   attr_accessor :steps
00009: 
00010:   def initialize
00011:     @start      = nil
00012:     @ballcount  = 0
00013:     @captures   = 0
00014:     @inProgress = false
00015:     @steps      = 0
00016:     @decision   = 0
00017:   end
00018: 
00019:   def pbReceptionMap
00020:     return @inProgress ? @start[0] : 0
00021:   end
00022: 
00023:   def inProgress?
00024:     return @inProgress
00025:   end
00026: 
00027:   def pbGoToStart
00028:     if $scene.is_a?(Scene_Map)
00029:       pbFadeOutIn do
00030:         $game_temp.player_transferring   = true
00031:         $game_temp.transition_processing = true
00032:         $game_temp.player_new_map_id    = @start[0]
00033:         $game_temp.player_new_x         = @start[1]
00034:         $game_temp.player_new_y         = @start[2]
00035:         $game_temp.player_new_direction = 2
00036:         pbDismountBike
00037:         $scene.transfer_player
00038:       end
00039:     end
00040:   end
00041: 
00042:   def pbStart(ballcount)
00043:     @start      = [$game_map.map_id, $game_player.x, $game_player.y, $game_player.direction]
00044:     @ballcount  = ballcount
00045:     @inProgress = true
00046:     @steps      = Settings::SAFARI_STEPS
00047:   end
00048: 
00049:   def pbEnd
00050:     @start      = nil
00051:     @ballcount  = 0
00052:     @captures   = 0
00053:     @inProgress = false
00054:     @steps      = 0
00055:     @decision   = 0
00056:     $game_map.need_refresh = true
00057:   end
00058: end
00059: 
00060: #===============================================================================
00061: #
00062: #===============================================================================
00063: def pbInSafari?
00064:   if pbSafariState.inProgress?
00065:     # Reception map is handled separately from safari map since the reception
00066:     # map can be outdoors, with its own grassy patches.
00067:     reception = pbSafariState.pbReceptionMap
00068:     return true if $game_map.map_id == reception
00069:     return true if $game_map.metadata&.safari_map
00070:   end
00071:   return false
00072: end
00073: 
00074: def pbSafariState
00075:   $PokemonGlobal.safariState = SafariState.new if !$PokemonGlobal.safariState
00076:   return $PokemonGlobal.safariState
00077: end
00078: 
00079: #===============================================================================
