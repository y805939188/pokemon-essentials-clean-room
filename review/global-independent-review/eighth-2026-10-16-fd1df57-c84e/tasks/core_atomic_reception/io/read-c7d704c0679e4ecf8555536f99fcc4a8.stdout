00001: #===============================================================================
00002: # This section was created solely for you to put various bits of code that
00003: # modify various wild Pokémon and trainers immediately prior to battling them.
00004: # Be sure that any code you use here ONLY applies to the Pokémon/trainers you
00005: # want it to apply to!
00006: #===============================================================================
00007: 
00008: # Make all wild Pokémon shiny while a certain Switch is ON (see Settings).
00009: EventHandlers.add(:on_wild_pokemon_created, :make_shiny_switch,
00010:   proc { |pkmn|
00011:     pkmn.shiny = true if $game_switches[Settings::SHINY_WILD_POKEMON_SWITCH]
00012:   }
00013: )
00014: 
00015: # In the Safari Zone and Bug-Catching Contests, wild Pokémon reroll their IVs up
00016: # to 4 times if they don't have a perfect IV.
00017: EventHandlers.add(:on_wild_pokemon_created, :reroll_ivs_in_safari_and_bug_contest,
00018:   proc { |pkmn|
00019:     next if !pbInSafari? && !pbInBugContest?
00020:     rerolled = false
00021:     4.times do
00022:       break if pkmn.iv.any? { |_stat, val| val == Pokemon::IV_STAT_LIMIT }
00023:       rerolled = true
00024:       GameData::Stat.each_main do |s|
00025:         pkmn.iv[s.id] = rand(Pokemon::IV_STAT_LIMIT + 1)
00026:       end
00027:     end
00028:     pkmn.calc_stats if rerolled
00029:   }
00030: )
00031: 
00032: # In Gen 6 and later, Legendary/Mythical/Ultra Beast Pokémon are guaranteed to
00033: # have at least 3 perfect IVs.
00034: EventHandlers.add(:on_wild_pokemon_created, :some_perfect_ivs_for_legendaries,
00035:   proc { |pkmn|
00036:     next if !Settings::LEGENDARIES_HAVE_SOME_PERFECT_IVS
00037:     data = pkmn.species_data
00038:     next if !data.has_flag?("Legendary") && !data.has_flag?("Mythical") && !data.has_flag?("UltraBeast")
00039:     stats = []
00040:     GameData::Stat.each_main { |s| stats.push(s.id) }
00041:     perfect_stats = stats.sample(3)
00042:     perfect_stats.each { |s| pkmn.iv[s] = Pokemon::IV_STAT_LIMIT }
00043:     pkmn.calc_stats
00044:   }
00045: )
00046: 
00047: # Used in the random dungeon map. Makes the levels of all wild Pokémon in that
00048: # map depend on the levels of Pokémon in the player's party.
00049: # This is a simple method, and can/should be modified to account for evolutions
00050: # and other such details.  Of course, you don't HAVE to use this code.
00051: EventHandlers.add(:on_wild_pokemon_created, :level_depends_on_party,
00052:   proc { |pkmn|
00053:     next if !$game_map.metadata&.has_flag?("ScaleWildEncounterLevels")
00054:     new_level = pbBalancedLevel($player.party) - 4 + rand(5)   # For variety
00055:     new_level = new_level.clamp(1, GameData::GrowthRate.max_level)
00056:     pkmn.level = new_level
00057:     pkmn.calc_stats
00058:     pkmn.reset_moves
00059:   }
00060: )
00061: 
