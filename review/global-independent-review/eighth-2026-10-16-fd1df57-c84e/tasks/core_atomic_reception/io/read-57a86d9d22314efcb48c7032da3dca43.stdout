01934:     itemName = GameData::Item.get(item).name
01935:     battle.pbCommonAnimation("UseItem", battler)
01936:     next battler.pbRaiseStatStageByCause(:SPEED, 1, battler, itemName)
01937:   }
01938: )
01939: 
01940: #===============================================================================
01941: # CertainEscapeFromBattle handlers
01942: #===============================================================================
01943: 
01944: Battle::ItemEffects::CertainEscapeFromBattle.add(:SMOKEBALL,
01945:   proc { |item, battler|
01946:     next true
01947:   }
01948: )
