00176:   def pbAttackPhase
00177:     @scene.pbBeginAttackPhase
00178:     # Reset certain effects
00179:     @battlers.each_with_index do |b, i|
00180:       next if !b
00181:       b.turnCount += 1 if !b.fainted?
00182:       @successStates[i].clear
00183:       if @choices[i][0] != :UseMove && @choices[i][0] != :Shift && @choices[i][0] != :SwitchOut
00184:         b.effects[PBEffects::DestinyBond] = false
00185:         b.effects[PBEffects::Grudge]      = false
00186:       end
00187:       b.effects[PBEffects::Rage] = false if !pbChoseMoveFunctionCode?(i, "StartRaiseUserAtk1WhenDamaged")
00188:     end
00189:     # Calculate move order for this round
00190:     pbCalculatePriority(true)
00191:     PBDebug.log("")
00192:     # Perform actions
00193:     pbAttackPhasePriorityChangeMessages
00194:     pbAttackPhaseCall
00195:     pbAttackPhaseSwitch
00196:     return if @decision > 0
00197:     pbAttackPhaseItems
00198:     return if @decision > 0
00199:     pbAttackPhaseMegaEvolution
00200:     pbAttackPhaseMoves
00201:   end
00202: end
