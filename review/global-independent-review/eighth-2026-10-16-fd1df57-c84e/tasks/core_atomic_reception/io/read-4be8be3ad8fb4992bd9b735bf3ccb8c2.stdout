00170:   def pbStartBattleSendOut(sendOuts)
00171:     # "Want to battle" messages
00172:     if wildBattle?
00173:       foeParty = pbParty(1)
00174:       case foeParty.length
00175:       when 1
00176:         pbDisplayPaused(_INTL("Oh! A wild {1} appeared!", foeParty[0].name))
00177:       when 2
00178:         pbDisplayPaused(_INTL("Oh! A wild {1} and {2} appeared!", foeParty[0].name,
00179:                               foeParty[1].name))
00180:       when 3
00181:         pbDisplayPaused(_INTL("Oh! A wild {1}, {2} and {3} appeared!", foeParty[0].name,
00182:                               foeParty[1].name, foeParty[2].name))
00183:       end
00184:     else   # Trainer battle
00185:       case @opponent.length
00186:       when 1
00187:         pbDisplayPaused(_INTL("You are challenged by {1}!", @opponent[0].full_name))
00188:       when 2
00189:         pbDisplayPaused(_INTL("You are challenged by {1} and {2}!", @opponent[0].full_name,
00190:                               @opponent[1].full_name))
00191:       when 3
00192:         pbDisplayPaused(_INTL("You are challenged by {1}, {2} and {3}!",
00193:                               @opponent[0].full_name, @opponent[1].full_name, @opponent[2].full_name))
00194:       end
00195:     end
00196:     # Send out Pokémon (opposing trainers first)
00197:     [1, 0].each do |side|
00198:       next if side == 1 && wildBattle?
00199:       msg = ""
00200:       toSendOut = []
00201:       trainers = (side == 0) ? @player : @opponent
00202:       # Opposing trainers and partner trainers's messages about sending out Pokémon
00203:       trainers.each_with_index do |t, i|
00204:         next if side == 0 && i == 0   # The player's message is shown last
00205:         msg += "\n" if msg.length > 0
00206:         sent = sendOuts[side][i]
00207:         case sent.length
00208:         when 1
00209:           msg += _INTL("{1} sent out {2}!", t.full_name, @battlers[sent[0]].name)
00210:         when 2
00211:           msg += _INTL("{1} sent out {2} and {3}!", t.full_name,
00212:                        @battlers[sent[0]].name, @battlers[sent[1]].name)
00213:         when 3
00214:           msg += _INTL("{1} sent out {2}, {3} and {4}!", t.full_name,
00215:                        @battlers[sent[0]].name, @battlers[sent[1]].name, @battlers[sent[2]].name)
00216:         end
00217:         toSendOut.concat(sent)
00218:       end
00219:       # The player's message about sending out Pokémon
00220:       if side == 0
00221:         msg += "\n" if msg.length > 0
00222:         sent = sendOuts[side][0]
00223:         case sent.length
00224:         when 1
00225:           msg += _INTL("Go! {1}!", @battlers[sent[0]].name)
00226:         when 2
00227:           msg += _INTL("Go! {1} and {2}!", @battlers[sent[0]].name, @battlers[sent[1]].name)
00228:         when 3
00229:           msg += _INTL("Go! {1}, {2} and {3}!", @battlers[sent[0]].name,
00230:                        @battlers[sent[1]].name, @battlers[sent[2]].name)
00231:         end
00232:         toSendOut.concat(sent)
00233:       end
00234:       pbDisplayBrief(msg) if msg.length > 0
00235:       # The actual sending out of Pokémon
00236:       animSendOuts = []
00237:       toSendOut.each do |idxBattler|
00238:         animSendOuts.push([idxBattler, @battlers[idxBattler].pokemon])
00239:       end
00240:       pbSendOut(animSendOuts, true)
00241:     end
00242:   end
00243: 
00244:   #=============================================================================
00245:   # Start a battle
00246:   #=============================================================================
00247:   def pbStartBattle
00248:     PBDebug.log("")
00249:     PBDebug.log("================================================================")
00250:     PBDebug.log("")
00251:     logMsg = "[Started battle] "
00252:     if @sideSizes[0] == 1 && @sideSizes[1] == 1
00253:       logMsg += "Single "
00254:     elsif @sideSizes[0] == 2 && @sideSizes[1] == 2
00255:       logMsg += "Double "
00256:     elsif @sideSizes[0] == 3 && @sideSizes[1] == 3
00257:       logMsg += "Triple "
00258:     else
00259:       logMsg += "#{@sideSizes[0]}v#{@sideSizes[1]} "
00260:     end
00261:     logMsg += "wild " if wildBattle?
00262:     logMsg += "trainer " if trainerBattle?
00263:     logMsg += "battle (#{@player.length} trainer(s) vs. "
00264:     logMsg += "#{pbParty(1).length} wild Pokémon)" if wildBattle?
00265:     logMsg += "#{@opponent.length} trainer(s))" if trainerBattle?
00266:     PBDebug.log(logMsg)
00267:     pbEnsureParticipants
00268:     pbParty(0).each { |pkmn| @peer.pbOnStartingBattle(self, pkmn, wildBattle?) if pkmn }
00269:     pbParty(1).each { |pkmn| @peer.pbOnStartingBattle(self, pkmn, wildBattle?) if pkmn }
00270:     begin
00271:       pbStartBattleCore
00272:     rescue BattleAbortedException
00273:       @decision = 0
00274:       @scene.pbEndBattle(@decision)
00275:     end
00276:     return @decision
00277:   end
00278: 
00279:   def pbStartBattleCore
00280:     # Set up the battlers on each side
00281:     sendOuts = pbSetUpSides
00282:     @battleAI.create_ai_objects
00283:     # Create all the sprites and play the battle intro animation
00284:     @scene.pbStartBattle(self)
00285:     # Show trainers on both sides sending out Pokémon
00286:     pbStartBattleSendOut(sendOuts)
00287:     # Weather announcement
00288:     weather_data = GameData::BattleWeather.try_get(@field.weather)
00289:     pbCommonAnimation(weather_data.animation) if weather_data
00290:     case @field.weather
00291:     when :Sun         then pbDisplay(_INTL("The sunlight is strong."))
00292:     when :Rain        then pbDisplay(_INTL("It is raining."))
00293:     when :Sandstorm   then pbDisplay(_INTL("A sandstorm is raging."))
00294:     when :Hail        then pbDisplay(_INTL("Hail is falling."))
00295:     when :HarshSun    then pbDisplay(_INTL("The sunlight is extremely harsh."))
00296:     when :HeavyRain   then pbDisplay(_INTL("It is raining heavily."))
00297:     when :StrongWinds then pbDisplay(_INTL("The wind is strong."))
00298:     when :ShadowSky   then pbDisplay(_INTL("The sky is shadowy."))
00299:     end
00300:     # Terrain announcement
00301:     terrain_data = GameData::BattleTerrain.try_get(@field.terrain)
00302:     pbCommonAnimation(terrain_data.animation) if terrain_data
00303:     case @field.terrain
00304:     when :Electric
00305:       pbDisplay(_INTL("An electric current runs across the battlefield!"))
00306:     when :Grassy
00307:       pbDisplay(_INTL("Grass is covering the battlefield!"))
00308:     when :Misty
00309:       pbDisplay(_INTL("Mist swirls about the battlefield!"))
00310:     when :Psychic
00311:       pbDisplay(_INTL("The battlefield is weird!"))
00312:     end
00313:     # Abilities upon entering battle
00314:     pbOnAllBattlersEnteringBattle
00315:     # Main battle loop
00316:     pbBattleLoop
00317:   end
00318: 
00319:   #=============================================================================
