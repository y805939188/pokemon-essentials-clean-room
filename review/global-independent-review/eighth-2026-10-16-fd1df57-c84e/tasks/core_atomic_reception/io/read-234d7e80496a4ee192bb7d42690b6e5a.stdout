00114:   attr_reader :status
00115: 
00116:   def status=(value)
00117:     @effects[PBEffects::Truant] = false if @status == :SLEEP && value != :SLEEP
00118:     @effects[PBEffects::Toxic]  = 0 if value != :POISON || self.statusCount == 0
00119:     @status = value
00120:     @pokemon.status = value if @pokemon
00121:     self.statusCount = 0 if value != :POISON && value != :SLEEP
00122:     @battle.scene.pbRefreshOne(@index)
00123:   end
