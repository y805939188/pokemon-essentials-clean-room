00066:   def pbInitPokemon(pkmn, idxParty)
00067:     raise _INTL("An egg can't be an active Pokémon.") if pkmn.egg?
00068:     @name         = pkmn.name
00069:     @species      = pkmn.species
00070:     @form         = pkmn.form
00071:     @level        = pkmn.level
00072:     @hp           = pkmn.hp
00073:     @totalhp      = pkmn.totalhp
00074:     @types        = pkmn.types
00075:     @ability_id   = pkmn.ability_id
00076:     @item_id      = pkmn.item_id
00077:     @attack       = pkmn.attack
00078:     @defense      = pkmn.defense
00079:     @spatk        = pkmn.spatk
00080:     @spdef        = pkmn.spdef
00081:     @speed        = pkmn.speed
00082:     @status       = pkmn.status
00083:     @statusCount  = pkmn.statusCount
00084:     @pokemon      = pkmn
00085:     @pokemonIndex = idxParty
00086:     @participants = []   # Participants earn Exp. if this battler is defeated
00087:     @moves        = []
00088:     pkmn.moves.each_with_index do |m, i|
00089:       @moves[i] = Battle::Move.from_pokemon_move(@battle, m)
00090:     end
00091:   end
00092: 
00093:   def pbInitEffects(batonPass)
00094:     if batonPass
00095:       # These effects are passed on if Baton Pass is used, but they need to be
00096:       # reapplied
00097:       @effects[PBEffects::LaserFocus] = (@effects[PBEffects::LaserFocus] > 0) ? 2 : 0
00098:       @effects[PBEffects::LockOn]     = (@effects[PBEffects::LockOn] > 0) ? 2 : 0
00099:       if @effects[PBEffects::PowerTrick]
00100:         @attack, @defense = @defense, @attack
00101:       end
00102:       # These effects are passed on if Baton Pass is used, but they need to be
00103:       # cancelled in certain circumstances anyway
00104:       @effects[PBEffects::Telekinesis] = 0 if isSpecies?(:GENGAR) && mega?
00105:       @effects[PBEffects::GastroAcid]  = false if unstoppableAbility?
00106:     else
00107:       # These effects are passed on if Baton Pass is used
00108:       GameData::Stat.each_battle { |stat| @stages[stat.id] = 0 }
00109:       @effects[PBEffects::AquaRing]          = false
00110:       @effects[PBEffects::Confusion]         = 0
00111:       @effects[PBEffects::Curse]             = false
00112:       @effects[PBEffects::Embargo]           = 0
00113:       @effects[PBEffects::FocusEnergy]       = 0
00114:       @effects[PBEffects::GastroAcid]        = false
00115:       @effects[PBEffects::HealBlock]         = 0
00116:       @effects[PBEffects::Ingrain]           = false
00117:       @effects[PBEffects::LaserFocus]        = 0
00118:       @effects[PBEffects::LeechSeed]         = -1
00119:       @effects[PBEffects::LockOn]            = 0
00120:       @effects[PBEffects::LockOnPos]         = -1
00121:       @effects[PBEffects::MagnetRise]        = 0
00122:       @effects[PBEffects::PerishSong]        = 0
00123:       @effects[PBEffects::PerishSongUser]    = -1
00124:       @effects[PBEffects::PowerTrick]        = false
00125:       @effects[PBEffects::Substitute]        = 0
00126:       @effects[PBEffects::Telekinesis]       = 0
00127:     end
00128:     @fainted                 = (@hp == 0)
00129:     @lastAttacker            = []
00130:     @lastFoeAttacker         = []
00131:     @lastHPLost              = 0
00132:     @lastHPLostFromFoe       = 0
00133:     @droppedBelowHalfHP      = false
00134:     @statsDropped            = false
00135:     @tookMoveDamageThisRound = false
00136:     @tookDamageThisRound     = false
00137:     @tookPhysicalHit         = false
00138:     @statsRaisedThisRound    = false
00139:     @statsLoweredThisRound   = false
00140:     @canRestoreIceFace       = false
00141:     @lastMoveUsed            = nil
00142:     @lastMoveUsedType        = nil
00143:     @lastRegularMoveUsed     = nil
00144:     @lastRegularMoveTarget   = -1
00145:     @lastRoundMoved          = -1
00146:     @lastMoveFailed          = false
00147:     @lastRoundMoveFailed     = false
00148:     @movesUsed               = []
00149:     @turnCount               = 0
00150:     @effects[PBEffects::Attract]             = -1
00151:     @battle.allBattlers.each do |b|   # Other battlers no longer attracted to self
00152:       b.effects[PBEffects::Attract] = -1 if b.effects[PBEffects::Attract] == @index
00153:     end
00154:     @effects[PBEffects::BanefulBunker]       = false
00155:     @effects[PBEffects::BeakBlast]           = false
00156:     @effects[PBEffects::Bide]                = 0
00157:     @effects[PBEffects::BideDamage]          = 0
00158:     @effects[PBEffects::BideTarget]          = -1
00159:     @effects[PBEffects::BurnUp]              = false
00160:     @effects[PBEffects::Charge]              = 0
00161:     @effects[PBEffects::ChoiceBand]          = nil
00162:     @effects[PBEffects::Counter]             = -1
00163:     @effects[PBEffects::CounterTarget]       = -1
00164:     @effects[PBEffects::Dancer]              = false
00165:     @effects[PBEffects::DefenseCurl]         = false
00166:     @effects[PBEffects::DestinyBond]         = false
00167:     @effects[PBEffects::DestinyBondPrevious] = false
00168:     @effects[PBEffects::DestinyBondTarget]   = -1
00169:     @effects[PBEffects::Disable]             = 0
00170:     @effects[PBEffects::DisableMove]         = nil
00171:     @effects[PBEffects::Electrify]           = false
00172:     @effects[PBEffects::Encore]              = 0
00173:     @effects[PBEffects::EncoreMove]          = nil
00174:     @effects[PBEffects::Endure]              = false
00175:     @effects[PBEffects::ExtraType]           = nil
00176:     @effects[PBEffects::FirstPledge]         = nil
00177:     @effects[PBEffects::FlashFire]           = false
00178:     @effects[PBEffects::Flinch]              = false
00179:     @effects[PBEffects::FocusPunch]          = false
00180:     @effects[PBEffects::FollowMe]            = 0
00181:     @effects[PBEffects::Foresight]           = false
00182:     @effects[PBEffects::FuryCutter]          = 0
00183:     @effects[PBEffects::GemConsumed]         = nil
00184:     @effects[PBEffects::Grudge]              = false
00185:     @effects[PBEffects::HelpingHand]         = false
00186:     @effects[PBEffects::HyperBeam]           = 0
00187:     @effects[PBEffects::Illusion]            = nil
00188:     if hasActiveAbility?(:ILLUSION)
00189:       idxLastParty = @battle.pbLastInTeam(@index)
00190:       if idxLastParty >= 0 && idxLastParty != @pokemonIndex
00191:         @effects[PBEffects::Illusion]        = @battle.pbParty(@index)[idxLastParty]
00192:       end
00193:     end
00194:     @effects[PBEffects::Imprison]            = false
00195:     @effects[PBEffects::Instruct]            = false
00196:     @effects[PBEffects::Instructed]          = false
00197:     @effects[PBEffects::JawLock]             = -1
00198:     @battle.allBattlers.each do |b|   # Other battlers no longer blocked by self
00199:       b.effects[PBEffects::JawLock] = -1 if b.effects[PBEffects::JawLock] == @index
00200:     end
00201:     @effects[PBEffects::KingsShield]         = false
00202:     @battle.allBattlers.each do |b|   # Other battlers lose their lock-on against self
00203:       next if b.effects[PBEffects::LockOn] == 0
00204:       next if b.effects[PBEffects::LockOnPos] != @index
00205:       b.effects[PBEffects::LockOn]    = 0
00206:       b.effects[PBEffects::LockOnPos] = -1
00207:     end
00208:     @effects[PBEffects::MagicBounce]         = false
00209:     @effects[PBEffects::MagicCoat]           = false
00210:     @effects[PBEffects::MeanLook]            = -1
00211:     @battle.allBattlers.each do |b|   # Other battlers no longer blocked by self
00212:       b.effects[PBEffects::MeanLook] = -1 if b.effects[PBEffects::MeanLook] == @index
00213:     end
00214:     @effects[PBEffects::MeFirst]             = false
00215:     @effects[PBEffects::Metronome]           = 0
00216:     @effects[PBEffects::MicleBerry]          = false
00217:     @effects[PBEffects::Minimize]            = false
00218:     @effects[PBEffects::MiracleEye]          = false
00219:     @effects[PBEffects::MirrorCoat]          = -1
00220:     @effects[PBEffects::MirrorCoatTarget]    = -1
00221:     @effects[PBEffects::MoveNext]            = false
00222:     @effects[PBEffects::MudSport]            = false
00223:     @effects[PBEffects::Nightmare]           = false
00224:     @effects[PBEffects::NoRetreat]           = false
00225:     @effects[PBEffects::Obstruct]            = false
00226:     @effects[PBEffects::Octolock]            = -1
00227:     @battle.allBattlers.each do |b|   # Other battlers no longer locked by self
00228:       b.effects[PBEffects::Octolock] = -1 if b.effects[PBEffects::Octolock] == @index
00229:     end
00230:     @effects[PBEffects::Outrage]             = 0
00231:     @effects[PBEffects::ParentalBond]        = 0
00232:     @effects[PBEffects::PickupItem]          = nil
00233:     @effects[PBEffects::PickupUse]           = 0
00234:     @effects[PBEffects::Pinch]               = false
00235:     @effects[PBEffects::Powder]              = false
00236:     @effects[PBEffects::Prankster]           = false
00237:     @effects[PBEffects::PriorityAbility]     = false
00238:     @effects[PBEffects::PriorityItem]        = false
00239:     @effects[PBEffects::Protect]             = false
00240:     @effects[PBEffects::ProtectRate]         = 1
00241:     @effects[PBEffects::Quash]               = 0
00242:     @effects[PBEffects::Rage]                = false
00243:     @effects[PBEffects::RagePowder]          = false
00244:     @effects[PBEffects::Rollout]             = 0
00245:     @effects[PBEffects::Roost]               = false
00246:     @effects[PBEffects::SkyDrop]             = -1
00247:     @battle.allBattlers.each do |b|   # Other battlers no longer Sky Dropped by self
00248:       b.effects[PBEffects::SkyDrop] = -1 if b.effects[PBEffects::SkyDrop] == @index
00249:     end
00250:     @effects[PBEffects::SlowStart]           = 0
00251:     @effects[PBEffects::SmackDown]           = false
00252:     @effects[PBEffects::Snatch]              = 0
00253:     @effects[PBEffects::SpikyShield]         = false
00254:     @effects[PBEffects::Spotlight]           = 0
00255:     @effects[PBEffects::Stockpile]           = 0
00256:     @effects[PBEffects::StockpileDef]        = 0
00257:     @effects[PBEffects::StockpileSpDef]      = 0
00258:     @effects[PBEffects::TarShot]             = false
00259:     @effects[PBEffects::Taunt]               = 0
00260:     @effects[PBEffects::ThroatChop]          = 0
00261:     @effects[PBEffects::Torment]             = false
00262:     @effects[PBEffects::Toxic]               = 0
00263:     @effects[PBEffects::Transform]           = false
00264:     @effects[PBEffects::TransformSpecies]    = nil
00265:     @effects[PBEffects::Trapping]            = 0
00266:     @effects[PBEffects::TrappingMove]        = nil
00267:     @effects[PBEffects::TrappingUser]        = -1
00268:     @battle.allBattlers.each do |b|   # Other battlers no longer trapped by self
00269:       next if b.effects[PBEffects::TrappingUser] != @index
00270:       b.effects[PBEffects::Trapping]     = 0
00271:       b.effects[PBEffects::TrappingUser] = -1
00272:     end
00273:     @effects[PBEffects::Truant]              = false
00274:     @effects[PBEffects::TwoTurnAttack]       = nil
00275:     @effects[PBEffects::Unburden]            = false
00276:     @effects[PBEffects::Uproar]              = 0
00277:     @effects[PBEffects::WaterSport]          = false
00278:     @effects[PBEffects::WeightChange]        = 0
00279:     @effects[PBEffects::Yawn]                = 0
00280:   end
00281: 
00282:   #=============================================================================
00283:   # Refreshing a battler's properties
00284:   #=============================================================================
00285:   def pbUpdate(fullChange = false)
00286:     return if !@pokemon
00287:     @pokemon.calc_stats
00288:     @level          = @pokemon.level
00289:     @hp             = @pokemon.hp
00290:     @totalhp        = @pokemon.totalhp
00291:     if !@effects[PBEffects::Transform]
00292:       @attack       = @pokemon.attack
00293:       @defense      = @pokemon.defense
00294:       @spatk        = @pokemon.spatk
00295:       @spdef        = @pokemon.spdef
00296:       @speed        = @pokemon.speed
00297:       if fullChange
00298:         @types      = @pokemon.types
00299:         @ability_id = @pokemon.ability_id
00300:       end
00301:     end
00302:   end
00303: 
00304:   # Used to erase the battler of a Pokémon that has been caught.
00305:   def pbReset
00306:     @pokemon      = nil
00307:     @pokemonIndex = -1
00308:     @hp           = 0
00309:     pbInitEffects(false)
00310:     @participants = []
00311:     # Reset status
00312:     @status       = :NONE
00313:     @statusCount  = 0
00314:     # Reset choice
00315:     @battle.pbClearChoice(@index)
00316:   end
00317: 
00318:   # Update which Pokémon will gain Exp if this battler is defeated.
00319:   def pbUpdateParticipants
00320:     return if fainted? || !@battle.opposes?(@index)
00321:     allOpposing.each do |b|
00322:       @participants.push(b.pokemonIndex) if !@participants.include?(b.pokemonIndex)
00323:     end
00324:   end
00325: end
