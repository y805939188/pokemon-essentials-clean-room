00205:   end
00206: 
00207:   # Sets this Pokémon's Exp. Points.
00208:   # @param value [Integer] new experience points
00209:   def exp=(value)
00210:     @exp = value
00211:     @level = nil
00212:   end
00213: 
00214:   # @return [Boolean] whether this Pokémon is an egg
00215:   def egg?
00216:     return @steps_to_hatch > 0
00217:   end
00218: 
00219:   # @return [GameData::GrowthRate] this Pokémon's growth rate
00220:   def growth_rate
00221:     return GameData::GrowthRate.get(species_data.growth_rate)
00222:   end
00223: 
00224:   # @return [Integer] this Pokémon's base Experience value
00225:   def base_exp
00226:     return species_data.base_exp
00227:   end
00228: 
00229:   # @return [Float] a number between 0 and 1 indicating how much of the current level's
00230:   #   Exp this Pokémon has
00231:   def exp_fraction
00232:     lvl = self.level
00233:     return 0.0 if lvl >= GameData::GrowthRate.max_level
00234:     g_rate = growth_rate
00235:     start_exp = g_rate.minimum_exp_for_level(lvl)
00236:     end_exp   = g_rate.minimum_exp_for_level(lvl + 1)
00237:     return (@exp - start_exp).to_f / (end_exp - start_exp)
00238:   end
00239: 
00240:   #=============================================================================
00241:   # Status
00242:   #=============================================================================
00243: 
00244:   # Sets the Pokémon's health.
00245:   # @param value [Integer] new HP value
00246:   def hp=(value)
00247:     @hp = value.clamp(0, @totalhp)
00248:     heal_status if @hp == 0
00249:     @ready_to_evolve = false if @hp == 0
00250:   end
00251: 
00252:   # Sets this Pokémon's status. See {GameData::Status} for all possible status effects.
00253:   # @param value [Symbol, String, GameData::Status] status to set
00254:   def status=(value)
00255:     return if !able?
00256:     new_status = GameData::Status.try_get(value)
00257:     if !new_status
00258:       raise ArgumentError, _INTL("Attempted to set {1} as Pokémon status", value.class.name)
00259:     end
00260:     @status = new_status.id
00261:   end
00262: 
00263:   # @return [Boolean] whether the Pokémon is not fainted and not an egg
00264:   def able?
00265:     return !egg? && @hp > 0
00266:   end
00267: 
00268:   # @return [Boolean] whether the Pokémon is fainted
00269:   def fainted?
00270:     return !egg? && @hp <= 0
00271:   end
00272: 
00273:   # Heals all HP of this Pokémon.
00274:   def heal_HP
00275:     return if egg?
00276:     @hp = @totalhp
00277:   end
00278: 
00279:   # Heals the status problem of this Pokémon.
00280:   def heal_status
