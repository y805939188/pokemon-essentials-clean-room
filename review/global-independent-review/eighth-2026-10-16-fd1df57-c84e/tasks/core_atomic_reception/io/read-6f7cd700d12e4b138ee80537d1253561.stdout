00241: 
00242: ItemHandlers::CanUseInBattle.add(:XSPEED, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00243:   next pbBattleItemCanRaiseStat?(:SPEED, battler, scene, showMessages)
00244: })
00245: 
00246: ItemHandlers::CanUseInBattle.copy(:XSPEED, :XSPEED2, :XSPEED3, :XSPEED6)
00247: 
00248: ItemHandlers::CanUseInBattle.add(:XACCURACY, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00249:   next pbBattleItemCanRaiseStat?(:ACCURACY, battler, scene, showMessages)
00250: })
00251: 
00252: ItemHandlers::CanUseInBattle.copy(:XACCURACY, :XACCURACY2, :XACCURACY3, :XACCURACY6)
00253: 
00254: ItemHandlers::CanUseInBattle.add(:MAXMUSHROOMS, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00255:   if !pbBattleItemCanRaiseStat?(:ATTACK, battler, scene, false) &&
00256:      !pbBattleItemCanRaiseStat?(:DEFENSE, battler, scene, false) &&
00257:      !pbBattleItemCanRaiseStat?(:SPECIAL_ATTACK, battler, scene, false) &&
00258:      !pbBattleItemCanRaiseStat?(:SPECIAL_DEFENSE, battler, scene, false) &&
00259:      !pbBattleItemCanRaiseStat?(:SPEED, battler, scene, false)
00260:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00261:     next false
00262:   end
00263:   next true
00264: })
00265: 
00266: ItemHandlers::CanUseInBattle.add(:DIREHIT, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00267:   if !battler || battler.effects[PBEffects::FocusEnergy] >= 1
00268:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00269:     next false
00270:   end
00271:   next true
00272: })
00273: 
00274: ItemHandlers::CanUseInBattle.add(:DIREHIT2, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00275:   if !battler || battler.effects[PBEffects::FocusEnergy] >= 2
00276:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00277:     next false
00278:   end
00279:   next true
00280: })
00281: 
00282: ItemHandlers::CanUseInBattle.add(:DIREHIT3, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00283:   if !battler || battler.effects[PBEffects::FocusEnergy] >= 3
00284:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
