00441: ItemHandlers::BattleUseOnPokemon.add(:FULLRESTORE, proc { |item, pokemon, battler, choices, scene|
00442:   pokemon.heal_status
00443:   battler&.pbCureStatus(false)
00444:   battler&.pbCureConfusion
00445:   name = (battler) ? battler.pbThis : pokemon.name
00446:   if pokemon.hp < pokemon.totalhp
00447:     pbBattleHPItem(pokemon, battler, pokemon.totalhp, scene)
00448:   else
00449:     scene.pbRefresh
00450:     scene.pbDisplay(_INTL("{1} became healthy.", name))
00451:   end
00452: })
