00454: ItemHandlers::BattleUseOnPokemon.add(:REVIVE, proc { |item, pokemon, battler, choices, scene|
00455:   pokemon.hp = pokemon.totalhp / 2
00456:   pokemon.hp = 1 if pokemon.hp <= 0
00457:   pokemon.heal_status
00458:   scene.pbRefresh
00459:   scene.pbDisplay(_INTL("{1} recovered from fainting!", pokemon.name))
00460: })
