00298: #===============================================================================
00299: # UseInBattle handlers
00300: # For items used directly or on an opposing battler
00301: #===============================================================================
00302: ItemHandlers::UseInBattle.add(:GUARDSPEC, proc { |item, battler, battle|
00303:   battler.pbOwnSide.effects[PBEffects::Mist] = 5
00304:   battle.pbDisplay(_INTL("{1} became shrouded in mist!", battler.pbTeam))
00305:   battler.pokemon.changeHappiness("battleitem")
00306: })
00307: 
00308: ItemHandlers::UseInBattle.add(:POKEDOLL, proc { |item, battler, battle|
00309:   battle.decision = 3
00310:   battle.pbDisplayPaused(_INTL("You got away safely!"))
00311: })
00312: 
00313: ItemHandlers::UseInBattle.copy(:POKEDOLL, :FLUFFYTAIL, :POKETOY)
00314: 
00315: ItemHandlers::UseInBattle.add(:POKEFLUTE, proc { |item, battler, battle|
00316:   battle.allBattlers.each do |b|
00317:     b.pbCureStatus(false) if b.status == :SLEEP && !b.hasActiveAbility?(:SOUNDPROOF)
00318:   end
00319:   battle.pbDisplay(_INTL("All Pokémon were roused by the tune!"))
00320: })
00321: 
00322: ItemHandlers::UseInBattle.addIf(:poke_balls,
00323:   proc { |item| GameData::Item.get(item).is_poke_ball? },
00324:   proc { |item, battler, battle|
00325:     battle.pbThrowPokeBall(battler.index, item)
00326:   }
00327: )
00328: 
