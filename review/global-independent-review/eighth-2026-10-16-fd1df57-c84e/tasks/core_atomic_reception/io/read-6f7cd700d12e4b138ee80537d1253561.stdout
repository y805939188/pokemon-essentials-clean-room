00289: 
00290: ItemHandlers::CanUseInBattle.add(:POKEFLUTE, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00291:   if battle.allBattlers.none? { |b| b.status == :SLEEP && !b.hasActiveAbility?(:SOUNDPROOF) }
00292:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00293:     next false
00294:   end
00295:   next true
00296: })
