00006:   def pbCommandMenu(idxBattler, firstAction)
00007:     shadowTrainer = (GameData::Type.exists?(:SHADOW) && @battle.trainerBattle?)
00008:     cmds = [
00009:       _INTL("What will\n{1} do?", @battle.battlers[idxBattler].name),
00010:       _INTL("Fight"),
00011:       _INTL("Bag"),
00012:       _INTL("Pokémon"),
00013:       (shadowTrainer) ? _INTL("Call") : (firstAction) ? _INTL("Run") : _INTL("Cancel")
00014:     ]
00015:     ret = pbCommandMenuEx(idxBattler, cmds, (shadowTrainer) ? 2 : (firstAction) ? 0 : 1)
00016:     ret = 4 if ret == 3 && shadowTrainer   # Convert "Run" to "Call"
00017:     ret = -1 if ret == 3 && !firstAction   # Convert "Run" to "Cancel"
00018:     return ret
00019:   end
