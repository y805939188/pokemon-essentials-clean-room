01834: Battle::ItemEffects::EndOfRoundHealing.add(:BLACKSLUDGE,
01835:   proc { |item, battler, battle|
01836:     if battler.pbHasType?(:POISON)
01837:       next if !battler.canHeal?
01838:       battle.pbCommonAnimation("UseItem", battler)
01839:       battler.pbRecoverHP(battler.totalhp / 16)
01840:       battle.pbDisplay(_INTL("{1} restored a little HP using its {2}!",
01841:          battler.pbThis, battler.itemName))
01842:     elsif battler.takesIndirectDamage?
01843:       battle.pbCommonAnimation("UseItem", battler)
01844:       battler.pbTakeEffectDamage(battler.totalhp / 8) do |hp_lost|
01845:         battle.pbDisplay(_INTL("{1} is hurt by its {2}!", battler.pbThis, battler.itemName))
01846:       end
01847:     end
01848:   }
01849: )
01850: 
01851: Battle::ItemEffects::EndOfRoundHealing.add(:LEFTOVERS,
01852:   proc { |item, battler, battle|
01853:     next if !battler.canHeal?
01854:     battle.pbCommonAnimation("UseItem", battler)
01855:     battler.pbRecoverHP(battler.totalhp / 16)
01856:     battle.pbDisplay(_INTL("{1} restored a little HP using its {2}!",
01857:        battler.pbThis, battler.itemName))
01858:   }
01859: )
01860: 
01861: #===============================================================================
01862: # EndOfRoundEffect handlers
01863: #===============================================================================
01864: 
01865: Battle::ItemEffects::EndOfRoundEffect.add(:FLAMEORB,
01866:   proc { |item, battler, battle|
01867:     next if !battler.pbCanBurn?(battler, false)
01868:     battler.pbBurn(nil, _INTL("{1} was burned by the {2}!", battler.pbThis, battler.itemName))
01869:   }
01870: )
01871: 
01872: Battle::ItemEffects::EndOfRoundEffect.add(:STICKYBARB,
01873:   proc { |item, battler, battle|
01874:     next if !battler.takesIndirectDamage?
01875:     battle.scene.pbDamageAnimation(battler)
01876:     battler.pbTakeEffectDamage(battler.totalhp / 8, false) do |hp_lost|
01877:       battle.pbDisplay(_INTL("{1} is hurt by its {2}!", battler.pbThis, battler.itemName))
01878:     end
01879:   }
01880: )
01881: 
01882: Battle::ItemEffects::EndOfRoundEffect.add(:TOXICORB,
01883:   proc { |item, battler, battle|
01884:     next if !battler.pbCanPoison?(battler, false)
01885:     battler.pbPoison(nil, _INTL("{1} was badly poisoned by the {2}!",
01886:        battler.pbThis, battler.itemName), true)
01887:   }
01888: )
01889: 
