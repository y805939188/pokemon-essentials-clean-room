00174:   def pbCommandPhase
00175:     @command_phase = true
00176:     @scene.pbBeginCommandPhase
00177:     # Reset choices if commands can be shown
00178:     @battlers.each_with_index do |b, i|
00179:       next if !b
00180:       pbClearChoice(i) if pbCanShowCommands?(i)
00181:     end
00182:     # Reset choices to perform Mega Evolution if it wasn't done somehow
00183:     2.times do |side|
00184:       @megaEvolution[side].each_with_index do |megaEvo, i|
00185:         @megaEvolution[side][i] = -1 if megaEvo >= 0
00186:       end
00187:     end
00188:     # Choose actions for the round (player first, then AI)
00189:     pbCommandPhaseLoop(true)    # Player chooses their actions
00190:     if @decision != 0   # Battle ended, stop choosing actions
