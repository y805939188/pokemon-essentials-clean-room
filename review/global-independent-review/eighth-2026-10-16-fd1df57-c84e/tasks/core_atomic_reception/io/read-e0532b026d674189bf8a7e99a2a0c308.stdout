00116:     @hyper_mode   = false
00117:     @saved_exp    = 0
00118:     @saved_ev     = {}
00119:     GameData::Stat.each_main { |s| @saved_ev[s.id] = 0 }
00120:     @heart_gauge  = max_gauge_size
00121:     @heart_gauge_step_counter = 0
00122:     @shadow_moves = []
00123:     # Retrieve Shadow moveset for this Pokémon
00124:     data = shadow_data
00125:     # Record this Pokémon's Shadow moves
00126:     if data
00127:       data.moves.each do |m|
00128:         @shadow_moves.push(m) if GameData::Move.exists?(m)
00129:         break if @shadow_moves.length >= MAX_MOVES
00130:       end
00131:     end
00132:     if @shadow_moves.empty? && GameData::Move.exists?(:SHADOWRUSH)
00133:       @shadow_moves.push(:SHADOWRUSH)
00134:     end
00135:     # Record this Pokémon's original moves
00136:     if !@shadow_moves.empty?
00137:       @moves.each_with_index { |m, i| @shadow_moves[MAX_MOVES + i] = m.id }
00138:       update_shadow_moves
00139:     end
