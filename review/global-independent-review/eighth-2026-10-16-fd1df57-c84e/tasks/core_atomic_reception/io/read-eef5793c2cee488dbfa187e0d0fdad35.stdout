00425:   def pbCureStatus(showMessages = true)
00426:     oldStatus = status
00427:     self.status = :NONE
00428:     if showMessages
00429:       case oldStatus
00430:       when :SLEEP     then @battle.pbDisplay(_INTL("{1} woke up!", pbThis))
00431:       when :POISON    then @battle.pbDisplay(_INTL("{1} was cured of its poisoning.", pbThis))
00432:       when :BURN      then @battle.pbDisplay(_INTL("{1}'s burn was healed.", pbThis))
00433:       when :PARALYSIS then @battle.pbDisplay(_INTL("{1} was cured of paralysis.", pbThis))
00434:       when :FROZEN    then @battle.pbDisplay(_INTL("{1} thawed out!", pbThis))
00435:       end
00436:     end
00437:     PBDebug.log("[Status change] #{pbThis}'s status was cured") if !showMessages
00438:   end
00439: 
00440:   #=============================================================================
