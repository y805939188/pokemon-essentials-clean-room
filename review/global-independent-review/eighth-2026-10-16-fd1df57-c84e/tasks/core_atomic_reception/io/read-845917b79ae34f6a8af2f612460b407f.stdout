00001: #===============================================================================
00002: # User flees from battle. (Teleport (Gen 7-))
00003: #===============================================================================
00004: class Battle::Move::FleeFromBattle < Battle::Move
00005:   def pbMoveFailed?(user, targets)
00006:     if !@battle.pbCanRun?(user.index) || (user.wild? && user.allAllies.length > 0)
00007:       @battle.pbDisplay(_INTL("But it failed!"))
00008:       return true
00009:     end
00010:     return false
00011:   end
00012: 
00013:   def pbEffectGeneral(user)
00014:     @battle.pbDisplay(_INTL("{1} fled from battle!", user.pbThis))
00015:     @battle.decision = 3   # Escaped
00016:   end
00017: end
00018: 
00019: #===============================================================================
00020: # User switches out. If user is a wild Pokémon, ends the battle instead.
00021: # (Teleport (Gen 8+))
00022: #===============================================================================
00023: class Battle::Move::SwitchOutUserStatusMove < Battle::Move
00024:   def pbMoveFailed?(user, targets)
00025:     if user.wild?
00026:       if !@battle.pbCanRun?(user.index) || user.allAllies.length > 0
00027:         @battle.pbDisplay(_INTL("But it failed!"))
00028:         return true
00029:       end
00030:     elsif !@battle.pbCanChooseNonActive?(user.index)
00031:       @battle.pbDisplay(_INTL("But it failed!"))
00032:       return true
00033:     end
00034:     return false
00035:   end
00036: 
00037:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
00038:     return if user.wild?
00039:     @battle.pbDisplay(_INTL("{1} went back to {2}!", user.pbThis,
00040:                             @battle.pbGetOwnerName(user.index)))
00041:     @battle.pbPursuit(user.index)
00042:     return if user.fainted?
00043:     newPkmn = @battle.pbGetReplacementPokemonIndex(user.index)   # Owner chooses
00044:     return if newPkmn < 0
00045:     @battle.pbRecallAndReplace(user.index, newPkmn)
00046:     @battle.pbClearChoice(user.index)   # Replacement Pokémon does nothing this round
00047:     @battle.moldBreaker = false
00048:     @battle.pbOnBattlerEnteringBattle(user.index)
00049:     switchedBattlers.push(user.index)
00050:   end
00051: 
00052:   def pbEffectGeneral(user)
00053:     if user.wild?
00054:       @battle.pbDisplay(_INTL("{1} fled from battle!", user.pbThis))
00055:       @battle.decision = 3   # Escaped
00056:     end
00057:   end
00058: end
00059: 
00060: #===============================================================================
00061: # After inflicting damage, user switches out. Ignores trapping moves.
00062: # (Flip Turn, U-turn, Volt Switch)
00063: #===============================================================================
00064: class Battle::Move::SwitchOutUserDamagingMove < Battle::Move
00065:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
00066:     return if user.fainted? || numHits == 0 || @battle.pbAllFainted?(user.idxOpposingSide)
00067:     targetSwitched = true
00068:     targets.each do |b|
00069:       targetSwitched = false if !switchedBattlers.include?(b.index)
00070:     end
00071:     return if targetSwitched
00072:     return if !@battle.pbCanChooseNonActive?(user.index)
00073:     @battle.pbDisplay(_INTL("{1} went back to {2}!", user.pbThis,
00074:                             @battle.pbGetOwnerName(user.index)))
00075:     @battle.pbPursuit(user.index)
00076:     return if user.fainted?
00077:     newPkmn = @battle.pbGetReplacementPokemonIndex(user.index)   # Owner chooses
00078:     return if newPkmn < 0
00079:     @battle.pbRecallAndReplace(user.index, newPkmn)
00080:     @battle.pbClearChoice(user.index)   # Replacement Pokémon does nothing this round
00081:     @battle.moldBreaker = false
00082:     @battle.pbOnBattlerEnteringBattle(user.index)
00083:     switchedBattlers.push(user.index)
00084:   end
00085: end
00086: 
00087: #===============================================================================
00088: # Decreases the target's Attack and Special Attack by 1 stage each. Then, user
00089: # switches out. Ignores trapping moves. (Parting Shot)
00090: #===============================================================================
00091: class Battle::Move::LowerTargetAtkSpAtk1SwitchOutUser < Battle::Move::TargetMultiStatDownMove
00092:   def initialize(battle, move)
00093:     super
00094:     @statDown = [:ATTACK, 1, :SPECIAL_ATTACK, 1]
00095:   end
00096: 
00097:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
00098:     switcher = user
00099:     targets.each do |b|
00100:       next if switchedBattlers.include?(b.index)
00101:       switcher = b if b.effects[PBEffects::MagicCoat] || b.effects[PBEffects::MagicBounce]
00102:     end
00103:     return if switcher.fainted? || numHits == 0
00104:     return if !@battle.pbCanChooseNonActive?(switcher.index)
00105:     @battle.pbDisplay(_INTL("{1} went back to {2}!", switcher.pbThis,
00106:                             @battle.pbGetOwnerName(switcher.index)))
00107:     @battle.pbPursuit(switcher.index)
00108:     return if switcher.fainted?
00109:     newPkmn = @battle.pbGetReplacementPokemonIndex(switcher.index)   # Owner chooses
00110:     return if newPkmn < 0
00111:     @battle.pbRecallAndReplace(switcher.index, newPkmn)
00112:     @battle.pbClearChoice(switcher.index)   # Replacement Pokémon does nothing this round
00113:     @battle.moldBreaker = false if switcher.index == user.index
00114:     @battle.pbOnBattlerEnteringBattle(switcher.index)
00115:     switchedBattlers.push(switcher.index)
00116:   end
00117: end
00118: 
00119: #===============================================================================
00120: # User switches out. Various effects affecting the user are passed to the
00121: # replacement. (Baton Pass)
00122: #===============================================================================
00123: class Battle::Move::SwitchOutUserPassOnEffects < Battle::Move
00124:   def pbMoveFailed?(user, targets)
00125:     if !@battle.pbCanChooseNonActive?(user.index)
00126:       @battle.pbDisplay(_INTL("But it failed!"))
00127:       return true
00128:     end
00129:     return false
00130:   end
00131: 
00132:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
00133:     return if user.fainted? || numHits == 0
00134:     return if !@battle.pbCanChooseNonActive?(user.index)
00135:     @battle.pbPursuit(user.index)
00136:     return if user.fainted?
00137:     newPkmn = @battle.pbGetReplacementPokemonIndex(user.index)   # Owner chooses
00138:     return if newPkmn < 0
00139:     @battle.pbRecallAndReplace(user.index, newPkmn, false, true)
00140:     @battle.pbClearChoice(user.index)   # Replacement Pokémon does nothing this round
00141:     @battle.moldBreaker = false
00142:     @battle.pbOnBattlerEnteringBattle(user.index)
00143:     switchedBattlers.push(user.index)
00144:   end
00145: end
00146: 
00147: #===============================================================================
00148: # When used against a sole wild Pokémon, makes target flee and ends the battle;
00149: # fails if target is a higher level than the user.
00150: # When used against a trainer's Pokémon, target switches out.
00151: # For status moves. (Roar, Whirlwind)
00152: #===============================================================================
