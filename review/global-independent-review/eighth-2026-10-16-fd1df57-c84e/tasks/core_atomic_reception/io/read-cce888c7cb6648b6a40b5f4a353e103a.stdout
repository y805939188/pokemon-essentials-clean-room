00136:   def pbCalculatePriority(fullCalc = false, indexArray = nil)
00137:     needRearranging = false
00138:     if fullCalc
00139:       @priorityTrickRoom = (@field.effects[PBEffects::TrickRoom] > 0)
00140:       # Recalculate everything from scratch
00141:       randomOrder = Array.new(maxBattlerIndex + 1) { |i| i }
00142:       (randomOrder.length - 1).times do |i|   # Can't use shuffle! here
00143:         r = i + pbRandom(randomOrder.length - i)
00144:         randomOrder[i], randomOrder[r] = randomOrder[r], randomOrder[i]
00145:       end
00146:       @priority.clear
00147:       (0..maxBattlerIndex).each do |i|
00148:         b = @battlers[i]
00149:         next if !b
00150:         # [battler, speed, sub-priority from ability, sub-priority from item,
00151:         #  final sub-priority, priority, tie-breaker order]
00152:         entry = [b, b.pbSpeed, 0, 0, 0, 0, randomOrder[i]]
00153:         if @choices[b.index][0] == :UseMove || @choices[b.index][0] == :Shift
00154:           # Calculate move's priority
00155:           if @choices[b.index][0] == :UseMove
00156:             move = @choices[b.index][2]
00157:             pri = move.pbPriority(b)
00158:             if b.abilityActive?
00159:               pri = Battle::AbilityEffects.triggerPriorityChange(b.ability, b, move, pri)
00160:             end
00161:             entry[5] = pri
00162:             @choices[b.index][4] = pri
00163:           end
00164:           # Calculate sub-priority changes (first/last within priority bracket)
00165:           # Abilities (Stall)
00166:           if b.abilityActive?
00167:             entry[2] = Battle::AbilityEffects.triggerPriorityBracketChange(b.ability, b, self)
00168:           end
00169:           # Items (Quick Claw, Custap Berry, Lagging Tail, Full Incense)
00170:           if b.itemActive?
00171:             entry[3] = Battle::ItemEffects.triggerPriorityBracketChange(b.item, b, self)
00172:           end
00173:         end
00174:         @priority.push(entry)
00175:       end
00176:       needRearranging = true
00177:     else
00178:       if (@field.effects[PBEffects::TrickRoom] > 0) != @priorityTrickRoom
00179:         needRearranging = true
00180:         @priorityTrickRoom = (@field.effects[PBEffects::TrickRoom] > 0)
00181:       end
00182:       # Recheck all battler speeds and changes to priority caused by abilities
00183:       @priority.each do |entry|
00184:         next if !entry
00185:         next if indexArray && !indexArray.include?(entry[0].index)
00186:         # Recalculate speed of battler
00187:         newSpeed = entry[0].pbSpeed
00188:         needRearranging = true if newSpeed != entry[1]
00189:         entry[1] = newSpeed
00190:         # Recalculate move's priority in case ability has changed
