00004: class Battle::AI
00005:   HP_HEAL_ITEMS = {
00006:     :POTION       => 20,
00007:     :SUPERPOTION  => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 60 : 50,
00008:     :HYPERPOTION  => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 120 : 200,
00009:     :MAXPOTION    => 999,
00010:     :BERRYJUICE   => 20,
00011:     :SWEETHEART   => 20,
00012:     :FRESHWATER   => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 30 : 50,
00013:     :SODAPOP      => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 50 : 60,
00014:     :LEMONADE     => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 70 : 80,
00015:     :MOOMOOMILK   => 100,
00016:     :ORANBERRY    => 10,
00017:     :SITRUSBERRY  => 1,   # Actual amount is determined below (pkmn.totalhp / 4)
00018:     :ENERGYPOWDER => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 60 : 50,
00019:     :ENERGYROOT   => (Settings::REBALANCED_HEALING_ITEM_AMOUNTS) ? 120 : 200
00020:   }
00021:   HP_HEAL_ITEMS[:RAGECANDYBAR] = 20 if !Settings::RAGE_CANDY_BAR_CURES_STATUS_PROBLEMS
00022:   FULL_RESTORE_ITEMS = [
00023:     :FULLRESTORE
00024:   ]
00025:   ONE_STATUS_CURE_ITEMS = [   # Preferred over items that heal all status problems
00026:     :AWAKENING, :CHESTOBERRY, :BLUEFLUTE,
00027:     :ANTIDOTE, :PECHABERRY,
00028:     :BURNHEAL, :RAWSTBERRY,
00029:     :PARALYZEHEAL, :PARLYZHEAL, :CHERIBERRY,
00030:     :ICEHEAL, :ASPEARBERRY
00031:   ]
00032:   ALL_STATUS_CURE_ITEMS = [
00033:     :FULLHEAL, :LAVACOOKIE, :OLDGATEAU, :CASTELIACONE, :LUMIOSEGALETTE,
00034:     :SHALOURSABLE, :BIGMALASADA, :PEWTERCRUNCHIES, :LUMBERRY, :HEALPOWDER
00035:   ]
00036:   ALL_STATUS_CURE_ITEMS.push(:RAGECANDYBAR) if Settings::RAGE_CANDY_BAR_CURES_STATUS_PROBLEMS
00037:   ONE_STAT_RAISE_ITEMS = {
00038:     :XATTACK    => [:ATTACK, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00039:     :XATTACK2   => [:ATTACK, 2],
00040:     :XATTACK3   => [:ATTACK, 3],
00041:     :XATTACK6   => [:ATTACK, 6],
00042:     :XDEFENSE   => [:DEFENSE, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00043:     :XDEFENSE2  => [:DEFENSE, 2],
00044:     :XDEFENSE3  => [:DEFENSE, 3],
00045:     :XDEFENSE6  => [:DEFENSE, 6],
00046:     :XDEFEND    => [:DEFENSE, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00047:     :XDEFEND2   => [:DEFENSE, 2],
00048:     :XDEFEND3   => [:DEFENSE, 3],
00049:     :XDEFEND6   => [:DEFENSE, 6],
00050:     :XSPATK     => [:SPECIAL_ATTACK, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00051:     :XSPATK2    => [:SPECIAL_ATTACK, 2],
00052:     :XSPATK3    => [:SPECIAL_ATTACK, 3],
00053:     :XSPATK6    => [:SPECIAL_ATTACK, 6],
00054:     :XSPECIAL   => [:SPECIAL_ATTACK, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00055:     :XSPECIAL2  => [:SPECIAL_ATTACK, 2],
00056:     :XSPECIAL3  => [:SPECIAL_ATTACK, 3],
00057:     :XSPECIAL6  => [:SPECIAL_ATTACK, 6],
00058:     :XSPDEF     => [:SPECIAL_DEFENSE, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00059:     :XSPDEF2    => [:SPECIAL_DEFENSE, 2],
00060:     :XSPDEF3    => [:SPECIAL_DEFENSE, 3],
00061:     :XSPDEF6    => [:SPECIAL_DEFENSE, 6],
00062:     :XSPEED     => [:SPEED, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00063:     :XSPEED2    => [:SPEED, 2],
00064:     :XSPEED3    => [:SPEED, 3],
00065:     :XSPEED6    => [:SPEED, 6],
00066:     :XACCURACY  => [:ACCURACY, (Settings::X_STAT_ITEMS_RAISE_BY_TWO_STAGES) ? 2 : 1],
00067:     :XACCURACY2 => [:ACCURACY, 2],
00068:     :XACCURACY3 => [:ACCURACY, 3],
00069:     :XACCURACY6 => [:ACCURACY, 6]
00070:   }
00071:   ALL_STATS_RAISE_ITEMS = [
00072:     :MAXMUSHROOMS
00073:   ]
00074:   REVIVE_ITEMS = {
00075:     :REVIVE      => 5,
00076:     :MAXREVIVE   => 7,
00077:     :REVIVALHERB => 7,
00078:     :MAXHONEY    => 7
00079:   }
00080: 
00081:   #-----------------------------------------------------------------------------
00082: 
00083:   # Decide whether the opponent should use an item on the Pokémon.
00084:   def pbChooseToUseItem
00085:     item = nil
00086:     idxTarget = nil   # Party index (battle_use type 1/2/3) or battler index
00087:     idxMove = nil
00088:     item, idxTarget, idxMove = choose_item_to_use
00089:     return false if !item
00090:     # Register use of item
00091:     @battle.pbRegisterItem(@user.index, item, idxTarget, idxMove)
00092:     PBDebug.log_ai("#{@user.name} will use item #{GameData::Item.get(item).name}")
00093:     return true
00094:   end
00095: 
00096:   # Return values are:
00097:   #   item ID
00098:   #   target index (party index for items with a battle use of 1/2/3, battler
00099:   #     index otherwise)
00100:   #   move index (for items usable on moves only)
00101:   def choose_item_to_use
00102:     return nil if !@battle.internalBattle
00103:     items = @battle.pbGetOwnerItems(@user.index)
00104:     return nil if !items || items.length == 0
00105:     # Find all items usable on the Pokémon choosing this action
00106:     pkmn = @user.battler.pokemon
00107:     usable_items = {}
00108:     items.each do |item|
00109:       usage = get_usability_of_item_on_pkmn(item, @user.party_index, @user.side)
00110:       usage.each_pair do |key, vals|
00111:         usable_items[key] ||= []
00112:         usable_items[key] += vals
00113:       end
00114:     end
00115:     # Prioritise using a HP restoration item
00116:     if usable_items[:hp_heal] && (pkmn.hp <= pkmn.totalhp / 4 ||
00117:        (pkmn.hp <= pkmn.totalhp / 2 && pbAIRandom(100) < 30))
00118:       usable_items[:hp_heal].sort! { |a, b| (a[2] == b[2]) ? a[3] <=> b[3] : a[2] <=> b[2] }
00119:       usable_items[:hp_heal].each do |item|
00120:         return item[0], item[1] if item[3] >= (pkmn.totalhp - pkmn.hp) * 0.75
00121:       end
00122:       return usable_items[:hp_heal].last[0], usable_items[:hp_heal].last[1]
00123:     end
00124:     # Next prioritise using a status-curing item
00125:     if usable_items[:status_cure] &&
00126:        ([:SLEEP, :FROZEN].include?(pkmn.status) || pbAIRandom(100) < 40)
00127:       usable_items[:status_cure].sort! { |a, b| a[2] <=> b[2] }
00128:       return usable_items[:status_cure].first[0], usable_items[:status_cure].first[1]
00129:     end
00130:     # Next try using an item that raises all stats (Max Mushrooms)
00131:     if usable_items[:all_stats_raise] && pbAIRandom(100) < 30
00132:       return usable_items[:stat_raise].first[0], usable_items[:stat_raise].first[1]
00133:     end
00134:     # Next try using an X item
00135:     if usable_items[:stat_raise] && pbAIRandom(100) < 30
00136:       usable_items[:stat_raise].sort! { |a, b| (a[2] == b[2]) ? a[3] <=> b[3] : a[2] <=> b[2] }
00137:       return usable_items[:stat_raise].last[0], usable_items[:stat_raise].last[1]
00138:     end
00139:     # Find items usable on other Pokémon in the user's team
00140:     # NOTE: Currently only checks Revives.
00141:     usable_items = {}
00142:     @battle.eachInTeamFromBattlerIndex(@user.index) do |team_pkmn, i|
00143:       next if !team_pkmn.fainted?   # Remove this line to check unfainted Pokémon too
00144:       items.each do |item|
00145:         usage = get_usability_of_item_on_pkmn(item, i, @user.side)
00146:         usage.each_pair do |key, vals|
00147:           usable_items[key] ||= []
00148:           usable_items[key] += vals
00149:         end
00150:       end
00151:     end
00152:     # Try using a Revive (prefer Max Revive-type items over Revive)
00153:     if usable_items[:revive] &&
00154:        (@battle.pbAbleNonActiveCount(@user.index) == 0 || pbAIRandom(100) < 40)
00155:       usable_items[:revive].sort! { |a, b| (a[2] == b[2]) ? a[1] <=> b[1] : a[2] <=> b[2] }
00156:       return usable_items[:revive].last[0], usable_items[:revive].last[1]
00157:     end
00158:     return nil
00159:   end
00160: 
00161:   def get_usability_of_item_on_pkmn(item, party_index, side)
00162:     pkmn = @battle.pbParty(side)[party_index]
00163:     battler = @battle.pbFindBattler(party_index, side)
00164:     ret = {}
00165:     return ret if !@battle.pbCanUseItemOnPokemon?(item, pkmn, battler, @battle.scene, false)
00166:     return ret if !ItemHandlers.triggerCanUseInBattle(item, pkmn, battler, nil,
00167:                                                       false, self, @battle.scene, false)
00168:     want_to_cure_status = (pkmn.status != :NONE)
00169:     if battler
00170:       if want_to_cure_status
00171:         want_to_cure_status = @battlers[battler.index].wants_status_problem?(pkmn.status)
00172:         want_to_cure_status = false if pkmn.status == :SLEEP && pkmn.statusCount <= 2
00173:       end
00174:       want_to_cure_status ||= (battler.effects[PBEffects::Confusion] > 1)
00175:     end
00176:     if HP_HEAL_ITEMS.include?(item)
00177:       if pkmn.hp < pkmn.totalhp
00178:         heal_amount = HP_HEAL_ITEMS[item]
00179:         heal_amount = pkmn.totalhp / 4 if item == :SITURUSBERRY
00180:         ret[:hp_heal] ||= []
00181:         ret[:hp_heal].push([item, party_index, 5, heal_amount])
00182:       end
00183:     elsif FULL_RESTORE_ITEMS.include?(item)
00184:       prefer_full_restore = (pkmn.hp <= pkmn.totalhp * 2 / 3 && want_to_cure_status)
00185:       if pkmn.hp < pkmn.totalhp
00186:         ret[:hp_heal] ||= []
00187:         ret[:hp_heal].push([item, party_index, (prefer_full_restore) ? 3 : 7, 999])
00188:       end
00189:       if want_to_cure_status
00190:         ret[:status_cure] ||= []
00191:         ret[:status_cure].push([item, party_index, (prefer_full_restore) ? 3 : 9])
00192:       end
00193:     elsif ONE_STATUS_CURE_ITEMS.include?(item)
00194:       if want_to_cure_status
00195:         ret[:status_cure] ||= []
00196:         ret[:status_cure].push([item, party_index, 5])
00197:       end
00198:     elsif ALL_STATUS_CURE_ITEMS.include?(item)
00199:       if want_to_cure_status
00200:         ret[:status_cure] ||= []
00201:         ret[:status_cure].push([item, party_index, 7])
00202:       end
00203:     elsif ONE_STAT_RAISE_ITEMS.include?(item)
00204:       stat_data = ONE_STAT_RAISE_ITEMS[item]
00205:       if battler && stat_raise_worthwhile?(@battlers[battler.index], stat_data[0])
00206:         ret[:stat_raise] ||= []
00207:         ret[:stat_raise].push([item, party_index, battler.stages[stat_data[0]], stat_data[1]])
00208:       end
00209:     elsif ALL_STATS_RAISE_ITEMS.include?(item)
00210:       if battler
00211:         ret[:all_stats_raise] ||= []
00212:         ret[:all_stats_raise].push([item, party_index])
00213:       end
00214:     elsif REVIVE_ITEMS.include?(item)
00215:       ret[:revive] ||= []
00216:       ret[:revive].push([item, party_index, REVIVE_ITEMS[item]])
00217:     end
00218:     return ret
00219:   end
00220: end
