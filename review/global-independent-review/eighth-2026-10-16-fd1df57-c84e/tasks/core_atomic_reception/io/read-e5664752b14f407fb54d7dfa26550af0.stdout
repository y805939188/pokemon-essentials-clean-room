00126:   return true if $player.able_pokemon_count >= 2
00127:   return $PokemonGlobal.partner && $player.able_pokemon_count >= 1
00128: end
00129: 
00130: def pbCanTripleBattle?
00131:   return true if $player.able_pokemon_count >= 3
00132:   return $PokemonGlobal.partner && $player.able_pokemon_count >= 2
00133: end
