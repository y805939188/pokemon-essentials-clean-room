00004: class BugContestState
00005:   attr_accessor :ballcount
00006:   attr_accessor :decision
00007:   attr_accessor :lastPokemon
00008:   attr_accessor :timer_start
00009: 
00010:   CONTESTANT_NAMES = [
00011:     _INTL("Bug Catcher Ed"),
00012:     _INTL("Bug Catcher Benny"),
00013:     _INTL("Bug Catcher Josh"),
00014:     _INTL("Camper Barry"),
00015:     _INTL("Cool Trainer Nick"),
00016:     _INTL("Lass Abby"),
00017:     _INTL("Picnicker Cindy"),
00018:     _INTL("Youngster Samuel")
00019:   ]
00020:   TIME_ALLOWED = Settings::BUG_CONTEST_TIME   # In seconds
00021: 
00022:   def initialize
00023:     clear
00024:     @lastContest = nil
00025:   end
00026: 
00027:   # Returns whether the last contest ended less than 24 hours ago.
00028:   def pbContestHeld?
00029:     return false if !@lastContest
00030:     return pbGetTimeNow.to_i - @lastContest < 24 * 60 * 60   # 24 hours
00031:   end
00032: 
00033:   def expired?
00034:     return false if !undecided?
00035:     return false if TIME_ALLOWED <= 0
00036:     return System.uptime - timer_start >= TIME_ALLOWED
00037:   end
00038: 
00039:   def clear
00040:     @ballcount    = 0
00041:     @ended        = false
00042:     @inProgress   = false
00043:     @decision     = 0
00044:     @lastPokemon  = nil
00045:     @otherparty   = []
00046:     @contestants  = []
00047:     @places       = []
00048:     @start        = nil
00049:     @contestMaps  = []
00050:     @reception    = []
00051:   end
00052: 
00053:   def inProgress?
00054:     return @inProgress
00055:   end
00056: 
00057:   def undecided?
00058:     return (@inProgress && @decision == 0)
00059:   end
00060: 
00061:   def decided?
00062:     return (@inProgress && @decision != 0) || @ended
00063:   end
00064: 
