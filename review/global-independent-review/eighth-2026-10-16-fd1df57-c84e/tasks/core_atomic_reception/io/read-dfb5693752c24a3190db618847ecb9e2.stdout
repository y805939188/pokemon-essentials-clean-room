00594: class Battle::Move::ConfuseTarget < Battle::Move
00595:   def canMagicCoat?; return true; end
00596: 
00597:   def pbFailsAgainstTarget?(user, target, show_message)
00598:     return false if damagingMove?
00599:     return !target.pbCanConfuse?(user, show_message, self)
00600:   end
00601: 
00602:   def pbEffectAgainstTarget(user, target)
00603:     return if damagingMove?
00604:     target.pbConfuse
00605:   end
00606: 
00607:   def pbAdditionalEffect(user, target)
00608:     return if target.damageState.substitute
00609:     return if !target.pbCanConfuse?(user, false, self)
00610:     target.pbConfuse
00611:   end
00612: end
00613: 
00614: #===============================================================================
00615: # Confuses the target. Accuracy perfect in rain, 50% in sunshine. Hits some
00616: # semi-invulnerable targets. (Hurricane)
00617: #===============================================================================
00618: class Battle::Move::ConfuseTargetAlwaysHitsInRainHitsTargetInSky < Battle::Move::ConfuseTarget
00619:   def hitsFlyingTargets?; return true; end
00620: 
00621:   def pbBaseAccuracy(user, target)
00622:     case target.effectiveWeather
00623:     when :Sun, :HarshSun
00624:       return 50
00625:     when :Rain, :HeavyRain
00626:       return 0
00627:     end
00628:     return super
00629:   end
00630: end
00631: 
00632: #===============================================================================
