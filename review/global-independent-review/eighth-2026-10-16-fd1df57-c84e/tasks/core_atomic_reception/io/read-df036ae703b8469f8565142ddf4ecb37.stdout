00329:   end
00330: 
00331:   # Save the result of the battle in a Game Variable (1 by default)
00332:   #    0 - Undecided or aborted
00333:   #    1 - Player won
00334:   #    2 - Player lost
00335:   #    3 - Player or wild Pokémon ran from battle, or player forfeited the match
00336:   #    4 - Wild Pokémon was caught
00337:   #    5 - Draw
00338:   def set_outcome(outcome, outcome_variable = 1, trainer_battle = false)
00339:     case outcome
00340:     when 1, 4   # Won, caught
00341:       $stats.wild_battles_won += 1 if !trainer_battle
00342:       $stats.trainer_battles_won += 1 if trainer_battle
00343:     when 2, 3, 5   # Lost, fled, draw
00344:       $stats.wild_battles_lost += 1 if !trainer_battle
00345:       $stats.trainer_battles_lost += 1 if trainer_battle
00346:     end
00347:     pbSet(outcome_variable, outcome)
00348:   end
00349: end
00350: 
00351: #===============================================================================
00352: # Wild battles
