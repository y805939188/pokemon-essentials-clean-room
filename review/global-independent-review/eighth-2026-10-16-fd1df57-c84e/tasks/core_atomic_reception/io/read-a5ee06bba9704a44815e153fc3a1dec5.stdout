00260:   def can_move_from_coordinate?(start_x, start_y, dir, strict = false)
00261:     case dir
00262:     when 2, 8   # Down, up
00263:       y_diff = (dir == 8) ? @height - 1 : 0
00264:       (start_x...(start_x + @width)).each do |i|
00265:         return false if !passable?(i, start_y - y_diff, dir, strict)
00266:       end
00267:       return true
00268:     when 4, 6   # Left, right
00269:       x_diff = (dir == 6) ? @width - 1 : 0
00270:       ((start_y - @height + 1)..start_y).each do |i|
00271:         return false if !passable?(start_x + x_diff, i, dir, strict)
00272:       end
00273:       return true
00274:     when 1, 3   # Down diagonals
00275:       # Treated as moving down first and then horizontally, because that
00276:       # describes which tiles the character's feet touch
00277:       (start_x...(start_x + @width)).each do |i|
00278:         return false if !passable?(i, start_y, 2, strict)
00279:       end
00280:       x_diff = (dir == 3) ? @width - 1 : 0
00281:       ((start_y - @height + 1)..start_y).each do |i|
00282:         return false if !passable?(start_x + x_diff, i + 1, dir + 3, strict)
00283:       end
00284:       return true
