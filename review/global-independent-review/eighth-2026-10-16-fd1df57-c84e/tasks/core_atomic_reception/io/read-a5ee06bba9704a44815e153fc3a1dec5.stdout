00240:     return false unless self.map.valid?(new_x, new_y)
00241:     return true if @through
00242:     if strict
00243:       return false unless self.map.passableStrict?(x, y, d, self)
00244:       return false unless self.map.passableStrict?(new_x, new_y, 10 - d, self)
00245:     else
00246:       return false unless self.map.passable?(x, y, d, self)
00247:       return false unless self.map.passable?(new_x, new_y, 10 - d, self)
00248:     end
00249:     self.map.events.each_value do |event|
00250:       next if self == event || !event.at_coordinate?(new_x, new_y) || event.through
00251:       return false if self != $game_player || event.character_name != ""
00252:     end
00253:     if $game_player.x == new_x && $game_player.y == new_y &&
00254:        !$game_player.through && @character_name != ""
00255:       return false
00256:     end
00257:     return true
00258:   end
