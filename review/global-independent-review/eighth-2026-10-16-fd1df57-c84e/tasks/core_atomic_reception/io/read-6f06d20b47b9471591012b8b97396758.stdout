00273:   # Heals all HP of this Pokémon.
00274:   def heal_HP
00275:     return if egg?
00276:     @hp = @totalhp
00277:   end
00278: 
00279:   # Heals the status problem of this Pokémon.
00280:   def heal_status
00281:     return if egg?
00282:     @status      = :NONE
00283:     @statusCount = 0
00284:   end
00285: 
00286:   # Restores all PP of this Pokémon. If a move index is given, restores the PP
00287:   # of the move in that index.
00288:   # @param move_index [Integer] index of the move to heal (-1 if all moves
00289:   #   should be healed)
00290:   def heal_PP(move_index = -1)
00291:     return if egg?
00292:     if move_index >= 0
00293:       @moves[move_index].pp = @moves[move_index].total_pp
00294:     else
00295:       @moves.each { |m| m.pp = m.total_pp }
00296:     end
00297:   end
00298: 
00299:   # Heals all HP, PP, and status problems of this Pokémon.
00300:   def heal
00301:     return if egg?
00302:     heal_HP
00303:     heal_status
00304:     heal_PP
00305:     @ready_to_evolve = false
00306:   end
00307: 
