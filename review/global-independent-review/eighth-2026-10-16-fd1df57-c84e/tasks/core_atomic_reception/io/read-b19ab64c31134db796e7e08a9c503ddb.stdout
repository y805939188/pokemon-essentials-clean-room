00191:   def level
00192:     @level = growth_rate.level_from_exp(@exp) if !@level
00193:     return @level
00194:   end
00195: 
00196:   # Sets this Pokémon's level. The given level must be between 1 and the
00197:   # maximum level (defined in {GameData::GrowthRate}).
00198:   # @param value [Integer] new level (between 1 and the maximum level)
00199:   def level=(value)
00200:     if value < 1 || value > GameData::GrowthRate.max_level
00201:       raise ArgumentError.new(_INTL("The level number ({1}) is invalid.", value))
00202:     end
00203:     @exp = growth_rate.minimum_exp_for_level(value)
00204:     @level = value
00205:   end
00206: 
00207:   # Sets this Pokémon's Exp. Points.
00208:   # @param value [Integer] new experience points
00209:   def exp=(value)
00210:     @exp = value
00211:     @level = nil
00212:   end
