00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Creating a battler
00004:   #=============================================================================
00005:   def initialize(btl, idxBattler)
00006:     @battle      = btl
00007:     @index       = idxBattler
00008:     @captured    = false
00009:     @dummy       = false
00010:     @stages      = {}
00011:     @effects     = []
00012:     @damageState = Battle::DamageState.new
00013:     pbInitBlank
00014:     pbInitEffects(false)
00015:   end
00016: 
00017:   def pbInitBlank
00018:     @name           = ""
00019:     @species        = 0
00020:     @form           = 0
00021:     @level          = 0
00022:     @hp = @totalhp  = 0
00023:     @types          = []
00024:     @ability_id     = nil
00025:     @item_id        = nil
00026:     @attack = @defense = @spatk = @spdef = @speed = 0
00027:     @status         = :NONE
00028:     @statusCount    = 0
00029:     @pokemon        = nil
00030:     @pokemonIndex   = -1
00031:     @participants   = []
00032:     @moves          = []
00033:   end
00034: 
00035:   # Used by Future Sight only, when Future Sight's user is no longer in battle.
00036:   def pbInitDummyPokemon(pkmn, idxParty)
00037:     raise _INTL("An egg can't be an active Pokémon.") if pkmn.egg?
00038:     @name         = pkmn.name
00039:     @species      = pkmn.species
00040:     @form         = pkmn.form
00041:     @level        = pkmn.level
00042:     @hp           = pkmn.hp
00043:     @totalhp      = pkmn.totalhp
00044:     @types        = pkmn.types
00045:     # ability and item intentionally not copied across here
00046:     @attack       = pkmn.attack
00047:     @defense      = pkmn.defense
00048:     @spatk        = pkmn.spatk
00049:     @spdef        = pkmn.spdef
00050:     @speed        = pkmn.speed
00051:     @status       = pkmn.status
00052:     @statusCount  = pkmn.statusCount
00053:     @pokemon      = pkmn
00054:     @pokemonIndex = idxParty
00055:     @participants = []
00056:     # moves intentionally not copied across here
00057:     @dummy        = true
00058:   end
