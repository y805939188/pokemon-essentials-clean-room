00022:     },
00023:     {
00024:       "id": "SHOP-SCENE",
00025:       "source": "Data/Scripts/016_UI/020_UI_PokeMart.rb",
00026:       "lines": [
00027:         176,
00028:         576
00029:       ],
00030:       "fact": "Stock list and description/icon presentation, scrolling and refresh retain supplied stock reference. Quantity input wraps +/-1 and changes10 with clamps; initial1 and cancel0. Confirm display uses full quantity*buyprice. Timed feedback waits1.5 seconds except USE; no rendered-pixel claim.",
