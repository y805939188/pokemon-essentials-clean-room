00040:       "id": "SHOP-BUY",
00041:       "source": "Data/Scripts/016_UI/020_UI_PokeMart.rb",
00042:       "lines": [
00043:         577,
00044:         676
00045:       ],
00046:       "fact": "Normal Buy loop: first affordability guard, important quantity1 confirmation or ordinary maximum min(999,floor(money/price)) with free999, explicit qty0/refusal cancel, second affordability check. Add one by one; complete success updates spent money stat and item count then wallet, deletes important owned from aliased stock, messages, bonus. Failure removes just-added prefix one by one, removal failure raises; no purchase stat/wallet update on that branch.",
00047:       "contracts": [
00048:         "WP29 §3.1–3.3/§6",
00049:         "SH01..07/11/18/19"
00050:       ],
00051:       "qualification": "SOURCE_STATIC; NOT_EXECUTED",
00052:       "reader": "/root/creature_b",
00053:       "reading_identity": "reading-ledger.json"
00054:     },
00055:     {
00056:       "id": "SHOP-BONUS",
00057:       "source": "Data/Scripts/016_UI/020_UI_PokeMart.rb",
00058:       "lines": [
00059:         643,
00060:         665
00061:       ],
00062:       "fact": "Premier bonus after purchase commit: quantity>=10 and registered Premier data. Generous mode any PokeBall floor(qty/10), add until failure, actual bonus count increments stat; zero additions still displays zero result. Legacy only POKEBALL one successful extra. No rollback of purchase on bonus capacity failure.",
00063:       "contracts": [
00064:         "WP29 §3.3",
00065:         "SH18/19"
00066:       ],
00067:       "qualification": "SOURCE_STATIC; NOT_EXECUTED",
