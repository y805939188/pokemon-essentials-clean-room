00013:       ],
00014:       "fact": "Adapter gets strict item data; buys positive temporary buy override else data price; sell uses nonnegative sell override else data sell; canSell rejects important or price<=0. Resource setter delegates Player; add/remove are one at a time. Quantity windows begin1, cancel0; ordinary sell upper is held quantity; buying flag controls price shown. Item/machine names and display extras are independent from transaction price.",
00015:       "contracts": [
00016:         "WP29 §2/§5",
00017:         "SH08/12..17/27"
00018:       ],
00019:       "qualification": "SOURCE_STATIC; NOT_EXECUTED",
