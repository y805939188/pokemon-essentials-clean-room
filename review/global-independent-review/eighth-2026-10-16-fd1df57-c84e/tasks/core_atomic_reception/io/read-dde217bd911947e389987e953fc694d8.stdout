00545: 
00546:   def pbOnStartUse(user, targets)
00547:     @finalGambitDamage = user.hp
00548:   end
00549: 
00550:   def pbFixedDamage(user, target)
00551:     return @finalGambitDamage
00552:   end
00553: 
00554:   def pbSelfKO(user)
00555:     return if user.fainted?
00556:     user.pbReduceHP(user.hp, false)
00557:     user.pbItemHPHealCheck
00558:   end
00559: end
00560: 
00561: #===============================================================================
00562: # Decreases the target's Attack and Special Attack by 2 stages each. (Memento)
00563: # User faints (if successful).
00564: #===============================================================================
00565: class Battle::Move::UserFaintsLowerTargetAtkSpAtk2 < Battle::Move::TargetMultiStatDownMove
00566:   def canMagicCoat?; return false; end
00567: 
00568:   def initialize(battle, move)
00569:     super
00570:     @statDown = [:ATTACK, 2, :SPECIAL_ATTACK, 2]
00571:   end
00572: 
00573:   # NOTE: The user faints even if the target's stats cannot be changed, so this
00574:   #       method must always return false to allow the move's usage to continue.
00575:   def pbFailsAgainstTarget?(user, target, show_message)
00576:     return false
00577:   end
00578: 
00579:   def pbSelfKO(user)
00580:     return if user.fainted?
00581:     user.pbReduceHP(user.hp, false)
00582:     user.pbItemHPHealCheck
00583:   end
00584: end
00585: 
00586: #===============================================================================
00587: # User faints. The Pokémon that replaces the user is fully healed (HP and
00588: # status). Fails if user won't be replaced. (Healing Wish)
00589: #===============================================================================
00590: class Battle::Move::UserFaintsHealAndCureReplacement < Battle::Move
00591:   def healingMove?; return true; end
00592:   def canSnatch?;   return true; end
00593: 
00594:   def pbMoveFailed?(user, targets)
00595:     if !@battle.pbCanChooseNonActive?(user.index)
00596:       @battle.pbDisplay(_INTL("But it failed!"))
00597:       return true
00598:     end
00599:     return false
00600:   end
00601: 
00602:   def pbSelfKO(user)
00603:     return if user.fainted?
00604:     user.pbReduceHP(user.hp, false)
00605:     user.pbItemHPHealCheck
00606:     @battle.positions[user.index].effects[PBEffects::HealingWish] = true
00607:   end
00608: end
00609: 
00610: #===============================================================================
00611: # User faints. The Pokémon that replaces the user is fully healed (HP, PP and
00612: # status). Fails if user won't be replaced. (Lunar Dance)
00613: #===============================================================================
00614: class Battle::Move::UserFaintsHealAndCureReplacementRestorePP < Battle::Move
00615:   def healingMove?; return true; end
00616:   def canSnatch?;   return true; end
00617: 
00618:   def pbMoveFailed?(user, targets)
00619:     if !@battle.pbCanChooseNonActive?(user.index)
00620:       @battle.pbDisplay(_INTL("But it failed!"))
00621:       return true
00622:     end
00623:     return false
00624:   end
00625: 
00626:   def pbSelfKO(user)
00627:     return if user.fainted?
00628:     user.pbReduceHP(user.hp, false)
00629:     user.pbItemHPHealCheck
00630:     @battle.positions[user.index].effects[PBEffects::LunarDance] = true
00631:   end
00632: end
