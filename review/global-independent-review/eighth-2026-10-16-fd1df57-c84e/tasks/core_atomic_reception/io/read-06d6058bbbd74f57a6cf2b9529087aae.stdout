00270:   ivscore = (ivscore * 100).floor
00271:   hpscore = (100.0 * pkmn.hp / pkmn.totalhp).floor
00272:   catch_rate = pkmn.species_data.catch_rate
00273:   rarescore = 60
00274:   rarescore += 20 if catch_rate <= 120
00275:   rarescore += 20 if catch_rate <= 60
00276:   return levelscore + ivscore + hpscore + rarescore
00277: end
00278: 
00279: def pbBugContestState
00280:   if !$PokemonGlobal.bugContestState
00281:     $PokemonGlobal.bugContestState = BugContestState.new
00282:   end
00283:   return $PokemonGlobal.bugContestState
00284: end
00285: 
00286: # Returns true if the Bug-Catching Contest in progress
00287: def pbInBugContest?
00288:   return pbBugContestState.inProgress?
00289: end
00290: 
00291: # Returns true if the Bug-Catching Contest in progress and has not yet been judged
00292: def pbBugContestUndecided?
00293:   return pbBugContestState.undecided?
00294: end
