00433: 
00434:   #=============================================================================
00435:   # End Of Round end effects that apply to the whole field
00436:   #=============================================================================
00437:   def pbEORCountDownFieldEffect(effect, msg)
00438:     return if @field.effects[effect] <= 0
00439:     @field.effects[effect] -= 1
00440:     return if @field.effects[effect] > 0
00441:     pbDisplay(msg)
00442:     if effect == PBEffects::MagicRoom
00443:       pbPriority(true).each { |battler| battler.pbItemTerrainStatBoostCheck }
00444:     end
00445:   end
00446: 
00447:   def pbEOREndFieldEffects(priority)
00448:     # Trick Room
00449:     pbEORCountDownFieldEffect(PBEffects::TrickRoom,
00450:                               _INTL("The twisted dimensions returned to normal!"))
00451:     # Gravity
00452:     pbEORCountDownFieldEffect(PBEffects::Gravity,
00453:                               _INTL("Gravity returned to normal!"))
00454:     # Water Sport
00455:     pbEORCountDownFieldEffect(PBEffects::WaterSportField,
00456:                               _INTL("The effects of Water Sport have faded."))
00457:     # Mud Sport
00458:     pbEORCountDownFieldEffect(PBEffects::MudSportField,
00459:                               _INTL("The effects of Mud Sport have faded."))
00460:     # Wonder Room
00461:     pbEORCountDownFieldEffect(PBEffects::WonderRoom,
00462:                               _INTL("Wonder Room wore off, and Defense and Sp. Def stats returned to normal!"))
00463:     # Magic Room
00464:     pbEORCountDownFieldEffect(PBEffects::MagicRoom,
00465:                               _INTL("Magic Room wore off, and held items' effects returned to normal!"))
00466:   end
