00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Decide whether the trainer is allowed to tell the Pokémon to use the given
00004:   # move. Called when choosing a command for the round.
00005:   # Also called when processing the Pokémon's action, because these effects also
00006:   # prevent Pokémon action. Relevant because these effects can become active
00007:   # earlier in the same round (after choosing the command but before using the
00008:   # move) or an unusable move may be called by another move such as Metronome.
00009:   #=============================================================================
00010:   def pbCanChooseMove?(move, commandPhase, showMessages = true, specialUsage = false)
00011:     # Disable
00012:     if @effects[PBEffects::DisableMove] == move.id && !specialUsage
00013:       if showMessages
00014:         msg = _INTL("{1}'s {2} is disabled!", pbThis, move.name)
00015:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00016:       end
00017:       return false
00018:     end
00019:     # Heal Block
00020:     if @effects[PBEffects::HealBlock] > 0 && move.healingMove?
00021:       if showMessages
00022:         msg = _INTL("{1} can't use {2} because of Heal Block!", pbThis, move.name)
00023:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00024:       end
00025:       return false
00026:     end
00027:     # Gravity
00028:     if @battle.field.effects[PBEffects::Gravity] > 0 && move.unusableInGravity?
00029:       if showMessages
00030:         msg = _INTL("{1} can't use {2} because of gravity!", pbThis, move.name)
00031:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00032:       end
00033:       return false
00034:     end
00035:     # Throat Chop
00036:     if @effects[PBEffects::ThroatChop] > 0 && move.soundMove?
00037:       if showMessages
00038:         msg = _INTL("{1} can't use {2} because of Throat Chop!", pbThis, move.name)
00039:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00040:       end
