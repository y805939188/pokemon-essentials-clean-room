00038:       "source": "001_Settings.rb:17",
00039:       "meaning": "MECHANICS_GENERATION=8 current declaration; derived settings evaluate this when their declarations execute. This is not an ongoing dynamic observer for later edits."
00040:     },
00041:     {
00042:       "id": "KERNEL-CORE-CONFIG-02",
00043:       "source": "001_Settings.rb:72",
00044:       "meaning": "TIME_SHADING=true boolean declaration; actual rendering/timing consumer and host effects separate."
00045:     },
00046:     {
00047:       "id": "KERNEL-CORE-CONFIG-03",
00048:       "source": "001_Settings.rb:220",
00049:       "meaning": "MAX_PARTY_SIZE=6 integer declaration; each caller allocation/guard may have separate local conditions. No claim all party arrays forcibly have6 members."
00050:     },
00051:     {
00052:       "id": "KERNEL-CORE-CONFIG-04",
00053:       "source": "001_Settings.rb:370",
00054:       "meaning": "OVERWORLD_WEATHER_SETS_BATTLE_TERRAIN=(MECHANICS_GENERATION>=8), so current declaration evaluates true. Existing battle-environment consumers determine applicability; no invented weather/terrain rewrite."
00055:     },
00056:     {
00057:       "id": "KERNEL-CORE-CONFIG-05",
00058:       "source": "002_BattleSettings.rb:125",
00059:       "meaning": "NO_MONEY_LOSS=33 is a Game Switch numeric identifier, not true/false or a declaration that money loss is disabled. CORE pbLoseMoney reads game_switches[33]."
00060:     },
00061:     {
00062:       "id": "KERNEL-CORE-CONFIG-06",
00063:       "source": "Game_Switches complete1–25",
00064:       "meaning": "Constructor @data=[]; getter returns stored truthy @data[id] only when id<=5000, otherwise false. Newly constructed absent slot33 therefore false. Setter stores raw value for id<=5000, with no local type/lowerbound/boolean normalization. false/nil read false, other truthy values returned as stored. Existing/loaded game state may differ from newly constructed absent state; class definition does not force saved33 off."
00065:     }
00066:   ],
