00104:   def pbSetPP(move, pp)
00105:     move.pp = pp
00106:     # No need to care about @effects[PBEffects::Mimic], since Mimic can't copy
00107:     # Mimic
00108:     if move.realMove && move.id == move.realMove.id && !@effects[PBEffects::Transform]
00109:       move.realMove.pp = pp
00110:     end
00111:   end
00112: 
00113:   def pbReducePP(move)
00114:     return true if usingMultiTurnAttack?
00115:     return true if move.pp < 0          # Don't reduce PP for special calls of moves
00116:     return true if move.total_pp <= 0   # Infinite PP, can always be used
00117:     return false if move.pp == 0        # Ran out of PP, couldn't reduce
00118:     pbSetPP(move, move.pp - 1) if move.pp > 0
00119:     return true
00120:   end
00121: 
00122:   def pbReducePPOther(move)
00123:     pbSetPP(move, move.pp - 1) if move.pp > 0
00124:   end
00125: 
00126:   #=============================================================================
00127:   # Change type
00128:   #=============================================================================
00129:   def pbChangeTypes(newType)
00130:     if newType.is_a?(Battle::Battler)
00131:       newTypes = newType.pbTypes
00132:       newTypes.push(:NORMAL) if newTypes.length == 0
00133:       newExtraType = newType.effects[PBEffects::ExtraType]
00134:       newExtraType = nil if newTypes.include?(newExtraType)
00135:       @types = newTypes.clone
00136:       @effects[PBEffects::ExtraType] = newExtraType
00137:     else
00138:       newType = GameData::Type.get(newType).id
00139:       @types = [newType]
00140:       @effects[PBEffects::ExtraType] = nil
00141:     end
00142:     @effects[PBEffects::BurnUp] = false
00143:     @effects[PBEffects::Roost]  = false
00144:   end
00145: 
00146:   def pbResetTypes
00147:     @types = @pokemon.types
00148:     @effects[PBEffects::ExtraType] = nil
00149:     @effects[PBEffects::BurnUp] = false
00150:     @effects[PBEffects::Roost]  = false
00151:   end
00152: 
00153:   #=============================================================================
00154:   # Forms
00155:   #=============================================================================
00156:   def pbChangeForm(newForm, msg)
00157:     return if fainted? || @effects[PBEffects::Transform] || @form == newForm
00158:     oldForm = @form
00159:     oldDmg = @totalhp - @hp
00160:     self.form = newForm
00161:     pbUpdate(true)
00162:     @hp = @totalhp - oldDmg
00163:     @effects[PBEffects::WeightChange] = 0 if Settings::MECHANICS_GENERATION >= 6
00164:     @battle.scene.pbChangePokemon(self, @pokemon)
00165:     @battle.scene.pbRefreshOne(@index)
00166:     @battle.pbDisplay(msg) if msg && msg != ""
00167:     PBDebug.log("[Form changed] #{pbThis} changed from form #{oldForm} to form #{newForm}")
00168:     @battle.pbSetSeen(self)
00169:   end
00170: 
00171:   def pbCheckFormOnStatusChange
00172:     return if fainted? || @effects[PBEffects::Transform]
00173:     # Shaymin - reverts if frozen
00174:     if isSpecies?(:SHAYMIN) && frozen?
00175:       pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00176:     end
00177:   end
00178: 
00179:   def pbCheckFormOnMovesetChange
00180:     return if fainted? || @effects[PBEffects::Transform]
