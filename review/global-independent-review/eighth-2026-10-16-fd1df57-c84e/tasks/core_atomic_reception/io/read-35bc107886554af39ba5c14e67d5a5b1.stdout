00341: class Battle::Move::HealUserPositionNextTurn < Battle::Move
00342:   def healingMove?; return true; end
00343:   def canSnatch?;   return true; end
00344: 
00345:   def pbMoveFailed?(user, targets)
00346:     if @battle.positions[user.index].effects[PBEffects::Wish] > 0
00347:       @battle.pbDisplay(_INTL("But it failed!"))
00348:       return true
00349:     end
00350:     return false
00351:   end
00352: 
00353:   def pbEffectGeneral(user)
00354:     @battle.positions[user.index].effects[PBEffects::Wish]       = 2
00355:     @battle.positions[user.index].effects[PBEffects::WishAmount] = (user.totalhp / 2.0).round
00356:     @battle.positions[user.index].effects[PBEffects::WishMaker]  = user.pokemonIndex
00357:   end
00358: end
00359: 
00360: #===============================================================================
00361: # Rings the user. Ringed Pokémon gain 1/16 of max HP at the end of each round.
00362: # (Aqua Ring)
00363: #===============================================================================
00364: class Battle::Move::StartHealUserEachTurn < Battle::Move
00365:   def canSnatch?; return true; end
