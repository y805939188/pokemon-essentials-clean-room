00001: #===============================================================================
00002: # CanUseInBattle handlers
00003: #===============================================================================
00004: ItemHandlers::CanUseInBattle.add(:GUARDSPEC, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00005:   if !battler || battler.pbOwnSide.effects[PBEffects::Mist] > 0
00006:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00007:     next false
00008:   end
00009:   next true
00010: })
00011: 
00012: ItemHandlers::CanUseInBattle.add(:POKEDOLL, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00013:   if !battle.wildBattle?
00014:     if showMessages
00015:       scene.pbDisplay(_INTL("Oak's words echoed... There's a time and place for everything! But not now."))
00016:     end
00017:     next false
00018:   end
00019:   if !battle.canRun
00020:     scene.pbDisplay(_INTL("You can't escape!")) if showMessages
00021:     next false
00022:   end
00023:   next true
00024: })
00025: 
00026: ItemHandlers::CanUseInBattle.copy(:POKEDOLL, :FLUFFYTAIL, :POKETOY)
00027: 
00028: ItemHandlers::CanUseInBattle.addIf(:poke_balls,
00029:   proc { |item| GameData::Item.get(item).is_poke_ball? },
00030:   proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00031:     if battle.pbPlayer.party_full? && $PokemonStorage.full?
00032:       scene.pbDisplay(_INTL("There is no room left in the PC!")) if showMessages
00033:       next false
00034:     end
00035:     if battle.disablePokeBalls
00036:       scene.pbDisplay(_INTL("You can't throw a Poké Ball!")) if showMessages
00037:       next false
00038:     end
00039:     # NOTE: Using a Poké Ball consumes all your actions for the round. The code
00040:     #       below is one half of making this happen; the other half is in def
00041:     #       pbItemUsesAllActions?.
00042:     if !firstAction
00043:       scene.pbDisplay(_INTL("It's impossible to aim without being focused!")) if showMessages
00044:       next false
00045:     end
00046:     if battler.semiInvulnerable?
00047:       scene.pbDisplay(_INTL("It's no good! It's impossible to aim at a Pokémon that's not in sight!")) if showMessages
00048:       next false
00049:     end
00050:     # NOTE: The code below stops you from throwing a Poké Ball if there is more
00051:     #       than one unfainted opposing Pokémon. (Snag Balls can be thrown in
00052:     #       this case, but only in trainer battles, and the trainer will deflect
00053:     #       them if they are trying to catch a non-Shadow Pokémon.)
00054:     if battle.pbOpposingBattlerCount > 1 && !(GameData::Item.get(item).is_snag_ball? && battle.trainerBattle?)
00055:       if battle.pbOpposingBattlerCount == 2
00056:         scene.pbDisplay(_INTL("It's no good! It's impossible to aim when there are two Pokémon!")) if showMessages
00057:       elsif showMessages
00058:         scene.pbDisplay(_INTL("It's no good! It's impossible to aim when there is more than one Pokémon!"))
00059:       end
00060:       next false
00061:     end
00062:     next true
00063:   }
00064: )
00065: 
00066: ItemHandlers::CanUseInBattle.add(:POTION, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00067:   if !pokemon.able? || pokemon.hp == pokemon.totalhp
00068:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00069:     next false
00070:   end
00071:   next true
00072: })
00073: 
00074: ItemHandlers::CanUseInBattle.copy(:POTION,
00075:                                   :SUPERPOTION, :HYPERPOTION, :MAXPOTION,
00076:                                   :BERRYJUICE, :SWEETHEART, :FRESHWATER, :SODAPOP,
00077:                                   :LEMONADE, :MOOMOOMILK, :ORANBERRY, :SITRUSBERRY,
00078:                                   :ENERGYPOWDER, :ENERGYROOT)
00079: ItemHandlers::CanUseInBattle.copy(:POTION, :RAGECANDYBAR) if !Settings::RAGE_CANDY_BAR_CURES_STATUS_PROBLEMS
00080: 
00081: ItemHandlers::CanUseInBattle.add(:AWAKENING, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00082:   next pbBattleItemCanCureStatus?(:SLEEP, pokemon, scene, showMessages)
00083: })
00084: 
00085: ItemHandlers::CanUseInBattle.copy(:AWAKENING, :CHESTOBERRY)
00086: 
00087: ItemHandlers::CanUseInBattle.add(:BLUEFLUTE, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00088:   if battler&.hasActiveAbility?(:SOUNDPROOF)
00089:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00090:     next false
00091:   end
00092:   next pbBattleItemCanCureStatus?(:SLEEP, pokemon, scene, showMessages)
00093: })
00094: 
