00119: ItemHandlers::CanUseInBattle.add(:FULLHEAL, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00120:   if !pokemon.able? ||
00121:      (pokemon.status == :NONE &&
00122:      (!battler || battler.effects[PBEffects::Confusion] == 0))
00123:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00124:     next false
00125:   end
00126:   next true
00127: })
00128: 
00129: ItemHandlers::CanUseInBattle.copy(:FULLHEAL,
00130:                                   :LAVACOOKIE, :OLDGATEAU, :CASTELIACONE,
00131:                                   :LUMIOSEGALETTE, :SHALOURSABLE, :BIGMALASADA,
00132:                                   :PEWTERCRUNCHIES, :LUMBERRY, :HEALPOWDER)
00133: ItemHandlers::CanUseInBattle.copy(:FULLHEAL, :RAGECANDYBAR) if Settings::RAGE_CANDY_BAR_CURES_STATUS_PROBLEMS
00134: 
00135: ItemHandlers::CanUseInBattle.add(:FULLRESTORE, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00136:   if !pokemon.able? ||
00137:      (pokemon.hp == pokemon.totalhp && pokemon.status == :NONE &&
00138:      (!battler || battler.effects[PBEffects::Confusion] == 0))
00139:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00140:     next false
00141:   end
00142:   next true
00143: })
00144: 
00145: ItemHandlers::CanUseInBattle.add(:REVIVE, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00146:   if !pokemon.fainted?
00147:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00148:     next false
00149:   end
00150:   next true
00151: })
00152: 
00153: ItemHandlers::CanUseInBattle.copy(:REVIVE, :MAXREVIVE, :REVIVALHERB, :MAXHONEY)
00154: 
00155: ItemHandlers::CanUseInBattle.add(:ETHER, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00156:   if !pokemon.able? || move < 0 ||
00157:      pokemon.moves[move].total_pp <= 0 ||
00158:      pokemon.moves[move].pp == pokemon.moves[move].total_pp
00159:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00160:     next false
00161:   end
00162:   next true
00163: })
00164: 
00165: ItemHandlers::CanUseInBattle.copy(:ETHER, :MAXETHER, :LEPPABERRY)
00166: 
00167: ItemHandlers::CanUseInBattle.add(:ELIXIR, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00168:   if !pokemon.able?
00169:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00170:     next false
00171:   end
00172:   canRestore = false
00173:   pokemon.moves.each do |m|
00174:     next if m.id == 0
00175:     next if m.total_pp <= 0 || m.pp == m.total_pp
00176:     canRestore = true
00177:     break
00178:   end
00179:   if !canRestore
00180:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00181:     next false
00182:   end
00183:   next true
00184: })
00185: 
00186: ItemHandlers::CanUseInBattle.copy(:ELIXIR, :MAXELIXIR)
00187: 
00188: ItemHandlers::CanUseInBattle.add(:REDFLUTE, proc { |item, pokemon, battler, move, firstAction, battle, scene, showMessages|
00189:   if !battler || battler.effects[PBEffects::Attract] < 0 ||
00190:      battler.hasActiveAbility?(:SOUNDPROOF)
00191:     scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00192:     next false
00193:   end
00194:   next true
00195: })
