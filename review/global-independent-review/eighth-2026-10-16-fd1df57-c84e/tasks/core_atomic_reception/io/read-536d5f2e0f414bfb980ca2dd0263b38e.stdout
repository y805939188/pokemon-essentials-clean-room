00085:   def ineffective?(value)
00086:     return value == INEFFECTIVE_MULTIPLIER
00087:   end
00088: 
00089:   def not_very_effective?(value)
00090:     return value > INEFFECTIVE_MULTIPLIER && value < NORMAL_EFFECTIVE_MULTIPLIER
00091:   end
00092: 
00093:   def resistant?(value)
00094:     return value < NORMAL_EFFECTIVE_MULTIPLIER
00095:   end
00096: 
00097:   def normal?(value)
00098:     return value == NORMAL_EFFECTIVE_MULTIPLIER
00099:   end
00100: 
00101:   def super_effective?(value)
00102:     return value > NORMAL_EFFECTIVE_MULTIPLIER
00103:   end
00104: 
00105:   def ineffective_type?(attack_type, *defend_types)
00106:     value = calculate(attack_type, *defend_types)
00107:     return ineffective?(value)
00108:   end
00109: 
00110:   def not_very_effective_type?(attack_type, *defend_types)
00111:     value = calculate(attack_type, *defend_types)
00112:     return not_very_effective?(value)
00113:   end
00114: 
00115:   def resistant_type?(attack_type, *defend_types)
00116:     value = calculate(attack_type, *defend_types)
00117:     return resistant?(value)
00118:   end
00119: 
00120:   def normal_type?(attack_type, *defend_types)
00121:     value = calculate(attack_type, *defend_types)
00122:     return normal?(value)
00123:   end
00124: 
00125:   def super_effective_type?(attack_type, *defend_types)
00126:     value = calculate(attack_type, *defend_types)
00127:     return super_effective?(value)
00128:   end
00129: 
00130:   def get_type_effectiveness(attack_type, defend_type)
00131:     return GameData::Type.get(defend_type).effectiveness(attack_type)
00132:   end
00133: 
00134:   def calculate(attack_type, *defend_types)
00135:     ret = NORMAL_EFFECTIVE_MULTIPLIER
00136:     defend_types.each do |type|
00137:       ret *= get_type_effectiveness(attack_type, type) / NORMAL_EFFECTIVE.to_f
00138:     end
00139:     return ret
00140:   end
00141: end
