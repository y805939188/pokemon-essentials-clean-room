01826: class Battle::Move::StartUserSideImmunityToStatStageLowering < Battle::Move
01827:   def canSnatch?; return true; end
01828: 
01829:   def pbMoveFailed?(user, targets)
01830:     if user.pbOwnSide.effects[PBEffects::Mist] > 0
01831:       @battle.pbDisplay(_INTL("But it failed!"))
01832:       return true
01833:     end
01834:     return false
01835:   end
01836: 
01837:   def pbEffectGeneral(user)
01838:     user.pbOwnSide.effects[PBEffects::Mist] = 5
01839:     @battle.pbDisplay(_INTL("{1} became shrouded in mist!", user.pbTeam))
01840:   end
01841: end
01842: 
