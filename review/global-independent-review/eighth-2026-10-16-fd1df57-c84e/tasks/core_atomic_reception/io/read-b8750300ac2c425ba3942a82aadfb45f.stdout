00355: 
00356: #===============================================================================
00357: # Powders the foe. This round, if it uses a Fire move, it loses 1/4 of its max
00358: # HP instead. (Powder)
00359: #===============================================================================
00360: class Battle::Move::TargetNextFireMoveDamagesTarget < Battle::Move
00361:   def ignoresSubstitute?(user); return true; end
00362:   def canMagicCoat?;            return true; end
00363: 
00364:   def pbFailsAgainstTarget?(user, target, show_message)
00365:     if target.effects[PBEffects::Powder]
00366:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00367:       return true
00368:     end
00369:     return false
00370:   end
00371: 
00372:   def pbEffectAgainstTarget(user, target)
00373:     target.effects[PBEffects::Powder] = true
00374:     @battle.pbDisplay(_INTL("{1} is covered in powder!", user.pbThis))
00375:   end
00376: end
00377: 
00378: #===============================================================================
