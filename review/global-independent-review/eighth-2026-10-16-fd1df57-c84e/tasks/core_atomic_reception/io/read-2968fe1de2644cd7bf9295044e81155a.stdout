00201: end
00202: 
00203: #===============================================================================
00204: #
00205: #===============================================================================
00206: class Battle::AI
00207:   attr_accessor :battleArena
00208: 
00209:   unless method_defined?(:_battleArena_pbChooseToSwitchOut)
00210:     alias _battleArena_pbChooseToSwitchOut pbChooseToSwitchOut
00211:   end
00212: 
00213:   def pbChooseToSwitchOut(force_switch = false)
00214:     return _battleArena_pbChooseToSwitchOut(force_switch) if !@battleArena
00215:     return false
00216:   end
00217: end
00218: 
00219: #===============================================================================
00220: #
00221: #===============================================================================
00222: class Battle::Scene
00223:   def pbBattleArenaUpdate
00224:     pbGraphicsUpdate
00225:   end
00226: 
00227:   def updateJudgment(window, phase, battler1, battler2, ratings1, ratings2)
00228:     total1 = 0
00229:     total2 = 0
00230:     phase.times do |i|
00231:       total1 += ratings1[i]
00232:       total2 += ratings2[i]
00233:     end
00234:     window.contents.clear
00235:     pbSetSystemFont(window.contents)
00236:     textpos = [
00237:       [battler1.name, 64, 6, :center, Color.new(248, 0, 0), Color.new(208, 208, 200)],
00238:       [_INTL("VS"), 144, 6, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00239:       [battler2.name, 224, 6, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00240:       [_INTL("Mind"), 144, 54, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00241:       [_INTL("Skill"), 144, 86, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00242:       [_INTL("Body"), 144, 118, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00243:       [total1.to_s, 64, 166, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00244:       [_INTL("Judgment"), 144, 166, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)],
00245:       [total2.to_s, 224, 166, :center, Color.new(72, 72, 72), Color.new(208, 208, 200)]
00246:     ]
00247:     pbDrawTextPositions(window.contents, textpos)
00248:     images = []
00249:     phase.times do |i|
00250:       y = [48, 80, 112][i]
00251:       x = (ratings1[i] == ratings2[i]) ? 64 : ((ratings1[i] > ratings2[i]) ? 0 : 32)
00252:       images.push(["Graphics/UI/Battle/judgment", 64 - 16, y, x, 0, 32, 32])
00253:       x = (ratings1[i] == ratings2[i]) ? 64 : ((ratings1[i] < ratings2[i]) ? 0 : 32)
00254:       images.push(["Graphics/UI/Battle/judgment", 224 - 16, y, x, 0, 32, 32])
00255:     end
00256:     pbDrawImagePositions(window.contents, images)
00257:     window.contents.fill_rect(16, 150, 256, 4, Color.new(80, 80, 80))
00258:   end
00259: 
00260:   def pbBattleArenaBattlers(battler1, battler2)
00261:     pbMessage(_INTL("REFEREE: {1} VS {2}!\nCommence battling!",
00262:                     battler1.name, battler2.name) + "\\wtnp[10]") { pbBattleArenaUpdate }
00263:   end
00264: 
00265:   def pbBattleArenaJudgment(battler1, battler2, ratings1, ratings2)
00266:     msgwindow  = nil
00267:     dimmingvp  = nil
00268:     infowindow = nil
00269:     begin
00270:       msgwindow = pbCreateMessageWindow
00271:       dimmingvp = Viewport.new(0, 0, Graphics.width, Graphics.height - msgwindow.height)
00272:       pbMessageDisplay(msgwindow,
00273:                        _INTL("REFEREE: That's it! We will now go to judging to determine the winner!") + "\\wtnp[10]") do
00274:         pbBattleArenaUpdate
00275:         dimmingvp.update
00276:       end
00277:       dimmingvp.z = 99999
00278:       infowindow = SpriteWindow_Base.new(80, 0, 320, 224)
00279:       infowindow.contents = Bitmap.new(infowindow.width - infowindow.borderX,
00280:                                        infowindow.height - infowindow.borderY)
00281:       infowindow.z        = 99999
00282:       infowindow.visible  = false
00283:       11.times do |i|
00284:         pbGraphicsUpdate
00285:         pbInputUpdate
00286:         msgwindow.update
00287:         dimmingvp.update
00288:         dimmingvp.color = Color.new(0, 0, 0, i * 128 / 10)
00289:       end
00290:       updateJudgment(infowindow, 0, battler1, battler2, ratings1, ratings2)
00291:       infowindow.visible = true
00292:       11.times do |i|
00293:         pbGraphicsUpdate
00294:         pbInputUpdate
00295:         msgwindow.update
00296:         dimmingvp.update
00297:         infowindow.update
00298:       end
00299:       updateJudgment(infowindow, 1, battler1, battler2, ratings1, ratings2)
00300:       pbMessageDisplay(msgwindow,
00301:                        _INTL("REFEREE: Judging category 1, Mind!\nThe Pokémon showing the most guts!") + "\\wtnp[20]") do
00302:         pbBattleArenaUpdate
00303:         dimmingvp.update
00304:         infowindow.update
00305:       end
00306:       updateJudgment(infowindow, 2, battler1, battler2, ratings1, ratings2)
00307:       pbMessageDisplay(msgwindow,
00308:                        _INTL("REFEREE: Judging category 2, Skill!\nThe Pokémon using moves the best!") + "\\wtnp[20]") do
00309:         pbBattleArenaUpdate
00310:         dimmingvp.update
00311:         infowindow.update
00312:       end
00313:       updateJudgment(infowindow, 3, battler1, battler2, ratings1, ratings2)
00314:       pbMessageDisplay(msgwindow,
00315:                        _INTL("REFEREE: Judging category 3, Body!\nThe Pokémon with the most vitality!") + "\\wtnp[20]") do
00316:         pbBattleArenaUpdate
00317:         dimmingvp.update
00318:         infowindow.update
00319:       end
00320:       total1 = 0
00321:       total2 = 0
00322:       3.times do |i|
00323:         total1 += ratings1[i]
00324:         total2 += ratings2[i]
00325:       end
00326:       if total1 == total2
00327:         pbMessageDisplay(msgwindow,
00328:                          _INTL("REFEREE: Judgment: {1} to {2}!\nWe have a draw!", total1, total2) + "\\wtnp[20]") do
00329:           pbBattleArenaUpdate
00330:           dimmingvp.update
00331:           infowindow.update
00332:         end
00333:       elsif total1 > total2
00334:         pbMessageDisplay(msgwindow,
00335:                          _INTL("REFEREE: Judgment: {1} to {2}!\nThe winner is {3}'s {4}!",
00336:                                total1, total2, @battle.pbGetOwnerName(battler1.index), battler1.name) + "\\wtnp[20]") do
00337:           pbBattleArenaUpdate
00338:           dimmingvp.update
00339:           infowindow.update
00340:         end
00341:       else
00342:         pbMessageDisplay(msgwindow,
00343:                          _INTL("REFEREE: Judgment: {1} to {2}!\nThe winner is {3}!",
00344:                                total1, total2, battler2.name) + "\\wtnp[20]") do
00345:           pbBattleArenaUpdate
00346:           dimmingvp.update
00347:           infowindow.update
00348:         end
00349:       end
00350:       infowindow.visible = false
00351:       msgwindow.visible  = false
00352:       11.times do |i|
00353:         pbGraphicsUpdate
00354:         pbInputUpdate
00355:         msgwindow.update
00356:         dimmingvp.update
00357:         dimmingvp.color = Color.new(0, 0, 0, (10 - i) * 128 / 10)
00358:       end
00359:     ensure
00360:       pbDisposeMessageWindow(msgwindow)
00361:       dimmingvp.dispose
00362:       infowindow&.contents&.dispose
00363:       infowindow&.dispose
00364:     end
00365:   end
00366: end
