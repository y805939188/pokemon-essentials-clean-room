00075:   # Called when the usage of various multi-turn moves is disrupted due to
00076:   # failing pbTryUseMove, being ineffective against all targets, or because
00077:   # Pursuit was used specially to intercept a switching foe.
00078:   # Cancels the use of multi-turn moves and counters thereof. Note that Hyper
00079:   # Beam's effect is NOT cancelled.
00080:   def pbCancelMoves(full_cancel = false)
00081:     # Outragers get confused anyway if they are disrupted during their final
00082:     # turn of using the move
00083:     if @effects[PBEffects::Outrage] == 1 && pbCanConfuseSelf?(false) && !full_cancel
00084:       pbConfuse(_INTL("{1} became confused due to fatigue!", pbThis))
00085:     end
00086:     # Cancel usage of most multi-turn moves
00087:     @effects[PBEffects::TwoTurnAttack] = nil
00088:     @effects[PBEffects::Rollout]       = 0
00089:     @effects[PBEffects::Outrage]       = 0
00090:     @effects[PBEffects::Uproar]        = 0
00091:     @effects[PBEffects::Bide]          = 0
00092:     @currentMove = nil if @effects[PBEffects::HyperBeam] == 0
00093:     # Reset counters for moves which increase them when used in succession
00094:     @effects[PBEffects::FuryCutter] = 0
00095:   end
00096: 
00097:   def pbEndTurn(_choice)
00098:     @lastRoundMoved = @battle.turnCount   # Done something this round
00099:     if !@effects[PBEffects::ChoiceBand] &&
00100:        (hasActiveItem?([:CHOICEBAND, :CHOICESPECS, :CHOICESCARF]) ||
00101:        hasActiveAbility?(:GORILLATACTICS))
00102:       if @lastMoveUsed && pbHasMove?(@lastMoveUsed)
00103:         @effects[PBEffects::ChoiceBand] = @lastMoveUsed
00104:       elsif @lastRegularMoveUsed && pbHasMove?(@lastRegularMoveUsed)
00105:         @effects[PBEffects::ChoiceBand] = @lastRegularMoveUsed
00106:       end
00107:     end
00108:     @effects[PBEffects::BeakBlast]   = false
00109:     @effects[PBEffects::Charge]      = 0 if @effects[PBEffects::Charge] == 1
00110:     @effects[PBEffects::GemConsumed] = nil
00111:     @effects[PBEffects::ShellTrap]   = false
00112:     @battle.allBattlers.each { |b| b.pbContinualAbilityChecks }   # Trace, end primordial weathers
00113:   end
