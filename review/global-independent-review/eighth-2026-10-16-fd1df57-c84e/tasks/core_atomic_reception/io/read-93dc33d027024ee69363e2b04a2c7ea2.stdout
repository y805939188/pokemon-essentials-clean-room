00587: def pbCancelVehicles(destination = nil, cancel_swimming = true)
00588:   $PokemonGlobal.surfing = false if cancel_swimming
00589:   $PokemonGlobal.diving  = false if cancel_swimming
00590:   $PokemonGlobal.bicycle = false if !destination || !pbCanUseBike?(destination)
00591:   pbUpdateVehicle
00592: end
00593: 
00594: def pbCanUseBike?(map_id)
00595:   map_metadata = GameData::MapMetadata.try_get(map_id)
00596:   return false if !map_metadata
00597:   return map_metadata.always_bicycle || map_metadata.can_bicycle || map_metadata.outdoor_map
00598: end
00599: 
00600: def pbMountBike
00601:   return if $PokemonGlobal.bicycle
00602:   $PokemonGlobal.bicycle = true
00603:   $stats.cycle_count += 1
00604:   pbUpdateVehicle
00605:   bike_bgm = GameData::Metadata.get.bicycle_BGM
00606:   pbCueBGM(bike_bgm, 0.4) if bike_bgm
00607:   pbSEPlay("Bicycle")
00608:   pbPokeRadarCancel
00609: end
00610: 
00611: def pbDismountBike
00612:   return if !$PokemonGlobal.bicycle
00613:   $PokemonGlobal.bicycle = false
00614:   pbUpdateVehicle
00615:   $game_map.autoplayAsCue
00616: end
