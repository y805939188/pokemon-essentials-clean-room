00602:   def affectedByContactEffect?(showMsg = false)
00603:     return false if fainted?
00604:     if hasActiveItem?(:PROTECTIVEPADS)
00605:       @battle.pbDisplay(_INTL("{1} protected itself with the {2}!", pbThis, itemName)) if showMsg
00606:       return false
00607:     end
00608:     return true
00609:   end
00610: 
00611:   def trappedInBattle?
00612:     return true if @effects[PBEffects::Trapping] > 0
00613:     return true if @effects[PBEffects::MeanLook] >= 0
00614:     return true if @effects[PBEffects::JawLock] >= 0
00615:     return true if @battle.allBattlers.any? { |b| b.effects[PBEffects::JawLock] == @index }
00616:     return true if @effects[PBEffects::Octolock] >= 0
00617:     return true if @effects[PBEffects::Ingrain]
00618:     return true if @effects[PBEffects::NoRetreat]
00619:     return true if @battle.field.effects[PBEffects::FairyLock] > 0
00620:     return false
00621:   end
00622: 
00623:   def movedThisRound?
00624:     return @lastRoundMoved && @lastRoundMoved == @battle.turnCount
00625:   end
