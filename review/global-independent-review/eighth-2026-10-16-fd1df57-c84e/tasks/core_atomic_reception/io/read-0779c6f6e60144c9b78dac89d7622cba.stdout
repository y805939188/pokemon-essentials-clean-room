00299:   #=============================================================================
00300:   # Initial success check against the target. Done once before the first hit.
00301:   # Includes move-specific failure conditions, protections and type immunities.
00302:   #=============================================================================
00303:   def pbSuccessCheckAgainstTarget(move, user, target, targets)
00304:     show_message = move.pbShowFailMessages?(targets)
00305:     typeMod = move.pbCalcTypeMod(move.calcType, user, target)
00306:     target.damageState.typeMod = typeMod
00307:     # Two-turn attacks can't fail here in the charging turn
00308:     return true if user.effects[PBEffects::TwoTurnAttack]
00309:     # Move-specific failures
00310:     if move.pbFailsAgainstTarget?(user, target, show_message)
