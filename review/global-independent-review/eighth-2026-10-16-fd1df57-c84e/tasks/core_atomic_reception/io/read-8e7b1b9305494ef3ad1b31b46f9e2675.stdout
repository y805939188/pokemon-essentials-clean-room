00001: class Battle::Move
00002:   #=============================================================================
00003:   # Effect methods per move usage
00004:   #=============================================================================
00005:   def pbCanChooseMove?(user, commandPhase, showMessages); return true; end   # For Belch
00006:   def pbDisplayChargeMessage(user); end   # For Focus Punch/shell Trap/Beak Blast
00007:   def pbOnStartUse(user, targets); end
00008:   def pbAddTarget(targets, user); end   # For Counter, etc. and Bide
00009:   def pbModifyTargets(targets, user); end   # For Dragon Darts
00010: 
00011:   # Reset move usage counters (child classes can increment them).
00012:   def pbChangeUsageCounters(user, specialUsage)
00013:     user.effects[PBEffects::FuryCutter]   = 0
00014:     user.effects[PBEffects::ParentalBond] = 0
00015:     user.effects[PBEffects::ProtectRate]  = 1
00016:     @battle.field.effects[PBEffects::FusionBolt]  = false
00017:     @battle.field.effects[PBEffects::FusionFlare] = false
00018:   end
00019: 
00020:   def pbDisplayUseMessage(user)
00021:     @battle.pbDisplayBrief(_INTL("{1} used {2}!", user.pbThis, @name))
00022:   end
