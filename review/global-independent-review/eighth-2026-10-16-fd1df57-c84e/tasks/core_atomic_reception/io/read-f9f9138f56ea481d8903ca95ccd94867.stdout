00001: class Battle
00002:   #=============================================================================
00003:   # Choosing to use an item
00004:   #=============================================================================
00005:   def pbCanUseItemOnPokemon?(item, pkmn, battler, scene, showMessages = true)
00006:     if !pkmn || pkmn.egg?
00007:       scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00008:       return false
00009:     end
00010:     # Embargo
00011:     if battler && battler.effects[PBEffects::Embargo] > 0
00012:       if showMessages
00013:         scene.pbDisplay(_INTL("Embargo's effect prevents the item's use on {1}!",
00014:                               battler.pbThis(true)))
00015:       end
00016:       return false
00017:     end
00018:     # Hyper Mode and non-Scents
00019:     if pkmn.hyper_mode && !GameData::Item.get(item)&.is_scent?
00020:       scene.pbDisplay(_INTL("It won't have any effect.")) if showMessages
00021:       return false
00022:     end
00023:     return true
00024:   end
00025: 
00026:   # NOTE: Using a Poké Ball consumes all your actions for the round. The method
00027:   #       below is one half of making this happen; the other half is in the
00028:   #       ItemHandlers::CanUseInBattle for Poké Balls.
00029:   def pbItemUsesAllActions?(item)
00030:     return true if GameData::Item.get(item).is_poke_ball?
00031:     return false
00032:   end
00033: 
00034:   def pbRegisterItem(idxBattler, item, idxTarget = nil, idxMove = nil)
00035:     # Register for use of item on a Pokémon in the party
00036:     @choices[idxBattler][0] = :UseItem
00037:     @choices[idxBattler][1] = item        # ID of item to be used
00038:     @choices[idxBattler][2] = idxTarget   # Party index of Pokémon to use item on
00039:     @choices[idxBattler][3] = idxMove     # Index of move to recharge (Ethers)
00040:     # Delete the item from the Bag. If it turns out it will have no effect, it
00041:     # will be re-added to the Bag later.
00042:     pbConsumeItemInBag(item, idxBattler)
00043:     return true
00044:   end
00045: 
00046:   #=============================================================================
00047:   # Using an item
00048:   #=============================================================================
00049:   def pbConsumeItemInBag(item, idxBattler)
00050:     return if !item
00051:     return if !GameData::Item.get(item).consumed_after_use?
00052:     if pbOwnedByPlayer?(idxBattler)
00053:       if !$bag.remove(item)
00054:         raise _INTL("Tried to consume item that wasn't in the Bag somehow.")
00055:       end
00056:     else
00057:       items = pbGetOwnerItems(idxBattler)
00058:       items.delete_at(items.index(item)) if items
00059:     end
00060:   end
00061: 
00062:   def pbReturnUnusedItemToBag(item, idxBattler)
00063:     return if !item
00064:     return if !GameData::Item.get(item).consumed_after_use?
00065:     if pbOwnedByPlayer?(idxBattler)
00066:       if $bag&.can_add?(item)
00067:         $bag.add(item)
00068:       else
00069:         raise _INTL("Couldn't return unused item to Bag somehow.")
00070:       end
00071:     else
00072:       items = pbGetOwnerItems(idxBattler)
00073:       items&.push(item)
00074:     end
00075:   end
