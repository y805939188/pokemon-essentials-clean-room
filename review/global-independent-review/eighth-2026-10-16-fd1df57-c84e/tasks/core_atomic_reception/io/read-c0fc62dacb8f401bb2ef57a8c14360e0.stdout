00068:   def pbFightMenu(idxBattler, megaEvoPossible = false)
00069:     battler = @battle.battlers[idxBattler]
00070:     cw = @sprites["fightWindow"]
00071:     cw.battler = battler
00072:     moveIndex = 0
00073:     if battler.moves[@lastMove[idxBattler]]&.id
00074:       moveIndex = @lastMove[idxBattler]
00075:     end
00076:     cw.shiftMode = (@battle.pbCanShift?(idxBattler)) ? 1 : 0
00077:     cw.setIndexAndMode(moveIndex, (megaEvoPossible) ? 1 : 0)
00078:     needFullRefresh = true
00079:     needRefresh = false
00080:     loop do
00081:       # Refresh view if necessary
00082:       if needFullRefresh
00083:         pbShowWindow(FIGHT_BOX)
00084:         pbSelectBattler(idxBattler)
00085:         needFullRefresh = false
00086:       end
00087:       if needRefresh
00088:         if megaEvoPossible
00089:           newMode = (@battle.pbRegisteredMegaEvolution?(idxBattler)) ? 2 : 1
00090:           cw.mode = newMode if newMode != cw.mode
00091:         end
00092:         needRefresh = false
00093:       end
00094:       oldIndex = cw.index
00095:       # General update
00096:       pbUpdate(cw)
00097:       # Update selected command
00098:       if Input.trigger?(Input::LEFT)
00099:         cw.index -= 1 if (cw.index & 1) == 1
00100:       elsif Input.trigger?(Input::RIGHT)
00101:         cw.index += 1 if battler.moves[cw.index + 1]&.id && (cw.index & 1) == 0
00102:       elsif Input.trigger?(Input::UP)
00103:         cw.index -= 2 if (cw.index & 2) == 2
00104:       elsif Input.trigger?(Input::DOWN)
00105:         cw.index += 2 if battler.moves[cw.index + 2]&.id && (cw.index & 2) == 0
00106:       end
00107:       pbPlayCursorSE if cw.index != oldIndex
00108:       # Actions
00109:       if Input.trigger?(Input::USE)      # Confirm choice
00110:         pbPlayDecisionSE
00111:         break if yield cw.index
00112:         needFullRefresh = true
00113:         needRefresh = true
00114:       elsif Input.trigger?(Input::BACK)   # Cancel fight menu
00115:         pbPlayCancelSE
00116:         break if yield -1
00117:         needRefresh = true
00118:       elsif Input.trigger?(Input::ACTION)   # Toggle Mega Evolution
00119:         if megaEvoPossible
00120:           pbPlayDecisionSE
00121:           break if yield -2
00122:           needRefresh = true
00123:         end
00124:       elsif Input.trigger?(Input::SPECIAL)   # Shift
00125:         if cw.shiftMode > 0
00126:           pbPlayDecisionSE
00127:           break if yield -3
00128:           needRefresh = true
00129:         end
00130:       end
00131:     end
00132:     @lastMove[idxBattler] = cw.index
00133:   end
00134: 
00135:   #=============================================================================
00136:   # Opens the party screen to choose a Pokémon to switch in (or just view its
00137:   # summary screens)
00138:   # mode: 0=Pokémon command, 1=choose a Pokémon to send to the Boxes, 2=view
00139:   #       summaries only
