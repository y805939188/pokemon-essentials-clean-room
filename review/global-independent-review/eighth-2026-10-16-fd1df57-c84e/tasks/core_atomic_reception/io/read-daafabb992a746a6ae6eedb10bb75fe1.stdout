00531:   def self.generate_foes(*args)
00532:     trainer_array = []
00533:     foe_items     = []
00534:     pokemon_array = []
00535:     party_starts  = []
00536:     trainer_type = nil
00537:     trainer_name = nil
00538:     args.each_with_index do |arg, i|
00539:       case arg
00540:       when NPCTrainer
00541:         raise _INTL("Trainer type {1} was given but not a trainer name.", trainer_type) if trainer_type
00542:         trainer_array.push(arg)
00543:         foe_items.push(arg.items)
00544:         party_starts.push(pokemon_array.length)
00545:         arg.party.each { |pkmn| pokemon_array.push(pkmn) }
00546:       when Array   # [trainer type, trainer name, version number, speech (optional)]
00547:         raise _INTL("Trainer type {1} was given but not a trainer name.", trainer_type) if trainer_type
00548:         trainer = pbLoadTrainer(arg[0], arg[1], arg[2])
00549:         pbMissingTrainer(arg[0], arg[1], arg[2]) if !trainer
00550:         trainer = pbLoadTrainer(arg[0], arg[1], arg[2]) if !trainer   # Try again
00551:         raise _INTL("Trainer for data '{1}' is not defined.", arg) if !trainer
00552:         EventHandlers.trigger(:on_trainer_load, trainer)
00553:         trainer.lose_text = arg[3] if arg[3] && !arg[3].empty?
00554:         trainer_array.push(trainer)
00555:         foe_items.push(trainer.items)
00556:         party_starts.push(pokemon_array.length)
00557:         trainer.party.each { |pkmn| pokemon_array.push(pkmn) }
00558:       else
00559:         if trainer_name   # Expecting version number
00560:           if !arg.is_a?(Integer) || arg < 0
00561:             raise _INTL("Expected a trainer version number (0 or higher) but {1} is not a number or not a valid value.", arg)
00562:           end
00563:           trainer = pbLoadTrainer(trainer_type, trainer_name, arg)
00564:           pbMissingTrainer(trainer_type, trainer_name, arg) if !trainer
00565:           trainer = pbLoadTrainer(trainer_type, trainer_name, arg) if !trainer   # Try again
00566:           raise _INTL("Trainer for data '{1}, {2}, {3}' is not defined.", trainer_type, trainer_name, arg) if !trainer
00567:           EventHandlers.trigger(:on_trainer_load, trainer)
00568:           trainer_array.push(trainer)
00569:           foe_items.push(trainer.items)
00570:           party_starts.push(pokemon_array.length)
00571:           trainer.party.each { |pkmn| pokemon_array.push(pkmn) }
00572:           trainer_type = nil
00573:           trainer_name = nil
00574:         elsif trainer_type   # Expecting trainer name
00575:           if !arg.is_a?(String) || arg.strip.empty?
00576:             raise _INTL("Expected a trainer name but '{1}' is not a valid name.", arg)
00577:           end
00578:           if args[i + 1].is_a?(Integer)   # Version number is next
00579:             trainer_name = arg.strip
00580:           else
00581:             trainer = pbLoadTrainer(trainer_type, arg)
00582:             pbMissingTrainer(trainer_type, arg, 0) if !trainer
00583:             trainer = pbLoadTrainer(trainer_type, arg) if !trainer   # Try again
00584:             raise _INTL("Trainer for data '{1}, {2}' is not defined.", trainer_type, arg) if !trainer
00585:             EventHandlers.trigger(:on_trainer_load, trainer)
00586:             trainer_array.push(trainer)
00587:             foe_items.push(trainer.items)
00588:             party_starts.push(pokemon_array.length)
00589:             trainer.party.each { |pkmn| pokemon_array.push(pkmn) }
00590:             trainer_type = nil
00591:           end
00592:         else   # Expecting trainer type
00593:           if !GameData::TrainerType.exists?(arg)
00594:             raise _INTL("Trainer type {1} does not exist.", arg)
00595:           end
00596:           trainer_type = arg
00597:         end
00598:       end
00599:     end
00600:     raise _INTL("Trainer type {1} was given but not a trainer name.", trainer_type) if trainer_type
00601:     return trainer_array, foe_items, pokemon_array, party_starts
00602:   end
