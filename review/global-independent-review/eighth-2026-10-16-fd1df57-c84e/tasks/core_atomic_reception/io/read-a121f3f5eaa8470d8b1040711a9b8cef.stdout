00380: def pbGetCurrentRegion(default = -1)
00381:   return default if !$game_map
00382:   map_pos = $game_map.metadata&.town_map_position
00383:   return (map_pos) ? map_pos[0] : default
00384: end
00385: 
00386: # Returns the Regional Pokédex number of the given species in the given Regional
00387: # Dex. The parameter "region" is zero-based. For example, if two regions are
00388: # defined, they would each be specified as 0 and 1.
00389: def pbGetRegionalNumber(region, species)
00390:   dex_list = pbLoadRegionalDexes[region]
00391:   return 0 if !dex_list || dex_list.length == 0
00392:   species_data = GameData::Species.try_get(species)
00393:   return 0 if !species_data
00394:   dex_list.each_with_index do |s, index|
00395:     return index + 1 if s == species_data.species
00396:   end
00397:   return 0
00398: end
00399: 
00400: # Returns an array of all species in the given Regional Dex in that Dex's order.
00401: def pbAllRegionalSpecies(region_dex)
00402:   return nil if region_dex < 0
00403:   dex_list = pbLoadRegionalDexes[region_dex]
00404:   return nil if !dex_list || dex_list.length == 0
00405:   return dex_list.clone
00406: end
00407: 
00408: # Returns the number of species in the given Regional Dex. Returns 0 if that
00409: # Regional Dex doesn't exist. If region_dex is a negative number, returns the
00410: # number of species in the National Dex (i.e. all species).
