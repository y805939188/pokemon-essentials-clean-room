00001: # The pbs_order value determines the order in which the stats are written in
00002: # several PBS files, where base stats/IVs/EVs/EV yields are defined. Only stats
00003: # which are yielded by the "each_main" method can have stat numbers defined in
00004: # those places. The values of pbs_order defined below should start with 0 and
00005: # increase without skipping any numbers.
00006: module GameData
00007:   class Stat
00008:     attr_reader :id
00009:     attr_reader :real_name
00010:     attr_reader :real_name_brief
00011:     attr_reader :type
00012:     attr_reader :pbs_order
00013: 
00014:     DATA = {}
00015: 
00016:     extend ClassMethodsSymbols
00017:     include InstanceMethods
00018: 
00019:     def self.load; end
00020:     def self.save; end
00021: 
00022:     # These stats are defined in PBS files, and should have the :pbs_order
00023:     # property.
00024:     def self.each_main
00025:       self.each { |s| yield s if [:main, :main_battle].include?(s.type) }
00026:     end
00027: 
00028:     def self.each_main_battle
00029:       self.each { |s| yield s if [:main_battle].include?(s.type) }
00030:     end
00031: 
00032:     # These stats have associated stat stages in battle.
00033:     def self.each_battle
00034:       self.each { |s| yield s if [:main_battle, :battle].include?(s.type) }
00035:     end
00036: 
00037:     def initialize(hash)
00038:       @id              = hash[:id]
00039:       @real_name       = hash[:name]       || "Unnamed"
00040:       @real_name_brief = hash[:name_brief] || "None"
00041:       @type            = hash[:type]       || :none
00042:       @pbs_order       = hash[:pbs_order]  || -1
00043:     end
00044: 
00045:     # @return [String] the translated name of this stat
00046:     def name
00047:       return _INTL(@real_name)
00048:     end
00049: 
00050:     # @return [String] the translated brief name of this stat
00051:     def name_brief
00052:       return _INTL(@real_name_brief)
00053:     end
00054:   end
00055: end
00056: 
00057: #===============================================================================
00058: 
00059: GameData::Stat.register({
00060:   :id         => :HP,
00061:   :name       => _INTL("HP"),
00062:   :name_brief => _INTL("HP"),
00063:   :type       => :main,
00064:   :pbs_order  => 0
00065: })
00066: 
00067: GameData::Stat.register({
00068:   :id         => :ATTACK,
00069:   :name       => _INTL("Attack"),
00070:   :name_brief => _INTL("Atk"),
00071:   :type       => :main_battle,
00072:   :pbs_order  => 1
00073: })
00074: 
00075: GameData::Stat.register({
00076:   :id         => :DEFENSE,
00077:   :name       => _INTL("Defense"),
00078:   :name_brief => _INTL("Def"),
00079:   :type       => :main_battle,
00080:   :pbs_order  => 2
00081: })
00082: 
00083: GameData::Stat.register({
00084:   :id         => :SPECIAL_ATTACK,
00085:   :name       => _INTL("Special Attack"),
00086:   :name_brief => _INTL("SpAtk"),
00087:   :type       => :main_battle,
00088:   :pbs_order  => 4
00089: })
00090: 
00091: GameData::Stat.register({
00092:   :id         => :SPECIAL_DEFENSE,
00093:   :name       => _INTL("Special Defense"),
00094:   :name_brief => _INTL("SpDef"),
00095:   :type       => :main_battle,
00096:   :pbs_order  => 5
00097: })
00098: 
00099: GameData::Stat.register({
00100:   :id         => :SPEED,
00101:   :name       => _INTL("Speed"),
00102:   :name_brief => _INTL("Spd"),
00103:   :type       => :main_battle,
00104:   :pbs_order  => 3
00105: })
00106: 
00107: GameData::Stat.register({
00108:   :id         => :ACCURACY,
00109:   :name       => _INTL("accuracy"),
00110:   :name_brief => _INTL("Acc"),
00111:   :type       => :battle
00112: })
00113: 
00114: GameData::Stat.register({
00115:   :id         => :EVASION,
00116:   :name       => _INTL("evasiveness"),
00117:   :name_brief => _INTL("Eva"),
00118:   :type       => :battle
00119: })
