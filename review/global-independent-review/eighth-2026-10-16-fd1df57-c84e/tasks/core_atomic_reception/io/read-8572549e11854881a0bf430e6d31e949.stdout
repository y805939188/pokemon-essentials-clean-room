01350:     next if !target.pbCanRaiseStatStage?(:SPECIAL_DEFENSE, target)
01351:     battle.pbCommonAnimation("UseItem", target)
01352:     target.pbRaiseStatStageByCause(:SPECIAL_DEFENSE, 1, target, target.itemName)
01353:     target.pbHeldItemTriggered(item)
01354:   }
