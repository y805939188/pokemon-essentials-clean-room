01272: Battle::ItemEffects::OnBeingHit.add(:ABSORBBULB,
01273:   proc { |item, user, target, move, battle|
01274:     next if move.calcType != :WATER
01275:     next if !target.pbCanRaiseStatStage?(:SPECIAL_ATTACK, target)
01276:     battle.pbCommonAnimation("UseItem", target)
01277:     target.pbRaiseStatStageByCause(:SPECIAL_ATTACK, 1, target, target.itemName)
01278:     target.pbHeldItemTriggered(item)
01279:   }
01280: )
