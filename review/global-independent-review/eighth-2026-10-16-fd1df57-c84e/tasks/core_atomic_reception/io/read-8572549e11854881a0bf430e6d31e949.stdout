01290: Battle::ItemEffects::OnBeingHit.add(:CELLBATTERY,
01291:   proc { |item, user, target, move, battle|
01292:     next if move.calcType != :ELECTRIC
01293:     next if !target.pbCanRaiseStatStage?(:ATTACK, target)
01294:     battle.pbCommonAnimation("UseItem", target)
01295:     target.pbRaiseStatStageByCause(:ATTACK, 1, target, target.itemName)
