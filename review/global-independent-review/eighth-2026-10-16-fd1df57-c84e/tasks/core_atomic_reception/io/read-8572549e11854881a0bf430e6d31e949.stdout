01402: 
01403: Battle::ItemEffects::OnBeingHit.add(:SNOWBALL,
01404:   proc { |item, user, target, move, battle|
01405:     next if move.calcType != :ICE
01406:     next if !target.pbCanRaiseStatStage?(:ATTACK, target)
01407:     battle.pbCommonAnimation("UseItem", target)
01408:     target.pbRaiseStatStageByCause(:ATTACK, 1, target, target.itemName)
01409:     target.pbHeldItemTriggered(item)
