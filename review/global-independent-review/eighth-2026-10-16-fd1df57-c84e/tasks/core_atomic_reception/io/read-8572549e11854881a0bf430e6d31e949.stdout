01333: # NOTE: Kee Berry supposedly shouldn't trigger if the user has Sheer Force, but
01334: #       I'm ignoring this. Weakness Policy has the same kind of effect and
01335: #       nowhere says it should be stopped by Sheer Force. I suspect this
01336: #       stoppage is either a false report that no one ever corrected, or an
01337: #       effect that later changed and wasn't noticed.
01338: Battle::ItemEffects::OnBeingHit.add(:KEEBERRY,
01339:   proc { |item, user, target, move, battle|
01340:     next if !move.physicalMove?
01341:     if Battle::ItemEffects.triggerOnBeingHitPositiveBerry(item, target, battle, false)
01342:       target.pbHeldItemTriggered(item)
01343:     end
01344:   }
01345: )
01346: 
