01371: Battle::ItemEffects::OnBeingHit.add(:ROCKYHELMET,
01372:   proc { |item, user, target, move, battle|
01373:     next if !move.pbContactMove?(user) || !user.affectedByContactEffect?
01374:     next if !user.takesIndirectDamage?
01375:     battle.scene.pbDamageAnimation(user)
01376:     user.pbReduceHP(user.totalhp / 6, false)
01377:     battle.pbDisplay(_INTL("{1} was hurt by the {2}!", user.pbThis, target.itemName))
01378:   }
01379: )
01380: 
01381: Battle::ItemEffects::OnBeingHit.add(:ROWAPBERRY,
01382:   proc { |item, user, target, move, battle|
01383:     next if !target.canConsumeBerry?
01384:     next if !move.specialMove?
01385:     next if !user.takesIndirectDamage?
01386:     amt = user.totalhp / 8
01387:     ripening = false
01388:     if target.hasActiveAbility?(:RIPEN)
01389:       battle.pbShowAbilitySplash(target)
01390:       amt *= 2
01391:       ripening = true
01392:     end
01393:     battle.pbCommonAnimation("EatBerry", target)
01394:     battle.pbHideAbilitySplash(target) if ripening
01395:     battle.scene.pbDamageAnimation(user)
01396:     user.pbReduceHP(amt, false)
01397:     battle.pbDisplay(_INTL("{1} consumed its {2} and hurt {3}!", target.pbThis,
01398:        target.itemName, user.pbThis(true)))
01399:     target.pbHeldItemTriggered(item)
