01300: Battle::ItemEffects::OnBeingHit.add(:ENIGMABERRY,
01301:   proc { |item, user, target, move, battle|
01302:     next if target.damageState.substitute ||
01303:             target.damageState.disguise || target.damageState.iceFace
01304:     next if !Effectiveness.super_effective?(target.damageState.typeMod)
01305:     if Battle::ItemEffects.triggerOnBeingHitPositiveBerry(item, target, battle, false)
01306:       target.pbHeldItemTriggered(item)
