01413: Battle::ItemEffects::OnBeingHit.add(:STICKYBARB,
01414:   proc { |item, user, target, move, battle|
01415:     next if !move.pbContactMove?(user) || !user.affectedByContactEffect?
01416:     next if user.fainted? || user.item
01417:     user.item = target.item
01418:     target.item = nil
01419:     target.effects[PBEffects::Unburden] = true if target.hasActiveAbility?(:UNBURDEN)
01420:     if battle.wildBattle? && !user.opposes? &&
01421:        !user.initialItem && user.item == target.initialItem
01422:       user.setInitialItem(user.item)
01423:       target.setInitialItem(nil)
01424:     end
01425:     battle.pbDisplay(_INTL("{1}'s {2} was transferred to {3}!",
01426:        target.pbThis, user.itemName, user.pbThis(true)))
01427:   }
01428: )
01429: 
01430: Battle::ItemEffects::OnBeingHit.add(:WEAKNESSPOLICY,
01431:   proc { |item, user, target, move, battle|
01432:     next if target.damageState.disguise || target.damageState.iceFace
01433:     next if !Effectiveness.super_effective?(target.damageState.typeMod)
01434:     next if !target.pbCanRaiseStatStage?(:ATTACK, target) &&
01435:             !target.pbCanRaiseStatStage?(:SPECIAL_ATTACK, target)
01436:     battle.pbCommonAnimation("UseItem", target)
01437:     showAnim = true
01438:     if target.pbCanRaiseStatStage?(:ATTACK, target)
01439:       target.pbRaiseStatStageByCause(:ATTACK, 2, target, target.itemName, showAnim)
01440:       showAnim = false
01441:     end
01442:     if target.pbCanRaiseStatStage?(:SPECIAL_ATTACK, target)
01443:       target.pbRaiseStatStageByCause(:SPECIAL_ATTACK, 2, target, target.itemName, showAnim)
01444:     end
01445:     battle.pbDisplay(_INTL("The {1} was used up...", target.itemName))
01446:     target.pbHeldItemTriggered(item)
01447:   }
01448: )
01449: 
01450: #===============================================================================
01451: # OnBeingHitPositiveBerry handlers
01452: # NOTE: This is for berries that have an effect when Pluck/Bug Bite/Fling
01453: #       forces their use.
01454: #===============================================================================
01455: 
01456: Battle::ItemEffects::OnBeingHitPositiveBerry.add(:ENIGMABERRY,
01457:   proc { |item, battler, battle, forced|
01458:     next false if !battler.canHeal?
01459:     next false if !forced && !battler.canConsumeBerry?
01460:     itemName = GameData::Item.get(item).name
01461:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
01462:     amt = battler.totalhp / 4
01463:     ripening = false
01464:     if battler.hasActiveAbility?(:RIPEN)
01465:       battle.pbShowAbilitySplash(battler, forced)
01466:       amt *= 2
01467:       ripening = true
01468:     end
01469:     battle.pbCommonAnimation("EatBerry", battler) if !forced
01470:     battle.pbHideAbilitySplash(battler) if ripening
01471:     battler.pbRecoverHP(amt)
01472:     if forced
01473:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
01474:     else
01475:       battle.pbDisplay(_INTL("{1} restored its health using its {2}!", battler.pbThis, itemName))
01476:     end
01477:     next true
01478:   }
01479: )
01480: 
01481: Battle::ItemEffects::OnBeingHitPositiveBerry.add(:KEEBERRY,
01482:   proc { |item, battler, battle, forced|
01483:     next false if !forced && !battler.canConsumeBerry?
01484:     next false if !battler.pbCanRaiseStatStage?(:DEFENSE, battler)
01485:     itemName = GameData::Item.get(item).name
01486:     amt = 1
01487:     ripening = false
01488:     if battler.hasActiveAbility?(:RIPEN)
01489:       battle.pbShowAbilitySplash(battler, forced)
01490:       amt *= 2
01491:       ripening = true
01492:     end
01493:     battle.pbCommonAnimation("EatBerry", battler) if !forced
01494:     battle.pbHideAbilitySplash(battler) if ripening
01495:     next battler.pbRaiseStatStageByCause(:DEFENSE, amt, battler, itemName) if !forced
01496:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}")
01497:     next battler.pbRaiseStatStage(:DEFENSE, amt, battler)
01498:   }
01499: )
01500: 
01501: Battle::ItemEffects::OnBeingHitPositiveBerry.add(:MARANGABERRY,
01502:   proc { |item, battler, battle, forced|
01503:     next false if !forced && !battler.canConsumeBerry?
01504:     next false if !battler.pbCanRaiseStatStage?(:SPECIAL_DEFENSE, battler)
01505:     itemName = GameData::Item.get(item).name
01506:     amt = 1
01507:     ripening = false
01508:     if battler.hasActiveAbility?(:RIPEN)
01509:       battle.pbShowAbilitySplash(battler, forced)
01510:       amt *= 2
01511:       ripening = true
01512:     end
01513:     battle.pbCommonAnimation("EatBerry", battler) if !forced
01514:     battle.pbHideAbilitySplash(battler) if ripening
01515:     next battler.pbRaiseStatStageByCause(:SPECIAL_DEFENSE, amt, battler, itemName) if !forced
01516:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}")
01517:     next battler.pbRaiseStatStage(:SPECIAL_DEFENSE, amt, battler)
01518:   }
01519: )
01520: 
01521: #===============================================================================
01522: # AfterMoveUseFromTarget handlers
01523: #===============================================================================
01524: 
01525: Battle::ItemEffects::AfterMoveUseFromTarget.add(:EJECTBUTTON,
01526:   proc { |item, battler, user, move, switched_battlers, battle|
01527:     next if !switched_battlers.empty?
01528:     next if battle.pbAllFainted?(battler.idxOpposingSide)
01529:     next if !battle.pbCanChooseNonActive?(battler.index)
01530:     battle.pbCommonAnimation("UseItem", battler)
01531:     battle.pbDisplay(_INTL("{1} is switched out with the {2}!", battler.pbThis, battler.itemName))
01532:     battler.pbConsumeItem(true, false)
01533:     newPkmn = battle.pbGetReplacementPokemonIndex(battler.index)   # Owner chooses
01534:     next if newPkmn < 0
01535:     battle.pbRecallAndReplace(battler.index, newPkmn)
01536:     battle.pbClearChoice(battler.index)   # Replacement Pokémon does nothing this round
01537:     switched_battlers.push(battler.index)
01538:     battle.moldBreaker = false if battler.index == user.index
01539:     battle.pbOnBattlerEnteringBattle(battler.index)
01540:   }
01541: )
01542: 
01543: Battle::ItemEffects::AfterMoveUseFromTarget.add(:REDCARD,
01544:   proc { |item, battler, user, move, switched_battlers, battle|
01545:     next if !switched_battlers.empty? || user.fainted?
01546:     newPkmn = battle.pbGetReplacementPokemonIndex(user.index, true)   # Random
01547:     next if newPkmn < 0
01548:     battle.pbCommonAnimation("UseItem", battler)
01549:     battle.pbDisplay(_INTL("{1} held up its {2} against {3}!",
01550:        battler.pbThis, battler.itemName, user.pbThis(true)))
01551:     battler.pbConsumeItem
01552:     if user.hasActiveAbility?(:SUCTIONCUPS) && !battle.moldBreaker
01553:       battle.pbShowAbilitySplash(user)
01554:       if Battle::Scene::USE_ABILITY_SPLASH
01555:         battle.pbDisplay(_INTL("{1} anchors itself!", user.pbThis))
01556:       else
01557:         battle.pbDisplay(_INTL("{1} anchors itself with {2}!", user.pbThis, user.abilityName))
01558:       end
01559:       battle.pbHideAbilitySplash(user)
01560:       next
01561:     end
01562:     if user.effects[PBEffects::Ingrain]
01563:       battle.pbDisplay(_INTL("{1} anchored itself with its roots!", user.pbThis))
01564:       next
01565:     end
01566:     battle.pbRecallAndReplace(user.index, newPkmn, true)
01567:     battle.pbDisplay(_INTL("{1} was dragged out!", user.pbThis))
01568:     battle.pbClearChoice(user.index)   # Replacement Pokémon does nothing this round
01569:     switched_battlers.push(user.index)
01570:     battle.moldBreaker = false
01571:     battle.pbOnBattlerEnteringBattle(user.index)
01572:   }
01573: )
01574: 
01575: #===============================================================================
01576: # AfterMoveUseFromUser handlers
01577: #===============================================================================
01578: 
01579: Battle::ItemEffects::AfterMoveUseFromUser.add(:LIFEORB,
01580:   proc { |item, user, targets, move, numHits, battle|
01581:     next if !user.takesIndirectDamage?
01582:     next if !move.pbDamagingMove? || numHits == 0
01583:     hitBattler = false
01584:     targets.each do |b|
01585:       hitBattler = true if !b.damageState.unaffected && !b.damageState.substitute
01586:       break if hitBattler
01587:     end
01588:     next if !hitBattler
01589:     PBDebug.log("[Item triggered] #{user.pbThis}'s #{user.itemName} (recoil)")
01590:     user.pbReduceHP(user.totalhp / 10)
01591:     battle.pbDisplay(_INTL("{1} lost some of its HP!", user.pbThis))
01592:     user.pbItemHPHealCheck
01593:     user.pbFaint if user.fainted?
01594:   }
01595: )
01596: 
01597: # NOTE: In the official games, Shell Bell does not prevent Emergency Exit/Wimp
01598: #       Out triggering even if Shell Bell heals the holder back to 50% HP or
01599: #       more. Essentials ignores this exception.
01600: Battle::ItemEffects::AfterMoveUseFromUser.add(:SHELLBELL,
01601:   proc { |item, user, targets, move, numHits, battle|
01602:     next if !user.canHeal?
01603:     totalDamage = 0
01604:     targets.each { |b| totalDamage += b.damageState.totalHPLost }
01605:     next if totalDamage <= 0
01606:     user.pbRecoverHP(totalDamage / 8)
01607:     battle.pbDisplay(_INTL("{1} restored a little HP using its {2}!",
01608:        user.pbThis, user.itemName))
01609:   }
01610: )
01611: 
01612: Battle::ItemEffects::AfterMoveUseFromUser.add(:THROATSPRAY,
01613:   proc { |item, user, targets, move, numHits, battle|
01614:     next if battle.pbAllFainted?(user.idxOwnSide) ||
01615:             battle.pbAllFainted?(user.idxOpposingSide)
01616:     next if !move.soundMove? || numHits == 0
01617:     next if !user.pbCanRaiseStatStage?(:SPECIAL_ATTACK, user)
01618:     battle.pbCommonAnimation("UseItem", user)
01619:     user.pbRaiseStatStage(:SPECIAL_ATTACK, 1, user)
01620:     user.pbConsumeItem
01621:   }
01622: )
01623: 
