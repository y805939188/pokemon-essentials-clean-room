01901:     next if !move.pbContactMove?(user)
01902:     next if user.fainted?
01903:     next if user.unstoppableAbility? || user.ability == ability
01904:     oldAbil = nil
01905:     battle.pbShowAbilitySplash(target) if user.opposes?(target)
01906:     if user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01907:       oldAbil = user.ability
01908:       battle.pbShowAbilitySplash(user, true, false) if user.opposes?(target)
01909:       user.ability = ability
01910:       battle.pbReplaceAbilitySplash(user) if user.opposes?(target)
01911:       if Battle::Scene::USE_ABILITY_SPLASH
01912:         battle.pbDisplay(_INTL("{1}'s Ability became {2}!", user.pbThis, user.abilityName))
01913:       else
01914:         battle.pbDisplay(_INTL("{1}'s Ability became {2} because of {3}!",
01915:            user.pbThis, user.abilityName, target.pbThis(true)))
01916:       end
01917:       battle.pbHideAbilitySplash(user) if user.opposes?(target)
01918:     end
01919:     battle.pbHideAbilitySplash(target) if user.opposes?(target)
01920:     user.pbOnLosingAbility(oldAbil)
01921:     user.pbTriggerAbilityOnGainingIt
01922:   }
01923: )
01924: 
01925: Battle::AbilityEffects::OnBeingHit.add(:PERISHBODY,
01926:   proc { |ability, user, target, move, battle|
01927:     next if !move.pbContactMove?(user)
01928:     next if user.fainted?
01929:     next if user.effects[PBEffects::PerishSong] > 0 || target.effects[PBEffects::PerishSong] > 0
01930:     battle.pbShowAbilitySplash(target)
01931:     if user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01932:       user.effects[PBEffects::PerishSong] = 4
01933:       user.effects[PBEffects::PerishSongUser] = target.index
01934:       target.effects[PBEffects::PerishSong] = 4
01935:       target.effects[PBEffects::PerishSongUser] = target.index
01936:       if Battle::Scene::USE_ABILITY_SPLASH
01937:         battle.pbDisplay(_INTL("Both Pokémon will faint in three turns!"))
01938:       else
01939:         battle.pbDisplay(_INTL("Both Pokémon will faint in three turns because of {1}'s {2}!",
01940:            target.pbThis(true), target.abilityName))
01941:       end
01942:     end
01943:     battle.pbHideAbilitySplash(target)
01944:   }
01945: )
01946: 
01947: Battle::AbilityEffects::OnBeingHit.add(:POISONPOINT,
01948:   proc { |ability, user, target, move, battle|
01949:     next if !move.pbContactMove?(user)
01950:     next if user.poisoned? || battle.pbRandom(100) >= 30
01951:     battle.pbShowAbilitySplash(target)
01952:     if user.pbCanPoison?(target, Battle::Scene::USE_ABILITY_SPLASH) &&
01953:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01954:       msg = nil
01955:       if !Battle::Scene::USE_ABILITY_SPLASH
01956:         msg = _INTL("{1}'s {2} poisoned {3}!", target.pbThis, target.abilityName, user.pbThis(true))
01957:       end
01958:       user.pbPoison(target, msg)
01959:     end
01960:     battle.pbHideAbilitySplash(target)
01961:   }
01962: )
01963: 
01964: Battle::AbilityEffects::OnBeingHit.add(:RATTLED,
01965:   proc { |ability, user, target, move, battle|
01966:     next if ![:BUG, :DARK, :GHOST].include?(move.calcType)
01967:     target.pbRaiseStatStageByAbility(:SPEED, 1, target)
01968:   }
01969: )
01970: 
01971: Battle::AbilityEffects::OnBeingHit.add(:SANDSPIT,
01972:   proc { |ability, user, target, move, battle|
01973:     battle.pbStartWeatherAbility(:Sandstorm, target)
01974:   }
01975: )
01976: 
01977: Battle::AbilityEffects::OnBeingHit.add(:STAMINA,
01978:   proc { |ability, user, target, move, battle|
01979:     target.pbRaiseStatStageByAbility(:DEFENSE, 1, target)
01980:   }
01981: )
01982: 
01983: Battle::AbilityEffects::OnBeingHit.add(:STATIC,
01984:   proc { |ability, user, target, move, battle|
01985:     next if !move.pbContactMove?(user)
01986:     next if user.paralyzed? || battle.pbRandom(100) >= 30
01987:     battle.pbShowAbilitySplash(target)
01988:     if user.pbCanParalyze?(target, Battle::Scene::USE_ABILITY_SPLASH) &&
01989:        user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
01990:       msg = nil
01991:       if !Battle::Scene::USE_ABILITY_SPLASH
01992:         msg = _INTL("{1}'s {2} paralyzed {3}! It may be unable to move!",
01993:            target.pbThis, target.abilityName, user.pbThis(true))
01994:       end
01995:       user.pbParalyze(target, msg)
01996:     end
01997:     battle.pbHideAbilitySplash(target)
01998:   }
01999: )
02000: 
02001: Battle::AbilityEffects::OnBeingHit.add(:WANDERINGSPIRIT,
02002:   proc { |ability, user, target, move, battle|
02003:     next if !move.pbContactMove?(user)
02004:     next if user.ungainableAbility? || [:RECEIVER, :WONDERGUARD].include?(user.ability_id)
02005:     oldUserAbil   = nil
02006:     oldTargetAbil = nil
02007:     battle.pbShowAbilitySplash(target) if user.opposes?(target)
02008:     if user.affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH)
02009:       battle.pbShowAbilitySplash(user, true, false) if user.opposes?(target)
02010:       oldUserAbil   = user.ability
02011:       oldTargetAbil = target.ability
02012:       user.ability   = oldTargetAbil
02013:       target.ability = oldUserAbil
02014:       if user.opposes?(target)
02015:         battle.pbReplaceAbilitySplash(user)
02016:         battle.pbReplaceAbilitySplash(target)
02017:       end
02018:       if Battle::Scene::USE_ABILITY_SPLASH
02019:         battle.pbDisplay(_INTL("{1} swapped Abilities with {2}!", target.pbThis, user.pbThis(true)))
02020:       else
02021:         battle.pbDisplay(_INTL("{1} swapped its {2} Ability with {3}'s {4} Ability!",
02022:            target.pbThis, user.abilityName, user.pbThis(true), target.abilityName))
02023:       end
02024:       if user.opposes?(target)
02025:         battle.pbHideAbilitySplash(user)
02026:         battle.pbHideAbilitySplash(target)
02027:       end
02028:     end
02029:     battle.pbHideAbilitySplash(target) if user.opposes?(target)
02030:     user.pbOnLosingAbility(oldUserAbil)
02031:     target.pbOnLosingAbility(oldTargetAbil)
02032:     user.pbTriggerAbilityOnGainingIt
02033:     target.pbTriggerAbilityOnGainingIt
02034:   }
02035: )
02036: 
02037: Battle::AbilityEffects::OnBeingHit.add(:WATERCOMPACTION,
02038:   proc { |ability, user, target, move, battle|
02039:     next if move.calcType != :WATER
02040:     target.pbRaiseStatStageByAbility(:DEFENSE, 2, target)
02041:   }
02042: )
02043: 
02044: Battle::AbilityEffects::OnBeingHit.add(:WEAKARMOR,
02045:   proc { |ability, user, target, move, battle|
02046:     next if !move.physicalMove?
02047:     next if !target.pbCanLowerStatStage?(:DEFENSE, target) &&
02048:             !target.pbCanRaiseStatStage?(:SPEED, target)
02049:     battle.pbShowAbilitySplash(target)
02050:     target.pbLowerStatStageByAbility(:DEFENSE, 1, target, false)
02051:     target.pbRaiseStatStageByAbility(:SPEED,
02052:        (Settings::MECHANICS_GENERATION >= 7) ? 2 : 1, target, false)
02053:     battle.pbHideAbilitySplash(target)
02054:   }
02055: )
02056: 
02057: #===============================================================================
02058: # OnDealingHit handlers
02059: #===============================================================================
02060: 
02061: Battle::AbilityEffects::OnDealingHit.add(:POISONTOUCH,
02062:   proc { |ability, user, target, move, battle|
02063:     next if !move.contactMove?
02064:     next if battle.pbRandom(100) >= 30
02065:     battle.pbShowAbilitySplash(user)
02066:     if target.hasActiveAbility?(:SHIELDDUST) && !battle.moldBreaker
02067:       battle.pbShowAbilitySplash(target)
02068:       if !Battle::Scene::USE_ABILITY_SPLASH
02069:         battle.pbDisplay(_INTL("{1} is unaffected!", target.pbThis))
02070:       end
02071:       battle.pbHideAbilitySplash(target)
02072:     elsif target.pbCanPoison?(user, Battle::Scene::USE_ABILITY_SPLASH)
02073:       msg = nil
02074:       if !Battle::Scene::USE_ABILITY_SPLASH
02075:         msg = _INTL("{1}'s {2} poisoned {3}!", user.pbThis, user.abilityName, target.pbThis(true))
02076:       end
02077:       target.pbPoison(user, msg)
02078:     end
02079:     battle.pbHideAbilitySplash(user)
02080:   }
02081: )
02082: 
02083: #===============================================================================
02084: # OnEndOfUsingMove handlers
02085: #===============================================================================
02086: 
02087: Battle::AbilityEffects::OnEndOfUsingMove.add(:BEASTBOOST,
02088:   proc { |ability, user, targets, move, battle|
02089:     next if battle.pbAllFainted?(user.idxOpposingSide)
02090:     numFainted = 0
02091:     targets.each { |b| numFainted += 1 if b.damageState.fainted }
02092:     next if numFainted == 0
02093:     userStats = user.plainStats
02094:     highestStatValue = 0
02095:     userStats.each_value { |value| highestStatValue = value if highestStatValue < value }
02096:     GameData::Stat.each_main_battle do |s|
02097:       next if userStats[s.id] < highestStatValue
02098:       if user.pbCanRaiseStatStage?(s.id, user)
02099:         user.pbRaiseStatStageByAbility(s.id, numFainted, user)
02100:       end
02101:       break
02102:     end
02103:   }
02104: )
02105: 
02106: Battle::AbilityEffects::OnEndOfUsingMove.add(:CHILLINGNEIGH,
02107:   proc { |ability, user, targets, move, battle|
02108:     next if battle.pbAllFainted?(user.idxOpposingSide)
02109:     numFainted = 0
02110:     targets.each { |b| numFainted += 1 if b.damageState.fainted }
02111:     next if numFainted == 0 || !user.pbCanRaiseStatStage?(:ATTACK, user)
02112:     user.ability_id = :CHILLINGNEIGH   # So the As One abilities can just copy this
02113:     user.pbRaiseStatStageByAbility(:ATTACK, 1, user)
02114:     user.ability_id = ability
02115:   }
02116: )
02117: 
02118: Battle::AbilityEffects::OnEndOfUsingMove.copy(:CHILLINGNEIGH, :ASONECHILLINGNEIGH)
02119: 
02120: Battle::AbilityEffects::OnEndOfUsingMove.add(:GRIMNEIGH,
02121:   proc { |ability, user, targets, move, battle|
02122:     next if battle.pbAllFainted?(user.idxOpposingSide)
02123:     numFainted = 0
02124:     targets.each { |b| numFainted += 1 if b.damageState.fainted }
02125:     next if numFainted == 0 || !user.pbCanRaiseStatStage?(:SPECIAL_ATTACK, user)
02126:     user.ability_id = :GRIMNEIGH   # So the As One abilities can just copy this
02127:     user.pbRaiseStatStageByAbility(:SPECIAL_ATTACK, 1, user)
02128:     user.ability_id = ability
02129:   }
02130: )
02131: 
02132: Battle::AbilityEffects::OnEndOfUsingMove.copy(:GRIMNEIGH, :ASONEGRIMNEIGH)
02133: 
02134: Battle::AbilityEffects::OnEndOfUsingMove.add(:MAGICIAN,
02135:   proc { |ability, user, targets, move, battle|
02136:     next if battle.futureSight
02137:     next if !move.pbDamagingMove?
02138:     next if user.item
02139:     next if user.wild?
02140:     targets.each do |b|
02141:       next if b.damageState.unaffected || b.damageState.substitute
02142:       next if !b.item
02143:       next if b.unlosableItem?(b.item) || user.unlosableItem?(b.item)
02144:       battle.pbShowAbilitySplash(user)
02145:       if b.hasActiveAbility?(:STICKYHOLD)
02146:         battle.pbShowAbilitySplash(b) if user.opposes?(b)
02147:         if Battle::Scene::USE_ABILITY_SPLASH
02148:           battle.pbDisplay(_INTL("{1}'s item cannot be stolen!", b.pbThis))
02149:         end
02150:         battle.pbHideAbilitySplash(b) if user.opposes?(b)
02151:         next
02152:       end
02153:       user.item = b.item
02154:       b.item = nil
02155:       b.effects[PBEffects::Unburden] = true if b.hasActiveAbility?(:UNBURDEN)
02156:       if battle.wildBattle? && !user.initialItem && user.item == b.initialItem
02157:         user.setInitialItem(user.item)
02158:         b.setInitialItem(nil)
02159:       end
02160:       if Battle::Scene::USE_ABILITY_SPLASH
02161:         battle.pbDisplay(_INTL("{1} stole {2}'s {3}!", user.pbThis,
02162:            b.pbThis(true), user.itemName))
02163:       else
02164:         battle.pbDisplay(_INTL("{1} stole {2}'s {3} with {4}!", user.pbThis,
02165:            b.pbThis(true), user.itemName, user.abilityName))
02166:       end
02167:       battle.pbHideAbilitySplash(user)
02168:       user.pbHeldItemTriggerCheck
02169:       break
02170:     end
02171:   }
02172: )
02173: 
02174: Battle::AbilityEffects::OnEndOfUsingMove.add(:MOXIE,
02175:   proc { |ability, user, targets, move, battle|
02176:     next if battle.pbAllFainted?(user.idxOpposingSide)
02177:     numFainted = 0
02178:     targets.each { |b| numFainted += 1 if b.damageState.fainted }
02179:     next if numFainted == 0 || !user.pbCanRaiseStatStage?(:ATTACK, user)
02180:     user.pbRaiseStatStageByAbility(:ATTACK, numFainted, user)
02181:   }
02182: )
02183: 
02184: #===============================================================================
02185: # AfterMoveUseFromTarget handlers
02186: #===============================================================================
02187: 
02188: Battle::AbilityEffects::AfterMoveUseFromTarget.add(:BERSERK,
02189:   proc { |ability, target, user, move, switched_battlers, battle|
02190:     next if !move.damagingMove?
02191:     next if !target.droppedBelowHalfHP
02192:     next if !target.pbCanRaiseStatStage?(:SPECIAL_ATTACK, target)
02193:     target.pbRaiseStatStageByAbility(:SPECIAL_ATTACK, 1, target)
02194:   }
02195: )
02196: 
02197: Battle::AbilityEffects::AfterMoveUseFromTarget.add(:COLORCHANGE,
02198:   proc { |ability, target, user, move, switched_battlers, battle|
02199:     next if target.damageState.calcDamage == 0 || target.damageState.substitute
02200:     next if !move.calcType || GameData::Type.get(move.calcType).pseudo_type
02201:     next if target.pbHasType?(move.calcType) && !target.pbHasOtherType?(move.calcType)
02202:     typeName = GameData::Type.get(move.calcType).name
02203:     battle.pbShowAbilitySplash(target)
02204:     target.pbChangeTypes(move.calcType)
02205:     battle.pbDisplay(_INTL("{1}'s type changed to {2} because of its {3}!",
02206:        target.pbThis, typeName, target.abilityName))
02207:     battle.pbHideAbilitySplash(target)
02208:   }
02209: )
02210: 
02211: Battle::AbilityEffects::AfterMoveUseFromTarget.add(:PICKPOCKET,
02212:   proc { |ability, target, user, move, switched_battlers, battle|
02213:     # NOTE: According to Bulbapedia, this can still trigger to steal the user's
02214:     #       item even if it was switched out by a Red Card. That doesn't make
02215:     #       sense, so this code doesn't do it.
02216:     next if target.wild?
02217:     next if switched_battlers.include?(user.index)   # User was switched out
02218:     next if !move.contactMove?
02219:     next if user.effects[PBEffects::Substitute] > 0 || target.damageState.substitute
02220:     next if target.item || !user.item
02221:     next if user.unlosableItem?(user.item) || target.unlosableItem?(user.item)
02222:     battle.pbShowAbilitySplash(target)
02223:     if user.hasActiveAbility?(:STICKYHOLD)
02224:       battle.pbShowAbilitySplash(user) if target.opposes?(user)
02225:       if Battle::Scene::USE_ABILITY_SPLASH
02226:         battle.pbDisplay(_INTL("{1}'s item cannot be stolen!", user.pbThis))
02227:       end
02228:       battle.pbHideAbilitySplash(user) if target.opposes?(user)
02229:       battle.pbHideAbilitySplash(target)
02230:       next
02231:     end
02232:     target.item = user.item
02233:     user.item = nil
02234:     user.effects[PBEffects::Unburden] = true if user.hasActiveAbility?(:UNBURDEN)
02235:     if battle.wildBattle? && !target.initialItem && target.item == user.initialItem
02236:       target.setInitialItem(target.item)
02237:       user.setInitialItem(nil)
02238:     end
02239:     battle.pbDisplay(_INTL("{1} pickpocketed {2}'s {3}!", target.pbThis,
02240:        user.pbThis(true), target.itemName))
02241:     battle.pbHideAbilitySplash(target)
02242:     target.pbHeldItemTriggerCheck
02243:   }
02244: )
02245: 
02246: #===============================================================================
02247: # EndOfRoundWeather handlers
02248: #===============================================================================
02249: 
02250: Battle::AbilityEffects::EndOfRoundWeather.add(:DRYSKIN,
02251:   proc { |ability, weather, battler, battle|
02252:     case weather
02253:     when :Sun, :HarshSun
02254:       if battler.takesIndirectDamage?
02255:         battle.pbShowAbilitySplash(battler)
02256:         battle.scene.pbDamageAnimation(battler)
02257:         battler.pbReduceHP(battler.totalhp / 8, false)
02258:         battle.pbDisplay(_INTL("{1} was hurt by the sunlight!", battler.pbThis))
02259:         battle.pbHideAbilitySplash(battler)
02260:         battler.pbItemHPHealCheck
02261:       end
02262:     when :Rain, :HeavyRain
02263:       next if !battler.canHeal?
02264:       battle.pbShowAbilitySplash(battler)
02265:       battler.pbRecoverHP(battler.totalhp / 8)
02266:       if Battle::Scene::USE_ABILITY_SPLASH
02267:         battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
02268:       else
02269:         battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", battler.pbThis, battler.abilityName))
02270:       end
02271:       battle.pbHideAbilitySplash(battler)
02272:     end
02273:   }
02274: )
02275: 
02276: Battle::AbilityEffects::EndOfRoundWeather.add(:ICEBODY,
02277:   proc { |ability, weather, battler, battle|
02278:     next unless weather == :Hail
02279:     next if !battler.canHeal?
02280:     battle.pbShowAbilitySplash(battler)
02281:     battler.pbRecoverHP(battler.totalhp / 16)
02282:     if Battle::Scene::USE_ABILITY_SPLASH
02283:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
02284:     else
02285:       battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", battler.pbThis, battler.abilityName))
02286:     end
02287:     battle.pbHideAbilitySplash(battler)
02288:   }
02289: )
02290: 
02291: Battle::AbilityEffects::EndOfRoundWeather.add(:ICEFACE,
02292:   proc { |ability, weather, battler, battle|
02293:     next if weather != :Hail
02294:     next if !battler.canRestoreIceFace || battler.form != 1
02295:     battle.pbShowAbilitySplash(battler)
02296:     if !Battle::Scene::USE_ABILITY_SPLASH
02297:       battle.pbDisplay(_INTL("{1}'s {2} activated!", battler.pbThis, battler.abilityName))
02298:     end
02299:     battler.pbChangeForm(0, _INTL("{1} transformed!", battler.pbThis))
02300:     battle.pbHideAbilitySplash(battler)
02301:   }
02302: )
02303: 
