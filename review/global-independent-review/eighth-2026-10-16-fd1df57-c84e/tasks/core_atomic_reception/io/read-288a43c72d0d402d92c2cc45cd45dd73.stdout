00551: Battle::ItemEffects::StatusCure.add(:MENTALHERB,
00552:   proc { |item, battler, battle, forced|
00553:     next false if battler.effects[PBEffects::Attract] == -1 &&
00554:                   battler.effects[PBEffects::Taunt] == 0 &&
00555:                   battler.effects[PBEffects::Encore] == 0 &&
00556:                   !battler.effects[PBEffects::Torment] &&
00557:                   battler.effects[PBEffects::Disable] == 0 &&
00558:                   battler.effects[PBEffects::HealBlock] == 0
00559:     itemName = GameData::Item.get(item).name
00560:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}")
00561:     battle.pbCommonAnimation("UseItem", battler) if !forced
00562:     if battler.effects[PBEffects::Attract] >= 0
00563:       if forced
00564:         battle.pbDisplay(_INTL("{1} got over its infatuation.", battler.pbThis))
00565:       else
00566:         battle.pbDisplay(_INTL("{1} cured its infatuation status using its {2}!",
00567:            battler.pbThis, itemName))
00568:       end
00569:       battler.pbCureAttract
00570:     end
00571:     battle.pbDisplay(_INTL("{1}'s taunt wore off!", battler.pbThis)) if battler.effects[PBEffects::Taunt] > 0
00572:     battler.effects[PBEffects::Taunt] = 0
00573:     battle.pbDisplay(_INTL("{1}'s encore ended!", battler.pbThis)) if battler.effects[PBEffects::Encore] > 0
00574:     battler.effects[PBEffects::Encore]     = 0
00575:     battler.effects[PBEffects::EncoreMove] = nil
00576:     battle.pbDisplay(_INTL("{1}'s torment wore off!", battler.pbThis)) if battler.effects[PBEffects::Torment]
00577:     battler.effects[PBEffects::Torment] = false
00578:     battle.pbDisplay(_INTL("{1} is no longer disabled!", battler.pbThis)) if battler.effects[PBEffects::Disable] > 0
00579:     battler.effects[PBEffects::Disable] = 0
00580:     battle.pbDisplay(_INTL("{1}'s Heal Block wore off!", battler.pbThis)) if battler.effects[PBEffects::HealBlock] > 0
00581:     battler.effects[PBEffects::HealBlock] = 0
00582:     next true
00583:   }
00584: )
00585: 
00586: Battle::ItemEffects::StatusCure.add(:PECHABERRY,
00587:   proc { |item, battler, battle, forced|
00588:     next false if !forced && !battler.canConsumeBerry?
00589:     next false if battler.status != :POISON
00590:     itemName = GameData::Item.get(item).name
00591:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00592:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00593:     battler.pbCureStatus(forced)
00594:     battle.pbDisplay(_INTL("{1}'s {2} cured its poisoning!", battler.pbThis, itemName)) if !forced
00595:     next true
00596:   }
00597: )
00598: 
00599: Battle::ItemEffects::StatusCure.add(:PERSIMBERRY,
00600:   proc { |item, battler, battle, forced|
00601:     next false if !forced && !battler.canConsumeBerry?
00602:     next false if battler.effects[PBEffects::Confusion] == 0
00603:     itemName = GameData::Item.get(item).name
00604:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00605:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00606:     battler.pbCureConfusion
00607:     if forced
00608:       battle.pbDisplay(_INTL("{1} snapped out of its confusion.", battler.pbThis))
00609:     else
00610:       battle.pbDisplay(_INTL("{1}'s {2} snapped it out of its confusion!", battler.pbThis,
00611:          itemName))
00612:     end
00613:     next true
00614:   }
00615: )
00616: 
00617: Battle::ItemEffects::StatusCure.add(:RAWSTBERRY,
00618:   proc { |item, battler, battle, forced|
00619:     next false if !forced && !battler.canConsumeBerry?
00620:     next false if battler.status != :BURN
00621:     itemName = GameData::Item.get(item).name
00622:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00623:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00624:     battler.pbCureStatus(forced)
00625:     battle.pbDisplay(_INTL("{1}'s {2} healed its burn!", battler.pbThis, itemName)) if !forced
00626:     next true
00627:   }
00628: )
00629: 
00630: #===============================================================================
00631: # PriorityBracketChange handlers
00632: #===============================================================================
00633: 
00634: Battle::ItemEffects::PriorityBracketChange.add(:CUSTAPBERRY,
00635:   proc { |item, battler, battle|
00636:     next 1 if battler.canConsumePinchBerry?
00637:   }
00638: )
00639: 
00640: Battle::ItemEffects::PriorityBracketChange.add(:LAGGINGTAIL,
00641:   proc { |item, battler, battle|
00642:     next -1
00643:   }
00644: )
00645: 
00646: Battle::ItemEffects::PriorityBracketChange.copy(:LAGGINGTAIL, :FULLINCENSE)
00647: 
00648: Battle::ItemEffects::PriorityBracketChange.add(:QUICKCLAW,
00649:   proc { |item, battler, battle|
00650:     next 1 if battle.pbRandom(100) < 20
00651:   }
00652: )
00653: 
00654: #===============================================================================
00655: # PriorityBracketUse handlers
00656: #===============================================================================
00657: 
00658: Battle::ItemEffects::PriorityBracketUse.add(:CUSTAPBERRY,
00659:   proc { |item, battler, battle|
00660:     battle.pbCommonAnimation("EatBerry", battler)
00661:     battle.pbDisplay(_INTL("{1}'s {2} let it move first!", battler.pbThis, battler.itemName))
00662:     battler.pbConsumeItem
00663:   }
00664: )
00665: 
00666: Battle::ItemEffects::PriorityBracketUse.add(:QUICKCLAW,
00667:   proc { |item, battler, battle|
00668:     battle.pbCommonAnimation("UseItem", battler)
00669:     battle.pbDisplay(_INTL("{1}'s {2} let it move first!", battler.pbThis, battler.itemName))
00670:   }
00671: )
00672: 
00673: #===============================================================================
00674: # OnMissingTarget handlers
00675: #===============================================================================
00676: 
00677: Battle::ItemEffects::OnMissingTarget.add(:BLUNDERPOLICY,
00678:   proc { |item, user, target, move, hit_num, battle|
00679:     next if hit_num > 0 || target.damageState.invulnerable
00680:     next if ["OHKO", "OHKOIce", "OHKOHitsUndergroundTarget"].include?(move.function_code)
00681:     next if !user.pbCanRaiseStatStage?(:SPEED, user)
00682:     battle.pbCommonAnimation("UseItem", user)
00683:     user.pbRaiseStatStageByCause(:SPEED, 2, user, user.itemName)
00684:     battle.pbDisplay(_INTL("The {1} was used up...", user.itemName))
00685:     user.pbHeldItemTriggered(item)
00686:   }
00687: )
00688: 
00689: #===============================================================================
00690: # AccuracyCalcFromUser handlers
00691: #===============================================================================
00692: 
00693: Battle::ItemEffects::AccuracyCalcFromUser.add(:WIDELENS,
00694:   proc { |item, mods, user, target, move, type|
00695:     mods[:accuracy_multiplier] *= 1.1
00696:   }
00697: )
00698: 
00699: Battle::ItemEffects::AccuracyCalcFromUser.add(:ZOOMLENS,
00700:   proc { |item, mods, user, target, move, type|
00701:     if (target.battle.choices[target.index][0] != :UseMove &&
00702:        target.battle.choices[target.index][0] != :Shift) ||
00703:        target.movedThisRound?
00704:       mods[:accuracy_multiplier] *= 1.2
00705:     end
00706:   }
00707: )
00708: 
00709: #===============================================================================
00710: # AccuracyCalcFromTarget handlers
00711: #===============================================================================
00712: 
00713: Battle::ItemEffects::AccuracyCalcFromTarget.add(:BRIGHTPOWDER,
00714:   proc { |item, mods, user, target, move, type|
00715:     mods[:accuracy_multiplier] *= 0.9
00716:   }
00717: )
00718: 
00719: Battle::ItemEffects::AccuracyCalcFromTarget.copy(:BRIGHTPOWDER, :LAXINCENSE)
00720: 
