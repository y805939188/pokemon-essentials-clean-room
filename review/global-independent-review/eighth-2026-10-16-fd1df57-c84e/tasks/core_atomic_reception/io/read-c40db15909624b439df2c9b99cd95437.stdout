01696: Battle::ItemEffects::ExpGainModifier.add(:LUCKYEGG,
01697:   proc { |item, battler, exp|
01698:     next exp * 3 / 2
01699:   }
01700: )
01701: 
01702: #===============================================================================
01703: # EVGainModifier handlers
01704: #===============================================================================
01705: 
01706: Battle::ItemEffects::EVGainModifier.add(:MACHOBRACE,
01707:   proc { |item, battler, evYield|
01708:     evYield.each_key { |stat| evYield[stat] *= 2 }
01709:   }
01710: )
01711: 
01712: Battle::ItemEffects::EVGainModifier.add(:POWERANKLET,
01713:   proc { |item, battler, evYield|
01714:     evYield[:SPEED] += (Settings::MORE_EVS_FROM_POWER_ITEMS) ? 8 : 4
01715:   }
01716: )
01717: 
