00165:   "facts": [
00166:     {
00167:       "id": "CAA-CORE-F01",
00168:       "title": "HP/status/count三个写入边界",
00169:       "complete_sources": [
00170:         {
00171:           "path": "Data/Scripts/014_Pokemon/001_Pokemon.rb",
00172:           "lines": [
00173:             244,
00174:             305
00175:           ]
00176:         }
00177:       ],
00178:       "premises": [
00179:         "普通数值HP和非负上限",
00180:         "无外部覆写；Shadow另需自己的完整覆盖"
00181:       ],
00182:       "fact": "HP赋值先夹到0..上限；结果0时调用带蛋守卫的异常治疗，再清进化准备。异常设置先检查非蛋且HP>0，未通过时包括非法输入也不解析；通过后未知状态报错，成功只写状态不写count。count为直接可写字段，无数值域检查。HP/异常/PP/完整治疗各自带蛋早退，完整治疗依次HP、异常、PP再清进化准备。",
00183:       "normal_cancel_failure_partial_commit": "无交互取消。HP=0对蛋仍清进化准备而不清既有异常/count；完整治疗的后续PP槽失败可留下前两项已改。",
00184:       "actual_consumers": [
00185:         "Trainer.heal_party",
00186:         "Storage.pbCopy/pbStoreCaught",
00187:         "Battle::Peer.pbStorePokemon"
00188:       ],
00189:       "open": "Battler调用端完整读穿另由CORE提供；Shadow叠加尚未接收",
00190:       "reader": "/root/creature_a_atomic_reception",
00191:       "evidence": "SOURCE_STATIC",
00192:       "runtime": "NOT_EXECUTED",
00193:       "independent_acceptance": "PENDING_RECEIVER"
00194:     },
00195:     {
00196:       "id": "CAA-CORE-F02",
00197:       "title": "level/exp和form能力接口",
00198:       "complete_sources": [
00199:         {
00200:           "path": "Data/Scripts/014_Pokemon/001_Pokemon.rb",
00201:           "lines": [
00202:             113,
00203:             238
00204:           ]
00205:         },
00206:         {
00207:           "path": "Data/Scripts/014_Pokemon/001_Pokemon.rb",
00208:           "lines": [
00209:             1099,
00210:             1127
00211:           ]
00212:         }
00213:       ],
00214:       "premises": [
00215:         "物种/成长/能力记录有效",
00216:         "可比较合法等级；正常handler"
00217:       ],
00218:       "fact": "物种切换同基身份早退；异基身份先写基物种与选定形态，再清forced、条件gender、level和ability并重算。普通form读取有forced优先、战斗/仓库守卫和不同truthy结果提交；显式form即使同值也写形态/清ability/handler/重算/登记；setForm在清缓存后handler前yield；simple写只写形态及重算。level设置越界在exp/level写入之前报错；成功写最小经验和等级。exp裸写清level缓存。",
00219:       "normal_cancel_failure_partial_commit": "handler/yield/重算/图鉴均在早写形态之后，不保证回滚。无交互取消。",
00220:       "actual_consumers": [
00221:         "Battle::Peer三个form hook",
00222:         "Pokemon.species_data",
00223:         "Pokemon.calc_stats"
00224:       ],
00225:       "open": "GrowthRate/MultipleForms具体记录、handler全域由其他责任者或续读",
00226:       "reader": "/root/creature_a_atomic_reception",
00227:       "evidence": "SOURCE_STATIC",
00228:       "runtime": "NOT_EXECUTED",
00229:       "independent_acceptance": "PENDING_RECEIVER"
00230:     },
