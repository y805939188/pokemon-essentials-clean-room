00350:       "independent_findings": {
00351:         "producer": "默认PBS第5行CATERPIE两努力项，经PBPokemon.fromInspected/createPokemon(50,31,合法训练家)各分510/2=255；Pokemon创建六EV0，模板后写255，calc_stats仅按ev/4读取，不规范化。",
00352:         "order": "Stat.each_main通过Symbols.each按定义顺序，HP为第一主项；本例进入普通非Shadow分支时首个将处理HP。",
00353:         "consumer": "pbGainEVsOne先读取EV产出副本/累计510/可用物品修正/病毒后进入逐主项；HP的单项剩余252−255=−3，原生整数clamp上下界0>−3先失败，未到总量夹限或本项写入。HP产出0与1均不能绕过这个区间有效性条件。",
00354:         "default_gate": "pbOrganizedBattleEx在创建后明确internalBattle=false；普通pbGainExp先因!internalBattle退出，故正常设施不抵达该EV分配。没有必须expGain=false的证据，不应这样概括。",
00355:         "formal": "WP19§5.3承认模板255却将增量模式写成通用min且没有反向区间失败。WP30§4.4描述clamp和先EV后经验但没有该输入失败。WP42§4.2仅引用数值并描述后序，同样不补这个输入门。",
00356:         "contrary_formal": "WP28§6第6条与IU50已经限定“从受限状态增加”，这是正确保留范围，足以反驳“WP28无条件保证任何255输入安全”的广泛指控；不需要删除该限定或扩大本提案为全部物品外层错误。"
00357:       },
00358:       "rebuttal_attempts": [
00359:         {
00360:           "objection": "255是非法存量，属于无界手写数据，不纳必修。",
00361:           "result": "REJECTED_FOR_THIS_FINITE_SOURCE_DOMAIN",
00362:           "reason": "固定默认模板通过公开创建定义正常生产255，已纳GR-016接受范围；不需要直接修改EV储存来造反例。组合入口仍须明确为作者调用/单独EV辅助。"
00363:         },
00364:         {
00365:           "objection": "创建/等级调整的calc_stats会把255压回252。",
00366:           "result": "REJECTED",
00367:           "reason": "完整calc_stats只计算并写能力/HP，保留EV储存；WP19/ST67也已承认此事实。"
00368:         },
00369:         {
00370:           "objection": "总EV510意味着每项增加0，不会触发。",
00371:           "result": "REJECTED",
00372:           "reason": "本项单项clamp在总量clamp之前求值；负上界不等同于安全夹0。"
00373:         },
00374:         {
00375:           "objection": "HP产出0会在进入夹限前直接跳过。",
00376:           "result": "REJECTED",
00377:           "reason": "普通逐项循环无零产出早退；0仍调用无效区间clamp。"
00378:         },
00379:         {
00380:           "objection": "默认设施不会给经验，因此没有此正常设施故障。",
00381:           "result": "ACCEPTED_AS_STRICT_SCOPE_LIMIT",
00382:           "reason": "internalBattle=false确实阻断普通pbGainExp；此反例只能陈述有限可调用普通分配输入，不宣称默认工厂/塔/Demo会进入。"
00383:         },
00384:         {
00385:           "objection": "WP28已经有从受限状态的前提，故全部文档无需改。",
00386:           "result": "PARTLY_ACCEPTED",
00387:           "reason": "WP28对应保证正确，应保留；WP19/WP30战斗消费者的有限反向区间异常仍未被该道具不变量完整表达，不能用跨域隐含前提当作已映射失败合同。"
00388:         },
00389:         {
