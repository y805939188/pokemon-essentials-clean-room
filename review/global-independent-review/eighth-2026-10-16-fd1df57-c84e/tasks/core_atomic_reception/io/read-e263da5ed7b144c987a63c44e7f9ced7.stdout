01196: 
01197:   def pbEffectGeneral(user)
01198:     choice = @sleepTalkMoves[@battle.pbRandom(@sleepTalkMoves.length)]
01199:     user.pbUseMoveSimple(user.moves[choice].id, user.pbDirectOpposing.index)
01200:   end
01201: end
01202: 
01203: #===============================================================================
01204: # This round, reflects all moves that can be Magic Coated which target the user
01205: # or which have no target back at their origin. (Magic Coat)
01206: #===============================================================================
01207: class Battle::Move::BounceBackProblemCausingStatusMoves < Battle::Move
01208:   def pbEffectGeneral(user)
01209:     user.effects[PBEffects::MagicCoat] = true
01210:     @battle.pbDisplay(_INTL("{1} shrouded itself with Magic Coat!", user.pbThis))
01211:   end
01212: end
