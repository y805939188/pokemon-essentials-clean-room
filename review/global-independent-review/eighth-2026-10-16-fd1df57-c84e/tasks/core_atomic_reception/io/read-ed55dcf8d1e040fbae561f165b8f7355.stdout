00527: 
00528:   #=============================================================================
00529:   # Per-hit success check against the target.
00530:   # Includes semi-invulnerable move use and accuracy calculation.
00531:   #=============================================================================
00532:   def pbSuccessCheckPerHit(move, user, target, skipAccuracyCheck)
00533:     # Two-turn attacks can't fail here in the charging turn
00534:     return true if user.effects[PBEffects::TwoTurnAttack]
00535:     # Lock-On
00536:     return true if user.effects[PBEffects::LockOn] > 0 &&
00537:                    user.effects[PBEffects::LockOnPos] == target.index
00538:     # Toxic
00539:     return true if move.pbOverrideSuccessCheckPerHit(user, target)
00540:     miss = false
00541:     hitsInvul = false
00542:     # No Guard
00543:     hitsInvul = true if user.hasActiveAbility?(:NOGUARD) ||
00544:                         target.hasActiveAbility?(:NOGUARD)
00545:     # Future Sight
00546:     hitsInvul = true if @battle.futureSight
00547:     # Helping Hand
00548:     hitsInvul = true if move.function_code == "PowerUpAllyMove"
00549:     if !hitsInvul
00550:       # Semi-invulnerable moves
00551:       if target.effects[PBEffects::TwoTurnAttack]
00552:         if target.inTwoTurnAttack?("TwoTurnAttackInvulnerableInSky",
00553:                                    "TwoTurnAttackInvulnerableInSkyParalyzeTarget",
00554:                                    "TwoTurnAttackInvulnerableInSkyTargetCannotAct")
00555:           miss = true if !move.hitsFlyingTargets?
00556:         elsif target.inTwoTurnAttack?("TwoTurnAttackInvulnerableUnderground")
00557:           miss = true if !move.hitsDiggingTargets?
00558:         elsif target.inTwoTurnAttack?("TwoTurnAttackInvulnerableUnderwater")
00559:           miss = true if !move.hitsDivingTargets?
00560:         elsif target.inTwoTurnAttack?("TwoTurnAttackInvulnerableRemoveProtections")
00561:           miss = true
00562:         end
00563:       end
00564:       if target.effects[PBEffects::SkyDrop] >= 0 &&
00565:          target.effects[PBEffects::SkyDrop] != user.index && !move.hitsFlyingTargets?
00566:         miss = true
00567:       end
00568:     end
00569:     if miss
00570:       target.damageState.invulnerable = true
00571:       PBDebug.log("[Move failed] Target is semi-invulnerable")
00572:     else
00573:       # Called by another move
00574:       return true if skipAccuracyCheck
00575:       # Accuracy check
00576:       return true if move.pbAccuracyCheck(user, target)   # Includes Counter/Mirror Coat
00577:       PBDebug.log("[Move failed] Failed pbAccuracyCheck")
00578:     end
00579:     # Missed
00580:     return false
00581:   end
00582: 
00583:   #=============================================================================
00584:   # Message shown when a move fails the per-hit success check above.
00585:   #=============================================================================
00586:   def pbMissMessage(move, user, target)
00587:     if target.damageState.affection_missed
00588:       @battle.pbDisplay(_INTL("{1} avoided the move in time with your shout!", target.pbThis))
00589:     elsif move.pbTarget(user).num_targets > 1 || target.effects[PBEffects::TwoTurnAttack]
00590:       @battle.pbDisplay(_INTL("{1} avoided the attack!", target.pbThis))
00591:     elsif !move.pbMissMessage(user, target)
00592:       @battle.pbDisplay(_INTL("{1}'s attack missed!", user.pbThis))
00593:     end
00594:   end
00595: end
