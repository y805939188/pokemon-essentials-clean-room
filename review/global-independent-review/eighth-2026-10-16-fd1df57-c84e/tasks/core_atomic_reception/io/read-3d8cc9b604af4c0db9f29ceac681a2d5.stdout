02250: Battle::AbilityEffects::EndOfRoundWeather.add(:DRYSKIN,
02251:   proc { |ability, weather, battler, battle|
02252:     case weather
02253:     when :Sun, :HarshSun
02254:       if battler.takesIndirectDamage?
02255:         battle.pbShowAbilitySplash(battler)
02256:         battle.scene.pbDamageAnimation(battler)
02257:         battler.pbReduceHP(battler.totalhp / 8, false)
02258:         battle.pbDisplay(_INTL("{1} was hurt by the sunlight!", battler.pbThis))
02259:         battle.pbHideAbilitySplash(battler)
02260:         battler.pbItemHPHealCheck
02261:       end
02262:     when :Rain, :HeavyRain
02263:       next if !battler.canHeal?
02264:       battle.pbShowAbilitySplash(battler)
02265:       battler.pbRecoverHP(battler.totalhp / 8)
02266:       if Battle::Scene::USE_ABILITY_SPLASH
02267:         battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
02268:       else
02269:         battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", battler.pbThis, battler.abilityName))
02270:       end
02271:       battle.pbHideAbilitySplash(battler)
02272:     end
02273:   }
02274: )
02275: 
02276: Battle::AbilityEffects::EndOfRoundWeather.add(:ICEBODY,
02277:   proc { |ability, weather, battler, battle|
02278:     next unless weather == :Hail
02279:     next if !battler.canHeal?
02280:     battle.pbShowAbilitySplash(battler)
02281:     battler.pbRecoverHP(battler.totalhp / 16)
02282:     if Battle::Scene::USE_ABILITY_SPLASH
02283:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
02284:     else
02285:       battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", battler.pbThis, battler.abilityName))
02286:     end
02287:     battle.pbHideAbilitySplash(battler)
02288:   }
02289: )
02290: 
02291: Battle::AbilityEffects::EndOfRoundWeather.add(:ICEFACE,
02292:   proc { |ability, weather, battler, battle|
02293:     next if weather != :Hail
02294:     next if !battler.canRestoreIceFace || battler.form != 1
02295:     battle.pbShowAbilitySplash(battler)
02296:     if !Battle::Scene::USE_ABILITY_SPLASH
02297:       battle.pbDisplay(_INTL("{1}'s {2} activated!", battler.pbThis, battler.abilityName))
02298:     end
02299:     battler.pbChangeForm(0, _INTL("{1} transformed!", battler.pbThis))
02300:     battle.pbHideAbilitySplash(battler)
02301:   }
02302: )
02303: 
02304: Battle::AbilityEffects::EndOfRoundWeather.add(:RAINDISH,
02305:   proc { |ability, weather, battler, battle|
02306:     next if ![:Rain, :HeavyRain].include?(weather)
02307:     next if !battler.canHeal?
02308:     battle.pbShowAbilitySplash(battler)
02309:     battler.pbRecoverHP(battler.totalhp / 16)
02310:     if Battle::Scene::USE_ABILITY_SPLASH
02311:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
02312:     else
02313:       battle.pbDisplay(_INTL("{1}'s {2} restored its HP.", battler.pbThis, battler.abilityName))
02314:     end
02315:     battle.pbHideAbilitySplash(battler)
02316:   }
02317: )
02318: 
02319: Battle::AbilityEffects::EndOfRoundWeather.add(:SOLARPOWER,
02320:   proc { |ability, weather, battler, battle|
02321:     next if ![:Sun, :HarshSun].include?(weather)
02322:     next if !battler.takesIndirectDamage?
02323:     battle.pbShowAbilitySplash(battler)
02324:     battle.scene.pbDamageAnimation(battler)
02325:     battler.pbReduceHP(battler.totalhp / 8, false)
02326:     battle.pbDisplay(_INTL("{1} was hurt by the sunlight!", battler.pbThis))
02327:     battle.pbHideAbilitySplash(battler)
02328:     battler.pbItemHPHealCheck
02329:   }
02330: )
02331: 
02332: #===============================================================================
02333: # EndOfRoundHealing handlers
02334: #===============================================================================
02335: 
02336: Battle::AbilityEffects::EndOfRoundHealing.add(:HEALER,
02337:   proc { |ability, battler, battle|
02338:     next if battle.pbRandom(100) >= 30
02339:     battler.allAllies.each do |b|
02340:       next if b.status == :NONE
02341:       battle.pbShowAbilitySplash(battler)
02342:       oldStatus = b.status
02343:       b.pbCureStatus(Battle::Scene::USE_ABILITY_SPLASH)
02344:       if !Battle::Scene::USE_ABILITY_SPLASH
02345:         case oldStatus
02346:         when :SLEEP
02347:           battle.pbDisplay(_INTL("{1}'s {2} woke its partner up!", battler.pbThis, battler.abilityName))
02348:         when :POISON
02349:           battle.pbDisplay(_INTL("{1}'s {2} cured its partner's poison!", battler.pbThis, battler.abilityName))
02350:         when :BURN
02351:           battle.pbDisplay(_INTL("{1}'s {2} healed its partner's burn!", battler.pbThis, battler.abilityName))
02352:         when :PARALYSIS
02353:           battle.pbDisplay(_INTL("{1}'s {2} cured its partner's paralysis!", battler.pbThis, battler.abilityName))
02354:         when :FROZEN
02355:           battle.pbDisplay(_INTL("{1}'s {2} defrosted its partner!", battler.pbThis, battler.abilityName))
02356:         end
02357:       end
02358:       battle.pbHideAbilitySplash(battler)
02359:     end
02360:   }
02361: )
02362: 
02363: Battle::AbilityEffects::EndOfRoundHealing.add(:HYDRATION,
02364:   proc { |ability, battler, battle|
02365:     next if battler.status == :NONE
02366:     next if ![:Rain, :HeavyRain].include?(battler.effectiveWeather)
02367:     battle.pbShowAbilitySplash(battler)
02368:     oldStatus = battler.status
02369:     battler.pbCureStatus(Battle::Scene::USE_ABILITY_SPLASH)
02370:     if !Battle::Scene::USE_ABILITY_SPLASH
02371:       case oldStatus
02372:       when :SLEEP
02373:         battle.pbDisplay(_INTL("{1}'s {2} woke it up!", battler.pbThis, battler.abilityName))
02374:       when :POISON
02375:         battle.pbDisplay(_INTL("{1}'s {2} cured its poison!", battler.pbThis, battler.abilityName))
02376:       when :BURN
02377:         battle.pbDisplay(_INTL("{1}'s {2} healed its burn!", battler.pbThis, battler.abilityName))
02378:       when :PARALYSIS
02379:         battle.pbDisplay(_INTL("{1}'s {2} cured its paralysis!", battler.pbThis, battler.abilityName))
02380:       when :FROZEN
02381:         battle.pbDisplay(_INTL("{1}'s {2} defrosted it!", battler.pbThis, battler.abilityName))
02382:       end
02383:     end
02384:     battle.pbHideAbilitySplash(battler)
02385:   }
02386: )
02387: 
02388: Battle::AbilityEffects::EndOfRoundHealing.add(:SHEDSKIN,
02389:   proc { |ability, battler, battle|
02390:     next if battler.status == :NONE
02391:     next unless battle.pbRandom(100) < 30
02392:     battle.pbShowAbilitySplash(battler)
02393:     oldStatus = battler.status
02394:     battler.pbCureStatus(Battle::Scene::USE_ABILITY_SPLASH)
02395:     if !Battle::Scene::USE_ABILITY_SPLASH
02396:       case oldStatus
02397:       when :SLEEP
02398:         battle.pbDisplay(_INTL("{1}'s {2} woke it up!", battler.pbThis, battler.abilityName))
02399:       when :POISON
02400:         battle.pbDisplay(_INTL("{1}'s {2} cured its poison!", battler.pbThis, battler.abilityName))
02401:       when :BURN
02402:         battle.pbDisplay(_INTL("{1}'s {2} healed its burn!", battler.pbThis, battler.abilityName))
02403:       when :PARALYSIS
02404:         battle.pbDisplay(_INTL("{1}'s {2} cured its paralysis!", battler.pbThis, battler.abilityName))
02405:       when :FROZEN
02406:         battle.pbDisplay(_INTL("{1}'s {2} defrosted it!", battler.pbThis, battler.abilityName))
02407:       end
02408:     end
02409:     battle.pbHideAbilitySplash(battler)
02410:   }
02411: )
