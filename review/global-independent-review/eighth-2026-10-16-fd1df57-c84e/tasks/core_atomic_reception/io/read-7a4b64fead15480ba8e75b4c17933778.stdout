00267:     end
00268:     return __clauses__pbMoveFailed?(user, targets)
00269:   end
00270: end
00271: 
00272: #===============================================================================
00273: # Perish Song
00274: #===============================================================================
00275: class Battle::Move::StartPerishCountsForAllBattlers
00276:   unless method_defined?(:__clauses__pbFailsAgainstTarget?)
00277:     alias __clauses__pbFailsAgainstTarget? pbFailsAgainstTarget?
00278:   end
00279: 
00280:   def pbFailsAgainstTarget?(user, target, show_message)
00281:     if @battle.rules["perishsongclause"] &&
00282:        @battle.pbAbleNonActiveCount(user.idxOwnSide) == 0
00283:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00284:       return true
00285:     end
00286:     return __clauses__pbFailsAgainstTarget?(user, target, show_message)
00287:   end
00288: end
