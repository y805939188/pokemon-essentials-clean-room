00496: class Battle::Move::WeatherMove < Battle::Move
00497:   attr_reader :weatherType
00498: 
00499:   def initialize(battle, move)
00500:     super
00501:     @weatherType = :None
00502:   end
00503: 
00504:   def pbMoveFailed?(user, targets)
00505:     case @battle.field.weather
00506:     when :HarshSun
00507:       @battle.pbDisplay(_INTL("The extremely harsh sunlight was not lessened at all!"))
00508:       return true
00509:     when :HeavyRain
00510:       @battle.pbDisplay(_INTL("There is no relief from this heavy rain!"))
00511:       return true
00512:     when :StrongWinds
00513:       @battle.pbDisplay(_INTL("The mysterious air current blows on regardless!"))
00514:       return true
00515:     when @weatherType
00516:       @battle.pbDisplay(_INTL("But it failed!"))
00517:       return true
00518:     end
00519:     return false
00520:   end
00521: 
00522:   def pbEffectGeneral(user)
00523:     @battle.pbStartWeather(user, @weatherType, true, false)
