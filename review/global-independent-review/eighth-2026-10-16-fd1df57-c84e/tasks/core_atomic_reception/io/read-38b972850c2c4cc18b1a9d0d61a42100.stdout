00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Ability trigger checks
00004:   #=============================================================================
00005:   def pbAbilitiesOnSwitchOut
00006:     if abilityActive?
00007:       Battle::AbilityEffects.triggerOnSwitchOut(self.ability, self, false)
00008:     end
00009:     # Reset form
00010:     @battle.peer.pbOnLeavingBattle(@battle, @pokemon, @battle.usedInBattle[idxOwnSide][@index / 2])
00011:     # Check for end of Neutralizing Gas/Unnerve
00012:     if hasActiveAbility?(:NEUTRALIZINGGAS)
00013:       # Treat self as fainted
00014:       @hp = 0
00015:       @fainted = true
00016:       pbAbilitiesOnNeutralizingGasEnding
00017:     elsif hasActiveAbility?([:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH])
00018:       # Treat self as fainted
00019:       @hp = 0
00020:       @fainted = true
00021:       pbItemsOnUnnerveEnding
00022:     end
00023:     # Treat self as fainted
00024:     @hp = 0
00025:     @fainted = true
00026:     # Check for end of primordial weather
00027:     @battle.pbEndPrimordialWeather
00028:   end
00029: 
00030:   def pbAbilitiesOnFainting
