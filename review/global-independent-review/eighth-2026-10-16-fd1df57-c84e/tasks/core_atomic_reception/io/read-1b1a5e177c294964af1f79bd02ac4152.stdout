00303:         $game_temp.party_critical_hits_dealt[user.pokemonIndex] += 1
00304:       end
00305:       if target.damageState.affection_critical
00306:         if numTargets > 1
00307:           @battle.pbDisplay(_INTL("{1} landed a critical hit on {2}, wishing to be praised!",
00308:                                   user.pbThis, target.pbThis(true)))
00309:         else
00310:           @battle.pbDisplay(_INTL("{1} landed a critical hit, wishing to be praised!", user.pbThis))
00311:         end
00312:       elsif numTargets > 1
00313:         @battle.pbDisplay(_INTL("A critical hit on {1}!", target.pbThis(true)))
00314:       else
00315:         @battle.pbDisplay(_INTL("A critical hit!"))
00316:       end
00317:     end
00318:     # Effectiveness message, for moves with 1 hit
00319:     if !multiHitMove? && user.effects[PBEffects::ParentalBond] == 0
00320:       pbEffectivenessMessage(user, target, numTargets)
00321:     end
00322:     if target.damageState.substitute && target.effects[PBEffects::Substitute] == 0
00323:       target.effects[PBEffects::Substitute] = 0
00324:       @battle.pbDisplay(_INTL("{1}'s substitute faded!", target.pbThis))
00325:     end
00326:   end
00327: 
00328:   def pbEndureKOMessage(target)
00329:     if target.damageState.disguise
00330:       @battle.pbShowAbilitySplash(target)
00331:       if Battle::Scene::USE_ABILITY_SPLASH
00332:         @battle.pbDisplay(_INTL("Its disguise served it as a decoy!"))
00333:       else
00334:         @battle.pbDisplay(_INTL("{1}'s disguise served it as a decoy!", target.pbThis))
00335:       end
00336:       @battle.pbHideAbilitySplash(target)
00337:       target.pbChangeForm(1, _INTL("{1}'s disguise was busted!", target.pbThis))
00338:       target.pbReduceHP(target.totalhp / 8, false) if Settings::MECHANICS_GENERATION >= 8
00339:     elsif target.damageState.iceFace
00340:       @battle.pbShowAbilitySplash(target)
00341:       if !Battle::Scene::USE_ABILITY_SPLASH
00342:         @battle.pbDisplay(_INTL("{1}'s {2} activated!", target.pbThis, target.abilityName))
00343:       end
00344:       target.pbChangeForm(1, _INTL("{1} transformed!", target.pbThis))
00345:       @battle.pbHideAbilitySplash(target)
00346:     elsif target.damageState.endured
00347:       @battle.pbDisplay(_INTL("{1} endured the hit!", target.pbThis))
00348:     elsif target.damageState.sturdy
00349:       @battle.pbShowAbilitySplash(target)
