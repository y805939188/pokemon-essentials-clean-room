02979: Battle::AbilityEffects::OnSwitchIn.add(:SCREENCLEANER,
02980:   proc { |ability, battler, battle, switch_in|
02981:     next if battler.pbOwnSide.effects[PBEffects::AuroraVeil] == 0 &&
02982:             battler.pbOwnSide.effects[PBEffects::LightScreen] == 0 &&
02983:             battler.pbOwnSide.effects[PBEffects::Reflect] == 0 &&
02984:             battler.pbOpposingSide.effects[PBEffects::AuroraVeil] == 0 &&
02985:             battler.pbOpposingSide.effects[PBEffects::LightScreen] == 0 &&
02986:             battler.pbOpposingSide.effects[PBEffects::Reflect] == 0
02987:     battle.pbShowAbilitySplash(battler)
02988:     if battler.pbOpposingSide.effects[PBEffects::AuroraVeil] > 0
02989:       battler.pbOpposingSide.effects[PBEffects::AuroraVeil] = 0
02990:       battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", battler.pbOpposingTeam))
02991:     end
02992:     if battler.pbOpposingSide.effects[PBEffects::LightScreen] > 0
02993:       battler.pbOpposingSide.effects[PBEffects::LightScreen] = 0
02994:       battle.pbDisplay(_INTL("{1}'s Light Screen wore off!", battler.pbOpposingTeam))
02995:     end
02996:     if battler.pbOpposingSide.effects[PBEffects::Reflect] > 0
02997:       battler.pbOpposingSide.effects[PBEffects::Reflect] = 0
02998:       battle.pbDisplay(_INTL("{1}'s Reflect wore off!", battler.pbOpposingTeam))
02999:     end
03000:     if battler.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
03001:       battler.pbOwnSide.effects[PBEffects::AuroraVeil] = 0
03002:       battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", battler.pbTeam))
03003:     end
03004:     if battler.pbOwnSide.effects[PBEffects::LightScreen] > 0
03005:       battler.pbOwnSide.effects[PBEffects::LightScreen] = 0
03006:       battle.pbDisplay(_INTL("{1}'s Light Screen wore off!", battler.pbTeam))
03007:     end
03008:     if battler.pbOwnSide.effects[PBEffects::Reflect] > 0
03009:       battler.pbOwnSide.effects[PBEffects::Reflect] = 0
03010:       battle.pbDisplay(_INTL("{1}'s Reflect wore off!", battler.pbTeam))
03011:     end
03012:     battle.pbHideAbilitySplash(battler)
03013:   }
03014: )
03015: 
03016: Battle::AbilityEffects::OnSwitchIn.add(:SLOWSTART,
