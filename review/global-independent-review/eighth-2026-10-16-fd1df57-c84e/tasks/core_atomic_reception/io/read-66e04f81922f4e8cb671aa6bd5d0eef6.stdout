00100:     ret = super
00101:     @rounds[@roundindex][idxBattler] = [Commands::FIGHT, -1]
00102:     return ret
00103:   end
00104: 
00105:   def pbRegisterSwitch(idxBattler, idxParty)
00106:     if super
00107:       @rounds[@roundindex][idxBattler] = [Commands::POKEMON, idxParty]
