00174:   def pbCommandPhase
00175:     @command_phase = true
00176:     @scene.pbBeginCommandPhase
00177:     # Reset choices if commands can be shown
00178:     @battlers.each_with_index do |b, i|
00179:       next if !b
00180:       pbClearChoice(i) if pbCanShowCommands?(i)
00181:     end
00182:     # Reset choices to perform Mega Evolution if it wasn't done somehow
00183:     2.times do |side|
00184:       @megaEvolution[side].each_with_index do |megaEvo, i|
00185:         @megaEvolution[side][i] = -1 if megaEvo >= 0
00186:       end
00187:     end
00188:     # Choose actions for the round (player first, then AI)
00189:     pbCommandPhaseLoop(true)    # Player chooses their actions
00190:     if @decision != 0   # Battle ended, stop choosing actions
00191:       @command_phase = false
00192:       return
00193:     end
00194:     pbCommandPhaseLoop(false)   # AI chooses their actions
00195:     @command_phase = false
00196:   end
00197: 
00198:   def pbCommandPhaseLoop(isPlayer)
00199:     # NOTE: Doing some things (e.g. running, throwing a Poké Ball) takes up all
00200:     #       your actions in a round.
00201:     actioned = []
00202:     idxBattler = -1
00203:     loop do
00204:       break if @decision != 0   # Battle ended, stop choosing actions
00205:       idxBattler += 1
00206:       break if idxBattler >= @battlers.length
00207:       next if !@battlers[idxBattler] || pbOwnedByPlayer?(idxBattler) != isPlayer
00208:       if @choices[idxBattler][0] != :None || !pbCanShowCommands?(idxBattler)
00209:         # Action is forced, can't choose one
00210:         PBDebug.log_ai("#{@battlers[idxBattler].pbThis} (#{idxBattler}) is forced to use a multi-turn move")
00211:         next
00212:       end
00213:       # AI controls this battler
00214:       if @controlPlayer || !pbOwnedByPlayer?(idxBattler)
00215:         @battleAI.pbDefaultChooseEnemyCommand(idxBattler)
00216:         next
00217:       end
00218:       # Player chooses an action
00219:       actioned.push(idxBattler)
00220:       commandsEnd = false   # Whether to cancel choosing all other actions this round
00221:       loop do
00222:         cmd = pbCommandMenu(idxBattler, actioned.length == 1)
00223:         # If being Sky Dropped, can't do anything except use a move
00224:         if cmd > 0 && @battlers[idxBattler].effects[PBEffects::SkyDrop] >= 0
00225:           pbDisplay(_INTL("Sky Drop won't let {1} go!", @battlers[idxBattler].pbThis(true)))
00226:           next
00227:         end
00228:         case cmd
00229:         when 0    # Fight
00230:           break if pbFightMenu(idxBattler)
00231:         when 1    # Bag
00232:           if pbItemMenu(idxBattler, actioned.length == 1)
00233:             commandsEnd = true if pbItemUsesAllActions?(@choices[idxBattler][1])
00234:             break
00235:           end
00236:         when 2    # Pokémon
00237:           break if pbPartyMenu(idxBattler)
00238:         when 3    # Run
00239:           # NOTE: "Run" is only an available option for the first battler the
00240:           #       player chooses an action for in a round. Attempting to run
00241:           #       from battle prevents you from choosing any other actions in
00242:           #       that round.
00243:           if pbRunMenu(idxBattler)
00244:             commandsEnd = true
00245:             break
00246:           end
00247:         when 4    # Call
00248:           break if pbCallMenu(idxBattler)
00249:         when -2   # Debug
00250:           pbDebugMenu
00251:           next
00252:         when -1   # Go back to previous battler's action choice
00253:           next if actioned.length <= 1
00254:           actioned.pop   # Forget this battler was done
00255:           idxBattler = actioned.last - 1
00256:           pbCancelChoice(idxBattler + 1)   # Clear the previous battler's choice
00257:           actioned.pop   # Forget the previous battler was done
00258:           break
00259:         end
00260:         pbCancelChoice(idxBattler)
00261:       end
00262:       break if commandsEnd
00263:     end
00264:   end
00265: end
