00285:     when 7, 9   # Up diagonals
00286:       # Treated as moving horizontally first and then up, because that describes
00287:       # which tiles the character's feet touch
00288:       x_diff = (dir == 9) ? @width - 1 : 0
00289:       ((start_y - @height + 1)..start_y).each do |i|
00290:         return false if !passable?(start_x + x_diff, i, dir - 3, strict)
00291:       end
00292:       x_tile_offset = (dir == 9) ? 1 : -1
00293:       (start_x...(start_x + @width)).each do |i|
00294:         return false if !passable?(i + x_tile_offset, start_y - @height + 1, 8, strict)
00295:       end
00296:       return true
00297:     end
00298:     return false
00299:   end
00300: 
00301:   def can_move_in_direction?(dir, strict = false)
00302:     return can_move_from_coordinate?(@x, @y, dir, strict)
00303:   end
00304: 
00305:   #=============================================================================
00306:   # Screen position of the character
00307:   #=============================================================================
00308:   def screen_x
00309:     ret = ((@real_x.to_f - self.map.display_x) / Game_Map::X_SUBPIXELS).round
00310:     ret += @width * Game_Map::TILE_WIDTH / 2
