00183:   def get_character(parameter = 0)
00184:     case parameter
00185:     when -1   # player
00186:       return $game_player
00187:     when 0    # this event
00188:       events = $game_map.events
00189:       return (events) ? events[@event_id] : nil
00190:     else      # specific event
00191:       events = $game_map.events
00192:       return (events) ? events[parameter] : nil
00193:     end
00194:   end
