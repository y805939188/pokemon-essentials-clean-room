00381: class Battle::Move::DoublePowerAfterFusionFlare < Battle::Move
00382:   def pbChangeUsageCounters(user, specialUsage)
00383:     @doublePower = @battle.field.effects[PBEffects::FusionFlare]
00384:     super
00385:   end
00386: 
00387:   def pbBaseDamageMultiplier(damageMult, user, target)
00388:     damageMult *= 2 if @doublePower
00389:     return damageMult
00390:   end
00391: 
00392:   def pbEffectGeneral(user)
00393:     @battle.field.effects[PBEffects::FusionBolt] = true
00394:   end
00395: 
00396:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00397:     hitNum = 1 if (targets.length > 0 && targets[0].damageState.critical) ||
00398:                   @doublePower   # Charged anim
00399:     super
00400:   end
00401: end
00402: 
00403: #===============================================================================
00404: # Power is doubled if Fusion Bolt has already been used this round. (Fusion Flare)
00405: #===============================================================================
00406: class Battle::Move::DoublePowerAfterFusionBolt < Battle::Move
