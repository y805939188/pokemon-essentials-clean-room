00303:   def pbSuccessCheckAgainstTarget(move, user, target, targets)
00304:     show_message = move.pbShowFailMessages?(targets)
00305:     typeMod = move.pbCalcTypeMod(move.calcType, user, target)
00306:     target.damageState.typeMod = typeMod
00307:     # Two-turn attacks can't fail here in the charging turn
00308:     return true if user.effects[PBEffects::TwoTurnAttack]
00309:     # Move-specific failures
00310:     if move.pbFailsAgainstTarget?(user, target, show_message)
00311:       PBDebug.log(sprintf("[Move failed] In function code %s's def pbFailsAgainstTarget?", move.function_code))
00312:       return false
00313:     end
00314:     # Immunity to priority moves because of Psychic Terrain
00315:     if @battle.field.terrain == :Psychic && target.affectedByTerrain? && target.opposes?(user) &&
00316:        @battle.choices[user.index][4] > 0   # Move priority saved from pbCalculatePriority
00317:       @battle.pbDisplay(_INTL("{1} surrounds itself with psychic terrain!", target.pbThis)) if show_message
00318:       return false
00319:     end
00320:     # Crafty Shield
00321:     if target.pbOwnSide.effects[PBEffects::CraftyShield] && user.index != target.index &&
00322:        move.statusMove? && !move.pbTarget(user).targets_all
00323:       if show_message
00324:         @battle.pbCommonAnimation("CraftyShield", target)
00325:         @battle.pbDisplay(_INTL("Crafty Shield protected {1}!", target.pbThis(true)))
00326:       end
00327:       target.damageState.protected = true
00328:       @battle.successStates[user.index].protected = true
00329:       return false
00330:     end
00331:     if !(user.hasActiveAbility?(:UNSEENFIST) && move.contactMove?)
00332:       # Wide Guard
00333:       if target.pbOwnSide.effects[PBEffects::WideGuard] && user.index != target.index &&
00334:          move.pbTarget(user).num_targets > 1 &&
00335:          (Settings::MECHANICS_GENERATION >= 7 || move.damagingMove?)
00336:         if show_message
00337:           @battle.pbCommonAnimation("WideGuard", target)
00338:           @battle.pbDisplay(_INTL("Wide Guard protected {1}!", target.pbThis(true)))
00339:         end
00340:         target.damageState.protected = true
00341:         @battle.successStates[user.index].protected = true
00342:         return false
00343:       end
00344:       if move.canProtectAgainst?
00345:         # Quick Guard
00346:         if target.pbOwnSide.effects[PBEffects::QuickGuard] &&
00347:            @battle.choices[user.index][4] > 0   # Move priority saved from pbCalculatePriority
00348:           if show_message
00349:             @battle.pbCommonAnimation("QuickGuard", target)
00350:             @battle.pbDisplay(_INTL("Quick Guard protected {1}!", target.pbThis(true)))
00351:           end
00352:           target.damageState.protected = true
00353:           @battle.successStates[user.index].protected = true
00354:           return false
00355:         end
00356:         # Protect
00357:         if target.effects[PBEffects::Protect]
00358:           if show_message
00359:             @battle.pbCommonAnimation("Protect", target)
00360:             @battle.pbDisplay(_INTL("{1} protected itself!", target.pbThis))
