00345:       multipliers[:power_multiplier] *= 1.5
00346:     end
00347:     if user.effects[PBEffects::HelpingHand] && !self.is_a?(Battle::Move::Confusion)
00348:       multipliers[:power_multiplier] *= 1.5
00349:     end
00350:     if user.effects[PBEffects::Charge] > 0 && type == :ELECTRIC
00351:       multipliers[:power_multiplier] *= 2
00352:     end
00353:     # Mud Sport
00354:     if type == :ELECTRIC
00355:       if @battle.allBattlers.any? { |b| b.effects[PBEffects::MudSport] }
00356:         multipliers[:power_multiplier] /= 3
00357:       end
00358:       if @battle.field.effects[PBEffects::MudSportField] > 0
00359:         multipliers[:power_multiplier] /= 3
00360:       end
00361:     end
00362:     # Water Sport
00363:     if type == :FIRE
00364:       if @battle.allBattlers.any? { |b| b.effects[PBEffects::WaterSport] }
00365:         multipliers[:power_multiplier] /= 3
00366:       end
00367:       if @battle.field.effects[PBEffects::WaterSportField] > 0
00368:         multipliers[:power_multiplier] /= 3
00369:       end
00370:     end
