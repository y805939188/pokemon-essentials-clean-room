00551: Battle::ItemEffects::StatusCure.add(:MENTALHERB,
00552:   proc { |item, battler, battle, forced|
00553:     next false if battler.effects[PBEffects::Attract] == -1 &&
00554:                   battler.effects[PBEffects::Taunt] == 0 &&
00555:                   battler.effects[PBEffects::Encore] == 0 &&
00556:                   !battler.effects[PBEffects::Torment] &&
00557:                   battler.effects[PBEffects::Disable] == 0 &&
00558:                   battler.effects[PBEffects::HealBlock] == 0
00559:     itemName = GameData::Item.get(item).name
00560:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}")
00561:     battle.pbCommonAnimation("UseItem", battler) if !forced
00562:     if battler.effects[PBEffects::Attract] >= 0
00563:       if forced
00564:         battle.pbDisplay(_INTL("{1} got over its infatuation.", battler.pbThis))
00565:       else
00566:         battle.pbDisplay(_INTL("{1} cured its infatuation status using its {2}!",
00567:            battler.pbThis, itemName))
00568:       end
00569:       battler.pbCureAttract
00570:     end
00571:     battle.pbDisplay(_INTL("{1}'s taunt wore off!", battler.pbThis)) if battler.effects[PBEffects::Taunt] > 0
00572:     battler.effects[PBEffects::Taunt] = 0
00573:     battle.pbDisplay(_INTL("{1}'s encore ended!", battler.pbThis)) if battler.effects[PBEffects::Encore] > 0
00574:     battler.effects[PBEffects::Encore]     = 0
00575:     battler.effects[PBEffects::EncoreMove] = nil
00576:     battle.pbDisplay(_INTL("{1}'s torment wore off!", battler.pbThis)) if battler.effects[PBEffects::Torment]
00577:     battler.effects[PBEffects::Torment] = false
00578:     battle.pbDisplay(_INTL("{1} is no longer disabled!", battler.pbThis)) if battler.effects[PBEffects::Disable] > 0
00579:     battler.effects[PBEffects::Disable] = 0
00580:     battle.pbDisplay(_INTL("{1}'s Heal Block wore off!", battler.pbThis)) if battler.effects[PBEffects::HealBlock] > 0
00581:     battler.effects[PBEffects::HealBlock] = 0
00582:     next true
00583:   }
00584: )
00585: 
00586: Battle::ItemEffects::StatusCure.add(:PECHABERRY,
00587:   proc { |item, battler, battle, forced|
