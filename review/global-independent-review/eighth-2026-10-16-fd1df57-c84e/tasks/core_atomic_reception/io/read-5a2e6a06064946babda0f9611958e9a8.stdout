00708:     # are near to any foes
00709:     pbEORShiftDistantBattlers
00710:     # Try to make Trace work, check for end of primordial weather
00711:     priority.each { |battler| battler.pbContinualAbilityChecks }
00712:     # Reset/count down battler-specific effects (no messages)
00713:     allBattlers.each do |battler|
00714:       battler.effects[PBEffects::BanefulBunker]    = false
00715:       battler.effects[PBEffects::Charge]           -= 1 if battler.effects[PBEffects::Charge] > 0
00716:       battler.effects[PBEffects::Counter]          = -1
00717:       battler.effects[PBEffects::CounterTarget]    = -1
00718:       battler.effects[PBEffects::Electrify]        = false
00719:       battler.effects[PBEffects::Endure]           = false
00720:       battler.effects[PBEffects::FirstPledge]      = nil
00721:       battler.effects[PBEffects::Flinch]           = false
00722:       battler.effects[PBEffects::FocusPunch]       = false
00723:       battler.effects[PBEffects::FollowMe]         = 0
00724:       battler.effects[PBEffects::HelpingHand]      = false
00725:       battler.effects[PBEffects::HyperBeam]        -= 1 if battler.effects[PBEffects::HyperBeam] > 0
00726:       battler.effects[PBEffects::KingsShield]      = false
00727:       battler.effects[PBEffects::LaserFocus]       -= 1 if battler.effects[PBEffects::LaserFocus] > 0
00728:       if battler.effects[PBEffects::LockOn] > 0   # Also Mind Reader
00729:         battler.effects[PBEffects::LockOn]         -= 1
00730:         battler.effects[PBEffects::LockOnPos]      = -1 if battler.effects[PBEffects::LockOn] == 0
00731:       end
00732:       battler.effects[PBEffects::MagicBounce]      = false
00733:       battler.effects[PBEffects::MagicCoat]        = false
00734:       battler.effects[PBEffects::MirrorCoat]       = -1
00735:       battler.effects[PBEffects::MirrorCoatTarget] = -1
00736:       battler.effects[PBEffects::Obstruct]         = false
00737:       battler.effects[PBEffects::Powder]           = false
00738:       battler.effects[PBEffects::Prankster]        = false
00739:       battler.effects[PBEffects::PriorityAbility]  = false
00740:       battler.effects[PBEffects::PriorityItem]     = false
00741:       battler.effects[PBEffects::Protect]          = false
00742:       battler.effects[PBEffects::RagePowder]       = false
00743:       battler.effects[PBEffects::Roost]            = false
00744:       battler.effects[PBEffects::Snatch]           = 0
00745:       battler.effects[PBEffects::SpikyShield]      = false
00746:       battler.effects[PBEffects::Spotlight]        = 0
00747:       battler.effects[PBEffects::ThroatChop]       -= 1 if battler.effects[PBEffects::ThroatChop] > 0
00748:       battler.lastHPLost                           = 0
00749:       battler.lastHPLostFromFoe                    = 0
00750:       battler.droppedBelowHalfHP                   = false
00751:       battler.statsDropped                         = false
00752:       battler.tookMoveDamageThisRound              = false
00753:       battler.tookDamageThisRound                  = false
00754:       battler.tookPhysicalHit                      = false
00755:       battler.statsRaisedThisRound                 = false
00756:       battler.statsLoweredThisRound                = false
00757:       battler.canRestoreIceFace                    = false
00758:       battler.lastRoundMoveFailed                  = battler.lastMoveFailed
00759:       battler.lastAttacker.clear
00760:       battler.lastFoeAttacker.clear
00761:     end
00762:     # Reset/count down side-specific effects (no messages)
00763:     2.times do |side|
00764:       @sides[side].effects[PBEffects::CraftyShield]         = false
00765:       if !@sides[side].effects[PBEffects::EchoedVoiceUsed]
00766:         @sides[side].effects[PBEffects::EchoedVoiceCounter] = 0
00767:       end
00768:       @sides[side].effects[PBEffects::EchoedVoiceUsed]      = false
00769:       @sides[side].effects[PBEffects::MatBlock]             = false
00770:       @sides[side].effects[PBEffects::QuickGuard]           = false
00771:       @sides[side].effects[PBEffects::Round]                = false
00772:       @sides[side].effects[PBEffects::WideGuard]            = false
00773:     end
00774:     # Reset/count down field-specific effects (no messages)
00775:     @field.effects[PBEffects::IonDeluge]   = false
00776:     @field.effects[PBEffects::FairyLock]   -= 1 if @field.effects[PBEffects::FairyLock] > 0
00777:     @field.effects[PBEffects::FusionBolt]  = false
00778:     @field.effects[PBEffects::FusionFlare] = false
00779:     @endOfRound = false
00780:   end
00781: end
