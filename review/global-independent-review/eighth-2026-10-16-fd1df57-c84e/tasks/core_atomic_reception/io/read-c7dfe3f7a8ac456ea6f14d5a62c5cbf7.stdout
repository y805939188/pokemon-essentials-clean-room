00376:       @battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true))) if show_message
00377:       return true
00378:     end
00379:     return false
00380:   end
00381: 
00382:   def pbEffectAgainstTarget(user, target)
