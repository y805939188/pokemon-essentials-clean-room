03123: #===============================================================================
03124: # ChangeOnBattlerFainting handlers
03125: #===============================================================================
03126: 
03127: Battle::AbilityEffects::ChangeOnBattlerFainting.add(:POWEROFALCHEMY,
03128:   proc { |ability, battler, fainted, battle|
03129:     next if battler.opposes?(fainted)
03130:     next if fainted.ungainableAbility? ||
03131:        [:POWEROFALCHEMY, :RECEIVER, :TRACE, :WONDERGUARD].include?(fainted.ability_id)
03132:     battle.pbShowAbilitySplash(battler, true)
03133:     battler.ability = fainted.ability
03134:     battle.pbReplaceAbilitySplash(battler)
03135:     battle.pbDisplay(_INTL("{1}'s {2} was taken over!", fainted.pbThis, fainted.abilityName))
03136:     battle.pbHideAbilitySplash(battler)
03137:   }
03138: )
03139: 
03140: Battle::AbilityEffects::ChangeOnBattlerFainting.copy(:POWEROFALCHEMY, :RECEIVER)
03141: 
03142: #===============================================================================
03143: # OnBattlerFainting handlers
03144: #===============================================================================
03145: 
03146: Battle::AbilityEffects::OnBattlerFainting.add(:SOULHEART,
03147:   proc { |ability, battler, fainted, battle|
03148:     battler.pbRaiseStatStageByAbility(:SPECIAL_ATTACK, 1, battler)
03149:   }
03150: )
03151: 
03152: #===============================================================================
03153: # OnTerrainChange handlers
03154: #===============================================================================
03155: 
03156: Battle::AbilityEffects::OnTerrainChange.add(:MIMICRY,
03157:   proc { |ability, battler, battle, ability_changed|
03158:     if battle.field.terrain == :None
03159:       # Revert to original typing
03160:       battle.pbShowAbilitySplash(battler)
03161:       battler.pbResetTypes
03162:       battle.pbDisplay(_INTL("{1} changed back to its regular type!", battler.pbThis))
03163:       battle.pbHideAbilitySplash(battler)
03164:     else
03165:       # Change to new typing
03166:       terrain_hash = {
03167:         :Electric => :ELECTRIC,
03168:         :Grassy   => :GRASS,
03169:         :Misty    => :FAIRY,
03170:         :Psychic  => :PSYCHIC
03171:       }
03172:       new_type = terrain_hash[battle.field.terrain]
03173:       new_type_name = nil
03174:       if new_type
03175:         type_data = GameData::Type.try_get(new_type)
03176:         new_type = nil if !type_data
03177:         new_type_name = type_data.name if type_data
03178:       end
03179:       if new_type
03180:         battle.pbShowAbilitySplash(battler)
03181:         battler.pbChangeTypes(new_type)
03182:         battle.pbDisplay(_INTL("{1}'s type changed to {2}!", battler.pbThis, new_type_name))
03183:         battle.pbHideAbilitySplash(battler)
03184:       end
03185:     end
03186:   }
03187: )
03188: 
03189: #===============================================================================
03190: # OnIntimidated handlers
03191: #===============================================================================
03192: 
03193: Battle::AbilityEffects::OnIntimidated.add(:RATTLED,
03194:   proc { |ability, battler, battle|
03195:     next if Settings::MECHANICS_GENERATION < 8
03196:     battler.pbRaiseStatStageByAbility(:SPEED, 1, battler)
03197:   }
03198: )
03199: 
03200: #===============================================================================
03201: # CertainEscapeFromBattle handlers
03202: #===============================================================================
03203: 
03204: Battle::AbilityEffects::CertainEscapeFromBattle.add(:RUNAWAY,
03205:   proc { |ability, battler|
03206:     next true
03207:   }
03208: )
