03060: #===============================================================================
03061: # OnSwitchOut handlers
03062: #===============================================================================
03063: 
03064: Battle::AbilityEffects::OnSwitchOut.add(:IMMUNITY,
03065:   proc { |ability, battler, endOfBattle|
03066:     next if battler.status != :POISON
03067:     PBDebug.log("[Ability triggered] #{battler.pbThis}'s #{battler.abilityName}")
03068:     battler.status = :NONE
03069:   }
03070: )
03071: 
03072: Battle::AbilityEffects::OnSwitchOut.add(:INSOMNIA,
03073:   proc { |ability, battler, endOfBattle|
03074:     next if battler.status != :SLEEP
03075:     PBDebug.log("[Ability triggered] #{battler.pbThis}'s #{battler.abilityName}")
03076:     battler.status = :NONE
03077:   }
03078: )
03079: 
03080: Battle::AbilityEffects::OnSwitchOut.copy(:INSOMNIA, :VITALSPIRIT)
