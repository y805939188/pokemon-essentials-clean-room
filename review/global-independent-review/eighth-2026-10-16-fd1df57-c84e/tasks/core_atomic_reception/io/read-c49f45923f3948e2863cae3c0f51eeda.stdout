03052: Battle::AbilityEffects::OnSwitchIn.add(:UNNERVE,
03053:   proc { |ability, battler, battle, switch_in|
03054:     battle.pbShowAbilitySplash(battler)
03055:     battle.pbDisplay(_INTL("{1} is too nervous to eat Berries!", battler.pbOpposingTeam))
03056:     battle.pbHideAbilitySplash(battler)
03057:   }
03058: )
