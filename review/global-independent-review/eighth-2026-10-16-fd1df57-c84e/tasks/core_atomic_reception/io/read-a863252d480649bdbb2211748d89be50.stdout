00142:   def skip_battle?
00143:     return true if $player.able_pokemon_count == 0
00144:     return true if $DEBUG && Input.press?(Input::CTRL)
00145:     return false
00146:   end
00147: 
00148:   def skip_battle(outcome_variable, trainer_battle = false)
00149:     pbMessage(_INTL("SKIPPING BATTLE...")) if !trainer_battle && $player.pokemon_count > 0
00150:     pbMessage(_INTL("SKIPPING BATTLE...")) if trainer_battle && $DEBUG
00151:     pbMessage(_INTL("AFTER WINNING...")) if trainer_battle && $player.able_pokemon_count > 0
00152:     $game_temp.clear_battle_rules
00153:     if $game_temp.memorized_bgm && $game_system.is_a?(Game_System)
00154:       $game_system.bgm_pause
00155:       $game_system.bgm_position = $game_temp.memorized_bgm_position
00156:       $game_system.bgm_resume($game_temp.memorized_bgm)
00157:     end
00158:     $game_temp.memorized_bgm            = nil
00159:     $game_temp.memorized_bgm_position   = 0
00160:     $PokemonGlobal.nextBattleBGM        = nil
00161:     $PokemonGlobal.nextBattleVictoryBGM = nil
00162:     $PokemonGlobal.nextBattleCaptureME  = nil
00163:     $PokemonGlobal.nextBattleBack       = nil
00164:     $PokemonEncounters.reset_step_count
00165:     outcome = 1   # Win
00166:     outcome = 0 if trainer_battle && $player.able_pokemon_count == 0   # Undecided
00167:     pbSet(outcome_variable, outcome)
00168:     return outcome
00169:   end
