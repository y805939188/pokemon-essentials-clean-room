00275:       break
00276:     end
00277:     damageAnims.each { |a| a.dispose }
00278:   end
00279: 
00280:   #=============================================================================
00281:   # Animates a data box's Exp bar
00282:   #=============================================================================
00283:   def pbEXPBar(battler, startExp, endExp, tempExp1, tempExp2)
00284:     return if !battler || endExp == startExp
00285:     startExpLevel = tempExp1 - startExp
00286:     endExpLevel   = tempExp2 - startExp
00287:     expRange      = endExp - startExp
00288:     dataBox = @sprites["dataBox_#{battler.index}"]
00289:     dataBox.animate_exp(startExpLevel, endExpLevel, expRange)
00290:     while dataBox.animating_exp?
00291:       pbUpdate
00292:     end
00293:   end
00294: 
00295:   #=============================================================================
00296:   # Shows stats windows upon a Pokémon levelling up
00297:   #=============================================================================
00298:   def pbLevelUp(pkmn, _battler, oldTotalHP, oldAttack, oldDefense, oldSpAtk, oldSpDef, oldSpeed)
00299:     pbTopRightWindow(
00300:       _INTL("Max. HP<r>+{1}\nAttack<r>+{2}\nDefense<r>+{3}\nSp. Atk<r>+{4}\nSp. Def<r>+{5}\nSpeed<r>+{6}",
00301:             pkmn.totalhp - oldTotalHP, pkmn.attack - oldAttack, pkmn.defense - oldDefense,
00302:             pkmn.spatk - oldSpAtk, pkmn.spdef - oldSpDef, pkmn.speed - oldSpeed)
00303:     )
00304:     pbTopRightWindow(
00305:       _INTL("Max. HP<r>{1}\nAttack<r>{2}\nDefense<r>{3}\nSp. Atk<r>{4}\nSp. Def<r>{5}\nSpeed<r>{6}",
00306:             pkmn.totalhp, pkmn.attack, pkmn.defense, pkmn.spatk, pkmn.spdef, pkmn.speed)
00307:     )
00308:   end
00309: 
00310:   #=============================================================================
00311:   # Animates a Pokémon fainting
00312:   #=============================================================================
00313:   def pbFaintBattler(battler)
00314:     @briefMessage = false
00315:     # Pokémon plays cry and drops down, data box disappears
00316:     faintAnim   = Animation::BattlerFaint.new(@sprites, @viewport, battler.index, @battle)
00317:     dataBoxAnim = Animation::DataBoxDisappear.new(@sprites, @viewport, battler.index)
00318:     loop do
00319:       faintAnim.update
00320:       dataBoxAnim.update
00321:       pbUpdate
00322:       break if faintAnim.animDone? && dataBoxAnim.animDone?
00323:     end
00324:     faintAnim.dispose
00325:     dataBoxAnim.dispose
00326:   end
