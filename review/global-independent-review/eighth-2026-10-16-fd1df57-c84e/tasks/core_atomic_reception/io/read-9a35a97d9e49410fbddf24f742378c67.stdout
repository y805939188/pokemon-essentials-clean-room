00379: #===============================================================================
00380: # Ends the effects of Light Screen, Reflect and Safeguard on both sides.
00381: # (Shadow Shed)
00382: #===============================================================================
00383: class Battle::Move::RemoveAllScreensAndSafeguard < Battle::Move
00384:   def pbMoveFailed?(user, targets)
00385:     will_fail = true
00386:     @battle.sides.each do |side|
00387:       will_fail = false if side.effects[PBEffects::AuroraVeil] > 0 ||
00388:                            side.effects[PBEffects::LightScreen] > 0 ||
00389:                            side.effects[PBEffects::Reflect] > 0 ||
00390:                            side.effects[PBEffects::Safeguard] > 0
00391:     end
00392:     if will_fail
00393:       @battle.pbDisplay(_INTL("But it failed!"))
00394:       return true
00395:     end
00396:     return false
00397:   end
00398: 
00399:   def pbEffectGeneral(user)
00400:     @battle.sides.each do |i|
00401:       i.effects[PBEffects::AuroraVeil]  = 0
00402:       i.effects[PBEffects::LightScreen] = 0
00403:       i.effects[PBEffects::Reflect]     = 0
00404:       i.effects[PBEffects::Safeguard]   = 0
00405:     end
00406:     @battle.pbDisplay(_INTL("It broke all barriers!"))
00407:   end
00408: end
00409: 
00410: #===============================================================================
00411: #
