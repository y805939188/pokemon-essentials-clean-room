00198: class Battle::Move::TargetMultiStatDownMove < Battle::Move
00199:   attr_reader :statDown
00200: 
00201:   def canMagicCoat?; return true; end
00202: 
00203:   def pbFailsAgainstTarget?(user, target, show_message)
00204:     return false if damagingMove?
00205:     failed = true
00206:     (@statDown.length / 2).times do |i|
00207:       next if !target.pbCanLowerStatStage?(@statDown[i * 2], user, self)
00208:       failed = false
00209:       break
00210:     end
00211:     if failed
00212:       # NOTE: It's a bit of a faff to make sure the appropriate failure message
00213:       #       is shown here, I know.
00214:       canLower = false
00215:       if target.hasActiveAbility?(:CONTRARY) && !@battle.moldBreaker
00216:         (@statDown.length / 2).times do |i|
00217:           next if target.statStageAtMax?(@statDown[i * 2])
00218:           canLower = true
00219:           break
00220:         end
00221:         @battle.pbDisplay(_INTL("{1}'s stats won't go any higher!", user.pbThis)) if !canLower && show_message
00222:       else
00223:         (@statDown.length / 2).times do |i|
00224:           next if target.statStageAtMin?(@statDown[i * 2])
00225:           canLower = true
00226:           break
00227:         end
00228:         @battle.pbDisplay(_INTL("{1}'s stats won't go any lower!", user.pbThis)) if !canLower && show_message
00229:       end
00230:       if canLower
00231:         target.pbCanLowerStatStage?(@statDown[0], user, self, show_message)
00232:       end
00233:       return true
00234:     end
00235:     return false
00236:   end
00237: 
00238:   def pbCheckForMirrorArmor(user, target)
00239:     if target.hasActiveAbility?(:MIRRORARMOR) && user.index != target.index
00240:       failed = true
00241:       (@statDown.length / 2).times do |i|
00242:         next if target.statStageAtMin?(@statDown[i * 2])
00243:         next if !user.pbCanLowerStatStage?(@statDown[i * 2], target, self, false, false, true)
00244:         failed = false
00245:         break
00246:       end
00247:       if failed
00248:         @battle.pbShowAbilitySplash(target)
00249:         if !Battle::Scene::USE_ABILITY_SPLASH
00250:           @battle.pbDisplay(_INTL("{1}'s {2} activated!", target.pbThis, target.abilityName))
00251:         end
00252:         user.pbCanLowerStatStage?(@statDown[0], target, self, true, false, true)   # Show fail message
00253:         @battle.pbHideAbilitySplash(target)
00254:         return false
00255:       end
00256:     end
00257:     return true
00258:   end
00259: 
00260:   def pbLowerTargetMultipleStats(user, target)
00261:     return if !pbCheckForMirrorArmor(user, target)
00262:     showAnim = true
00263:     showMirrorArmorSplash = true
00264:     (@statDown.length / 2).times do |i|
00265:       next if !target.pbCanLowerStatStage?(@statDown[i * 2], user, self)
00266:       if target.pbLowerStatStage(@statDown[i * 2], @statDown[(i * 2) + 1], user,
00267:                                  showAnim, false, (showMirrorArmorSplash) ? 1 : 3)
00268:         showAnim = false
00269:       end
00270:       showMirrorArmorSplash = false
00271:     end
00272:     @battle.pbHideAbilitySplash(target)   # To hide target's Mirror Armor splash
00273:   end
00274: 
00275:   def pbEffectAgainstTarget(user, target)
00276:     pbLowerTargetMultipleStats(user, target) if !damagingMove?
00277:   end
00278: 
00279:   def pbAdditionalEffect(user, target)
00280:     pbLowerTargetMultipleStats(user, target) if !target.damageState.substitute
00281:   end
00282: end
00283: 
00284: #===============================================================================
00285: # Fixed damage-inflicting move.
00286: #===============================================================================
00287: class Battle::Move::FixedDamageMove < Battle::Move
00288:   def pbFixedDamage(user, target); return 1; end
