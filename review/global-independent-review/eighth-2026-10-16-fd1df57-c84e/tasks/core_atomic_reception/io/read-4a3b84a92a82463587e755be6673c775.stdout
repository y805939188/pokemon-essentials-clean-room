00657:     # Damage from poison/burn
00658:     pbEORStatusProblemDamage(priority)
00659:     # Damage from Nightmare and Curse
00660:     pbEOREffectDamage(priority)
00661:     # Trapping attacks (Bind/Clamp/Fire Spin/Magma Storm/Sand Tomb/Whirlpool/Wrap)
00662:     priority.each { |battler| pbEORTrappingDamage(battler) }
00663:     # Octolock
00664:     priority.each do |battler|
00665:       next if battler.fainted? || battler.effects[PBEffects::Octolock] < 0
00666:       pbCommonAnimation("Octolock", battler)
00667:       battler.pbLowerStatStage(:DEFENSE, 1, nil) if battler.pbCanLowerStatStage?(:DEFENSE)
00668:       battler.pbLowerStatStage(:SPECIAL_DEFENSE, 1, nil) if battler.pbCanLowerStatStage?(:SPECIAL_DEFENSE)
00669:       battler.pbItemOnStatDropped
00670:     end
00671:     # Effects that apply to a battler that wear off after a number of rounds
00672:     pbEOREndBattlerEffects(priority)
00673:     # Check for end of battle (i.e. because of Perish Song)
00674:     if @decision > 0
00675:       pbGainExp
00676:       return
00677:     end
00678:     # Effects that apply to a side that wear off after a number of rounds
00679:     2.times { |side| pbEOREndSideEffects(side, priority) }
00680:     # Effects that apply to the whole field that wear off after a number of rounds
00681:     pbEOREndFieldEffects(priority)
00682:     # End of terrains
00683:     pbEOREndTerrain
00684:     priority.each do |battler|
00685:       # Self-inflicted effects that wear off after a number of rounds
00686:       pbEOREndBattlerSelfEffects(battler)
00687:       # Bad Dreams, Moody, Speed Boost
00688:       if battler.abilityActive?
00689:         Battle::AbilityEffects.triggerEndOfRoundEffect(battler.ability, battler, self)
00690:       end
00691:       # Flame Orb, Sticky Barb, Toxic Orb
00692:       if battler.itemActive?
00693:         Battle::ItemEffects.triggerEndOfRoundEffect(battler.item, battler, self)
00694:       end
00695:       # Harvest, Pickup, Ball Fetch
00696:       if battler.abilityActive?
00697:         Battle::AbilityEffects.triggerEndOfRoundGainItem(battler.ability, battler, self)
00698:       end
00699:     end
00700:     pbGainExp
00701:     return if @decision > 0
00702:     # Form checks
00703:     priority.each { |battler| battler.pbCheckForm(true) }
00704:     # Switch Pokémon in if possible
00705:     pbEORSwitch
00706:     return if @decision > 0
00707:     # In battles with at least one side of size 3+, move battlers around if none
00708:     # are near to any foes
00709:     pbEORShiftDistantBattlers
00710:     # Try to make Trace work, check for end of primordial weather
