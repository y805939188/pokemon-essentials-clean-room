00001: module GameData
00002:   class BattleWeather
00003:     attr_reader :id
00004:     attr_reader :real_name
00005:     attr_reader :animation
00006: 
00007:     DATA = {}
00008: 
00009:     extend ClassMethodsSymbols
00010:     include InstanceMethods
00011: 
00012:     def self.load; end
00013:     def self.save; end
00014: 
00015:     def initialize(hash)
00016:       @id        = hash[:id]
00017:       @real_name = hash[:name] || "Unnamed"
00018:       @animation = hash[:animation]
00019:     end
00020: 
00021:     # @return [String] the translated name of this battle weather
00022:     def name
00023:       return _INTL(@real_name)
00024:     end
00025:   end
00026: end
