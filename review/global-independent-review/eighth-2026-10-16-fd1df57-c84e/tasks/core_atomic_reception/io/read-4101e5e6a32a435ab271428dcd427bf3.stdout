00129:       Battle::AbilityEffects.triggerAccuracyCalcFromUser(
00130:         user.ability, modifiers, user, target, self, @calcType
00131:       )
00132:     end
00133:     user.allAllies.each do |b|
00134:       next if !b.abilityActive?
