00081:   #=============================================================================
00082:   # Accuracy check
00083:   #=============================================================================
00084:   def pbBaseAccuracy(user, target); return @accuracy; end
00085: 
00086:   # Accuracy calculations for one-hit KO moves are handled elsewhere.
00087:   def pbAccuracyCheck(user, target)
00088:     # "Always hit" effects and "always hit" accuracy
00089:     return true if target.effects[PBEffects::Telekinesis] > 0
00090:     return true if target.effects[PBEffects::Minimize] && tramplesMinimize? && Settings::MECHANICS_GENERATION >= 6
00091:     baseAcc = pbBaseAccuracy(user, target)
00092:     return true if baseAcc == 0
00093:     # Calculate all multiplier effects
00094:     modifiers = {}
00095:     modifiers[:base_accuracy]  = baseAcc
00096:     modifiers[:accuracy_stage] = user.stages[:ACCURACY]
00097:     modifiers[:evasion_stage]  = target.stages[:EVASION]
00098:     modifiers[:accuracy_multiplier] = 1.0
00099:     modifiers[:evasion_multiplier]  = 1.0
00100:     pbCalcAccuracyModifiers(user, target, modifiers)
00101:     # Check if move can't miss
00102:     return true if modifiers[:base_accuracy] == 0
00103:     # Calculation
00104:     max_stage = Battle::Battler::STAT_STAGE_MAXIMUM
00105:     accStage = [[modifiers[:accuracy_stage], -max_stage].max, max_stage].min + max_stage
00106:     evaStage = [[modifiers[:evasion_stage], -max_stage].max, max_stage].min + max_stage
00107:     stageMul = Battle::Battler::ACC_EVA_STAGE_MULTIPLIERS
00108:     stageDiv = Battle::Battler::ACC_EVA_STAGE_DIVISORS
00109:     accuracy = 100.0 * stageMul[accStage] / stageDiv[accStage]
00110:     evasion  = 100.0 * stageMul[evaStage] / stageDiv[evaStage]
00111:     accuracy = (accuracy * modifiers[:accuracy_multiplier]).round
00112:     evasion  = (evasion  * modifiers[:evasion_multiplier]).round
00113:     evasion = 1 if evasion < 1
00114:     threshold = modifiers[:base_accuracy] * accuracy / evasion
00115:     # Calculation
00116:     r = @battle.pbRandom(100)
00117:     if Settings::AFFECTION_EFFECTS && @battle.internalBattle &&
00118:        target.pbOwnedByPlayer? && target.affection_level == 5 && !target.mega?
00119:       return true if r < threshold - 10
00120:       target.damageState.affection_missed = true if r < threshold
00121:       return false
00122:     end
00123:     return r < threshold
00124:   end
00125: 
