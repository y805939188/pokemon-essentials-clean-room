00051:   end
00052: 
00053:   def pbCanSwitchIn?(idxBattler, _idxParty, partyScene = nil)
00054:     partyScene&.pbDisplay(_INTL("{1} can't be switched out!", @battlers[idxBattler].pbThis))
00055:     return false
00056:   end
00057: 
00058:   def pbEORSwitch(favorDraws = false)
00059:     return if favorDraws && @decision == 5
00060:     return if !favorDraws && @decision > 0
00061:     pbJudge
00062:     return if @decision > 0
00063:     2.times do |side|
00064:       next if !@battlers[side].fainted?
00065:       next if @partyindexes[side] + 1 >= self.pbParty(side).length
00066:       @partyindexes[side] += 1
00067:       newpoke = @partyindexes[side]
00068:       pbMessagesOnReplace(side, newpoke)
00069:       pbReplace(side, newpoke)
00070:       pbOnBattlerEnteringBattle(side)
00071:     end
00072:   end
00073: 
00074:   def pbOnAllBattlersEnteringBattle
00075:     @battlersChanged = true
00076:     2.times do |side|
00077:       @mind[side]    = 0
00078:       @skill[side]   = 0
00079:       @starthp[side] = battlers[side].hp
00080:     end
00081:     @count           = 0
00082:     return super
00083:   end
