00191:     # @param gender [Integer] gender to register (0=male, 1=female, 2=genderless)
00192:     # @param form [Integer] form to register
00193:     # @param shiny [Boolean] shininess to register
00194:     # @param should_refresh_dexes [Boolean] whether to recalculate accessible Dex lists
00195:     def register(species, gender = 0, form = 0, shiny = false, should_refresh_dexes = true)
00196:       if species.is_a?(Pokemon)
00197:         species_data = species.species_data
00198:         gender = species.gender
00199:         shiny = species.shiny?
00200:       else
00201:         species_data = GameData::Species.get_species_form(species, form)
00202:       end
00203:       species = species_data.species
00204:       gender = 0 if gender >= 2
00205:       form = species_data.form
00206:       shin = (shiny) ? 1 : 0
00207:       if form != species_data.pokedex_form
00208:         species_data = GameData::Species.get_species_form(species, species_data.pokedex_form)
00209:         form = species_data.form
00210:       end
00211:       form = 0 if species_data.form_name.nil? || species_data.form_name.empty?
00212:       # Register as seen
00213:       @seen[species] = true
00214:       @seen_forms[species] ||= [[[], []], [[], []]]
00215:       @seen_forms[species][gender][shin][form] = true
00216:       @last_seen_forms[species] ||= []
00217:       @last_seen_forms[species] = [gender, form, shiny] if @last_seen_forms[species] == []
00218:       self.refresh_accessible_dexes if should_refresh_dexes
00219:     end
00220: 
00221:     # @param pkmn [Pokemon] Pokemon to register as most recently seen
00222:     def register_last_seen(pkmn)
00223:       validate pkmn => Pokemon
00224:       species_data = pkmn.species_data
00225:       form = species_data.pokedex_form
00226:       form = 0 if species_data.form_name.nil? || species_data.form_name.empty?
00227:       @last_seen_forms[pkmn.species] = [pkmn.gender, form, pkmn.shiny?]
00228:     end
00229: 
00230:     #---------------------------------------------------------------------------
00231: 
00232:     # @param species [Symbol, GameData::Species] species to check
00233:     # @return [Integer] the number of Pokémon of the given species that have
00234:     #   been caught by the player
00235:     def caught_count(species)
00236:       species_id = GameData::Species.try_get(species)&.species
00237:       return 0 if species_id.nil?
00238:       return @caught_counts[species_id] || 0
00239:     end
00240: 
00241:     # @param species [Symbol, GameData::Species] species to check
00242:     # @return [Integer] the number of Pokémon of the given species that have
00243:     #   been defeated by the player
00244:     def defeated_count(species)
00245:       species_id = GameData::Species.try_get(species)&.species
00246:       return 0 if species_id.nil?
00247:       return @defeated_counts[species_id] || 0
00248:     end
00249: 
00250:     # @param species [Symbol, GameData::Species] species to check
00251:     # @return [Integer] the number of Pokémon of the given species that have
00252:     #   been defeated or caught by the player
00253:     def battled_count(species)
00254:       species_id = GameData::Species.try_get(species)&.species
00255:       return 0 if species_id.nil?
00256:       return (@defeated_counts[species_id] || 0) + (@caught_counts[species_id] || 0)
00257:     end
00258: 
00259:     # @param species [Symbol, GameData::Species] species to count as caught
00260:     def register_caught(species)
00261:       species_id = GameData::Species.try_get(species)&.species
00262:       return if species_id.nil?
00263:       @caught_counts[species_id] = 0 if @caught_counts[species_id].nil?
00264:       @caught_counts[species_id] += 1
00265:     end
00266: 
00267:     # @param species [Symbol, GameData::Species] species to count as defeated
00268:     def register_defeated(species)
00269:       species_id = GameData::Species.try_get(species)&.species
00270:       return if species_id.nil?
00271:       @defeated_counts[species_id] = 0 if @defeated_counts[species_id].nil?
00272:       @defeated_counts[species_id] += 1
00273:     end
00274: 
00275:     #---------------------------------------------------------------------------
00276: 
00277:     # Unlocks the given Dex, -1 being the National Dex.
00278:     # @param dex [Integer] Dex ID (-1 is the National Dex)
00279:     def unlock(dex)
00280:       validate dex => Integer
00281:       dex = @unlocked_dexes.length - 1 if dex < 0 || dex > @unlocked_dexes.length - 1
00282:       @unlocked_dexes[dex] = true
00283:       self.refresh_accessible_dexes
00284:     end
00285: 
00286:     # Locks the given Dex, -1 being the National Dex.
00287:     # @param dex [Integer] Dex ID (-1 is the National Dex)
00288:     def lock(dex)
00289:       validate dex => Integer
00290:       dex = @unlocked_dexes.length - 1 if dex < 0 || dex > @unlocked_dexes.length - 1
00291:       @unlocked_dexes[dex] = false
00292:       self.refresh_accessible_dexes
00293:     end
00294: 
00295:     # @param dex [Integer] Dex ID (-1 is the National Dex)
00296:     # @return [Boolean] whether the given Dex is unlocked
00297:     def unlocked?(dex)
00298:       validate dex => Integer
00299:       dex = @unlocked_dexes.length - 1 if dex == -1
00300:       return @unlocked_dexes[dex] == true
00301:     end
00302: 
00303:     # @return [Integer] the number of defined Dexes (including the National Dex)
00304:     def dexes_count
00305:       return @unlocked_dexes.length
00306:     end
00307: 
00308:     # Decides which Dex lists are able to be viewed (i.e. they are unlocked and
00309:     # have at least 1 seen species in them), and saves all accessible Dex region
00310:     # numbers into {#accessible_dexes}. National Dex comes after all regional
00311:     # Dexes.
00312:     # If the Dex list shown depends on the player's location, this just decides
00313:     # if a species in the current region has been seen - doesn't look at other
00314:     # regions.
00315:     def refresh_accessible_dexes
00316:       @accessible_dexes = []
00317:       if Settings::USE_CURRENT_REGION_DEX
00318:         region = pbGetCurrentRegion
00319:         region = -1 if region >= dexes_count - 1
00320:         @accessible_dexes[0] = region if self.seen_any?(region)
00321:         return
00322:       end
00323:       if dexes_count == 1   # Only National Dex is defined
00324:         @accessible_dexes.push(-1) if self.unlocked?(0) && self.seen_any?
00325:       else   # Regional Dexes + National Dex
00326:         dexes_count.times do |i|
00327:           dex_list_to_check = (i == dexes_count - 1) ? -1 : i
00328:           if self.unlocked?(i) && self.seen_any?(dex_list_to_check)
00329:             @accessible_dexes.push(dex_list_to_check)
00330:           end
00331:         end
00332:       end
00333:     end
00334: 
00335:     def species_in_unlocked_dex?(species)
00336:       return true if @unlocked_dexes.last
00337:       (@unlocked_dexes.length - 1).times do |i|
00338:         next if !self.unlocked?(i)
00339:         return true if pbGetRegionalNumber(i, species) > 0
00340:       end
00341:       return false
00342:     end
00343: 
00344:     #---------------------------------------------------------------------------
00345: 
00346:     private
00347: 
00348:     # @param hash [Hash]
00349:     # @param region [Integer]
00350:     # @return [Integer]
00351:     def count_species(hash, region = -1)
00352:       ret = 0
00353:       if region == -1
00354:         GameData::Species.each_species { |s| ret += 1 if hash[s.species] }
00355:       else
00356:         pbAllRegionalSpecies(region).each { |s| ret += 1 if s && hash[s] }
00357:       end
00358:       return ret
00359:     end
00360:   end
00361: end
