00048:   def pbAttackPhaseSwitch
00049:     pbPriority.each do |b|
00050:       next unless @choices[b.index][0] == :SwitchOut && !b.fainted?
00051:       idxNewPkmn = @choices[b.index][1]   # Party index of Pokémon to switch to
00052:       b.lastMoveFailed = false   # Counts as a successful move for Stomping Tantrum
00053:       @lastMoveUser = b.index
00054:       # Switching message
00055:       pbMessageOnRecall(b)
00056:       # Pursuit interrupts switching
00057:       pbPursuit(b.index)
00058:       return if @decision > 0
00059:       # Switch Pokémon
00060:       allBattlers.each do |b2|
00061:         b2.droppedBelowHalfHP = false
00062:         b2.statsDropped = false
00063:       end
00064:       pbRecallAndReplace(b.index, idxNewPkmn)
00065:       pbOnBattlerEnteringBattle(b.index, true)
00066:     end
00067:   end
