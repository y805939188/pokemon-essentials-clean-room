00038:       "1_exact_formal_assertion": {
00039:         "old_locator": "CORE-C0140",
00040:         "manual_child": "CAR-C0140-12",
00041:         "line": 255,
00042:         "whole_line": "- 善后（结果， 可败）：全队中毒个体的状态计数清零（剧毒计数变常规）；Mega/Primal 显式还原（此善后与濒死路径才有，普通换下不解除——引用 WP41 分层）；有伙伴时治疗玩家全队并治疗/还原伙伴全队；负/平且可败时全队治疗并等待 0.25 秒；触发「战斗结束」；玩家转向正前。",
00043:         "wrong_child": "玩家转向正前",
00044:         "scope": "Only final player-facing phrase; other poison/shape/registered-partner/loss healing/wait/end-event statements stay intact."
00045:       },
00046:       "2_complete_source_units": [
00047:         {
00048:           "path": "/workspace/pokemon-essentials/Data/Scripts/012_Overworld/002_Battle triggering/001_Overworld_BattleStarting.rb",
00049:           "range": [
00050:             306,
00051:             329
00052:           ],
00053:           "content": "  def after_battle(outcome, can_lose)\n    $player.party.each do |pkmn|\n      pkmn.statusCount = 0 if pkmn.status == :POISON   # Bad poison becomes regular\n      pkmn.makeUnmega\n      pkmn.makeUnprimal\n    end\n    if $PokemonGlobal.partner\n      $player.heal_party\n      $PokemonGlobal.partner[3].each do |pkmn|\n        pkmn.heal\n        pkmn.makeUnmega\n        pkmn.makeUnprimal\n      end\n    end\n    if [2, 5].include?(outcome) && can_lose   # if loss or draw\n      $player.party.each { |pkmn| pkmn.heal }\n      timer_start = System.uptime\n      until System.uptime - timer_start >= 0.25\n        Graphics.update\n      end\n    end\n    EventHandlers.trigger(:on_end_battle, outcome, can_lose)\n    $game_player.straighten\n  end\n",
00054:           "bytes": 32672,
00055:           "sha256": "c4e1ca1833df530a244df4084d0d381f95f8c01f8757441691bbcfe0cf9264b1",
00056:           "actual_reader": "/root/core_atomic_reception",
00057:           "reading": "PERSONALLY_FULL_FILE_749_LINES"
00058:         },
00059:         {
00060:           "path": "/workspace/pokemon-essentials/Data/Scripts/004_Game classes/006_Game_Character.rb",
00061:           "range": [
00062:             356,
00063:             360
00064:           ],
00065:           "content": "  def straighten\n    @pattern = 0 if @walk_anime || @step_anime\n    @anime_count = 0\n    @prelock_direction = 0\n  end\n",
00066:           "bytes": 30978,
00067:           "sha256": "48496384805d3d5b67c6ba990486de4d53f60cfb7a09e4fc81a3a8350a18d871",
00068:           "actual_reader": "/root/core_atomic_reception",
