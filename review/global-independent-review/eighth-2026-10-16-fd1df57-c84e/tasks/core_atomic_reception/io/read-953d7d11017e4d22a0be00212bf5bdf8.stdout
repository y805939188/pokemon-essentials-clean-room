00073:           "range": [
00074:             815,
00075:             826
00076:           ],
00077:           "content": "  def turn_generic(dir)\n    return if @direction_fix\n    oldDirection = @direction\n    @direction = dir\n    @stop_count = 0\n    check_event_trigger_after_turning if dir != oldDirection\n  end\n\n  def turn_down;  turn_generic(2); end\n  def turn_left;  turn_generic(4); end\n  def turn_right; turn_generic(6); end\n  def turn_up;    turn_generic(8); end\n",
00078:           "bytes": 30978,
00079:           "sha256": "48496384805d3d5b67c6ba990486de4d53f60cfb7a09e4fc81a3a8350a18d871",
00080:           "actual_reader": "/root/core_atomic_reception",
00081:           "reading": "PARTIAL_FILE_COMPLETE_TURN_METHODS"
00082:         },
00083:         {
