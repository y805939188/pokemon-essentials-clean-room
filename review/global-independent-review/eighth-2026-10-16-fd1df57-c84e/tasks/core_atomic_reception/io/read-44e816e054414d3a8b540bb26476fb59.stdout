00057:   def self.from_pokemon_move(battle, move)
00058:     validate move => Pokemon::Move
00059:     code = move.function_code || "None"
00060:     if code[/^\d/]   # Begins with a digit
00061:       class_name = sprintf("Battle::Move::Effect%s", code)
00062:     else
00063:       class_name = sprintf("Battle::Move::%s", code)
00064:     end
00065:     if Object.const_defined?(class_name)
00066:       return Object.const_get(class_name).new(battle, move)
00067:     end
00068:     return Battle::Move::Unimplemented.new(battle, move)
00069:   end
