00168: class Battle::Move::RemoveTargetItem < Battle::Move
00169:   def pbBaseDamage(baseDmg, user, target)
00170:     if Settings::MECHANICS_GENERATION >= 6 &&
00171:        target.item && !target.unlosableItem?(target.item)
00172:       # NOTE: Damage is still boosted even if target has Sticky Hold or a
00173:       #       substitute.
00174:       baseDmg = (baseDmg * 1.5).round
00175:     end
00176:     return baseDmg
00177:   end
00178: 
00179:   def pbEffectAfterAllHits(user, target)
00180:     return if user.wild?   # Wild Pokémon can't knock off
00181:     return if user.fainted?
00182:     return if target.damageState.unaffected || target.damageState.substitute
00183:     return if !target.item || target.unlosableItem?(target.item)
00184:     return if target.hasActiveAbility?(:STICKYHOLD) && !@battle.moldBreaker
00185:     itemName = target.itemName
00186:     target.pbRemoveItem(false)
00187:     @battle.pbDisplay(_INTL("{1} dropped its {2}!", target.pbThis, itemName))
00188:   end
00189: end
