01076:   def calcIV
01077:     this_ivs = self.iv
01078:     ret = {}
01079:     GameData::Stat.each_main do |s|
01080:       ret[s.id] = (@ivMaxed[s.id]) ? IV_STAT_LIMIT : this_ivs[s.id]
01081:     end
01082:     return ret
01083:   end
01084: 
01085:   # @return [Integer] the maximum HP of this Pokémon
01086:   def calcHP(base, level, iv, ev)
01087:     return 1 if base == 1   # For Shedinja
01088:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
01089:     return (((base * 2) + iv + (ev / 4)) * level / 100).floor + level + 10
01090:   end
01091: 
01092:   # @return [Integer] the specified stat of this Pokémon (not used for total HP)
01093:   def calcStat(base, level, iv, ev, nat)
01094:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
01095:     return (((((base * 2) + iv + (ev / 4)) * level / 100).floor + 5) * nat / 100).floor
01096:   end
