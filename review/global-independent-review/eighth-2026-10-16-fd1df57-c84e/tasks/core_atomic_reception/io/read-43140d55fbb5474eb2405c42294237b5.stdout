00001: class Battle::Battler
00002:   #=============================================================================
00003:   # Turn processing
00004:   #=============================================================================
00005:   def pbProcessTurn(choice, tryFlee = true)
00006:     return false if fainted?
00007:     # Wild roaming Pokémon always flee if possible
00008:     if tryFlee && wild? &&
00009:        @battle.rules["alwaysflee"] && @battle.pbCanRun?(@index)
00010:       pbBeginTurn(choice)
00011:       pbSEPlay("Battle flee")
00012:       @battle.pbDisplay(_INTL("{1} fled from battle!", pbThis))
00013:       @battle.decision = 3
00014:       pbEndTurn(choice)
00015:       return true
00016:     end
00017:     # Shift with the battler next to this one
00018:     if choice[0] == :Shift
00019:       idxOther = -1
00020:       case @battle.pbSideSize(@index)
00021:       when 2
00022:         idxOther = (@index + 2) % 4
00023:       when 3
00024:         if @index != 2 && @index != 3   # If not in middle spot already
00025:           idxOther = (@index.even?) ? 2 : 3
00026:         end
00027:       end
00028:       if idxOther >= 0
00029:         @battle.pbSwapBattlers(@index, idxOther)
00030:         case @battle.pbSideSize(@index)
00031:         when 2
00032:           @battle.pbDisplay(_INTL("{1} moved across!", pbThis))
00033:         when 3
00034:           @battle.pbDisplay(_INTL("{1} moved to the center!", pbThis))
00035:         end
00036:       end
00037:       pbBeginTurn(choice)
00038:       pbCancelMoves
00039:       @lastRoundMoved = @battle.turnCount   # Done something this round
00040:       return true
00041:     end
00042:     # If this battler's action for this round wasn't "use a move"
00043:     if choice[0] != :UseMove
00044:       # Clean up effects that end at battler's turn
00045:       pbBeginTurn(choice)
00046:       pbEndTurn(choice)
00047:       return false
00048:     end
00049:     # Use the move
00050:     PBDebug.log("[Use move] #{pbThis} (#{@index}) used #{choice[2].name}")
00051:     PBDebug.logonerr { pbUseMove(choice, choice[2] == @battle.struggle) }
00052:     @battle.pbJudge
00053:     # Update priority order
00054:     @battle.pbCalculatePriority if Settings::RECALCULATE_TURN_ORDER_AFTER_SPEED_CHANGES
00055:     return true
00056:   end
00057: 
00058:   #=============================================================================
00059:   #
00060:   #=============================================================================
00061:   def pbBeginTurn(_choice)
00062:     # Cancel some lingering effects which only apply until the user next moves
00063:     @effects[PBEffects::DestinyBondPrevious] = @effects[PBEffects::DestinyBond]
00064:     @effects[PBEffects::DestinyBond]         = false
00065:     @effects[PBEffects::Grudge]              = false
00066:     @effects[PBEffects::MoveNext]            = false
00067:     @effects[PBEffects::Quash]               = 0
00068:     # Encore's effect ends if the encored move is no longer available
00069:     if @effects[PBEffects::Encore] > 0 && pbEncoredMoveIndex < 0
00070:       @effects[PBEffects::Encore]     = 0
00071:       @effects[PBEffects::EncoreMove] = nil
00072:     end
00073:   end
00074: 
00075:   # Called when the usage of various multi-turn moves is disrupted due to
00076:   # failing pbTryUseMove, being ineffective against all targets, or because
00077:   # Pursuit was used specially to intercept a switching foe.
00078:   # Cancels the use of multi-turn moves and counters thereof. Note that Hyper
00079:   # Beam's effect is NOT cancelled.
00080:   def pbCancelMoves(full_cancel = false)
00081:     # Outragers get confused anyway if they are disrupted during their final
00082:     # turn of using the move
00083:     if @effects[PBEffects::Outrage] == 1 && pbCanConfuseSelf?(false) && !full_cancel
00084:       pbConfuse(_INTL("{1} became confused due to fatigue!", pbThis))
00085:     end
00086:     # Cancel usage of most multi-turn moves
00087:     @effects[PBEffects::TwoTurnAttack] = nil
00088:     @effects[PBEffects::Rollout]       = 0
00089:     @effects[PBEffects::Outrage]       = 0
00090:     @effects[PBEffects::Uproar]        = 0
00091:     @effects[PBEffects::Bide]          = 0
00092:     @currentMove = nil if @effects[PBEffects::HyperBeam] == 0
00093:     # Reset counters for moves which increase them when used in succession
00094:     @effects[PBEffects::FuryCutter] = 0
00095:   end
00096: 
00097:   def pbEndTurn(_choice)
00098:     @lastRoundMoved = @battle.turnCount   # Done something this round
00099:     if !@effects[PBEffects::ChoiceBand] &&
00100:        (hasActiveItem?([:CHOICEBAND, :CHOICESPECS, :CHOICESCARF]) ||
00101:        hasActiveAbility?(:GORILLATACTICS))
00102:       if @lastMoveUsed && pbHasMove?(@lastMoveUsed)
00103:         @effects[PBEffects::ChoiceBand] = @lastMoveUsed
00104:       elsif @lastRegularMoveUsed && pbHasMove?(@lastRegularMoveUsed)
00105:         @effects[PBEffects::ChoiceBand] = @lastRegularMoveUsed
00106:       end
00107:     end
00108:     @effects[PBEffects::BeakBlast]   = false
00109:     @effects[PBEffects::Charge]      = 0 if @effects[PBEffects::Charge] == 1
00110:     @effects[PBEffects::GemConsumed] = nil
00111:     @effects[PBEffects::ShellTrap]   = false
00112:     @battle.allBattlers.each { |b| b.pbContinualAbilityChecks }   # Trace, end primordial weathers
00113:   end
00114: 
00115:   def pbConfusionDamage(msg)
00116:     @damageState.reset
00117:     confusionMove = Battle::Move::Confusion.new(@battle, nil)
00118:     confusionMove.calcType = confusionMove.pbCalcType(self)   # nil
00119:     @damageState.typeMod = confusionMove.pbCalcTypeMod(confusionMove.calcType, self, self)   # 8
00120:     confusionMove.pbCheckDamageAbsorption(self, self)
00121:     confusionMove.pbCalcDamage(self, self)
00122:     confusionMove.pbReduceDamage(self, self)
00123:     self.hp -= @damageState.hpLost
00124:     confusionMove.pbAnimateHitAndHPLost(self, [self])
00125:     @battle.pbDisplay(msg)   # "It hurt itself in its confusion!"
00126:     confusionMove.pbRecordDamageLost(self, self)
00127:     confusionMove.pbEndureKOMessage(self)
00128:     pbFaint if fainted?
00129:     pbItemHPHealCheck
00130:   end
