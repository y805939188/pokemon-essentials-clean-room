00002: {"id":"UI67-U002","name":"战斗更新/窗口/终场","sources":[{"repo":"/workspace/pokemon-essentials","commit":"8c5911e4a4b07b07e832e4bb0d5d8859e88b4a9b","tree":"7589c800b61ba13a13040ed0d686979b80a84fd0","path":"Data/Scripts/011_Battle/004_Scene/001_Battle_Scene.rb","mode":"100644","bytes":13731,"sha256":"a744f0eb4d040372c7219c0ccd8502cd957f109b536d83513ccdcc54587721a8","blob":"1b949814487382dac9d8ed2772b4fff65253f9d2","reader":"/root/ui_full","status":"FULL_READ","ranges":[[1,419]],"whole_file_read":true,"lines":419,"semantic_selector":"positions/update/refresh/showWindow/end/reset/swap"}],"facts":[{"id":"UI67-F002-01","assertion":"单打位置从对应base中心起。"},{"id":"UI67-F002-02","assertion":"双打按index四项位移表。"},{"id":"UI67-F002-03","assertion":"三打按index六项位移表。"},{"id":"UI67-F002-04","assertion":"trainer单双三按side+index独立位移。"},{"id":"UI67-F002-05","assertion":"pbUpdate先graphics再input再frame。"},{"id":"UI67-F002-06","assertion":"graphics先更新每个排队动画。"},{"id":"UI67-F002-07","assertion":"done动画dispose置nil后compact。"},{"id":"UI67-F002-08","assertion":"battle_bg若respond update才更新。"},{"id":"UI67-F002-09","assertion":"再Graphics.update。"},{"id":"UI67-F002-10","assertion":"input先Input.update。"},{"id":"UI67-F002-11","assertion":"BACK且abortable且未aborted时先abortedtrue再battle.pbAbort。"},{"id":"UI67-F002-12","assertion":"frame先cw.update。"},{"id":"UI67-F002-13","assertion":"再各非nilbattler的数据框/个体/影子update。"},{"id":"UI67-F002-14","assertion":"showWindow消息/命令/fight/target互斥。"},{"id":"UI67-F002-15","assertion":"BLANK全部false。"},{"id":"UI67-F002-16","assertion":"refreshEverything重建背景再重设个体/数据框。"},{"id":"UI67-F002-17","assertion":"swap同时交换精灵/影子/两个记忆槽。"},{"id":"UI67-F002-18","assertion":"再回写各index/position/databox.battler。"},{"id":"UI67-F002-19","assertion":"beginCommand清消息文字。"},{"id":"UI67-F002-20","assertion":"beginAttack取消选择并显示消息。"},{"id":"UI67-F002-21","assertion":"endRound为空定义。"},{"id":"UI67-F002-22","assertion":"endBattle先abortablefalse。"},{"id":"UI67-F002-23","assertion":"再BLANK。"},{"id":"UI67-F002-24","assertion":"BGMfade1秒。"},{"id":"UI67-F002-25","assertion":"再fade/disposeSprites。"},{"id":"UI67-F002-26","assertion":"本方法不disposeviewport，不能推全域生命周期。"},{"id":"UI67-F002-27","assertion":"resetCommands把当前位置两记忆归0。"},{"id":"UI67-F002-28","assertion":"胜野生battleEndtrue再victoryBGM。"},{"id":"UI67-F002-29","assertion":"胜trainer同true再按opponent选BGM。"}],"reader":"/root/ui_full","premise":"固定B8/R合法普通战斗对象与默认配置，无插件并发；源请求不证明媒体/宿主，后段失败保留前缀且无通用ensure。","disposition":"OWN_FULL_DEPENDENCY_READ; domain callers/receivers separately received","execution":"NOT_EXECUTED"}
