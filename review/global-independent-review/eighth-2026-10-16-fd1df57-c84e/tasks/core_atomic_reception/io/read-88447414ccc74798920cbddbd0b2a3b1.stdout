00223: 
00224:   def fullPattern
00225:     case self.direction
00226:     when 2 then return self.pattern
00227:     when 4 then return self.pattern + 4
00228:     when 6 then return self.pattern + 8
00229:     when 8 then return self.pattern + 12
00230:     end
00231:     return 0
00232:   end
00233: 
00234:   #=============================================================================
00235:   # Passability
00236:   #=============================================================================
00237:   def passable?(x, y, d, strict = false)
00238:     new_x = x + (d == 6 ? 1 : d == 4 ? -1 : 0)
00239:     new_y = y + (d == 2 ? 1 : d == 8 ? -1 : 0)
00240:     return false unless self.map.valid?(new_x, new_y)
