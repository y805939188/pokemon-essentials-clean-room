00653: class Battle::Move::StartSlowerBattlersActFirst < Battle::Move
00654:   def pbEffectGeneral(user)
00655:     if @battle.field.effects[PBEffects::TrickRoom] > 0
00656:       @battle.field.effects[PBEffects::TrickRoom] = 0
00657:       @battle.pbDisplay(_INTL("{1} reverted the dimensions!", user.pbThis))
00658:     else
00659:       @battle.field.effects[PBEffects::TrickRoom] = 5
00660:       @battle.pbDisplay(_INTL("{1} twisted the dimensions!", user.pbThis))
00661:     end
00662:   end
00663: 
00664:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
