00004: class Battle::AI::AIBattler
00005:   attr_reader :index, :side, :party_index
00006:   attr_reader :battler
00007: 
00008:   def initialize(ai, index)
00009:     @ai = ai
00010:     @index = index
00011:     @side = (@ai.battle.opposes?(@index)) ? 1 : 0
00012:     refresh_battler
00013:   end
00014: 
00015:   def refresh_battler
00016:     old_party_index = @party_index
00017:     @battler = @ai.battle.battlers[@index]
00018:     @party_index = battler.pokemonIndex
00019:   end
00020: 
00021:   def pokemon;     return battler.pokemon;     end
00022:   def level;       return battler.level;       end
00023:   def hp;          return battler.hp;          end
00024:   def totalhp;     return battler.totalhp;     end
00025:   def fainted?;    return battler.fainted?;    end
00026:   def status;      return battler.status;      end
00027:   def statusCount; return battler.statusCount; end
00028:   def gender;      return battler.gender;      end
00029:   def turnCount;   return battler.turnCount;   end
00030:   def effects;     return battler.effects;     end
00031:   def stages;      return battler.stages;      end
00032:   def statStageAtMax?(stat); return battler.statStageAtMax?(stat); end
00033:   def statStageAtMin?(stat); return battler.statStageAtMin?(stat); end
00034:   def moves;       return battler.moves;       end
00035: 
00036:   def wild?
00037:     return @ai.battle.wildBattle? && opposes?
00038:   end
00039: 
00040:   def name
00041:     return sprintf("%s (%d)", battler.name, @index)
00042:   end
00043: 
00044:   def opposes?(other = nil)
00045:     return @side == 1 if other.nil?
00046:     return other.side != @side
00047:   end
00048: 
00049:   def idxOwnSide;      return battler.idxOwnSide;      end
00050:   def pbOwnSide;       return battler.pbOwnSide;       end
00051:   def idxOpposingSide; return battler.idxOpposingSide; end
00052:   def pbOpposingSide;  return battler.pbOpposingSide;  end
00053: 
00054:   #-----------------------------------------------------------------------------
00055: 
00056:   # Returns how much damage this battler will take at the end of this round.
00057:   def rough_end_of_round_damage
00058:     ret = 0
00059:     # Weather
00060:     weather = battler.effectiveWeather
00061:     if @ai.battle.field.weatherDuration == 1
00062:       weather = @ai.battle.field.defaultWeather
00063:       weather = :None if @ai.battle.allBattlers.any? { |b| b.hasActiveAbility?([:CLOUDNINE, :AIRLOCK]) }
00064:       weather = :None if [:Sun, :Rain, :HarshSun, :HeavyRain].include?(weather) && has_active_item?(:UTILITYUMBRELLA)
00065:     end
00066:     case weather
00067:     when :Sandstorm
