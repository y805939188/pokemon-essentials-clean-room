00652: 
00653:   def pbEncoredMoveIndex
00654:     return -1 if @effects[PBEffects::Encore] == 0 || !@effects[PBEffects::EncoreMove]
00655:     ret = -1
00656:     eachMoveWithIndex do |m, i|
00657:       next if m.id != @effects[PBEffects::EncoreMove]
00658:       ret = i
00659:       break
00660:     end
00661:     return ret
00662:   end
00663: 
00664:   def initialItem
00665:     return @battle.initialItems[@index & 1][@pokemonIndex]
00666:   end
00667: 
00668:   def setInitialItem(value)
00669:     item_data = GameData::Item.try_get(value)
00670:     new_item = (item_data) ? item_data.id : nil
00671:     @battle.initialItems[@index & 1][@pokemonIndex] = new_item
00672:   end
00673: 
00674:   def recycleItem
00675:     return @battle.recycleItems[@index & 1][@pokemonIndex]
00676:   end
00677: 
00678:   def setRecycleItem(value)
00679:     item_data = GameData::Item.try_get(value)
00680:     new_item = (item_data) ? item_data.id : nil
00681:     @battle.recycleItems[@index & 1][@pokemonIndex] = new_item
00682:   end
00683: 
00684:   def belched?
00685:     return @battle.belch[@index & 1][@pokemonIndex]
00686:   end
00687: 
00688:   def setBelched
00689:     @battle.belch[@index & 1][@pokemonIndex] = true
00690:   end
