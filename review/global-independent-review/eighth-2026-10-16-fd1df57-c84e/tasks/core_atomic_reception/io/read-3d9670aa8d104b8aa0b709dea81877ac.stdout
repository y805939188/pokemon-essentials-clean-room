00692:   #=============================================================================
00693:   # Methods relating to this battler's position on the battlefield
00694:   #=============================================================================
00695:   # Returns whether the given position belongs to the opposing Pokémon's side.
00696:   def opposes?(i = 0)
00697:     i = i.index if i.respond_to?("index")
00698:     return (@index & 1) != (i & 1)
00699:   end
00700: 
00701:   # Returns whether the given position/battler is near to self.
00702:   def near?(i)
00703:     i = i.index if i.respond_to?("index")
00704:     return @battle.nearBattlers?(@index, i)
