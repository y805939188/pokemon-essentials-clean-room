00067:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00068:       end
00069:       return false
00070:     end
00071:     # Torment
00072:     if @effects[PBEffects::Torment] && !@effects[PBEffects::Instructed] && !specialUsage &&
00073:        @lastMoveUsed && move.id == @lastMoveUsed && move.id != @battle.struggle.id
00074:       if showMessages
00075:         msg = _INTL("{1} can't use the same move twice in a row due to the torment!", pbThis)
00076:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00077:       end
00078:       return false
00079:     end
00080:     # Imprison
