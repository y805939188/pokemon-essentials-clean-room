00001: class Battle
00002:   #=============================================================================
00003:   # Attack phase actions
00004:   #=============================================================================
00005:   # Quick Claw, Custap Berry's "X let it move first!" message.
00006:   def pbAttackPhasePriorityChangeMessages
00007:     pbPriority.each do |b|
00008:       if b.effects[PBEffects::PriorityAbility] && b.abilityActive?
00009:         Battle::AbilityEffects.triggerPriorityBracketUse(b.ability, b, self)
00010:       elsif b.effects[PBEffects::PriorityItem] && b.itemActive?
00011:         Battle::ItemEffects.triggerPriorityBracketUse(b.item, b, self)
00012:       end
00013:     end
00014:   end
00015: 
00016:   def pbAttackPhaseCall
00017:     pbPriority.each do |b|
00018:       next unless @choices[b.index][0] == :Call && !b.fainted?
00019:       b.lastMoveFailed = false   # Counts as a successful move for Stomping Tantrum
00020:       pbCall(b.index)
00021:     end
00022:   end
00023: 
00024:   def pbPursuit(idxSwitcher)
00025:     @switching = true
00026:     pbPriority.each do |b|
00027:       next if b.fainted? || !b.opposes?(idxSwitcher)   # Shouldn't hit an ally
00028:       next if b.movedThisRound? || !pbChoseMoveFunctionCode?(b.index, "PursueSwitchingFoe")
00029:       # Check whether Pursuit can be used
00030:       next unless pbMoveCanTarget?(b.index, idxSwitcher, @choices[b.index][2].pbTarget(b))
00031:       next unless pbCanChooseMove?(b.index, @choices[b.index][1], false)
00032:       next if b.status == :SLEEP || b.status == :FROZEN
00033:       next if b.effects[PBEffects::SkyDrop] >= 0
00034:       next if b.hasActiveAbility?(:TRUANT) && b.effects[PBEffects::Truant]
00035:       # Mega Evolve
00036:       if !b.wild?
00037:         owner = pbGetOwnerIndexFromBattlerIndex(b.index)
00038:         pbMegaEvolve(b.index) if @megaEvolution[b.idxOwnSide][owner] == b.index
00039:       end
00040:       # Use Pursuit
00041:       @choices[b.index][3] = idxSwitcher   # Change Pursuit's target
00042:       b.pbProcessTurn(@choices[b.index], false)
00043:       break if @decision > 0 || @battlers[idxSwitcher].fainted?
00044:     end
00045:     @switching = false
00046:   end
