00004: class PokemonSystem
00005:   attr_accessor :textspeed
00006:   attr_accessor :battlescene
00007:   attr_accessor :battlestyle
00008:   attr_accessor :sendtoboxes
00009:   attr_accessor :givenicknames
00010:   attr_accessor :frame
00011:   attr_accessor :textskin
00012:   attr_accessor :screensize
00013:   attr_accessor :language
00014:   attr_accessor :runstyle
00015:   attr_accessor :bgmvolume
00016:   attr_accessor :sevolume
00017:   attr_accessor :textinput
00018: 
00019:   def initialize
00020:     @textspeed     = 1     # Text speed (0=slow, 1=medium, 2=fast, 3=instant)
00021:     @battlescene   = 0     # Battle effects (animations) (0=on, 1=off)
00022:     @battlestyle   = 0     # Battle style (0=switch, 1=set)
00023:     @sendtoboxes   = 0     # Send to Boxes (0=manual, 1=automatic)
00024:     @givenicknames = 0     # Give nicknames (0=give, 1=don't give)
00025:     @frame         = 0     # Default window frame (see also Settings::MENU_WINDOWSKINS)
00026:     @textskin      = 0     # Speech frame
00027:     @screensize    = (Settings::SCREEN_SCALE * 2).floor - 1   # 0=half size, 1=full size, 2=full-and-a-half size, 3=double size
00028:     @language      = 0     # Language (see also Settings::LANGUAGES in script PokemonSystem)
00029:     @runstyle      = 0     # Default movement speed (0=walk, 1=run)
00030:     @bgmvolume     = 80    # Volume of background music and ME
00031:     @sevolume      = 100   # Volume of sound effects
00032:     @textinput     = 0     # Text input mode (0=cursor, 1=keyboard)
00033:   end
00034: end
00035: 
