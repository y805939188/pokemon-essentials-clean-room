00905:     return species_data.weight
00906:   end
00907: 
00908:   # @return [Hash<Integer>] the EV yield of this Pokémon (a hash with six key/value pairs)
00909:   def evYield
00910:     this_evs = species_data.evs
00911:     ret = {}
00912:     GameData::Stat.each_main { |s| ret[s.id] = this_evs[s.id] }
00913:     return ret
