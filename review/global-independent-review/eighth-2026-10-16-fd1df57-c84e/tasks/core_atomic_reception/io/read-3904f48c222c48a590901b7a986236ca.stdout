00320:       end
00321:       pbCancelMoves
00322:       pbEndTurn(choice)
00323:       return
00324:     end
00325:     # Primordial Sea, Desolate Land
00326:     if move.damagingMove?
00327:       case @battle.pbWeather
00328:       when :HeavyRain
00329:         if move.calcType == :FIRE
00330:           @battle.pbDisplay(_INTL("The Fire-type attack fizzled out in the heavy rain!"))
00331:           user.lastMoveFailed = true
00332:           pbCancelMoves
00333:           pbEndTurn(choice)
00334:           return
00335:         end
00336:       when :HarshSun
00337:         if move.calcType == :WATER
00338:           @battle.pbDisplay(_INTL("The Water-type attack evaporated in the harsh sunlight!"))
00339:           user.lastMoveFailed = true
00340:           pbCancelMoves
00341:           pbEndTurn(choice)
00342:           return
00343:         end
00344:       end
00345:     end
00346:     # Protean
00347:     if user.hasActiveAbility?([:LIBERO, :PROTEAN]) &&
00348:        !move.callsAnotherMove? && !move.snatched &&
00349:        user.pbHasOtherType?(move.calcType) && !GameData::Type.get(move.calcType).pseudo_type
00350:       @battle.pbShowAbilitySplash(user)
