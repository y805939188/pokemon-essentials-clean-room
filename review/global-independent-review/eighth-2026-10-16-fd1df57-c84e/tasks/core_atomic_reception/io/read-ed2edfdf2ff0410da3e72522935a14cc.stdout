00637: class Battle::Move::StartPerishCountsForAllBattlers < Battle::Move
00638:   def pbMoveFailed?(user, targets)
00639:     failed = true
00640:     targets.each do |b|
00641:       next if b.effects[PBEffects::PerishSong] > 0   # Heard it before
00642:       failed = false
00643:       break
00644:     end
00645:     if failed
00646:       @battle.pbDisplay(_INTL("But it failed!"))
00647:       return true
00648:     end
00649:     return false
00650:   end
00651: 
00652:   def pbFailsAgainstTarget?(user, target, show_message)
00653:     return target.effects[PBEffects::PerishSong] > 0   # Heard it before
00654:   end
00655: 
00656:   def pbEffectAgainstTarget(user, target)
00657:     target.effects[PBEffects::PerishSong]     = 4
00658:     target.effects[PBEffects::PerishSongUser] = user.index
00659:   end
00660: 
00661:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00662:     super
00663:     @battle.pbDisplay(_INTL("All Pokémon that hear the song will faint in three turns!"))
00664:   end
00665: end
00666: 
00667: #===============================================================================
00668: # If user is KO'd before it next moves, the battler that caused it also faints.
00669: # (Destiny Bond)
