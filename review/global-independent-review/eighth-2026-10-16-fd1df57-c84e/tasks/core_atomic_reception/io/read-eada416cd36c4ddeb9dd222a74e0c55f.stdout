00040:   def pbEndOfRoundPhase
00041:     __clauses__pbEndOfRoundPhase
00042:     if @rules["suddendeath"] && @decision == 0
00043:       p1able = pbAbleCount(0)
00044:       p2able = pbAbleCount(1)
00045:       if p1able > p2able
00046:         @decision = 1   # loss
00047:       elsif p1able < p2able
00048:         @decision = 2   # win
00049:       end
00050:     end
00051:   end
00052: end
00053: 
00054: #===============================================================================
00055: #
00056: #===============================================================================
00057: class Battle::Battler
00058:   unless @__clauses__aliased
00059:     alias __clauses__pbCanSleep? pbCanSleep?
00060:     alias __clauses__pbCanSleepYawn? pbCanSleepYawn?
00061:     alias __clauses__pbCanFreeze? pbCanFreeze?
00062:     alias __clauses__pbUseMove pbUseMove
00063:     @__clauses__aliased = true
00064:   end
00065: 
00066:   def pbCanSleep?(user, showMessages, move = nil, ignoreStatus = false)
00067:     selfsleep = (user && user.index == @index)
00068:     if ((@battle.rules["modifiedsleepclause"]) || (!selfsleep && @battle.rules["sleepclause"])) &&
00069:        pbHasStatusPokemon?(:SLEEP)
00070:       if showMessages
00071:         @battle.pbDisplay(_INTL("But {1} couldn't sleep!", pbThis(true)))
00072:       end
00073:       return false
00074:     end
00075:     return __clauses__pbCanSleep?(user, showMessages, move, ignoreStatus)
00076:   end
00077: 
00078:   def pbCanSleepYawn?
00079:     if (@battle.rules["sleepclause"] || @battle.rules["modifiedsleepclause"]) &&
00080:        pbHasStatusPokemon?(:SLEEP)
00081:       return false
00082:     end
00083:     return __clauses__pbCanSleepYawn?
00084:   end
00085: 
00086:   def pbCanFreeze?(*arg)
00087:     if @battle.rules["freezeclause"] && pbHasStatusPokemon?(:FROZEN)
00088:       return false
00089:     end
00090:     return __clauses__pbCanFreeze?(*arg)
00091:   end
00092: 
00093:   def pbHasStatusPokemon?(status)
00094:     count = 0
00095:     @battle.pbParty(@index).each do |pkmn|
00096:       next if !pkmn || pkmn.egg?
00097:       next if pkmn.status != status
00098:       count += 1
00099:     end
00100:     return count > 0
00101:   end
