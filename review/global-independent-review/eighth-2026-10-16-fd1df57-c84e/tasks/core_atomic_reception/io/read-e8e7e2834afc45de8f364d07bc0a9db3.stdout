00001: #===============================================================================
00002: # No additional effect.
00003: #===============================================================================
00004: class Battle::Move::None < Battle::Move
00005: end
00006: 
00007: #===============================================================================
00008: # Does absolutely nothing. Shows a special message. (Celebrate)
00009: #===============================================================================
00010: class Battle::Move::DoesNothingCongratulations < Battle::Move
00011:   def pbEffectGeneral(user)
00012:     if user.wild?
00013:       @battle.pbDisplay(_INTL("Congratulations from {1}!", user.pbThis(true)))
00014:     else
00015:       @battle.pbDisplay(_INTL("Congratulations, {1}!", @battle.pbGetOwnerName(user.index)))
00016:     end
00017:   end
00018: end
00019: 
00020: #===============================================================================
00021: # Does absolutely nothing. (Hold Hands)
00022: #===============================================================================
00023: class Battle::Move::DoesNothingFailsIfNoAlly < Battle::Move
00024:   def ignoresSubstitute?(user); return true; end
00025: 
00026:   def pbMoveFailed?(user, targets)
00027:     if user.allAllies.length == 0
00028:       @battle.pbDisplay(_INTL("But it failed!"))
00029:       return true
00030:     end
00031:     return false
00032:   end
00033: end
00034: 
00035: #===============================================================================
00036: # Does absolutely nothing. (Splash)
00037: #===============================================================================
00038: class Battle::Move::DoesNothingUnusableInGravity < Battle::Move
00039:   def unusableInGravity?; return true; end
00040: 
00041:   def pbEffectGeneral(user)
00042:     @battle.pbDisplay(_INTL("But nothing happened!"))
00043:   end
00044: end
00045: 
00046: #===============================================================================
00047: # Scatters coins that the player picks up after winning the battle. (Pay Day)
00048: # NOTE: In Gen 6+, if the user levels up after this move is used, the amount of
00049: #       money picked up depends on the user's new level rather than its level
00050: #       when it used the move. I think this is silly, so I haven't coded this
00051: #       effect.
00052: #===============================================================================
00053: class Battle::Move::AddMoneyGainedFromBattle < Battle::Move
00054:   def pbEffectGeneral(user)
00055:     if user.pbOwnedByPlayer?
00056:       @battle.field.effects[PBEffects::PayDay] += 5 * user.level
00057:     end
00058:     @battle.pbDisplay(_INTL("Coins were scattered everywhere!"))
00059:   end
00060: end
00061: 
00062: #===============================================================================
00063: # Doubles the prize money the player gets after winning the battle. (Happy Hour)
00064: #===============================================================================
00065: class Battle::Move::DoubleMoneyGainedFromBattle < Battle::Move
00066:   def pbEffectGeneral(user)
00067:     @battle.field.effects[PBEffects::HappyHour] = true if !user.opposes?
00068:     @battle.pbDisplay(_INTL("Everyone is caught up in the happy atmosphere!"))
00069:   end
00070: end
00071: 
00072: #===============================================================================
00073: # Fails if this isn't the user's first turn. (First Impression)
00074: #===============================================================================
00075: class Battle::Move::FailsIfNotUserFirstTurn < Battle::Move
00076:   def pbMoveFailed?(user, targets)
00077:     if user.turnCount > 1
00078:       @battle.pbDisplay(_INTL("But it failed!"))
00079:       return true
00080:     end
00081:     return false
00082:   end
00083: end
00084: 
00085: #===============================================================================
00086: # Fails unless user has already used all other moves it knows. (Last Resort)
00087: #===============================================================================
00088: class Battle::Move::FailsIfUserHasUnusedMove < Battle::Move
00089:   def pbFailsAgainstTarget?(user, target, show_message)
00090:     hasThisMove = false
00091:     hasOtherMoves = false
00092:     hasUnusedMoves = false
00093:     user.eachMove do |m|
00094:       hasThisMove    = true if m.id == @id
00095:       hasOtherMoves  = true if m.id != @id
00096:       hasUnusedMoves = true if m.id != @id && !user.movesUsed.include?(m.id)
00097:     end
00098:     if !hasThisMove || !hasOtherMoves || hasUnusedMoves
00099:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00100:       return true
00101:     end
00102:     return false
00103:   end
00104: end
00105: 
00106: #===============================================================================
00107: # Fails unless user has consumed a berry at some point. (Belch)
00108: #===============================================================================
00109: class Battle::Move::FailsIfUserNotConsumedBerry < Battle::Move
00110:   def pbCanChooseMove?(user, commandPhase, showMessages)
00111:     if !user.belched?
00112:       if showMessages
00113:         msg = _INTL("{1} hasn't eaten any held berry, so it can't possibly belch!", user.pbThis)
00114:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00115:       end
00116:       return false
00117:     end
00118:     return true
00119:   end
00120: 
00121:   def pbMoveFailed?(user, targets)
00122:     if !user.belched?
00123:       @battle.pbDisplay(_INTL("But it failed!"))
00124:       return true
00125:     end
00126:     return false
00127:   end
00128: end
00129: 
00130: #===============================================================================
00131: # Fails if the target is not holding an item, or if the target is affected by
00132: # Magic Room/Klutz. (Poltergeist)
00133: #===============================================================================
00134: class Battle::Move::FailsIfTargetHasNoItem < Battle::Move
00135:   def pbFailsAgainstTarget?(user, target, show_message)
00136:     if !target.item || !target.itemActive?
00137:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00138:       return true
00139:     end
00140:     @battle.pbDisplay(_INTL("{1} is about to be attacked by its {2}!", target.pbThis, target.itemName))
00141:     return false
00142:   end
00143: end
00144: 
00145: #===============================================================================
00146: # Only damages Pokémon that share a type with the user. (Synchronoise)
00147: #===============================================================================
00148: class Battle::Move::FailsUnlessTargetSharesTypeWithUser < Battle::Move
00149:   def pbFailsAgainstTarget?(user, target, show_message)
00150:     userTypes = user.pbTypes(true)
00151:     targetTypes = target.pbTypes(true)
00152:     sharesType = false
00153:     userTypes.each do |t|
00154:       next if !targetTypes.include?(t)
00155:       sharesType = true
00156:       break
00157:     end
00158:     if !sharesType
00159:       @battle.pbDisplay(_INTL("{1} is unaffected!", target.pbThis)) if show_message
00160:       return true
00161:     end
00162:     return false
00163:   end
00164: end
00165: 
00166: #===============================================================================
00167: # Fails if user was hit by a damaging move this round. (Focus Punch)
00168: #===============================================================================
00169: class Battle::Move::FailsIfUserDamagedThisTurn < Battle::Move
00170:   def pbDisplayChargeMessage(user)
00171:     user.effects[PBEffects::FocusPunch] = true
00172:     @battle.pbCommonAnimation("FocusPunch", user)
00173:     @battle.pbDisplay(_INTL("{1} is tightening its focus!", user.pbThis))
00174:   end
00175: 
00176:   def pbDisplayUseMessage(user)
00177:     super if !user.effects[PBEffects::FocusPunch] || !user.tookMoveDamageThisRound
00178:   end
00179: 
00180:   def pbMoveFailed?(user, targets)
00181:     if user.effects[PBEffects::FocusPunch] && user.tookMoveDamageThisRound
00182:       @battle.pbDisplay(_INTL("{1} lost its focus and couldn't move!", user.pbThis))
00183:       return true
00184:     end
00185:     return false
00186:   end
00187: end
00188: 
00189: #===============================================================================
00190: # Fails if the target didn't choose a damaging move to use this round, or has
00191: # already moved. (Sucker Punch)
00192: #===============================================================================
00193: class Battle::Move::FailsIfTargetActed < Battle::Move
00194:   def pbFailsAgainstTarget?(user, target, show_message)
00195:     if @battle.choices[target.index][0] != :UseMove
00196:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00197:       return true
00198:     end
00199:     oppMove = @battle.choices[target.index][2]
00200:     if !oppMove ||
00201:        (oppMove.function_code != "UseMoveTargetIsAboutToUse" &&
00202:        (target.movedThisRound? || oppMove.statusMove?))
00203:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00204:       return true
00205:     end
00206:     return false
00207:   end
00208: end
00209: 
00210: #===============================================================================
00211: # If attack misses, user takes crash damage of 1/2 of max HP.
00212: # (High Jump Kick, Jump Kick)
00213: #===============================================================================
00214: class Battle::Move::CrashDamageIfFailsUnusableInGravity < Battle::Move
00215:   def recoilMove?;        return true; end
00216:   def unusableInGravity?; return true; end
00217: 
00218:   def pbCrashDamage(user)
00219:     return if !user.takesIndirectDamage?
00220:     @battle.pbDisplay(_INTL("{1} kept going and crashed!", user.pbThis))
00221:     @battle.scene.pbDamageAnimation(user)
00222:     user.pbReduceHP(user.totalhp / 2, false)
00223:     user.pbItemHPHealCheck
00224:     user.pbFaint if user.fainted?
00225:   end
00226: end
