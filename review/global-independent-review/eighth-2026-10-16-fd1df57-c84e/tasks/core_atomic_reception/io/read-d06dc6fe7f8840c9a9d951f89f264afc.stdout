00815:   def turn_generic(dir)
00816:     return if @direction_fix
00817:     oldDirection = @direction
00818:     @direction = dir
00819:     @stop_count = 0
00820:     check_event_trigger_after_turning if dir != oldDirection
00821:   end
00822: 
00823:   def turn_down;  turn_generic(2); end
00824:   def turn_left;  turn_generic(4); end
00825:   def turn_right; turn_generic(6); end
00826:   def turn_up;    turn_generic(8); end
