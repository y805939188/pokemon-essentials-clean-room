00795:   def canSnatch?; return true; end
00796: 
00797:   def pbMoveFailed?(user, targets)
00798:     if user.effectiveWeather != :Hail
00799:       @battle.pbDisplay(_INTL("But it failed!"))
00800:       return true
00801:     end
00802:     if user.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
00803:       @battle.pbDisplay(_INTL("But it failed!"))
00804:       return true
00805:     end
00806:     return false
00807:   end
00808: 
00809:   def pbEffectGeneral(user)
00810:     user.pbOwnSide.effects[PBEffects::AuroraVeil] = 5
00811:     user.pbOwnSide.effects[PBEffects::AuroraVeil] = 8 if user.hasActiveItem?(:LIGHTCLAY)
00812:     @battle.pbDisplay(_INTL("{1} made {2} stronger against physical and special moves!",
00813:                             @name, user.pbTeam(true)))
00814:   end
00815: end
00816: 
00817: #===============================================================================
00818: # Ends the opposing side's Light Screen, Reflect and Aurora Break. (Brick Break,
00819: # Psychic Fangs)
00820: #===============================================================================
00821: class Battle::Move::RemoveScreens < Battle::Move
00822:   def ignoresReflect?; return true; end
00823: 
00824:   def pbEffectGeneral(user)
00825:     if user.pbOpposingSide.effects[PBEffects::LightScreen] > 0
00826:       user.pbOpposingSide.effects[PBEffects::LightScreen] = 0
00827:       @battle.pbDisplay(_INTL("{1}'s Light Screen wore off!", user.pbOpposingTeam))
00828:     end
00829:     if user.pbOpposingSide.effects[PBEffects::Reflect] > 0
00830:       user.pbOpposingSide.effects[PBEffects::Reflect] = 0
00831:       @battle.pbDisplay(_INTL("{1}'s Reflect wore off!", user.pbOpposingTeam))
00832:     end
00833:     if user.pbOpposingSide.effects[PBEffects::AuroraVeil] > 0
00834:       user.pbOpposingSide.effects[PBEffects::AuroraVeil] = 0
00835:       @battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", user.pbOpposingTeam))
00836:     end
00837:   end
00838: 
00839:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00840:     if user.pbOpposingSide.effects[PBEffects::AuroraVeil] > 0 ||
00841:        user.pbOpposingSide.effects[PBEffects::LightScreen] > 0 ||
00842:        user.pbOpposingSide.effects[PBEffects::Reflect] > 0
00843:       hitNum = 1   # Wall-breaking anim
00844:     end
00845:     super
00846:   end
00847: end
00848: 
