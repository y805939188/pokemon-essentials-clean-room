01921: class Battle::Move::StartUserSideDoubleSpeed < Battle::Move
01922:   def canSnatch?; return true; end
01923: 
01924:   def pbMoveFailed?(user, targets)
01925:     if user.pbOwnSide.effects[PBEffects::Tailwind] > 0
01926:       @battle.pbDisplay(_INTL("But it failed!"))
01927:       return true
01928:     end
01929:     return false
01930:   end
01931: 
01932:   def pbEffectGeneral(user)
01933:     user.pbOwnSide.effects[PBEffects::Tailwind] = 4
01934:     @battle.pbDisplay(_INTL("The Tailwind blew from behind {1}!", user.pbTeam(true)))
01935:   end
01936: end
01937: 
