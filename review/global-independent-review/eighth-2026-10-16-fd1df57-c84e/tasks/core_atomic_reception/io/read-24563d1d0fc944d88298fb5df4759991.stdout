00696: class Battle::Move::StartWeakenElectricMoves < Battle::Move
00697:   def pbMoveFailed?(user, targets)
00698:     if Settings::MECHANICS_GENERATION >= 6
00699:       if @battle.field.effects[PBEffects::MudSportField] > 0
00700:         @battle.pbDisplay(_INTL("But it failed!"))
00701:         return true
00702:       end
00703:     elsif @battle.allBattlers.any? { |b| b.effects[PBEffects::MudSport] }
00704:       @battle.pbDisplay(_INTL("But it failed!"))
00705:       return true
00706:     end
00707:     return false
00708:   end
00709: 
00710:   def pbEffectGeneral(user)
00711:     if Settings::MECHANICS_GENERATION >= 6
00712:       @battle.field.effects[PBEffects::MudSportField] = 5
00713:     else
00714:       user.effects[PBEffects::MudSport] = true
00715:     end
00716:     @battle.pbDisplay(_INTL("Electricity's power was weakened!"))
00717:   end
00718: end
00719: 
