00178: MultipleForms.register(:BURMY, {
00179:   "getFormOnCreation" => proc { |pkmn|
00180:     case pbGetEnvironment
00181:     when :Rock, :Sand, :Cave
00182:       next 1   # Sandy Cloak
00183:     when :None
00184:       next 2   # Trash Cloak
00185:     else
00186:       next 0   # Plant Cloak
00187:     end
00188:   },
00189:   "getFormOnLeavingBattle" => proc { |pkmn, battle, usedInBattle, endBattle|
00190:     next if !endBattle || !usedInBattle
00191:     case battle.environment
00192:     when :Rock, :Sand, :Cave
00193:       next 1   # Sandy Cloak
00194:     when :None
00195:       next 2   # Trash Cloak
00196:     else
00197:       next 0   # Plant Cloak
00198:     end
00199:   }
00200: })
