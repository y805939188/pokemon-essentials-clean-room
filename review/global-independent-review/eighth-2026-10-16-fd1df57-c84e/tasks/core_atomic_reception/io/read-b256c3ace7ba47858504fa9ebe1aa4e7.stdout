00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: class Battle::Peer
00005:   def pbStorePokemon(player, pkmn)
00006:     if !player.party_full?
00007:       player.party[player.party.length] = pkmn
00008:       return -1
00009:     end
00010:     if Settings::HEAL_STORED_POKEMON
00011:       old_ready_evo = pkmn.ready_to_evolve
00012:       pkmn.heal
00013:       pkmn.ready_to_evolve = old_ready_evo
00014:     end
00015:     oldCurBox = pbCurrentBox
00016:     storedBox = $PokemonStorage.pbStoreCaught(pkmn)
00017:     if storedBox < 0
00018:       # NOTE: Poké Balls can't be used if storage is full, so you shouldn't ever
00019:       #       see this message.
00020:       pbDisplayPaused(_INTL("Can't catch any more..."))
00021:       return oldCurBox
00022:     end
00023:     return storedBox
00024:   end
00025: 
00026:   def pbGetStorageCreatorName
00027:     return pbGetStorageCreator if $player.seen_storage_creator
00028:     return nil
00029:   end
00030: 
00031:   def pbCurrentBox
00032:     return $PokemonStorage.currentBox
00033:   end
00034: 
00035:   def pbBoxName(box)
00036:     return (box < 0) ? "" : $PokemonStorage[box].name
00037:   end
00038: 
00039:   def pbOnStartingBattle(battle, pkmn, wild = false)
00040:     f = MultipleForms.call("getFormOnStartingBattle", pkmn, wild)
00041:     pkmn.form = f if f
00042:     MultipleForms.call("changePokemonOnStartingBattle", pkmn, battle)
00043:   end
00044: 
00045:   def pbOnEnteringBattle(battle, battler, pkmn, wild = false)
00046:     f = MultipleForms.call("getFormOnEnteringBattle", pkmn, wild)
00047:     pkmn.form = f if f
00048:     battler.form = pkmn.form if battler.form != pkmn.form
00049:     MultipleForms.call("changePokemonOnEnteringBattle", battler, pkmn, battle)
00050:   end
00051: 
00052:   # For switching out, including due to fainting, and for the end of battle
00053:   def pbOnLeavingBattle(battle, pkmn, usedInBattle, endBattle = false)
00054:     return if !pkmn
00055:     f = MultipleForms.call("getFormOnLeavingBattle", pkmn, battle, usedInBattle, endBattle)
00056:     pkmn.form = f if f && pkmn.form != f
00057:     pkmn.hp = pkmn.totalhp if pkmn.hp > pkmn.totalhp
00058:     MultipleForms.call("changePokemonOnLeavingBattle", pkmn, battle, usedInBattle, endBattle)
00059:   end
00060: end
00061: 
00062: #===============================================================================
00063: # Unused class.
00064: #===============================================================================
00065: class Battle::NullPeer
00066:   def pbOnEnteringBattle(battle, battler, pkmn, wild = false); end
00067:   def pbOnLeavingBattle(battle, pkmn, usedInBattle, endBattle = false); end
00068: 
00069:   def pbStorePokemon(player, pkmn)
00070:     player.party[player.party.length] = pkmn if !player.party_full?
00071:     return -1
00072:   end
00073: 
00074:   def pbGetStorageCreatorName; return nil; end
00075:   def pbCurrentBox;            return -1;  end
00076:   def pbBoxName(box);          return "";  end
00077: end
