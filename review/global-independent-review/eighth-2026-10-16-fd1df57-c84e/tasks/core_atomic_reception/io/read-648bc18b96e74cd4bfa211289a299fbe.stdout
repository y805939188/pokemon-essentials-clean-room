01217: class Battle::Move::LowerTargetEvasion1RemoveSideEffects < Battle::Move::TargetStatDownMove
01218:   def ignoresSubstitute?(user); return true; end
01219: 
01220:   def initialize(battle, move)
01221:     super
01222:     @statDown = [:EVASION, 1]
01223:   end
01224: 
01225:   def pbFailsAgainstTarget?(user, target, show_message)
01226:     targetSide = target.pbOwnSide
01227:     targetOpposingSide = target.pbOpposingSide
01228:     return false if targetSide.effects[PBEffects::AuroraVeil] > 0 ||
01229:                     targetSide.effects[PBEffects::LightScreen] > 0 ||
01230:                     targetSide.effects[PBEffects::Reflect] > 0 ||
01231:                     targetSide.effects[PBEffects::Mist] > 0 ||
01232:                     targetSide.effects[PBEffects::Safeguard] > 0
01233:     return false if targetSide.effects[PBEffects::StealthRock] ||
01234:                     targetSide.effects[PBEffects::Spikes] > 0 ||
01235:                     targetSide.effects[PBEffects::ToxicSpikes] > 0 ||
01236:                     targetSide.effects[PBEffects::StickyWeb]
01237:     return false if Settings::MECHANICS_GENERATION >= 6 &&
01238:                     (targetOpposingSide.effects[PBEffects::StealthRock] ||
01239:                     targetOpposingSide.effects[PBEffects::Spikes] > 0 ||
01240:                     targetOpposingSide.effects[PBEffects::ToxicSpikes] > 0 ||
01241:                     targetOpposingSide.effects[PBEffects::StickyWeb])
01242:     return false if Settings::MECHANICS_GENERATION >= 8 && @battle.field.terrain != :None
01243:     return super
01244:   end
01245: 
01246:   def pbEffectAgainstTarget(user, target)
01247:     if target.pbCanLowerStatStage?(@statDown[0], user, self)
01248:       target.pbLowerStatStage(@statDown[0], @statDown[1], user)
01249:     end
01250:     if target.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
01251:       target.pbOwnSide.effects[PBEffects::AuroraVeil] = 0
01252:       @battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", target.pbTeam))
