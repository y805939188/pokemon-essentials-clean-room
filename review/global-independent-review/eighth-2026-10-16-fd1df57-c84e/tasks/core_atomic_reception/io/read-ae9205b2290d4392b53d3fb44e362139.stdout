00240: #===============================================================================
00241: # Self-Destruct
00242: #===============================================================================
00243: class Battle::Move::UserFaintsExplosive
00244:   unless method_defined?(:__clauses__pbMoveFailed?)
00245:     alias __clauses__pbMoveFailed? pbMoveFailed?
00246:   end
00247: 
00248:   def pbMoveFailed?(user, targets)
00249:     if @battle.rules["selfkoclause"]
00250:       # Check whether no unfainted Pokemon remain in either party
00251:       count = @battle.pbAbleNonActiveCount(user.idxOwnSide)
00252:       count += @battle.pbAbleNonActiveCount(user.idxOpposingSide)
00253:       if count == 0
00254:         @battle.pbDisplay("But it failed!")
00255:         return false
00256:       end
00257:     end
00258:     if @battle.rules["selfdestructclause"]
00259:       # Check whether no unfainted Pokemon remain in either party
00260:       count = @battle.pbAbleNonActiveCount(user.idxOwnSide)
00261:       count += @battle.pbAbleNonActiveCount(user.idxOpposingSide)
00262:       if count == 0
00263:         @battle.pbDisplay(_INTL("{1}'s team was disqualified!", user.pbThis))
00264:         @battle.decision = (user.opposes?) ? 1 : 2
00265:         return false
00266:       end
00267:     end
00268:     return __clauses__pbMoveFailed?(user, targets)
00269:   end
00270: end
00271: 
