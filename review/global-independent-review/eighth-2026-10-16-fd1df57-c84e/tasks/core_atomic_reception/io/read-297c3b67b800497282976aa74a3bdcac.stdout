00751: class Battle::Move::StartWeakenPhysicalDamageAgainstUserSide < Battle::Move
00752:   def canSnatch?; return true; end
00753: 
00754:   def pbMoveFailed?(user, targets)
00755:     if user.pbOwnSide.effects[PBEffects::Reflect] > 0
00756:       @battle.pbDisplay(_INTL("But it failed!"))
00757:       return true
00758:     end
00759:     return false
00760:   end
00761: 
00762:   def pbEffectGeneral(user)
00763:     user.pbOwnSide.effects[PBEffects::Reflect] = 5
00764:     user.pbOwnSide.effects[PBEffects::Reflect] = 8 if user.hasActiveItem?(:LIGHTCLAY)
00765:     @battle.pbDisplay(_INTL("{1} raised {2}'s Defense!", @name, user.pbTeam(true)))
00766:   end
00767: end
00768: 
00769: #===============================================================================
00770: # For 5 rounds, lowers power of special attacks against the user's side. (Light Screen)
00771: #===============================================================================
00772: class Battle::Move::StartWeakenSpecialDamageAgainstUserSide < Battle::Move
00773:   def canSnatch?; return true; end
00774: 
00775:   def pbMoveFailed?(user, targets)
00776:     if user.pbOwnSide.effects[PBEffects::LightScreen] > 0
00777:       @battle.pbDisplay(_INTL("But it failed!"))
00778:       return true
00779:     end
00780:     return false
00781:   end
00782: 
00783:   def pbEffectGeneral(user)
00784:     user.pbOwnSide.effects[PBEffects::LightScreen] = 5
00785:     user.pbOwnSide.effects[PBEffects::LightScreen] = 8 if user.hasActiveItem?(:LIGHTCLAY)
00786:     @battle.pbDisplay(_INTL("{1} raised {2}'s Special Defense!", @name, user.pbTeam(true)))
00787:   end
00788: end
00789: 
00790: #===============================================================================
00791: # For 5 rounds, lowers power of attacks against the user's side. Fails if
00792: # weather is not hail. (Aurora Veil)
00793: #===============================================================================
00794: class Battle::Move::StartWeakenDamageAgainstUserSideIfHail < Battle::Move
00795:   def canSnatch?; return true; end
00796: 
00797:   def pbMoveFailed?(user, targets)
00798:     if user.effectiveWeather != :Hail
00799:       @battle.pbDisplay(_INTL("But it failed!"))
00800:       return true
00801:     end
00802:     if user.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
00803:       @battle.pbDisplay(_INTL("But it failed!"))
00804:       return true
00805:     end
00806:     return false
00807:   end
00808: 
00809:   def pbEffectGeneral(user)
00810:     user.pbOwnSide.effects[PBEffects::AuroraVeil] = 5
00811:     user.pbOwnSide.effects[PBEffects::AuroraVeil] = 8 if user.hasActiveItem?(:LIGHTCLAY)
00812:     @battle.pbDisplay(_INTL("{1} made {2} stronger against physical and special moves!",
00813:                             @name, user.pbTeam(true)))
00814:   end
00815: end
00816: 
00817: #===============================================================================
00818: # Ends the opposing side's Light Screen, Reflect and Aurora Break. (Brick Break,
00819: # Psychic Fangs)
00820: #===============================================================================
00821: class Battle::Move::RemoveScreens < Battle::Move
00822:   def ignoresReflect?; return true; end
00823: 
00824:   def pbEffectGeneral(user)
00825:     if user.pbOpposingSide.effects[PBEffects::LightScreen] > 0
00826:       user.pbOpposingSide.effects[PBEffects::LightScreen] = 0
00827:       @battle.pbDisplay(_INTL("{1}'s Light Screen wore off!", user.pbOpposingTeam))
00828:     end
00829:     if user.pbOpposingSide.effects[PBEffects::Reflect] > 0
00830:       user.pbOpposingSide.effects[PBEffects::Reflect] = 0
00831:       @battle.pbDisplay(_INTL("{1}'s Reflect wore off!", user.pbOpposingTeam))
00832:     end
00833:     if user.pbOpposingSide.effects[PBEffects::AuroraVeil] > 0
00834:       user.pbOpposingSide.effects[PBEffects::AuroraVeil] = 0
00835:       @battle.pbDisplay(_INTL("{1}'s Aurora Veil wore off!", user.pbOpposingTeam))
00836:     end
00837:   end
00838: 
00839:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00840:     if user.pbOpposingSide.effects[PBEffects::AuroraVeil] > 0 ||
00841:        user.pbOpposingSide.effects[PBEffects::LightScreen] > 0 ||
00842:        user.pbOpposingSide.effects[PBEffects::Reflect] > 0
00843:       hitNum = 1   # Wall-breaking anim
00844:     end
00845:     super
00846:   end
00847: end
00848: 
00849: #===============================================================================
