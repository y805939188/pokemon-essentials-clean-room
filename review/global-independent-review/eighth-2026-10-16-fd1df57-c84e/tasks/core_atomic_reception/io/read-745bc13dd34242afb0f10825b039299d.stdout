00909: class Battle::Move::ProtectUserSideFromDamagingMovesIfUserFirstTurn < Battle::Move
00910:   def canSnatch?; return true; end
00911: 
00912:   def pbMoveFailed?(user, targets)
00913:     if user.turnCount > 1
00914:       @battle.pbDisplay(_INTL("But it failed!"))
00915:       return true
00916:     end
00917:     return true if pbMoveFailedLastInRound?(user)
00918:     return false
00919:   end
00920: 
00921:   def pbEffectGeneral(user)
00922:     user.pbOwnSide.effects[PBEffects::MatBlock] = true
00923:     @battle.pbDisplay(_INTL("{1} intends to flip up a mat and block incoming attacks!", user.pbThis))
00924:   end
00925: end
00926: 
00927: #===============================================================================
00928: # User's side is protected against status moves this round. (Crafty Shield)
00929: #===============================================================================
00930: class Battle::Move::ProtectUserSideFromStatusMoves < Battle::Move
00931:   def pbMoveFailed?(user, targets)
00932:     if user.pbOwnSide.effects[PBEffects::CraftyShield]
00933:       @battle.pbDisplay(_INTL("But it failed!"))
00934:       return true
00935:     end
00936:     return true if pbMoveFailedLastInRound?(user)
00937:     return false
00938:   end
00939: 
00940:   def pbEffectGeneral(user)
00941:     user.pbOwnSide.effects[PBEffects::CraftyShield] = true
00942:     @battle.pbDisplay(_INTL("Crafty Shield protected {1}!", user.pbTeam(true)))
00943:   end
00944: end
00945: 
00946: #===============================================================================
00947: # User's side is protected against moves with priority greater than 0 this round.
00948: # (Quick Guard)
00949: #===============================================================================
00950: class Battle::Move::ProtectUserSideFromPriorityMoves < Battle::Move::ProtectMove
00951:   def canSnatch?; return true; end
00952: 
00953:   def initialize(battle, move)
00954:     super
00955:     @effect      = PBEffects::QuickGuard
00956:     @sidedEffect = true
00957:   end
00958: end
00959: 
00960: #===============================================================================
00961: # User's side is protected against moves that target multiple battlers this round.
00962: # (Wide Guard)
00963: #===============================================================================
00964: class Battle::Move::ProtectUserSideFromMultiTargetDamagingMoves < Battle::Move::ProtectMove
00965:   def canSnatch?; return true; end
00966: 
00967:   def initialize(battle, move)
00968:     super
00969:     @effect      = PBEffects::WideGuard
00970:     @sidedEffect = true
00971:   end
00972: end
