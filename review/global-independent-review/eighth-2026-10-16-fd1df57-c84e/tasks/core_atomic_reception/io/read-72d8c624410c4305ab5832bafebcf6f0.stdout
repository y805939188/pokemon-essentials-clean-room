00422: EventHandlers.add(:on_start_battle, :record_party_heart_gauges,
00423:   proc {
00424:     $game_temp.party_heart_gauges_before_battle = []
00425:     $player.party.each_with_index do |pkmn, i|
00426:       $game_temp.party_heart_gauges_before_battle[i] = pkmn.heart_gauge
00427:     end
00428:   }
00429: )
00430: 
00431: EventHandlers.add(:on_end_battle, :check_ready_to_purify,
00432:   proc { |_decision, _canLose|
00433:     $game_temp.party_heart_gauges_before_battle.each_with_index do |value, i|
00434:       pkmn = $player.party[i]
00435:       next if !pkmn || !value || value == 0
00436:       pkmn.check_ready_to_purify if pkmn.heart_gauge == 0
00437:     end
00438:   }
00439: )
00440: 
00441: EventHandlers.add(:on_player_step_taken, :lower_heart_gauges,
00442:   proc {
00443:     $player.able_party.each do |pkmn|
00444:       next if pkmn.heart_gauge == 0
00445:       pkmn.heart_gauge_step_counter = 0 if !pkmn.heart_gauge_step_counter
00446:       pkmn.heart_gauge_step_counter += 1
00447:       next if pkmn.heart_gauge_step_counter < 256
00448:       old_stage = pkmn.heartStage
00449:       pkmn.change_heart_gauge("walking")
00450:       new_stage = pkmn.heartStage
00451:       if new_stage == 0
00452:         pkmn.check_ready_to_purify
00453:       elsif new_stage != old_stage
00454:         pkmn.update_shadow_moves
00455:       end
00456:       pkmn.heart_gauge_step_counter = 0
00457:     end
00458:     $PokemonGlobal.purifyChamber&.update
00459:   }
00460: )
