00143:     POKEMON = 2
00144:     RUN     = 3
00145:   end
00146: 
00147:   def initialize(scene, battle)
00148:     @battletype  = battle[0]
00149:     @properties  = battle[1]
00150:     @rounds      = battle[2]
00151:     @randomnums  = battle[3]
