00182:   def pbSwitchInBetween(_idxBattler, _checkLaxOnly = false, _canCancel = false)
00183:     ret = @switches[@switchindex]
00184:     @switchindex += 1
00185:     return ret
00186:   end
00187: 
00188:   def pbRandom(_num)
00189:     ret = @randomnums[@randomindex]
00190:     @randomindex += 1
00191:     return ret
00192:   end
