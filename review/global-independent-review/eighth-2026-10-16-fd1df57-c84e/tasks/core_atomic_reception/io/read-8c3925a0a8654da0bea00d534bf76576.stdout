00049:   CertainEscapeFromBattle         = ItemHandlerHash.new   # Smoke Ball
00050: 
00051:   #=============================================================================
00052: 
00053:   def self.trigger(hash, *args, ret: false)
00054:     new_ret = hash.trigger(*args)
00055:     return (!new_ret.nil?) ? new_ret : ret
00056:   end
00057: 
00058:   #=============================================================================
00059: 
00060:   def self.triggerSpeedCalc(item, battler, mult)
00061:     return trigger(SpeedCalc, item, battler, mult, ret: mult)
