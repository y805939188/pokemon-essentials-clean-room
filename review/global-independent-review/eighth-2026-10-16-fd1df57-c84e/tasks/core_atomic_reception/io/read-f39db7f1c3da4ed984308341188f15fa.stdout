00001: # NOTE: If adding a new target, you will need to add code in several places to
00002: #       make them work properly:
00003: #         - def pbFindTargets
00004: #         - def pbMoveCanTarget?
00005: #         - def pbCreateTargetTexts
00006: #         - def pbFirstTarget
00007: #         - def pbTargetsMultiple?
00008: module GameData
00009:   class Target
00010:     attr_reader :id
00011:     attr_reader :real_name
00012:     attr_reader :num_targets        # 0, 1 or 2 (meaning 2+)
00013:     attr_reader :targets_foe        # Is able to target one or more foes
00014:     attr_reader :targets_all        # Crafty Shield can't protect from these moves
00015:     attr_reader :affects_foe_side   # Pressure also affects these moves
00016:     attr_reader :long_range         # Hits non-adjacent targets
00017: 
00018:     DATA = {}
00019: 
00020:     extend ClassMethodsSymbols
00021:     include InstanceMethods
00022: 
00023:     def self.load; end
00024:     def self.save; end
00025: 
00026:     def initialize(hash)
00027:       @id               = hash[:id]
00028:       @real_name        = hash[:name]             || "Unnamed"
00029:       @num_targets      = hash[:num_targets]      || 0
00030:       @targets_foe      = hash[:targets_foe]      || false
00031:       @targets_all      = hash[:targets_all]      || false
00032:       @affects_foe_side = hash[:affects_foe_side] || false
00033:       @long_range       = hash[:long_range]       || false
00034:     end
00035: 
00036:     # @return [String] the translated name of this target
00037:     def name
00038:       return _INTL(@real_name)
00039:     end
00040: 
00041:     def can_choose_distant_target?
00042:       return @num_targets == 1 && @long_range
00043:     end
00044: 
00045:     def can_target_one_foe?
00046:       return @num_targets == 1 && @targets_foe
00047:     end
00048:   end
00049: end
00050: 
00051: #===============================================================================
00052: 
00053: # Bide, Counter, Metal Burst, Mirror Coat (calculate a target)
00054: GameData::Target.register({
00055:   :id               => :None,
00056:   :name             => _INTL("None")
00057: })
00058: 
00059: GameData::Target.register({
00060:   :id               => :User,
00061:   :name             => _INTL("User")
00062: })
00063: 
00064: # Aromatic Mist, Helping Hand, Hold Hands
00065: GameData::Target.register({
00066:   :id               => :NearAlly,
00067:   :name             => _INTL("Near Ally"),
00068:   :num_targets      => 1
00069: })
00070: 
00071: # Acupressure
00072: GameData::Target.register({
00073:   :id               => :UserOrNearAlly,
00074:   :name             => _INTL("User or Near Ally"),
00075:   :num_targets      => 1
00076: })
00077: 
00078: # Coaching
00079: GameData::Target.register({
00080:   :id               => :AllAllies,
00081:   :name             => _INTL("All Allies"),
00082:   :num_targets      => 2,
00083:   :targets_all      => true,
00084:   :long_range       => true
00085: })
00086: 
00087: # Aromatherapy, Gear Up, Heal Bell, Life Dew, Magnetic Flux, Howl (in Gen 8+)
00088: GameData::Target.register({
00089:   :id               => :UserAndAllies,
00090:   :name             => _INTL("User and Allies"),
00091:   :num_targets      => 2,
00092:   :long_range       => true
00093: })
00094: 
00095: # Me First
00096: GameData::Target.register({
00097:   :id               => :NearFoe,
00098:   :name             => _INTL("Near Foe"),
00099:   :num_targets      => 1,
00100:   :targets_foe      => true
00101: })
00102: 
00103: # Petal Dance, Outrage, Struggle, Thrash, Uproar
00104: GameData::Target.register({
00105:   :id               => :RandomNearFoe,
00106:   :name             => _INTL("Random Near Foe"),
00107:   :num_targets      => 1,
00108:   :targets_foe      => true
00109: })
00110: 
00111: GameData::Target.register({
00112:   :id               => :AllNearFoes,
00113:   :name             => _INTL("All Near Foes"),
00114:   :num_targets      => 2,
00115:   :targets_foe      => true
00116: })
00117: 
00118: # For throwing a Poké Ball
00119: GameData::Target.register({
00120:   :id               => :Foe,
00121:   :name             => _INTL("Foe"),
00122:   :num_targets      => 1,
00123:   :targets_foe      => true,
00124:   :long_range       => true
00125: })
00126: 
00127: # Unused
00128: GameData::Target.register({
00129:   :id               => :AllFoes,
00130:   :name             => _INTL("All Foes"),
00131:   :num_targets      => 2,
00132:   :targets_foe      => true,
00133:   :long_range       => true
00134: })
00135: 
00136: GameData::Target.register({
00137:   :id               => :NearOther,
00138:   :name             => _INTL("Near Other"),
00139:   :num_targets      => 1,
00140:   :targets_foe      => true
00141: })
00142: 
00143: GameData::Target.register({
00144:   :id               => :AllNearOthers,
00145:   :name             => _INTL("All Near Others"),
00146:   :num_targets      => 2,
00147:   :targets_foe      => true
00148: })
00149: 
00150: # Most Flying-type moves, pulse moves (hits non-near targets)
00151: GameData::Target.register({
00152:   :id               => :Other,
00153:   :name             => _INTL("Other"),
00154:   :num_targets      => 1,
00155:   :targets_foe      => true,
00156:   :long_range       => true
00157: })
00158: 
00159: # Flower Shield, Perish Song, Rototiller, Teatime
00160: GameData::Target.register({
00161:   :id               => :AllBattlers,
00162:   :name             => _INTL("All Battlers"),
00163:   :num_targets      => 2,
00164:   :targets_foe      => true,
00165:   :targets_all      => true,
00166:   :long_range       => true
00167: })
00168: 
00169: GameData::Target.register({
00170:   :id               => :UserSide,
00171:   :name             => _INTL("User Side")
00172: })
00173: 
00174: # Entry hazards
00175: GameData::Target.register({
00176:   :id               => :FoeSide,
00177:   :name             => _INTL("Foe Side"),
00178:   :affects_foe_side => true
00179: })
00180: 
00181: GameData::Target.register({
00182:   :id               => :BothSides,
00183:   :name             => _INTL("Both Sides"),
00184:   :affects_foe_side => true
00185: })
