00020: 
00021:   CRITICAL_HIT_RATIOS = (Settings::NEW_CRITICAL_HIT_RATE_MECHANICS) ? [24, 8, 2, 1] : [16, 8, 4, 3, 2]
00022: 
00023:   def to_int; return @id; end
00024: 
00025:   # @deprecated This method is slated to be removed in v22.
00026:   def baseDamage
00027:     Deprecation.warn_method("baseDamage", "v22", "power")
00028:     return @power
00029:   end
00030: 
00031:   #=============================================================================
00032:   # Creating a move
00033:   #=============================================================================
00034:   def initialize(battle, move)
00035:     @battle        = battle
00036:     @realMove      = move
00037:     @id            = move.id
00038:     @name          = move.name   # Get the move's name
00039:     # Get data on the move
00040:     @function_code = move.function_code
00041:     @power         = move.power
00042:     @type          = move.type
00043:     @category      = move.category
00044:     @accuracy      = move.accuracy
00045:     @pp            = move.pp   # Can be changed with Mimic/Transform
00046:     @target        = move.target
00047:     @priority      = move.priority
00048:     @flags         = move.flags.clone
00049:     @addlEffect    = move.effect_chance
00050:     @powerBoost    = false   # For Aerilate, Pixilate, Refrigerate, Galvanize
00051:     @snatched      = false
00052:   end
00053: 
00054:   # This is the code actually used to generate a Battle::Move object. The
00055:   # object generated is a subclass of this one which depends on the move's
00056:   # function code.
00057:   def self.from_pokemon_move(battle, move)
00058:     validate move => Pokemon::Move
00059:     code = move.function_code || "None"
00060:     if code[/^\d/]   # Begins with a digit
00061:       class_name = sprintf("Battle::Move::Effect%s", code)
00062:     else
00063:       class_name = sprintf("Battle::Move::%s", code)
00064:     end
00065:     if Object.const_defined?(class_name)
00066:       return Object.const_get(class_name).new(battle, move)
00067:     end
00068:     return Battle::Move::Unimplemented.new(battle, move)
00069:   end
00070: 
00071:   #=============================================================================
00072:   # About the move
00073:   #=============================================================================
00074:   def pbTarget(_user); return GameData::Target.get(@target); end
00075: 
00076:   def total_pp
00077:     return @total_pp if @total_pp && @total_pp > 0   # Usually undefined
00078:     return @realMove.total_pp if @realMove
00079:     return 0
00080:   end
00081: 
00082:   # NOTE: This method is only ever called while using a move (and also by the
00083:   #       AI), so using @calcType here is acceptable.
00084:   def physicalMove?(thisType = nil)
00085:     return (@category == 0) if Settings::MOVE_CATEGORY_PER_MOVE
00086:     thisType ||= @calcType
00087:     thisType ||= @type
00088:     return true if !thisType
00089:     return GameData::Type.get(thisType).physical?
00090:   end
00091: 
00092:   # NOTE: This method is only ever called while using a move (and also by the
00093:   #       AI), so using @calcType here is acceptable.
00094:   def specialMove?(thisType = nil)
00095:     return (@category == 1) if Settings::MOVE_CATEGORY_PER_MOVE
00096:     thisType ||= @calcType
00097:     thisType ||= @type
00098:     return false if !thisType
00099:     return GameData::Type.get(thisType).special?
00100:   end
00101: 
00102:   def damagingMove?; return @category != 2; end
00103:   def statusMove?;   return @category == 2; end
00104: 
00105:   def pbPriority(user); return @priority; end
00106: 
00107:   def usableWhenAsleep?;    return false; end
00108:   def unusableInGravity?;   return false; end
00109:   def healingMove?;         return false; end
00110:   def recoilMove?;          return false; end
00111:   def flinchingMove?;       return false; end
00112:   def callsAnotherMove?;    return false; end
00113:   # Whether the move can/will hit more than once in the same turn (including
00114:   # Beat Up which may instead hit just once). Not the same as pbNumHits>1.
00115:   def multiHitMove?;        return false; end
00116:   def chargingTurnMove?;    return false; end
00117:   def successCheckPerHit?;  return false; end
00118:   def hitsFlyingTargets?;   return false; end
00119:   def hitsDiggingTargets?;  return false; end
00120:   def hitsDivingTargets?;   return false; end
00121:   def ignoresReflect?;      return false; end   # For Brick Break
00122:   def targetsPosition?;     return false; end   # For Future Sight/Doom Desire
00123:   def cannotRedirect?;      return false; end   # For Snipe Shot
00124:   def worksWithNoTargets?;  return false; end   # For Explosion
00125:   def damageReducedByBurn?; return true;  end   # For Facade
00126:   def triggersHyperMode?;   return false; end
00127:   def canSnatch?;           return false; end
00128:   def canMagicCoat?;        return false; end
00129: 
00130:   def contactMove?;       return @flags.any? { |f| f[/^Contact$/i] };             end
00131:   def canProtectAgainst?; return @flags.any? { |f| f[/^CanProtect$/i] };          end
00132:   def canMirrorMove?;     return @flags.any? { |f| f[/^CanMirrorMove$/i] };       end
00133:   def thawsUser?;         return @flags.any? { |f| f[/^ThawsUser$/i] };           end
00134:   def highCriticalRate?;  return @flags.any? { |f| f[/^HighCriticalHitRate$/i] }; end
00135:   def bitingMove?;        return @flags.any? { |f| f[/^Biting$/i] };              end
00136:   def punchingMove?;      return @flags.any? { |f| f[/^Punching$/i] };            end
00137:   def soundMove?;         return @flags.any? { |f| f[/^Sound$/i] };               end
00138:   def powderMove?;        return @flags.any? { |f| f[/^Powder$/i] };              end
00139:   def pulseMove?;         return @flags.any? { |f| f[/^Pulse$/i] };               end
00140:   def bombMove?;          return @flags.any? { |f| f[/^Bomb$/i] };                end
00141:   def danceMove?;         return @flags.any? { |f| f[/^Dance$/i] };               end
00142:   # Causes perfect accuracy and double damage if target used Minimize. Perfect accuracy only with Gen 6+ mechanics.
00143:   def tramplesMinimize?;  return @flags.any? { |f| f[/^TramplesMinimize$/i] };    end
00144: 
00145:   def nonLethal?(_user, _target); return false; end   # For False Swipe
00146:   def preventsBattlerConsumingHealingBerry?(battler, targets); return false; end   # For Bug Bite/Pluck
00147: 
00148:   # user is the Pokémon using this move.
00149:   def ignoresSubstitute?(user)
00150:     if Settings::MECHANICS_GENERATION >= 6
00151:       return true if soundMove?
00152:       return true if user&.hasActiveAbility?(:INFILTRATOR)
00153:     end
00154:     return false
00155:   end
00156: 
00157:   def display_type(battler)
00158:     case @function_code
00159:     when "TypeDependsOnUserMorpekoFormRaiseUserSpeed1"
00160:       if battler.isSpecies?(:MORPEKO) || battler.effects[PBEffects::TransformSpecies] == :MORPEKO
00161:         return pbBaseType(battler)
00162:       end
00163: =begin
00164:     when "TypeDependsOnUserPlate", "TypeDependsOnUserMemory",
00165:          "TypeDependsOnUserDrive", "TypeAndPowerDependOnUserBerry",
00166:          "TypeIsUserFirstType", "TypeAndPowerDependOnWeather",
00167:          "TypeAndPowerDependOnTerrain"
00168:       return pbBaseType(battler)
00169: =end
00170:     end
00171:     return @realMove.display_type(battler.pokemon)
00172:   end
00173: 
00174:   def display_damage(battler)
00175: =begin
00176:     case @function_code
00177:     when "TypeAndPowerDependOnUserBerry"
00178:       return pbNaturalGiftBaseDamage(battler.item_id)
00179:     when "TypeAndPowerDependOnWeather", "TypeAndPowerDependOnTerrain",
00180:          "PowerHigherWithUserHP", "PowerLowerWithUserHP",
00181:          "PowerHigherWithUserHappiness", "PowerLowerWithUserHappiness",
00182:          "PowerHigherWithUserPositiveStatStages", "PowerDependsOnUserStockpile"
00183:       return pbBaseType(@power, battler, nil)
00184:     end
00185: =end
00186:     return @realMove.display_damage(battler.pokemon)
00187:   end
00188: 
00189:   def display_category(battler)
00190: =begin
00191:     case @function_code
00192:     when "CategoryDependsOnHigherDamageIgnoreTargetAbility"
00193:       pbOnStartUse(user, nil)
00194:       return @calcCategory
00195:     end
00196: =end
00197:     return @realMove.display_category(battler.pokemon)
00198:   end
00199: 
00200:   def display_accuracy(battler); return @realMove.display_accuracy(battler.pokemon); end
00201: end
