00398:     newPkmn = battle.pbGetReplacementPokemonIndex(battler.index)   # Owner chooses
00399:     next false if newPkmn < 0   # Shouldn't ever do this
00400:     battle.pbRecallAndReplace(battler.index, newPkmn)
00401:     battle.pbClearChoice(battler.index)   # Replacement Pokémon does nothing this round
00402:     battle.moldBreaker = false if move_user && battler.index == move_user.index
00403:     battle.pbOnBattlerEnteringBattle(battler.index)
00404:     next true
00405:   }
00406: )
00407: 
00408: Battle::AbilityEffects::OnHPDroppedBelowHalf.copy(:EMERGENCYEXIT, :WIMPOUT)
