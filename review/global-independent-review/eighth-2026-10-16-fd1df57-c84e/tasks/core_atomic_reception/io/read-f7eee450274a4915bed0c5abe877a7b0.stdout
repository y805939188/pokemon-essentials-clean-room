00358:          battler.pbThis, itemName))
00359:     end
00360:     next true
00361:   }
00362: )
00363: 
00364: Battle::ItemEffects::HPHeal.add(:ORANBERRY,
00365:   proc { |item, battler, battle, forced|
00366:     next false if !battler.canHeal?
00367:     next false if !forced && !battler.canConsumePinchBerry?(false)
00368:     amt = 10
00369:     ripening = false
00370:     if battler.hasActiveAbility?(:RIPEN)
00371:       battle.pbShowAbilitySplash(battler, forced)
00372:       amt *= 2
00373:       ripening = true
00374:     end
