00210: EventHandlers.add(:on_wild_pokemon_created, :poke_radar_shiny,
00211:   proc { |pkmn|
00212:     next if !$game_temp.poke_radar_data
00213:     grasses = $game_temp.poke_radar_data[3]
00214:     next if !grasses
00215:     grasses.each do |grass|
00216:       next if $game_player.x != grass[0] || $game_player.y != grass[1]
00217:       pkmn.shiny = true if grass[3] == 2
00218:       break
00219:     end
00220:   }
00221: )
00222: 
00223: EventHandlers.add(:on_wild_battle_end, :poke_radar_continue_chain,
00224:   proc { |species, level, decision|
00225:     if $game_temp.poke_radar_data && [1, 4].include?(decision)   # Defeated/caught
00226:       $game_temp.poke_radar_data[0] = species
00227:       $game_temp.poke_radar_data[1] = level
00228:       $game_temp.poke_radar_data[2] += 1
00229:       $stats.poke_radar_longest_chain = [$game_temp.poke_radar_data[2], $stats.poke_radar_longest_chain].max
00230:       # Catching makes the next Radar encounter more likely to continue the chain
00231:       $game_temp.poke_radar_data[4] = (decision == 4)
00232:       pbPokeRadarHighlightGrass(false)
00233:     else
00234:       pbPokeRadarCancel
00235:     end
00236:   }
00237: )
00238: 
00239: EventHandlers.add(:on_player_step_taken, :poke_radar,
00240:   proc {
00241:     if $PokemonGlobal.pokeradarBattery && $PokemonGlobal.pokeradarBattery > 0 &&
00242:        !$game_temp.poke_radar_data
00243:       $PokemonGlobal.pokeradarBattery -= 1
00244:     end
00245:     terrain = $game_map.terrain_tag($game_player.x, $game_player.y)
00246:     if !terrain.land_wild_encounters || !terrain.shows_grass_rustle
00247:       pbPokeRadarCancel
00248:     end
00249:   }
00250: )
00251: 
00252: EventHandlers.add(:on_enter_map, :cancel_poke_radar,
00253:   proc { |_old_map_id|
00254:     pbPokeRadarCancel
00255:   }
