00045:   def pbAbilitiesOnDamageTaken(move_user = nil)
00046:     return false if !@droppedBelowHalfHP
00047:     return false if !abilityActive?
00048:     return Battle::AbilityEffects.triggerOnHPDroppedBelowHalf(self.ability, self, move_user, @battle)
00049:   end
00050: 
00051:   def pbAbilityOnTerrainChange(ability_changed = false)
00052:     return if !abilityActive?
00053:     Battle::AbilityEffects.triggerOnTerrainChange(self.ability, self, @battle, ability_changed)
00054:   end
00055: 
00056:   # Used for Rattled's Gen 8 effect. Called when Intimidate is triggered.
00057:   def pbAbilitiesOnIntimidated
00058:     return if !abilityActive?
00059:     Battle::AbilityEffects.triggerOnIntimidated(self.ability, self, @battle)
00060:   end
00061: 
00062:   def pbAbilitiesOnNeutralizingGasEnding
00063:     return if @battle.pbCheckGlobalAbility(:NEUTRALIZINGGAS)
00064:     @battle.pbDisplay(_INTL("The effects of the neutralizing gas wore off!"))
00065:     @battle.pbEndPrimordialWeather
00066:     @battle.pbPriority(true).each do |b|
00067:       next if b.fainted?
00068:       next if !b.unstoppableAbility? && !b.abilityActive?
00069:       Battle::AbilityEffects.triggerOnSwitchIn(b.ability, b, @battle)
00070:     end
00071:   end
