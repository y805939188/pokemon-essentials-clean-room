00099:         "commit": "8c5911e4a4b07b07e832e4bb0d5d8859e88b4a9b",
00100:         "tree": "7589c800b61ba13a13040ed0d686979b80a84fd0",
00101:         "path": "Data/Scripts/018_Alternate battle modes/001_Battle Frontier/004_Challenge_Battles.rb",
00102:         "bytes": 5351,
00103:         "sha256": "27208b92f28d9430fcdffa08c2dfd483685ce1d76bf6e3413e7b8258786de182",
00104:         "blob": "7b2a9514fbfc6ca650cba2052a7c5e663a0cbcb9"
