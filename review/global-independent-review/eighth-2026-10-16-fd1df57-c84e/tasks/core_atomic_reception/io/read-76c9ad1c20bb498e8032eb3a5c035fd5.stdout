00408:   def pbWildBattleSuccess
00409:     @battleEnd = true
00410:     pbBGMPlay(pbGetWildVictoryBGM)
00411:   end
00412: 
00413:   # This method is called when the player wins a trainer battle.
00414:   # This method can change the battle's music for example.
00415:   def pbTrainerBattleSuccess
00416:     @battleEnd = true
00417:     pbBGMPlay(pbGetTrainerVictoryBGM(@battle.opponent))
00418:   end
00419: end
