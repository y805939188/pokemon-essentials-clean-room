00001: # Category has the following effects:
00002: #   - Determines the in-battle weather.
00003: #   - Some abilities reduce the encounter rate in certain categories of weather.
00004: #   - Some evolution methods check the current weather's category.
00005: #   - The :Rain category treats the last listed particle graphic as a water splash rather
00006: #     than a raindrop, which behaves differently.
00007: #   - :Rain auto-waters berry plants.
00008: # Delta values are per second.
00009: # For the tone_proc, strength goes from 0 to RPG::Weather::MAX_SPRITES (60) and
00010: # will typically be the maximum.
00011: module GameData
00012:   class Weather
00013:     attr_reader :id
00014:     attr_reader :id_number
00015:     attr_reader :real_name
00016:     attr_reader :category   # :None, :Rain, :Hail, :Sandstorm, :Sun, :Fog
00017:     attr_reader :graphics   # [[particle file names], [tile file names]]
00018:     attr_reader :particle_delta_x
00019:     attr_reader :particle_delta_y
00020:     attr_reader :particle_delta_opacity
00021:     attr_reader :tile_delta_x
00022:     attr_reader :tile_delta_y
00023:     attr_reader :tone_proc
00024: 
00025:     DATA = {}
00026: 
00027:     extend ClassMethods
00028:     include InstanceMethods
00029: 
00030:     def self.load; end
00031:     def self.save; end
00032: 
00033:     def initialize(hash)
00034:       @id                     = hash[:id]
00035:       @id_number              = hash[:id_number]
00036:       @real_name              = hash[:id].to_s                || "Unnamed"
00037:       @category               = hash[:category]               || :None
00038:       @particle_delta_x       = hash[:particle_delta_x]       || 0
00039:       @particle_delta_y       = hash[:particle_delta_y]       || 0
00040:       @particle_delta_opacity = hash[:particle_delta_opacity] || 0
00041:       @tile_delta_x           = hash[:tile_delta_x]           || 0
00042:       @tile_delta_y           = hash[:tile_delta_y]           || 0
00043:       @graphics               = hash[:graphics]               || []
00044:       @tone_proc              = hash[:tone_proc]
00045:     end
00046: 
00047:     alias name real_name
00048: 
00049:     def has_particles?
00050:       return @graphics[0] && @graphics[0].length > 0
00051:     end
00052: 
00053:     def has_tiles?
00054:       return @graphics[1] && @graphics[1].length > 0
00055:     end
00056: 
00057:     def tone(strength)
00058:       return (@tone_proc) ? @tone_proc.call(strength) : Tone.new(0, 0, 0, 0)
00059:     end
00060:   end
00061: end
00062: 
00063: #===============================================================================
00064: 
00065: GameData::Weather.register({
00066:   :id               => :None,
00067:   :id_number        => 0   # Must be 0 (preset RMXP weather)
00068: })
00069: 
00070: GameData::Weather.register({
00071:   :id               => :Rain,
00072:   :id_number        => 1,   # Must be 1 (preset RMXP weather)
00073:   :category         => :Rain,
00074:   :graphics         => [["rain_1", "rain_2", "rain_3", "rain_4"]],   # Last is splash
00075:   :particle_delta_x => -600,
00076:   :particle_delta_y => 2400,
00077:   :tone_proc        => proc { |strength|
00078:     next Tone.new(-strength / 2, -strength / 2, -strength / 2, 10)
00079:   }
00080: })
00081: 
00082: # NOTE: This randomly flashes the screen in RPG::Weather#update.
00083: GameData::Weather.register({
00084:   :id               => :Storm,
00085:   :id_number        => 2,   # Must be 2 (preset RMXP weather)
00086:   :category         => :Rain,
00087:   :graphics         => [["storm_1", "storm_2", "storm_3", "storm_4"]],   # Last is splash
00088:   :particle_delta_x => -3600,
00089:   :particle_delta_y => 3600,
00090:   :tone_proc        => proc { |strength|
00091:     next Tone.new(-strength * 3 / 4, -strength * 3 / 4, -strength * 3 / 4, 10)
00092:   }
00093: })
00094: 
00095: # NOTE: This alters the movement of snow particles in RPG::Weather#update_sprite_position.
00096: GameData::Weather.register({
00097:   :id               => :Snow,
00098:   :id_number        => 3,   # Must be 3 (preset RMXP weather)
00099:   :category         => :Hail,
00100:   :graphics         => [["hail_1", "hail_2", "hail_3"]],
00101:   :particle_delta_x => -240,
00102:   :particle_delta_y => 240,
00103:   :tone_proc        => proc { |strength|
00104:     next Tone.new(strength / 2, strength / 2, strength / 2, 0)
00105:   }
00106: })
00107: 
00108: GameData::Weather.register({
00109:   :id               => :Blizzard,
00110:   :id_number        => 4,
00111:   :category         => :Hail,
00112:   :graphics         => [["blizzard_1", "blizzard_2", "blizzard_3", "blizzard_4"], ["blizzard_tile"]],
00113:   :particle_delta_x => -720,
00114:   :particle_delta_y => 240,
00115:   :tile_delta_x     => -1200,
00116:   :tile_delta_y     => 600,
00117:   :tone_proc        => proc { |strength|
00118:     next Tone.new(strength * 3 / 4, strength * 3 / 4, strength * 3 / 4, 0)
00119:   }
00120: })
00121: 
00122: GameData::Weather.register({
00123:   :id               => :Sandstorm,
00124:   :id_number        => 5,
00125:   :category         => :Sandstorm,
00126:   :graphics         => [["sandstorm_1", "sandstorm_2", "sandstorm_3", "sandstorm_4"], ["sandstorm_tile"]],
00127:   :particle_delta_x => -1200,
00128:   :particle_delta_y => 640,
00129:   :tile_delta_x     => -800,
00130:   :tile_delta_y     => 400,
00131:   :tone_proc        => proc { |strength|
00132:     next Tone.new(strength / 2, 0, -strength / 2, 0)
00133:   }
00134: })
00135: 
00136: GameData::Weather.register({
00137:   :id               => :HeavyRain,
00138:   :id_number        => 6,
00139:   :category         => :Rain,
00140:   :graphics         => [["storm_1", "storm_2", "storm_3", "storm_4"]],   # Last is splash
