00608: EventHandlers.add(:on_end_battle, :evolve_and_black_out,
00609:   proc { |decision, canLose|
00610:     # Check for evolutions
00611:     pbEvolutionCheck if Settings::CHECK_EVOLUTION_AFTER_ALL_BATTLES ||
00612:                         (decision != 2 && decision != 5)   # not a loss or a draw
00613:     $game_temp.party_levels_before_battle = nil
00614:     $game_temp.party_critical_hits_dealt = nil
00615:     $game_temp.party_direct_damage_taken = nil
00616:     # Check for blacking out or gaining Pickup/Huney Gather items
00617:     case decision
00618:     when 1, 4   # Win, capture
00619:       $player.pokemon_party.each do |pkmn|
00620:         pbPickup(pkmn)
00621:         pbHoneyGather(pkmn)
00622:       end
00623:     when 2, 5   # Lose, draw
00624:       if !canLose
00625:         $game_system.bgm_unpause
00626:         $game_system.bgs_unpause
00627:         pbStartOver
00628:       end
00629:     end
00630:   }
00631: )
00632: 
00633: def pbEvolutionCheck
00634:   $player.party.each_with_index do |pkmn, i|
00635:     next if !pkmn || pkmn.egg?
00636:     next if pkmn.fainted? && !Settings::CHECK_EVOLUTION_FOR_FAINTED_POKEMON
00637:     # Find an evolution
00638:     new_species = nil
00639:     if new_species.nil? && $game_temp.party_levels_before_battle &&
00640:        $game_temp.party_levels_before_battle[i] &&
00641:        $game_temp.party_levels_before_battle[i] < pkmn.level
00642:       new_species = pkmn.check_evolution_on_level_up
00643:     end
00644:     new_species = pkmn.check_evolution_after_battle(i) if new_species.nil?
00645:     next if new_species.nil?
00646:     # Evolve Pokémon if possible
00647:     evo = PokemonEvolutionScene.new
00648:     evo.pbStartScreen(pkmn, new_species)
00649:     evo.pbEvolution
00650:     evo.pbEndScreen
00651:   end
00652: end
00653: 
