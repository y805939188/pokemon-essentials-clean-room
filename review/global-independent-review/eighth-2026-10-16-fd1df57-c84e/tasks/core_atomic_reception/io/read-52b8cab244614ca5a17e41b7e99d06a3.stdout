00147:   def initialize(scene, battle)
00148:     @battletype  = battle[0]
00149:     @properties  = battle[1]
00150:     @rounds      = battle[2]
00151:     @randomnums  = battle[3]
00152:     @switches    = battle[4]
00153:     @roundindex  = -1
00154:     @randomindex = 0
00155:     @switchindex = 0
00156:     super(scene,
00157:        Marshal.restore(@properties["party1"]),
00158:        Marshal.restore(@properties["party2"]),
00159:        RecordedBattle::PlaybackHelper.pbCreateTrainerInfo(@properties["player"]),
00160:        RecordedBattle::PlaybackHelper.pbCreateTrainerInfo(@properties["opponent"])
00161:     )
00162:   end
00163: 
00164:   def pbStartBattle
00165:     @party1starts          = Marshal.restore(@properties["party1starts"])
00166:     @party2starts          = Marshal.restore(@properties["party2starts"])
00167:     @internalBattle        = @properties["internalBattle"]
00168:     @field.weather         = @properties["weather"]
00169:     @field.weatherDuration = @properties["weatherDuration"]
00170:     @canRun                = @properties["canRun"]
00171:     @switchStyle           = @properties["switchStyle"]
00172:     @showAnims             = @properties["showAnims"]
00173:     @backdrop              = @properties["backdrop"]
00174:     @backdropBase          = @properties["backdropBase"]
00175:     @time                  = @properties["time"]
00176:     @environment           = @properties["environment"]
00177:     @items                 = Marshal.restore(@properties["items"])
00178:     @rules                 = Marshal.restore(@properties["rules"])
00179:     super
00180:   end
00181: 
00182:   def pbSwitchInBetween(_idxBattler, _checkLaxOnly = false, _canCancel = false)
00183:     ret = @switches[@switchindex]
00184:     @switchindex += 1
00185:     return ret
00186:   end
00187: 
00188:   def pbRandom(_num)
00189:     ret = @randomnums[@randomindex]
00190:     @randomindex += 1
00191:     return ret
00192:   end
00193: 
00194:   def pbDisplayPaused(str)
00195:     pbDisplay(str)
00196:   end
00197: 
00198:   def pbCommandPhaseLoop(isPlayer)
00199:     return if !isPlayer
00200:     @roundindex += 1
00201:     4.times do |i|
00202:       next if @rounds[@roundindex][i].length == 0
00203:       pbClearChoice(i)
00204:       case @rounds[@roundindex][i][0]
00205:       when Commands::FIGHT
00206:         if @rounds[@roundindex][i][1] == -1
00207:           pbAutoChooseMove(i, false)
00208:         else
00209:           pbRegisterMove(i, @rounds[@roundindex][i][1])
00210:         end
00211:         if @rounds[@roundindex][i][2]
00212:           pbRegisterTarget(i, @rounds[@roundindex][i][2])
00213:         end
00214:       when Commands::BAG
00215:         pbRegisterItem(i, @rounds[@roundindex][i][1], @rounds[@roundindex][i][2], @rounds[@roundindex][i][3])
00216:       when Commands::POKEMON
00217:         pbRegisterSwitch(i, @rounds[@roundindex][i][1])
00218:       when Commands::RUN
00219:         @decision = @rounds[@roundindex][i][1]
00220:       end
00221:     end
00222:   end
