02700:     battle.allOtherSideBattlers(battler.index).each do |b|
02701:       oDef   += b.defense
02702:       oSpDef += b.spdef
02703:     end
02704:     stat = (oDef < oSpDef) ? :ATTACK : :SPECIAL_ATTACK
02705:     battler.pbRaiseStatStageByAbility(stat, 1, battler)
02706:   }
02707: )
02708: 
02709: Battle::AbilityEffects::OnSwitchIn.add(:DRIZZLE,
02710:   proc { |ability, battler, battle, switch_in|
02711:     battle.pbStartWeatherAbility(:Rain, battler)
02712:   }
02713: )
02714: 
02715: Battle::AbilityEffects::OnSwitchIn.add(:DROUGHT,
02716:   proc { |ability, battler, battle, switch_in|
02717:     battle.pbStartWeatherAbility(:Sun, battler)
02718:   }
02719: )
02720: 
02721: Battle::AbilityEffects::OnSwitchIn.add(:ELECTRICSURGE,
02722:   proc { |ability, battler, battle, switch_in|
02723:     next if battle.field.terrain == :Electric
02724:     battle.pbShowAbilitySplash(battler)
02725:     battle.pbStartTerrain(battler, :Electric)
02726:     # NOTE: The ability splash is hidden again in def pbStartTerrain.
