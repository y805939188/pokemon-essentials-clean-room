00320:   def pbEOREndBattlerEffects(priority)
00321:     # Taunt
00322:     pbEORCountDownBattlerEffect(priority, PBEffects::Taunt) do |battler|
00323:       pbDisplay(_INTL("{1}'s taunt wore off!", battler.pbThis))
00324:     end
00325:     # Encore
00326:     priority.each do |battler|
00327:       next if battler.fainted? || battler.effects[PBEffects::Encore] == 0
00328:       idxEncoreMove = battler.pbEncoredMoveIndex
00329:       if idxEncoreMove >= 0
00330:         battler.effects[PBEffects::Encore] -= 1
00331:         if battler.effects[PBEffects::Encore] == 0 || battler.moves[idxEncoreMove].pp == 0
00332:           battler.effects[PBEffects::Encore] = 0
00333:           pbDisplay(_INTL("{1}'s encore ended!", battler.pbThis))
00334:         end
00335:       else
00336:         PBDebug.log("[End of effect] #{battler.pbThis}'s encore ended (encored move no longer known)")
00337:         battler.effects[PBEffects::Encore]     = 0
00338:         battler.effects[PBEffects::EncoreMove] = nil
00339:       end
00340:     end
00341:     # Disable/Cursed Body
00342:     pbEORCountDownBattlerEffect(priority, PBEffects::Disable) do |battler|
00343:       battler.effects[PBEffects::DisableMove] = nil
00344:       pbDisplay(_INTL("{1} is no longer disabled!", battler.pbThis))
00345:     end
00346:     # Magnet Rise
00347:     pbEORCountDownBattlerEffect(priority, PBEffects::MagnetRise) do |battler|
00348:       pbDisplay(_INTL("{1}'s electromagnetism wore off!", battler.pbThis))
00349:     end
00350:     # Telekinesis
00351:     pbEORCountDownBattlerEffect(priority, PBEffects::Telekinesis) do |battler|
00352:       pbDisplay(_INTL("{1} was freed from the telekinesis!", battler.pbThis))
00353:     end
00354:     # Heal Block
00355:     pbEORCountDownBattlerEffect(priority, PBEffects::HealBlock) do |battler|
00356:       pbDisplay(_INTL("{1}'s Heal Block wore off!", battler.pbThis))
00357:     end
00358:     # Embargo
00359:     pbEORCountDownBattlerEffect(priority, PBEffects::Embargo) do |battler|
00360:       pbDisplay(_INTL("{1} can use items again!", battler.pbThis))
00361:       battler.pbItemTerrainStatBoostCheck
00362:     end
00363:     # Yawn
00364:     pbEORCountDownBattlerEffect(priority, PBEffects::Yawn) do |battler|
00365:       if battler.pbCanSleepYawn?
00366:         PBDebug.log("[Lingering effect] #{battler.pbThis} fell asleep because of Yawn")
00367:         battler.pbSleep
00368:       end
00369:     end
00370:     # Perish Song
00371:     perishSongUsers = []
00372:     priority.each do |battler|
00373:       next if battler.fainted? || battler.effects[PBEffects::PerishSong] == 0
00374:       battler.effects[PBEffects::PerishSong] -= 1
00375:       pbDisplay(_INTL("{1}'s perish count fell to {2}!", battler.pbThis, battler.effects[PBEffects::PerishSong]))
00376:       if battler.effects[PBEffects::PerishSong] == 0
00377:         perishSongUsers.push(battler.effects[PBEffects::PerishSongUser])
00378:         battler.pbReduceHP(battler.hp)
00379:       end
00380:       battler.pbItemHPHealCheck
00381:       battler.pbFaint if battler.fainted?
00382:     end
00383:     # Judge if all remaining Pokemon fainted by a Perish Song triggered by a single side
00384:     if perishSongUsers.length > 0 &&
00385:        ((perishSongUsers.find_all { |idxBattler| opposes?(idxBattler) }.length == perishSongUsers.length) ||
00386:        (perishSongUsers.find_all { |idxBattler| !opposes?(idxBattler) }.length == perishSongUsers.length))
00387:       pbJudgeCheckpoint(@battlers[perishSongUsers[0]])
00388:     end
00389:     return if @decision > 0
00390:   end
00391: 
00392:   #=============================================================================
00393:   # End Of Round end effects that apply to one side of the field
00394:   #=============================================================================
00395:   def pbEORCountDownSideEffect(side, effect, msg)
00396:     return if @sides[side].effects[effect] <= 0
00397:     @sides[side].effects[effect] -= 1
00398:     pbDisplay(msg) if @sides[side].effects[effect] == 0
00399:   end
00400: 
00401:   def pbEOREndSideEffects(side, priority)
00402:     # Reflect
00403:     pbEORCountDownSideEffect(side, PBEffects::Reflect,
00404:                              _INTL("{1}'s Reflect wore off!", @battlers[side].pbTeam))
00405:     # Light Screen
00406:     pbEORCountDownSideEffect(side, PBEffects::LightScreen,
00407:                              _INTL("{1}'s Light Screen wore off!", @battlers[side].pbTeam))
00408:     # Safeguard
00409:     pbEORCountDownSideEffect(side, PBEffects::Safeguard,
00410:                              _INTL("{1} is no longer protected by Safeguard!", @battlers[side].pbTeam))
00411:     # Mist
00412:     pbEORCountDownSideEffect(side, PBEffects::Mist,
00413:                              _INTL("{1} is no longer protected by mist!", @battlers[side].pbTeam))
00414:     # Tailwind
00415:     pbEORCountDownSideEffect(side, PBEffects::Tailwind,
00416:                              _INTL("{1}'s Tailwind petered out!", @battlers[side].pbTeam))
00417:     # Lucky Chant
00418:     pbEORCountDownSideEffect(side, PBEffects::LuckyChant,
00419:                              _INTL("{1}'s Lucky Chant wore off!", @battlers[side].pbTeam))
00420:     # Pledge Rainbow
00421:     pbEORCountDownSideEffect(side, PBEffects::Rainbow,
00422:                              _INTL("The rainbow on {1}'s side disappeared!", @battlers[side].pbTeam(true)))
00423:     # Pledge Sea of Fire
00424:     pbEORCountDownSideEffect(side, PBEffects::SeaOfFire,
00425:                              _INTL("The sea of fire around {1} disappeared!", @battlers[side].pbTeam(true)))
00426:     # Pledge Swamp
00427:     pbEORCountDownSideEffect(side, PBEffects::Swamp,
00428:                              _INTL("The swamp around {1} disappeared!", @battlers[side].pbTeam(true)))
00429:     # Aurora Veil
00430:     pbEORCountDownSideEffect(side, PBEffects::AuroraVeil,
00431:                              _INTL("{1}'s Aurora Veil wore off!", @battlers[side].pbTeam))
