00001: #===============================================================================
00002: # ** Game_Temp
00003: #-------------------------------------------------------------------------------
00004: #  This class handles temporary data that is not included with save data.
00005: #  Refer to "$game_temp" for the instance of this class.
00006: #===============================================================================
00007: class Game_Temp
00008:   # Flags requesting something to happen
00009:   attr_accessor :menu_calling             # menu calling flag
00010:   attr_accessor :ready_menu_calling       # ready menu calling flag
00011:   attr_accessor :debug_calling            # debug calling flag
00012:   attr_accessor :interact_calling         # EventHandlers.trigger(:on_player_interact) flag
00013:   attr_accessor :battle_abort             # battle flag: interrupt (unused)
00014:   attr_accessor :title_screen_calling     # return to title screen flag
00015:   attr_accessor :common_event_id          # common event ID to start
00016:   # Flags indicating something is happening
00017:   attr_accessor :in_menu                  # menu is open
00018:   attr_accessor :in_storage               # in-Pokémon storage flag
00019:   attr_accessor :in_battle                # in-battle flag
00020:   attr_accessor :message_window_showing   # message window showing
00021:   attr_accessor :ending_surf              # jumping off surf base flag
00022:   attr_accessor :surf_base_coords         # [x, y] while jumping on/off, or nil
00023:   attr_accessor :in_mini_update           # performing mini update flag
00024:   # Battle
00025:   attr_accessor :battleback_name          # battleback file name
00026:   attr_accessor :force_single_battle      # force next battle to be 1v1 flag
00027:   attr_accessor :waiting_trainer          # [trainer, event ID] or nil
00028:   attr_accessor :last_battle_record       # record of actions in last recorded battle
00029:   # Player transfers
00030:   attr_accessor :player_transferring      # player place movement flag
00031:   attr_accessor :player_new_map_id        # player destination: map ID
00032:   attr_accessor :player_new_x             # player destination: x-coordinate
00033:   attr_accessor :player_new_y             # player destination: y-coordinate
00034:   attr_accessor :player_new_direction     # player destination: direction
00035:   attr_accessor :fly_destination          # [map ID, x, y] or nil
00036:   # Transitions
00037:   attr_accessor :transition_processing    # transition processing flag
00038:   attr_accessor :transition_name          # transition file name
00039:   attr_accessor :background_bitmap
00040:   attr_accessor :fadestate                # for sprite hashes
00041:   # Other
00042:   attr_accessor :begun_new_game           # new game flag (true fron new game until saving)
00043:   attr_accessor :menu_beep                # menu: play sound effect flag
00044:   attr_accessor :menu_last_choice         # pause menu: index of last selection
00045:   attr_accessor :memorized_bgm            # set when trainer intro BGM is played
00046:   attr_accessor :memorized_bgm_position   # set when trainer intro BGM is played
00047:   attr_accessor :darkness_sprite          # DarknessSprite or nil
00048:   attr_accessor :mart_prices
00049: 
00050:   #-----------------------------------------------------------------------------
00051:   # * Object Initialization
00052:   #-----------------------------------------------------------------------------
00053:   def initialize
00054:     # Flags requesting something to happen
00055:     @menu_calling           = false
00056:     @ready_menu_calling     = false
00057:     @debug_calling          = false
00058:     @interact_calling       = false
00059:     @battle_abort           = false
00060:     @title_screen_calling   = false
