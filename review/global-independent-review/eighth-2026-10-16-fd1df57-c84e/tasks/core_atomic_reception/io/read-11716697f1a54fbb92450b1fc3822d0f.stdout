00430:         multipliers[:final_damage_multiplier] *= 2
00431:       end
00432:     end
00433:     # Random variance
00434:     if !self.is_a?(Battle::Move::Confusion)
00435:       random = 85 + @battle.pbRandom(16)
00436:       multipliers[:final_damage_multiplier] *= random / 100.0
00437:     end
00438:     # STAB
00439:     if type && user.pbHasType?(type)
00440:       if user.hasActiveAbility?(:ADAPTABILITY)
00441:         multipliers[:final_damage_multiplier] *= 2
00442:       else
00443:         multipliers[:final_damage_multiplier] *= 1.5
00444:       end
00445:     end
00446:     # Type effectiveness
00447:     multipliers[:final_damage_multiplier] *= target.damageState.typeMod
00448:     # Burn
00449:     if user.status == :BURN && physicalMove? && damageReducedByBurn? &&
00450:        !user.hasActiveAbility?(:GUTS)
00451:       multipliers[:final_damage_multiplier] /= 2
00452:     end
00453:     # Aurora Veil, Reflect, Light Screen
00454:     if !ignoresReflect? && !target.damageState.critical &&
00455:        !user.hasActiveAbility?(:INFILTRATOR)
00456:       if target.pbOwnSide.effects[PBEffects::AuroraVeil] > 0
00457:         if @battle.pbSideBattlerCount(target) > 1
00458:           multipliers[:final_damage_multiplier] *= 2 / 3.0
00459:         else
00460:           multipliers[:final_damage_multiplier] /= 2
