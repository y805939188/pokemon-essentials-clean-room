00602:   def pbSwapBattlers(idxA, idxB)
00603:     return false if !@battlers[idxA] || !@battlers[idxB]
00604:     # Can't swap if battlers aren't owned by the same trainer
00605:     return false if opposes?(idxA, idxB)
00606:     return false if pbGetOwnerIndexFromBattlerIndex(idxA) != pbGetOwnerIndexFromBattlerIndex(idxB)
00607:     @battlers[idxA],       @battlers[idxB]       = @battlers[idxB],       @battlers[idxA]
00608:     @battlers[idxA].index, @battlers[idxB].index = @battlers[idxB].index, @battlers[idxA].index
00609:     @choices[idxA],        @choices[idxB]        = @choices[idxB],        @choices[idxA]
00610:     @scene.pbSwapBattlerSprites(idxA, idxB)
00611:     # Swap the target of any battlers' effects that point at either of the
00612:     # swapped battlers, to ensure they still point at the correct target
00613:     # NOTE: LeechSeed is not swapped, because drained HP goes to whichever
00614:     #       Pokémon is in the position that Leech Seed was used from.
00615:     # NOTE: PerishSongUser doesn't need to change, as it's only used to
00616:     #       determine which side the Perish Song user was on, and a battler
00617:     #       can't change sides.
00618:     effectsToSwap = [PBEffects::Attract,
00619:                      PBEffects::BideTarget,
00620:                      PBEffects::CounterTarget,
00621:                      PBEffects::JawLock,
00622:                      PBEffects::LockOnPos,
00623:                      PBEffects::MeanLook,
00624:                      PBEffects::MirrorCoatTarget,
00625:                      PBEffects::Octolock,
00626:                      PBEffects::SkyDrop,
00627:                      PBEffects::TrappingUser]
00628:     allBattlers.each do |b|
00629:       effectsToSwap.each do |i|
00630:         next if b.effects[i] != idxA && b.effects[i] != idxB
00631:         b.effects[i] = (b.effects[i] == idxA) ? idxB : idxA
00632:       end
00633:     end
00634:     return true
00635:   end
00636: 
00637:   #=============================================================================
00638:   #
00639:   #=============================================================================
00640:   # Returns the battler representing the Pokémon at index idxParty in its party,
00641:   # on the same side as a battler with battler index of idxBattlerOther.
00642:   def pbFindBattler(idxParty, idxBattlerOther = 0)
00643:     allSameSideBattlers(idxBattlerOther).each { |b| return b if b.pokemonIndex == idxParty }
00644:     return nil
00645:   end
00646: 
00647:   # Only used for Wish, as the Wishing Pokémon will no longer be in battle.
