00156:   def pbChangeForm(newForm, msg)
00157:     return if fainted? || @effects[PBEffects::Transform] || @form == newForm
00158:     oldForm = @form
00159:     oldDmg = @totalhp - @hp
00160:     self.form = newForm
00161:     pbUpdate(true)
00162:     @hp = @totalhp - oldDmg
00163:     @effects[PBEffects::WeightChange] = 0 if Settings::MECHANICS_GENERATION >= 6
00164:     @battle.scene.pbChangePokemon(self, @pokemon)
00165:     @battle.scene.pbRefreshOne(@index)
00166:     @battle.pbDisplay(msg) if msg && msg != ""
00167:     PBDebug.log("[Form changed] #{pbThis} changed from form #{oldForm} to form #{newForm}")
00168:     @battle.pbSetSeen(self)
00169:   end
00170: 
00171:   def pbCheckFormOnStatusChange
00172:     return if fainted? || @effects[PBEffects::Transform]
00173:     # Shaymin - reverts if frozen
00174:     if isSpecies?(:SHAYMIN) && frozen?
00175:       pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00176:     end
00177:   end
00178: 
00179:   def pbCheckFormOnMovesetChange
00180:     return if fainted? || @effects[PBEffects::Transform]
00181:     # Keldeo - knowing Secret Sword
00182:     if isSpecies?(:KELDEO)
00183:       newForm = 0
00184:       newForm = 1 if pbHasMove?(:SECRETSWORD)
00185:       pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00186:     end
00187:   end
00188: 
00189:   def pbCheckFormOnWeatherChange(ability_changed = false)
00190:     return if fainted? || @effects[PBEffects::Transform]
00191:     # Castform - Forecast
00192:     if isSpecies?(:CASTFORM)
00193:       if hasActiveAbility?(:FORECAST)
00194:         newForm = 0
00195:         case effectiveWeather
00196:         when :Sun, :HarshSun   then newForm = 1
00197:         when :Rain, :HeavyRain then newForm = 2
00198:         when :Hail             then newForm = 3
00199:         end
00200:         if @form != newForm
00201:           @battle.pbShowAbilitySplash(self, true)
00202:           @battle.pbHideAbilitySplash(self)
00203:           pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00204:         end
00205:       else
00206:         pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00207:       end
00208:     end
00209:     # Cherrim - Flower Gift
00210:     if isSpecies?(:CHERRIM)
00211:       if hasActiveAbility?(:FLOWERGIFT)
00212:         newForm = 0
00213:         newForm = 1 if [:Sun, :HarshSun].include?(effectiveWeather)
00214:         if @form != newForm
00215:           @battle.pbShowAbilitySplash(self, true)
00216:           @battle.pbHideAbilitySplash(self)
00217:           pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00218:         end
00219:       else
00220:         pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00221:       end
00222:     end
00223:     # Eiscue - Ice Face
00224:     if !ability_changed && isSpecies?(:EISCUE) && self.ability == :ICEFACE &&
00225:        @form == 1 && effectiveWeather == :Hail
00226:       @canRestoreIceFace = true   # Changed form at end of round
00227:     end
00228:   end
00229: 
00230:   # Checks the Pokémon's form and updates it if necessary. Used for when a
00231:   # Pokémon enters battle (endOfRound=false) and at the end of each round
00232:   # (endOfRound=true).
00233:   def pbCheckForm(endOfRound = false)
00234:     return if fainted? || @effects[PBEffects::Transform]
00235:     # Form changes upon entering battle and when the weather changes
