00001: # NOTE: The following clauses have battle code implementing them, but no class
00002: #       below to apply them:
00003: #         "drawclause"
00004: #         "modifiedselfdestructclause"
00005: #         "suddendeath"
00006: 
00007: #===============================================================================
00008: #
00009: #===============================================================================
00010: class BattleRule
00011:   def setRule(battle); end
00012: end
00013: 
00014: #===============================================================================
00015: #
00016: #===============================================================================
00017: class DoubleBattle < BattleRule
00018:   def setRule(battle); battle.setBattleMode("double"); end
00019: end
00020: 
00021: #===============================================================================
00022: #
00023: #===============================================================================
00024: class SingleBattle < BattleRule
00025:   def setRule(battle); battle.setBattleMode("single"); end
00026: end
00027: 
