00648: 
00649: #===============================================================================
00650: # For 5 rounds, for each priority bracket, slow Pokémon move before fast ones.
00651: # (Trick Room)
00652: #===============================================================================
00653: class Battle::Move::StartSlowerBattlersActFirst < Battle::Move
00654:   def pbEffectGeneral(user)
00655:     if @battle.field.effects[PBEffects::TrickRoom] > 0
00656:       @battle.field.effects[PBEffects::TrickRoom] = 0
00657:       @battle.pbDisplay(_INTL("{1} reverted the dimensions!", user.pbThis))
00658:     else
00659:       @battle.field.effects[PBEffects::TrickRoom] = 5
00660:       @battle.pbDisplay(_INTL("{1} twisted the dimensions!", user.pbThis))
00661:     end
00662:   end
00663: 
00664:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00665:     return if @battle.field.effects[PBEffects::TrickRoom] > 0   # No animation
00666:     super
00667:   end
00668: end
00669: 
00670: #===============================================================================
00671: # If Grassy Terrain applies, priority is increased by 1. (Grassy Glide)
00672: #===============================================================================
00673: class Battle::Move::HigherPriorityInGrassyTerrain < Battle::Move
00674:   def pbPriority(user)
00675:     ret = super
00676:     ret += 1 if @battle.field.terrain == :Grassy && user.affectedByTerrain?
00677:     return ret
00678:   end
00679: end
00680: 
00681: #===============================================================================
00682: # Target's last move used loses 3 PP. Damaging move. (Eerie Spell)
00683: #===============================================================================
00684: class Battle::Move::LowerPPOfTargetLastMoveBy3 < Battle::Move
00685:   def pbAdditionalEffect(user, target)
00686:     return if target.fainted? || target.damageState.substitute
00687:     last_move = target.pbGetMoveWithID(target.lastRegularMoveUsed)
00688:     return if !last_move || last_move.pp == 0 || last_move.total_pp <= 0
00689:     reduction = [3, last_move.pp].min
00690:     target.pbSetPP(last_move, last_move.pp - reduction)
00691:     @battle.pbDisplay(_INTL("It reduced the PP of {1}'s {2} by {3}!",
00692:                             target.pbThis(true), last_move.name, reduction))
00693:   end
00694: end
00695: 
00696: #===============================================================================
00697: # Target's last move used loses 4 PP. Status move. (Spite)
00698: #===============================================================================
00699: class Battle::Move::LowerPPOfTargetLastMoveBy4 < Battle::Move
00700:   def ignoresSubstitute?(user); return true; end
00701:   def canMagicCoat?;            return true; end
00702: 
00703:   def pbFailsAgainstTarget?(user, target, show_message)
00704:     last_move = target.pbGetMoveWithID(target.lastRegularMoveUsed)
00705:     if !last_move || last_move.pp == 0 || last_move.total_pp <= 0
00706:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00707:       return true
00708:     end
00709:     return false
00710:   end
00711: 
00712:   def pbEffectAgainstTarget(user, target)
00713:     last_move = target.pbGetMoveWithID(target.lastRegularMoveUsed)
00714:     reduction = [4, last_move.pp].min
00715:     target.pbSetPP(last_move, last_move.pp - reduction)
00716:     @battle.pbDisplay(_INTL("It reduced the PP of {1}'s {2} by {3}!",
00717:                             target.pbThis(true), last_move.name, reduction))
00718:   end
00719: end
