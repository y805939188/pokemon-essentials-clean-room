00721: #===============================================================================
00722: # For 5 rounds, disables the last move the target used. (Disable)
00723: #===============================================================================
00724: class Battle::Move::DisableTargetLastMoveUsed < Battle::Move
00725:   def ignoresSubstitute?(user); return true; end
00726:   def canMagicCoat?;            return true; end
00727: 
00728:   def pbFailsAgainstTarget?(user, target, show_message)
00729:     if target.effects[PBEffects::Disable] > 0 || !target.lastRegularMoveUsed
00730:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00731:       return true
00732:     end
00733:     return true if pbMoveFailedAromaVeil?(user, target, show_message)
00734:     canDisable = false
00735:     target.eachMove do |m|
00736:       next if m.id != target.lastRegularMoveUsed
00737:       next if m.pp == 0 && m.total_pp > 0
00738:       canDisable = true
00739:       break
00740:     end
00741:     if !canDisable
00742:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00743:       return true
00744:     end
00745:     return false
00746:   end
00747: 
00748:   def pbEffectAgainstTarget(user, target)
00749:     target.effects[PBEffects::Disable]     = 5
00750:     target.effects[PBEffects::DisableMove] = target.lastRegularMoveUsed
00751:     @battle.pbDisplay(_INTL("{1}'s {2} was disabled!", target.pbThis,
00752:                             GameData::Move.get(target.lastRegularMoveUsed).name))
00753:     target.pbItemStatusCureCheck
00754:   end
00755: end
00756: 
00757: #===============================================================================
00758: # The target can no longer use the same move twice in a row. (Torment)
00759: # NOTE: Torment is only supposed to start applying at the end of the round in
00760: #       which it is used, unlike Taunt which starts applying immediately. I've
00761: #       decided to make Torment apply immediately.
00762: #===============================================================================
00763: class Battle::Move::DisableTargetUsingSameMoveConsecutively < Battle::Move
00764:   def ignoresSubstitute?(user); return true; end
00765:   def canMagicCoat?;            return true; end
00766: 
00767:   def pbFailsAgainstTarget?(user, target, show_message)
00768:     if target.effects[PBEffects::Torment]
00769:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00770:       return true
00771:     end
00772:     return true if pbMoveFailedAromaVeil?(user, target, show_message)
00773:     return false
00774:   end
00775: 
00776:   def pbEffectAgainstTarget(user, target)
00777:     target.effects[PBEffects::Torment] = true
00778:     @battle.pbDisplay(_INTL("{1} was subjected to torment!", target.pbThis))
00779:     target.pbItemStatusCureCheck
00780:   end
00781: end
00782: 
00783: #===============================================================================
00784: # For 4 rounds, the target must use the same move each round. (Encore)
00785: #===============================================================================
00786: class Battle::Move::DisableTargetUsingDifferentMove < Battle::Move
00787:   attr_reader :moveBlacklist
00788: 
00789:   def ignoresSubstitute?(user); return true; end
00790:   def canMagicCoat?;            return true; end
00791: 
00792:   def initialize(battle, move)
00793:     super
00794:     @moveBlacklist = [
00795:       "DisableTargetUsingDifferentMove",               # Encore
00796:       # Struggle
00797:       "Struggle",                                      # Struggle
00798:       # Moves that affect the moveset
00799:       "ReplaceMoveThisBattleWithTargetLastMoveUsed",   # Mimic
00800:       "ReplaceMoveWithTargetLastMoveUsed",             # Sketch
