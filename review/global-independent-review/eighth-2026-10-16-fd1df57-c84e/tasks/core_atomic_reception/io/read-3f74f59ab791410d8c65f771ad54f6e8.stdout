00001: module GameData
00002:   class Move
00003:     attr_reader :id
00004:     attr_reader :real_name
00005:     attr_reader :type
00006:     attr_reader :category
00007:     attr_reader :power
00008:     attr_reader :accuracy
00009:     attr_reader :total_pp
00010:     attr_reader :target
00011:     attr_reader :priority
00012:     attr_reader :function_code
00013:     attr_reader :flags
00014:     attr_reader :effect_chance
00015:     attr_reader :real_description
00016:     attr_reader :pbs_file_suffix
00017: 
00018:     DATA = {}
00019:     DATA_FILENAME = "moves.dat"
00020:     PBS_BASE_FILENAME = "moves"
00021: 
00022:     SCHEMA = {
00023:       "SectionName"  => [:id,               "m"],
00024:       "Name"         => [:real_name,        "s"],
00025:       "Type"         => [:type,             "e", :Type],
00026:       "Category"     => [:category,         "e", ["Physical", "Special", "Status"]],
00027:       "Power"        => [:power,            "u"],
00028:       "Accuracy"     => [:accuracy,         "u"],
00029:       "TotalPP"      => [:total_pp,         "u"],
00030:       "Target"       => [:target,           "e", :Target],
00031:       "Priority"     => [:priority,         "i"],
00032:       "FunctionCode" => [:function_code,    "s"],
00033:       "Flags"        => [:flags,            "*s"],
00034:       "EffectChance" => [:effect_chance,    "u"],
00035:       "Description"  => [:real_description, "q"]
00036:     }
00037: 
00038:     extend ClassMethodsSymbols
00039:     include InstanceMethods
00040: 
00041:     def initialize(hash)
00042:       @id               = hash[:id]
00043:       @real_name        = hash[:real_name]        || "Unnamed"
00044:       @type             = hash[:type]             || :NONE
00045:       @category         = hash[:category]         || 2
00046:       @power            = hash[:power]            || 0
00047:       @accuracy         = hash[:accuracy]         || 100
00048:       @total_pp         = hash[:total_pp]         || 5
00049:       @target           = hash[:target]           || :None
00050:       @priority         = hash[:priority]         || 0
00051:       @function_code    = hash[:function_code]    || "None"
00052:       @flags            = hash[:flags]            || []
00053:       @flags            = [@flags] if !@flags.is_a?(Array)
00054:       @effect_chance    = hash[:effect_chance]    || 0
00055:       @real_description = hash[:real_description] || "???"
00056:       @pbs_file_suffix  = hash[:pbs_file_suffix]  || ""
00057:     end
00058: 
00059:     # @deprecated This method is slated to be removed in v22.
00060:     def base_damage
00061:       Deprecation.warn_method("base_damage", "v22", "power")
00062:       return @power
00063:     end
00064: 
00065:     # @return [String] the translated name of this move
00066:     def name
00067:       return pbGetMessageFromHash(MessageTypes::MOVE_NAMES, @real_name)
00068:     end
00069: 
00070:     # @return [String] the translated description of this move
00071:     def description
00072:       return pbGetMessageFromHash(MessageTypes::MOVE_DESCRIPTIONS, @real_description)
00073:     end
00074: 
00075:     def has_flag?(flag)
00076:       return @flags.any? { |f| f.downcase == flag.downcase }
00077:     end
00078: 
00079:     def physical?
00080:       return false if @power == 0
00081:       return @category == 0 if Settings::MOVE_CATEGORY_PER_MOVE
00082:       return GameData::Type.get(@type).physical?
00083:     end
00084: 
00085:     def special?
00086:       return false if @power == 0
00087:       return @category == 1 if Settings::MOVE_CATEGORY_PER_MOVE
00088:       return GameData::Type.get(@type).special?
00089:     end
00090: 
00091:     def damaging?
00092:       return @category != 2
00093:     end
00094: 
00095:     def status?
00096:       return @category == 2
