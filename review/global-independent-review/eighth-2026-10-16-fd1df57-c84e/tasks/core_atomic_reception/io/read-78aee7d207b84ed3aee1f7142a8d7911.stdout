00078:   def pbEORUseFutureSight(position, position_index)
00079:     return if !position || position.effects[PBEffects::FutureSightCounter] == 0
00080:     position.effects[PBEffects::FutureSightCounter] -= 1
00081:     return if position.effects[PBEffects::FutureSightCounter] > 0
00082:     return if !@battlers[position_index] || @battlers[position_index].fainted?   # No target
00083:     moveUser = nil
00084:     allBattlers.each do |battler|
00085:       next if battler.opposes?(position.effects[PBEffects::FutureSightUserIndex])
00086:       next if battler.pokemonIndex != position.effects[PBEffects::FutureSightUserPartyIndex]
00087:       moveUser = battler
00088:       break
00089:     end
00090:     return if moveUser && moveUser.index == position_index   # Target is the user
00091:     if !moveUser   # User isn't in battle, get it from the party
00092:       party = pbParty(position.effects[PBEffects::FutureSightUserIndex])
00093:       pkmn = party[position.effects[PBEffects::FutureSightUserPartyIndex]]
00094:       if pkmn&.able?
00095:         moveUser = Battler.new(self, position.effects[PBEffects::FutureSightUserIndex])
00096:         moveUser.pbInitDummyPokemon(pkmn, position.effects[PBEffects::FutureSightUserPartyIndex])
00097:       end
00098:     end
00099:     return if !moveUser   # User is fainted
00100:     move = position.effects[PBEffects::FutureSightMove]
00101:     pbDisplay(_INTL("{1} took the {2} attack!", @battlers[position_index].pbThis,
00102:                     GameData::Move.get(move).name))
00103:     # NOTE: Future Sight failing against the target here doesn't count towards
00104:     #       Stomping Tantrum.
00105:     userLastMoveFailed = moveUser.lastMoveFailed
00106:     @futureSight = true
00107:     moveUser.pbUseMoveSimple(move, position_index)
00108:     @futureSight = false
00109:     moveUser.lastMoveFailed = userLastMoveFailed
00110:     @battlers[position_index].pbFaint if @battlers[position_index].fainted?
00111:     position.effects[PBEffects::FutureSightCounter]        = 0
00112:     position.effects[PBEffects::FutureSightMove]           = nil
00113:     position.effects[PBEffects::FutureSightUserIndex]      = -1
00114:     position.effects[PBEffects::FutureSightUserPartyIndex] = -1
00115:   end
00116: 
00117:   #=============================================================================
00118:   # End Of Round healing from Wish
00119:   #=============================================================================
00120:   def pbEORWishHealing
00121:     @positions.each_with_index do |pos, idxPos|
00122:       next if !pos || pos.effects[PBEffects::Wish] == 0
00123:       pos.effects[PBEffects::Wish] -= 1
00124:       next if pos.effects[PBEffects::Wish] > 0
00125:       next if !@battlers[idxPos] || !@battlers[idxPos].canHeal?
00126:       wishMaker = pbThisEx(idxPos, pos.effects[PBEffects::WishMaker])
00127:       @battlers[idxPos].pbRecoverHP(pos.effects[PBEffects::WishAmount])
00128:       pbDisplay(_INTL("{1}'s wish came true!", wishMaker))
00129:     end
00130:   end
