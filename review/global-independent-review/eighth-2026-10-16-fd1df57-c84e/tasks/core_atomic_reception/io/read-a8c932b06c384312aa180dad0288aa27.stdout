00060:     pbFaint if fainted?
00061:     @droppedBelowHalfHP = false
00062:   end
00063: 
00064:   def pbFaint(showMessage = true)
00065:     if !fainted?
00066:       PBDebug.log("!!!***Can't faint with HP greater than 0")
00067:       return
00068:     end
00069:     return if @fainted   # Has already fainted properly
00070:     @battle.pbDisplayBrief(_INTL("{1} fainted!", pbThis)) if showMessage
00071:     PBDebug.log("[Pokémon fainted] #{pbThis} (#{@index})") if !showMessage
00072:     @battle.scene.pbFaintBattler(self)
00073:     @battle.pbSetDefeated(self) if opposes?
00074:     pbInitEffects(false)
00075:     # Reset status
00076:     self.status      = :NONE
00077:     self.statusCount = 0
00078:     # Lose happiness
00079:     if @pokemon && @battle.internalBattle
00080:       badLoss = @battle.allOtherSideBattlers(@index).any? { |b| b.level >= self.level + 30 }
00081:       @pokemon.changeHappiness((badLoss) ? "faintbad" : "faint")
00082:     end
00083:     # Reset form
00084:     @battle.peer.pbOnLeavingBattle(@battle, @pokemon, @battle.usedInBattle[idxOwnSide][@index / 2])
00085:     @pokemon.makeUnmega if mega?
00086:     @pokemon.makeUnprimal if primal?
00087:     # Do other things
00088:     @battle.pbClearChoice(@index)   # Reset choice
00089:     pbOwnSide.effects[PBEffects::LastRoundFainted] = @battle.turnCount
00090:     if $game_temp.party_direct_damage_taken &&
00091:        $game_temp.party_direct_damage_taken[@pokemonIndex] &&
00092:        pbOwnedByPlayer?
00093:       $game_temp.party_direct_damage_taken[@pokemonIndex] = 0
00094:     end
00095:     # Check other battlers' abilities that trigger upon a battler fainting
00096:     pbAbilitiesOnFainting
00097:     # Check for end of primordial weather
00098:     @battle.pbEndPrimordialWeather
00099:   end
00100: 
00101:   #=============================================================================
00102:   # Move PP
