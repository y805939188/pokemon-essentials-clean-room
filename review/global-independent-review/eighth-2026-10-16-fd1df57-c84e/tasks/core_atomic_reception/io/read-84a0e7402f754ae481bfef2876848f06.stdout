00001: #===============================================================================
00002: # ** Game_Switches
00003: #-------------------------------------------------------------------------------
00004: #  This class handles switches. It's a wrapper for the built-in class "Array."
00005: #  Refer to "$game_switches" for the instance of this class.
00006: #===============================================================================
00007: class Game_Switches
00008:   def initialize
00009:     @data = []
00010:   end
00011: 
00012:   # Get Switch
00013:   #     switch_id : switch ID
00014:   def [](switch_id)
00015:     return @data[switch_id] if switch_id <= 5000 && @data[switch_id]
00016:     return false
00017:   end
00018: 
00019:   # Set Switch
00020:   #     switch_id : switch ID
00021:   #     value     : ON (true) / OFF (false)
00022:   def []=(switch_id, value)
00023:     @data[switch_id] = value if switch_id <= 5000
00024:   end
00025: end
