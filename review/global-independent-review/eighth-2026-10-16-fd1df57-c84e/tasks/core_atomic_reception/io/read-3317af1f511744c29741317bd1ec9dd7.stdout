00040:   end
00041: 
00042:   def self.log_message(msg)
00043:     if $DEBUG && $INTERNAL
00044:       msg = "\"" + msg + "\""
00045:       echoln Console.markup_style(msg.gsub("%", "%%"), text: :dark_gray)
00046:       @@log.push(msg + "\r\n")
00047:       PBDebug.flush   # if @@log.length > 1024
00048:     end
00049:   end
00050: 
00051:   def self.log_ai(msg)
00052:     if $DEBUG && $INTERNAL
00053:       msg = "[AI] " + msg
00054:       echoln msg.gsub("%", "%%")
00055:       @@log.push(msg + "\r\n")
00056:       PBDebug.flush   # if @@log.length > 1024
00057:     end
00058:   end
00059: 
00060:   def self.log_score_change(amt, msg)
00061:     return if amt == 0
00062:     if $DEBUG && $INTERNAL
00063:       sign = (amt > 0) ? "+" : "-"
00064:       amt_text = sprintf("%3d", amt.abs)
00065:       msg = "     #{sign}#{amt_text}: #{msg}"
00066:       echoln msg.gsub("%", "%%")
00067:       @@log.push(msg + "\r\n")
00068:       PBDebug.flush   # if @@log.length > 1024
00069:     end
00070:   end
00071: 
00072:   def self.dump(msg)
00073:     if $DEBUG && $INTERNAL
00074:       File.open("Data/dumplog.txt", "a+b") { |f| f.write("#{msg}\r\n") }
00075:     end
00076:   end
00077: end
