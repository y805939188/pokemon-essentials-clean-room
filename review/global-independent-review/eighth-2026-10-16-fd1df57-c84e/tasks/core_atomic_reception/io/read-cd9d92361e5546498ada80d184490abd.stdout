00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: class Battle::DamageState
00005:   attr_accessor :typeMod         # Type effectiveness
00006:   attr_accessor :unaffected
00007:   attr_accessor :protected
00008:   attr_accessor :magicCoat
00009:   attr_accessor :magicBounce
00010:   attr_accessor :totalHPLost     # Like hpLost, but cumulative over all hits
00011:   attr_accessor :fainted         # Whether battler was knocked out by the move
00012: 
00013:   attr_accessor :missed          # Whether the move failed the accuracy check
00014:   attr_accessor :affection_missed
00015:   attr_accessor :invulnerable    # If the move missed due to two turn move invulnerability
00016:   attr_accessor :calcDamage      # Calculated damage
00017:   attr_accessor :hpLost          # HP lost by opponent, inc. HP lost by a substitute
00018:   attr_accessor :critical        # Critical hit flag
00019:   attr_accessor :affection_critical
00020:   attr_accessor :substitute      # Whether a substitute took the damage
00021:   attr_accessor :focusBand       # Focus Band used
00022:   attr_accessor :focusSash       # Focus Sash used
00023:   attr_accessor :sturdy          # Sturdy ability used
00024:   attr_accessor :disguise        # Disguise ability used
00025:   attr_accessor :iceFace         # Ice Face ability used
00026:   attr_accessor :endured         # Damage was endured
00027:   attr_accessor :affection_endured
00028:   attr_accessor :berryWeakened   # Whether a type-resisting berry was used
00029: 
00030:   def initialize; reset; end
00031: 
00032:   def reset
00033:     @typeMod          = Effectiveness::INEFFECTIVE_MULTIPLIER
00034:     @unaffected       = false
00035:     @protected        = false
00036:     @missed           = false
00037:     @affection_missed = false
00038:     @invulnerable     = false
00039:     @magicCoat        = false
00040:     @magicBounce      = false
00041:     @totalHPLost      = 0
00042:     @fainted          = false
00043:     resetPerHit
00044:   end
00045: 
00046:   def resetPerHit
00047:     @calcDamage         = 0
00048:     @hpLost             = 0
00049:     @critical           = false
00050:     @affection_critical = false
00051:     @substitute         = false
00052:     @focusBand          = false
00053:     @focusSash          = false
00054:     @sturdy             = false
00055:     @disguise           = false
00056:     @iceFace            = false
00057:     @endured            = false
00058:     @affection_endured  = false
00059:     @berryWeakened      = false
00060:   end
00061: end
