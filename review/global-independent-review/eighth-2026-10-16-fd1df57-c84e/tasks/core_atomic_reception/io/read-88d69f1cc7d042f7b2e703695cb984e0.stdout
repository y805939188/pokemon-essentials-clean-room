00171:   def pbOnLosingAbility(oldAbil, suppressed = false)
00172:     if oldAbil == :NEUTRALIZINGGAS && (suppressed || !@effects[PBEffects::GastroAcid])
00173:       pbAbilitiesOnNeutralizingGasEnding
00174:     elsif [:UNNERVE, :ASONECHILLINGNEIGH, :ASONEGRIMNEIGH].include?(oldAbil) &&
00175:           (suppressed || !@effects[PBEffects::GastroAcid])
00176:       pbItemsOnUnnerveEnding
00177:     elsif oldAbil == :ILLUSION && @effects[PBEffects::Illusion]
00178:       @effects[PBEffects::Illusion] = nil
00179:       if !@effects[PBEffects::Transform]
00180:         @battle.scene.pbChangePokemon(self, @pokemon)
00181:         @battle.pbDisplay(_INTL("{1}'s {2} wore off!", pbThis, GameData::Ability.get(oldAbil).name))
00182:         @battle.pbSetSeen(self)
00183:       end
00184:     end
00185:     @effects[PBEffects::GastroAcid] = false if unstoppableAbility?
00186:     @effects[PBEffects::SlowStart]  = 0 if self.ability != :SLOWSTART
00187:     @effects[PBEffects::Truant]     = false if self.ability != :TRUANT
00188:     # Check for end of primordial weather
00189:     @battle.pbEndPrimordialWeather
00190:     # Revert form if Flower Gift/Forecast was lost
00191:     pbCheckFormOnWeatherChange(true)
00192:     # Abilities that trigger when the terrain changes
00193:     pbAbilityOnTerrainChange(true)
00194:   end
00195: 
00196:   def pbTriggerAbilityOnGainingIt
00197:     # Ending primordial weather, checking Trace
00198:     pbContinualAbilityChecks(true)   # Don't trigger Traced ability as it's triggered below
00199:     # Abilities that trigger upon switching in
00200:     if (!fainted? && unstoppableAbility?) || abilityActive?
00201:       Battle::AbilityEffects.triggerOnSwitchIn(self.ability, self, @battle)
00202:     end
00203:     # Status-curing ability check
00204:     pbAbilityStatusCureCheck
00205:     # Check for end of primordial weather
00206:     @battle.pbEndPrimordialWeather
