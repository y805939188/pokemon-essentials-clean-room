00296: #===============================================================================
00297: class Battle::Move::UserConsumeBerryRaiseDefense2 < Battle::Move::StatUpMove
00298:   def initialize(battle, move)
00299:     super
00300:     @statUp = [:DEFENSE, 2]
00301:   end
00302: 
00303:   def pbCanChooseMove?(user, commandPhase, showMessages)
00304:     item = user.item
00305:     if !item || !item.is_berry? || !user.itemActive?
00306:       if showMessages
00307:         msg = _INTL("{1} can't use that move because it doesn't have a Berry!", user.pbThis)
00308:         (commandPhase) ? @battle.pbDisplayPaused(msg) : @battle.pbDisplay(msg)
00309:       end
00310:       return false
00311:     end
00312:     return true
00313:   end
00314: 
00315:   def pbMoveFailed?(user, targets)
00316:     # NOTE: Unnerve does not stop a Pokémon using this move.
00317:     item = user.item
00318:     if !item || !item.is_berry? || !user.itemActive?
00319:       @battle.pbDisplay(_INTL("But it failed!"))
00320:       return true
00321:     end
00322:     return super
00323:   end
00324: 
00325:   def pbEffectGeneral(user)
00326:     super
00327:     @battle.pbDisplay(_INTL("{1} ate its {2}!", user.pbThis, user.itemName))
00328:     item = user.item
00329:     user.pbConsumeItem(true, false)   # Don't trigger Symbiosis yet
00330:     user.pbHeldItemTriggerCheck(item.id, false)
00331:   end
