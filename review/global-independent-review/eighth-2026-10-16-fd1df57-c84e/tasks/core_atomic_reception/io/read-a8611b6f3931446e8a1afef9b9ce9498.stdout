01099:   def calc_stats
01100:     base_stats = self.baseStats
01101:     this_level = self.level
01102:     this_IV    = self.calcIV
01103:     # Format stat multipliers due to nature
01104:     nature_mod = {}
01105:     GameData::Stat.each_main { |s| nature_mod[s.id] = 100 }
01106:     this_nature = self.nature_for_stats
01107:     if this_nature
01108:       this_nature.stat_changes.each { |change| nature_mod[change[0]] += change[1] }
01109:     end
01110:     # Calculate stats
01111:     stats = {}
01112:     GameData::Stat.each_main do |s|
01113:       if s.id == :HP
01114:         stats[s.id] = calcHP(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id])
01115:       else
01116:         stats[s.id] = calcStat(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id], nature_mod[s.id])
01117:       end
01118:     end
01119:     hp_difference = stats[:HP] - @totalhp
01120:     @totalhp = stats[:HP]
01121:     self.hp = [@hp + hp_difference, 1].max if @hp > 0 || hp_difference > 0
01122:     @attack  = stats[:ATTACK]
01123:     @defense = stats[:DEFENSE]
01124:     @spatk   = stats[:SPECIAL_ATTACK]
01125:     @spdef   = stats[:SPECIAL_DEFENSE]
01126:     @speed   = stats[:SPEED]
01127:   end
01128: 
01129:   #=============================================================================
01130:   # Pokémon creation
01131:   #=============================================================================
01132: 
01133:   # Creates a copy of this Pokémon and returns it.
01134:   # @return [Pokemon] a copy of this Pokémon
01135:   def clone
01136:     ret = super
01137:     ret.iv          = {}
01138:     ret.ivMaxed     = {}
01139:     ret.ev          = {}
01140:     GameData::Stat.each_main do |s|
01141:       ret.iv[s.id]      = @iv[s.id]
01142:       ret.ivMaxed[s.id] = @ivMaxed[s.id]
01143:       ret.ev[s.id]      = @ev[s.id]
01144:     end
01145:     ret.moves       = []
01146:     @moves.each_with_index { |m, i| ret.moves[i] = m.clone }
01147:     ret.first_moves = @first_moves.clone
01148:     ret.owner       = @owner.clone
01149:     ret.ribbons     = @ribbons.clone
01150:     return ret
01151:   end
01152: 
01153:   # Creates a new Pokémon object.
01154:   # @param species [Symbol, String, GameData::Species] Pokémon species
