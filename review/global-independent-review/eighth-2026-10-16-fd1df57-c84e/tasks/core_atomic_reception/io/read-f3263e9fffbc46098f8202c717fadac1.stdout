01193: #===============================================================================
01194: # DamageCalcFromUser handlers
01195: #===============================================================================
01196: 
01197: Battle::AbilityEffects::DamageCalcFromUser.add(:AERILATE,
01198:   proc { |ability, user, target, move, mults, power, type|
01199:     mults[:power_multiplier] *= 1.2 if move.powerBoost
01200:   }
01201: )
01202: 
01203: Battle::AbilityEffects::DamageCalcFromUser.copy(:AERILATE, :GALVANIZE, :NORMALIZE, :PIXILATE, :REFRIGERATE)
01204: 
01205: Battle::AbilityEffects::DamageCalcFromUser.add(:ANALYTIC,
01206:   proc { |ability, user, target, move, mults, power, type|
01207:     # NOTE: In the official games, if another battler faints earlier in the
01208:     #       round but it would have moved after the user, then Analytic does not
01209:     #       power up the move. However, this makes the determination so much
01210:     #       more complicated (involving pbPriority and counting or not counting
01211:     #       speed/priority modifiers depending on which Generation's mechanics
01212:     #       are being used), so I'm choosing to ignore it. The effect is thus:
01213:     #       "power up the move if all other battlers on the field right now have
01214:     #       already moved".
01215:     if move.pbMoveFailedLastInRound?(user, false)
01216:       mults[:power_multiplier] *= 1.3
01217:     end
01218:   }
01219: )
01220: 
01221: Battle::AbilityEffects::DamageCalcFromUser.add(:BLAZE,
01222:   proc { |ability, user, target, move, mults, power, type|
01223:     if user.hp <= user.totalhp / 3 && type == :FIRE
01224:       mults[:attack_multiplier] *= 1.5
01225:     end
01226:   }
01227: )
01228: 
01229: Battle::AbilityEffects::DamageCalcFromUser.add(:DEFEATIST,
01230:   proc { |ability, user, target, move, mults, power, type|
01231:     mults[:attack_multiplier] /= 2 if user.hp <= user.totalhp / 2
01232:   }
01233: )
01234: 
01235: Battle::AbilityEffects::DamageCalcFromUser.add(:DRAGONSMAW,
01236:   proc { |ability, user, target, move, mults, power, type|
01237:     mults[:attack_multiplier] *= 1.5 if type == :DRAGON
01238:   }
01239: )
01240: 
01241: Battle::AbilityEffects::DamageCalcFromUser.add(:FLAREBOOST,
01242:   proc { |ability, user, target, move, mults, power, type|
01243:     mults[:power_multiplier] *= 1.5 if user.burned? && move.specialMove?
01244:   }
01245: )
01246: 
01247: Battle::AbilityEffects::DamageCalcFromUser.add(:FLASHFIRE,
01248:   proc { |ability, user, target, move, mults, power, type|
01249:     if user.effects[PBEffects::FlashFire] && type == :FIRE
01250:       mults[:attack_multiplier] *= 1.5
01251:     end
01252:   }
01253: )
01254: 
01255: Battle::AbilityEffects::DamageCalcFromUser.add(:FLOWERGIFT,
01256:   proc { |ability, user, target, move, mults, power, type|
01257:     if move.physicalMove? && [:Sun, :HarshSun].include?(user.effectiveWeather)
01258:       mults[:attack_multiplier] *= 1.5
01259:     end
01260:   }
01261: )
01262: 
01263: Battle::AbilityEffects::DamageCalcFromUser.add(:GORILLATACTICS,
01264:   proc { |ability, user, target, move, mults, power, type|
01265:     mults[:attack_multiplier] *= 1.5 if move.physicalMove?
01266:   }
01267: )
01268: 
01269: Battle::AbilityEffects::DamageCalcFromUser.add(:GUTS,
01270:   proc { |ability, user, target, move, mults, power, type|
01271:     if user.pbHasAnyStatus? && move.physicalMove?
01272:       mults[:attack_multiplier] *= 1.5
01273:     end
01274:   }
01275: )
01276: 
01277: Battle::AbilityEffects::DamageCalcFromUser.add(:HUGEPOWER,
01278:   proc { |ability, user, target, move, mults, power, type|
01279:     mults[:attack_multiplier] *= 2 if move.physicalMove?
01280:   }
01281: )
01282: 
01283: Battle::AbilityEffects::DamageCalcFromUser.copy(:HUGEPOWER, :PUREPOWER)
01284: 
01285: Battle::AbilityEffects::DamageCalcFromUser.add(:HUSTLE,
01286:   proc { |ability, user, target, move, mults, power, type|
01287:     mults[:attack_multiplier] *= 1.5 if move.physicalMove?
01288:   }
01289: )
01290: 
01291: Battle::AbilityEffects::DamageCalcFromUser.add(:IRONFIST,
01292:   proc { |ability, user, target, move, mults, power, type|
01293:     mults[:power_multiplier] *= 1.2 if move.punchingMove?
01294:   }
01295: )
01296: 
01297: Battle::AbilityEffects::DamageCalcFromUser.add(:MEGALAUNCHER,
01298:   proc { |ability, user, target, move, mults, power, type|
01299:     mults[:power_multiplier] *= 1.5 if move.pulseMove?
01300:   }
01301: )
01302: 
01303: Battle::AbilityEffects::DamageCalcFromUser.add(:MINUS,
01304:   proc { |ability, user, target, move, mults, power, type|
01305:     next if !move.specialMove?
01306:     if user.allAllies.any? { |b| b.hasActiveAbility?([:MINUS, :PLUS]) }
01307:       mults[:attack_multiplier] *= 1.5
01308:     end
01309:   }
01310: )
01311: 
01312: Battle::AbilityEffects::DamageCalcFromUser.copy(:MINUS, :PLUS)
01313: 
01314: Battle::AbilityEffects::DamageCalcFromUser.add(:NEUROFORCE,
01315:   proc { |ability, user, target, move, mults, power, type|
01316:     if Effectiveness.super_effective?(target.damageState.typeMod)
01317:       mults[:final_damage_multiplier] *= 1.25
01318:     end
01319:   }
01320: )
01321: 
01322: Battle::AbilityEffects::DamageCalcFromUser.add(:OVERGROW,
01323:   proc { |ability, user, target, move, mults, power, type|
01324:     if user.hp <= user.totalhp / 3 && type == :GRASS
01325:       mults[:attack_multiplier] *= 1.5
01326:     end
01327:   }
01328: )
01329: 
01330: Battle::AbilityEffects::DamageCalcFromUser.add(:PUNKROCK,
01331:   proc { |ability, user, target, move, mults, power, type|
01332:     mults[:attack_multiplier] *= 1.3 if move.soundMove?
01333:   }
01334: )
01335: 
01336: Battle::AbilityEffects::DamageCalcFromUser.add(:RECKLESS,
01337:   proc { |ability, user, target, move, mults, power, type|
01338:     mults[:power_multiplier] *= 1.2 if move.recoilMove?
01339:   }
01340: )
01341: 
01342: Battle::AbilityEffects::DamageCalcFromUser.add(:RIVALRY,
01343:   proc { |ability, user, target, move, mults, power, type|
01344:     if user.gender != 2 && target.gender != 2
01345:       if user.gender == target.gender
01346:         mults[:power_multiplier] *= 1.25
01347:       else
01348:         mults[:power_multiplier] *= 0.75
01349:       end
01350:     end
01351:   }
01352: )
01353: 
01354: Battle::AbilityEffects::DamageCalcFromUser.add(:SANDFORCE,
01355:   proc { |ability, user, target, move, mults, power, type|
01356:     if user.effectiveWeather == :Sandstorm &&
01357:        [:ROCK, :GROUND, :STEEL].include?(type)
01358:       mults[:power_multiplier] *= 1.3
01359:     end
01360:   }
01361: )
01362: 
01363: Battle::AbilityEffects::DamageCalcFromUser.add(:SHEERFORCE,
01364:   proc { |ability, user, target, move, mults, power, type|
01365:     mults[:power_multiplier] *= 1.3 if move.addlEffect > 0
01366:   }
01367: )
01368: 
01369: Battle::AbilityEffects::DamageCalcFromUser.add(:SLOWSTART,
