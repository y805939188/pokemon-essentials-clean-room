00100:   end
00101: 
00102:   def pbAttackPhaseMoves
00103:     # Show charging messages (Focus Punch)
00104:     pbPriority.each do |b|
00105:       next unless @choices[b.index][0] == :UseMove && !b.fainted?
00106:       next if b.movedThisRound?
00107:       @choices[b.index][2].pbDisplayChargeMessage(b)
00108:     end
00109:     # Main move processing loop
00110:     loop do
00111:       priority = pbPriority
00112:       # Forced to go next
00113:       advance = false
00114:       priority.each do |b|
00115:         next unless b.effects[PBEffects::MoveNext] && !b.fainted?
00116:         next unless @choices[b.index][0] == :UseMove || @choices[b.index][0] == :Shift
00117:         next if b.movedThisRound?
00118:         advance = b.pbProcessTurn(@choices[b.index])
00119:         break if advance
00120:       end
00121:       return if @decision > 0
00122:       next if advance
00123:       # Regular priority order
00124:       priority.each do |b|
00125:         next if b.effects[PBEffects::Quash] > 0 || b.fainted?
00126:         next unless @choices[b.index][0] == :UseMove || @choices[b.index][0] == :Shift
00127:         next if b.movedThisRound?
00128:         advance = b.pbProcessTurn(@choices[b.index])
00129:         break if advance
00130:       end
00131:       return if @decision > 0
00132:       next if advance
00133:       # Quashed
00134:       if Settings::MECHANICS_GENERATION >= 8
00135:         priority.each do |b|
00136:           next unless b.effects[PBEffects::Quash] > 0 && !b.fainted?
00137:           next unless @choices[b.index][0] == :UseMove || @choices[b.index][0] == :Shift
00138:           next if b.movedThisRound?
00139:           advance = b.pbProcessTurn(@choices[b.index])
00140:           break if advance
00141:         end
00142:       else
00143:         quashLevel = 0
00144:         loop do
00145:           quashLevel += 1
00146:           moreQuash = false
00147:           priority.each do |b|
00148:             moreQuash = true if b.effects[PBEffects::Quash] > quashLevel
00149:             next unless b.effects[PBEffects::Quash] == quashLevel && !b.fainted?
00150:             next unless @choices[b.index][0] == :UseMove || @choices[b.index][0] == :Shift
00151:             next if b.movedThisRound?
00152:             advance = b.pbProcessTurn(@choices[b.index])
00153:             break
00154:           end
00155:           break if advance || !moreQuash
00156:         end
00157:       end
00158:       return if @decision > 0
00159:       next if advance
00160:       # Check for all done
00161:       priority.each do |b|
00162:         next if b.fainted?
00163:         next if b.movedThisRound? || ![:UseMove, :Shift].include?(@choices[b.index][0])
00164:         advance = true
00165:         break
00166:       end
00167:       next if advance
00168:       # All Pokémon have moved; end the loop
00169:       break
00170:     end
00171:   end
00172: 
00173:   #=============================================================================
00174:   # Attack phase
00175:   #=============================================================================
