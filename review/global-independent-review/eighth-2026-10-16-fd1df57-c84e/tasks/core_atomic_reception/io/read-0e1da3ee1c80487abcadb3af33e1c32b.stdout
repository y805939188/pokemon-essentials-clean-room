00543: 
00544:   #=============================================================================
00545:   # Comparing the positions of two battlers
00546:   #=============================================================================
00547:   def opposes?(idxBattler1, idxBattler2 = 0)
00548:     idxBattler1 = idxBattler1.index if idxBattler1.respond_to?("index")
00549:     idxBattler2 = idxBattler2.index if idxBattler2.respond_to?("index")
00550:     return (idxBattler1 & 1) != (idxBattler2 & 1)
00551:   end
00552: 
00553:   def nearBattlers?(idxBattler1, idxBattler2)
00554:     return false if idxBattler1 == idxBattler2
00555:     return true if pbSideSize(0) <= 2 && pbSideSize(1) <= 2
00556:     # Get all pairs of battler positions that are not close to each other
00557:     pairsArray = [[0, 4], [1, 5]]   # Covers 3v1 and 1v3
00558:     case pbSideSize(0)
00559:     when 3
00560:       case pbSideSize(1)
00561:       when 3   # 3v3 (triple)
00562:         pairsArray.push([0, 1])
00563:         pairsArray.push([4, 5])
00564:       when 2   # 3v2
00565:         pairsArray.push([0, 1])
00566:         pairsArray.push([3, 4])
00567:       end
00568:     when 2       # 2v3
00569:       pairsArray.push([0, 1])
00570:       pairsArray.push([2, 5])
00571:     end
00572:     # See if any pair matches the two battlers being assessed
00573:     pairsArray.each do |pair|
00574:       return false if pair.include?(idxBattler1) && pair.include?(idxBattler2)
00575:     end
00576:     return true
00577:   end
