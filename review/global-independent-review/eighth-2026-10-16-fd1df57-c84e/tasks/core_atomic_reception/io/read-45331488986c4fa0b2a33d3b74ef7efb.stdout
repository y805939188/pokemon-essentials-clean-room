00467:   # is given, returns whether this Pokémon has an ability set.
00468:   # @param check_ability [Symbol, String, GameData::Ability, nil] ability ID to check
00469:   # @return [Boolean] whether this Pokémon has a particular ability or
00470:   #   an ability at all
00471:   def hasAbility?(check_ability = nil)
00472:     current_ability = self.ability
00473:     return !current_ability.nil? if check_ability.nil?
00474:     return current_ability == check_ability
00475:   end
00476: 
00477:   # @return [Boolean] whether this Pokémon has a hidden ability
00478:   def hasHiddenAbility?
00479:     return ability_index >= 2
00480:   end
