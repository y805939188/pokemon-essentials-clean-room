00519:   def pbDecisionOnTime
00520:     counts   = [0, 0]
00521:     hpTotals = [0, 0]
00522:     2.times do |side|
00523:       pbParty(side).each do |pkmn|
00524:         next if !pkmn || !pkmn.able?
00525:         counts[side]   += 1
00526:         hpTotals[side] += pkmn.hp
00527:       end
00528:     end
00529:     return 1 if counts[0] > counts[1]       # Win (player has more able Pokémon)
00530:     return 2 if counts[0] < counts[1]       # Loss (foe has more able Pokémon)
00531:     return 1 if hpTotals[0] > hpTotals[1]   # Win (player has more HP in total)
00532:     return 2 if hpTotals[0] < hpTotals[1]   # Loss (foe has more HP in total)
00533:     return 5                                # Draw
00534:   end
