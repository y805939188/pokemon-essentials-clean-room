00018:       "title": "世界时钟明暗",
00019:       "reviewer": "/root/world_full",
00020:       "assertions": [
00021:         {
00022:           "id": "WFS-038-01",
00023:           "fact": "pbGetTimeNow每次取宿主本地Time.now，可覆写；日5–20、夜20–5、晨5–10、午14–17、暮17–20，谓词可传时间。"
00024:         },
00025:         {
00026:           "id": "WFS-038-02",
00027:           "fact": "24小时tone表全读，分钟线性插到下一小时mod24；单调≥30秒门才重算，重算取日历时间。"
00028:         },
00029:         {
00030:           "id": "WFS-038-03",
00031:           "fact": "配置关闭返回已有缓存，首次才零；地图应用非地图场景直接不写，地图且配置/户外才应用，否则置零。"
00032:         },
00033:         {
00034:           "id": "WFS-038-04",
00035:           "fact": "明暗度取当日分钟、过正午镜像后整数255t/720，未使用色调缓存。"
00036:         }
00037:       ],
00038:       "consumers": [
00039:         "WP59§3",
