00122:       "title": "战斗规则与前置参数",
00123:       "reviewer": "/root/world_full",
00124:       "assertions": [
00125:         {
00126:           "id": "WFS-070-01",
00127:           "fact": "规则存于临时battle_rules；规范化名称后支持人数、canlose/canrun、experience/money、switchstyle、animations、partner、environment、weather、terrain、backdrop、base、outcome变量等，未知规则抛错误。"
00128:         },
00129:         {
00130:           "id": "WFS-070-02",
00131:           "fact": "规则可请求的双/三人格式经可用精灵数修正；无合法参战对象前门不能等同实际战斗成功。"
00132:         },
00133:         {
00134:           "id": "WFS-070-03",
00135:           "fact": "队伍初始化与partner合并共用实际party对象，不能把数组合并理解为克隆精灵；后续恢复/演化会消费这些对象。"
00136:         }
00137:       ],
00138:       "consumers": [
00139:         "WP16战前参数",
00140:         "Creature battle ingress"
00141:       ],
00142:       "evidence": "SOURCE_STATIC",
