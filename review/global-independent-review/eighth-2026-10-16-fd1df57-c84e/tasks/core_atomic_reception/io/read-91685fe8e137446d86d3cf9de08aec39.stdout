00153:       ],
00154:       "title": "战斗参数准备与世界消费",
00155:       "reviewer": "/root/world_full",
00156:       "assertions": [
00157:         {
00158:           "id": "WFS-071-01",
00159:           "fact": "显式defaultTerrain优先；否则仅在配置允许时由世界Storm映射Electric、Fog映射Misty；未匹配保留None。"
00160:         },
00161:         {
00162:           "id": "WFS-071-02",
00163:           "fact": "显式defaultWeather优先；否则按世界category将Rain和Storm映射Rain、Hail映射Hail、Sandstorm和Sun同名映射，未匹配None。"
00164:         },
00165:         {
00166:           "id": "WFS-071-03",
00167:           "fact": "世界天气定义与BattleWeather是不同登记域，映射类别不是直接复制全部世界ID。"
00168:         },
00169:         {
00170:           "id": "WFS-071-04",
00171:           "fact": "洞穴时段先由当前MapMetadata.battle_environment==Cave决定；否则TIME_SHADING允许时按night/evening/其它写2/1/0，没有Outdoor门，显式battle环境覆盖不改此洞穴判定。"
00172:         },
00173:         {
00174:           "id": "WFS-071-05",
00175:           "fact": "环境、backdrop、base等按各自显式规则和世界推导分支选择；准备写对象按顺序发生，异常无总回滚。"
00176:         }
00177:       ],
00178:       "consumers": [
00179:         "WP16战前世界参数",
00180:         "WP59天气/时间",
00181:         "resources weather receipt"
00182:       ],
00183:       "evidence": "SOURCE_STATIC",
