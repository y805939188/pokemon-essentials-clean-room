00087:       "title": "月相星座完整数学",
00088:       "reviewer": "/root/world_full",
00089:       "assertions": [
00090:         {
00091:           "id": "WFS-040-01",
00092:           "fact": "月相8阈值与正序≤比较全读；调整年、整数日、世纪门先于日内项，日内小时和分钟均乘60。"
00093:         },
00094:         {
00095:           "id": "WFS-040-02",
00096:           "fact": "相位先取小数后原负值加1，负古代区可全越阈回0；注释UTC不做实际归一。"
00097:         },
00098:         {
00099:           "id": "WFS-040-03",
00100:           "fact": "星座12行全读，首匹配按起月>=日或终月<=日，7/21–22空档回0。"
00101:         },
00102:         {
00103:           "id": "WFS-040-04",
00104:           "fact": "对冲+6、伴侣+4/+8、互补+1/+11均mod12。"
00105:         }
