00231:     return user.attack, user.stages[:ATTACK] + Battle::Battler::STAT_STAGE_MAXIMUM
00232:   end
00233: 
00234:   def pbGetDefenseStats(user, target)
00235:     return target.spdef, target.stages[:SPECIAL_DEFENSE] + Battle::Battler::STAT_STAGE_MAXIMUM if specialMove?
00236:     return target.defense, target.stages[:DEFENSE] + Battle::Battler::STAT_STAGE_MAXIMUM
00237:   end
