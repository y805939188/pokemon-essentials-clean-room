00001: # DO NOT USE ANY CLASS NAMES IN HERE AS FUNCTION CODES!
00002: # These are base classes for other classes to build on; those other classes are
00003: # named after function codes, so use those instead.
00004: 
00005: #===============================================================================
00006: # Superclass that handles moves using a non-existent function code.
00007: # Damaging moves just do damage with no additional effect.
00008: # Status moves always fail.
00009: #===============================================================================
00010: class Battle::Move::Unimplemented < Battle::Move
00011:   def pbMoveFailed?(user, targets)
00012:     if statusMove?
00013:       @battle.pbDisplay(_INTL("But it failed!"))
00014:       return true
00015:     end
00016:     return false
00017:   end
00018: end
00019: 
00020: #===============================================================================
00021: # Pseudomove for confusion damage.
00022: #===============================================================================
00023: class Battle::Move::Confusion < Battle::Move
00024:   def initialize(battle, move)
00025:     @battle        = battle
00026:     @realMove      = move
00027:     @id            = :CONFUSEDAMAGE
00028:     @name          = ""
00029:     @function_code = "None"
00030:     @power         = 40
00031:     @type          = nil
00032:     @category      = 0
00033:     @accuracy      = 100
00034:     @pp            = -1
00035:     @target        = :User
00036:     @priority      = 0
00037:     @flags         = []
00038:     @addlEffect    = 0
00039:     @powerBoost    = false
00040:     @snatched      = false
00041:   end
00042: 
00043:   def physicalMove?(thisType = nil);   return true;  end
00044:   def specialMove?(thisType = nil);    return false; end
00045:   def pbCritialOverride(user, target); return -1;    end
00046: end
00047: 
00048: #===============================================================================
00049: # Struggle.
00050: #===============================================================================
00051: class Battle::Move::Struggle < Battle::Move
00052:   def initialize(battle, move)
00053:     @battle        = battle
00054:     @realMove      = nil                     # Not associated with a move
00055:     @id            = :STRUGGLE
00056:     @name          = _INTL("Struggle")
00057:     @function_code = "Struggle"
00058:     @power         = 50
00059:     @type          = nil
00060:     @category      = 0
00061:     @accuracy      = 0
00062:     @pp            = -1
00063:     @target        = :RandomNearFoe
00064:     @priority      = 0
00065:     @flags         = ["Contact", "CanProtect"]
00066:     @addlEffect    = 0
00067:     @powerBoost    = false
00068:     @snatched      = false
00069:   end
00070: 
00071:   def physicalMove?(thisType = nil); return true;  end
00072:   def specialMove?(thisType = nil);  return false; end
00073: 
00074:   def pbEffectAfterAllHits(user, target)
00075:     return if target.damageState.unaffected
00076:     user.pbReduceHP((user.totalhp / 4.0).round, false)
00077:     @battle.pbDisplay(_INTL("{1} is damaged by recoil!", user.pbThis))
00078:     user.pbItemHPHealCheck
00079:   end
00080: end
00081: 
00082: #===============================================================================
00083: # Raise one of user's stats.
00084: #===============================================================================
00085: class Battle::Move::StatUpMove < Battle::Move
00086:   attr_reader :statUp
00087: 
00088:   def canSnatch?; return true; end
00089: 
