00444: class Battle::Scene::TargetMenu < Battle::Scene::MenuBase
00445:   attr_accessor :mode
00446: 
00447:   # Lists of which button graphics to use in different situations/types of battle.
00448:   MODES = [
00449:     [0, 2, 1, 3],   # 0 = Regular battle
00450:     [0, 2, 1, 9],   # 1 = Regular battle with "Cancel" instead of "Run"
00451:     [0, 2, 1, 4],   # 2 = Regular battle with "Call" instead of "Run"
00452:     [5, 7, 6, 3],   # 3 = Safari Zone
00453:     [0, 8, 1, 3]    # 4 = Bug-Catching Contest
00454:   ]
00455:   CMD_BUTTON_WIDTH_SMALL = 170
00456:   TEXT_BASE_COLOR   = Color.new(240, 248, 224)
00457:   TEXT_SHADOW_COLOR = Color.new(64, 64, 64)
00458: 
00459:   def initialize(viewport, z, sideSizes)
00460:     super(viewport)
00461:     @sideSizes = sideSizes
00462:     maxIndex = (@sideSizes[0] > @sideSizes[1]) ? (@sideSizes[0] - 1) * 2 : (@sideSizes[1] * 2) - 1
00463:     @smallButtons = (@sideSizes.max > 2)
00464:     self.x = 0
00465:     self.y = Graphics.height - 96
00466:     @texts = []
00467:     # NOTE: @mode is for which buttons are shown as selected.
00468:     #       0=select 1 button (@index), 1=select all buttons with text
00469:     # Create bitmaps
00470:     @buttonBitmap = AnimatedBitmap.new("Graphics/UI/Battle/cursor_target")
00471:     # Create target buttons
00472:     @buttons = Array.new(maxIndex + 1) do |i|
00473:       numButtons = @sideSizes[i % 2]
00474:       next if numButtons <= i / 2
00475:       # NOTE: Battler indices go from left to right from the perspective of
00476:       #       that side's trainer, so inc is different for each side for the
00477:       #       same value of i/2.
00478:       inc = (i.even?) ? i / 2 : numButtons - 1 - (i / 2)
00479:       button = Sprite.new(viewport)
00480:       button.bitmap = @buttonBitmap.bitmap
00481:       button.src_rect.width  = (@smallButtons) ? CMD_BUTTON_WIDTH_SMALL : @buttonBitmap.width / 2
00482:       button.src_rect.height = BUTTON_HEIGHT
00483:       if @smallButtons
00484:         button.x    = self.x + 170 - [0, 82, 166][numButtons - 1]
00485:       else
00486:         button.x    = self.x + 138 - [0, 116][numButtons - 1]
00487:       end
00488:       button.x += (button.src_rect.width - 4) * inc
00489:       button.y = self.y + 6
00490:       button.y += (BUTTON_HEIGHT - 4) * ((i + 1) % 2)
00491:       addSprite("button_#{i}", button)
00492:       next button
00493:     end
00494:     # Create overlay (shows target names)
00495:     @overlay = BitmapSprite.new(Graphics.width, Graphics.height - self.y, viewport)
00496:     @overlay.x = self.x
00497:     @overlay.y = self.y
00498:     pbSetNarrowFont(@overlay.bitmap)
00499:     addSprite("overlay", @overlay)
00500:     self.z = z
00501:     refresh
00502:   end
00503: 
00504:   def dispose
00505:     super
00506:     @buttonBitmap&.dispose
00507:   end
00508: 
00509:   def z=(value)
00510:     super
00511:     @overlay.z += 5 if @overlay
00512:   end
00513: 
00514:   def setDetails(texts, mode)
00515:     @texts = texts
00516:     @mode  = mode
00517:     refresh
00518:   end
