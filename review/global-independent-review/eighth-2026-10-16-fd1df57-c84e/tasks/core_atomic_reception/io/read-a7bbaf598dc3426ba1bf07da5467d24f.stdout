00001: # These are in-battle terrain effects caused by moves like Electric Terrain.
00002: module GameData
00003:   class BattleTerrain
00004:     attr_reader :id
00005:     attr_reader :real_name
00006:     attr_reader :animation
00007: 
00008:     DATA = {}
00009: 
00010:     extend ClassMethodsSymbols
00011:     include InstanceMethods
00012: 
00013:     def self.load; end
00014:     def self.save; end
00015: 
00016:     def initialize(hash)
00017:       @id        = hash[:id]
00018:       @real_name = hash[:name] || "Unnamed"
00019:       @animation = hash[:animation]
00020:     end
00021: 
00022:     # @return [String] the translated name of this battle terrain
00023:     def name
00024:       return _INTL(@real_name)
00025:     end
00026:   end
00027: end
00028: 
00029: #===============================================================================
00030: 
00031: GameData::BattleTerrain.register({
00032:   :id   => :None,
00033:   :name => _INTL("None")
00034: })
00035: 
00036: GameData::BattleTerrain.register({
00037:   :id        => :Electric,
00038:   :name      => _INTL("Electric"),
00039:   :animation => "ElectricTerrain"
00040: })
00041: 
00042: GameData::BattleTerrain.register({
00043:   :id        => :Grassy,
00044:   :name      => _INTL("Grassy"),
00045:   :animation => "GrassyTerrain"
00046: })
00047: 
00048: GameData::BattleTerrain.register({
00049:   :id        => :Misty,
00050:   :name      => _INTL("Misty"),
00051:   :animation => "MistyTerrain"
00052: })
00053: 
00054: GameData::BattleTerrain.register({
00055:   :id        => :Psychic,
00056:   :name      => _INTL("Psychic"),
00057:   :animation => "PsychicTerrain"
00058: })
