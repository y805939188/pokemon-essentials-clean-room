00075:   def pbContinualAbilityChecks(onSwitchIn = false)
00076:     # Check for end of primordial weather
00077:     @battle.pbEndPrimordialWeather
00078:     # Trace
00079:     if hasActiveAbility?(:TRACE)
00080:       # NOTE: In Gen 5 only, Trace only triggers upon the Trace bearer switching
00081:       #       in and not at any later times, even if a traceable ability turns
00082:       #       up later. Essentials ignores this, and allows Trace to trigger
00083:       #       whenever it can even in Gen 5 battle mechanics.
00084:       choices = @battle.allOtherSideBattlers(@index).select do |b|
00085:         next !b.ungainableAbility? &&
00086:              ![:POWEROFALCHEMY, :RECEIVER, :TRACE].include?(b.ability_id)
00087:       end
00088:       if choices.length > 0
00089:         choice = choices[@battle.pbRandom(choices.length)]
00090:         @battle.pbShowAbilitySplash(self)
00091:         self.ability = choice.ability
00092:         @battle.pbDisplay(_INTL("{1} traced {2}'s {3}!", pbThis, choice.pbThis(true), choice.abilityName))
00093:         @battle.pbHideAbilitySplash(self)
00094:         if !onSwitchIn && (unstoppableAbility? || abilityActive?)
00095:           Battle::AbilityEffects.triggerOnSwitchIn(self.ability, self, @battle)
00096:         end
00097:       end
00098:     end
00099:   end
00100: 
00101:   #=============================================================================
