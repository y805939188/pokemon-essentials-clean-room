01382: #===============================================================================
01383: # Type depends on the user's held Plate. (Judgment)
01384: #===============================================================================
01385: class Battle::Move::TypeDependsOnUserPlate < Battle::Move
01386:   def initialize(battle, move)
01387:     super
01388:     @itemTypes = {
01389:       :FISTPLATE   => :FIGHTING,
01390:       :SKYPLATE    => :FLYING,
01391:       :TOXICPLATE  => :POISON,
01392:       :EARTHPLATE  => :GROUND,
01393:       :STONEPLATE  => :ROCK,
01394:       :INSECTPLATE => :BUG,
01395:       :SPOOKYPLATE => :GHOST,
01396:       :IRONPLATE   => :STEEL,
01397:       :FLAMEPLATE  => :FIRE,
01398:       :SPLASHPLATE => :WATER,
01399:       :MEADOWPLATE => :GRASS,
01400:       :ZAPPLATE    => :ELECTRIC,
01401:       :MINDPLATE   => :PSYCHIC,
01402:       :ICICLEPLATE => :ICE,
01403:       :DRACOPLATE  => :DRAGON,
01404:       :DREADPLATE  => :DARK,
01405:       :PIXIEPLATE  => :FAIRY
01406:     }
01407:   end
01408: 
01409:   def pbBaseType(user)
01410:     ret = :NORMAL
01411:     if user.item_id && user.itemActive?
01412:       typ = @itemTypes[user.item_id]
01413:       ret = typ if typ && GameData::Type.exists?(typ)
01414:     end
01415:     return ret
01416:   end
01417: end
