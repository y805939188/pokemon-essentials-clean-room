01333: 
01334: #===============================================================================
01335: # Power and type depend on the user's held berry. Destroys the berry.
01336: # (Natural Gift)
01337: #===============================================================================
01338: class Battle::Move::TypeAndPowerDependOnUserBerry < Battle::Move
01339:   def pbMoveFailed?(user, targets)
01340:     # NOTE: Unnerve does not stop a Pokémon using this move.
01341:     item = user.item
01342:     if !item || !item.is_berry? || !user.itemActive? ||
01343:        item.flags.none? { |f| f[/^NaturalGift_/i] }
01344:       @battle.pbDisplay(_INTL("But it failed!"))
01345:       return true
01346:     end
01347:     return false
01348:   end
01349: 
01350:   def pbBaseType(user)
01351:     ret = :NORMAL
01352:     item = user.item
01353:     if item
01354:       item.flags.each do |flag|
01355:         next if !flag[/^NaturalGift_(\w+)_(?:\d+)$/i]
01356:         typ = $~[1].to_sym
01357:         ret = typ if GameData::Type.exists?(typ)
01358:         break
01359:       end
01360:     end
01361:     return ret
01362:   end
01363: 
01364:   def pbBaseDamage(baseDmg, user, target)
01365:     if user.item.id
01366:       GameData::Item.get(user.item.id).flags.each do |flag|
01367:         return [$~[1].to_i, 10].max if flag[/^NaturalGift_(?:\w+)_(\d+)$/i]
01368:       end
01369:     end
01370:     return 1
01371:   end
01372: 
01373:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
01374:     # NOTE: The item is consumed even if this move was Protected against or it
01375:     #       missed. The item is not consumed if the target was switched out by
01376:     #       an effect like a target's Red Card.
01377:     # NOTE: There is no item consumption animation.
01378:     user.pbConsumeItem(true, true, false) if user.item
01379:   end
01380: end
