01433:       :STEELMEMORY    => :STEEL,
01434:       :FIREMEMORY     => :FIRE,
01435:       :WATERMEMORY    => :WATER,
01436:       :GRASSMEMORY    => :GRASS,
01437:       :ELECTRICMEMORY => :ELECTRIC,
01438:       :PSYCHICMEMORY  => :PSYCHIC,
01439:       :ICEMEMORY      => :ICE,
01440:       :DRAGONMEMORY   => :DRAGON,
01441:       :DARKMEMORY     => :DARK,
01442:       :FAIRYMEMORY    => :FAIRY
