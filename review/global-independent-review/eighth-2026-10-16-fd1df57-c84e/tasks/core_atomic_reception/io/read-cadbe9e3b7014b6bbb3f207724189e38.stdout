00880: )
00881: 
00882: #===============================================================================
00883: # MoveBlocking handlers
00884: #===============================================================================
00885: 
00886: Battle::AbilityEffects::MoveBlocking.add(:DAZZLING,
00887:   proc { |ability, bearer, user, targets, move, battle|
00888:     next false if battle.choices[user.index][4] <= 0
00889:     next false if !bearer.opposes?(user)
00890:     ret = false
00891:     targets.each { |b| ret = true if b.opposes?(user) }
00892:     next ret
00893:   }
00894: )
00895: 
00896: Battle::AbilityEffects::MoveBlocking.copy(:DAZZLING, :QUEENLYMAJESTY)
00897: 
