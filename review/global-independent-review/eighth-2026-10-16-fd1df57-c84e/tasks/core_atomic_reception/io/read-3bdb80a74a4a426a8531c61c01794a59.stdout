00498: 
00499:   def airborne?
00500:     return false if hasActiveItem?(:IRONBALL)
00501:     return false if @effects[PBEffects::Ingrain]
00502:     return false if @effects[PBEffects::SmackDown]
00503:     return false if @battle.field.effects[PBEffects::Gravity] > 0
00504:     return true if pbHasType?(:FLYING)
00505:     return true if hasActiveAbility?(:LEVITATE) && !@battle.moldBreaker
00506:     return true if hasActiveItem?(:AIRBALLOON)
00507:     return true if @effects[PBEffects::MagnetRise] > 0
00508:     return true if @effects[PBEffects::Telekinesis] > 0
00509:     return false
00510:   end
00511: 
00512:   def affectedByTerrain?
00513:     return false if airborne?
00514:     return false if semiInvulnerable?
00515:     return true
00516:   end
00517: 
00518:   def takesIndirectDamage?(showMsg = false)
00519:     return false if fainted?
00520:     if hasActiveAbility?(:MAGICGUARD)
00521:       if showMsg
00522:         @battle.pbShowAbilitySplash(self)
00523:         if Battle::Scene::USE_ABILITY_SPLASH
00524:           @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis))
00525:         else
00526:           @battle.pbDisplay(_INTL("{1} is unaffected because of its {2}!", pbThis, abilityName))
00527:         end
00528:         @battle.pbHideAbilitySplash(self)
00529:       end
00530:       return false
00531:     end
00532:     return true
00533:   end
00534: 
00535:   def takesSandstormDamage?
00536:     return false if !takesIndirectDamage?
00537:     return false if pbHasType?(:GROUND) || pbHasType?(:ROCK) || pbHasType?(:STEEL)
00538:     return false if inTwoTurnAttack?("TwoTurnAttackInvulnerableUnderground",
00539:                                      "TwoTurnAttackInvulnerableUnderwater")
00540:     return false if hasActiveAbility?([:OVERCOAT, :SANDFORCE, :SANDRUSH, :SANDVEIL])
00541:     return false if hasActiveItem?(:SAFETYGOGGLES)
00542:     return true
00543:   end
00544: 
00545:   def takesHailDamage?
00546:     return false if !takesIndirectDamage?
00547:     return false if pbHasType?(:ICE)
00548:     return false if inTwoTurnAttack?("TwoTurnAttackInvulnerableUnderground",
00549:                                      "TwoTurnAttackInvulnerableUnderwater")
00550:     return false if hasActiveAbility?([:OVERCOAT, :ICEBODY, :SNOWCLOAK])
00551:     return false if hasActiveItem?(:SAFETYGOGGLES)
00552:     return true
00553:   end
00554: 
00555:   def takesShadowSkyDamage?
00556:     return false if !takesIndirectDamage?
00557:     return false if shadowPokemon?
00558:     return true
00559:   end
00560: 
00561:   def effectiveWeather
00562:     ret = @battle.pbWeather
00563:     ret = :None if [:Sun, :Rain, :HarshSun, :HeavyRain].include?(ret) && hasActiveItem?(:UTILITYUMBRELLA)
00564:     return ret
00565:   end
00566: 
00567:   def affectedByPowder?(showMsg = false)
00568:     return false if fainted?
00569:     if pbHasType?(:GRASS) && Settings::MORE_TYPE_EFFECTS
00570:       @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis)) if showMsg
00571:       return false
00572:     end
00573:     if Settings::MECHANICS_GENERATION >= 6
00574:       if hasActiveAbility?(:OVERCOAT) && !@battle.moldBreaker
00575:         if showMsg
00576:           @battle.pbShowAbilitySplash(self)
00577:           if Battle::Scene::USE_ABILITY_SPLASH
00578:             @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis))
00579:           else
00580:             @battle.pbDisplay(_INTL("{1} is unaffected because of its {2}!", pbThis, abilityName))
00581:           end
00582:           @battle.pbHideAbilitySplash(self)
00583:         end
00584:         return false
00585:       end
00586:       if hasActiveItem?(:SAFETYGOGGLES)
00587:         if showMsg
00588:           @battle.pbDisplay(_INTL("{1} is unaffected because of its {2}!", pbThis, itemName))
00589:         end
00590:         return false
00591:       end
00592:     end
00593:     return true
00594:   end
00595: 
00596:   def canHeal?
00597:     return false if fainted? || @hp >= @totalhp
00598:     return false if @effects[PBEffects::HealBlock] > 0
00599:     return true
00600:   end
00601: 
00602:   def affectedByContactEffect?(showMsg = false)
00603:     return false if fainted?
00604:     if hasActiveItem?(:PROTECTIVEPADS)
00605:       @battle.pbDisplay(_INTL("{1} protected itself with the {2}!", pbThis, itemName)) if showMsg
