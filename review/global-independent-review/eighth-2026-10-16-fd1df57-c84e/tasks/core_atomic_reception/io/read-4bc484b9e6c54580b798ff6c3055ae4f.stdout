00336:   def pbSwapBattlerSprites(idxA, idxB)
00337:     @sprites["pokemon_#{idxA}"], @sprites["pokemon_#{idxB}"] = @sprites["pokemon_#{idxB}"], @sprites["pokemon_#{idxA}"]
00338:     @sprites["shadow_#{idxA}"], @sprites["shadow_#{idxB}"] = @sprites["shadow_#{idxB}"], @sprites["shadow_#{idxA}"]
00339:     @lastCmd[idxA], @lastCmd[idxB] = @lastCmd[idxB], @lastCmd[idxA]
00340:     @lastMove[idxA], @lastMove[idxB] = @lastMove[idxB], @lastMove[idxA]
00341:     [idxA, idxB].each do |i|
00342:       @sprites["pokemon_#{i}"].index = i
00343:       @sprites["pokemon_#{i}"].pbSetPosition
00344:       @sprites["shadow_#{i}"].index = i
00345:       @sprites["shadow_#{i}"].pbSetPosition
00346:       @sprites["dataBox_#{i}"].battler = @battle.battlers[i]
00347:     end
00348:     pbRefresh
00349:   end
00350: 
00351:   #=============================================================================
00352:   # Phases
00353:   #=============================================================================
00354:   def pbBeginCommandPhase
00355:     @sprites["messageWindow"].text = ""
00356:   end
00357: 
00358:   def pbBeginAttackPhase
00359:     pbSelectBattler(-1)
00360:     pbShowWindow(MESSAGE_BOX)
00361:   end
00362: 
00363:   def pbBeginEndOfRoundPhase; end
00364: 
00365:   def pbEndBattle(_result)
00366:     @abortable = false
00367:     pbShowWindow(BLANK)
00368:     # Fade out all sprites
00369:     pbBGMFade(1.0)
00370:     pbFadeOutAndHide(@sprites)
00371:     pbDisposeSprites
00372:   end
00373: 
