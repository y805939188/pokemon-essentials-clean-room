00206:       next if addition == 0
00207:       @ev[s.id] += addition
00208:       total += addition
00209:     end
00210:   end
00211: 
00212:   alias __shadow_clone clone unless method_defined?(:__shadow_clone)
00213:   def clone
00214:     ret = __shadow_clone
00215:     if @saved_ev
00216:       GameData::Stat.each_main { |s| ret.saved_ev[s.id] = @saved_ev[s.id] }
00217:     end
00218:     ret.shadow_moves = @shadow_moves.clone if @shadow_moves
00219:     return ret
00220:   end
00221: end
