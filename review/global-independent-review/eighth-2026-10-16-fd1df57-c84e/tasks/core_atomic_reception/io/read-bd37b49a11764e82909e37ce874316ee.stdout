00101:   #=============================================================================
00102:   # Move PP
00103:   #=============================================================================
00104:   def pbSetPP(move, pp)
00105:     move.pp = pp
00106:     # No need to care about @effects[PBEffects::Mimic], since Mimic can't copy
00107:     # Mimic
00108:     if move.realMove && move.id == move.realMove.id && !@effects[PBEffects::Transform]
00109:       move.realMove.pp = pp
00110:     end
00111:   end
00112: 
00113:   def pbReducePP(move)
00114:     return true if usingMultiTurnAttack?
00115:     return true if move.pp < 0          # Don't reduce PP for special calls of moves
00116:     return true if move.total_pp <= 0   # Infinite PP, can always be used
00117:     return false if move.pp == 0        # Ran out of PP, couldn't reduce
00118:     pbSetPP(move, move.pp - 1) if move.pp > 0
00119:     return true
00120:   end
00121: 
00122:   def pbReducePPOther(move)
00123:     pbSetPP(move, move.pp - 1) if move.pp > 0
00124:   end
00125: 
00126:   #=============================================================================
00127:   # Change type
00128:   #=============================================================================
00129:   def pbChangeTypes(newType)
00130:     if newType.is_a?(Battle::Battler)
00131:       newTypes = newType.pbTypes
00132:       newTypes.push(:NORMAL) if newTypes.length == 0
00133:       newExtraType = newType.effects[PBEffects::ExtraType]
00134:       newExtraType = nil if newTypes.include?(newExtraType)
00135:       @types = newTypes.clone
00136:       @effects[PBEffects::ExtraType] = newExtraType
00137:     else
00138:       newType = GameData::Type.get(newType).id
00139:       @types = [newType]
00140:       @effects[PBEffects::ExtraType] = nil
00141:     end
00142:     @effects[PBEffects::BurnUp] = false
00143:     @effects[PBEffects::Roost]  = false
00144:   end
00145: 
00146:   def pbResetTypes
00147:     @types = @pokemon.types
00148:     @effects[PBEffects::ExtraType] = nil
00149:     @effects[PBEffects::BurnUp] = false
00150:     @effects[PBEffects::Roost]  = false
00151:   end
00152: 
00153:   #=============================================================================
00154:   # Forms
00155:   #=============================================================================
00156:   def pbChangeForm(newForm, msg)
00157:     return if fainted? || @effects[PBEffects::Transform] || @form == newForm
00158:     oldForm = @form
00159:     oldDmg = @totalhp - @hp
00160:     self.form = newForm
00161:     pbUpdate(true)
00162:     @hp = @totalhp - oldDmg
00163:     @effects[PBEffects::WeightChange] = 0 if Settings::MECHANICS_GENERATION >= 6
00164:     @battle.scene.pbChangePokemon(self, @pokemon)
00165:     @battle.scene.pbRefreshOne(@index)
00166:     @battle.pbDisplay(msg) if msg && msg != ""
00167:     PBDebug.log("[Form changed] #{pbThis} changed from form #{oldForm} to form #{newForm}")
00168:     @battle.pbSetSeen(self)
00169:   end
00170: 
00171:   def pbCheckFormOnStatusChange
00172:     return if fainted? || @effects[PBEffects::Transform]
00173:     # Shaymin - reverts if frozen
00174:     if isSpecies?(:SHAYMIN) && frozen?
00175:       pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00176:     end
00177:   end
00178: 
00179:   def pbCheckFormOnMovesetChange
00180:     return if fainted? || @effects[PBEffects::Transform]
00181:     # Keldeo - knowing Secret Sword
00182:     if isSpecies?(:KELDEO)
00183:       newForm = 0
00184:       newForm = 1 if pbHasMove?(:SECRETSWORD)
00185:       pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00186:     end
00187:   end
00188: 
00189:   def pbCheckFormOnWeatherChange(ability_changed = false)
00190:     return if fainted? || @effects[PBEffects::Transform]
00191:     # Castform - Forecast
00192:     if isSpecies?(:CASTFORM)
00193:       if hasActiveAbility?(:FORECAST)
00194:         newForm = 0
00195:         case effectiveWeather
00196:         when :Sun, :HarshSun   then newForm = 1
00197:         when :Rain, :HeavyRain then newForm = 2
00198:         when :Hail             then newForm = 3
00199:         end
00200:         if @form != newForm
00201:           @battle.pbShowAbilitySplash(self, true)
00202:           @battle.pbHideAbilitySplash(self)
00203:           pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00204:         end
00205:       else
00206:         pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00207:       end
00208:     end
00209:     # Cherrim - Flower Gift
00210:     if isSpecies?(:CHERRIM)
00211:       if hasActiveAbility?(:FLOWERGIFT)
00212:         newForm = 0
00213:         newForm = 1 if [:Sun, :HarshSun].include?(effectiveWeather)
00214:         if @form != newForm
00215:           @battle.pbShowAbilitySplash(self, true)
00216:           @battle.pbHideAbilitySplash(self)
00217:           pbChangeForm(newForm, _INTL("{1} transformed!", pbThis))
00218:         end
00219:       else
00220:         pbChangeForm(0, _INTL("{1} transformed!", pbThis))
00221:       end
00222:     end
00223:     # Eiscue - Ice Face
00224:     if !ability_changed && isSpecies?(:EISCUE) && self.ability == :ICEFACE &&
00225:        @form == 1 && effectiveWeather == :Hail
00226:       @canRestoreIceFace = true   # Changed form at end of round
00227:     end
00228:   end
00229: 
00230:   # Checks the Pokémon's form and updates it if necessary. Used for when a
00231:   # Pokémon enters battle (endOfRound=false) and at the end of each round
00232:   # (endOfRound=true).
00233:   def pbCheckForm(endOfRound = false)
00234:     return if fainted? || @effects[PBEffects::Transform]
00235:     # Form changes upon entering battle and when the weather changes
00236:     pbCheckFormOnWeatherChange if !endOfRound
00237:     # Darmanitan - Zen Mode
00238:     if isSpecies?(:DARMANITAN) && self.ability == :ZENMODE
00239:       if @hp <= @totalhp / 2
00240:         if @form.even?
00241:           @battle.pbShowAbilitySplash(self, true)
00242:           @battle.pbHideAbilitySplash(self)
00243:           pbChangeForm(@form + 1, _INTL("{1} triggered!", abilityName))
00244:         end
00245:       elsif @form.odd?
00246:         @battle.pbShowAbilitySplash(self, true)
00247:         @battle.pbHideAbilitySplash(self)
00248:         pbChangeForm(@form - 1, _INTL("{1} triggered!", abilityName))
00249:       end
00250:     end
00251:     # Minior - Shields Down
00252:     if isSpecies?(:MINIOR) && self.ability == :SHIELDSDOWN
00253:       if @hp > @totalhp / 2   # Turn into Meteor form
00254:         newForm = (@form >= 7) ? @form - 7 : @form
00255:         if @form != newForm
00256:           @battle.pbShowAbilitySplash(self, true)
00257:           @battle.pbHideAbilitySplash(self)
00258:           pbChangeForm(newForm, _INTL("{1} deactivated!", abilityName))
00259:         end
00260:       elsif @form < 7   # Turn into Core form
00261:         @battle.pbShowAbilitySplash(self, true)
00262:         @battle.pbHideAbilitySplash(self)
00263:         pbChangeForm(@form + 7, _INTL("{1} activated!", abilityName))
00264:       end
00265:     end
00266:     # Wishiwashi - Schooling
00267:     if isSpecies?(:WISHIWASHI) && self.ability == :SCHOOLING
00268:       if @level >= 20 && @hp > @totalhp / 4
00269:         if @form != 1
00270:           @battle.pbShowAbilitySplash(self, true)
00271:           @battle.pbHideAbilitySplash(self)
00272:           pbChangeForm(1, _INTL("{1} formed a school!", pbThis))
00273:         end
00274:       elsif @form != 0
00275:         @battle.pbShowAbilitySplash(self, true)
00276:         @battle.pbHideAbilitySplash(self)
00277:         pbChangeForm(0, _INTL("{1} stopped schooling!", pbThis))
00278:       end
00279:     end
00280:     # Zygarde - Power Construct
00281:     if isSpecies?(:ZYGARDE) && self.ability == :POWERCONSTRUCT && endOfRound &&
00282:        @hp <= @totalhp / 2 && @form < 2   # Turn into Complete Forme
00283:       newForm = @form + 2
00284:       @battle.pbDisplay(_INTL("You sense the presence of many!"))
00285:       @battle.pbShowAbilitySplash(self, true)
00286:       @battle.pbHideAbilitySplash(self)
00287:       pbChangeForm(newForm, _INTL("{1} transformed into its Complete Forme!", pbThis))
00288:     end
00289:     # Morpeko - Hunger Switch
00290:     if isSpecies?(:MORPEKO) && hasActiveAbility?(:HUNGERSWITCH) && endOfRound
00291:       # Intentionally doesn't show the ability splash or a message
00292:       newForm = (@form + 1) % 2
00293:       pbChangeForm(newForm, nil)
00294:     end
00295:   end
00296: 
00297:   def pbTransform(target)
00298:     oldAbil = @ability_id
00299:     @effects[PBEffects::Transform]        = true
00300:     @effects[PBEffects::TransformSpecies] = target.species
00301:     pbChangeTypes(target)
00302:     self.ability = target.ability
00303:     @attack  = target.attack
00304:     @defense = target.defense
00305:     @spatk   = target.spatk
00306:     @spdef   = target.spdef
00307:     @speed   = target.speed
00308:     GameData::Stat.each_battle { |s| @stages[s.id] = target.stages[s.id] }
00309:     if Settings::NEW_CRITICAL_HIT_RATE_MECHANICS
00310:       @effects[PBEffects::FocusEnergy] = target.effects[PBEffects::FocusEnergy]
00311:       @effects[PBEffects::LaserFocus]  = target.effects[PBEffects::LaserFocus]
00312:     end
00313:     @moves.clear
00314:     target.moves.each_with_index do |m, i|
00315:       @moves[i] = Battle::Move.from_pokemon_move(@battle, Pokemon::Move.new(m.id))
00316:       @moves[i].pp       = 5
00317:       @moves[i].total_pp = 5
00318:     end
00319:     @effects[PBEffects::Disable]      = 0
00320:     @effects[PBEffects::DisableMove]  = nil
00321:     @effects[PBEffects::WeightChange] = target.effects[PBEffects::WeightChange]
00322:     @battle.scene.pbRefreshOne(@index)
00323:     @battle.pbDisplay(_INTL("{1} transformed into {2}!", pbThis, target.pbThis(true)))
00324:     pbOnLosingAbility(oldAbil)
00325:   end
00326: 
00327:   def pbHyperMode; end
00328: end
