00071:   ],
00072:   "facts": [
00073:     {
00074:       "id": "CAA-LIFE-D01",
00075:       "meaning": "DayCare.initialize creates2 slots and resets egg_generated=false/step_counter0, then captures DAY_CARE_POKEMON_GAIN_EXP_FROM_WALKING and DAY_CARE_POKEMON_CAN_SHARE_EGG_MOVES settings into mutable attributes. Later setting changes alone do not replace captured attributes.",
00076:       "source_units": [
00077:         "DayCare329–335"
00078:       ]
00079:     },
00080:     {
00081:       "id": "CAA-LIFE-D02",
00082:       "meaning": "DayCare.deposit increments stats.day_care_deposits before fetching Pokemon or checking capacity. Empty index or no free slot raises after increment. Free slot.deposit first assigns original same Pokemon reference, heals, optionally SHAYMIN form=0 then captures level; only after normal slot completion wrapper deletes original party index and resets egg counters. No last-able/egg/cannot_store guard in this wrapper. Earlier failure may leave both slot and party referencing same object.",
00083:       "source_units": [
00084:         "DayCare273–278",
00085:         "DayCare437–450"
00086:       ]
00087:     },
00088:     {
00089:       "id": "CAA-LIFE-D03",
00090:       "meaning": "withdraw validates filled slot then party not full; increments day_care_levels_gained by actual level_gain, pushes same slot Pokemon then slot.reset and counter reset. It does not invoke heal. A later exception preserves earlier counter/append prefix. No payment deduction here; slot.cost returns(level_gain+1)*100 separately.",
00091:       "source_units": [
00092:         "DayCare287–297",
00093:         "DayCare452–464"
00094:       ]
00095:     },
00096:     {
00097:       "id": "CAA-LIFE-D04",
00098:       "meaning": "update_on_step_taken increments step_counter; >=256 resets0, if no current egg and2 members checks compatibility chance[0,20,50,70] or Oval[0,40,80,88] and rand100. Sharing then has separate mutable share flag and rand100<50. gain_exp flag independently iterates slots every step, including steps without egg check.",
00099:       "source_units": [
00100:         "DayCare386–407"
00101:       ]
00102:     },
00103:     {
00104:       "id": "CAA-LIFE-D05",
00105:       "meaning": "Slot.add_exp returns if empty or current exp>=maximum. It stores old_level then pokemon.exp += amount without its own clamp. If new level differs, calc and learn every move whose level equals final newlevel. Ordinary source+1 walking givesbounded increment; arbitrary public amount may crossmultiple levels without learning skippedlevels. Shadow exp= redirects delta to saved_exp and leaves current exp/cache, so ordinary level change consequence not universal.",
00106:       "source_units": [
00107:         "DayCare308–318",
00108:         "PokemonShadow13–20"
00109:       ]
00110:     },
00111:     {
00112:       "id": "CAA-LIFE-D06",
00113:       "meaning": "EggGenerator basic Pokemon.new(species,EGG_LEVEL) completes constructor/form recheck before assigning Egg name/positivehatchsteps/obtaintext/happiness120. SINISTEA forcesform0 and getFormOnEggCreation optionalform= then parent inheritance can form= again after eggflag, so Pokedex register is possible for eggs and samevalueform. No generic no-seen guarantee from egg wrapper.",
00114:       "source_units": [
00115:         "DayCare1–89",
00116:         "Pokemon1128–1227"
00117:       ]
00118:     },
00119:     {
00120:       "id": "CAA-LIFE-D07",
00121:       "meaning": "EggGenerator inheritance uses raw parent IVs, nature from Everstone holder, mother/nonDitto ability rules, deduplicated latest moves including configured father machine/mother egg paths. It uses owner.language difference for extra shiny retries (>=8:6, earlier5) and Charm2, resets shiny=nil before PID rerolls. Pokemon.foreign? is not Masuda gate. Pokerus separate chance; final calc does not change raw IV used for inheritance.",
00122:       "source_units": [
00123:         "DayCare89–258"
00124:       ]
00125:     },
00126:     {
00127:       "id": "CAA-LIFE-D08",
00128:       "meaning": "share_egg_move requires exactly2 members and samebase species, free move space, legal eggmove not already known. Ifboth learners possible randomly choose one; uses first eligible knownmove for selected learner then learn_move, no first_moves addition. compatibility rejects Shadow/Undiscovered; intersectEggGroup or Ditto and compatiblegender then score1+sameSpecies+differentOwnerID.",
00129:       "source_units": [
00130:         "DayCare360–384",
00131:         "DayCare501–551"
00132:       ]
00133:     },
00134:     {
00135:       "id": "CAA-LIFE-D09",
00136:       "meaning": "collect_egg first day_care.generate_egg (returnsnil unless2 members), then raisesifnil, then checks player.party_full?. Thus constructor/form/cache/globaldex writes can occur before full-party rejection. Normal pushes generatedegg and resets counters. It has no own egg_generated flag guard and does not increment eggs_hatched.",
00137:       "source_units": [
00138:         "DayCare354–358",
00139:         "DayCare488–496"
00140:       ]
00141:     },
00142:     {
00143:       "id": "CAA-LIFE-E01",
00144:       "meaning": "Evolution animation cancel increments evolutions_cancelled, normal success increments evolution_count before cry/media/message and before species commit. Success invokes action_after_evolution first, then records wasfainted, species=, explicit hp0 ifwasfainted, calc, readyfalse, then dex register/owned. Later resource/handler failure preserves reached count/model/dex prefix. Learnedmove cancellation after commit does not undo evolution.",
00145:       "source_units": [
00146:         "EvolutionUI112–136",
00147:         "EvolutionUI195–244"
00148:       ]
00149:     },
00150:     {
00151:       "id": "CAA-LIFE-E02",
00152:       "meaning": "Evolution.newspecies Dex prompt gate SHOW_NEW_SPECIES_POKEDEX_ENTRY_MORE_OFTEN && !was_owned && player.has_pokedex && unlocked membership; no see_form flag. Inside message then register_last_seen then EntryUI. It gathers moves at0 or finallevel then learns after the prompt; entry failure can prevent later learn while species/dex alreadywritten.",
00153:       "source_units": [
00154:         "EvolutionUI222–244"
00155:       ]
00156:     },
00157:     {
00158:       "id": "CAA-LIFE-E03",
00159:       "meaning": "pbDuplicatePokemon clones Pokemon, then species=, name=nil, markings=[],ballPOKEBALL,itemnil,clearAllRibbons,calc,heal,pushparty,dexregister,setowned in that order. Plainclone already makesribbons new array, so clearAllRibbons does not clearoriginal ribbons; sharedmail is not explicitly cleared byduplicate and later getter may invalidate only clone reference. Shedinja after_evolution_proc checks partyfull thenbagPOKEBALL, callsduplicate, removesball thentrue; noensure rollback for later failure.",
00160:       "source_units": [
00161:         "EvolutionUI5–21",
00162:         "Evolution265–277",
00163:         "Pokemon1135–1150"
00164:       ]
00165:     },
00166:     {
00167:       "id": "CAA-LIFE-C01",
00168:       "meaning": "Shadow clone invokes plainclone then, ifsaved_ev exists, writes samevalues through ret.saved_ev with no newhash allocation; it remains shared. shadow_moves list iscloned. Setting clone.saved_ev=nil duringpurify only detachesclone; directitem mutation beforedetach writes both. Default Shadow doesnot overrideheal_status; hp= callsbasehp= then clearsrawhyperifhp<=0.",
00169:       "source_units": [
00170:         "PokemonShadow13–26",
00171:         "PokemonShadow212–220"
00172:       ]
00173:     },
00174:     {
00175:       "id": "CAA-LIFE-DBG01",
00176:       "meaning": "Debug forget_move receives index then checks>=0 before dereference/delete; cancellation-1 leaves list unchanged, unlike direct Pokemon.forget_move_at_index(-1). Debug setPP/ppup wrappers clamp chosenrange, ppup reduction conditionally reducescurrentpp. These are UIguards, not lowerMove setters.",
00177:       "source_units": [
00178:         "Debug473–568"
00179:       ]
00180:     },
00181:     {
00182:       "id": "CAA-LIFE-DBG02",
00183:       "meaning": "Debug Owner either replacesOwner fromplayer or mutates currentOwner name/gender/id fields in place. ForeignID numeric selected0..65535 is val|(val<<16), not newcachedshiny calculation. cancelnegative menu breaks; noimplicitclearall caches or save. SharedOwner effects depend prior clone/alias construction, not this editor.",
00184:       "source_units": [
00185:         "Debug932–975"
00186:       ]
00187:     },
00188:     {
00189:       "id": "CAA-LIFE-DBG03",
00190:       "meaning": "Debug species/form reads ordinaryform for messages, specieschange sets species thencalc and optional !settingUpBattle&&!egg dexregister. Formchoice can set forced_form beforeform= afteroverrideconfirm; removeoverride only nil thenrefresh. Underlying form= globalregister may stillrun independently of caller extra dexguard.",
00191:       "source_units": [
00192:         "Debug739–815"
00193:       ]
00194:     },
00195:     {
00196:       "id": "CAA-LIFE-DBG04",
00197:       "meaning": "Debug hidden-values writesrawEV/IV thencalc/refresh. IndividualEV upper=min(EV_LIMIT-otherEV,EV_STAT_LIMIT), choosesdefaultmin(current,upper); randomizer zerosall thenallocates boundedincrements. pID randomize writesnew32bit thencalc without clearingcachednature/gender/shiny/ability. Debug discardable toggles eachcannot_store/release/trade separately.",
00198:       "source_units": [
00199:         "Debug209–319",
00200:         "Debug980–1003"
00201:       ]
00202:     },
00203:     {
00204:       "id": "CAA-LIFE-DBG05",
00205:       "meaning": "Debug status rejectsegg thenHP<=0; cureheal_status, otherstatus setscount afterstatus write (SLEEP positivechosen only; other0). Debug duplicate confirmfalse no clone; normalclone storedparty/box byactualscreentype thenhardrefresh; delete confirm then directpartydelete orsceneRelease+heldnil/storageDelete, noTrainer.remove otherable safeguard.",
00206:       "source_units": [
00207:         "Debug31–83",
00208:         "Debug1095–1151"
00209:       ]
00210:     }
00211:   ],
00212:   "common_premise": "Fixed R default definitions, actual source Ruby branches and valid ordinary dependency objects. All stated full source files actually read; Evolution data class only complete named partial units. Source-static only, random/native/UI/disk/event execution not performed. Actual Settings/Stats definitions remain kernel original responsibility; package only their concrete receiver contracts.",
00213:   "save_reload": "Existing KERNEL SAVE01–07 complete limited reception supplies top-level player/Pokedex/storage/global registration and load failure prefixes; this packet doesnot claim native multi-root identity/cycle roundtrip.",
00214:   "open": [
00215:     "all DayCare event/map/dialogue caller scripts and payment partychooser semantics beyond complete methods",
00216:     "all evolutionmethod families and actual species/PBS combinations, outside Shedinja finitecallback",
00217:     "all Debug editor listing/interactive native behavior and any plugin-added handlers"
00218:   ],
00219:   "global_approval": false,
00220:   "business": "NOT_EXECUTED",
