00471:   def pbEOREndTerrain
00472:     # Count down terrain duration
00473:     @field.terrainDuration -= 1 if @field.terrainDuration > 0
00474:     # Terrain wears off
00475:     if @field.terrain != :None && @field.terrainDuration == 0
00476:       case @field.terrain
00477:       when :Electric
00478:         pbDisplay(_INTL("The electric current disappeared from the battlefield!"))
00479:       when :Grassy
00480:         pbDisplay(_INTL("The grass disappeared from the battlefield!"))
00481:       when :Misty
00482:         pbDisplay(_INTL("The mist disappeared from the battlefield!"))
00483:       when :Psychic
00484:         pbDisplay(_INTL("The weirdness disappeared from the battlefield!"))
00485:       end
00486:       @field.terrain = :None
00487:       allBattlers.each { |battler| battler.pbAbilityOnTerrainChange }
00488:       # Start up the default terrain
00489:       if @field.defaultTerrain != :None
00490:         pbStartTerrain(nil, @field.defaultTerrain, false)
00491:         allBattlers.each { |battler| battler.pbAbilityOnTerrainChange }
00492:         allBattlers.each { |battler| battler.pbItemTerrainStatBoostCheck }
00493:       end
00494:       return if @field.terrain == :None
00495:     end
00496:     # Terrain continues
00497:     terrain_data = GameData::BattleTerrain.try_get(@field.terrain)
00498:     pbCommonAnimation(terrain_data.animation) if terrain_data
00499:     case @field.terrain
00500:     when :Electric then pbDisplay(_INTL("An electric current is running across the battlefield."))
00501:     when :Grassy   then pbDisplay(_INTL("Grass is covering the battlefield."))
00502:     when :Misty    then pbDisplay(_INTL("Mist is swirling about the battlefield."))
00503:     when :Psychic  then pbDisplay(_INTL("The battlefield is weird."))
00504:     end
00505:   end
