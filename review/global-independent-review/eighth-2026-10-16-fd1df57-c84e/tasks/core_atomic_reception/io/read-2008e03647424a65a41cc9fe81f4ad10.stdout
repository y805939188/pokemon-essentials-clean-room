00299:   #=============================================================================
00300:   # Effects upon a Pokémon entering battle
00301:   #=============================================================================
00302:   # Called at the start of battle only.
00303:   def pbOnAllBattlersEnteringBattle
00304:     pbCalculatePriority(true)
00305:     battler_indices = []
00306:     allBattlers.each { |b| battler_indices.push(b.index) }
00307:     pbOnBattlerEnteringBattle(battler_indices)
00308:     pbCalculatePriority
00309:     # Check forms are correct
00310:     allBattlers.each { |b| b.pbCheckForm }
00311:   end
00312: 
00313:   # Called when one or more Pokémon switch in. Does a lot of things, including
00314:   # entry hazards, form changes and items/abilities that trigger upon switching
