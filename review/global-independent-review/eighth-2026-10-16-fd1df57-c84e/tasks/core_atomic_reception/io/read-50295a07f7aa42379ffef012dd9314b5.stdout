00001: #===============================================================================
00002: # This script modifies the battle system to implement battle rules
00003: #===============================================================================
00004: class Battle
00005:   unless @__clauses__aliased
00006:     alias __clauses__pbDecisionOnDraw pbDecisionOnDraw
00007:     alias __clauses__pbEndOfRoundPhase pbEndOfRoundPhase
00008:     @__clauses__aliased = true
00009:   end
00010: 
00011:   def pbDecisionOnDraw
00012:     if @rules["selfkoclause"]
00013:       if self.lastMoveUser < 0
00014:         # in extreme cases there may be no last move user
00015:         return 5   # game is a draw
00016:       elsif opposes?(self.lastMoveUser)
00017:         return 2   # loss
00018:       else
00019:         return 1   # win
00020:       end
00021:     end
00022:     return __clauses__pbDecisionOnDraw
00023:   end
00024: 
00025:   def pbJudgeCheckpoint(user, move = nil)
00026:     if pbAllFainted?(0) && pbAllFainted?(1)
00027:       if @rules["drawclause"]   # NOTE: Also includes Life Orb (not implemented)
00028:         if !(move && move.function_code == "HealUserByHalfOfDamageDone")
00029:           # Not a draw if fainting occurred due to Liquid Ooze
00030:           @decision = (user.opposes?) ? 1 : 2   # win / loss
00031:         end
00032:       elsif @rules["modifiedselfdestructclause"]
00033:         if move && move.function_code == "UserFaintsExplosive"   # Self-Destruct
00034:           @decision = (user.opposes?) ? 1 : 2   # win / loss
00035:         end
00036:       end
00037:     end
00038:   end
00039: 
00040:   def pbEndOfRoundPhase
00041:     __clauses__pbEndOfRoundPhase
00042:     if @rules["suddendeath"] && @decision == 0
00043:       p1able = pbAbleCount(0)
00044:       p2able = pbAbleCount(1)
00045:       if p1able > p2able
00046:         @decision = 1   # loss
00047:       elsif p1able < p2able
00048:         @decision = 2   # win
00049:       end
00050:     end
00051:   end
00052: end
00053: 
00054: #===============================================================================
00055: #
00056: #===============================================================================
00057: class Battle::Battler
00058:   unless @__clauses__aliased
00059:     alias __clauses__pbCanSleep? pbCanSleep?
00060:     alias __clauses__pbCanSleepYawn? pbCanSleepYawn?
00061:     alias __clauses__pbCanFreeze? pbCanFreeze?
00062:     alias __clauses__pbUseMove pbUseMove
00063:     @__clauses__aliased = true
00064:   end
00065: 
00066:   def pbCanSleep?(user, showMessages, move = nil, ignoreStatus = false)
00067:     selfsleep = (user && user.index == @index)
00068:     if ((@battle.rules["modifiedsleepclause"]) || (!selfsleep && @battle.rules["sleepclause"])) &&
00069:        pbHasStatusPokemon?(:SLEEP)
00070:       if showMessages
00071:         @battle.pbDisplay(_INTL("But {1} couldn't sleep!", pbThis(true)))
00072:       end
00073:       return false
00074:     end
00075:     return __clauses__pbCanSleep?(user, showMessages, move, ignoreStatus)
00076:   end
00077: 
00078:   def pbCanSleepYawn?
00079:     if (@battle.rules["sleepclause"] || @battle.rules["modifiedsleepclause"]) &&
00080:        pbHasStatusPokemon?(:SLEEP)
00081:       return false
00082:     end
00083:     return __clauses__pbCanSleepYawn?
00084:   end
00085: 
00086:   def pbCanFreeze?(*arg)
00087:     if @battle.rules["freezeclause"] && pbHasStatusPokemon?(:FROZEN)
00088:       return false
00089:     end
00090:     return __clauses__pbCanFreeze?(*arg)
