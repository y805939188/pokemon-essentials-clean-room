00001: # DO NOT USE ANY CLASS NAMES IN HERE AS FUNCTION CODES!
00002: # These are base classes for other classes to build on; those other classes are
00003: # named after function codes, so use those instead.
00004: 
00005: #===============================================================================
00006: # Superclass that handles moves using a non-existent function code.
00007: # Damaging moves just do damage with no additional effect.
00008: # Status moves always fail.
00009: #===============================================================================
00010: class Battle::Move::Unimplemented < Battle::Move
00011:   def pbMoveFailed?(user, targets)
00012:     if statusMove?
00013:       @battle.pbDisplay(_INTL("But it failed!"))
00014:       return true
00015:     end
00016:     return false
00017:   end
00018: end
00019: 
00020: #===============================================================================
00021: # Pseudomove for confusion damage.
00022: #===============================================================================
00023: class Battle::Move::Confusion < Battle::Move
00024:   def initialize(battle, move)
00025:     @battle        = battle
