02571: #===============================================================================
02572: # OnSwitchIn handlers
02573: #===============================================================================
02574: 
02575: Battle::AbilityEffects::OnSwitchIn.add(:AIRLOCK,
02576:   proc { |ability, battler, battle, switch_in|
02577:     battle.pbShowAbilitySplash(battler)
02578:     if !Battle::Scene::USE_ABILITY_SPLASH
02579:       battle.pbDisplay(_INTL("{1} has {2}!", battler.pbThis, battler.abilityName))
02580:     end
02581:     battle.pbDisplay(_INTL("The effects of the weather disappeared."))
02582:     battle.pbHideAbilitySplash(battler)
02583:   }
02584: )
02585: 
02586: Battle::AbilityEffects::OnSwitchIn.copy(:AIRLOCK, :CLOUDNINE)
02587: 
02588: Battle::AbilityEffects::OnSwitchIn.add(:ANTICIPATION,
02589:   proc { |ability, battler, battle, switch_in|
02590:     next if !battler.pbOwnedByPlayer?
02591:     battlerTypes = battler.pbTypes(true)
02592:     types = battlerTypes
02593:     found = false
02594:     battle.allOtherSideBattlers(battler.index).each do |b|
02595:       b.eachMove do |m|
02596:         next if m.statusMove?
02597:         if types.length > 0
02598:           moveType = m.type
02599:           if Settings::MECHANICS_GENERATION >= 6 && m.function_code == "TypeDependsOnUserIVs"   # Hidden Power
02600:             moveType = pbHiddenPower(b.pokemon)[0]
02601:           end
02602:           eff = Effectiveness.calculate(moveType, *types)
02603:           next if Effectiveness.ineffective?(eff)
02604:           next if !Effectiveness.super_effective?(eff) &&
02605:                   !["OHKO", "OHKOIce", "OHKOHitsUndergroundTarget"].include?(m.function_code)
02606:         elsif !["OHKO", "OHKOIce", "OHKOHitsUndergroundTarget"].include?(m.function_code)
02607:           next
02608:         end
02609:         found = true
02610:         break
02611:       end
02612:       break if found
02613:     end
02614:     if found
02615:       battle.pbShowAbilitySplash(battler)
02616:       battle.pbDisplay(_INTL("{1} shuddered with anticipation!", battler.pbThis))
02617:       battle.pbHideAbilitySplash(battler)
02618:     end
02619:   }
02620: )
02621: 
02622: Battle::AbilityEffects::OnSwitchIn.add(:ASONECHILLINGNEIGH,
02623:   proc { |ability, battler, battle, switch_in|
02624:     battle.pbShowAbilitySplash(battler)
02625:     battle.pbDisplay(_INTL("{1} has two Abilities!", battler.pbThis))
02626:     battle.pbHideAbilitySplash(battler)
02627:     battler.ability_id = :UNNERVE
02628:     battle.pbShowAbilitySplash(battler)
02629:     battle.pbDisplay(_INTL("{1} is too nervous to eat Berries!", battler.pbOpposingTeam))
02630:     battle.pbHideAbilitySplash(battler)
02631:     battler.ability_id = ability
02632:   }
02633: )
02634: 
02635: Battle::AbilityEffects::OnSwitchIn.copy(:ASONECHILLINGNEIGH, :ASONEGRIMNEIGH)
02636: 
02637: Battle::AbilityEffects::OnSwitchIn.add(:AURABREAK,
02638:   proc { |ability, battler, battle, switch_in|
02639:     battle.pbShowAbilitySplash(battler)
02640:     battle.pbDisplay(_INTL("{1} reversed all other Pokémon's auras!", battler.pbThis))
02641:     battle.pbHideAbilitySplash(battler)
02642:   }
02643: )
02644: 
02645: Battle::AbilityEffects::OnSwitchIn.add(:COMATOSE,
02646:   proc { |ability, battler, battle, switch_in|
02647:     battle.pbShowAbilitySplash(battler)
02648:     battle.pbDisplay(_INTL("{1} is drowsing!", battler.pbThis))
02649:     battle.pbHideAbilitySplash(battler)
02650:   }
02651: )
02652: 
02653: Battle::AbilityEffects::OnSwitchIn.add(:CURIOUSMEDICINE,
02654:   proc { |ability, battler, battle, switch_in|
02655:     next if battler.allAllies.none? { |b| b.hasAlteredStatStages? }
02656:     battle.pbShowAbilitySplash(battler)
02657:     battler.allAllies.each do |b|
02658:       next if !b.hasAlteredStatStages?
02659:       b.pbResetStatStages
02660:       if Battle::Scene::USE_ABILITY_SPLASH
02661:         battle.pbDisplay(_INTL("{1}'s stat changes were removed!", b.pbThis))
02662:       else
02663:         battle.pbDisplay(_INTL("{1}'s stat changes were removed by {2}'s {3}!",
02664:            b.pbThis, battler.pbThis(true), battler.abilityName))
02665:       end
02666:     end
02667:     battle.pbHideAbilitySplash(battler)
02668:   }
02669: )
02670: 
02671: Battle::AbilityEffects::OnSwitchIn.add(:DARKAURA,
02672:   proc { |ability, battler, battle, switch_in|
02673:     battle.pbShowAbilitySplash(battler)
02674:     battle.pbDisplay(_INTL("{1} is radiating a dark aura!", battler.pbThis))
02675:     battle.pbHideAbilitySplash(battler)
02676:   }
02677: )
02678: 
02679: Battle::AbilityEffects::OnSwitchIn.add(:DAUNTLESSSHIELD,
02680:   proc { |ability, battler, battle, switch_in|
02681:     battler.pbRaiseStatStageByAbility(:DEFENSE, 1, battler)
02682:   }
02683: )
02684: 
02685: Battle::AbilityEffects::OnSwitchIn.add(:DELTASTREAM,
02686:   proc { |ability, battler, battle, switch_in|
02687:     battle.pbStartWeatherAbility(:StrongWinds, battler, true)
02688:   }
02689: )
02690: 
02691: Battle::AbilityEffects::OnSwitchIn.add(:DESOLATELAND,
02692:   proc { |ability, battler, battle, switch_in|
02693:     battle.pbStartWeatherAbility(:HarshSun, battler, true)
02694:   }
02695: )
02696: 
02697: Battle::AbilityEffects::OnSwitchIn.add(:DOWNLOAD,
02698:   proc { |ability, battler, battle, switch_in|
02699:     oDef = oSpDef = 0
02700:     battle.allOtherSideBattlers(battler.index).each do |b|
02701:       oDef   += b.defense
02702:       oSpDef += b.spdef
02703:     end
02704:     stat = (oDef < oSpDef) ? :ATTACK : :SPECIAL_ATTACK
02705:     battler.pbRaiseStatStageByAbility(stat, 1, battler)
02706:   }
02707: )
02708: 
