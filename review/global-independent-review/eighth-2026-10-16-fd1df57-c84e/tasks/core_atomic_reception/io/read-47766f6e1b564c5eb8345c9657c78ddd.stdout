00031:   #=============================================================================
00032:   # Creating a move
00033:   #=============================================================================
00034:   def initialize(battle, move)
00035:     @battle        = battle
00036:     @realMove      = move
00037:     @id            = move.id
00038:     @name          = move.name   # Get the move's name
00039:     # Get data on the move
00040:     @function_code = move.function_code
00041:     @power         = move.power
00042:     @type          = move.type
00043:     @category      = move.category
00044:     @accuracy      = move.accuracy
00045:     @pp            = move.pp   # Can be changed with Mimic/Transform
00046:     @target        = move.target
00047:     @priority      = move.priority
00048:     @flags         = move.flags.clone
00049:     @addlEffect    = move.effect_chance
00050:     @powerBoost    = false   # For Aerilate, Pixilate, Refrigerate, Galvanize
00051:     @snatched      = false
00052:   end
00053: 
00054:   # This is the code actually used to generate a Battle::Move object. The
00055:   # object generated is a subclass of this one which depends on the move's
00056:   # function code.
00057:   def self.from_pokemon_move(battle, move)
00058:     validate move => Pokemon::Move
00059:     code = move.function_code || "None"
00060:     if code[/^\d/]   # Begins with a digit
00061:       class_name = sprintf("Battle::Move::Effect%s", code)
00062:     else
00063:       class_name = sprintf("Battle::Move::%s", code)
00064:     end
00065:     if Object.const_defined?(class_name)
00066:       return Object.const_get(class_name).new(battle, move)
00067:     end
00068:     return Battle::Move::Unimplemented.new(battle, move)
00069:   end
