00156:   def pbEORTerrainHealing(battler)
00157:     return if battler.fainted?
00158:     # Grassy Terrain (healing)
00159:     if @field.terrain == :Grassy && battler.affectedByTerrain? && battler.canHeal?
00160:       PBDebug.log("[Lingering effect] Grassy Terrain heals #{battler.pbThis(true)}")
00161:       battler.pbRecoverHP(battler.totalhp / 16)
00162:       pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
00163:     end
00164:   end
00165: 
00166:   #=============================================================================
00167:   # End Of Round various healing effects
