00399:   #=============================================================================
00400:   # Generalised status displays
00401:   #=============================================================================
00402:   def pbContinueStatus
00403:     if self.status == :POISON && @statusCount > 0
00404:       @battle.pbCommonAnimation("Toxic", self)
00405:     else
00406:       anim_name = GameData::Status.get(self.status).animation
00407:       @battle.pbCommonAnimation(anim_name, self) if anim_name
00408:     end
00409:     yield if block_given?
00410:     case self.status
00411:     when :SLEEP
00412:       @battle.pbDisplay(_INTL("{1} is fast asleep.", pbThis))
00413:     when :POISON
00414:       @battle.pbDisplay(_INTL("{1} was hurt by poison!", pbThis))
00415:     when :BURN
00416:       @battle.pbDisplay(_INTL("{1} was hurt by its burn!", pbThis))
00417:     when :PARALYSIS
00418:       @battle.pbDisplay(_INTL("{1} is paralyzed! It can't move!", pbThis))
00419:     when :FROZEN
00420:       @battle.pbDisplay(_INTL("{1} is frozen solid!", pbThis))
00421:     end
00422:     PBDebug.log("[Status continues] #{pbThis}'s sleep count is #{@statusCount}") if self.status == :SLEEP
00423:   end
00424: 
00425:   def pbCureStatus(showMessages = true)
00426:     oldStatus = status
00427:     self.status = :NONE
00428:     if showMessages
00429:       case oldStatus
00430:       when :SLEEP     then @battle.pbDisplay(_INTL("{1} woke up!", pbThis))
00431:       when :POISON    then @battle.pbDisplay(_INTL("{1} was cured of its poisoning.", pbThis))
00432:       when :BURN      then @battle.pbDisplay(_INTL("{1}'s burn was healed.", pbThis))
00433:       when :PARALYSIS then @battle.pbDisplay(_INTL("{1} was cured of paralysis.", pbThis))
00434:       when :FROZEN    then @battle.pbDisplay(_INTL("{1} thawed out!", pbThis))
00435:       end
00436:     end
00437:     PBDebug.log("[Status change] #{pbThis}'s status was cured") if !showMessages
00438:   end
00439: 
00440:   #=============================================================================
00441:   # Confusion
00442:   #=============================================================================
00443:   def pbCanConfuse?(user = nil, showMessages = true, move = nil, selfInflicted = false)
00444:     return false if fainted?
00445:     if @effects[PBEffects::Confusion] > 0
00446:       @battle.pbDisplay(_INTL("{1} is already confused.", pbThis)) if showMessages
00447:       return false
00448:     end
00449:     if @effects[PBEffects::Substitute] > 0 && !(move && move.ignoresSubstitute?(user)) &&
00450:        !selfInflicted
00451:       @battle.pbDisplay(_INTL("But it failed!")) if showMessages
00452:       return false
00453:     end
00454:     # Terrains immunity
00455:     if affectedByTerrain? && @battle.field.terrain == :Misty && Settings::MECHANICS_GENERATION >= 7
00456:       @battle.pbDisplay(_INTL("{1} surrounds itself with misty terrain!", pbThis(true))) if showMessages
00457:       return false
00458:     end
00459:     if (selfInflicted || !@battle.moldBreaker) && hasActiveAbility?(:OWNTEMPO)
00460:       if showMessages
00461:         @battle.pbShowAbilitySplash(self)
00462:         if Battle::Scene::USE_ABILITY_SPLASH
00463:           @battle.pbDisplay(_INTL("{1} doesn't become confused!", pbThis))
00464:         else
00465:           @battle.pbDisplay(_INTL("{1}'s {2} prevents confusion!", pbThis, abilityName))
00466:         end
00467:         @battle.pbHideAbilitySplash(self)
00468:       end
00469:       return false
00470:     end
00471:     if pbOwnSide.effects[PBEffects::Safeguard] > 0 && !selfInflicted &&
00472:        !(user && user.hasActiveAbility?(:INFILTRATOR))
00473:       @battle.pbDisplay(_INTL("{1}'s team is protected by Safeguard!", pbThis)) if showMessages
00474:       return false
00475:     end
00476:     return true
00477:   end
00478: 
00479:   def pbCanConfuseSelf?(showMessages)
00480:     return pbCanConfuse?(nil, showMessages, nil, true)
00481:   end
00482: 
00483:   def pbConfuse(msg = nil)
00484:     @effects[PBEffects::Confusion] = pbConfusionDuration
00485:     @battle.pbCommonAnimation("Confusion", self)
00486:     msg = _INTL("{1} became confused!", pbThis) if nil_or_empty?(msg)
00487:     @battle.pbDisplay(msg)
00488:     PBDebug.log("[Lingering effect] #{pbThis}'s confusion count is #{@effects[PBEffects::Confusion]}")
00489:     # Confusion cures
00490:     pbItemStatusCureCheck
00491:     pbAbilityStatusCureCheck
00492:   end
00493: 
00494:   def pbConfusionDuration(duration = -1)
00495:     duration = 2 + @battle.pbRandom(4) if duration <= 0
00496:     return duration
00497:   end
00498: 
00499:   def pbCureConfusion
00500:     @effects[PBEffects::Confusion] = 0
00501:   end
00502: 
00503:   #=============================================================================
00504:   # Attraction
00505:   #=============================================================================
00506:   def pbCanAttract?(user, showMessages = true)
00507:     return false if fainted?
00508:     return false if !user || user.fainted?
00509:     if @effects[PBEffects::Attract] >= 0
00510:       @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis)) if showMessages
00511:       return false
00512:     end
00513:     agender = user.gender
00514:     ogender = gender
00515:     if agender == 2 || ogender == 2 || agender == ogender
00516:       @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis)) if showMessages
00517:       return false
00518:     end
00519:     if !@battle.moldBreaker
00520:       if hasActiveAbility?([:AROMAVEIL, :OBLIVIOUS])
00521:         if showMessages
00522:           @battle.pbShowAbilitySplash(self)
00523:           if Battle::Scene::USE_ABILITY_SPLASH
00524:             @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis))
00525:           else
00526:             @battle.pbDisplay(_INTL("{1}'s {2} prevents romance!", pbThis, abilityName))
00527:           end
00528:           @battle.pbHideAbilitySplash(self)
00529:         end
00530:         return false
00531:       else
00532:         allAllies.each do |b|
00533:           next if !b.hasActiveAbility?(:AROMAVEIL)
00534:           if showMessages
00535:             @battle.pbShowAbilitySplash(b)
00536:             if Battle::Scene::USE_ABILITY_SPLASH
00537:               @battle.pbDisplay(_INTL("{1} is unaffected!", pbThis))
00538:             else
00539:               @battle.pbDisplay(_INTL("{1}'s {2} prevents romance!", b.pbThis, b.abilityName))
00540:             end
00541:             @battle.pbHideAbilitySplash(b)
00542:           end
00543:           return false
00544:         end
00545:       end
00546:     end
00547:     return true
00548:   end
00549: 
00550:   def pbAttract(user, msg = nil)
00551:     @effects[PBEffects::Attract] = user.index
00552:     @battle.pbCommonAnimation("Attract", self)
00553:     msg = _INTL("{1} fell in love!", pbThis) if nil_or_empty?(msg)
00554:     @battle.pbDisplay(msg)
00555:     # Destiny Knot
00556:     if hasActiveItem?(:DESTINYKNOT) && user.pbCanAttract?(self, false)
00557:       user.pbAttract(self, _INTL("{1} fell in love from the {2}!", user.pbThis(true), itemName))
00558:     end
00559:     # Attraction cures
00560:     pbItemStatusCureCheck
00561:     pbAbilityStatusCureCheck
00562:   end
00563: 
00564:   def pbCureAttract
00565:     @effects[PBEffects::Attract] = -1
00566:   end
00567: 
00568:   #=============================================================================
00569:   # Flinching
00570:   #=============================================================================
00571:   def pbFlinch(_user = nil)
00572:     return if hasActiveAbility?(:INNERFOCUS) && !@battle.moldBreaker
00573:     @effects[PBEffects::Flinch] = true
00574:   end
00575: end
