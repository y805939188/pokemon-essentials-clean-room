01628: Battle::ItemEffects::OnEndOfUsingMove.add(:LEPPABERRY,
01629:   proc { |item, battler, battle, forced|
01630:     next false if !forced && !battler.canConsumeBerry?
01631:     found_empty_moves = []
01632:     found_partial_moves = []
01633:     battler.pokemon.moves.each_with_index do |move, i|
01634:       next if move.total_pp <= 0 || move.pp == move.total_pp
01635:       (move.pp == 0) ? found_empty_moves.push(i) : found_partial_moves.push(i)
01636:     end
01637:     next false if found_empty_moves.empty? && (!forced || found_partial_moves.empty?)
01638:     itemName = GameData::Item.get(item).name
01639:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
01640:     amt = 10
01641:     ripening = false
01642:     if battler.hasActiveAbility?(:RIPEN)
01643:       battle.pbShowAbilitySplash(battler, forced)
01644:       amt *= 2
01645:       ripening = true
01646:     end
01647:     battle.pbCommonAnimation("EatBerry", battler) if !forced
01648:     battle.pbHideAbilitySplash(battler) if ripening
01649:     choice = found_empty_moves.first
01650:     choice = found_partial_moves.first if forced && choice.nil?
01651:     pkmnMove = battler.pokemon.moves[choice]
01652:     pkmnMove.pp += amt
01653:     pkmnMove.pp = pkmnMove.total_pp if pkmnMove.pp > pkmnMove.total_pp
01654:     battler.moves[choice].pp = pkmnMove.pp
01655:     moveName = pkmnMove.name
01656:     if forced
01657:       battle.pbDisplay(_INTL("{1} restored its {2}'s PP.", battler.pbThis, moveName))
01658:     else
01659:       battle.pbDisplay(_INTL("{1}'s {2} restored its {3}'s PP!", battler.pbThis, itemName, moveName))
01660:     end
01661:     next true
01662:   }
01663: )
01664: 
01665: #===============================================================================
01666: # OnEndOfUsingMoveStatRestore handlers
01667: #===============================================================================
01668: 
01669: Battle::ItemEffects::OnEndOfUsingMoveStatRestore.add(:WHITEHERB,
01670:   proc { |item, battler, battle, forced|
01671:     reducedStats = false
01672:     GameData::Stat.each_battle do |s|
01673:       next if battler.stages[s.id] >= 0
01674:       battler.stages[s.id] = 0
01675:       battler.statsRaisedThisRound = true
01676:       reducedStats = true
01677:     end
01678:     next false if !reducedStats
01679:     itemName = GameData::Item.get(item).name
01680:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
01681:     battle.pbCommonAnimation("UseItem", battler) if !forced
01682:     if forced
01683:       battle.pbDisplay(_INTL("{1}'s status returned to normal!", battler.pbThis))
01684:     else
01685:       battle.pbDisplay(_INTL("{1} returned its status to normal using its {2}!",
01686:          battler.pbThis, itemName))
01687:     end
01688:     next true
01689:   }
01690: )
01691: 
