01790: Battle::ItemEffects::TerrainStatBoost.add(:ELECTRICSEED,
01791:   proc { |item, battler, battle|
01792:     next false if battle.field.terrain != :Electric
01793:     next false if !battler.pbCanRaiseStatStage?(:DEFENSE, battler)
01794:     itemName = GameData::Item.get(item).name
01795:     battle.pbCommonAnimation("UseItem", battler)
01796:     next battler.pbRaiseStatStageByCause(:DEFENSE, 1, battler, itemName)
01797:   }
01798: )
01799: 
