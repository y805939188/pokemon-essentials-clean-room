00695:     @field.defaultWeather  = value
00696:     @field.weather         = value
00697:     @field.weatherDuration = -1
00698:   end
00699: 
00700:   # Returns the effective weather (note that weather effects can be negated)
00701:   def pbWeather
00702:     return :None if allBattlers.any? { |b| b.hasActiveAbility?([:CLOUDNINE, :AIRLOCK]) }
00703:     return @field.weather
00704:   end
00705: 
00706:   # Used for causing weather by a move or by an ability.
00707:   def pbStartWeather(user, newWeather, fixedDuration = false, showAnim = true)
00708:     return if @field.weather == newWeather
00709:     @field.weather = newWeather
00710:     duration = (fixedDuration) ? 5 : -1
00711:     if duration > 0 && user && user.itemActive?
00712:       duration = Battle::ItemEffects.triggerWeatherExtender(user.item, @field.weather,
00713:                                                             duration, user, self)
00714:     end
00715:     @field.weatherDuration = duration
00716:     weather_data = GameData::BattleWeather.try_get(@field.weather)
00717:     pbCommonAnimation(weather_data.animation) if showAnim && weather_data
00718:     pbHideAbilitySplash(user) if user
00719:     case @field.weather
00720:     when :Sun         then pbDisplay(_INTL("The sunlight turned harsh!"))
00721:     when :Rain        then pbDisplay(_INTL("It started to rain!"))
00722:     when :Sandstorm   then pbDisplay(_INTL("A sandstorm brewed!"))
00723:     when :Hail        then pbDisplay(_INTL("It started to hail!"))
00724:     when :HarshSun    then pbDisplay(_INTL("The sunlight turned extremely harsh!"))
00725:     when :HeavyRain   then pbDisplay(_INTL("A heavy rain began to fall!"))
00726:     when :StrongWinds then pbDisplay(_INTL("Mysterious strong winds are protecting Flying-type Pokémon!"))
00727:     when :ShadowSky   then pbDisplay(_INTL("A shadow sky appeared!"))
00728:     end
00729:     # Check for end of primordial weather, and weather-triggered form changes
00730:     allBattlers.each { |b| b.pbCheckFormOnWeatherChange }
00731:     pbEndPrimordialWeather
00732:   end
00733: 
00734:   def pbEndPrimordialWeather
00735:     return if @field.weather == @field.defaultWeather
00736:     oldWeather = @field.weather
00737:     # End Primordial Sea, Desolate Land, Delta Stream
00738:     case @field.weather
00739:     when :HarshSun
00740:       if !pbCheckGlobalAbility(:DESOLATELAND)
00741:         @field.weather = :None
00742:         pbDisplay("The harsh sunlight faded!")
00743:       end
00744:     when :HeavyRain
00745:       if !pbCheckGlobalAbility(:PRIMORDIALSEA)
00746:         @field.weather = :None
00747:         pbDisplay("The heavy rain has lifted!")
00748:       end
00749:     when :StrongWinds
00750:       if !pbCheckGlobalAbility(:DELTASTREAM)
00751:         @field.weather = :None
00752:         pbDisplay("The mysterious air current has dissipated!")
00753:       end
00754:     end
00755:     if @field.weather != oldWeather
00756:       # Check for form changes caused by the weather changing
00757:       allBattlers.each { |b| b.pbCheckFormOnWeatherChange }
00758:       # Start up the default weather
00759:       pbStartWeather(nil, @field.defaultWeather) if @field.defaultWeather != :None
00760:     end
00761:   end
00762: 
00763:   def pbStartWeatherAbility(new_weather, battler, ignore_primal = false)
00764:     return if !ignore_primal && [:HarshSun, :HeavyRain, :StrongWinds].include?(@field.weather)
