00136:   def pbUseMoveSimple(moveID, target = -1, idxMove = -1, specialUsage = true)
00137:     choice = []
00138:     choice[0] = :UseMove   # "Use move"
00139:     choice[1] = idxMove    # Index of move to be used in user's moveset
00140:     if idxMove >= 0
00141:       choice[2] = @moves[idxMove]
00142:     else
00143:       choice[2] = Battle::Move.from_pokemon_move(@battle, Pokemon::Move.new(moveID))
00144:       choice[2].pp = -1
00145:     end
00146:     choice[3] = target     # Target (-1 means no target yet)
00147:     PBDebug.log("[Use move] #{pbThis} used the called/simple move #{choice[2].name}")
00148:     pbUseMove(choice, specialUsage)
00149:   end
00150: 
00151:   #=============================================================================
00152:   # Master "use move" method
00153:   #=============================================================================
00154:   def pbUseMove(choice, specialUsage = false)
00155:     # NOTE: This is intentionally determined before a multi-turn attack can
00156:     #       set specialUsage to true.
00157:     skipAccuracyCheck = (specialUsage && choice[2] != @battle.struggle)
00158:     # Start using the move
00159:     pbBeginTurn(choice)
00160:     # Force the use of certain moves if they're already being used
00161:     if !@battle.futureSight
00162:       if usingMultiTurnAttack?
00163:         choice[2] = Battle::Move.from_pokemon_move(@battle, Pokemon::Move.new(@currentMove))
00164:         specialUsage = true
00165:       elsif @effects[PBEffects::Encore] > 0 && choice[1] >= 0 &&
00166:             @battle.pbCanShowCommands?(@index)
00167:         idxEncoredMove = pbEncoredMoveIndex
00168:         if idxEncoredMove >= 0 && choice[1] != idxEncoredMove &&
00169:            @battle.pbCanChooseMove?(@index, idxEncoredMove, false)   # Change move if battler was Encored mid-round
