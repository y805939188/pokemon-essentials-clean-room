00001: #===============================================================================
00002: # Defines an event that procedures can subscribe to.
00003: #===============================================================================
00004: class Event
00005:   def initialize
00006:     @callbacks = []
00007:   end
00008: 
00009:   # Sets an event handler for this event and removes all other event handlers.
00010:   def set(method)
00011:     @callbacks.clear
00012:     @callbacks.push(method)
00013:   end
00014: 
00015:   # Removes an event handler procedure from the event.
00016:   def -(other)
00017:     @callbacks.delete(other)
00018:     return self
00019:   end
00020: 
00021:   # Adds an event handler procedure from the event.
00022:   def +(other)
00023:     return self if @callbacks.include?(other)
00024:     @callbacks.push(other)
00025:     return self
00026:   end
00027: 
00028:   # Clears the event of event handlers.
00029:   def clear
00030:     @callbacks.clear
00031:   end
00032: 
00033:   # Triggers the event and calls all its event handlers.  Normally called only
00034:   # by the code where the event occurred.
00035:   # The first argument is the sender of the event, the second argument contains
00036:   # the event's parameters. If three or more arguments are given, this method
00037:   # supports the following callbacks:
00038:   # proc { |sender,params| } where params is an array of the other parameters, and
00039:   # proc { |sender,arg0,arg1,...| }
00040:   def trigger(*arg)
00041:     arglist = arg[1, arg.length]
00042:     @callbacks.each do |callback|
00043:       if callback.arity > 2 && arg.length == callback.arity
00044:         # Retrofitted for callbacks that take three or more arguments
00045:         callback.call(*arg)
00046:       else
00047:         callback.call(arg[0], arglist)
00048:       end
00049:     end
00050:   end
00051: 
00052:   # Triggers the event and calls all its event handlers. Normally called only
00053:   # by the code where the event occurred. The first argument is the sender of
00054:   # the event, the other arguments are the event's parameters.
00055:   def trigger2(*arg)
00056:     @callbacks.each do |callback|
00057:       callback.call(*arg)
00058:     end
00059:   end
00060: end
00061: 
00062: #===============================================================================
00063: # Same as class Event, but each registered proc has a name (a symbol) so it can
00064: # be referenced individually.
00065: #===============================================================================
00066: class NamedEvent
00067:   def initialize
00068:     @callbacks = {}
00069:   end
00070: 
00071:   # Adds an event handler procedure from the event.
00072:   def add(key, proc)
00073:     @callbacks[key] = proc
00074:   end
00075: 
