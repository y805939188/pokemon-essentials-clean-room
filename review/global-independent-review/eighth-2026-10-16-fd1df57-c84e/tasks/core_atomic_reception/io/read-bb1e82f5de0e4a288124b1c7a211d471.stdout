00198:   def pbLowerStatStage(stat, increment, user, showAnim = true, ignoreContrary = false,
00199:                        mirrorArmorSplash = 0, ignoreMirrorArmor = false)
00200:     if !@battle.moldBreaker
00201:       # Contrary
00202:       if hasActiveAbility?(:CONTRARY) && !ignoreContrary
00203:         return pbRaiseStatStage(stat, increment, user, showAnim, true)
00204:       end
00205:       # Mirror Armor
00206:       if hasActiveAbility?(:MIRRORARMOR) && !ignoreMirrorArmor &&
00207:          user && user.index != @index && !statStageAtMin?(stat)
00208:         if mirrorArmorSplash < 2
00209:           @battle.pbShowAbilitySplash(self)
00210:           if !Battle::Scene::USE_ABILITY_SPLASH
00211:             @battle.pbDisplay(_INTL("{1}'s {2} activated!", pbThis, abilityName))
00212:           end
00213:         end
00214:         ret = false
00215:         if user.pbCanLowerStatStage?(stat, self, nil, true, ignoreContrary, true)
00216:           ret = user.pbLowerStatStage(stat, increment, self, showAnim, ignoreContrary, mirrorArmorSplash, true)
00217:         end
00218:         @battle.pbHideAbilitySplash(self) if mirrorArmorSplash.even?   # i.e. not 1 or 3
00219:         return ret
00220:       end
00221:     end
00222:     # Perform the stat stage change
00223:     increment = pbLowerStatStageBasic(stat, increment, ignoreContrary)
00224:     return false if increment <= 0
00225:     # Stat down animation and message
00226:     @battle.pbCommonAnimation("StatDown", self) if showAnim
00227:     arrStatTexts = [
00228:       _INTL("{1}'s {2} fell!", pbThis, GameData::Stat.get(stat).name),
00229:       _INTL("{1}'s {2} harshly fell!", pbThis, GameData::Stat.get(stat).name),
00230:       _INTL("{1}'s {2} severely fell!", pbThis, GameData::Stat.get(stat).name)
00231:     ]
00232:     @battle.pbDisplay(arrStatTexts[[increment - 1, 2].min])
00233:     # Trigger abilities upon stat loss
00234:     if abilityActive?
00235:       Battle::AbilityEffects.triggerOnStatLoss(self.ability, self, stat, user)
00236:     end
00237:     return true
00238:   end
00239: 
