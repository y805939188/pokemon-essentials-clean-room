00016:     # Calculates the maximum level a Pokémon can attain. This can vary during a
00017:     # game, and here is where you would make it do so. Note that this method is
00018:     # called by the Compiler, which happens before anything (e.g. Game Switches/
00019:     # Variables, the player's data) is loaded, so code in this method should
00020:     # check whether the needed variables exist before using them; if they don't,
00021:     # this method should return the maximum possible level ever.
00022:     # @return [Integer] the maximum level attainable by a Pokémon
00023:     def self.max_level
00024:       return Settings::MAXIMUM_LEVEL
00025:     end
00026: 
00027:     def initialize(hash)
00028:       @id          = hash[:id]
00029:       @real_name   = hash[:name] || "Unnamed"
00030:       @exp_values  = hash[:exp_values]
