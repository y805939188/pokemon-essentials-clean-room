00001: module PBDebug
00002:   @@log = []
00003: 
00004:   def self.logonerr
00005:     begin
00006:       yield
00007:     rescue
00008:       PBDebug.log("")
00009:       PBDebug.log("**Exception: #{$!.message}")
00010:       backtrace = ""
00011:       $!.backtrace.each { |line| backtrace += line + "\r\n" }
00012:       PBDebug.log(backtrace)
00013:       PBDebug.log("")
00014:       pbPrintException($!)   # if $INTERNAL
00015:       PBDebug.flush
00016:     end
00017:   end
00018: 
00019:   def self.flush
00020:     if $DEBUG && $INTERNAL && @@log.length > 0
00021:       File.open("Data/debuglog.txt", "a+b") { |f| f.write(@@log.join) }
00022:     end
00023:     @@log.clear
00024:   end
00025: 
00026:   def self.log(msg)
00027:     if $DEBUG && $INTERNAL
00028:       echoln msg.gsub("%", "%%")
00029:       @@log.push(msg + "\r\n")
00030:       PBDebug.flush   # if @@log.length > 1024
00031:     end
00032:   end
00033: 
00034:   def self.log_header(msg)
00035:     if $DEBUG && $INTERNAL
00036:       echoln Console.markup_style(msg.gsub("%", "%%"), text: :light_purple)
00037:       @@log.push(msg + "\r\n")
00038:       PBDebug.flush   # if @@log.length > 1024
00039:     end
00040:   end
