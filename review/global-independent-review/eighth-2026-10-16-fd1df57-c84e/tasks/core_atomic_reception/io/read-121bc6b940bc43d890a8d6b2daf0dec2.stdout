00178:           "git_blob": "a3c00d47e159924e49f83aad5485718381ebae33",
00179:           "content": "  def pbReduceHP(amt, anim = true, registerDamage = true, anyAnim = true)\n    amt = amt.round\n    amt = @hp if amt > @hp\n    amt = 1 if amt < 1 && !fainted?\n    oldHP = @hp\n    self.hp -= amt\n    PBDebug.log(\"[HP change] #{pbThis} lost #{amt} HP (#{oldHP} -> #{@hp})\") if amt > 0\n    raise _INTL(\"HP less than 0\") if @hp < 0\n    raise _INTL(\"HP greater than total HP\") if @hp > @totalhp\n    @battle.scene.pbHPChanged(self, oldHP, anim) if anyAnim && amt > 0\n    if amt > 0 && registerDamage\n      @droppedBelowHalfHP = true if @hp < @totalhp / 2 && @hp + amt >= @totalhp / 2\n      @tookDamageThisRound = true\n      @tookMoveDamageThisRound = true\n    end\n    return amt\n  end\n",
