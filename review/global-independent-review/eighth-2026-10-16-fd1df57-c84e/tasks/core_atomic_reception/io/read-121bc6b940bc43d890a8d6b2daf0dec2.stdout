00192:           "git_blob": "a3c00d47e159924e49f83aad5485718381ebae33",
00193:           "content": "  def pbTakeEffectDamage(amt, show_anim = true)\n    @droppedBelowHalfHP = false\n    hp_lost = pbReduceHP(amt, show_anim)\n    yield hp_lost if block_given?   # Show message\n    pbItemHPHealCheck\n    pbAbilitiesOnDamageTaken\n    pbFaint if fainted?\n    @droppedBelowHalfHP = false\n  end\n",
