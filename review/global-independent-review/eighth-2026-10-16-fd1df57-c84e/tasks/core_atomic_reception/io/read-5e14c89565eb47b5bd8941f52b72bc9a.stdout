00191: # already moved. (Sucker Punch)
00192: #===============================================================================
00193: class Battle::Move::FailsIfTargetActed < Battle::Move
00194:   def pbFailsAgainstTarget?(user, target, show_message)
00195:     if @battle.choices[target.index][0] != :UseMove
