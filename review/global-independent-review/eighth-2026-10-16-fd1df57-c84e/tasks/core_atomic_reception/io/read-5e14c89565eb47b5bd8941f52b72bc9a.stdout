00163:   end
00164: end
00165: 
00166: #===============================================================================
00167: # Fails if user was hit by a damaging move this round. (Focus Punch)
00168: #===============================================================================
00169: class Battle::Move::FailsIfUserDamagedThisTurn < Battle::Move
00170:   def pbDisplayChargeMessage(user)
00171:     user.effects[PBEffects::FocusPunch] = true
00172:     @battle.pbCommonAnimation("FocusPunch", user)
00173:     @battle.pbDisplay(_INTL("{1} is tightening its focus!", user.pbThis))
00174:   end
00175: 
00176:   def pbDisplayUseMessage(user)
00177:     super if !user.effects[PBEffects::FocusPunch] || !user.tookMoveDamageThisRound
00178:   end
00179: 
00180:   def pbMoveFailed?(user, targets)
00181:     if user.effects[PBEffects::FocusPunch] && user.tookMoveDamageThisRound
00182:       @battle.pbDisplay(_INTL("{1} lost its focus and couldn't move!", user.pbThis))
00183:       return true
00184:     end
00185:     return false
00186:   end
00187: end
00188: 
