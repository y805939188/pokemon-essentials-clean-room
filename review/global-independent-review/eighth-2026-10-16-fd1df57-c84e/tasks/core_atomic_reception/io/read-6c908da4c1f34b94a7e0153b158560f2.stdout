00122:           "git_blob": "dfea2bb1c97725d8c01ec40fb34549539de04e23",
00123:           "content": "  def takesIndirectDamage?(showMsg = false)\n    return false if fainted?\n    if hasActiveAbility?(:MAGICGUARD)\n      if showMsg\n        @battle.pbShowAbilitySplash(self)\n        if Battle::Scene::USE_ABILITY_SPLASH\n          @battle.pbDisplay(_INTL(\"{1} is unaffected!\", pbThis))\n        else\n          @battle.pbDisplay(_INTL(\"{1} is unaffected because of its {2}!\", pbThis, abilityName))\n        end\n        @battle.pbHideAbilitySplash(self)\n      end\n      return false\n    end\n    return true\n  end\n",
