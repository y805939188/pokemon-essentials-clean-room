03156: Battle::AbilityEffects::OnTerrainChange.add(:MIMICRY,
03157:   proc { |ability, battler, battle, ability_changed|
03158:     if battle.field.terrain == :None
03159:       # Revert to original typing
03160:       battle.pbShowAbilitySplash(battler)
03161:       battler.pbResetTypes
03162:       battle.pbDisplay(_INTL("{1} changed back to its regular type!", battler.pbThis))
03163:       battle.pbHideAbilitySplash(battler)
03164:     else
03165:       # Change to new typing
03166:       terrain_hash = {
03167:         :Electric => :ELECTRIC,
03168:         :Grassy   => :GRASS,
03169:         :Misty    => :FAIRY,
03170:         :Psychic  => :PSYCHIC
03171:       }
03172:       new_type = terrain_hash[battle.field.terrain]
03173:       new_type_name = nil
03174:       if new_type
03175:         type_data = GameData::Type.try_get(new_type)
03176:         new_type = nil if !type_data
03177:         new_type_name = type_data.name if type_data
03178:       end
03179:       if new_type
03180:         battle.pbShowAbilitySplash(battler)
03181:         battler.pbChangeTypes(new_type)
03182:         battle.pbDisplay(_INTL("{1}'s type changed to {2}!", battler.pbThis, new_type_name))
03183:         battle.pbHideAbilitySplash(battler)
03184:       end
03185:     end
03186:   }
03187: )
