00073:       when -3   # Shift
00074:         pbUnregisterMegaEvolution(idxBattler)
00075:         pbRegisterShift(idxBattler)
00076:         ret = true
00077:       else      # Chose a move to use
00078:         next false if cmd < 0 || !@battlers[idxBattler].moves[cmd] ||
00079:                       !@battlers[idxBattler].moves[cmd].id
00080:         next false if !pbRegisterMove(idxBattler, cmd)
00081:         next false if !singleBattle? &&
00082:                       !pbChooseTarget(@battlers[idxBattler], @battlers[idxBattler].moves[cmd])
00083:         ret = true
00084:       end
00085:       next true
00086:     end
00087:     return ret
00088:   end
00089: 
00090:   def pbAutoFightMenu(idxBattler); return false; end
00091: 
00092:   def pbChooseTarget(battler, move)
00093:     target_data = move.pbTarget(battler)
00094:     idxTarget = @scene.pbChooseTarget(battler.index, target_data)
00095:     return false if idxTarget < 0
00096:     pbRegisterTarget(battler.index, idxTarget)
