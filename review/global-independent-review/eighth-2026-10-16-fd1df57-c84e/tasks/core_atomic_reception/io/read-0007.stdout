00288:   def pbLowerStatStageByAbility(stat, increment, user, splashAnim = true, checkContact = false)
00289:     ret = false
00290:     @battle.pbShowAbilitySplash(user) if splashAnim
00291:     if pbCanLowerStatStage?(stat, user, nil, Battle::Scene::USE_ABILITY_SPLASH) &&
00292:        (!checkContact || affectedByContactEffect?(Battle::Scene::USE_ABILITY_SPLASH))
00293:       if Battle::Scene::USE_ABILITY_SPLASH
00294:         ret = pbLowerStatStage(stat, increment, user)
00295:       else
00296:         ret = pbLowerStatStageByCause(stat, increment, user, user.abilityName)
00297:       end
00298:     end
00299:     @battle.pbHideAbilitySplash(user) if splashAnim
00300:     return ret
00301:   end
00302: 
00303:   def pbLowerAttackStatStageIntimidate(user)
00304:     return false if fainted?
00305:     # NOTE: Substitute intentionally blocks Intimidate even if self has Contrary.
00306:     if @effects[PBEffects::Substitute] > 0
00307:       if Battle::Scene::USE_ABILITY_SPLASH
00308:         @battle.pbDisplay(_INTL("{1} is protected by its substitute!", pbThis))
00309:       else
00310:         @battle.pbDisplay(_INTL("{1}'s substitute protected it from {2}'s {3}!",
00311:                                 pbThis, user.pbThis(true), user.abilityName))
00312:       end
00313:       return false
00314:     end
00315:     if Settings::MECHANICS_GENERATION >= 8 && hasActiveAbility?([:OBLIVIOUS, :OWNTEMPO, :INNERFOCUS, :SCRAPPY])
00316:       @battle.pbShowAbilitySplash(self)
00317:       if Battle::Scene::USE_ABILITY_SPLASH
00318:         @battle.pbDisplay(_INTL("{1}'s {2} cannot be lowered!", pbThis, GameData::Stat.get(:ATTACK).name))
00319:       else
00320:         @battle.pbDisplay(_INTL("{1}'s {2} prevents {3} loss!", pbThis, abilityName,
00321:                                 GameData::Stat.get(:ATTACK).name))
00322:       end
00323:       @battle.pbHideAbilitySplash(self)
00324:       return false
00325:     end
00326:     if Battle::Scene::USE_ABILITY_SPLASH
00327:       return pbLowerStatStageByAbility(:ATTACK, 1, user, false)
00328:     end
00329:     # NOTE: These checks exist to ensure appropriate messages are shown if
00330:     #       Intimidate is blocked somehow (i.e. the messages should mention the
00331:     #       Intimidate ability by name).
00332:     if !hasActiveAbility?(:CONTRARY)
00333:       if pbOwnSide.effects[PBEffects::Mist] > 0
00334:         @battle.pbDisplay(_INTL("{1} is protected from {2}'s {3} by Mist!",
00335:                                 pbThis, user.pbThis(true), user.abilityName))
00336:         return false
00337:       end
00338:       if abilityActive? &&
00339:          (Battle::AbilityEffects.triggerStatLossImmunity(self.ability, self, :ATTACK, @battle, false) ||
00340:           Battle::AbilityEffects.triggerStatLossImmunityNonIgnorable(self.ability, self, :ATTACK, @battle, false))
00341:         @battle.pbDisplay(_INTL("{1}'s {2} prevented {3}'s {4} from working!",
00342:                                 pbThis, abilityName, user.pbThis(true), user.abilityName))
00343:         return false
00344:       end
00345:       allAllies.each do |b|
00346:         next if !b.abilityActive?
00347:         if Battle::AbilityEffects.triggerStatLossImmunityFromAlly(b.ability, b, self, :ATTACK, @battle, false)
00348:           @battle.pbDisplay(_INTL("{1} is protected from {2}'s {3} by {4}'s {5}!",
00349:                                   pbThis, user.pbThis(true), user.abilityName, b.pbThis(true), b.abilityName))
00350:           return false
00351:         end
00352:       end
00353:     end
00354:     return false if !pbCanLowerStatStage?(:ATTACK, user)
00355:     return pbLowerStatStageByCause(:ATTACK, 1, user, user.abilityName)
00356:   end
00357: 
00358:   #=============================================================================
00359:   # Reset stat stages
00360:   #=============================================================================
00361:   def hasAlteredStatStages?
00362:     GameData::Stat.each_battle { |s| return true if @stages[s.id] != 0 }
00363:     return false
00364:   end
00365: 
00366:   def hasRaisedStatStages?
00367:     GameData::Stat.each_battle { |s| return true if @stages[s.id] > 0 }
00368:     return false
00369:   end
00370: 
00371:   def hasLoweredStatStages?
00372:     GameData::Stat.each_battle { |s| return true if @stages[s.id] < 0 }
00373:     return false
00374:   end
00375: 
00376:   def pbResetStatStages
00377:     GameData::Stat.each_battle do |s|
00378:       if @stages[s.id] > 0
00379:         @statsLoweredThisRound = true
00380:         @statsDropped = true
00381:       elsif @stages[s.id] < 0
00382:         @statsRaisedThisRound = true
00383:       end
00384:       @stages[s.id] = 0
00385:     end
00386:   end
00387: end
