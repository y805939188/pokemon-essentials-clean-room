00474:   def pbSideBattlerCount(idxBattler = 0)
00475:     return allSameSideBattlers(idxBattler).length
00476:   end
00477: 
00478:   def pbOpposingBattlerCount(idxBattler = 0)
00479:     return allOtherSideBattlers(idxBattler).length
00480:   end
00481: 
00482:   # This method only counts the player's Pokémon, not a partner trainer's.
00483:   def pbPlayerBattlerCount
00484:     return allSameSideBattlers.select { |b| b.pbOwnedByPlayer? }.length
00485:   end
