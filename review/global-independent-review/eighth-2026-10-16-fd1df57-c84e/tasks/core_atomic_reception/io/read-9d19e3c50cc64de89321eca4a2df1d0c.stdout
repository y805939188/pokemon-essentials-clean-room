00560:         @battle.pbShowAbilitySplash(nextUser, true)
00561:         @battle.pbHideAbilitySplash(nextUser)
00562:         if !Battle::Scene::USE_ABILITY_SPLASH
00563:           @battle.pbDisplay(_INTL("{1} kept the dance going with {2}!",
00564:                                   nextUser.pbThis, nextUser.abilityName))
00565:         end
00566:         nextUser.effects[PBEffects::Dancer] = true
00567:         if nextUser.pbCanChooseMove?(move, false)
00568:           PBDebug.logonerr { nextUser.pbUseMoveSimple(move.id, preTarget) }
00569:           nextUser.lastRoundMoved = oldLastRoundMoved
00570:           nextUser.effects[PBEffects::Outrage] = oldOutrage
00571:           nextUser.currentMove = oldCurrentMove
00572:           @battle.pbJudge
00573:           return if @battle.decision > 0
00574:         end
00575:         nextUser.effects[PBEffects::Dancer] = false
00576:       end
00577:     end
00578:   end
00579: 
00580:   #=============================================================================
00581:   # Attack a single target
00582:   #=============================================================================
00583:   def pbProcessMoveHit(move, user, targets, hitNum, skipAccuracyCheck)
00584:     return false if user.fainted?
00585:     # For two-turn attacks being used in a single turn
00586:     move.pbInitialEffect(user, targets, hitNum)
00587:     numTargets = 0   # Number of targets that are affected by this hit
00588:     # Count a hit for Parental Bond (if it applies)
00589:     user.effects[PBEffects::ParentalBond] -= 1 if user.effects[PBEffects::ParentalBond] > 0
00590:     # Accuracy check (accuracy/evasion calc)
