00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: module RecordedBattleModule
00005:   attr_reader :randomnums
00006:   attr_reader :rounds
00007: 
00008:   module Commands
00009:     FIGHT   = 0
00010:     BAG     = 1
00011:     POKEMON = 2
00012:     RUN     = 3
00013:   end
00014: 
00015:   def initialize(*arg)
00016:     @randomnumbers = []
00017:     @rounds        = []
00018:     @switches      = []
00019:     @roundindex    = -1
00020:     @properties    = {}
00021:     super(*arg)
00022:   end
00023: 
00024:   def pbGetBattleType
00025:     return 0   # Battle Tower
00026:   end
00027: 
00028:   def pbGetTrainerInfo(trainer)
00029:     return nil if !trainer
00030:     if trainer.is_a?(Array)
00031:       ret = []
00032:       trainer.each do |tr|
00033:         if tr.is_a?(Player)
00034:           ret.push([tr.trainer_type, tr.name.clone, tr.id, tr.badges.clone])
00035:         else   # NPCTrainer
00036:           ret.push([tr.trainer_type, tr.name.clone, tr.id, tr.lose_text || "...", tr.win_text || "..."])
00037:         end
00038:       end
00039:       return ret
00040:     elsif trainer[i].is_a?(Player)
00041:       return [[trainer.trainer_type, trainer.name.clone, trainer.id, trainer.badges.clone]]
00042:     else
00043:       return [[trainer.trainer_type, trainer.name.clone, trainer.id, trainer.lose_text || "...", trainer.win_text || "..."]]
00044:     end
00045:   end
00046: 
00047:   def pbStartBattle
00048:     @properties = {}
00049:     @properties["internalBattle"]  = @internalBattle
00050:     @properties["player"]          = pbGetTrainerInfo(@player)
00051:     @properties["opponent"]        = pbGetTrainerInfo(@opponent)
00052:     @properties["party1"]          = Marshal.dump(@party1)
00053:     @properties["party2"]          = Marshal.dump(@party2)
00054:     @properties["party1starts"]    = Marshal.dump(@party1starts)
00055:     @properties["party2starts"]    = Marshal.dump(@party2starts)
00056:     @properties["weather"]         = @field.weather
00057:     @properties["weatherDuration"] = @field.weatherDuration
00058:     @properties["canRun"]          = @canRun
00059:     @properties["switchStyle"]     = @switchStyle
00060:     @properties["showAnims"]       = @showAnims
00061:     @properties["items"]           = Marshal.dump(@items)
00062:     @properties["backdrop"]        = @backdrop
00063:     @properties["backdropBase"]    = @backdropBase
00064:     @properties["time"]            = @time
00065:     @properties["environment"]     = @environment
00066:     @properties["rules"]           = Marshal.dump(@rules)
00067:     super
00068:   end
00069: 
00070:   def pbDumpRecord
00071:     return Marshal.dump([pbGetBattleType, @properties, @rounds, @randomnumbers, @switches])
00072:   end
00073: 
00074:   def pbSwitchInBetween(idxBattler, checkLaxOnly = false, canCancel = false)
00075:     ret = super
00076:     @switches.push(ret)
00077:     return ret
00078:   end
00079: 
00080:   def pbRegisterMove(idxBattler, idxMove, showMessages = true)
00081:     if super
00082:       @rounds[@roundindex][idxBattler] = [Commands::FIGHT, idxMove]
00083:       return true
00084:     end
00085:     return false
00086:   end
00087: 
00088:   def pbRegisterTarget(idxBattler, idxTarget)
00089:     super
00090:     @rounds[@roundindex][idxBattler][2] = idxTarget
00091:   end
00092: 
00093:   def pbRun(idxBattler, duringBattle = false)
00094:     ret = super
00095:     @rounds[@roundindex][idxBattler] = [Commands::RUN, @decision]
00096:     return ret
00097:   end
00098: 
00099:   def pbAutoChooseMove(idxBattler, showMessages = true)
00100:     ret = super
00101:     @rounds[@roundindex][idxBattler] = [Commands::FIGHT, -1]
00102:     return ret
00103:   end
00104: 
00105:   def pbRegisterSwitch(idxBattler, idxParty)
00106:     if super
00107:       @rounds[@roundindex][idxBattler] = [Commands::POKEMON, idxParty]
00108:       return true
00109:     end
00110:     return false
00111:   end
00112: 
00113:   def pbRegisterItem(idxBattler, item, idxTarget = nil, idxMove = nil)
00114:     if super
00115:       @rounds[@roundindex][idxBattler] = [Commands::BAG, item, idxTarget, idxMove]
00116:       return true
00117:     end
00118:     return false
00119:   end
00120: 
00121:   def pbCommandPhase
00122:     @roundindex += 1
00123:     @rounds[@roundindex] = [[], [], [], []]
00124:     super
00125:   end
00126: 
00127:   def pbStorePokemon(pkmn); end
00128: 
00129:   def pbRandom(num)
00130:     ret = super(num)
00131:     @randomnumbers.push(ret)
00132:     return ret
00133:   end
00134: end
00135: 
00136: #===============================================================================
00137: #
00138: #===============================================================================
00139: module RecordedBattlePlaybackModule
00140:   module Commands
00141:     FIGHT   = 0
00142:     BAG     = 1
00143:     POKEMON = 2
00144:     RUN     = 3
00145:   end
00146: 
00147:   def initialize(scene, battle)
00148:     @battletype  = battle[0]
00149:     @properties  = battle[1]
00150:     @rounds      = battle[2]
00151:     @randomnums  = battle[3]
00152:     @switches    = battle[4]
00153:     @roundindex  = -1
00154:     @randomindex = 0
00155:     @switchindex = 0
00156:     super(scene,
00157:        Marshal.restore(@properties["party1"]),
00158:        Marshal.restore(@properties["party2"]),
00159:        RecordedBattle::PlaybackHelper.pbCreateTrainerInfo(@properties["player"]),
00160:        RecordedBattle::PlaybackHelper.pbCreateTrainerInfo(@properties["opponent"])
00161:     )
00162:   end
00163: 
00164:   def pbStartBattle
00165:     @party1starts          = Marshal.restore(@properties["party1starts"])
00166:     @party2starts          = Marshal.restore(@properties["party2starts"])
00167:     @internalBattle        = @properties["internalBattle"]
00168:     @field.weather         = @properties["weather"]
00169:     @field.weatherDuration = @properties["weatherDuration"]
00170:     @canRun                = @properties["canRun"]
00171:     @switchStyle           = @properties["switchStyle"]
00172:     @showAnims             = @properties["showAnims"]
00173:     @backdrop              = @properties["backdrop"]
00174:     @backdropBase          = @properties["backdropBase"]
00175:     @time                  = @properties["time"]
00176:     @environment           = @properties["environment"]
00177:     @items                 = Marshal.restore(@properties["items"])
00178:     @rules                 = Marshal.restore(@properties["rules"])
00179:     super
00180:   end
00181: 
00182:   def pbSwitchInBetween(_idxBattler, _checkLaxOnly = false, _canCancel = false)
00183:     ret = @switches[@switchindex]
00184:     @switchindex += 1
00185:     return ret
00186:   end
00187: 
00188:   def pbRandom(_num)
00189:     ret = @randomnums[@randomindex]
00190:     @randomindex += 1
00191:     return ret
00192:   end
00193: 
00194:   def pbDisplayPaused(str)
00195:     pbDisplay(str)
00196:   end
00197: 
00198:   def pbCommandPhaseLoop(isPlayer)
00199:     return if !isPlayer
00200:     @roundindex += 1
00201:     4.times do |i|
00202:       next if @rounds[@roundindex][i].length == 0
00203:       pbClearChoice(i)
00204:       case @rounds[@roundindex][i][0]
00205:       when Commands::FIGHT
00206:         if @rounds[@roundindex][i][1] == -1
00207:           pbAutoChooseMove(i, false)
00208:         else
00209:           pbRegisterMove(i, @rounds[@roundindex][i][1])
00210:         end
00211:         if @rounds[@roundindex][i][2]
00212:           pbRegisterTarget(i, @rounds[@roundindex][i][2])
00213:         end
00214:       when Commands::BAG
00215:         pbRegisterItem(i, @rounds[@roundindex][i][1], @rounds[@roundindex][i][2], @rounds[@roundindex][i][3])
00216:       when Commands::POKEMON
00217:         pbRegisterSwitch(i, @rounds[@roundindex][i][1])
00218:       when Commands::RUN
00219:         @decision = @rounds[@roundindex][i][1]
00220:       end
00221:     end
00222:   end
00223: end
00224: 
00225: #===============================================================================
00226: #
00227: #===============================================================================
00228: class RecordedBattle < Battle
00229:   include RecordedBattleModule
00230: 
00231:   def pbGetBattleType; return 0; end
00232: end
00233: 
00234: class RecordedBattle::BattlePalaceBattle < BattlePalaceBattle
00235:   include RecordedBattleModule
00236: 
00237:   def pbGetBattleType; return 1; end
00238: end
00239: 
00240: class RecordedBattle::BattleArenaBattle < BattleArenaBattle
00241:   include RecordedBattleModule
00242: 
00243:   def pbGetBattleType; return 2; end
00244: end
00245: 
00246: class RecordedBattle::PlaybackBattle < Battle
00247:   include RecordedBattlePlaybackModule
00248: end
00249: 
00250: class RecordedBattle::BattlePalacePlaybackBattle < BattlePalaceBattle
00251:   include RecordedBattlePlaybackModule
00252: end
00253: 
00254: class RecordedBattle::BattleArenaPlaybackBattle < BattleArenaBattle
00255:   include RecordedBattlePlaybackModule
00256: end
00257: 
00258: #===============================================================================
00259: #
00260: #===============================================================================
00261: module RecordedBattle::PlaybackHelper
00262:   def self.pbGetOpponent(battle)
00263:     return self.pbCreateTrainerInfo(battle[1]["opponent"])
00264:   end
00265: 
00266:   def self.pbGetBattleBGM(battle)
00267:     return self.pbGetTrainerBattleBGM(self.pbGetOpponent(battle))
00268:   end
00269: 
00270:   def self.pbCreateTrainerInfo(trainer)
00271:     return nil if !trainer
00272:     ret = []
00273:     trainer.each do |tr|
00274:       if tr.length == 4   # Player
00275:         t = Player.new(tr[1], tr[0])
00276:         t.badges = tr[3]
00277:       else   # NPCTrainer
00278:         t = NPCTrainer.new(tr[1], tr[0])
00279:         t.lose_text = tr[3] || "..."
00280:         t.win_text = tr[4] || "..."
00281:       end
00282:       t.id = tr[2]
00283:       ret.push(t)
00284:     end
00285:     return ret
00286:   end
00287: end
