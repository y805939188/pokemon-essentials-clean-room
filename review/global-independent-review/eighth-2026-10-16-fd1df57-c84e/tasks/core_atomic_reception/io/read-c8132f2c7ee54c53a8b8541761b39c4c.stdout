00231:         entry[0].effects[PBEffects::PriorityAbility] = true
00232:       end
00233:       entry[4] = subpri   # Final sub-priority
00234:     end
00235:     # Reorder the priority array
00236:     if needRearranging
00237:       @priority.sort! do |a, b|
00238:         if a[5] != b[5]
00239:           # Sort by priority (highest value first)
00240:           b[5] <=> a[5]
00241:         elsif a[4] != b[4]
00242:           # Sort by sub-priority (highest value first)
00243:           b[4] <=> a[4]
00244:         elsif @priorityTrickRoom
00245:           # Sort by speed (lowest first), and use tie-breaker if necessary
00246:           (a[1] == b[1]) ? b[6] <=> a[6] : a[1] <=> b[1]
00247:         else
00248:           # Sort by speed (highest first), and use tie-breaker if necessary
00249:           (a[1] == b[1]) ? b[6] <=> a[6] : b[1] <=> a[1]
00250:         end
00251:       end
00252:       # Write the priority order to the debug log
00253:       if fullCalc && $INTERNAL
00254:         logMsg = "[Round order] "
00255:         @priority.each_with_index do |entry, i|
00256:           logMsg += ", " if i > 0
