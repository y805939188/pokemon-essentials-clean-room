00551: #===============================================================================
00552: # Power is doubled if the user's last move failed. (Stomping Tantrum)
00553: #===============================================================================
00554: class Battle::Move::DoublePowerIfUserLastMoveFailed < Battle::Move
00555:   def pbBaseDamage(baseDmg, user, target)
00556:     baseDmg *= 2 if user.lastRoundMoveFailed
00557:     return baseDmg
00558:   end
00559: end
