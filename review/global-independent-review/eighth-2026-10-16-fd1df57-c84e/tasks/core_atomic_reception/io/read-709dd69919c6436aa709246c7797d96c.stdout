00001: #===============================================================================
00002: # Trainer class for the player
00003: #===============================================================================
00004: class Player < Trainer
00005:   # @return [Integer] the character ID of the player
00006:   attr_reader   :character_ID
00007:   # @return [Integer] the player's outfit
00008:   attr_reader   :outfit
00009:   # @return [Array<Boolean>] the player's Gym Badges (true if owned)
00010:   attr_accessor :badges
00011:   # @return [Integer] the player's money
00012:   attr_reader   :money
00013:   # @return [Integer] the player's Game Corner coins
00014:   attr_reader   :coins
00015:   # @return [Integer] the player's battle points
00016:   attr_reader   :battle_points
00017:   # @return [Integer] the player's soot
00018:   attr_reader   :soot
00019:   # @return [Pokedex] the player's Pokédex
00020:   attr_reader   :pokedex
00021:   # @return [Boolean] whether the Pokédex has been obtained
00022:   attr_accessor :has_pokedex
00023:   # @return [Boolean] whether the Pokégear has been obtained
00024:   attr_accessor :has_pokegear
00025:   # @return [Boolean] whether the player has running shoes (i.e. can run)
00026:   attr_accessor :has_running_shoes
00027:   # @return [Boolean] whether the player has an innate ability to access Pokémon storage
00028:   attr_accessor :has_box_link
00029:   # @return [Boolean] whether the creator of the Pokémon Storage System has been seen
00030:   attr_accessor :seen_storage_creator
00031:   # @return [Boolean] whether the effect of Exp All applies innately
00032:   attr_accessor :has_exp_all
00033:   # @return [Boolean] whether Mystery Gift can be used from the load screen
00034:   attr_accessor :mystery_gift_unlocked
00035:   # @return [Array<Array>] downloaded Mystery Gift data
