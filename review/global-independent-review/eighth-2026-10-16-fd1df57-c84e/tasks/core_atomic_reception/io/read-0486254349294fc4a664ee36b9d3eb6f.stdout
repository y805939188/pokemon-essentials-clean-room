00087: #===============================================================================
00088: # Decreases the target's Attack and Special Attack by 1 stage each. Then, user
00089: # switches out. Ignores trapping moves. (Parting Shot)
00090: #===============================================================================
00091: class Battle::Move::LowerTargetAtkSpAtk1SwitchOutUser < Battle::Move::TargetMultiStatDownMove
00092:   def initialize(battle, move)
00093:     super
00094:     @statDown = [:ATTACK, 1, :SPECIAL_ATTACK, 1]
00095:   end
00096: 
00097:   def pbEndOfMoveUsageEffect(user, targets, numHits, switchedBattlers)
00098:     switcher = user
00099:     targets.each do |b|
00100:       next if switchedBattlers.include?(b.index)
00101:       switcher = b if b.effects[PBEffects::MagicCoat] || b.effects[PBEffects::MagicBounce]
00102:     end
00103:     return if switcher.fainted? || numHits == 0
00104:     return if !@battle.pbCanChooseNonActive?(switcher.index)
00105:     @battle.pbDisplay(_INTL("{1} went back to {2}!", switcher.pbThis,
00106:                             @battle.pbGetOwnerName(switcher.index)))
00107:     @battle.pbPursuit(switcher.index)
00108:     return if switcher.fainted?
00109:     newPkmn = @battle.pbGetReplacementPokemonIndex(switcher.index)   # Owner chooses
00110:     return if newPkmn < 0
00111:     @battle.pbRecallAndReplace(switcher.index, newPkmn)
00112:     @battle.pbClearChoice(switcher.index)   # Replacement Pokémon does nothing this round
00113:     @battle.moldBreaker = false if switcher.index == user.index
00114:     @battle.pbOnBattlerEnteringBattle(switcher.index)
00115:     switchedBattlers.push(switcher.index)
00116:   end
00117: end
