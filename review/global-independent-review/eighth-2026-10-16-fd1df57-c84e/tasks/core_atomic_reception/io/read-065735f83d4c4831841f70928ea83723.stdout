00387:   def pbTeamIndexRangeFromBattlerIndex(idxBattler)
00388:     partyStarts = pbPartyStarts(idxBattler)
00389:     idxTrainer = pbGetOwnerIndexFromBattlerIndex(idxBattler)
00390:     idxPartyStart = partyStarts[idxTrainer]
00391:     idxPartyEnd   = (idxTrainer < partyStarts.length - 1) ? partyStarts[idxTrainer + 1] : pbParty(idxBattler).length
00392:     return idxPartyStart, idxPartyEnd
00393:   end
00394: 
00395:   def pbTeamLengthFromBattlerIndex(idxBattler)
00396:     idxPartyStart, idxPartyEnd = pbTeamIndexRangeFromBattlerIndex(idxBattler)
00397:     return idxPartyEnd - idxPartyStart
00398:   end
00399: 
00400:   def eachInTeamFromBattlerIndex(idxBattler)
00401:     party = pbParty(idxBattler)
00402:     idxPartyStart, idxPartyEnd = pbTeamIndexRangeFromBattlerIndex(idxBattler)
00403:     party.each_with_index { |pkmn, i| yield pkmn, i if pkmn && i >= idxPartyStart && i < idxPartyEnd }
00404:   end
00405: 
00406:   def eachInTeam(side, idxTrainer)
00407:     party       = pbParty(side)
00408:     partyStarts = pbPartyStarts(side)
00409:     idxPartyStart = partyStarts[idxTrainer]
00410:     idxPartyEnd   = (idxTrainer < partyStarts.length - 1) ? partyStarts[idxTrainer + 1] : party.length
00411:     party.each_with_index { |pkmn, i| yield pkmn, i if pkmn && i >= idxPartyStart && i < idxPartyEnd }
00412:   end
00413: 
00414:   # Used for Illusion.
00415:   # NOTE: This cares about the temporary rearranged order of the team. That is,
00416:   #       if you do some switching, the last Pokémon in the team could change
00417:   #       and the Illusion could be a different Pokémon.
00418:   def pbLastInTeam(idxBattler)
00419:     party       = pbParty(idxBattler)
00420:     partyOrders = pbPartyOrder(idxBattler)
00421:     idxPartyStart, idxPartyEnd = pbTeamIndexRangeFromBattlerIndex(idxBattler)
00422:     ret = -1
00423:     party.each_with_index do |pkmn, i|
00424:       next if i < idxPartyStart || i >= idxPartyEnd   # Check the team only
00425:       next if !pkmn || !pkmn.able?   # Can't copy a non-fainted Pokémon or egg
00426:       ret = i if ret < 0 || partyOrders[i] > partyOrders[ret]
00427:     end
00428:     return ret
00429:   end
00430: 
00431:   # Used to calculate money gained/lost after winning/losing a battle.
00432:   def pbMaxLevelInTeam(side, idxTrainer)
00433:     ret = 1
00434:     eachInTeam(side, idxTrainer) do |pkmn, _i|
00435:       ret = pkmn.level if pkmn.level > ret
00436:     end
00437:     return ret
00438:   end
00439: 
00440:   #=============================================================================
00441:   # Iterate through battlers
00442:   #=============================================================================
00443:   # Unused
00444:   def eachBattler
00445:     @battlers.each { |b| yield b if b && !b.fainted? }
00446:   end
00447: 
00448:   def allBattlers
00449:     return @battlers.select { |b| b && !b.fainted? }
00450:   end
00451: 
00452:   # Unused
00453:   def eachSameSideBattler(idxBattler = 0)
00454:     idxBattler = idxBattler.index if idxBattler.respond_to?("index")
00455:     @battlers.each { |b| yield b if b && !b.fainted? && !b.opposes?(idxBattler) }
00456:   end
00457: 
00458:   def allSameSideBattlers(idxBattler = 0)
00459:     idxBattler = idxBattler.index if idxBattler.respond_to?("index")
00460:     return @battlers.select { |b| b && !b.fainted? && !b.opposes?(idxBattler) }
00461:   end
00462: 
00463:   # Unused
00464:   def eachOtherSideBattler(idxBattler = 0)
00465:     idxBattler = idxBattler.index if idxBattler.respond_to?("index")
00466:     @battlers.each { |b| yield b if b && !b.fainted? && b.opposes?(idxBattler) }
00467:   end
00468: 
00469:   def allOtherSideBattlers(idxBattler = 0)
00470:     idxBattler = idxBattler.index if idxBattler.respond_to?("index")
00471:     return @battlers.select { |b| b && !b.fainted? && b.opposes?(idxBattler) }
00472:   end
00473: 
00474:   def pbSideBattlerCount(idxBattler = 0)
00475:     return allSameSideBattlers(idxBattler).length
00476:   end
00477: 
00478:   def pbOpposingBattlerCount(idxBattler = 0)
00479:     return allOtherSideBattlers(idxBattler).length
00480:   end
00481: 
00482:   # This method only counts the player's Pokémon, not a partner trainer's.
00483:   def pbPlayerBattlerCount
00484:     return allSameSideBattlers.select { |b| b.pbOwnedByPlayer? }.length
00485:   end
00486: 
00487:   def pbCheckGlobalAbility(abil)
00488:     allBattlers.each { |b| return b if b.hasActiveAbility?(abil) }
00489:     return nil
00490:   end
00491: 
00492:   def pbCheckOpposingAbility(abil, idxBattler = 0, nearOnly = false)
00493:     allOtherSideBattlers(idxBattler).each do |b|
00494:       next if nearOnly && !b.near?(idxBattler)
00495:       return b if b.hasActiveAbility?(abil)
00496:     end
00497:     return nil
00498:   end
00499: 
00500:   # Given a battler index, and using battle side sizes, returns an array of
00501:   # battler indices from the opposing side that are in order of most "opposite".
00502:   # Used when choosing a target and pressing up/down to move the cursor to the
00503:   # opposite side, and also when deciding which target to select first for some
00504:   # moves.
00505:   def pbGetOpposingIndicesInOrder(idxBattler)
00506:     case pbSideSize(0)
00507:     when 1
00508:       case pbSideSize(1)
00509:       when 1   # 1v1 single
00510:         return [0] if opposes?(idxBattler)
00511:         return [1]
