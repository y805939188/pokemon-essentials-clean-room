00485:   end
00486: 
00487:   def pbCheckGlobalAbility(abil)
00488:     allBattlers.each { |b| return b if b.hasActiveAbility?(abil) }
00489:     return nil
00490:   end
00491: 
00492:   def pbCheckOpposingAbility(abil, idxBattler = 0, nearOnly = false)
00493:     allOtherSideBattlers(idxBattler).each do |b|
00494:       next if nearOnly && !b.near?(idxBattler)
00495:       return b if b.hasActiveAbility?(abil)
00496:     end
00497:     return nil
00498:   end
00499: 
00500:   # Given a battler index, and using battle side sizes, returns an array of
00501:   # battler indices from the opposing side that are in order of most "opposite".
00502:   # Used when choosing a target and pressing up/down to move the cursor to the
00503:   # opposite side, and also when deciding which target to select first for some
00504:   # moves.
00505:   def pbGetOpposingIndicesInOrder(idxBattler)
00506:     case pbSideSize(0)
00507:     when 1
00508:       case pbSideSize(1)
00509:       when 1   # 1v1 single
00510:         return [0] if opposes?(idxBattler)
00511:         return [1]
00512:       when 2   # 1v2
00513:         return [0] if opposes?(idxBattler)
00514:         return [3, 1]
00515:       when 3   # 1v3
00516:         return [0] if opposes?(idxBattler)
00517:         return [3, 5, 1]
00518:       end
00519:     when 2
00520:       case pbSideSize(1)
00521:       when 1   # 2v1
00522:         return [0, 2] if opposes?(idxBattler)
00523:         return [1]
00524:       when 2   # 2v2 double
00525:         return [[3, 1], [2, 0], [1, 3], [0, 2]][idxBattler]
00526:       when 3   # 2v3
00527:         return [[5, 3, 1], [2, 0], [3, 1, 5]][idxBattler] if idxBattler < 3
00528:         return [0, 2]
00529:       end
00530:     when 3
00531:       case pbSideSize(1)
00532:       when 1   # 3v1
00533:         return [2, 0, 4] if opposes?(idxBattler)
00534:         return [1]
00535:       when 2   # 3v2
00536:         return [[3, 1], [2, 4, 0], [3, 1], [2, 0, 4], [1, 3]][idxBattler]
00537:       when 3   # 3v3 triple
00538:         return [[5, 3, 1], [4, 2, 0], [3, 5, 1], [2, 0, 4], [1, 3, 5], [0, 2, 4]][idxBattler]
00539:       end
00540:     end
00541:     return [idxBattler]
00542:   end
00543: 
00544:   #=============================================================================
00545:   # Comparing the positions of two battlers
00546:   #=============================================================================
00547:   def opposes?(idxBattler1, idxBattler2 = 0)
00548:     idxBattler1 = idxBattler1.index if idxBattler1.respond_to?("index")
00549:     idxBattler2 = idxBattler2.index if idxBattler2.respond_to?("index")
00550:     return (idxBattler1 & 1) != (idxBattler2 & 1)
00551:   end
00552: 
00553:   def nearBattlers?(idxBattler1, idxBattler2)
00554:     return false if idxBattler1 == idxBattler2
00555:     return true if pbSideSize(0) <= 2 && pbSideSize(1) <= 2
00556:     # Get all pairs of battler positions that are not close to each other
00557:     pairsArray = [[0, 4], [1, 5]]   # Covers 3v1 and 1v3
00558:     case pbSideSize(0)
00559:     when 3
00560:       case pbSideSize(1)
00561:       when 3   # 3v3 (triple)
00562:         pairsArray.push([0, 1])
00563:         pairsArray.push([4, 5])
00564:       when 2   # 3v2
00565:         pairsArray.push([0, 1])
00566:         pairsArray.push([3, 4])
00567:       end
00568:     when 2       # 2v3
00569:       pairsArray.push([0, 1])
00570:       pairsArray.push([2, 5])
00571:     end
00572:     # See if any pair matches the two battlers being assessed
00573:     pairsArray.each do |pair|
00574:       return false if pair.include?(idxBattler1) && pair.include?(idxBattler2)
00575:     end
00576:     return true
00577:   end
00578: 
00579:   #=============================================================================
