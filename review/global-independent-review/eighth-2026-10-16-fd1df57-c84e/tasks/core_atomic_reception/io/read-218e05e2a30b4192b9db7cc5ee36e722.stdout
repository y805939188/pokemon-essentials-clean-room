00136: GameData::Weather.register({
00137:   :id               => :HeavyRain,
00138:   :id_number        => 6,
00139:   :category         => :Rain,
00140:   :graphics         => [["storm_1", "storm_2", "storm_3", "storm_4"]],   # Last is splash
00141:   :particle_delta_x => -3600,
00142:   :particle_delta_y => 3600,
00143:   :tone_proc        => proc { |strength|
00144:     next Tone.new(-strength * 3 / 4, -strength * 3 / 4, -strength * 3 / 4, 10)
00145:   }
00146: })
00147: 
00148: # NOTE: This alters the screen tone in RPG::Weather#update_screen_tone.
00149: GameData::Weather.register({
00150:   :id               => :Sun,
00151:   :id_number        => 7,
00152:   :category         => :Sun,
00153:   :tone_proc        => proc { |strength|
00154:     next Tone.new(64, 64, 32, 0)
00155:   }
00156: })
00157: 
00158: GameData::Weather.register({
