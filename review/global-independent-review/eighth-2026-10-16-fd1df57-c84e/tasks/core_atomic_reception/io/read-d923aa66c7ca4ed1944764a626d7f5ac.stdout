00561: # The target uses its most recent move again. (Instruct)
00562: #===============================================================================
00563: class Battle::Move::TargetUsesItsLastUsedMoveAgain < Battle::Move
00564:   attr_reader :moveBlacklist
00565: 
00566:   def ignoresSubstitute?(user); return true; end
00567: 
00568:   def initialize(battle, move)
00569:     super
00570:     @moveBlacklist = [
00571:       "MultiTurnAttackBideThenReturnDoubleDamage",       # Bide
00572:       "ProtectUserFromDamagingMovesKingsShield",         # King's Shield
00573:       "TargetUsesItsLastUsedMoveAgain",                  # Instruct (this move)
00574:       # Struggle
00575:       "Struggle",                                        # Struggle
00576:       # Moves that affect the moveset
00577:       "ReplaceMoveThisBattleWithTargetLastMoveUsed",     # Mimic
00578:       "ReplaceMoveWithTargetLastMoveUsed",               # Sketch
00579:       "TransformUserIntoTarget",                         # Transform
00580:       # Moves that call other moves
00581:       "UseLastMoveUsedByTarget",                         # Mirror Move
00582:       "UseLastMoveUsed",                                 # Copycat
00583:       "UseMoveTargetIsAboutToUse",                       # Me First
00584:       "UseMoveDependingOnEnvironment",                   # Nature Power
00585:       "UseRandomUserMoveIfAsleep",                       # Sleep Talk
00586:       "UseRandomMoveFromUserParty",                      # Assist
00587:       "UseRandomMove",                                   # Metronome
00588:       # Moves that require a recharge turn
00589:       "AttackAndSkipNextTurn",                           # Hyper Beam
00590:       # Two-turn attacks
00591:       "TwoTurnAttack",                                   # Razor Wind
00592:       "TwoTurnAttackOneTurnInSun",                       # Solar Beam, Solar Blade
00593:       "TwoTurnAttackParalyzeTarget",                     # Freeze Shock
00594:       "TwoTurnAttackBurnTarget",                         # Ice Burn
00595:       "TwoTurnAttackFlinchTarget",                       # Sky Attack
00596:       "TwoTurnAttackChargeRaiseUserDefense1",            # Skull Bash
00597:       "TwoTurnAttackInvulnerableInSky",                  # Fly
00598:       "TwoTurnAttackInvulnerableUnderground",            # Dig
00599:       "TwoTurnAttackInvulnerableUnderwater",             # Dive
00600:       "TwoTurnAttackInvulnerableInSkyParalyzeTarget",    # Bounce
00601:       "TwoTurnAttackInvulnerableRemoveProtections",      # Shadow Force, Phantom Force
00602:       "TwoTurnAttackInvulnerableInSkyTargetCannotAct",   # Sky Drop
00603:       "AllBattlersLoseHalfHPUserSkipsNextTurn",          # Shadow Half
00604:       "TwoTurnAttackRaiseUserSpAtkSpDefSpd2",            # Geomancy
00605:       # Moves that start focussing at the start of the round
00606:       "FailsIfUserDamagedThisTurn",                      # Focus Punch
00607:       "UsedAfterUserTakesPhysicalDamage",                # Shell Trap
00608:       "BurnAttackerBeforeUserActs"                       # Beak Blast
00609:     ]
00610:   end
00611: 
00612:   def pbFailsAgainstTarget?(user, target, show_message)
00613:     if !target.lastRegularMoveUsed || !target.pbHasMove?(target.lastRegularMoveUsed) ||
00614:        !GameData::Move.exists?(target.lastRegularMoveUsed)
00615:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00616:       return true
00617:     end
00618:     if target.usingMultiTurnAttack?
00619:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00620:       return true
00621:     end
00622:     targetMove = @battle.choices[target.index][2]
00623:     if targetMove && (targetMove.function_code == "FailsIfUserDamagedThisTurn" ||   # Focus Punch
00624:                       targetMove.function_code == "UsedAfterUserTakesPhysicalDamage" ||   # Shell Trap
00625:                       targetMove.function_code == "BurnAttackerBeforeUserActs")    # Beak Blast
00626:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00627:       return true
00628:     end
00629:     if @moveBlacklist.include?(GameData::Move.get(target.lastRegularMoveUsed).function_code)
00630:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00631:       return true
00632:     end
00633:     idxMove = -1
00634:     target.eachMoveWithIndex do |m, i|
00635:       idxMove = i if m.id == target.lastRegularMoveUsed
00636:     end
00637:     if target.moves[idxMove].pp == 0 && target.moves[idxMove].total_pp > 0
00638:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00639:       return true
00640:     end
00641:     return false
00642:   end
00643: 
00644:   def pbEffectAgainstTarget(user, target)
00645:     target.effects[PBEffects::Instruct] = true
00646:   end
00647: end
00648: 
00649: #===============================================================================
