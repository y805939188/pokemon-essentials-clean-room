00277: Battle::ItemEffects::HPHeal.add(:BERRYJUICE,
00278:   proc { |item, battler, battle, forced|
00279:     next false if !battler.canHeal?
00280:     next false if !forced && battler.hp > battler.totalhp / 2
00281:     itemName = GameData::Item.get(item).name
00282:     PBDebug.log("[Item triggered] Forced consuming of #{itemName}") if forced
00283:     battle.pbCommonAnimation("UseItem", battler) if !forced
00284:     battler.pbRecoverHP(20)
00285:     if forced
00286:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
00287:     else
00288:       battle.pbDisplay(_INTL("{1} restored its health using its {2}!", battler.pbThis, itemName))
00289:     end
00290:     next true
00291:   }
00292: )
00293: 
00294: Battle::ItemEffects::HPHeal.add(:FIGYBERRY,
00295:   proc { |item, battler, battle, forced|
00296:     next battler.pbConfusionBerry(item, forced, :ATTACK,
00297:        _INTL("For {1}, the {2} was too spicy!", battler.pbThis(true), GameData::Item.get(item).name)
00298:     )
00299:   }
00300: )
00301: 
