00401: Battle::ItemEffects::HPHeal.add(:SITRUSBERRY,
00402:   proc { |item, battler, battle, forced|
00403:     next false if !battler.canHeal?
00404:     next false if !forced && !battler.canConsumePinchBerry?(false)
00405:     amt = battler.totalhp / 4
00406:     ripening = false
00407:     if battler.hasActiveAbility?(:RIPEN)
00408:       battle.pbShowAbilitySplash(battler, forced)
00409:       amt *= 2
00410:       ripening = true
00411:     end
00412:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00413:     battle.pbHideAbilitySplash(battler) if ripening
00414:     battler.pbRecoverHP(amt)
00415:     itemName = GameData::Item.get(item).name
00416:     if forced
00417:       PBDebug.log("[Item triggered] Forced consuming of #{itemName}")
00418:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
00419:     else
00420:       battle.pbDisplay(_INTL("{1} restored its health using its {2}!", battler.pbThis, itemName))
00421:     end
00422:     next true
00423:   }
00424: )
00425: 
00426: Battle::ItemEffects::HPHeal.add(:STARFBERRY,
00427:   proc { |item, battler, battle, forced|
00428:     stats = []
00429:     GameData::Stat.each_main_battle { |s| stats.push(s.id) if battler.pbCanRaiseStatStage?(s.id, battler) }
00430:     next false if stats.length == 0
00431:     stat = stats[battle.pbRandom(stats.length)]
00432:     next battler.pbStatIncreasingBerry(item, forced, stat, 2)
00433:   }
00434: )
00435: 
00436: Battle::ItemEffects::HPHeal.add(:WIKIBERRY,
00437:   proc { |item, battler, battle, forced|
00438:     next battler.pbConfusionBerry(item, forced, :SPECIAL_ATTACK,
00439:        _INTL("For {1}, the {2} was too dry!", battler.pbThis(true), GameData::Item.get(item).name)
00440:     )
00441:   }
00442: )
