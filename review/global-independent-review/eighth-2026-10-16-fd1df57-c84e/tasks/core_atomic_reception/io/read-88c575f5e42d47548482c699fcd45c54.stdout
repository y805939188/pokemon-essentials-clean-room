00345: 
00346: Battle::ItemEffects::HPHeal.add(:MICLEBERRY,
00347:   proc { |item, battler, battle, forced|
00348:     next false if !forced && !battler.canConsumePinchBerry?
00349:     next false if !battler.effects[PBEffects::MicleBerry]
00350:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00351:     battler.effects[PBEffects::MicleBerry] = true
00352:     itemName = GameData::Item.get(item).name
00353:     if forced
00354:       PBDebug.log("[Item triggered] Forced consuming of #{itemName}")
00355:       battle.pbDisplay(_INTL("{1} boosted the accuracy of its next move!", battler.pbThis))
00356:     else
00357:       battle.pbDisplay(_INTL("{1} boosted the accuracy of its next move using its {2}!",
00358:          battler.pbThis, itemName))
00359:     end
00360:     next true
00361:   }
00362: )
00363: 
00364: Battle::ItemEffects::HPHeal.add(:ORANBERRY,
00365:   proc { |item, battler, battle, forced|
00366:     next false if !battler.canHeal?
00367:     next false if !forced && !battler.canConsumePinchBerry?(false)
00368:     amt = 10
00369:     ripening = false
00370:     if battler.hasActiveAbility?(:RIPEN)
00371:       battle.pbShowAbilitySplash(battler, forced)
00372:       amt *= 2
00373:       ripening = true
00374:     end
00375:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00376:     battle.pbHideAbilitySplash(battler) if ripening
00377:     battler.pbRecoverHP(amt)
00378:     itemName = GameData::Item.get(item).name
00379:     if forced
00380:       PBDebug.log("[Item triggered] Forced consuming of #{itemName}")
00381:       battle.pbDisplay(_INTL("{1}'s HP was restored.", battler.pbThis))
00382:     else
00383:       battle.pbDisplay(_INTL("{1} restored a little HP using its {2}!", battler.pbThis, itemName))
00384:     end
00385:     next true
00386:   }
00387: )
00388: 
00389: Battle::ItemEffects::HPHeal.add(:PETAYABERRY,
00390:   proc { |item, battler, battle, forced|
00391:     next battler.pbStatIncreasingBerry(item, forced, :SPECIAL_ATTACK)
00392:   }
00393: )
00394: 
