00316: Battle::ItemEffects::HPHeal.add(:LANSATBERRY,
00317:   proc { |item, battler, battle, forced|
00318:     next false if !forced && !battler.canConsumePinchBerry?
00319:     next false if battler.effects[PBEffects::FocusEnergy] >= 2
00320:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00321:     battler.effects[PBEffects::FocusEnergy] = 2
00322:     itemName = GameData::Item.get(item).name
00323:     if forced
00324:       battle.pbDisplay(_INTL("{1} got pumped from the {2}!", battler.pbThis, itemName))
00325:     else
00326:       battle.pbDisplay(_INTL("{1} used its {2} to get pumped!", battler.pbThis, itemName))
00327:     end
00328:     next true
00329:   }
00330: )
00331: 
