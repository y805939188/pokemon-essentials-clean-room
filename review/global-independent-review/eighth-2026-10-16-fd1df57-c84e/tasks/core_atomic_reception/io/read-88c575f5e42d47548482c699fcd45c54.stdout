00444: #===============================================================================
00445: # OnStatLoss handlers
00446: #===============================================================================
00447: Battle::ItemEffects::OnStatLoss.add(:EJECTPACK,
00448:   proc { |item, battler, move_user, battle|
00449:     next false if battler.effects[PBEffects::SkyDrop] >= 0 ||
00450:                   battler.inTwoTurnAttack?("TwoTurnAttackInvulnerableInSkyTargetCannotAct")   # Sky Drop
00451:     next false if battle.pbAllFainted?(battler.idxOpposingSide)
00452:     next false if battler.wild?   # Wild Pokémon can't eject
00453:     next false if !battle.pbCanSwitchOut?(battler.index)   # Battler can't switch out
00454:     next false if !battle.pbCanChooseNonActive?(battler.index)   # No Pokémon can switch in
00455:     battle.pbCommonAnimation("UseItem", battler)
00456:     battle.pbDisplay(_INTL("{1} is switched out by the {2}!", battler.pbThis, battler.itemName))
00457:     battler.pbConsumeItem(true, false)
00458:     if battle.endOfRound   # Just switch out
00459:       battle.scene.pbRecall(battler.index) if !battler.fainted?
00460:       battler.pbAbilitiesOnSwitchOut   # Inc. primordial weather check
00461:       next true
00462:     end
00463:     newPkmn = battle.pbGetReplacementPokemonIndex(battler.index)   # Owner chooses
00464:     next false if newPkmn < 0   # Shouldn't ever do this
00465:     battle.pbRecallAndReplace(battler.index, newPkmn)
00466:     battle.pbClearChoice(battler.index)   # Replacement Pokémon does nothing this round
00467:     battle.moldBreaker = false if move_user && battler.index == move_user.index
00468:     battle.pbOnBattlerEnteringBattle(battler.index)
00469:     next true
00470:   }
00471: )
00472: 
00473: #===============================================================================
00474: # StatusCure handlers
00475: #===============================================================================
00476: 
00477: Battle::ItemEffects::StatusCure.add(:ASPEARBERRY,
00478:   proc { |item, battler, battle, forced|
00479:     next false if !forced && !battler.canConsumeBerry?
00480:     next false if battler.status != :FROZEN
00481:     itemName = GameData::Item.get(item).name
00482:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00483:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00484:     battler.pbCureStatus(forced)
00485:     battle.pbDisplay(_INTL("{1}'s {2} defrosted it!", battler.pbThis, itemName)) if !forced
00486:     next true
00487:   }
00488: )
00489: 
00490: Battle::ItemEffects::StatusCure.add(:CHERIBERRY,
00491:   proc { |item, battler, battle, forced|
00492:     next false if !forced && !battler.canConsumeBerry?
00493:     next false if battler.status != :PARALYSIS
00494:     itemName = GameData::Item.get(item).name
00495:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00496:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00497:     battler.pbCureStatus(forced)
00498:     battle.pbDisplay(_INTL("{1}'s {2} cured its paralysis!", battler.pbThis, itemName)) if !forced
00499:     next true
00500:   }
00501: )
00502: 
00503: Battle::ItemEffects::StatusCure.add(:CHESTOBERRY,
00504:   proc { |item, battler, battle, forced|
00505:     next false if !forced && !battler.canConsumeBerry?
00506:     next false if battler.status != :SLEEP
00507:     itemName = GameData::Item.get(item).name
00508:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00509:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00510:     battler.pbCureStatus(forced)
00511:     battle.pbDisplay(_INTL("{1}'s {2} woke it up!", battler.pbThis, itemName)) if !forced
00512:     next true
00513:   }
00514: )
00515: 
00516: Battle::ItemEffects::StatusCure.add(:LUMBERRY,
00517:   proc { |item, battler, battle, forced|
00518:     next false if !forced && !battler.canConsumeBerry?
00519:     next false if battler.status == :NONE &&
00520:                   battler.effects[PBEffects::Confusion] == 0
00521:     itemName = GameData::Item.get(item).name
00522:     PBDebug.log("[Item triggered] #{battler.pbThis}'s #{itemName}") if forced
00523:     battle.pbCommonAnimation("EatBerry", battler) if !forced
00524:     oldStatus = battler.status
00525:     oldConfusion = (battler.effects[PBEffects::Confusion] > 0)
00526:     battler.pbCureStatus(forced)
00527:     battler.pbCureConfusion
00528:     if forced
00529:       battle.pbDisplay(_INTL("{1} snapped out of its confusion.", battler.pbThis)) if oldConfusion
00530:     else
00531:       case oldStatus
00532:       when :SLEEP
00533:         battle.pbDisplay(_INTL("{1}'s {2} woke it up!", battler.pbThis, itemName))
00534:       when :POISON
00535:         battle.pbDisplay(_INTL("{1}'s {2} cured its poisoning!", battler.pbThis, itemName))
00536:       when :BURN
00537:         battle.pbDisplay(_INTL("{1}'s {2} healed its burn!", battler.pbThis, itemName))
00538:       when :PARALYSIS
00539:         battle.pbDisplay(_INTL("{1}'s {2} cured its paralysis!", battler.pbThis, itemName))
00540:       when :FROZEN
00541:         battle.pbDisplay(_INTL("{1}'s {2} defrosted it!", battler.pbThis, itemName))
00542:       end
00543:       if oldConfusion
00544:         battle.pbDisplay(_INTL("{1}'s {2} snapped it out of its confusion!", battler.pbThis, itemName))
00545:       end
00546:     end
00547:     next true
00548:   }
00549: )
00550: 
