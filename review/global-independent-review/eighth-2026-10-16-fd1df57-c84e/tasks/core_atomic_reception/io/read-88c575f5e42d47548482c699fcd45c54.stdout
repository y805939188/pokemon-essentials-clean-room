00263: Battle::ItemEffects::HPHeal.add(:AGUAVBERRY,
00264:   proc { |item, battler, battle, forced|
00265:     next battler.pbConfusionBerry(item, forced, :SPECIAL_DEFENSE,
00266:        _INTL("For {1}, the {2} was too bitter!", battler.pbThis(true), GameData::Item.get(item).name)
00267:     )
00268:   }
00269: )
00270: 
00271: Battle::ItemEffects::HPHeal.add(:APICOTBERRY,
00272:   proc { |item, battler, battle, forced|
00273:     next battler.pbStatIncreasingBerry(item, forced, :SPECIAL_DEFENSE)
00274:   }
00275: )
