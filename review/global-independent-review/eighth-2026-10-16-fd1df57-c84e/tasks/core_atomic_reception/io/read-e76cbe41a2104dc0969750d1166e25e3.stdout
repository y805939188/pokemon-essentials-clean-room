01159:   def initialize(species, level, owner = $player, withMoves = true, recheck_form = true)
01160:     species_data = GameData::Species.get(species)
01161:     @species          = species_data.species
01162:     @form             = species_data.base_form
01163:     @forced_form      = nil
01164:     @time_form_set    = nil
01165:     self.level        = level
01166:     @steps_to_hatch   = 0
01167:     heal_status
01168:     @gender           = nil
01169:     @shiny            = nil
01170:     @ability_index    = nil
01171:     @ability          = nil
01172:     @nature           = nil
01173:     @nature_for_stats = nil
01174:     @item             = nil
01175:     @mail             = nil
01176:     @moves            = []
01177:     reset_moves if withMoves
01178:     @first_moves      = []
01179:     @ribbons          = []
01180:     @cool             = 0
01181:     @beauty           = 0
01182:     @cute             = 0
01183:     @smart            = 0
01184:     @tough            = 0
01185:     @sheen            = 0
01186:     @pokerus          = 0
01187:     @name             = nil
01188:     @happiness        = species_data.happiness
01189:     @poke_ball        = :POKEBALL
01190:     @markings         = []
01191:     @iv               = {}
01192:     @ivMaxed          = {}
01193:     @ev               = {}
01194:     GameData::Stat.each_main do |s|
01195:       @iv[s.id]       = rand(IV_STAT_LIMIT + 1)
01196:       @ev[s.id]       = 0
01197:     end
01198:     case owner
01199:     when Owner
01200:       @owner = owner
01201:     when Player, NPCTrainer
01202:       @owner = Owner.new_from_trainer(owner)
01203:     else
01204:       @owner = Owner.new(0, "", 2, 2)
01205:     end
01206:     @obtain_method    = 0   # Met
01207:     @obtain_method    = 4 if $game_switches && $game_switches[Settings::FATEFUL_ENCOUNTER_SWITCH]
01208:     @obtain_map       = ($game_map) ? $game_map.map_id : 0
01209:     @obtain_text      = nil
01210:     @obtain_level     = level
01211:     @hatched_map      = 0
01212:     @timeReceived     = Time.now.to_i
01213:     @timeEggHatched   = nil
01214:     @fused            = nil
01215:     @personalID       = rand(2**16) | (rand(2**16) << 16)
01216:     @hp               = 1
01217:     @totalhp          = 1
01218:     calc_stats
01219:     if @form == 0 && recheck_form
01220:       f = MultipleForms.call("getFormOnCreation", self)
01221:       if f
01222:         self.form = f
01223:         reset_moves if withMoves
01224:       end
01225:     end
01226:   end
01227: end
