00418: #
00419: #===============================================================================
00420: # Record current heart gauges of Pokémon in party, to see if they drop to zero
00421: # during battle and need to say they're ready to be purified afterwards
00422: EventHandlers.add(:on_start_battle, :record_party_heart_gauges,
00423:   proc {
00424:     $game_temp.party_heart_gauges_before_battle = []
00425:     $player.party.each_with_index do |pkmn, i|
00426:       $game_temp.party_heart_gauges_before_battle[i] = pkmn.heart_gauge
00427:     end
00428:   }
00429: )
00430: 
00431: EventHandlers.add(:on_end_battle, :check_ready_to_purify,
00432:   proc { |_decision, _canLose|
00433:     $game_temp.party_heart_gauges_before_battle.each_with_index do |value, i|
00434:       pkmn = $player.party[i]
00435:       next if !pkmn || !value || value == 0
