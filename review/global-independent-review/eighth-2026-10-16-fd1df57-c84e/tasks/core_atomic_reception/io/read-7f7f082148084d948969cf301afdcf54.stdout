00814:   def drawSelectedMove(move_to_learn, selected_move)
00815:     # Draw all of page four, except selected move's details
00816:     drawPageFourSelecting(move_to_learn)
00817:     # Set various values
00818:     overlay = @sprites["overlay"].bitmap
00819:     base = Color.new(64, 64, 64)
00820:     shadow = Color.new(176, 176, 176)
00821:     @sprites["pokemon"].visible = false if @sprites["pokemon"]
00822:     @sprites["pokeicon"].pokemon = @pokemon
00823:     @sprites["pokeicon"].visible = true
00824:     @sprites["itemicon"].visible = false if @sprites["itemicon"]
00825:     textpos = []
00826:     # Write power and accuracy values for selected move
00827:     case selected_move.display_damage(@pokemon)
00828:     when 0 then textpos.push(["---", 216, 160, :right, base, shadow])   # Status move
00829:     when 1 then textpos.push(["???", 216, 160, :right, base, shadow])   # Variable power move
00830:     else        textpos.push([selected_move.display_damage(@pokemon).to_s, 216, 160, :right, base, shadow])
00831:     end
00832:     if selected_move.display_accuracy(@pokemon) == 0
00833:       textpos.push(["---", 216, 192, :right, base, shadow])
00834:     else
00835:       textpos.push(["#{selected_move.display_accuracy(@pokemon)}%", 216 + overlay.text_size("%").width, 192, :right, base, shadow])
00836:     end
00837:     # Draw all text
00838:     pbDrawTextPositions(overlay, textpos)
00839:     # Draw selected move's damage category icon
00840:     imagepos = [["Graphics/UI/category", 166, 124, 0, selected_move.display_category(@pokemon) * 28, 64, 28]]
00841:     pbDrawImagePositions(overlay, imagepos)
00842:     # Draw selected move's description
00843:     drawTextEx(overlay, 4, 224, 230, 5, selected_move.description, base, shadow)
00844:   end
00845: 
00846:   def drawPageFive
00847:     overlay = @sprites["overlay"].bitmap
00848:     @sprites["uparrow"].visible   = false
00849:     @sprites["downarrow"].visible = false
00850:     # Write various bits of text
00851:     textpos = [
00852:       [_INTL("No. of Ribbons:"), 234, 338, :left, Color.new(64, 64, 64), Color.new(176, 176, 176)],
00853:       [@pokemon.numRibbons.to_s, 450, 338, :right, Color.new(64, 64, 64), Color.new(176, 176, 176)]
00854:     ]
00855:     # Draw all text
00856:     pbDrawTextPositions(overlay, textpos)
00857:     # Show all ribbons
00858:     imagepos = []
00859:     coord = 0
00860:     (@ribbonOffset * 4...(@ribbonOffset * 4) + 12).each do |i|
00861:       break if !@pokemon.ribbons[i]
00862:       ribbon_data = GameData::Ribbon.get(@pokemon.ribbons[i])
00863:       ribn = ribbon_data.icon_position
00864:       imagepos.push(["Graphics/UI/Summary/ribbons",
00865:                      230 + (68 * (coord % 4)), 78 + (68 * (coord / 4).floor),
00866:                      64 * (ribn % 8), 64 * (ribn / 8).floor, 64, 64])
00867:       coord += 1
00868:     end
00869:     # Draw all images
00870:     pbDrawImagePositions(overlay, imagepos)
00871:   end
00872: 
00873:   def drawSelectedRibbon(ribbonid)
00874:     # Draw all of page five
00875:     drawPage(5)
