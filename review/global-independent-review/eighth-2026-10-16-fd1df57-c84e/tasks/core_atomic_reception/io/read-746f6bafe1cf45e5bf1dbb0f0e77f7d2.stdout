00001: #===============================================================================
00002: # Battle preparation
00003: #===============================================================================
00004: class PokemonGlobalMetadata
00005:   attr_accessor :nextBattleBGM
00006:   attr_accessor :nextBattleVictoryBGM
00007:   attr_accessor :nextBattleCaptureME
00008:   attr_accessor :nextBattleBack
