00188:       when 2
00189:         pbDisplayPaused(_INTL("You are challenged by {1} and {2}!", @opponent[0].full_name,
00190:                               @opponent[1].full_name))
00191:       when 3
00192:         pbDisplayPaused(_INTL("You are challenged by {1}, {2} and {3}!",
