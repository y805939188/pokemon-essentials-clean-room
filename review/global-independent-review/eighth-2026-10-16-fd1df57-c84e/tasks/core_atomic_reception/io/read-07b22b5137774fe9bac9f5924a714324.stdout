00001: class Pokemon
00002:   #=============================================================================
00003:   # Mega Evolution
00004:   # NOTE: These are treated as form changes in Essentials.
00005:   #=============================================================================
00006:   def getMegaForm
00007:     ret = 0
00008:     GameData::Species.each do |data|
00009:       next if data.species != @species || data.unmega_form != form_simple
00010:       if data.mega_stone && hasItem?(data.mega_stone)
00011:         ret = data.form
00012:         break
00013:       elsif data.mega_move && hasMove?(data.mega_move)
00014:         ret = data.form
00015:         break
00016:       end
00017:     end
00018:     return ret   # form number, or 0 if no accessible Mega form
00019:   end
00020: 
00021:   def getUnmegaForm
00022:     return (mega?) ? species_data.unmega_form : -1
00023:   end
00024: 
00025:   def hasMegaForm?
00026:     megaForm = self.getMegaForm
00027:     return megaForm > 0 && megaForm != form_simple
00028:   end
00029: 
00030:   def mega?
00031:     return (species_data.mega_stone || species_data.mega_move) ? true : false
00032:   end
00033: 
00034:   def makeMega
00035:     megaForm = self.getMegaForm
00036:     self.form = megaForm if megaForm > 0
00037:   end
00038: 
00039:   def makeUnmega
00040:     unmegaForm = self.getUnmegaForm
00041:     self.form = unmegaForm if unmegaForm >= 0
00042:   end
00043: 
00044:   def megaName
00045:     formName = species_data.form_name
00046:     return (formName && !formName.empty?) ? formName : _INTL("Mega {1}", species_data.name)
00047:   end
00048: 
00049:   # 0=default message, 1=Rayquaza message.
00050:   def megaMessage
00051:     megaForm = self.getMegaForm
00052:     message_number = GameData::Species.get_species_form(@species, megaForm)&.mega_message
00053:     return message_number || 0
00054:   end
00055: 
00056:   #=============================================================================
00057:   # Primal Reversion
00058:   # NOTE: These are treated as form changes in Essentials.
00059:   #=============================================================================
00060:   def hasPrimalForm?
00061:     v = MultipleForms.call("getPrimalForm", self)
00062:     return !v.nil?
00063:   end
00064: 
00065:   def primal?
00066:     v = MultipleForms.call("getPrimalForm", self)
00067:     return !v.nil? && v == @form
00068:   end
00069: 
00070:   def makePrimal
00071:     v = MultipleForms.call("getPrimalForm", self)
00072:     self.form = v if !v.nil?
00073:   end
00074: 
00075:   def makeUnprimal
00076:     v = MultipleForms.call("getUnprimalForm", self)
00077:     if !v.nil?
00078:       self.form = v
00079:     elsif primal?
00080:       self.form = 0
00081:     end
00082:   end
00083: end
