00090:   # Max total EVs
00091:   EV_LIMIT      = 510
00092:   # Max EVs that a single stat can have
00093:   EV_STAT_LIMIT = 252
00094:   # Maximum length a Pokémon's nickname can be
00095:   MAX_NAME_SIZE = 10
00096:   # Maximum number of moves a Pokémon can know at once
00097:   MAX_MOVES     = 4
00098: 
00099:   def self.play_cry(species, form = 0, volume = 90, pitch = 100)
