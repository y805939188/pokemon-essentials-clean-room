00654: class Battle::Move::StartPreventCriticalHitsAgainstUserSide < Battle::Move
00655:   def canSnatch?; return true; end
00656: 
00657:   def pbMoveFailed?(user, targets)
00658:     if user.pbOwnSide.effects[PBEffects::LuckyChant] > 0
00659:       @battle.pbDisplay(_INTL("But it failed!"))
00660:       return true
00661:     end
00662:     return false
00663:   end
00664: 
00665:   def pbEffectGeneral(user)
00666:     user.pbOwnSide.effects[PBEffects::LuckyChant] = 5
00667:     @battle.pbDisplay(_INTL("The Lucky Chant shielded {1} from critical hits!", user.pbTeam(true)))
00668:   end
00669: end
00670: 
00671: #===============================================================================
00672: # If target would be KO'd by this attack, it survives with 1HP instead.
