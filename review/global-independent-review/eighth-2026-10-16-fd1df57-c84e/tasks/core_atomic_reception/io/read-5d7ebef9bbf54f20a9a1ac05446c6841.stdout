00087:   # Register all caught Pokémon in the Pokédex, and store them.
00088:   def pbRecordAndStoreCaughtPokemon
00089:     @caughtPokemon.each do |pkmn|
00090:       pbSetCaught(pkmn)
00091:       pbSetSeen(pkmn)   # In case the form changed upon leaving battle
00092:       # Record the Pokémon's species as owned in the Pokédex
00093:       if !pbPlayer.owned?(pkmn.species)
00094:         pbPlayer.pokedex.set_owned(pkmn.species)
00095:         if $player.has_pokedex && $player.pokedex.species_in_unlocked_dex?(pkmn.species)
00096:           pbDisplayPaused(_INTL("{1}'s data was added to the Pokédex.", pkmn.name))
00097:           pbPlayer.pokedex.register_last_seen(pkmn)
00098:           @scene.pbShowPokedex(pkmn.species)
00099:         end
00100:       end
00101:       # Record a Shadow Pokémon's species as having been caught
00102:       pbPlayer.pokedex.set_shadow_pokemon_owned(pkmn.species) if pkmn.shadowPokemon?
00103:       # Store caught Pokémon
00104:       pbStorePokemon(pkmn)
00105:     end
00106:     @caughtPokemon.clear
00107:   end
