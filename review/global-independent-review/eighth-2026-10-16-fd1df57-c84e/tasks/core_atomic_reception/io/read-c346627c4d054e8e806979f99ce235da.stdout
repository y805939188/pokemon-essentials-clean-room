00575:     end
00576:     return true
00577:   end
00578: 
00579:   #=============================================================================
00580:   # Altering a party or rearranging battlers
00581:   #=============================================================================
00582:   def pbRemoveFromParty(idxBattler, idxParty)
00583:     party = pbParty(idxBattler)
00584:     # Erase the Pokémon from the party
00585:     party[idxParty] = nil
00586:     # Rearrange the display order of the team to place the erased Pokémon last
00587:     # in it (to avoid gaps)
00588:     partyOrders = pbPartyOrder(idxBattler)
00589:     partyStarts = pbPartyStarts(idxBattler)
00590:     idxTrainer = pbGetOwnerIndexFromPartyIndex(idxBattler, idxParty)
00591:     idxPartyStart = partyStarts[idxTrainer]
00592:     idxPartyEnd   = (idxTrainer < partyStarts.length - 1) ? partyStarts[idxTrainer + 1] : party.length
00593:     origPartyPos = partyOrders[idxParty]   # Position of erased Pokémon initially
00594:     partyOrders[idxParty] = idxPartyEnd   # Put erased Pokémon last in the team
00595:     party.each_with_index do |_pkmn, i|
00596:       next if i < idxPartyStart || i >= idxPartyEnd   # Only check the team
00597:       next if partyOrders[i] < origPartyPos   # Appeared before erased Pokémon
00598:       partyOrders[i] -= 1   # Appeared after erased Pokémon; bump it up by 1
00599:     end
00600:   end
00601: 
