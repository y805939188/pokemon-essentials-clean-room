00443:   def pbCanConfuse?(user = nil, showMessages = true, move = nil, selfInflicted = false)
00444:     return false if fainted?
00445:     if @effects[PBEffects::Confusion] > 0
00446:       @battle.pbDisplay(_INTL("{1} is already confused.", pbThis)) if showMessages
00447:       return false
00448:     end
00449:     if @effects[PBEffects::Substitute] > 0 && !(move && move.ignoresSubstitute?(user)) &&
00450:        !selfInflicted
00451:       @battle.pbDisplay(_INTL("But it failed!")) if showMessages
00452:       return false
00453:     end
00454:     # Terrains immunity
00455:     if affectedByTerrain? && @battle.field.terrain == :Misty && Settings::MECHANICS_GENERATION >= 7
00456:       @battle.pbDisplay(_INTL("{1} surrounds itself with misty terrain!", pbThis(true))) if showMessages
00457:       return false
00458:     end
00459:     if (selfInflicted || !@battle.moldBreaker) && hasActiveAbility?(:OWNTEMPO)
00460:       if showMessages
00461:         @battle.pbShowAbilitySplash(self)
00462:         if Battle::Scene::USE_ABILITY_SPLASH
00463:           @battle.pbDisplay(_INTL("{1} doesn't become confused!", pbThis))
00464:         else
00465:           @battle.pbDisplay(_INTL("{1}'s {2} prevents confusion!", pbThis, abilityName))
00466:         end
00467:         @battle.pbHideAbilitySplash(self)
00468:       end
00469:       return false
00470:     end
00471:     if pbOwnSide.effects[PBEffects::Safeguard] > 0 && !selfInflicted &&
00472:        !(user && user.hasActiveAbility?(:INFILTRATOR))
00473:       @battle.pbDisplay(_INTL("{1}'s team is protected by Safeguard!", pbThis)) if showMessages
00474:       return false
00475:     end
00476:     return true
00477:   end
