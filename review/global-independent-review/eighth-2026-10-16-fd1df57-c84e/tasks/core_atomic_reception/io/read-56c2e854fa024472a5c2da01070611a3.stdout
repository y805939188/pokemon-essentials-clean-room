00289:   def pbSendOut(sendOuts, startBattle = false)
00290:     sendOuts.each { |b| @peer.pbOnEnteringBattle(self, @battlers[b[0]], b[1]) }
00291:     @scene.pbSendOutBattlers(sendOuts, startBattle)
00292:     sendOuts.each do |b|
00293:       @scene.pbResetCommandsIndex(b[0])
00294:       pbSetSeen(@battlers[b[0]])
00295:       @usedInBattle[b[0] & 1][b[0] / 2] = true
00296:     end
00297:   end
00298: 
00299:   #=============================================================================
