00436: class Battle::Move::ProtectMove < Battle::Move
00437:   def initialize(battle, move)
00438:     super
00439:     @sidedEffect = false
00440:   end
00441: 
00442:   def pbChangeUsageCounters(user, specialUsage)
00443:     oldVal = user.effects[PBEffects::ProtectRate]
00444:     super
00445:     user.effects[PBEffects::ProtectRate] = oldVal
00446:   end
00447: 
00448:   def pbMoveFailed?(user, targets)
00449:     if @sidedEffect
00450:       if user.pbOwnSide.effects[@effect]
00451:         user.effects[PBEffects::ProtectRate] = 1
00452:         @battle.pbDisplay(_INTL("But it failed!"))
00453:         return true
00454:       end
00455:     elsif user.effects[@effect]
00456:       user.effects[PBEffects::ProtectRate] = 1
00457:       @battle.pbDisplay(_INTL("But it failed!"))
00458:       return true
00459:     end
00460:     if (!@sidedEffect || Settings::MECHANICS_GENERATION <= 5) &&
00461:        user.effects[PBEffects::ProtectRate] > 1 &&
00462:        @battle.pbRandom(user.effects[PBEffects::ProtectRate]) != 0
00463:       user.effects[PBEffects::ProtectRate] = 1
00464:       @battle.pbDisplay(_INTL("But it failed!"))
00465:       return true
00466:     end
00467:     if pbMoveFailedLastInRound?(user)
00468:       user.effects[PBEffects::ProtectRate] = 1
00469:       return true
00470:     end
00471:     return false
00472:   end
00473: 
00474:   def pbEffectGeneral(user)
00475:     if @sidedEffect
00476:       user.pbOwnSide.effects[@effect] = true
00477:     else
00478:       user.effects[@effect] = true
00479:     end
00480:     user.effects[PBEffects::ProtectRate] *= (Settings::MECHANICS_GENERATION >= 6) ? 3 : 2
00481:     pbProtectMessage(user)
00482:   end
00483: 
00484:   def pbProtectMessage(user)
00485:     if @sidedEffect
00486:       @battle.pbDisplay(_INTL("{1} protected {2}!", @name, user.pbTeam(true)))
00487:     else
00488:       @battle.pbDisplay(_INTL("{1} protected itself!", user.pbThis))
00489:     end
00490:   end
00491: end
