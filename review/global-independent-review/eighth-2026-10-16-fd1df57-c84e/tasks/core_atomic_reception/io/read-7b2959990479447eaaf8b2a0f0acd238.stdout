00340: def pbEventFacesPlayer?(event, player, distance)
00341:   return false if !event || !player || distance <= 0
00342:   x_min = x_max = y_min = y_max = -1
00343:   case event.direction
00344:   when 2   # Down
00345:     x_min = event.x
00346:     x_max = event.x + event.width - 1
00347:     y_min = event.y + 1
00348:     y_max = event.y + distance
00349:   when 4   # Left
00350:     x_min = event.x - distance
00351:     x_max = event.x - 1
00352:     y_min = event.y - event.height + 1
00353:     y_max = event.y
00354:   when 6   # Right
00355:     x_min = event.x + event.width
00356:     x_max = event.x + event.width - 1 + distance
00357:     y_min = event.y - event.height + 1
00358:     y_max = event.y
00359:   when 8   # Up
00360:     x_min = event.x
00361:     x_max = event.x + event.width - 1
00362:     y_min = event.y - event.height + 1 - distance
00363:     y_max = event.y - event.height
00364:   else
00365:     return false
00366:   end
00367:   return player.x >= x_min && player.x <= x_max &&
00368:          player.y >= y_min && player.y <= y_max
00369: end
00370: 
00371: # Returns whether event is able to walk up to the player.
00372: def pbEventCanReachPlayer?(event, player, distance)
00373:   return false if !pbEventFacesPlayer?(event, player, distance)
00374:   delta_x = (event.direction == 6) ? 1 : (event.direction == 4) ? -1 : 0
00375:   delta_y = (event.direction == 2) ? 1 : (event.direction == 8) ? -1 : 0
00376:   case event.direction
00377:   when 2   # Down
00378:     real_distance = player.y - event.y - 1
00379:   when 4   # Left
00380:     real_distance = event.x - player.x - 1
00381:   when 6   # Right
00382:     real_distance = player.x - event.x - event.width
00383:   when 8   # Up
00384:     real_distance = event.y - event.height - player.y
00385:   end
00386:   if real_distance > 0
00387:     real_distance.times do |i|
00388:       return false if !event.can_move_from_coordinate?(event.x + (i * delta_x), event.y + (i * delta_y), event.direction)
00389:     end
00390:   end
00391:   return true
00392: end
00393: 
00394: # Returns whether the two events are standing next to each other and facing each
00395: # other.
00396: def pbFacingEachOther(event1, event2)
00397:   return pbEventFacesPlayer?(event1, event2, 1) && pbEventFacesPlayer?(event2, event1, 1)
00398: end
00399: 
00400: #===============================================================================
00401: # Audio playing
00402: #===============================================================================
00403: def pbCueBGM(bgm, seconds, volume = nil, pitch = nil)
00404:   return if !bgm
00405:   bgm = pbResolveAudioFile(bgm, volume, pitch)
00406:   playingBGM = $game_system.playing_bgm
00407:   if !playingBGM || playingBGM.name != bgm.name || playingBGM.pitch != bgm.pitch
00408:     pbBGMFade(seconds)
00409:     $game_temp.cue_bgm = bgm
