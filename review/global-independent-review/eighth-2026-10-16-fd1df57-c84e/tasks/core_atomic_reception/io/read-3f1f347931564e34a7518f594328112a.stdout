00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: class Battle::AI
00005:   attr_reader :battle
00006:   attr_reader :trainer
00007:   attr_reader :battlers
00008:   attr_reader :user, :target, :move
00009: 
00010:   def initialize(battle)
00011:     @battle = battle
00012:   end
00013: 
00014:   def create_ai_objects
00015:     # Initialize AI trainers
00016:     @trainers = [[], []]
00017:     @battle.player.each_with_index do |trainer, i|
00018:       @trainers[0][i] = AITrainer.new(self, 0, i, trainer)
00019:     end
00020:     if @battle.wildBattle?
00021:       @trainers[1][0] = AITrainer.new(self, 1, 0, nil)
00022:     else
00023:       @battle.opponent.each_with_index do |trainer, i|
00024:         @trainers[1][i] = AITrainer.new(self, 1, i, trainer)
00025:       end
00026:     end
00027:     # Initialize AI battlers
00028:     @battlers = []
00029:     @battle.battlers.each_with_index do |battler, i|
00030:       @battlers[i] = AIBattler.new(self, i) if battler
00031:     end
00032:     # Initialize AI move object
00033:     @move = AIMove.new(self)
00034:   end
00035: 
00036:   # Set some class variables for the Pokémon whose action is being chosen
00037:   def set_up(idxBattler)
00038:     # Find the AI trainer choosing the action
00039:     opposes = @battle.opposes?(idxBattler)
00040:     trainer_index = @battle.pbGetOwnerIndexFromBattlerIndex(idxBattler)
00041:     @trainer = @trainers[(opposes) ? 1 : 0][trainer_index]
00042:     # Find the AI battler for which the action is being chosen
00043:     @user = @battlers[idxBattler]
00044:     @battlers.each { |b| b.refresh_battler if b }
00045:   end
00046: 
00047:   # Choose an action.
00048:   def pbDefaultChooseEnemyCommand(idxBattler)
00049:     set_up(idxBattler)
00050:     ret = false
00051:     PBDebug.logonerr { ret = pbChooseToSwitchOut }
00052:     if ret
00053:       PBDebug.log("")
00054:       return
00055:     end
00056:     ret = false
00057:     PBDebug.logonerr { ret = pbChooseToUseItem }
00058:     if ret
00059:       PBDebug.log("")
00060:       return
00061:     end
00062:     if @battle.pbAutoFightMenu(idxBattler)
00063:       PBDebug.log("")
00064:       return
00065:     end
00066:     @battle.pbRegisterMegaEvolution(idxBattler) if pbEnemyShouldMegaEvolve?
00067:     choices = pbGetMoveScores
00068:     pbChooseMove(choices)
00069:     PBDebug.log("")
00070:   end
00071: 
00072:   # Choose a replacement Pokémon (called directly from @battle, not part of
00073:   # action choosing). Must return the party index of a replacement Pokémon if
00074:   # possible.
00075:   def pbDefaultChooseNewEnemy(idxBattler)
00076:     set_up(idxBattler)
00077:     return choose_best_replacement_pokemon(idxBattler, true)
00078:   end
00079: end
00080: 
00081: #===============================================================================
00082: #
00083: #===============================================================================
00084: module Battle::AI::Handlers
00085:   MoveFailureCheck              = HandlerHash.new
00086:   MoveFailureAgainstTargetCheck = HandlerHash.new
00087:   MoveEffectScore               = HandlerHash.new
00088:   MoveEffectAgainstTargetScore  = HandlerHash.new
00089:   MoveBasePower                 = HandlerHash.new
00090:   GeneralMoveScore              = HandlerHash.new
00091:   GeneralMoveAgainstTargetScore = HandlerHash.new
00092:   ShouldSwitch                  = HandlerHash.new
00093:   ShouldNotSwitch               = HandlerHash.new
00094:   AbilityRanking                = AbilityHandlerHash.new
00095:   ItemRanking                   = ItemHandlerHash.new
00096: 
00097:   def self.move_will_fail?(function_code, *args)
00098:     return MoveFailureCheck.trigger(function_code, *args) || false
00099:   end
00100: 
00101:   def self.move_will_fail_against_target?(function_code, *args)
00102:     return MoveFailureAgainstTargetCheck.trigger(function_code, *args) || false
00103:   end
00104: 
00105:   def self.apply_move_effect_score(function_code, score, *args)
00106:     ret = MoveEffectScore.trigger(function_code, score, *args)
00107:     return (ret.nil?) ? score : ret
00108:   end
00109: 
00110:   def self.apply_move_effect_against_target_score(function_code, score, *args)
00111:     ret = MoveEffectAgainstTargetScore.trigger(function_code, score, *args)
00112:     return (ret.nil?) ? score : ret
00113:   end
00114: 
00115:   def self.get_base_power(function_code, power, *args)
00116:     ret = MoveBasePower.trigger(function_code, power, *args)
00117:     return (ret.nil?) ? power : ret
00118:   end
00119: 
00120:   def self.apply_general_move_score_modifiers(score, *args)
00121:     GeneralMoveScore.each do |id, score_proc|
00122:       new_score = score_proc.call(score, *args)
00123:       score = new_score if new_score
00124:     end
00125:     return score
00126:   end
00127: 
00128:   def self.apply_general_move_against_target_score_modifiers(score, *args)
00129:     GeneralMoveAgainstTargetScore.each do |id, score_proc|
00130:       new_score = score_proc.call(score, *args)
00131:       score = new_score if new_score
00132:     end
00133:     return score
00134:   end
00135: 
00136:   def self.should_switch?(*args)
00137:     ret = false
00138:     ShouldSwitch.each do |id, switch_proc|
00139:       ret ||= switch_proc.call(*args)
00140:       break if ret
00141:     end
00142:     return ret
00143:   end
00144: 
00145:   def self.should_not_switch?(*args)
00146:     ret = false
00147:     ShouldNotSwitch.each do |id, switch_proc|
00148:       ret ||= switch_proc.call(*args)
00149:       break if ret
00150:     end
00151:     return ret
00152:   end
00153: 
00154:   def self.modify_ability_ranking(ability, score, *args)
00155:     ret = AbilityRanking.trigger(ability, score, *args)
00156:     return (ret.nil?) ? score : ret
00157:   end
00158: 
00159:   def self.modify_item_ranking(item, score, *args)
00160:     ret = ItemRanking.trigger(item, score, *args)
00161:     return (ret.nil?) ? score : ret
00162:   end
00163: end
