00785: 
00786:   #=============================================================================
00787:   # Pokérus
00788:   #=============================================================================
00789: 
00790:   # @return [Integer] the Pokérus infection stage for this Pokémon
00791:   def pokerusStrain
00792:     return @pokerus / 16
00793:   end
00794: 
00795:   # Returns the Pokérus infection stage for this Pokémon. The possible stages are
00796:   # 0 (not infected), 1 (infected) and 2 (cured).
00797:   # @return [0, 1, 2] current Pokérus infection stage
00798:   def pokerusStage
00799:     return 0 if @pokerus == 0
00800:     return ((@pokerus % 16) == 0) ? 2 : 1
00801:   end
00802: 
00803:   # Gives this Pokémon Pokérus (either the specified strain or a random one).
00804:   # @param strain [Integer] Pokérus strain to give (1-15 inclusive, or 0 for random)
00805:   def givePokerus(strain = 0)
00806:     return if self.pokerusStage == 2   # Can't re-infect a cured Pokémon
00807:     $stats.pokerus_infections += 1
00808:     strain = rand(1...16) if strain <= 0 || strain >= 16
00809:     time = 1 + (strain % 4)
00810:     @pokerus = time
00811:     @pokerus |= strain << 4
00812:   end
00813: 
00814:   # Resets the infection time for this Pokémon's Pokérus (even if cured).
00815:   def resetPokerusTime
00816:     return if @pokerus == 0
00817:     strain = @pokerus / 16
00818:     time = 1 + (strain % 4)
00819:     @pokerus = time
00820:     @pokerus |= strain << 4
00821:   end
00822: 
00823:   # Reduces the time remaining for this Pokémon's Pokérus (if infected).
00824:   def lowerPokerusCount
00825:     return if self.pokerusStage != 1
00826:     @pokerus -= 1
00827:   end
