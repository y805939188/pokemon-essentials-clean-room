00001: #===============================================================================
00002: # Hits twice.
00003: #===============================================================================
00004: class Battle::Move::HitTwoTimes < Battle::Move
00005:   def multiHitMove?;            return true; end
00006:   def pbNumHits(user, targets); return 2;    end
00007: end
00008: 
00009: #===============================================================================
00010: # Hits twice. May poison the target on each hit. (Twineedle)
00011: #===============================================================================
00012: class Battle::Move::HitTwoTimesPoisonTarget < Battle::Move::PoisonTarget
00013:   def multiHitMove?;            return true; end
00014:   def pbNumHits(user, targets); return 2;    end
00015: end
00016: 
00017: #===============================================================================
00018: # Hits twice. Causes the target to flinch. (Double Iron Bash)
00019: #===============================================================================
00020: class Battle::Move::HitTwoTimesFlinchTarget < Battle::Move::FlinchTarget
00021:   def multiHitMove?;            return true; end
00022:   def pbNumHits(user, targets); return 2;    end
00023: end
00024: 
00025: #===============================================================================
00026: # Hits in 2 volleys. The second volley targets the original target's ally if it
00027: # has one (that can be targeted), or the original target if not. A battler
00028: # cannot be targeted if it is is immune to or protected from this move somehow,
00029: # or if this move will miss it. (Dragon Darts)
00030: # NOTE: This move sometimes shows a different failure message compared to the
00031: #       official games. This is because of the order in which failure checks are
00032: #       done (all checks for each target in turn, versus all targets for each
00033: #       check in turn). This is considered unimportant, and since correcting it
00034: #       would involve extensive code rewrites, it is being ignored.
00035: #===============================================================================
00036: class Battle::Move::HitTwoTimesTargetThenTargetAlly < Battle::Move
00037:   def pbNumHits(user, targets); return 1;    end
00038:   def pbRepeatHit?;             return true; end
00039: 
00040:   def pbModifyTargets(targets, user)
00041:     return if targets.length != 1
00042:     choices = []
00043:     targets[0].allAllies.each { |b| user.pbAddTarget(choices, user, b, self) }
00044:     return if choices.length == 0
00045:     idxChoice = (choices.length > 1) ? @battle.pbRandom(choices.length) : 0
00046:     user.pbAddTarget(targets, user, choices[idxChoice], self, !pbTarget(user).can_choose_distant_target?)
00047:   end
00048: 
00049:   def pbShowFailMessages?(targets)
00050:     if targets.length > 1
00051:       valid_targets = targets.select { |b| !b.fainted? && !b.damageState.unaffected }
00052:       return valid_targets.length <= 1
00053:     end
00054:     return super
00055:   end
00056: 
00057:   def pbDesignateTargetsForHit(targets, hitNum)
00058:     valid_targets = []
00059:     targets.each { |b| valid_targets.push(b) if !b.damageState.unaffected }
00060:     return [valid_targets[1]] if valid_targets[1] && hitNum == 1
00061:     return [valid_targets[0]]
00062:   end
00063: end
00064: 
00065: #===============================================================================
00066: # Hits 3 times. Power is multiplied by the hit number. (Triple Kick)
00067: # An accuracy check is performed for each hit.
00068: #===============================================================================
00069: class Battle::Move::HitThreeTimesPowersUpWithEachHit < Battle::Move
00070:   def multiHitMove?;            return true; end
00071:   def pbNumHits(user, targets); return 3;    end
00072: 
00073:   def successCheckPerHit?
00074:     return @accCheckPerHit
00075:   end
00076: 
00077:   def pbOnStartUse(user, targets)
00078:     @calcBaseDmg = 0
00079:     @accCheckPerHit = !user.hasActiveAbility?(:SKILLLINK)
00080:   end
00081: 
00082:   def pbBaseDamage(baseDmg, user, target)
00083:     @calcBaseDmg += baseDmg
00084:     return @calcBaseDmg
00085:   end
00086: end
00087: 
00088: #===============================================================================
00089: # Hits 3 times in a row. If each hit could be a critical hit, it will definitely
00090: # be a critical hit. (Surging Strikes)
00091: #===============================================================================
00092: class Battle::Move::HitThreeTimesAlwaysCriticalHit < Battle::Move
00093:   def multiHitMove?;                   return true; end
00094:   def pbNumHits(user, targets);        return 3;    end
00095:   def pbCritialOverride(user, target); return 1;    end
00096: end
00097: 
00098: #===============================================================================
00099: # Hits 2-5 times.
00100: #===============================================================================
00101: class Battle::Move::HitTwoToFiveTimes < Battle::Move
00102:   def multiHitMove?; return true; end
00103: 
00104:   def pbNumHits(user, targets)
00105:     hitChances = [
00106:       2, 2, 2, 2, 2, 2, 2,
00107:       3, 3, 3, 3, 3, 3, 3,
00108:       4, 4, 4,
00109:       5, 5, 5
00110:     ]
00111:     r = @battle.pbRandom(hitChances.length)
00112:     r = hitChances.length - 1 if user.hasActiveAbility?(:SKILLLINK)
00113:     return hitChances[r]
00114:   end
00115: end
00116: 
00117: #===============================================================================
00118: # Hits 2-5 times. If the user is Ash Greninja, powers up and hits 3 times.
00119: # (Water Shuriken)
00120: #===============================================================================
00121: class Battle::Move::HitTwoToFiveTimesOrThreeForAshGreninja < Battle::Move::HitTwoToFiveTimes
00122:   def pbNumHits(user, targets)
00123:     return 3 if user.isSpecies?(:GRENINJA) && user.form == 2
00124:     return super
00125:   end
00126: 
00127:   def pbBaseDamage(baseDmg, user, target)
00128:     return 20 if user.isSpecies?(:GRENINJA) && user.form == 2
00129:     return super
00130:   end
00131: end
00132: 
00133: #===============================================================================
00134: # Hits 2-5 times in a row. If the move does not fail, increases the user's Speed
00135: # by 1 stage and decreases the user's Defense by 1 stage. (Scale Shot)
00136: #===============================================================================
00137: class Battle::Move::HitTwoToFiveTimesRaiseUserSpd1LowerUserDef1 < Battle::Move::HitTwoToFiveTimes
00138:   def pbEffectAfterAllHits(user, target)
00139:     return if target.damageState.unaffected
00140:     if user.pbCanLowerStatStage?(:DEFENSE, user, self)
00141:       user.pbLowerStatStage(:DEFENSE, 1, user)
00142:     end
00143:     if user.pbCanRaiseStatStage?(:SPEED, user, self)
00144:       user.pbRaiseStatStage(:SPEED, 1, user)
00145:     end
00146:   end
00147: end
00148: 
00149: #===============================================================================
00150: # Hits X times, where X is the number of non-user unfainted status-free Pokémon
