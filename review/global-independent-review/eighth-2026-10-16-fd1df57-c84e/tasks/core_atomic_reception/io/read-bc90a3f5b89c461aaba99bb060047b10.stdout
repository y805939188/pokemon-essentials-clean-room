00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: module Battle::ItemEffects
00005:   SpeedCalc                       = ItemHandlerHash.new
00006:   WeightCalc                      = ItemHandlerHash.new   # Float Stone
00007:   # Battler's HP/stat changed
00008:   HPHeal                          = ItemHandlerHash.new
00009:   OnStatLoss                      = ItemHandlerHash.new
00010:   # Battler's status problem
00011:   StatusCure                      = ItemHandlerHash.new
00012:   # Priority and turn order
00013:   PriorityBracketChange           = ItemHandlerHash.new
00014:   PriorityBracketUse              = ItemHandlerHash.new
00015:   # Move usage failures
00016:   OnMissingTarget                 = ItemHandlerHash.new   # Blunder Policy
00017:   # Accuracy calculation
00018:   AccuracyCalcFromUser            = ItemHandlerHash.new
00019:   AccuracyCalcFromTarget          = ItemHandlerHash.new
00020:   # Damage calculation
00021:   DamageCalcFromUser              = ItemHandlerHash.new
00022:   DamageCalcFromTarget            = ItemHandlerHash.new
00023:   CriticalCalcFromUser            = ItemHandlerHash.new
00024:   CriticalCalcFromTarget          = ItemHandlerHash.new   # None!
00025:   # Upon a move hitting a target
00026:   OnBeingHit                      = ItemHandlerHash.new
00027:   OnBeingHitPositiveBerry         = ItemHandlerHash.new
00028:   # Items that trigger at the end of using a move
00029:   AfterMoveUseFromTarget          = ItemHandlerHash.new
00030:   AfterMoveUseFromUser            = ItemHandlerHash.new
00031:   OnEndOfUsingMove                = ItemHandlerHash.new   # Leppa Berry
00032:   OnEndOfUsingMoveStatRestore     = ItemHandlerHash.new   # White Herb
00033:   # Experience and EV gain
00034:   ExpGainModifier                 = ItemHandlerHash.new   # Lucky Egg
00035:   EVGainModifier                  = ItemHandlerHash.new
00036:   # Weather and terrin
00037:   WeatherExtender                 = ItemHandlerHash.new
00038:   TerrainExtender                 = ItemHandlerHash.new   # Terrain Extender
00039:   TerrainStatBoost                = ItemHandlerHash.new
00040:   # End Of Round
00041:   EndOfRoundHealing               = ItemHandlerHash.new
00042:   EndOfRoundEffect                = ItemHandlerHash.new
00043:   # Switching and fainting
00044:   CertainSwitching                = ItemHandlerHash.new   # Shed Shell
00045:   TrappingByTarget                = ItemHandlerHash.new   # None!
00046:   OnSwitchIn                      = ItemHandlerHash.new   # Air Balloon
00047:   OnIntimidated                   = ItemHandlerHash.new   # Adrenaline Orb
00048:   # Running from battle
00049:   CertainEscapeFromBattle         = ItemHandlerHash.new   # Smoke Ball
00050: 
00051:   #=============================================================================
00052: 
00053:   def self.trigger(hash, *args, ret: false)
00054:     new_ret = hash.trigger(*args)
00055:     return (!new_ret.nil?) ? new_ret : ret
00056:   end
00057: 
00058:   #=============================================================================
00059: 
00060:   def self.triggerSpeedCalc(item, battler, mult)
00061:     return trigger(SpeedCalc, item, battler, mult, ret: mult)
00062:   end
00063: 
00064:   def self.triggerWeightCalc(item, battler, w)
00065:     return trigger(WeightCalc, item, battler, w, ret: w)
00066:   end
00067: 
00068:   #=============================================================================
00069: 
00070:   def self.triggerHPHeal(item, battler, battle, forced)
00071:     return trigger(HPHeal, item, battler, battle, forced)
00072:   end
00073: 
00074:   def self.triggerOnStatLoss(item, user, move_user, battle)
00075:     return trigger(OnStatLoss, item, user, move_user, battle)
00076:   end
00077: 
00078:   #=============================================================================
00079: 
00080:   def self.triggerStatusCure(item, battler, battle, forced)
00081:     return trigger(StatusCure, item, battler, battle, forced)
00082:   end
00083: 
00084:   #=============================================================================
00085: 
00086:   def self.triggerPriorityBracketChange(item, battler, battle)
00087:     return trigger(PriorityBracketChange, item, battler, battle, ret: 0)
00088:   end
00089: 
00090:   def self.triggerPriorityBracketUse(item, battler, battle)
00091:     PriorityBracketUse.trigger(item, battler, battle)
00092:   end
00093: 
00094:   #=============================================================================
00095: 
00096:   def self.triggerOnMissingTarget(item, user, target, move, hit_num, battle)
00097:     OnMissingTarget.trigger(item, user, target, move, hit_num, battle)
00098:   end
00099: 
00100:   #=============================================================================
00101: 
00102:   def self.triggerAccuracyCalcFromUser(item, mods, user, target, move, type)
00103:     AccuracyCalcFromUser.trigger(item, mods, user, target, move, type)
00104:   end
00105: 
00106:   def self.triggerAccuracyCalcFromTarget(item, mods, user, target, move, type)
00107:     AccuracyCalcFromTarget.trigger(item, mods, user, target, move, type)
00108:   end
00109: 
00110:   #=============================================================================
00111: 
00112:   def self.triggerDamageCalcFromUser(item, user, target, move, mults, power, type)
00113:     DamageCalcFromUser.trigger(item, user, target, move, mults, power, type)
00114:   end
00115: 
00116:   def self.triggerDamageCalcFromTarget(item, user, target, move, mults, power, type)
00117:     DamageCalcFromTarget.trigger(item, user, target, move, mults, power, type)
00118:   end
00119: 
00120:   def self.triggerCriticalCalcFromUser(item, user, target, crit_stage)
00121:     return trigger(CriticalCalcFromUser, item, user, target, crit_stage, ret: crit_stage)
00122:   end
00123: 
00124:   def self.triggerCriticalCalcFromTarget(item, user, target, crit_stage)
00125:     return trigger(CriticalCalcFromTarget, item, user, target, crit_stage, ret: crit_stage)
00126:   end
00127: 
00128:   #=============================================================================
00129: 
00130:   def self.triggerOnBeingHit(item, user, target, move, battle)
00131:     OnBeingHit.trigger(item, user, target, move, battle)
00132:   end
00133: 
00134:   def self.triggerOnBeingHitPositiveBerry(item, battler, battle, forced)
00135:     return trigger(OnBeingHitPositiveBerry, item, battler, battle, forced)
00136:   end
00137: 
00138:   #=============================================================================
00139: 
00140:   def self.triggerAfterMoveUseFromTarget(item, battler, user, move, switched_battlers, battle)
00141:     AfterMoveUseFromTarget.trigger(item, battler, user, move, switched_battlers, battle)
00142:   end
00143: 
00144:   def self.triggerAfterMoveUseFromUser(item, user, targets, move, num_hits, battle)
00145:     AfterMoveUseFromUser.trigger(item, user, targets, move, num_hits, battle)
00146:   end
00147: 
00148:   def self.triggerOnEndOfUsingMove(item, battler, battle, forced)
00149:     return trigger(OnEndOfUsingMove, item, battler, battle, forced)
00150:   end
00151: 
00152:   def self.triggerOnEndOfUsingMoveStatRestore(item, battler, battle, forced)
00153:     return trigger(OnEndOfUsingMoveStatRestore, item, battler, battle, forced)
00154:   end
00155: 
00156:   #=============================================================================
00157: 
00158:   def self.triggerExpGainModifier(item, battler, exp)
00159:     return trigger(ExpGainModifier, item, battler, exp, ret: -1)
00160:   end
00161: 
00162:   def self.triggerEVGainModifier(item, battler, ev_array)
00163:     return false if !EVGainModifier[item]
00164:     EVGainModifier.trigger(item, battler, ev_array)
00165:     return true
00166:   end
00167: 
00168:   #=============================================================================
00169: 
00170:   def self.triggerWeatherExtender(item, weather, duration, battler, battle)
00171:     return trigger(WeatherExtender, item, weather, duration, battler, battle, ret: duration)
00172:   end
00173: 
00174:   def self.triggerTerrainExtender(item, terrain, duration, battler, battle)
00175:     return trigger(TerrainExtender, item, terrain, duration, battler, battle, ret: duration)
00176:   end
00177: 
00178:   def self.triggerTerrainStatBoost(item, battler, battle)
00179:     return trigger(TerrainStatBoost, item, battler, battle)
00180:   end
00181: 
00182:   #=============================================================================
00183: 
00184:   def self.triggerEndOfRoundHealing(item, battler, battle)
00185:     EndOfRoundHealing.trigger(item, battler, battle)
00186:   end
00187: 
00188:   def self.triggerEndOfRoundEffect(item, battler, battle)
00189:     EndOfRoundEffect.trigger(item, battler, battle)
00190:   end
00191: 
00192:   #=============================================================================
00193: 
00194:   def self.triggerCertainSwitching(item, switcher, battle)
00195:     return trigger(CertainSwitching, item, switcher, battle)
00196:   end
00197: 
00198:   def self.triggerTrappingByTarget(item, switcher, bearer, battle)
00199:     return trigger(TrappingByTarget, item, switcher, bearer, battle)
00200:   end
00201: 
00202:   def self.triggerOnSwitchIn(item, battler, battle)
00203:     OnSwitchIn.trigger(item, battler, battle)
00204:   end
00205: 
00206:   def self.triggerOnIntimidated(item, battler, battle)
00207:     return trigger(OnIntimidated, item, battler, battle)
00208:   end
00209: 
00210:   #=============================================================================
00211: 
00212:   def self.triggerCertainEscapeFromBattle(item, battler)
00213:     return trigger(CertainEscapeFromBattle, item, battler)
00214:   end
00215: end
