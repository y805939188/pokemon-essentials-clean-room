00309: end
00310: 
00311: #===============================================================================
00312: # Target can no longer switch out or flee, as long as the user remains active.
00313: # Trapping is considered an additional effect for damaging moves.
00314: # (Anchor Shot, Block, Mean Look, Spider Web, Spirit Shackle)
00315: #===============================================================================
00316: class Battle::Move::TrapTargetInBattle < Battle::Move
00317:   def canMagicCoat?; return true; end
00318: 
00319:   def pbFailsAgainstTarget?(user, target, show_message)
00320:     return false if damagingMove?
00321:     if target.effects[PBEffects::MeanLook] >= 0
00322:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00323:       return true
00324:     end
00325:     if Settings::MORE_TYPE_EFFECTS && target.pbHasType?(:GHOST)
00326:       @battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true))) if show_message
00327:       return true
00328:     end
00329:     return false
00330:   end
00331: 
00332:   def pbEffectAgainstTarget(user, target)
00333:     return if damagingMove?
00334:     target.effects[PBEffects::MeanLook] = user.index
00335:     @battle.pbDisplay(_INTL("{1} can no longer escape!", target.pbThis))
00336:   end
00337: 
00338:   def pbAdditionalEffect(user, target)
00339:     return if target.fainted? || target.damageState.substitute
00340:     return if target.effects[PBEffects::MeanLook] >= 0
00341:     return if Settings::MORE_TYPE_EFFECTS && target.pbHasType?(:GHOST)
00342:     target.effects[PBEffects::MeanLook] = user.index
00343:     @battle.pbDisplay(_INTL("{1} can no longer escape!", target.pbThis))
00344:   end
00345: end
00346: 
00347: #===============================================================================
00348: # Target can no longer switch out or flee, as long as the user remains active.
00349: # Trapping is not considered an additional effect. (Thousand Waves)
00350: #===============================================================================
00351: class Battle::Move::TrapTargetInBattleMainEffect < Battle::Move
00352:   def canMagicCoat?; return true; end
00353: 
00354:   def pbEffectAgainstTarget(user, target)
00355:     return if target.fainted? || target.damageState.substitute
00356:     return if target.effects[PBEffects::MeanLook] >= 0
00357:     return if Settings::MORE_TYPE_EFFECTS && target.pbHasType?(:GHOST)
00358:     target.effects[PBEffects::MeanLook] = user.index
00359:     @battle.pbDisplay(_INTL("{1} can no longer escape!", target.pbThis))
00360:   end
00361: end
00362: 
00363: #===============================================================================
00364: # The target can no longer switch out or flee, while the user remains in battle.
00365: # At the end of each round, the target's Defense and Special Defense are lowered
00366: # by 1 stage each. (Octolock)
00367: #===============================================================================
00368: class Battle::Move::TrapTargetInBattleLowerTargetDefSpDef1EachTurn < Battle::Move
00369:   def pbFailsAgainstTarget?(user, target, show_message)
00370:     return false if damagingMove?
00371:     if target.effects[PBEffects::Octolock] >= 0
00372:       @battle.pbDisplay(_INTL("But it failed!")) if show_message
00373:       return true
00374:     end
00375:     if Settings::MORE_TYPE_EFFECTS && target.pbHasType?(:GHOST)
00376:       @battle.pbDisplay(_INTL("It doesn't affect {1}...", target.pbThis(true))) if show_message
00377:       return true
00378:     end
00379:     return false
00380:   end
00381: 
00382:   def pbEffectAgainstTarget(user, target)
00383:     target.effects[PBEffects::Octolock] = user.index
00384:     @battle.pbDisplay(_INTL("{1} can no longer escape because of {2}!", target.pbThis, @name))
00385:   end
00386: end
00387: 
00388: #===============================================================================
00389: # Prevents the user and the target from switching out or fleeing. This effect
00390: # isn't applied if either Pokémon is already prevented from switching out or
00391: # fleeing. (Jaw Lock)
00392: #===============================================================================
00393: class Battle::Move::TrapUserAndTargetInBattle < Battle::Move
00394:   def pbEffectAgainstTarget(user, target)
00395:     return if user.fainted? || target.fainted? || target.damageState.substitute
00396:     return if Settings::MORE_TYPE_EFFECTS && target.pbHasType?(:GHOST)
00397:     return if user.trappedInBattle? || target.trappedInBattle?
00398:     target.effects[PBEffects::JawLock] = user.index
00399:     @battle.pbDisplay(_INTL("Neither Pokémon can run away!"))
00400:   end
00401: end
00402: 
00403: #===============================================================================
00404: # No Pokémon can switch out or flee until the end of the next round. (Fairy Lock)
00405: #===============================================================================
00406: class Battle::Move::TrapAllBattlersInBattleForOneTurn < Battle::Move
00407:   def pbMoveFailed?(user, targets)
00408:     if @battle.field.effects[PBEffects::FairyLock] > 0
00409:       @battle.pbDisplay(_INTL("But it failed!"))
00410:       return true
00411:     end
00412:     return false
00413:   end
00414: 
00415:   def pbEffectGeneral(user)
00416:     @battle.field.effects[PBEffects::FairyLock] = 2
00417:     @battle.pbDisplay(_INTL("No one will be able to run away during the next turn!"))
00418:   end
00419: end
