00162: 
00163:   #=============================================================================
00164:   # Display-only properties
00165:   #=============================================================================
00166:   def name
00167:     return @effects[PBEffects::Illusion].name if @effects[PBEffects::Illusion]
00168:     return @name
00169:   end
00170: 
00171:   attr_writer :name
00172: 
00173:   def displayPokemon
00174:     return @effects[PBEffects::Illusion] if @effects[PBEffects::Illusion]
00175:     return self.pokemon
00176:   end
00177: 
00178:   def displaySpecies
00179:     return @effects[PBEffects::Illusion].species if @effects[PBEffects::Illusion]
00180:     return self.species
00181:   end
00182: 
00183:   def displayGender
00184:     return @effects[PBEffects::Illusion].gender if @effects[PBEffects::Illusion]
00185:     return self.gender
00186:   end
00187: 
00188:   def displayForm
00189:     return @effects[PBEffects::Illusion].form if @effects[PBEffects::Illusion]
00190:     return self.form
00191:   end
00192: 
00193:   def shiny?
00194:     return @effects[PBEffects::Illusion].shiny? if @effects[PBEffects::Illusion]
00195:     return @pokemon&.shiny?
00196:   end
00197: 
00198:   def super_shiny?
00199:     return @pokemon&.super_shiny?
00200:   end
00201: 
00202:   def owned?
00203:     return false if !@battle.wildBattle?
00204:     return $player.owned?(displaySpecies)
00205:   end
00206:   alias owned owned?
00207: 
00208:   def abilityName
00209:     abil = self.ability
00210:     return (abil) ? abil.name : ""
00211:   end
00212: 
00213:   def itemName
00214:     itm = self.item
00215:     return (itm) ? itm.name : ""
00216:   end
00217: 
00218:   def pbThis(lowerCase = false)
00219:     if opposes?
00220:       if @battle.trainerBattle?
00221:         return lowerCase ? _INTL("the opposing {1}", name) : _INTL("The opposing {1}", name)
00222:       else
00223:         return lowerCase ? _INTL("the wild {1}", name) : _INTL("The wild {1}", name)
00224:       end
00225:     elsif !pbOwnedByPlayer?
00226:       return lowerCase ? _INTL("the ally {1}", name) : _INTL("The ally {1}", name)
00227:     end
00228:     return name
00229:   end
00230: 
00231:   def pbTeam(lowerCase = false)
00232:     if opposes?
00233:       return lowerCase ? _INTL("the opposing team") : _INTL("The opposing team")
00234:     end
00235:     return lowerCase ? _INTL("your team") : _INTL("Your team")
00236:   end
00237: 
00238:   def pbOpposingTeam(lowerCase = false)
00239:     if opposes?
00240:       return lowerCase ? _INTL("your team") : _INTL("Your team")
00241:     end
00242:     return lowerCase ? _INTL("the opposing team") : _INTL("The opposing team")
