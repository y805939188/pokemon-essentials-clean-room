00274: class Battle::Move::StartNegateHeldItems < Battle::Move
00275:   def pbEffectGeneral(user)
00276:     if @battle.field.effects[PBEffects::MagicRoom] > 0
00277:       @battle.field.effects[PBEffects::MagicRoom] = 0
00278:       @battle.pbDisplay(_INTL("The area returned to normal!"))
00279:     else
00280:       @battle.field.effects[PBEffects::MagicRoom] = 5
00281:       @battle.pbDisplay(_INTL("It created a bizarre area in which Pokémon's held items lose their effects!"))
00282:     end
00283:   end
00284: 
00285:   def pbShowAnimation(id, user, targets, hitNum = 0, showAnimation = true)
00286:     return if @battle.field.effects[PBEffects::MagicRoom] > 0   # No animation
00287:     super
00288:   end
00289: end
