00637:     # Find an evolution
00638:     new_species = nil
00639:     if new_species.nil? && $game_temp.party_levels_before_battle &&
00640:        $game_temp.party_levels_before_battle[i] &&
00641:        $game_temp.party_levels_before_battle[i] < pkmn.level
00642:       new_species = pkmn.check_evolution_on_level_up
00643:     end
00644:     new_species = pkmn.check_evolution_after_battle(i) if new_species.nil?
00645:     next if new_species.nil?
00646:     # Evolve Pokémon if possible
00647:     evo = PokemonEvolutionScene.new
00648:     evo.pbStartScreen(pkmn, new_species)
00649:     evo.pbEvolution
00650:     evo.pbEndScreen
00651:   end
00652: end
00653: 
00654: def pbDynamicItemList(*args)
00655:   ret = []
00656:   args.each { |arg| ret.push(arg) if GameData::Item.exists?(arg) }
00657:   return ret
00658: end
00659: 
00660: # Common items to find via Pickup. Items from this list are added to the pool in
00661: # order, starting from a point dependng on the Pokémon's level. The number of
00662: # items added is how many probabilities are in the PICKUP_COMMON_ITEM_CHANCES
00663: # array below.
00664: # There must be 9 + PICKUP_COMMON_ITEM_CHANCES.length number of items in this
00665: # array (18 by default). The 9 is actually (100 / num_rarity_levels) - 1, where
00666: # num_rarity_levels is in def pbPickup below.
00667: PICKUP_COMMON_ITEMS = [
00668:   :POTION,        # Levels 1-10
00669:   :ANTIDOTE,      # Levels 1-10, 11-20
00670:   :SUPERPOTION,   # Levels 1-10, 11-20, 21-30
00671:   :GREATBALL,     # Levels 1-10, 11-20, 21-30, 31-40
00672:   :REPEL,         # Levels 1-10, 11-20, 21-30, 31-40, 41-50
00673:   :ESCAPEROPE,    # Levels 1-10, 11-20, 21-30, 31-40, 41-50, 51-60
00674:   :FULLHEAL,      # Levels 1-10, 11-20, 21-30, 31-40, 41-50, 51-60, 61-70
00675:   :HYPERPOTION,   # Levels 1-10, 11-20, 21-30, 31-40, 41-50, 51-60, 61-70, 71-80
00676:   :ULTRABALL,     # Levels 1-10, 11-20, 21-30, 31-40, 41-50, 51-60, 61-70, 71-80, 81-90
00677:   :REVIVE,        # Levels       11-20, 21-30, 31-40, 41-50, 51-60, 61-70, 71-80, 81-90, 91-100
00678:   :RARECANDY,     # Levels              21-30, 31-40, 41-50, 51-60, 61-70, 71-80, 81-90, 91-100
00679:   :SUNSTONE,      # Levels                     31-40, 41-50, 51-60, 61-70, 71-80, 81-90, 91-100
00680:   :MOONSTONE,     # Levels                            41-50, 51-60, 61-70, 71-80, 81-90, 91-100
00681:   :HEARTSCALE,    # Levels                                   51-60, 61-70, 71-80, 81-90, 91-100
00682:   :FULLRESTORE,   # Levels                                          61-70, 71-80, 81-90, 91-100
00683:   :MAXREVIVE,     # Levels                                                 71-80, 81-90, 91-100
00684:   :PPUP,          # Levels                                                        81-90, 91-100
00685:   :MAXELIXIR      # Levels                                                               91-100
00686: ]
00687: # Chances to get each item added to the pool from the array above.
00688: PICKUP_COMMON_ITEM_CHANCES = [30, 10, 10, 10, 10, 10, 10, 4, 4]
00689: # Rare items to find via Pickup. Items from this list are added to the pool in
00690: # order, starting from a point dependng on the Pokémon's level. The number of
00691: # items added is how many probabilities are in the PICKUP_RARE_ITEM_CHANCES
00692: # array below.
00693: # There must be 9 + PICKUP_RARE_ITEM_CHANCES.length number of items in this
00694: # array (11 by default). The 9 is actually (100 / num_rarity_levels) - 1, where
00695: # num_rarity_levels is in def pbPickup below.
00696: PICKUP_RARE_ITEMS = [
00697:   :HYPERPOTION,   # Levels 1-10
00698:   :NUGGET,        # Levels 1-10, 11-20
00699:   :KINGSROCK,     # Levels       11-20, 21-30
00700:   :FULLRESTORE,   # Levels              21-30, 31-40
00701:   :ETHER,         # Levels                     31-40, 41-50
00702:   :IRONBALL,      # Levels                            41-50, 51-60
00703:   :DESTINYKNOT,   # Levels                                   51-60, 61-70
00704:   :ELIXIR,        # Levels                                          61-70, 71-80
00705:   :DESTINYKNOT,   # Levels                                                 71-80, 81-90
00706:   :LEFTOVERS,     # Levels                                                        81-90, 91-100
00707:   :DESTINYKNOT    # Levels                                                               91-100
00708: ]
00709: # Chances to get each item added to the pool from the array above.
00710: PICKUP_RARE_ITEM_CHANCES = [1, 1]
00711: 
00712: # Try to gain an item after a battle if a Pokemon has the ability Pickup.
00713: def pbPickup(pkmn)
00714:   return if pkmn.egg? || !pkmn.hasAbility?(:PICKUP)
00715:   return if pkmn.hasItem?
00716:   return unless rand(100) < 10   # 10% chance for Pickup to trigger
00717:   num_rarity_levels = 10
00718:   # Ensure common and rare item lists contain defined items
00719:   common_items = pbDynamicItemList(*PICKUP_COMMON_ITEMS)
00720:   rare_items = pbDynamicItemList(*PICKUP_RARE_ITEMS)
00721:   return if common_items.length < num_rarity_levels - 1 + PICKUP_COMMON_ITEM_CHANCES.length
00722:   return if rare_items.length < num_rarity_levels - 1 + PICKUP_RARE_ITEM_CHANCES.length
00723:   # Determine the starting point for adding items from the above arrays into the
00724:   # pool
00725:   start_index = [([100, pkmn.level].min - 1) * num_rarity_levels / 100, 0].max
00726:   # Generate a pool of items depending on the Pokémon's level
00727:   items = []
00728:   PICKUP_COMMON_ITEM_CHANCES.length.times { |i| items.push(common_items[start_index + i]) }
00729:   PICKUP_RARE_ITEM_CHANCES.length.times { |i| items.push(rare_items[start_index + i]) }
00730:   # Randomly choose an item from the pool to give to the Pokémon
00731:   all_chances = PICKUP_COMMON_ITEM_CHANCES + PICKUP_RARE_ITEM_CHANCES
00732:   rnd = rand(all_chances.sum)
00733:   cumul = 0
00734:   all_chances.each_with_index do |c, i|
00735:     cumul += c
00736:     next if rnd >= cumul
00737:     pkmn.item = items[i]
00738:     break
00739:   end
00740: end
00741: 
00742: # Try to gain a Honey item after a battle if a Pokemon has the ability Honey Gather.
00743: def pbHoneyGather(pkmn)
00744:   return if !GameData::Item.exists?(:HONEY)
00745:   return if pkmn.egg? || !pkmn.hasAbility?(:HONEYGATHER) || pkmn.hasItem?
00746:   chance = 5 + (((pkmn.level - 1) / 10) * 5)
00747:   return unless rand(100) < chance
00748:   pkmn.item = :HONEY
00749: end
