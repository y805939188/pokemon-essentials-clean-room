00001: #===============================================================================
00002: # This script modifies the battle system to implement battle rules
00003: #===============================================================================
00004: class Battle
00005:   unless @__clauses__aliased
00006:     alias __clauses__pbDecisionOnDraw pbDecisionOnDraw
00007:     alias __clauses__pbEndOfRoundPhase pbEndOfRoundPhase
00008:     @__clauses__aliased = true
00009:   end
00010: 
00011:   def pbDecisionOnDraw
00012:     if @rules["selfkoclause"]
00013:       if self.lastMoveUser < 0
00014:         # in extreme cases there may be no last move user
00015:         return 5   # game is a draw
00016:       elsif opposes?(self.lastMoveUser)
00017:         return 2   # loss
00018:       else
00019:         return 1   # win
00020:       end
00021:     end
00022:     return __clauses__pbDecisionOnDraw
00023:   end
00024: 
00025:   def pbJudgeCheckpoint(user, move = nil)
00026:     if pbAllFainted?(0) && pbAllFainted?(1)
00027:       if @rules["drawclause"]   # NOTE: Also includes Life Orb (not implemented)
00028:         if !(move && move.function_code == "HealUserByHalfOfDamageDone")
00029:           # Not a draw if fainting occurred due to Liquid Ooze
00030:           @decision = (user.opposes?) ? 1 : 2   # win / loss
00031:         end
00032:       elsif @rules["modifiedselfdestructclause"]
00033:         if move && move.function_code == "UserFaintsExplosive"   # Self-Destruct
00034:           @decision = (user.opposes?) ? 1 : 2   # win / loss
00035:         end
00036:       end
00037:     end
00038:   end
00039: 
00040:   def pbEndOfRoundPhase
00041:     __clauses__pbEndOfRoundPhase
00042:     if @rules["suddendeath"] && @decision == 0
00043:       p1able = pbAbleCount(0)
00044:       p2able = pbAbleCount(1)
00045:       if p1able > p2able
00046:         @decision = 1   # loss
00047:       elsif p1able < p2able
00048:         @decision = 2   # win
00049:       end
00050:     end
00051:   end
00052: end
00053: 
