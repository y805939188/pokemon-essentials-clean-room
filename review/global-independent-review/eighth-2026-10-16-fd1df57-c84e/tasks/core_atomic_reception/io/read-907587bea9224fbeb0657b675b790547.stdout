00564: class Battle::Move::DoublePowerIfAllyFaintedLastTurn < Battle::Move
00565:   def pbBaseDamage(baseDmg, user, target)
00566:     lrf = user.pbOwnSide.effects[PBEffects::LastRoundFainted]
00567:     baseDmg *= 2 if lrf >= 0 && lrf == @battle.turnCount - 1
00568:     return baseDmg
00569:   end
00570: end
