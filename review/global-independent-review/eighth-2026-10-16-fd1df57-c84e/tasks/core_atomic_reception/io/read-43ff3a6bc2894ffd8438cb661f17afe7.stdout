00393:   # End Of Round end effects that apply to one side of the field
00394:   #=============================================================================
00395:   def pbEORCountDownSideEffect(side, effect, msg)
00396:     return if @sides[side].effects[effect] <= 0
00397:     @sides[side].effects[effect] -= 1
00398:     pbDisplay(msg) if @sides[side].effects[effect] == 0
00399:   end
00400: 
00401:   def pbEOREndSideEffects(side, priority)
00402:     # Reflect
00403:     pbEORCountDownSideEffect(side, PBEffects::Reflect,
00404:                              _INTL("{1}'s Reflect wore off!", @battlers[side].pbTeam))
00405:     # Light Screen
00406:     pbEORCountDownSideEffect(side, PBEffects::LightScreen,
00407:                              _INTL("{1}'s Light Screen wore off!", @battlers[side].pbTeam))
00408:     # Safeguard
00409:     pbEORCountDownSideEffect(side, PBEffects::Safeguard,
00410:                              _INTL("{1} is no longer protected by Safeguard!", @battlers[side].pbTeam))
00411:     # Mist
00412:     pbEORCountDownSideEffect(side, PBEffects::Mist,
00413:                              _INTL("{1} is no longer protected by mist!", @battlers[side].pbTeam))
00414:     # Tailwind
00415:     pbEORCountDownSideEffect(side, PBEffects::Tailwind,
00416:                              _INTL("{1}'s Tailwind petered out!", @battlers[side].pbTeam))
00417:     # Lucky Chant
00418:     pbEORCountDownSideEffect(side, PBEffects::LuckyChant,
00419:                              _INTL("{1}'s Lucky Chant wore off!", @battlers[side].pbTeam))
00420:     # Pledge Rainbow
00421:     pbEORCountDownSideEffect(side, PBEffects::Rainbow,
00422:                              _INTL("The rainbow on {1}'s side disappeared!", @battlers[side].pbTeam(true)))
00423:     # Pledge Sea of Fire
00424:     pbEORCountDownSideEffect(side, PBEffects::SeaOfFire,
00425:                              _INTL("The sea of fire around {1} disappeared!", @battlers[side].pbTeam(true)))
00426:     # Pledge Swamp
00427:     pbEORCountDownSideEffect(side, PBEffects::Swamp,
00428:                              _INTL("The swamp around {1} disappeared!", @battlers[side].pbTeam(true)))
00429:     # Aurora Veil
00430:     pbEORCountDownSideEffect(side, PBEffects::AuroraVeil,
00431:                              _INTL("{1}'s Aurora Veil wore off!", @battlers[side].pbTeam))
00432:   end
00433: 
00434:   #=============================================================================
00435:   # End Of Round end effects that apply to the whole field
00436:   #=============================================================================
00437:   def pbEORCountDownFieldEffect(effect, msg)
00438:     return if @field.effects[effect] <= 0
00439:     @field.effects[effect] -= 1
00440:     return if @field.effects[effect] > 0
00441:     pbDisplay(msg)
00442:     if effect == PBEffects::MagicRoom
00443:       pbPriority(true).each { |battler| battler.pbItemTerrainStatBoostCheck }
00444:     end
00445:   end
00446: 
00447:   def pbEOREndFieldEffects(priority)
00448:     # Trick Room
00449:     pbEORCountDownFieldEffect(PBEffects::TrickRoom,
00450:                               _INTL("The twisted dimensions returned to normal!"))
00451:     # Gravity
00452:     pbEORCountDownFieldEffect(PBEffects::Gravity,
00453:                               _INTL("Gravity returned to normal!"))
00454:     # Water Sport
00455:     pbEORCountDownFieldEffect(PBEffects::WaterSportField,
00456:                               _INTL("The effects of Water Sport have faded."))
00457:     # Mud Sport
00458:     pbEORCountDownFieldEffect(PBEffects::MudSportField,
00459:                               _INTL("The effects of Mud Sport have faded."))
00460:     # Wonder Room
00461:     pbEORCountDownFieldEffect(PBEffects::WonderRoom,
00462:                               _INTL("Wonder Room wore off, and Defense and Sp. Def stats returned to normal!"))
00463:     # Magic Room
00464:     pbEORCountDownFieldEffect(PBEffects::MagicRoom,
00465:                               _INTL("Magic Room wore off, and held items' effects returned to normal!"))
00466:   end
00467: 
00468:   #=============================================================================
00469:   # End Of Round end terrain check
00470:   #=============================================================================
00471:   def pbEOREndTerrain
00472:     # Count down terrain duration
00473:     @field.terrainDuration -= 1 if @field.terrainDuration > 0
00474:     # Terrain wears off
00475:     if @field.terrain != :None && @field.terrainDuration == 0
00476:       case @field.terrain
00477:       when :Electric
00478:         pbDisplay(_INTL("The electric current disappeared from the battlefield!"))
00479:       when :Grassy
00480:         pbDisplay(_INTL("The grass disappeared from the battlefield!"))
00481:       when :Misty
00482:         pbDisplay(_INTL("The mist disappeared from the battlefield!"))
00483:       when :Psychic
00484:         pbDisplay(_INTL("The weirdness disappeared from the battlefield!"))
00485:       end
00486:       @field.terrain = :None
00487:       allBattlers.each { |battler| battler.pbAbilityOnTerrainChange }
00488:       # Start up the default terrain
00489:       if @field.defaultTerrain != :None
00490:         pbStartTerrain(nil, @field.defaultTerrain, false)
00491:         allBattlers.each { |battler| battler.pbAbilityOnTerrainChange }
00492:         allBattlers.each { |battler| battler.pbItemTerrainStatBoostCheck }
00493:       end
00494:       return if @field.terrain == :None
00495:     end
00496:     # Terrain continues
00497:     terrain_data = GameData::BattleTerrain.try_get(@field.terrain)
00498:     pbCommonAnimation(terrain_data.animation) if terrain_data
00499:     case @field.terrain
00500:     when :Electric then pbDisplay(_INTL("An electric current is running across the battlefield."))
00501:     when :Grassy   then pbDisplay(_INTL("Grass is covering the battlefield."))
00502:     when :Misty    then pbDisplay(_INTL("Mist is swirling about the battlefield."))
00503:     when :Psychic  then pbDisplay(_INTL("The battlefield is weird."))
00504:     end
00505:   end
00506: 
00507:   #=============================================================================
00508:   # End Of Round end self-inflicted effects on battler
