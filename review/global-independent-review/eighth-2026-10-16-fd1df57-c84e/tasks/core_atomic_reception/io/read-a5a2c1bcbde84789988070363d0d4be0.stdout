00140:   end
00141: 
00142:   def update_shadow_moves
00143:     return if !@shadow_moves || @shadow_moves.empty?
00144:     # Not a Shadow Pokémon (any more); relearn all its original moves
00145:     if !shadowPokemon?
00146:       if @shadow_moves.length > MAX_MOVES
00147:         new_moves = []
00148:         @shadow_moves.each_with_index { |m, i| new_moves.push(m) if m && i >= MAX_MOVES }
00149:         replace_moves(new_moves)
00150:       end
00151:       @shadow_moves = nil
00152:       return
00153:     end
00154:     # Is a Shadow Pokémon; ensure it knows the appropriate moves depending on its heart stage
00155:     # Start with all Shadow moves
00156:     new_moves = []
00157:     @shadow_moves.each_with_index { |m, i| new_moves.push(m) if m && i < MAX_MOVES }
00158:     num_shadow_moves = new_moves.length
00159:     # Add some original moves (skipping ones in the same slot as a Shadow Move)
00160:     num_original_moves = [3, 3, 2, 1, 1, 0][self.heartStage]
00161:     if num_original_moves > 0
00162:       relearned_count = 0
00163:       @shadow_moves.each_with_index do |m, i|
00164:         next if !m || i < MAX_MOVES + num_shadow_moves
00165:         new_moves.push(m)
00166:         relearned_count += 1
00167:         break if relearned_count >= num_original_moves
00168:       end
00169:     end
00170:     # Relearn Shadow moves plus some original moves (may not change anything)
00171:     replace_moves(new_moves)
00172:   end
00173: 
00174:   def replace_moves(new_moves)
00175:     # Forget any known moves that aren't in new_moves
00176:     @moves.each_with_index do |m, i|
00177:       @moves[i] = nil if !new_moves.include?(m.id)
00178:     end
00179:     @moves.compact!
00180:     # Learn any moves in new_moves that aren't known
