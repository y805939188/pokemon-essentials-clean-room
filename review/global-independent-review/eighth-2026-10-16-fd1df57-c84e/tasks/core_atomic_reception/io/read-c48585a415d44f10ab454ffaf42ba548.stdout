00080: def pbStartOver(gameover = false)
00081:   if pbInBugContest?
00082:     pbBugContestStartOver
00083:     return
00084:   end
00085:   $stats.blacked_out_count += 1
00086:   $player.heal_party
00087:   if $PokemonGlobal.pokecenterMapId && $PokemonGlobal.pokecenterMapId >= 0
00088:     if gameover
00089:       pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
00090:                 _INTL("After the unfortunate defeat, you scurry back to a Pokémon Center."))
00091:     else
00092:       pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
00093:                 _INTL("You scurry back to a Pokémon Center, protecting your exhausted Pokémon from any further harm..."))
00094:     end
00095:     pbCancelVehicles
00096:     Followers.clear
00097:     $game_switches[Settings::STARTING_OVER_SWITCH] = true
00098:     $game_temp.player_new_map_id    = $PokemonGlobal.pokecenterMapId
00099:     $game_temp.player_new_x         = $PokemonGlobal.pokecenterX
00100:     $game_temp.player_new_y         = $PokemonGlobal.pokecenterY
00101:     $game_temp.player_new_direction = $PokemonGlobal.pokecenterDirection
00102:     pbDismountBike
00103:     $scene.transfer_player if $scene.is_a?(Scene_Map)
00104:     $game_map.refresh
00105:   else
00106:     homedata = GameData::PlayerMetadata.get($player.character_ID)&.home
00107:     homedata = GameData::Metadata.get.home if !homedata
00108:     if homedata && !pbRgssExists?(sprintf("Data/Map%03d.rxdata", homedata[0]))
00109:       if $DEBUG
00110:         pbMessage(_ISPRINTF("Can't find the map 'Map{1:03d}' in the Data folder. The game will resume at the player's position.", homedata[0]))
00111:       end
00112:       $player.heal_party
00113:       return
00114:     end
00115:     if gameover
00116:       pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
00117:                 _INTL("After the unfortunate defeat, you scurry back home."))
00118:     else
00119:       pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
00120:                 _INTL("You scurry back home, protecting your exhausted Pokémon from any further harm..."))
00121:     end
00122:     if homedata
00123:       pbCancelVehicles
00124:       Followers.clear
00125:       $game_switches[Settings::STARTING_OVER_SWITCH] = true
00126:       $game_temp.player_new_map_id    = homedata[0]
00127:       $game_temp.player_new_x         = homedata[1]
00128:       $game_temp.player_new_y         = homedata[2]
00129:       $game_temp.player_new_direction = homedata[3]
00130:       pbDismountBike
00131:       $scene.transfer_player if $scene.is_a?(Scene_Map)
00132:       $game_map.refresh
00133:     else
00134:       $player.heal_party
00135:     end
00136:   end
00137:   pbEraseEscapePoint
00138: end
