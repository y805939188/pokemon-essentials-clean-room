00173: class Battle::Move::TargetStatDownMove < Battle::Move
00174:   attr_reader :statDown
00175: 
00176:   def canMagicCoat?; return true; end
00177: 
00178:   def pbFailsAgainstTarget?(user, target, show_message)
00179:     return false if damagingMove?
00180:     return !target.pbCanLowerStatStage?(@statDown[0], user, self, show_message)
00181:   end
00182: 
00183:   def pbEffectAgainstTarget(user, target)
00184:     return if damagingMove?
00185:     target.pbLowerStatStage(@statDown[0], @statDown[1], user)
00186:   end
00187: 
00188:   def pbAdditionalEffect(user, target)
00189:     return if target.damageState.substitute
00190:     return if !target.pbCanLowerStatStage?(@statDown[0], user, self)
00191:     target.pbLowerStatStage(@statDown[0], @statDown[1], user)
00192:   end
00193: end
00194: 
00195: #===============================================================================
00196: # Lower multiple of target's stats.
00197: #===============================================================================
00198: class Battle::Move::TargetMultiStatDownMove < Battle::Move
00199:   attr_reader :statDown
00200: 
00201:   def canMagicCoat?; return true; end
00202: 
00203:   def pbFailsAgainstTarget?(user, target, show_message)
00204:     return false if damagingMove?
00205:     failed = true
00206:     (@statDown.length / 2).times do |i|
00207:       next if !target.pbCanLowerStatStage?(@statDown[i * 2], user, self)
00208:       failed = false
00209:       break
00210:     end
00211:     if failed
00212:       # NOTE: It's a bit of a faff to make sure the appropriate failure message
00213:       #       is shown here, I know.
00214:       canLower = false
00215:       if target.hasActiveAbility?(:CONTRARY) && !@battle.moldBreaker
00216:         (@statDown.length / 2).times do |i|
00217:           next if target.statStageAtMax?(@statDown[i * 2])
00218:           canLower = true
00219:           break
00220:         end
00221:         @battle.pbDisplay(_INTL("{1}'s stats won't go any higher!", user.pbThis)) if !canLower && show_message
00222:       else
00223:         (@statDown.length / 2).times do |i|
00224:           next if target.statStageAtMin?(@statDown[i * 2])
00225:           canLower = true
00226:           break
00227:         end
00228:         @battle.pbDisplay(_INTL("{1}'s stats won't go any lower!", user.pbThis)) if !canLower && show_message
00229:       end
