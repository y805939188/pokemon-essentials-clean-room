00426: class Battle::Move::PursueSwitchingFoe < Battle::Move
00427:   def pbAccuracyCheck(user, target)
00428:     return true if @battle.switching
00429:     return super
00430:   end
00431: 
00432:   def pbBaseDamage(baseDmg, user, target)
00433:     baseDmg *= 2 if @battle.switching
00434:     return baseDmg
00435:   end
00436: end
00437: 
00438: #===============================================================================
00439: # Fails if user has not been hit by an opponent's physical move this round.
00440: # (Shell Trap)
00441: #===============================================================================
00442: class Battle::Move::UsedAfterUserTakesPhysicalDamage < Battle::Move
00443:   def pbDisplayChargeMessage(user)
00444:     user.effects[PBEffects::ShellTrap] = true
00445:     @battle.pbCommonAnimation("ShellTrap", user)
00446:     @battle.pbDisplay(_INTL("{1} set a shell trap!", user.pbThis))
00447:   end
00448: 
00449:   def pbDisplayUseMessage(user)
00450:     super if user.tookPhysicalHit
00451:   end
00452: 
00453:   def pbMoveFailed?(user, targets)
00454:     if !user.effects[PBEffects::ShellTrap]
00455:       @battle.pbDisplay(_INTL("But it failed!"))
00456:       return true
00457:     end
00458:     if !user.tookPhysicalHit
00459:       @battle.pbDisplay(_INTL("{1}'s shell trap didn't work!", user.pbThis))
00460:       return true
00461:     end
00462:     return false
