00349: class Battle::Move::PowerHigherWithConsecutiveUseOnUserSide < Battle::Move
00350:   def pbChangeUsageCounters(user, specialUsage)
00351:     oldVal = user.pbOwnSide.effects[PBEffects::EchoedVoiceCounter]
00352:     super
00353:     if !user.pbOwnSide.effects[PBEffects::EchoedVoiceUsed]
00354:       user.pbOwnSide.effects[PBEffects::EchoedVoiceCounter] = (oldVal >= 5) ? 5 : oldVal + 1
00355:     end
00356:     user.pbOwnSide.effects[PBEffects::EchoedVoiceUsed] = true
00357:   end
00358: 
00359:   def pbBaseDamage(baseDmg, user, target)
00360:     return baseDmg * user.pbOwnSide.effects[PBEffects::EchoedVoiceCounter]   # 1-5
00361:   end
00362: end
00363: 
00364: #===============================================================================
00365: # Power is chosen at random. Power is doubled if the target is using Dig. Hits
