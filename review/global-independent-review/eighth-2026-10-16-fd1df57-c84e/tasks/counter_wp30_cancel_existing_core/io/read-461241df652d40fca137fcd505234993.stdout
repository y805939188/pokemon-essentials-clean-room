00001: #===============================================================================
00002: #
00003: #===============================================================================
00004: module MultipleForms
00005:   @@formSpecies = SpeciesHandlerHash.new
00006: 
00007:   def self.copy(sym, *syms)
00008:     @@formSpecies.copy(sym, *syms)
00009:   end
00010: 
00011:   def self.register(sym, hash)
00012:     @@formSpecies.add(sym, hash)
00013:   end
00014: 
00015:   def self.registerIf(sym, cond, hash)
00016:     @@formSpecies.addIf(sym, cond, hash)
00017:   end
00018: 
00019:   def self.hasFunction?(pkmn, func)
00020:     spec = (pkmn.is_a?(Pokemon)) ? pkmn.species : pkmn
00021:     sp = @@formSpecies[spec]
00022:     return sp && sp[func]
00023:   end
00024: 
00025:   def self.getFunction(pkmn, func)
00026:     spec = (pkmn.is_a?(Pokemon)) ? pkmn.species : pkmn
00027:     sp = @@formSpecies[spec]
00028:     return (sp && sp[func]) ? sp[func] : nil
00029:   end
00030: 
00031:   def self.call(func, pkmn, *args)
00032:     sp = @@formSpecies[pkmn.species]
00033:     return nil if !sp || !sp[func]
00034:     return sp[func].call(pkmn, *args)
00035:   end
00036: end
00037: 
