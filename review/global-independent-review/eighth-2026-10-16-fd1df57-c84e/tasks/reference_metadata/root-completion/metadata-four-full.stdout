FILE .gitignore bytes=491 encoding=utf-8
1: # Audio, Graphics and Plugins folders
2: Audio/
3: Graphics/
4: Plugins/
5: Screenshots/
6: 
7: # Data folder, but not Data/Scripts folder or messages_core.dat
8: Data/*
9: !Data/Scripts.rxdata
10: !Data/Scripts/
11: !Data/messages_core.dat
12: 
13: # Files in the main project folder
14: errorlog.txt
15: Game.ini
16: Game.rxproj
17: RGSS*.dll
18: 
19: # Common code editor folders & files
20: .vscode/
21: *.code-workspace
22: .idea/
23: *.mkproj
24: 
25: # Operating system generated files & folders
26: .DS_Store
27: .DS_Store?
28: ehthumbs.db
29: Thumbs.db
30: [Dd]esktop.ini
31: 
32: # Temp files
33: 
34: ~*
END .gitignore
FILE .rubocop.yml bytes=7806 encoding=utf-8
1: AllCops:
2:   TargetRubyVersion: "3.0"
3:   NewCops: enable
4: 
5: #===============================================================================
6: # Layout
7: #===============================================================================
8: 
9: # We don't need empty lines in methods to separate "return if"s from later code.
10: Layout/EmptyLineAfterGuardClause:
11:   Enabled: false
12: 
13: # Extra whitespace often helps to make code more presentable.
14: Layout/ExtraSpacing:
15:   AllowForAlignment: true
16:   AllowBeforeTrailingComments: true
17: 
18: # Looks better than having hash elements shifted way to the right just to line
19: # up with the hash's opening bracket.
20: Layout/FirstHashElementIndentation:
21:   EnforcedStyle: consistent
22: 
23: # In a hash with multiple values (one per line), prefer the => to be lined up
24: # and text to otherwise be left-aligned.
25: Layout/HashAlignment:
26:   EnforcedHashRocketStyle: table
27:   EnforcedColonStyle: table
28: 
29: # This interferes with the presentation of some code, notably registered procs.
30: Layout/MultilineMethodCallBraceLayout:
31:   Enabled: false
32: 
33: # This means hashes and arrays are written the same way, rather than hashes
34: # needing to be written like { foo => bar } while arrays are like [foo, bar].
35: Layout/SpaceInsideHashLiteralBraces:
36:   EnforcedStyle: no_space
37: 
38: #===============================================================================
39: # Lint
40: #===============================================================================
41: 
42: # Some methods and blocks will have unused arguments. That's fine.
43: Lint/UnusedBlockArgument:
44:   Enabled: false
45: Lint/UnusedMethodArgument:
46:   Enabled: false
47: 
48: #===============================================================================
49: # Metrics
50: #===============================================================================
51: 
52: # Yes, Essentials has classes/modules/methods that are too big and complex.
53: # That's just how it is.
54: Metrics:
55:   Enabled: false
56: 
57: #===============================================================================
58: # Naming
59: #===============================================================================
60: 
61: # This cop forbids class/module names with underscores in them. Having
62: # underscores isn't the end of the world.
63: Naming/ClassAndModuleCamelCase:
64:   Enabled: false
65: 
66: # Script files are given names that look reasonable in the list of script
67: # sections in RMXP, and are all numbered. They won't be camel_case.
68: Naming/FileName:
69:   Enabled: false
70: 
71: # Disabled for sanity's sake. While this is a cop we want to obey, fixing all
72: # this is a gargantuan task that may never be completed, and we don't need
73: # rubocop telling us about the 4000+ instances of camelCase method names.
74: Naming/MethodName:
75:   Enabled: false
76: 
77: # Disabled for sanity's sake. While this is a cop we want to obey, fixing all
78: # this is a gargantuan task that may never be completed, and we don't need
79: # rubocop telling us about the 1500+ instances of camelCase parameter names.
80: Naming/MethodParameterName:
81:   Enabled: false
82: 
83: # Disabled for sanity's sake. While this is a cop we want to obey, fixing all
84: # this is a gargantuan task that may never be completed, and we don't need
85: # rubocop telling us about the 10000+ instances of camelCase variable names.
86: Naming/VariableName:
87:   Enabled: false
88: 
89: #===============================================================================
90: # Security
91: #===============================================================================
92: 
93: # Script event conditions and script switches are eval'd, amongst other things.
94: Security/Eval:
95:   Enabled: false
96: 
97: # Plenty of things are loaded via Marshal.
98: Security/MarshalLoad:
99:   Enabled: false
100: 
101: #===============================================================================
102: # Style
103: #===============================================================================
104: 
105: # List the attr_reader/writer/accessor variables however you want.
106: Style/AccessorGrouping:
107:   Enabled: false
108: 
109: # The assign_to_condition style looks awful, indenting loads of lines and
110: # increasing the separation between variable and value being assigned to it.
111: # Having said that, using "assign_inside_condition" flags every instance of
112: # conditional assignment using a one-line ternary operator, so this cop has been
113: # disabled because such assignment is fine.
114: Style/ConditionalAssignment:
115:   Enabled: false
116:   EnforcedStyle: assign_inside_condition
117: 
118: # Check with yard instead.
119: Style/Documentation:
120:   Enabled: false
121: 
122: # This is just shorthand that looks bad due to the lack of an "end" to a "def".
123: Style/EndlessMethod:
124:   EnforcedStyle: disallow
125: 
126: # It's a choice between format and sprintf. We already make use of sprintf and
127: # the translatable _ISPRINTF, so...
128: Style/FormatString:
129:   EnforcedStyle: sprintf
130: 
131: # Prefer sprintf("%s", "Hello") over sprintf("%<greeting>s", greeting: "Hello")
132: # because it should be easy enough to see which token is which, and it saves
133: # space.
134: Style/FormatStringToken:
135:   EnforcedStyle: unannotated
136: 
137: # String literals are not frozen by default, which makes this comment a
138: # pointless bit of boilerplate that we neither need nor want.
139: Style/FrozenStringLiteralComment:
140:   Enabled: false
141: 
142: # RMXP and Essentials use lots of global variables.
143: Style/GlobalVars:
144:   Enabled: false
145: 
146: # Mixing the styles within a hash just looks silly.
147: Style/HashSyntax:
148:   EnforcedStyle: no_mixed_keys
149: 
150: # Sometimes you want to clearly separate sets of code, one per "paradigm".
151: Style/IfInsideElse:
152:   Enabled: false
153:   AllowIfModifier: true
154: 
155: # The alernative is ->(x) { x } which is less English than "lambda". This style
156: # makes lambda definitions require the word "lambda".
157: Style/Lambda:
158:   EnforcedStyle: lambda
159: 
160: # unless just adds mental gymnastics trying to figure out what it actually
161: # means. I much prefer if !something.
162: Style/NegatedIf:
163:   Enabled: false
164: 
165: # .zero?, .positive? and .negative? are more wordy than == 0, > 0 and < 0. They
166: # also aren't consistent with other value comparisons, e.g. x > 42.
167: Style/NumericPredicate:
168:   EnforcedStyle: comparison
169: 
170: # Following this just means that calls to an affected method need to know what
171: # that method calls its parameters, which is ridiculous. Keep things short and
172: # simple.
173: Style/OptionalBooleanParameter:
174:   Enabled: false
175: 
176: # has_key? and has_value? are far more readable than key? and value?
177: Style/PreferredHashMethods:
178:   Enabled: false
179: 
180: # Explicit returns help to show whether a method returns a value.
181: Style/RedundantReturn:
182:   Enabled: false
183: 
184: # Enforcing the names of variables? To single letter ones? Just no.
185: Style/SingleLineBlockParams:
186:   Enabled: false
187: 
188: # Single line methods use up less space, and they're easier to list next to each
189: # other and see that they behave similarly.
190: Style/SingleLineMethods:
191:   Enabled: false
192: 
193: # This requires writing array[n..] instead of array[n..-1], and I think endless
194: # ranges look bad.
195: Style/SlicingWithRange:
196:   Enabled: false
197: 
198: # Single quotes being faster is hardly measurable and only affects parse time.
199: # Enforcing double quotes reduces the times where you need to change them
200: # when introducing an interpolation or an apostrophe. Use single quotes only if
201: # their semantics are needed.
202: Style/StringLiterals:
203:   EnforcedStyle: double_quotes
204: 
205: # This cop requires arrays of symbols/text to be written like %i[a b c]. We
206: # don't need that nonsense. ["a", "b", "c"] is clearer and introduces no
207: # additional syntax to confuse people.
208: Style/SymbolArray:
209:   EnforcedStyle: brackets
210: Style/WordArray:
211:   EnforcedStyle: brackets
212: 
213: # Allows procs to be written like { |obj| obj.something } which is clearer.
214: Style/SymbolProc:
215:   AllowMethodsWithArguments: true
216: 
217: # Parentheses around the condition in a ternary operator helps to differentiate
218: # it from the true/false results.
219: Style/TernaryParentheses:
220:   EnforcedStyle: require_parentheses
221: 
222: # This prefers "x += 1 while x < 10" and "x += 1 until x == 10". This hides
223: # loops, which is not good.
224: Style/WhileUntilModifier:
225:   Enabled: false
END .rubocop.yml
