  "five_world_chains": [
    {
      "id": "WORLD5-VEHICLE",
      "source": "Scene_Map:72–101/121–134/165–230; command201:722–747; Player:575–616; Overworld:267–276; MapFactory:142–149",
      "formal": "WP11:64–73; WP12:184–196",
      "fact": "201守卫排队后两场景以false消费而保留游泳；直接省参清游泳，骑行按目的地另查。跨图进入通知可上/下车，同图无该次通知。前序helper异常保留已到前缀。"
    },
    {
      "id": "WORLD5-STEP",
      "source": "Player:141–193/416–555; Character:362–400/893–992; Overworld:172–218",
      "formal": "WP12:97–113; WP06:82–97",
      "fact": "逻辑坐标/距离/条件离格先于动画完成；完成后合格玩家入口才全局步数加一并31位回绕。强制路线/解释器早退只发一般通知；不把距离零等同周期不进。"
    },
    {
      "id": "WORLD5-FOLLOW",
      "source": "Follower:36–111/134–215; Factory:155–191; Scene_Map:72–101",
      "formal": "WP13:154–168; WP12:86–89",
      "fact": "实际location入口与strict能力不同；同轴1/2格按许可尝试，其它非重合直接定位。临时through仅正常返回恢复；逐跟随者正常调用后才写持久记录，显式转移同时写runtime/记录。"
    },
    {
      "id": "WORLD5-ERROR",
      "source": "Interpreter:138–206",
      "formal": "WP13:104–109",
      "fact": "SystemExit及类名Reset原样抛，其他异常构造带上下文EventScriptError；正常表达式返回原值。异常包装不撤销前写入；错误格式化/宿主呈现本次未证明。"
    },
    {
      "id": "WORLD5-MISSINGMAP",
      "source": "Scene_Map:56–101; StartGame:63–104; MapFactory:7–27; Map:39–74",
      "formal": "WP11:64–66/171; WP09:95–109; WP10:243–247",
      "fact": "显式缺图无选图恢复；有BGM/BGS时先读目标图而失败，皆无时可在重建后失败。读档仅magic/safesave重建路径捕ENOENT，调试选图/取消退出、非调试抛错；nil事件集合与空集合不同。"
    }
  ],
