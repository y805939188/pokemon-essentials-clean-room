    },
    {
      "id": "WFS-025-04",
      "fact": "直接跳不走普通遭遇门，坐标变才按两轴绝对距离累计。"
    },
    {
      "id": "WFS-025-05",
      "fact": "玩家边界先宽松/跨图，只有当前图有效内才DEBUG Ctrl，再角色外层。"
    },
    {
      "id": "WFS-025-06",
      "fact": "落位继承模操作后按原输入中心镜头并重置遭遇计数（双随机+1）。"
    }
  ],
