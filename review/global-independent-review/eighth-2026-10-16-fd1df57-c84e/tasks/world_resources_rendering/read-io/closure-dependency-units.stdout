   220	      if lineno == 1 && line[0].ord == 0xEF && line[1].ord == 0xBB && line[2].ord == 0xBF
   221	        line = line[3, line.length - 3]
   222	      end
   223	      line.force_encoding(Encoding::UTF_8)
   224	      line = prepline(line)
   225	      yield line, lineno if !line[/^\#/] && !line[/^\s*$/]
   226	      lineno += 1
   227	    end
   228	  end
   229	
   230	  # Used for map_connections.txt, phone.txt, regional_dexes.txt, encounters.txt,
   231	  # trainers.txt and dungeon_tilesets.txt
   232	  def pbCompilerEachPreppedLine(filename)
   233	    File.open(filename, "rb") do |f|
   234	      FileLineData.file = filename
   235	      lineno = 1
   236	      f.each_line do |line|
   237	        if lineno == 1 && line[0].ord == 0xEF && line[1].ord == 0xBB && line[2].ord == 0xBF
   238	          line = line[3, line.length - 3]
   239	        end
   240	        line.force_encoding(Encoding::UTF_8)
   241	        line = prepline(line)
   242	        if !line[/^\#/] && !line[/^\s*$/]
   243	          FileLineData.setLine(line, lineno)
   244	          yield line, lineno
   245	        end
   246	        lineno += 1
   247	      end
   248	    end
   249	  end
   250	
   251	  #=============================================================================
   252	  # Splits a string containing comma-separated values into an array of those
   253	  # values.
   254	  #=============================================================================
   255	  def split_csv_line(string)
   256	    # Split the string into an array of values, using a comma as the separator
   257	    values = string.split(",")
   258	    # Check for quote marks in each value, as we may need to recombine some values
   259	    # to make proper results
   260	    (0...values.length).each do |i|
   261	      value = values[i]
   262	      next if !value || value.empty?
   263	      quote_count = value.count('"')
   264	      if quote_count != 0
   265	        # Quote marks found in value
   266	        (i...(values.length - 1)).each do |j|
   267	          quote_count = values[i].count('"')
   268	          if quote_count == 2 && value.start_with?('\\"') && values[i].end_with?('\\"')
   269	            # Two quote marks around the whole value; remove them
   270	            values[i] = values[i][2..-3]
   271	            break
   272	          elsif quote_count.even?
   273	            break
   274	          end
   275	          # Odd number of quote marks in value; concatenate the next value to it and
   276	          # see if that's any better
   277	          values[i] += "," + values[j + 1]
   278	          values[j + 1] = nil
   279	        end
   280	        # Recheck for enclosing quote marks to remove
   281	        if quote_count != 2
   282	          if value.count('"') == 2 && value.start_with?('\\"') && value.end_with?('\\"')
   283	            values[i] = values[i][2..-3]
   284	          end
   285	        end
   286	      end
   287	      # Remove leading and trailing whitespace from value
   288	      values[i].strip!
   289	    end
   290	    # Remove nil values caused by concatenating values above
   291	    values.compact!
   292	    return values
   293	  end
   294	
