   683	  #=============================================================================
   684	  # Save map metadata data to PBS file
   685	  # NOTE: Doesn't use write_PBS_file_generic because it writes the RMXP map name
   686	  #       next to the section header for each map.
   687	  #=============================================================================
   688	  def write_map_metadata
   689	    paths = get_all_PBS_file_paths(GameData::MapMetadata)
   690	    map_infos = pbLoadMapInfos
   691	    schema = GameData::MapMetadata.schema
   692	    idx = 0
   693	    paths.each do |path|
   694	      write_pbs_file_message_start(path[0])
   695	      File.open(path[0], "wb") do |f|
   696	        add_PBS_header_to_file(f)
   697	        GameData::MapMetadata.each do |element|
   698	          next if element.pbs_file_suffix != path[1]
   699	          echo "." if idx % 100 == 0
   700	          Graphics.update if idx % 500 == 0
   701	          idx += 1
   702	          f.write("\#-------------------------------\r\n")
   703	          map_name = (map_infos && map_infos[element.id]) ? map_infos[element.id].name : nil
   704	          f.write(sprintf("[%03d]", element.id))
   705	          f.write(sprintf("   # %s", map_name)) if map_name
   706	          f.write("\r\n")
   707	          schema.each_key do |key|
   708	            next if key == "SectionName"
   709	            val = element.get_property_for_PBS(key)
   710	            next if val.nil?
   711	            if schema[key][1][0] == "^" && val.is_a?(Array)
   712	              val.each do |sub_val|
   713	                f.write(sprintf("%s = ", key))
   714	                pbWriteCsvRecord(sub_val, f, schema[key])
   715	                f.write("\r\n")
   716	              end
   717	            else
   718	              f.write(sprintf("%s = ", key))
   719	              pbWriteCsvRecord(val, f, schema[key])
   720	              f.write("\r\n")
   721	            end
   722	          end
   723	        end
   724	      end
   725	      process_pbs_file_message_end
   726	    end
   727	  end
