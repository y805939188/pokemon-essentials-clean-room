   301	    ret = ""
   302	    str.sub!(/^\s*/, "")
   303	    if str[0, 1] == "\""
   304	      str[0, 1] = ""
   305	      escaped = false
   306	      fieldbytes = 0
   307	      str.scan(/./) do |s|
   308	        fieldbytes += s.length
   309	        break if s == "\"" && !escaped
   310	        if s == "\\" && !escaped
   675	            end
   676	          end
   677	        end
   678	      end
   679	      process_pbs_file_message_end
   680	    end
