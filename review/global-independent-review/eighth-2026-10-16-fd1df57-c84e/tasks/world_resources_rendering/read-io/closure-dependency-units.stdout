   313	  def pbAddSprite(id, x, y, filename, viewport)
   314	    sprite = @sprites[id] || IconSprite.new(x, y, viewport)
   315	    if filename
   316	      sprite.setBitmap(filename) rescue nil
   317	    end
   318	    @sprites[id] = sprite
   319	    return sprite
   320	  end
   321	
   322	  def pbAddPlane(id, filename, viewport)
   323	    sprite = AnimatedPlane.new(viewport)
   324	    if filename
   325	      sprite.setBitmap(filename)
   326	    end
   327	    @sprites[id] = sprite
   328	    return sprite
   329	  end
   330	
   331	  def pbDisposeSprites
   332	    pbDisposeSpriteHash(@sprites)
   333	  end
