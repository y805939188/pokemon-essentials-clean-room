    71	    def apply_metrics_to_sprite(sprite, index, shadow = false)
    72	      if shadow
    73	        sprite.x += @shadow_x * 2 if (index & 1) == 1   # Foe Pokémon
    74	      elsif (index & 1) == 0   # Player's Pokémon
    75	        sprite.x += @back_sprite[0] * 2
    76	        sprite.y += @back_sprite[1] * 2
    77	      else                     # Foe Pokémon
    78	        sprite.x += @front_sprite[0] * 2
    79	        sprite.y += @front_sprite[1] * 2
    80	        sprite.y -= @front_sprite_altitude * 2
    81	      end
    82	    end
