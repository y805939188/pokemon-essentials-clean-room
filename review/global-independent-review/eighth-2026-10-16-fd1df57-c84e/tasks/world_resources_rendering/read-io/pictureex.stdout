     4	class PictureOrigin
     5	  TOP_LEFT     = 0
     6	  CENTER       = 1
     7	  TOP_RIGHT    = 2
     8	  BOTTOM_LEFT  = 3
     9	  LOWER_LEFT   = 3
    10	  BOTTOM_RIGHT = 4
    11	  LOWER_RIGHT  = 4
    12	  TOP          = 5
    13	  BOTTOM       = 6
    14	  LEFT         = 7
    15	  RIGHT        = 8
    16	end
