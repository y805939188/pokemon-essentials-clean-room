   301	  def moveHue(delay, duration, hue, cb = nil)
   302	    delay, duration = ensureDelayAndDuration(delay, duration)
   303	    @processes.push([Processes::HUE, delay, duration, false, cb, @hue, hue])
   304	  end
   305	
   306	  # Hue changes don't actually work.
   307	  def setHue(delay, hue, cb = nil)
