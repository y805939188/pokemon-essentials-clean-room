    81	# PictureEx
    82	#===============================================================================
    83	class PictureEx
    84	  attr_accessor :x              # x-coordinate
    85	  attr_accessor :y              # y-coordinate
    86	  attr_accessor :z              # z value
    87	  attr_accessor :zoom_x         # x directional zoom rate
    88	  attr_accessor :zoom_y         # y directional zoom rate
    89	  attr_accessor :angle          # rotation angle
    90	  attr_accessor :tone           # tone
    91	  attr_accessor :color          # color
    92	  attr_accessor :hue            # filename hue
    93	  attr_accessor :opacity        # opacity level
    94	  attr_accessor :visible        # visibility boolean
    95	  attr_accessor :blend_type     # blend method
    96	  attr_accessor :name           # file name
    97	  attr_accessor :origin         # starting point
    98	  attr_reader   :src_rect       # source rect
    99	  attr_reader   :cropBottom     # crops sprite to above this y-coordinate
   100	  attr_reader   :frameUpdates   # Array of processes updated in a frame
   101	
   102	  def move_processes
   103	    ret = []
   104	    @processes.each do |p|
   105	      next if ![Processes::XY, Processes::DELTA_XY].include?(p[0])
   106	      pro = []
   107	      pro.push(p[0] == Processes::XY ? "XY" : "DELTA")
   108	      if p[1] == 0 && p[2] == 0
   109	        pro.push("start " + p[7].to_i.to_s + ", " + p[8].to_i.to_s)
   110	      else
   111	        pro.push("for " + p[2].to_s) if p[2] > 0
   112	        if p[0] == Processes::XY
   113	          pro.push("go to " + p[7].to_i.to_s + ", " + p[8].to_i.to_s)
   114	        else
   115	          pro.push("move by " + p[7].to_i.to_s + ", " + p[8].to_i.to_s)
   116	        end
   117	      end
   118	      ret.push(pro)
   119	    end
   120	    return ret
   121	  end
   122	
   123	  def initialize(z)
   124	    # process: [type, delay, total_duration, frame_counter, cb, etc.]
   125	    @processes     = []
   126	    @x             = 0.0
   127	    @y             = 0.0
   128	    @z             = z
   129	    @zoom_x        = 100.0
   130	    @zoom_y        = 100.0
   131	    @angle         = 0
   132	    @rotate_speed  = 0
   133	    @auto_angle    = 0   # Cumulative angle change caused by @rotate_speed
   134	    @tone          = Tone.new(0, 0, 0, 0)
   135	    @tone_duration = 0
   136	    @color         = Color.new(0, 0, 0, 0)
   137	    @hue           = 0
   138	    @opacity       = 255.0
   139	    @visible       = true
   140	    @blend_type    = 0
   141	    @name          = ""
   142	    @origin        = PictureOrigin::TOP_LEFT
   143	    @src_rect      = Rect.new(0, 0, -1, -1)
   144	    @cropBottom    = -1
   145	    @frameUpdates  = []
   146	  end
   147	
   148	  def callback(cb)
   149	    case cb
   150	    when Proc
   151	      cb.call(self)
   152	    when Array
   153	      cb[0].method(cb[1]).call(self, *cb[2])
   154	    when Method
   155	      cb.call(self)
   156	    end
   157	  end
   158	
   159	  def setCallback(delay, cb = nil)
   160	    delay = ensureDelayAndDuration(delay)
   161	    @processes.push([nil, delay, 0, false, cb])
   162	  end
   163	
   164	  def running?
   165	    return @processes.length > 0
   166	  end
   167	
   168	  def totalDuration
   169	    ret = 0
   170	    @processes.each do |process|
   171	      dur = process[1] + process[2]
   172	      ret = dur if dur > ret
   173	    end
   174	    return ret
   175	  end
   176	
   177	  def ensureDelayAndDuration(delay, duration = nil)
   178	    delay = self.totalDuration if delay < 0
   179	    return delay, duration if !duration.nil?
   180	    return delay
   181	  end
   182	
   183	  def ensureDelay(delay)
   184	    return ensureDelayAndDuration(delay)
   185	  end
   186	
   187	  # speed is the angle to change by in 1/20 of a second. @rotate_speed is the
   188	  # angle to change by per frame.
   189	  # NOTE: This is not compatible with manually changing the angle at a certain
   190	  #       point. If you make a sprite auto-rotate, you should not try to alter
   191	  #       the angle another way too.
   192	  def rotate(speed)
   193	    @rotate_speed = speed * 20.0
   194	  end
   195	
   196	  def erase
   197	    self.name = ""
   198	  end
   199	
   200	  def clearProcesses
   201	    @processes = []
   202	    @timer_start = nil
   203	  end
   204	
   205	  def adjustPosition(xOffset, yOffset)
   206	    @processes.each do |process|
   207	      next if process[0] != Processes::XY
   208	      process[5] += xOffset
   209	      process[6] += yOffset
   210	      process[7] += xOffset
   211	      process[8] += yOffset
   212	    end
   213	  end
   214	
   215	  def move(delay, duration, origin, x, y, zoom_x = 100.0, zoom_y = 100.0, opacity = 255)
   216	    setOrigin(delay, duration, origin)
   217	    moveXY(delay, duration, x, y)
   218	    moveZoomXY(delay, duration, zoom_x, zoom_y)
   219	    moveOpacity(delay, duration, opacity)
   220	  end
   221	
   222	  def moveXY(delay, duration, x, y, cb = nil)
   223	    delay, duration = ensureDelayAndDuration(delay, duration)
   224	    @processes.push([Processes::XY, delay, duration, false, cb, @x, @y, x, y])
   225	  end
   226	
   227	  def setXY(delay, x, y, cb = nil)
   228	    moveXY(delay, 0, x, y, cb)
   229	  end
   230	
   231	  def moveCurve(delay, duration, x1, y1, x2, y2, x3, y3, cb = nil)
   232	    delay, duration = ensureDelayAndDuration(delay, duration)
   233	    @processes.push([Processes::CURVE, delay, duration, false, cb, [@x, @y, x1, y1, x2, y2, x3, y3]])
   234	  end
   235	
   236	  def moveDelta(delay, duration, x, y, cb = nil)
   237	    delay, duration = ensureDelayAndDuration(delay, duration)
   238	    @processes.push([Processes::DELTA_XY, delay, duration, false, cb, @x, @y, x, y])
   239	  end
   240	
   241	  def setDelta(delay, x, y, cb = nil)
   242	    moveDelta(delay, 0, x, y, cb)
   243	  end
   244	
   245	  def moveZ(delay, duration, z, cb = nil)
   246	    delay, duration = ensureDelayAndDuration(delay, duration)
   247	    @processes.push([Processes::Z, delay, duration, false, cb, @z, z])
   248	  end
   249	
   250	  def setZ(delay, z, cb = nil)
   251	    moveZ(delay, 0, z, cb)
   252	  end
   253	
   254	  def moveZoomXY(delay, duration, zoom_x, zoom_y, cb = nil)
   255	    delay, duration = ensureDelayAndDuration(delay, duration)
   256	    @processes.push([Processes::ZOOM, delay, duration, false, cb, @zoom_x, @zoom_y, zoom_x, zoom_y])
   257	  end
   258	
   259	  def setZoomXY(delay, zoom_x, zoom_y, cb = nil)
   260	    moveZoomXY(delay, 0, zoom_x, zoom_y, cb)
   261	  end
   262	
   263	  def moveZoom(delay, duration, zoom, cb = nil)
   264	    moveZoomXY(delay, duration, zoom, zoom, cb)
   265	  end
   266	
   267	  def setZoom(delay, zoom, cb = nil)
   268	    moveZoomXY(delay, 0, zoom, zoom, cb)
   269	  end
