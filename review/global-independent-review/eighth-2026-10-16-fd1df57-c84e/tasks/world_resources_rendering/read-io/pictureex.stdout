   271	  def moveAngle(delay, duration, angle, cb = nil)
   272	    delay, duration = ensureDelayAndDuration(delay, duration)
   273	    @processes.push([Processes::ANGLE, delay, duration, false, cb, @angle, angle])
   274	  end
   275	
   276	  def setAngle(delay, angle, cb = nil)
