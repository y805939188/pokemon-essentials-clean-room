   356	  # Used to cut Pokémon sprites off when they faint and sink into the ground.
   357	  def setCropBottom(delay, y, cb = nil)
   358	    delay = ensureDelay(delay)
   359	    @processes.push([Processes::CROP_BOTTOM, delay, 0, false, cb, y])
   360	  end
   361	
   362	  def update
   363	    time_now = System.uptime
   364	    @timer_start = time_now if !@timer_start
   365	    this_frame = ((time_now - @timer_start) * 20).to_i   # 20 frames per second
   366	    procEnded = false
   367	    @frameUpdates.clear
   368	    @processes.each_with_index do |process, i|
   369	      # Skip processes that aren't due to start yet
   370	      next if process[1] > this_frame
   371	      # Set initial values if the process has just started
   372	      if !process[3]   # Not started yet
   373	        process[3] = true   # Running
   374	        case process[0]
   375	        when Processes::XY
   376	          process[5] = @x
   377	          process[6] = @y
   378	        when Processes::DELTA_XY
   379	          process[5] = @x
   380	          process[6] = @y
   381	          process[7] += @x
   382	          process[8] += @y
   383	        when Processes::CURVE
   384	          process[5][0] = @x
   385	          process[5][1] = @y
   386	        when Processes::Z
   387	          process[5] = @z
   388	        when Processes::ZOOM
   389	          process[5] = @zoom_x
   390	          process[6] = @zoom_y
   391	        when Processes::ANGLE
   392	          process[5] = @angle
   393	        when Processes::TONE
   394	          process[5] = @tone.clone
   395	        when Processes::COLOR
   396	          process[5] = @color.clone
   397	        when Processes::HUE
   398	          process[5] = @hue
   399	        when Processes::OPACITY
   400	          process[5] = @opacity
   401	        end
   402	      end
   403	      # Update process
   404	      @frameUpdates.push(process[0]) if !@frameUpdates.include?(process[0])
   405	      start_time = @timer_start + (process[1] / 20.0)
   406	      duration = process[2] / 20.0
   407	      case process[0]
   408	      when Processes::XY, Processes::DELTA_XY
   409	        @x = lerp(process[5], process[7], duration, start_time, time_now)
   410	        @y = lerp(process[6], process[8], duration, start_time, time_now)
   411	      when Processes::CURVE
   412	        @x, @y = getCubicPoint2(process[5], (time_now - start_time) / duration)
   413	      when Processes::Z
   414	        @z = lerp(process[5], process[6], duration, start_time, time_now)
   415	      when Processes::ZOOM
   416	        @zoom_x = lerp(process[5], process[7], duration, start_time, time_now)
   417	        @zoom_y = lerp(process[6], process[8], duration, start_time, time_now)
   418	      when Processes::ANGLE
   419	        @angle = lerp(process[5], process[6], duration, start_time, time_now)
   420	      when Processes::TONE
   421	        @tone.red = lerp(process[5].red, process[6].red, duration, start_time, time_now)
   422	        @tone.green = lerp(process[5].green, process[6].green, duration, start_time, time_now)
   423	        @tone.blue = lerp(process[5].blue, process[6].blue, duration, start_time, time_now)
   424	        @tone.gray = lerp(process[5].gray, process[6].gray, duration, start_time, time_now)
   425	      when Processes::COLOR
   426	        @color.red = lerp(process[5].red, process[6].red, duration, start_time, time_now)
   427	        @color.green = lerp(process[5].green, process[6].green, duration, start_time, time_now)
   428	        @color.blue = lerp(process[5].blue, process[6].blue, duration, start_time, time_now)
   429	        @color.alpha = lerp(process[5].alpha, process[6].alpha, duration, start_time, time_now)
   430	      when Processes::HUE
   431	        @hue = lerp(process[5], process[6], duration, start_time, time_now)
   432	      when Processes::OPACITY
   433	        @opacity = lerp(process[5], process[6], duration, start_time, time_now)
   434	      when Processes::VISIBLE
   435	        @visible = process[5]
   436	      when Processes::BLEND_TYPE
   437	        @blend_type = process[5]
   438	      when Processes::SE
   439	        pbSEPlay(process[5], process[6], process[7])
   440	      when Processes::NAME
   441	        @name = process[5]
   442	      when Processes::ORIGIN
   443	        @origin = process[5]
   444	      when Processes::SRC
   445	        @src_rect.x = process[5]
   446	        @src_rect.y = process[6]
   447	      when Processes::SRC_SIZE
   448	        @src_rect.width  = process[5]
   449	        @src_rect.height = process[6]
   450	      when Processes::CROP_BOTTOM
   451	        @cropBottom = process[5]
   452	      end
   453	      # Erase process if its duration has elapsed
   454	      if process[1] + process[2] <= this_frame
   455	        callback(process[4]) if process[4]
   456	        @processes[i] = nil
   457	        procEnded = true
   458	      end
   459	    end
   460	    # Clear out empty spaces in @processes array caused by finished processes
   461	    @processes.compact! if procEnded
   462	    @timer_start = nil if @processes.empty? && @rotate_speed == 0
   463	    # Add the constant rotation speed
   464	    if @rotate_speed != 0
   465	      @frameUpdates.push(Processes::ANGLE) if !@frameUpdates.include?(Processes::ANGLE)
   466	      @auto_angle = @rotate_speed * (time_now - @timer_start)
   467	      while @auto_angle < 0
   468	        @auto_angle += 360
   469	      end
   470	      @auto_angle %= 360
   471	      @angle += @rotate_speed
   472	      while @angle < 0
   473	        @angle += 360
   474	      end
   475	      @angle %= 360
   476	    end
   477	  end
   478	end
   479	
   480	#===============================================================================
   481	#
   482	#===============================================================================
   483	def setPictureSprite(sprite, picture, iconSprite = false)
   484	  return if picture.frameUpdates.length == 0
   485	  picture.frameUpdates.each do |type|
   486	    case type
   487	    when Processes::XY, Processes::DELTA_XY
   488	      sprite.x = picture.x.round
   489	      sprite.y = picture.y.round
   490	    when Processes::Z
   491	      sprite.z = picture.z
   492	    when Processes::ZOOM
   493	      sprite.zoom_x = picture.zoom_x / 100.0
   494	      sprite.zoom_y = picture.zoom_y / 100.0
   495	    when Processes::ANGLE
   496	      sprite.angle = picture.angle
   497	    when Processes::TONE
   498	      sprite.tone = picture.tone
   499	    when Processes::COLOR
   500	      sprite.color = picture.color
   501	    when Processes::HUE
   502	      # This doesn't do anything.
   503	    when Processes::BLEND_TYPE
   504	      sprite.blend_type = picture.blend_type
   505	    when Processes::OPACITY
   506	      sprite.opacity = picture.opacity
   507	    when Processes::VISIBLE
   508	      sprite.visible = picture.visible
   509	    when Processes::NAME
   510	      sprite.name = picture.name if iconSprite && sprite.name != picture.name
   511	    when Processes::ORIGIN
   512	      case picture.origin
   513	      when PictureOrigin::TOP_LEFT, PictureOrigin::LEFT, PictureOrigin::BOTTOM_LEFT
   514	        sprite.ox = 0
   515	      when PictureOrigin::TOP, PictureOrigin::CENTER, PictureOrigin::BOTTOM
   516	        sprite.ox = (sprite.bitmap && !sprite.bitmap.disposed?) ? sprite.src_rect.width / 2 : 0
   517	      when PictureOrigin::TOP_RIGHT, PictureOrigin::RIGHT, PictureOrigin::BOTTOM_RIGHT
   518	        sprite.ox = (sprite.bitmap && !sprite.bitmap.disposed?) ? sprite.src_rect.width : 0
   519	      end
   520	      case picture.origin
   521	      when PictureOrigin::TOP_LEFT, PictureOrigin::TOP, PictureOrigin::TOP_RIGHT
   522	        sprite.oy = 0
   523	      when PictureOrigin::LEFT, PictureOrigin::CENTER, PictureOrigin::RIGHT
   524	        sprite.oy = (sprite.bitmap && !sprite.bitmap.disposed?) ? sprite.src_rect.height / 2 : 0
   525	      when PictureOrigin::BOTTOM_LEFT, PictureOrigin::BOTTOM, PictureOrigin::BOTTOM_RIGHT
   526	        sprite.oy = (sprite.bitmap && !sprite.bitmap.disposed?) ? sprite.src_rect.height : 0
   527	      end
   528	    when Processes::SRC
   529	      next unless iconSprite && sprite.src_rect
   530	      sprite.src_rect.x = picture.src_rect.x
   531	      sprite.src_rect.y = picture.src_rect.y
   532	    when Processes::SRC_SIZE
   533	      next unless iconSprite && sprite.src_rect
   534	      sprite.src_rect.width  = picture.src_rect.width
   535	      sprite.src_rect.height = picture.src_rect.height
   536	    end
   537	  end
   538	  if iconSprite && sprite.src_rect && picture.cropBottom >= 0
   539	    spriteBottom = sprite.y - sprite.oy + sprite.src_rect.height
   540	    if spriteBottom > picture.cropBottom
   541	      sprite.src_rect.height = [picture.cropBottom - sprite.y + sprite.oy, 0].max
   542	    end
   543	  end
   544	end
   545	
   546	def setPictureIconSprite(sprite, picture)
   547	  setPictureSprite(sprite, picture, true)
   548	end
