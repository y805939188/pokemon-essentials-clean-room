   280	  def moveTone(delay, duration, tone, cb = nil)
   281	    delay, duration = ensureDelayAndDuration(delay, duration)
   282	    target = (tone) ? tone.clone : Tone.new(0, 0, 0, 0)
   283	    @processes.push([Processes::TONE, delay, duration, false, cb, @tone.clone, target])
   284	  end
   285	
   286	  def setTone(delay, tone, cb = nil)
   287	    moveTone(delay, 0, tone, cb)
   288	  end
   289	
   290	  def moveColor(delay, duration, color, cb = nil)
   291	    delay, duration = ensureDelayAndDuration(delay, duration)
   292	    target = (color) ? color.clone : Color.new(0, 0, 0, 0)
   293	    @processes.push([Processes::COLOR, delay, duration, false, cb, @color.clone, target])
   294	  end
   295	
   296	  def setColor(delay, color, cb = nil)
   297	    moveColor(delay, 0, color, cb)
   298	  end
