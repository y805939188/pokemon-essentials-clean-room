    18	#===============================================================================
    19	#
    20	#===============================================================================
    21	class Processes
    22	  XY          = 0
    23	  DELTA_XY    = 1
    24	  Z           = 2
    25	  CURVE       = 3
    26	  ZOOM        = 4
    27	  ANGLE       = 5
    28	  TONE        = 6
    29	  COLOR       = 7
    30	  HUE         = 8
    31	  OPACITY     = 9
    32	  VISIBLE     = 10
    33	  BLEND_TYPE  = 11
    34	  SE          = 12
    35	  NAME        = 13
    36	  ORIGIN      = 14
    37	  SRC         = 15
    38	  SRC_SIZE    = 16
    39	  CROP_BOTTOM = 17
    40	end
    41	
    42	#===============================================================================
    43	#
    44	#===============================================================================
    45	def getCubicPoint2(src, t)
    46	  x0  = src[0]
    47	  y0  = src[1]
    48	  cx0 = src[2]
    49	  cy0 = src[3]
    50	  cx1 = src[4]
    51	  cy1 = src[5]
    52	  x1  = src[6]
    53	  y1  = src[7]
    54	
    55	  x1 = cx1 + ((x1 - cx1) * t)
    56	  x0 += ((cx0 - x0) * t)
    57	  cx0 += ((cx1 - cx0) * t)
    58	  cx1 = cx0 + ((x1 - cx0) * t)
    59	  cx0 = x0 + ((cx0 - x0) * t)
    60	  cx = cx0 + ((cx1 - cx0) * t)
    61	  # a = x1 - 3 * cx1 + 3 * cx0 - x0
    62	  # b = 3 * (cx1 - 2 * cx0 + x0)
    63	  # c = 3 * (cx0 - x0)
    64	  # d = x0
    65	  # cx = a*t*t*t + b*t*t + c*t + d
    66	  y1 = cy1 + ((y1 - cy1) * t)
    67	  y0 += ((cy0 - y0) * t)
    68	  cy0 += ((cy1 - cy0) * t)
    69	  cy1 = cy0 + ((y1 - cy0) * t)
    70	  cy0 = y0 + ((cy0 - y0) * t)
    71	  cy = cy0 + ((cy1 - cy0) * t)
    72	  # a = y1 - 3 * cy1 + 3 * cy0 - y0
    73	  # b = 3 * (cy1 - 2 * cy0 + y0)
    74	  # c = 3 * (cy0 - y0)
    75	  # d = y0
    76	  # cy = a*t*t*t + b*t*t + c*t + d
    77	  return [cx, cy]
    78	end
