   634	#===============================================================================
   635	# Partner trainer
   636	#===============================================================================
   637	def pbRegisterPartner(tr_type, tr_name, tr_id = 0)
   638	  tr_type = GameData::TrainerType.get(tr_type).id
   639	  pbCancelVehicles
   640	  trainer = pbLoadTrainer(tr_type, tr_name, tr_id)
   641	  EventHandlers.trigger(:on_trainer_load, trainer)
   642	  trainer.party.each do |i|
   643	    i.owner = Pokemon::Owner.new_from_trainer(trainer)
   644	    i.calc_stats
   645	  end
   646	  $PokemonGlobal.partner = [tr_type, tr_name, trainer.id, trainer.party]
   647	end
   648	
   649	def pbDeregisterPartner
   650	  $PokemonGlobal.partner = nil
   651	end
   652	
   653	#===============================================================================
   654	# Picking up an item found on the ground
   655	#===============================================================================
   656	def pbItemBall(item, quantity = 1)
   657	  item = GameData::Item.get(item)
   658	  return false if !item || quantity < 1
   659	  itemname = (quantity > 1) ? item.portion_name_plural : item.portion_name
   660	  pocket = item.pocket
   661	  move = item.move
   662	  if $bag.add(item, quantity)   # If item can be picked up
   663	    meName = (item.is_key_item?) ? "Key item get" : "Item get"
   664	    if item == :DNASPLICERS
   665	      pbMessage("\\me[#{meName}]" + _INTL("You found \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   666	    elsif item.is_machine?   # TM or HM
   667	      if quantity > 1
   668	        pbMessage("\\me[Machine get]" + _INTL("You found {1} \\c[1]{2} {3}\\c[0]!",
   669	                                              quantity, itemname, GameData::Move.get(move).name) + "\\wtnp[70]")
   670	      else
   671	        pbMessage("\\me[Machine get]" + _INTL("You found \\c[1]{1} {2}\\c[0]!",
   672	                                              itemname, GameData::Move.get(move).name) + "\\wtnp[70]")
   673	      end
   674	    elsif quantity > 1
   675	      pbMessage("\\me[#{meName}]" + _INTL("You found {1} \\c[1]{2}\\c[0]!", quantity, itemname) + "\\wtnp[40]")
   676	    elsif itemname.starts_with_vowel?
   677	      pbMessage("\\me[#{meName}]" + _INTL("You found an \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   678	    else
   679	      pbMessage("\\me[#{meName}]" + _INTL("You found a \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   680	    end
   681	    pbMessage(_INTL("You put the {1} in\\nyour Bag's <icon=bagPocket{2}>\\c[1]{3}\\c[0] pocket.",
   682	                    itemname, pocket, PokemonBag.pocket_names[pocket - 1]))
   683	    return true
   684	  end
   685	  # Can't add the item
   686	  if item.is_machine?   # TM or HM
   687	    if quantity > 1
   688	      pbMessage(_INTL("You found {1} \\c[1]{2} {3}\\c[0]!", quantity, itemname, GameData::Move.get(move).name))
   689	    else
   690	      pbMessage(_INTL("You found \\c[1]{1} {2}\\c[0]!", itemname, GameData::Move.get(move).name))
   691	    end
   692	  elsif quantity > 1
   693	    pbMessage(_INTL("You found {1} \\c[1]{2}\\c[0]!", quantity, itemname))
   694	  elsif itemname.starts_with_vowel?
   695	    pbMessage(_INTL("You found an \\c[1]{1}\\c[0]!", itemname))
   696	  else
   697	    pbMessage(_INTL("You found a \\c[1]{1}\\c[0]!", itemname))
   698	  end
   699	  pbMessage(_INTL("But your Bag is full..."))
   700	  return false
   701	end
   702	
   703	#===============================================================================
   704	# Being given an item
   705	#===============================================================================
   706	def pbReceiveItem(item, quantity = 1)
   707	  item = GameData::Item.get(item)
   708	  return false if !item || quantity < 1
   709	  itemname = (quantity > 1) ? item.portion_name_plural : item.portion_name
   710	  pocket = item.pocket
   711	  move = item.move
   712	  meName = (item.is_key_item?) ? "Key item get" : "Item get"
   713	  if item == :DNASPLICERS
   714	    pbMessage("\\me[#{meName}]" + _INTL("You obtained \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   715	  elsif item.is_machine?   # TM or HM
   716	    if quantity > 1
   717	      pbMessage("\\me[Machine get]" + _INTL("You obtained {1} \\c[1]{2} {3}\\c[0]!",
   718	                                            quantity, itemname, GameData::Move.get(move).name) + "\\wtnp[70]")
   719	    else
   720	      pbMessage("\\me[Machine get]" + _INTL("You obtained \\c[1]{1} {2}\\c[0]!",
   721	                                            itemname, GameData::Move.get(move).name) + "\\wtnp[70]")
   722	    end
   723	  elsif quantity > 1
   724	    pbMessage("\\me[#{meName}]" + _INTL("You obtained {1} \\c[1]{2}\\c[0]!", quantity, itemname) + "\\wtnp[40]")
   725	  elsif itemname.starts_with_vowel?
   726	    pbMessage("\\me[#{meName}]" + _INTL("You obtained an \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   727	  else
   728	    pbMessage("\\me[#{meName}]" + _INTL("You obtained a \\c[1]{1}\\c[0]!", itemname) + "\\wtnp[40]")
   729	  end
   730	  if $bag.add(item, quantity)   # If item can be added
   731	    pbMessage(_INTL("You put the {1} in\\nyour Bag's <icon=bagPocket{2}>\\c[1]{3}\\c[0] pocket.",
   732	                    itemname, pocket, PokemonBag.pocket_names[pocket - 1]))
   733	    return true
   734	  end
   735	  return false   # Can't add the item
   736	end
   737	
   738	#===============================================================================
   739	# Buying a prize item from the Game Corner
   740	#===============================================================================
   741	def pbBuyPrize(item, quantity = 1)
   742	  item = GameData::Item.get(item)
   743	  return false if !item || quantity < 1
   744	  item_name = (quantity > 1) ? item.portion_name_plural : item.portion_name
   745	  pocket = item.pocket
   746	  return false if !$bag.add(item, quantity)
   747	  pbMessage("\\CN" + _INTL("You put the {1} in\\nyour Bag's <icon=bagPocket{2}>\\c[1]{3}\\c[0] pocket.",
   748	                           item_name, pocket, PokemonBag.pocket_names[pocket - 1]))
   749	  return true
   750	end
