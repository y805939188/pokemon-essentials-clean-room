   437	#===============================================================================
   438	# Event movement
   439	#===============================================================================
   440	module PBMoveRoute
   441	  DOWN                  = 1
   442	  LEFT                  = 2
   443	  RIGHT                 = 3
   444	  UP                    = 4
   445	  LOWER_LEFT            = 5
   446	  LOWER_RIGHT           = 6
   447	  UPPER_LEFT            = 7
   448	  UPPER_RIGHT           = 8
   449	  RANDOM                = 9
   450	  TOWARD_PLAYER         = 10
   451	  AWAY_FROM_PLAYER      = 11
   452	  FORWARD               = 12
   453	  BACKWARD              = 13
   454	  JUMP                  = 14   # xoffset, yoffset
   455	  WAIT                  = 15   # frames
   456	  TURN_DOWN             = 16
   457	  TURN_LEFT             = 17
   458	  TURN_RIGHT            = 18
   459	  TURN_UP               = 19
   460	  TURN_RIGHT90          = 20
   461	  TURN_LEFT90           = 21
   462	  TURN180               = 22
   463	  TURN_RIGHT_OR_LEFT90  = 23
   464	  TURN_RANDOM           = 24
   465	  TURN_TOWARD_PLAYER    = 25
   466	  TURN_AWAY_FROM_PLAYER = 26
   467	  SWITCH_ON             = 27   # 1 param
   468	  SWITCH_OFF            = 28   # 1 param
   469	  CHANGE_SPEED          = 29   # 1 param
   470	  CHANGE_FREQUENCY      = 30   # 1 param
   471	  WALK_ANIME_ON         = 31
   472	  WALK_ANIME_OFF        = 32
   473	  STEP_ANIME_ON         = 33
   474	  STEP_ANIME_OFF        = 34
   475	  DIRECTION_FIX_ON      = 35
   476	  DIRECTION_FIX_OFF     = 36
   477	  THROUGH_ON            = 37
   478	  THROUGH_OFF           = 38
   479	  ALWAYS_ON_TOP_ON      = 39
   480	  ALWAYS_ON_TOP_OFF     = 40
   481	  GRAPHIC               = 41   # Name, hue, direction, pattern
   482	  OPACITY               = 42   # 1 param
   483	  BLENDING              = 43   # 1 param
   484	  PLAY_SE               = 44   # 1 param
   485	  SCRIPT                = 45   # 1 param
   486	  SCRIPT_ASYNC          = 101   # 1 param
   487	end
   488	
   489	def pbMoveRoute(event, commands, waitComplete = false)
   490	  route = RPG::MoveRoute.new
   491	  route.repeat    = false
   492	  route.skippable = true
   493	  route.list.clear
   494	  route.list.push(RPG::MoveCommand.new(PBMoveRoute::THROUGH_ON))
   495	  i = 0
   496	  while i < commands.length
   497	    case commands[i]
   498	    when PBMoveRoute::WAIT, PBMoveRoute::SWITCH_ON, PBMoveRoute::SWITCH_OFF,
   499	       PBMoveRoute::CHANGE_SPEED, PBMoveRoute::CHANGE_FREQUENCY, PBMoveRoute::OPACITY,
   500	       PBMoveRoute::BLENDING, PBMoveRoute::PLAY_SE, PBMoveRoute::SCRIPT
   501	      route.list.push(RPG::MoveCommand.new(commands[i], [commands[i + 1]]))
   502	      i += 1
   503	    when PBMoveRoute::SCRIPT_ASYNC
   504	      route.list.push(RPG::MoveCommand.new(PBMoveRoute::SCRIPT, [commands[i + 1]]))
   505	      route.list.push(RPG::MoveCommand.new(PBMoveRoute::WAIT, [0]))
   506	      i += 1
   507	    when PBMoveRoute::JUMP
   508	      route.list.push(RPG::MoveCommand.new(commands[i], [commands[i + 1], commands[i + 2]]))
   509	      i += 2
   510	    when PBMoveRoute::GRAPHIC
   511	      route.list.push(RPG::MoveCommand.new(commands[i],
   512	                                           [commands[i + 1], commands[i + 2],
   513	                                            commands[i + 3], commands[i + 4]]))
   514	      i += 4
   515	    else
   516	      route.list.push(RPG::MoveCommand.new(commands[i]))
   517	    end
   518	    i += 1
   519	  end
   520	  route.list.push(RPG::MoveCommand.new(PBMoveRoute::THROUGH_OFF))
   521	  route.list.push(RPG::MoveCommand.new(0))
   522	  event&.force_move_route(route)
   523	  return route
   524	end
   525	
   526	# duration is in seconds
   527	def pbWait(duration)
   528	  timer_start = System.uptime
   529	  until System.uptime - timer_start >= duration
   530	    yield System.uptime - timer_start if block_given?
   531	    Graphics.update
   532	    Input.update
   533	    pbUpdateSceneMap
   534	  end
   535	end
   536	
   537	#===============================================================================
   538	# Player/event movement in the field
   539	#===============================================================================
   540	def pbSlideOnIce
   541	  if !$DEBUG || !Input.press?(Input::CTRL)
   542	    if $game_player.pbTerrainTag.ice && $game_player.can_move_in_direction?($game_player.direction)
   543	      $PokemonGlobal.ice_sliding = true
   544	      $game_player.straighten
   545	      $game_player.walk_anime = false
   546	      return
   547	    end
   548	  end
   549	  $PokemonGlobal.ice_sliding = false
   550	  $game_player.walk_anime = true
   551	end
   552	
   553	def pbTurnTowardEvent(event, otherEvent)
   554	  sx = 0
   555	  sy = 0
   556	  if $map_factory
   557	    relativePos = $map_factory.getThisAndOtherEventRelativePos(otherEvent, event)
   558	    sx = relativePos[0]
   559	    sy = relativePos[1]
   560	  else
   561	    sx = event.x - otherEvent.x
   562	    sy = event.y - otherEvent.y
   563	  end
   564	  sx += (event.width - otherEvent.width) / 2.0
   565	  sy -= (event.height - otherEvent.height) / 2.0
   566	  return if sx == 0 && sy == 0
   567	  if sx.abs > sy.abs
   568	    (sx > 0) ? event.turn_left : event.turn_right
   569	  else
   570	    (sy > 0) ? event.turn_up : event.turn_down
   571	  end
   572	end
   573	
   574	def pbMoveTowardPlayer(event)
   575	  maxsize = [$game_map.width, $game_map.height].max
   576	  return if !pbEventCanReachPlayer?(event, $game_player, maxsize)
   577	  loop do
   578	    x = event.x
   579	    y = event.y
   580	    event.move_toward_player
   581	    break if event.x == x && event.y == y
   582	    while event.moving?
   583	      Graphics.update
   584	      Input.update
   585	      pbUpdateSceneMap
   586	    end
   587	  end
   588	  $PokemonMap&.addMovedEvent(event.id)
   589	end
