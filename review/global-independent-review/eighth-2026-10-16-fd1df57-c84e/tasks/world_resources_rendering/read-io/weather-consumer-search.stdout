   591	#===============================================================================
   592	# Bridges, cave escape points, and setting the heal point
   593	#===============================================================================
   594	def pbBridgeOn(height = 2)
   595	  $PokemonGlobal.bridge = height
   596	end
   597	
   598	def pbBridgeOff
   599	  $PokemonGlobal.bridge = 0
   600	end
   601	
   602	def pbSetEscapePoint
   603	  $PokemonGlobal.escapePoint = [] if !$PokemonGlobal.escapePoint
   604	  xco = $game_player.x
   605	  yco = $game_player.y
   606	  case $game_player.direction
   607	  when 2   # Down
   608	    yco -= 1
   609	    dir = 8
   610	  when 4   # Left
   611	    xco += 1
   612	    dir = 6
   613	  when 6   # Right
   614	    xco -= 1
   615	    dir = 4
   616	  when 8   # Up
   617	    yco += 1
   618	    dir = 2
   619	  end
   620	  $PokemonGlobal.escapePoint = [$game_map.map_id, xco, yco, dir]
   621	end
   622	
   623	def pbEraseEscapePoint
   624	  $PokemonGlobal.escapePoint = []
   625	end
   626	
   627	def pbSetPokemonCenter
   628	  $PokemonGlobal.pokecenterMapId     = $game_map.map_id
   629	  $PokemonGlobal.pokecenterX         = $game_player.x
   630	  $PokemonGlobal.pokecenterY         = $game_player.y
   631	  $PokemonGlobal.pokecenterDirection = $game_player.direction
   632	end
