   381	#===============================================================================
   382	# Options Menu commands
   383	#===============================================================================
   384	MenuHandlers.add(:options_menu, :bgm_volume, {
   385	  "name"        => _INTL("Music Volume"),
   386	  "order"       => 10,
   387	  "type"        => SliderOption,
   388	  "parameters"  => [0, 100, 5],   # [minimum_value, maximum_value, interval]
   389	  "description" => _INTL("Adjust the volume of the background music."),
   390	  "get_proc"    => proc { next $PokemonSystem.bgmvolume },
   391	  "set_proc"    => proc { |value, scene|
   392	    next if $PokemonSystem.bgmvolume == value
   393	    $PokemonSystem.bgmvolume = value
   394	    next if scene.in_load_screen || $game_system.playing_bgm.nil?
   395	    playingBGM = $game_system.getPlayingBGM
   396	    $game_system.bgm_pause
   397	    $game_system.bgm_resume(playingBGM)
   398	  }
   399	})
   400	
   401	MenuHandlers.add(:options_menu, :se_volume, {
   402	  "name"        => _INTL("SE Volume"),
   403	  "order"       => 20,
   404	  "type"        => SliderOption,
   405	  "parameters"  => [0, 100, 5],   # [minimum_value, maximum_value, interval]
   406	  "description" => _INTL("Adjust the volume of sound effects."),
   407	  "get_proc"    => proc { next $PokemonSystem.sevolume },
   408	  "set_proc"    => proc { |value, _scene|
   409	    next if $PokemonSystem.sevolume == value
   410	    $PokemonSystem.sevolume = value
   411	    if $game_system.playing_bgs
   412	      $game_system.playing_bgs.volume = value
   413	      playingBGS = $game_system.getPlayingBGS
   414	      $game_system.bgs_pause
   415	      $game_system.bgs_resume(playingBGS)
   416	    end
   417	    pbPlayCursorSE
   418	  }
   419	})
   420	
   421	MenuHandlers.add(:options_menu, :text_speed, {
   422	  "name"        => _INTL("Text Speed"),
   423	  "order"       => 30,
   424	  "type"        => EnumOption,
   425	  "parameters"  => [_INTL("Slow"), _INTL("Mid"), _INTL("Fast"), _INTL("Inst")],
   426	  "description" => _INTL("Choose the speed at which text appears."),
   427	  "on_select"   => proc { |scene| scene.sprites["textbox"].letterbyletter = true },
   428	  "get_proc"    => proc { next $PokemonSystem.textspeed },
   429	  "set_proc"    => proc { |value, scene|
   430	    next if value == $PokemonSystem.textspeed
   431	    $PokemonSystem.textspeed = value
   432	    MessageConfig.pbSetTextSpeed(MessageConfig.pbSettingToTextSpeed(value))
