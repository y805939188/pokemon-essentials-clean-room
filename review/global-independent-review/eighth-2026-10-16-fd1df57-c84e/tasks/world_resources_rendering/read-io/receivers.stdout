    36	#===============================================================================
    37	#
    38	#===============================================================================
    39	module PropertyMixin
    40	  attr_reader :name
    41	
    42	  def get
    43	    return @get_proc&.call
    44	  end
    45	
    46	  def set(*args)
    47	    @set_proc&.call(*args)
    48	  end
