     4	class PokemonSystem
     5	  attr_accessor :textspeed
     6	  attr_accessor :battlescene
     7	  attr_accessor :battlestyle
     8	  attr_accessor :sendtoboxes
     9	  attr_accessor :givenicknames
    10	  attr_accessor :frame
    11	  attr_accessor :textskin
    12	  attr_accessor :screensize
    13	  attr_accessor :language
    14	  attr_accessor :runstyle
    15	  attr_accessor :bgmvolume
    16	  attr_accessor :sevolume
    17	  attr_accessor :textinput
    18	
    19	  def initialize
    20	    @textspeed     = 1     # Text speed (0=slow, 1=medium, 2=fast, 3=instant)
    21	    @battlescene   = 0     # Battle effects (animations) (0=on, 1=off)
    22	    @battlestyle   = 0     # Battle style (0=switch, 1=set)
    23	    @sendtoboxes   = 0     # Send to Boxes (0=manual, 1=automatic)
    24	    @givenicknames = 0     # Give nicknames (0=give, 1=don't give)
    25	    @frame         = 0     # Default window frame (see also Settings::MENU_WINDOWSKINS)
    26	    @textskin      = 0     # Speech frame
    27	    @screensize    = (Settings::SCREEN_SCALE * 2).floor - 1   # 0=half size, 1=full size, 2=full-and-a-half size, 3=double size
    28	    @language      = 0     # Language (see also Settings::LANGUAGES in script PokemonSystem)
    29	    @runstyle      = 0     # Default movement speed (0=walk, 1=run)
    30	    @bgmvolume     = 80    # Volume of background music and ME
    31	    @sevolume      = 100   # Volume of sound effects
    32	    @textinput     = 0     # Text input mode (0=cursor, 1=keyboard)
    33	  end
    34	end
