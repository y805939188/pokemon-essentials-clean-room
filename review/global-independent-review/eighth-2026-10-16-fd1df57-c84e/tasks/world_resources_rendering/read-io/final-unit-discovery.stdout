   311	  def pbStartSellScene2(bag, adapter)
   312	    @subscene = PokemonBag_Scene.new
   313	    @adapter = adapter
   314	    @viewport2 = Viewport.new(0, 0, Graphics.width, Graphics.height)
   315	    @viewport2.z = 99999
   316	    pbWait(0.4) do |delta_t|
   317	      @viewport2.color.alpha = lerp(0, 255, 0.4, delta_t)
   318	    end
   319	    @viewport2.color.alpha = 255
   320	    @subscene.pbStartScene(bag)
   321	    @viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
   322	    @viewport.z = 99999
   323	    @sprites = {}
   324	    @sprites["helpwindow"] = Window_AdvancedTextPokemon.new("")
   325	    pbPrepareWindow(@sprites["helpwindow"])
   326	    @sprites["helpwindow"].visible = false
   327	    @sprites["helpwindow"].viewport = @viewport
   328	    pbBottomLeftLines(@sprites["helpwindow"], 1)
   329	    @sprites["moneywindow"] = Window_AdvancedTextPokemon.new("")
   330	    pbPrepareWindow(@sprites["moneywindow"])
   331	    @sprites["moneywindow"].setSkin("Graphics/Windowskins/goldskin")
   332	    @sprites["moneywindow"].visible = false
   333	    @sprites["moneywindow"].viewport = @viewport
   334	    @sprites["moneywindow"].x = 0
   335	    @sprites["moneywindow"].y = 0
   336	    @sprites["moneywindow"].width = 186
   337	    @sprites["moneywindow"].height = 96
   338	    @sprites["moneywindow"].baseColor = Color.new(88, 88, 80)
   339	    @sprites["moneywindow"].shadowColor = Color.new(168, 184, 184)
   340	    pbDeactivateWindows(@sprites)
   341	    @buying = false
   342	    pbRefresh
   343	  end
