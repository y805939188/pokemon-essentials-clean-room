   352	  def pbEndSellScene
   353	    @subscene&.pbEndScene
   354	    pbDisposeSpriteHash(@sprites)
   355	    if @viewport2
   356	      pbWait(0.4) do |delta_t|
   357	        @viewport2.color.alpha = lerp(255, 0, 0.4, delta_t)
   358	      end
   359	      @viewport2.dispose
   360	    end
   361	    @viewport.dispose
   362	    pbScrollMap(4, 5, 5) if !@subscene
   363	  end
