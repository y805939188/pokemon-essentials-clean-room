    60	# class Numeric
    61	#===============================================================================
    62	class Numeric
    63	  # Turns a number into a string formatted like 12,345,678.
    64	  def to_s_formatted
    65	    return self.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\1,').reverse
    66	  end
    67	
    68	  def to_word
    69	    ret = [_INTL("zero"), _INTL("one"), _INTL("two"), _INTL("three"),
    70	           _INTL("four"), _INTL("five"), _INTL("six"), _INTL("seven"),
    71	           _INTL("eight"), _INTL("nine"), _INTL("ten"), _INTL("eleven"),
    72	           _INTL("twelve"), _INTL("thirteen"), _INTL("fourteen"), _INTL("fifteen"),
    73	           _INTL("sixteen"), _INTL("seventeen"), _INTL("eighteen"), _INTL("nineteen"),
    74	           _INTL("twenty")]
    75	    return ret[self] if self.is_a?(Integer) && self >= 0 && self <= ret.length
    76	    return self.to_s
    77	  end
    78	end
