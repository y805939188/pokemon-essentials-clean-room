   226	  def pbRefresh
   227	    if @subscene
   228	      @subscene.pbRefresh
   229	    else
   230	      itemwindow = @sprites["itemwindow"]
   231	      @sprites["icon"].item = itemwindow.item
   232	      @sprites["itemtextwindow"].text =
   233	        (itemwindow.item) ? @adapter.getDescription(itemwindow.item) : _INTL("Quit shopping.")
   234	      @sprites["qtywindow"].visible = !itemwindow.item.nil?
   235	      @sprites["qtywindow"].text    = _INTL("In Bag:<r>{1}", @adapter.getQuantity(itemwindow.item))
   236	      @sprites["qtywindow"].y       = Graphics.height - 102 - @sprites["qtywindow"].height
   237	      itemwindow.refresh
   238	    end
   239	    @sprites["moneywindow"].text = _INTL("Money:\n<r>{1}", @adapter.getMoneyString)
   240	  end
