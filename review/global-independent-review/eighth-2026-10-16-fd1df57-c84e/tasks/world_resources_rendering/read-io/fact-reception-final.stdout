  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-036-01",
      "fact": "运动flag初始false，startTime直接宿主时间，stepcount0，phone/寄养构建；事件私有值空表、桥/repel0、逃脱点空、治疗点nil。"
    },
    {
      "id": "WFS-036-02",
      "fact": "flashUsed访问器与初始化flashused大小写不同，初始读nil；不能把实现写错理想化成精确false。"
    },
    {
      "id": "WFS-036-03",
      "fact": "遭遇版本写入验证整数，同值早退，否则写后有遭遇和地图才重新setup。"
    },
    {
      "id": "WFS-036-04",
      "fact": "forced_movement仅冰滑/下瀑/上瀑三flag，不含路线forcing或fishing。"
    }
  ],
