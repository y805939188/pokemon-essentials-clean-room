{
  "unit_id": "WFS-073",
  "path": "Data/Scripts/012_Overworld/002_Battle triggering/001_Overworld_BattleStarting.rb",
  "reference_index": 45,
  "range": [
    401,
    607
  ],
  "title": "野生/训练家战斗调用与返回",
  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-073-01",
      "fact": "野生core按对方数量1选动画kind0，否则kind2；训练家core按battle.singleBattle?选kind1或3；都在pbBattleAnimation内以pbSceneStandby调用battle.pbStartBattle和after_battle。"
    },
    {
      "id": "WFS-073-02",
      "fact": "野生外层可被override处理并原样返回；普通core结果2或5映false，其它映true，不能将true一概叫胜利。"
    },
    {
      "id": "WFS-073-03",
      "fact": "训练家外层仅outcome1为true；双训练家等待状态与赢后selfswitch写入有独立前门和正常尾部，不能把初次等待当战斗已执行。"
    },
    {
      "id": "WFS-073-04",
      "fact": "战前/战中/战后异常会保留已发生的写入，未声明通用重试、回滚或所有临时门必清。"
    }
  ],
  "consumers": [
    "WP16三路caller",
    "World battle wrappers",
    "UI/Creature"
  ],
  "evidence": "SOURCE_STATIC",
  "execution": "NOT_EXECUTED",
  "mapping_status": "EXPLICIT_ASSERTIONS_ONLY;NO_AUTOMATIC_GLOBAL_COMPLETENESS"
}
