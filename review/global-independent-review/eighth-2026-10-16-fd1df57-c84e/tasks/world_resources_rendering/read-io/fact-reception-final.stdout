{
  "unit_id": "WFS-037",
  "path": "Data/Scripts/012_Overworld/002_Overworld_Metadata.rb",
  "reference_index": 47,
  "range": [
    126,
    183
  ],
  "title": "当前图记录与恢复",
  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-037-01",
      "fact": "clear重建消去/移动记录并清力量/遭遇率/等级flag。"
    },
    {
      "id": "WFS-037-02",
      "fact": "消去按当前图及任意输入ID登记；移动只整数ID且当前图事件存在才记四字段快照。"
    },
    {
      "id": "WFS-037-03",
      "fact": "恢复消去只匹配图且真值/现事件才erase；移动落位/转向在同图且记录/事件存在时执行。"
    },
    {
      "id": "WFS-037-04",
      "fact": "through真恢复写位于同图/存在门之外，假值不清；其它图真记录或缺事件可能触发不同当前同ID对象或失败。"
    },
    {
      "id": "WFS-037-05",
      "fact": "不是统一幂等、安全全恢复；WP11/WP13具体当前条款待完整反向接收。"
    }
  ],
  "consumers": [
    "WP11恢复",
    "WP13地图事件",
    "kernel persistence"
  ],
  "evidence": "SOURCE_STATIC",
  "execution": "NOT_EXECUTED",
  "mapping_status": "PARTIAL_UNTIL_ALL_FORMAL_AND_INTERFACES_RECEIVED"
}
{
  "unit_id": "WFS-070",
  "path": "Data/Scripts/012_Overworld/002_Battle triggering/001_Overworld_BattleStarting.rb",
  "reference_index": 45,
  "range": [
    1,
    208
  ],
  "title": "战斗规则与前置参数",
  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-070-01",
      "fact": "规则存于临时battle_rules；规范化名称后支持人数、canlose/canrun、experience/money、switchstyle、animations、partner、environment、weather、terrain、backdrop、base、outcome变量等，未知规则抛错误。"
    },
    {
      "id": "WFS-070-02",
      "fact": "规则可请求的双/三人格式经可用精灵数修正；无合法参战对象前门不能等同实际战斗成功。"
    },
    {
      "id": "WFS-070-03",
      "fact": "队伍初始化与partner合并共用实际party对象，不能把数组合并理解为克隆精灵；后续恢复/演化会消费这些对象。"
    }
  ],
  "consumers": [
    "WP16战前参数",
    "Creature battle ingress"
  ],
  "evidence": "SOURCE_STATIC",
  "execution": "NOT_EXECUTED",
  "mapping_status": "EXPLICIT_ASSERTIONS_ONLY;NO_AUTOMATIC_GLOBAL_COMPLETENESS"
}
{
  "unit_id": "WFS-071",
  "path": "Data/Scripts/012_Overworld/002_Battle triggering/001_Overworld_BattleStarting.rb",
  "reference_index": 45,
  "range": [
    209,
    304
  ],
  "title": "战斗参数准备与世界消费",
  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-071-01",
      "fact": "显式defaultTerrain优先；否则仅在配置允许时由世界Storm映射Electric、Fog映射Misty；未匹配保留None。"
    },
    {
      "id": "WFS-071-02",
      "fact": "显式defaultWeather优先；否则按世界category将Rain和Storm映射Rain、Hail映射Hail、Sandstorm和Sun同名映射，未匹配None。"
    },
    {
      "id": "WFS-071-03",
      "fact": "世界天气定义与BattleWeather是不同登记域，映射类别不是直接复制全部世界ID。"
    },
    {
      "id": "WFS-071-04",
      "fact": "洞穴时段先由当前MapMetadata.battle_environment==Cave决定；否则TIME_SHADING允许时按night/evening/其它写2/1/0，没有Outdoor门，显式battle环境覆盖不改此洞穴判定。"
    },
    {
      "id": "WFS-071-05",
      "fact": "环境、backdrop、base等按各自显式规则和世界推导分支选择；准备写对象按顺序发生，异常无总回滚。"
    }
  ],
  "consumers": [
    "WP16战前世界参数",
    "WP59天气/时间",
    "resources weather receipt"
  ],
  "evidence": "SOURCE_STATIC",
  "execution": "NOT_EXECUTED",
  "mapping_status": "EXPLICIT_ASSERTIONS_ONLY;NO_AUTOMATIC_GLOBAL_COMPLETENESS"
}
{
  "unit_id": "WFS-072",
  "path": "Data/Scripts/012_Overworld/002_Battle triggering/001_Overworld_BattleStarting.rb",
  "reference_index": 45,
  "range": [
    306,
    749
  ],
  "title": "战前结束及物品被动",
  "reviewer": "/root/world_full",
  "assertions": [
    {
      "id": "WFS-072-01",
      "fact": "战斗后会清毒步计数并还原Mega/Primal；partner参战的恢复与玩家canlose恢复按实际分支，不等同所有败北都治愈。"
    },
    {
      "id": "WFS-072-02",
      "fact": "结束事件中先做可进化成员处理再清队伍临时数组；Pickup和HoneyGather仅outcome1或4进入，outcome2或5且非canlose进入黑屏恢复流程。"
    },
    {
      "id": "WFS-072-03",
      "fact": "Pickup有18项common和11项rare及30、10等配置权重，先过滤实际登记项再裁剪长度；须能力、无持物、10%门及等级分段，不能把未登记项当可抽取。"
    },
    {
      "id": "WFS-072-04",
      "fact": "HoneyGather须能力且无持物，按5+floor((level−1)/10)*5百分比门赋Honey；过程依赖登记和正常执行。"
    }
  ],
  "consumers": [
    "Creature passive/item",
    "kernel blackout",
    "WP16 aftermath"
  ],
  "evidence": "SOURCE_STATIC",
  "execution": "NOT_EXECUTED",
  "mapping_status": "EXPLICIT_ASSERTIONS_ONLY;NO_AUTOMATIC_GLOBAL_COMPLETENESS",
