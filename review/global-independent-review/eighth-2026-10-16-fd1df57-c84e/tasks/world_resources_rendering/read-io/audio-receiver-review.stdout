     1	#===============================================================================
     2	# ** Game_Screen
     3	#-------------------------------------------------------------------------------
     4	#  This class handles screen maintenance data, such as change in color tone,
     5	#  flashing, etc. Refer to "$game_screen" for the instance of this class.
     6	#===============================================================================
     7	class Game_Screen
     8	  attr_reader   :brightness         # brightness
     9	  attr_reader   :tone               # color tone
    10	  attr_reader   :flash_color        # flash color
    11	  attr_reader   :shake              # shake positioning
    12	  attr_reader   :pictures           # pictures
    13	  attr_reader   :weather_type       # weather type
    14	  attr_reader   :weather_max        # max number of weather sprites
    15	  attr_accessor :weather_duration   # ticks in which the weather should fade in
    16	
    17	  def initialize
    18	    @brightness        = 255
    19	    @tone              = Tone.new(0, 0, 0, 0)
    20	    @tone_target       = Tone.new(0, 0, 0, 0)
    21	    @tone_duration     = 0
    22	    @tone_timer_start  = nil
    23	    @flash_color       = Color.new(0, 0, 0, 0)
    24	    @flash_duration    = 0
    25	    @flash_timer_start = nil
    26	    @shake_power       = 0
    27	    @shake_speed       = 0
    28	    @shake_duration    = 0
    29	    @shake             = 0
    30	    @pictures          = [nil]
    31	    (1..100).each { |i| @pictures.push(Game_Picture.new(i)) }
    32	    @weather_type      = :None
    33	    @weather_max       = 0.0
    34	    @weather_duration  = 0
    35	  end
    36	
    37	  # duration is time in 1/20ths of a second.
    38	  def start_tone_change(tone, duration)
    39	    if duration == 0
    40	      @tone = tone.clone
    41	      return
    42	    end
    43	    @tone_initial     = @tone.clone
    44	    @tone_target      = tone.clone
    45	    @tone_duration    = duration / 20.0
    46	    @tone_timer_start = $stats.play_time
    47	  end
    48	
    49	  # duration is time in 1/20ths of a second.
    50	  def start_flash(color, duration)
    51	    @flash_color         = color.clone
    52	    @flash_initial_alpha = @flash_color.alpha
    53	    @flash_duration      = duration / 20.0
    54	    @flash_timer_start   = $stats.play_time
    55	  end
    56	
    57	  # duration is time in 1/20ths of a second.
    58	  def start_shake(power, speed, duration)
    59	    @shake_power       = power
    60	    @shake_speed       = speed
    61	    @shake_duration    = duration / 20.0
    62	    @shake_timer_start = $stats.play_time
    63	  end
    64	
    65	  # duration is time in 1/20ths of a second.
    66	  def weather(type, power, duration)
    67	    @weather_type     = GameData::Weather.get(type).id
    68	    @weather_max      = (power + 1) * RPG::Weather::MAX_SPRITES / 10
    69	    @weather_duration = duration
    70	  end
    71	
    72	  def update
    73	    now = $stats.play_time
    74	    if @tone_timer_start
    75	      @tone.red = lerp(@tone_initial.red, @tone_target.red, @tone_duration, @tone_timer_start, now)
    76	      @tone.green = lerp(@tone_initial.green, @tone_target.green, @tone_duration, @tone_timer_start, now)
    77	      @tone.blue = lerp(@tone_initial.blue, @tone_target.blue, @tone_duration, @tone_timer_start, now)
    78	      @tone.gray = lerp(@tone_initial.gray, @tone_target.gray, @tone_duration, @tone_timer_start, now)
    79	      if now - @tone_timer_start >= @tone_duration
    80	        @tone_initial = nil
    81	        @tone_timer_start = nil
    82	      end
    83	    end
    84	    if @flash_timer_start
    85	      @flash_color.alpha = lerp(@flash_initial_alpha, 0, @flash_duration, @flash_timer_start, now)
    86	      if now - @flash_timer_start >= @flash_duration
    87	        @flash_initial_alpha = nil
    88	        @flash_timer_start = nil
    89	      end
    90	    end
    91	    if @shake_timer_start
    92	      delta_t = now - @shake_timer_start
    93	      movement_per_second = @shake_power * @shake_speed * 4
    94	      limit = @shake_power * 2.5   # Maximum pixel displacement
    95	      phase = (delta_t * movement_per_second / limit).to_i % 4
    96	      case phase
    97	      when 0, 2
    98	        @shake = (movement_per_second * delta_t) % limit
    99	        @shake *= -1 if phase == 2
   100	      else
   101	        @shake = limit - ((movement_per_second * delta_t) % limit)
   102	        @shake *= -1 if phase == 3
   103	      end
   104	      if delta_t >= @shake_duration
   105	        @shake_phase = phase if !@shake_phase || phase == 1 || phase == 3
   106	        if phase != @shake_phase || @shake < 2
   107	          @shake_timer_start = nil
   108	          @shake = 0
   109	        end
   110	      end
   111	    end
   112	    if $game_temp.in_battle
   113	      (51..100).each { |i| @pictures[i].update }
   114	    else
   115	      (1..50).each { |i|  @pictures[i].update }
   116	    end
   117	  end
   118	end
   119	
   120	#===============================================================================
   121	#
   122	#===============================================================================
   123	def pbToneChangeAll(tone, duration)
   124	  $game_screen.start_tone_change(tone, duration)
   125	  $game_screen.pictures.each { |picture| picture&.start_tone_change(tone, duration) }
   126	end
   127	
   128	def pbFlash(color, frames)
   129	  $game_screen.start_flash(color, frames)
   130	end
   131	
   132	def pbShake(power, speed, frames)
   133	  $game_screen.start_shake(power, speed, frames)
   134	end
