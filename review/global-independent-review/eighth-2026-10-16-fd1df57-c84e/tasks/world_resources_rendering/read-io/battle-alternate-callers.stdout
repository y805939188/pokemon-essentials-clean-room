   130	#===============================================================================
   131	# Debug playback methods.
   132	#===============================================================================
   133	def pbDebugPlayBattle
   134	  params = ChooseNumberParams.new
   135	  params.setRange(0, 500)
   136	  params.setInitialValue(0)
   137	  params.setCancelValue(-1)
   138	  num = pbMessageChooseNumber(_INTL("Choose a battle."), params)
   139	  pbPlayBattleFromFile(sprintf("Battles/Battle%03d.dat", num)) if num >= 0
   140	end
   141	
   142	def pbPlayBattleFromFile(filename)
   143	  pbRgssOpen(filename, "rb") { |f| pbPlayBattle(f.read) }
   144	end
