   102	def pbRecordLastBattle
   103	  $PokemonGlobal.lastbattle = $game_temp.last_battle_record
   104	  $game_temp.last_battle_record = nil
   105	end
   106	
   107	def pbPlayLastBattle
   108	  pbPlayBattle($PokemonGlobal.lastbattle)
   109	end
