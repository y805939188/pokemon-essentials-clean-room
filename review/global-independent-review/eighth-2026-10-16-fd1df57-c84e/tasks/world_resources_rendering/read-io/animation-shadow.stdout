   121	#===============================================================================
   122	# ? CLASS Sprite_Character edit
   123	#===============================================================================
   124	class Sprite_Character < RPG::Sprite
   125	  alias shadow_initialize initialize unless private_method_defined?(:shadow_initialize)
   126	
   127	  def initialize(viewport, character = nil)
   128	    @ombrelist = []
   129	    @character = character
   130	    shadow_initialize(viewport, @character)
   131	  end
   132	
   133	  def setShadows(map, shadows)
   134	    if character.is_a?(Game_Event) && shadows.length > 0
   135	      params = XPML_read(map, "Shadow", @character, 4)
   136	      if params
   137	        shadows.each do |shadow|
   138	          @ombrelist.push(Sprite_Shadow.new(viewport, @character, shadows))
   139	        end
   140	      end
   141	    end
   142	    if character.is_a?(Game_Player) && shadows.length > 0
   143	      shadows.each do |shadow|
   144	        @ombrelist.push(Sprite_Shadow.new(viewport, $game_player, shadow))
   145	      end
   146	    end
   147	    update
   148	  end
   149	
   150	  def clearShadows
   151	    @ombrelist.each { |s| s&.dispose }
   152	    @ombrelist.clear
   153	  end
   154	
   155	  alias shadow_update update unless method_defined?(:shadow_update)
   156	
   157	  def update
   158	    shadow_update
   159	    @ombrelist.each { |ombre| ombre.update }
   160	  end
   161	end
