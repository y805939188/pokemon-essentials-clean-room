   164	# ? CLASS Game_Event edit
   165	#===============================================================================
   166	class Game_Event
   167	  attr_accessor :id
   168	end
   169	
   170	#===============================================================================
   171	# ? CLASS Spriteset_Map edit
   172	#===============================================================================
   173	class Spriteset_Map
   174	  attr_accessor :shadows
   175	
   176	  alias shadow_initialize initialize unless private_method_defined?(:shadow_initialize)
   177	
   178	  def initialize(map = nil)
   179	    @shadows = []
   180	    warn = false
   181	    map = $game_map if !map
   182	    map.events.keys.sort.each do |k|
   183	      ev = map.events[k]
   184	      warn = true if ev.list && ev.list.length > 0 && ev.list[0].code == 108 &&
   185	                     (ev.list[0].parameters == ["s"] || ev.list[0].parameters == ["o"])
   186	      params = XPML_read(map, "Shadow Source", ev, 4)
   187	      @shadows.push([ev] + params) if params
   188	    end
   189	    if warn == true
   190	      p "Warning : At least one event on this map uses the obsolete way to add shadows"
   191	    end
   192	    shadow_initialize(map)
   193	    @character_sprites.each do |sprite|
   194	      sprite.setShadows(map, @shadows)
   195	    end
   196	    $scene.spritesetGlobal.playersprite.setShadows(map, @shadows)
   197	  end
   198	end
   199	
   200	#===============================================================================
   201	# ? XPML Definition, by Rataime, using ideas from Near Fantastica
   202	#
   203	#   Returns nil if the markup wasn't present at all,
   204	#   returns [] if there wasn't any parameters, else
   205	#   returns a parameters list with "int" converted as int
   206	#   eg :
   207	#   begin first
   208	#   begin second
   209	#   param1 1
   210	#   param2 two
   211	#   begin third
   212	#   anything 3
   213	#
   214	#   p XPML_read("first", event_id) -> []
   215	#   p XPML_read("second", event_id) -> [1, "two"]
   216	#   p XPML_read("third", event_id) -> [3]
   217	#   p XPML_read("forth", event_id) -> nil
   218	#===============================================================================
   219	def XPML_read(map, markup, event, max_param_number = 0)
   220	  parameter_list = nil
   221	  return nil if !event || event.list.nil?
   222	  event.list.size.times do |i|
   223	    next unless event.list[i].code == 108 &&
   224	                event.list[i].parameters[0].downcase == "begin " + markup.downcase
   225	    parameter_list = [] if parameter_list.nil?
   226	    ((i + 1)...event.list.size).each do |j|
   227	      return parameter_list if event.list[j].code != 108
   228	      parts = event.list[j].parameters[0].split
   229	      return parameter_list if parts.size == 1 || parts[0].downcase == "begin"
   230	      if parts[1].to_i != 0 || parts[1] == "0"
   231	        parameter_list.push(parts[1].to_i)
   232	      else
   233	        parameter_list.push(parts[1])
   234	      end
   235	      return parameter_list if max_param_number != 0 && j == i + max_param_number
   236	    end
   237	  end
   238	  return parameter_list
   239	end
     1	#===============================================================================
     2	#
     3	#===============================================================================
     4	class PictureSprite < Sprite
     5	  def initialize(viewport, picture)
     6	    super(viewport)
     7	    @picture = picture
     8	    @pictureBitmap = nil
     9	    @customBitmap = nil
    10	    @customBitmapIsBitmap = true
    11	    @hue = 0
    12	    update
    13	  end
    14	
    15	  def dispose
    16	    @pictureBitmap&.dispose
    17	    super
    18	  end
    19	
    20	  # Doesn't free the bitmap
    21	  def setCustomBitmap(bitmap)
    22	    @customBitmap = bitmap
    23	    @customBitmapIsBitmap = @customBitmap.is_a?(Bitmap)
    24	  end
    25	
    26	  def update
    27	    super
    28	    @pictureBitmap&.update
    29	    # If picture file name is different from current one
    30	    if @customBitmap && @picture.name == ""
    31	      self.bitmap = (@customBitmapIsBitmap) ? @customBitmap : @customBitmap.bitmap
    32	    elsif @picture_name != @picture.name || @picture.hue.to_i != @hue.to_i
    33	      # Remember file name to instance variables
    34	      @picture_name = @picture.name
    35	      @hue = @picture.hue.to_i
    36	      # If file name is not empty
    37	      if @picture_name == ""
    38	        @pictureBitmap&.dispose
    39	        @pictureBitmap = nil
    40	        self.visible = false
    41	        return
    42	      end
    43	      # Get picture graphic
    44	      @pictureBitmap&.dispose
    45	      @pictureBitmap = AnimatedBitmap.new(@picture_name, @hue)
    46	      self.bitmap = (@pictureBitmap) ? @pictureBitmap.bitmap : nil
    47	    elsif @picture_name == ""
    48	      # Set sprite to invisible
    49	      self.visible = false
    50	      return
    51	    end
    52	    setPictureSprite(self, @picture)
    53	  end
    54	end
    55	
    56	def pbTextBitmap(text, maxwidth = Graphics.width)
    57	  tmp = Bitmap.new(maxwidth, Graphics.height)
    58	  pbSetSystemFont(tmp)
    59	  drawFormattedTextEx(tmp, 0, 4, maxwidth, text, Color.new(248, 248, 248), Color.new(168, 184, 184))
    60	  return tmp
    61	end
    62	
    63	#===============================================================================
    64	#
    65	#===============================================================================
    66	class EventScene
    67	  attr_accessor :onCTrigger, :onBTrigger, :onUpdate
    68	
    69	  def initialize(viewport = nil)
    70	    @viewport       = viewport
    71	    @onCTrigger     = Event.new
    72	    @onBTrigger     = Event.new
    73	    @onUpdate       = Event.new
    74	    @pictures       = []
    75	    @picturesprites = []
    76	    @usersprites    = []
    77	    @disposed       = false
    78	  end
    79	
    80	  def dispose
    81	    return if disposed?
    82	    @picturesprites.each { |sprite| sprite.dispose }
    83	    @usersprites.each { |sprite| sprite.dispose }
    84	    @onCTrigger.clear
    85	    @onBTrigger.clear
    86	    @onUpdate.clear
    87	    @pictures.clear
    88	    @picturesprites.clear
    89	    @usersprites.clear
    90	    @disposed = true
    91	  end
    92	
    93	  def disposed?
    94	    return @disposed
    95	  end
    96	
    97	  def addBitmap(x, y, bitmap)
    98	    # _bitmap_ can be a Bitmap or an AnimatedBitmap
    99	    # (update method isn't called if it's animated)
   100	    # EventScene doesn't take ownership of the passed-in bitmap
   101	    num = @pictures.length
   102	    picture = PictureEx.new(num)
   103	    picture.setXY(0, x, y)
   104	    picture.setVisible(0, true)
   105	    @pictures[num] = picture
   106	    @picturesprites[num] = PictureSprite.new(@viewport, picture)
   107	    @picturesprites[num].setCustomBitmap(bitmap)
   108	    return picture
   109	  end
   110	
   111	  def addLabel(x, y, width, text)
   112	    addBitmap(x, y, pbTextBitmap(text, width))
   113	  end
   114	
   115	  def addImage(x, y, name)
   116	    num = @pictures.length
   117	    picture = PictureEx.new(num)
   118	    picture.name = name
   119	    picture.setXY(0, x, y)
   120	    picture.setVisible(0, true)
   121	    @pictures[num] = picture
   122	    @picturesprites[num] = PictureSprite.new(@viewport, picture)
   123	    return picture
   124	  end
   125	
   126	  def addUserSprite(sprite)
   127	    @usersprites.push(sprite)
   128	  end
   129	
   130	  def getPicture(num)
   131	    return @pictures[num]
   132	  end
   133	
   134	  # ticks is in 1/20ths of a second.
   135	  def wait(ticks)
   136	    return if ticks <= 0
   137	    timer_start = System.uptime
   138	    loop do
   139	      update
   140	      break if System.uptime - timer_start >= ticks / 20.0
   141	    end
   142	  end
   143	
   144	  # extra_ticks is in 1/20ths of a second.
   145	  def pictureWait(extra_ticks = 0)
   146	    loop do
   147	      hasRunning = false
   148	      @pictures.each { |pic| hasRunning = true if pic.running? }
   149	      break if !hasRunning
   150	      update
   151	    end
   152	    wait(extra_ticks)
   153	  end
   154	
   155	  def update
   156	    return if disposed?
   157	    Graphics.update
   158	    Input.update
   159	    @pictures.each { |picture| picture.update }
   160	    @picturesprites.each { |sprite| sprite.update }
   161	    @usersprites.each do |sprite|
   162	      next if !sprite || sprite.disposed? || !sprite.is_a?(Sprite)
   163	      sprite.update
   164	    end
   165	    @usersprites.delete_if { |sprite| sprite.disposed? }
   166	    @onUpdate.trigger(self)
   167	    if Input.trigger?(Input::BACK)
   168	      @onBTrigger.trigger(self)
   169	    elsif Input.trigger?(Input::USE)
   170	      @onCTrigger.trigger(self)
   171	    end
   172	  end
   173	
   174	  def main
   175	    loop do
   176	      update
   177	      break if disposed?
   178	    end
   179	  end
   180	end
   181	
   182	#===============================================================================
   183	#
   184	#===============================================================================
   185	def pbEventScreen(cls)
   186	  pbFadeOutIn do
   187	    viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
   188	    viewport.z = 99999
   189	    PBDebug.logonerr { cls.new(viewport).main }
   190	    viewport.dispose
   191	  end
   192	end
