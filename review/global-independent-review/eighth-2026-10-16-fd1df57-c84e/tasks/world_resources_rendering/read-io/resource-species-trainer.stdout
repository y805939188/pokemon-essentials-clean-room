    45	
    46	    extend ClassMethodsSymbols
    47	    include InstanceMethods
    48	
    49	    def self.editor_properties
    50	      field_use_array = [_INTL("Can't use in field")]
    51	      self.schema["FieldUse"][2].each { |key, value| field_use_array[value] = key if !field_use_array[value] }
    52	      battle_use_array = [_INTL("Can't use in battle")]
    53	      self.schema["BattleUse"][2].each { |key, value| battle_use_array[value] = key if !battle_use_array[value] }
    54	      return [
    55	        ["ID",                ReadOnlyProperty,                        _INTL("ID of this item (used as a symbol like :XXX).")],
    56	        ["Name",              ItemNameProperty,                        _INTL("Name of this item as displayed by the game.")],
    57	        ["NamePlural",        ItemNameProperty,                        _INTL("Plural name of this item as displayed by the game.")],
    58	        ["PortionName",       ItemNameProperty,                        _INTL("Name of a portion of this item as displayed by the game.")],
    59	        ["PortionNamePlural", ItemNameProperty,                        _INTL("Name of 2 or more portions of this item as displayed by the game.")],
    60	        ["Pocket",            PocketProperty,                          _INTL("Pocket in the Bag where this item is stored.")],
    61	        ["Price",             LimitProperty.new(Settings::MAX_MONEY),  _INTL("Purchase price of this item.")],
    62	        ["SellPrice",         LimitProperty2.new(Settings::MAX_MONEY), _INTL("Sell price of this item. If blank, is half the purchase price.")],
    63	        ["BPPrice",           LimitProperty.new(Settings::MAX_BATTLE_POINTS), _INTL("Purchase price of this item in Battle Points (BP).")],
    64	        ["FieldUse",          EnumProperty.new(field_use_array),       _INTL("How this item can be used outside of battle.")],
    65	        ["BattleUse",         EnumProperty.new(battle_use_array),      _INTL("How this item can be used within a battle.")],
    66	        ["Flags",             StringListProperty,                      _INTL("Words/phrases that can be used to group certain kinds of items.")],
    67	        ["Consumable",        BooleanProperty,                         _INTL("Whether this item is consumed after use.")],
    68	        ["ShowQuantity",      BooleanProperty,                         _INTL("Whether the Bag shows how many of this item are in there.")],
    69	        ["Move",              MoveProperty,                            _INTL("Move taught by this HM, TM or TR.")],
    70	        ["Description",       StringProperty,                          _INTL("Description of this item.")]
    71	      ]
    72	    end
    73	
    74	    def self.icon_filename(item)
    75	      return "Graphics/Items/back" if item.nil?
    76	      item_data = self.try_get(item)
    77	      return "Graphics/Items/000" if item_data.nil?
    78	      # Check for files
    79	      ret = sprintf("Graphics/Items/%s", item_data.id)
    80	      return ret if pbResolveBitmap(ret)
    81	      # Check for TM/HM type icons
    82	      if item_data.is_machine?
    83	        prefix = "machine"
    84	        if item_data.is_HM?
    85	          prefix = "machine_hm"
    86	        elsif item_data.is_TR?
    87	          prefix = "machine_tr"
    88	        end
    89	        move_type = GameData::Move.get(item_data.move).type
    90	        type_data = GameData::Type.get(move_type)
    91	        ret = sprintf("Graphics/Items/%s_%s", prefix, type_data.id)
    92	        return ret if pbResolveBitmap(ret)
    93	        if !item_data.is_TM?
    94	          ret = sprintf("Graphics/Items/machine_%s", type_data.id)
    95	          return ret if pbResolveBitmap(ret)
    96	        end
    97	      end
    98	      return "Graphics/Items/000"
    99	    end
   100	
   101	    def self.held_icon_filename(item)
   102	      item_data = self.try_get(item)
   103	      return nil if !item_data
   104	      name_base = (item_data.is_mail?) ? "mail" : "item"
   105	      # Check for files
   106	      ret = sprintf("Graphics/UI/Party/icon_%s_%s", name_base, item_data.id)
   107	      return ret if pbResolveBitmap(ret)
   108	      return sprintf("Graphics/UI/Party/icon_%s", name_base)
   109	    end
   110	
   111	    def self.mail_filename(item)
   112	      item_data = self.try_get(item)
   113	      return nil if !item_data
   114	      # Check for files
   115	      ret = sprintf("Graphics/UI/Mail/mail_%s", item_data.id)
   116	      return pbResolveBitmap(ret) ? ret : nil
   117	    end
   118	
   119	    def initialize(hash)
   120	      @id                       = hash[:id]
   121	      @real_name                = hash[:real_name]        || "Unnamed"
   122	      @real_name_plural         = hash[:real_name_plural] || "Unnamed"
   123	      @real_portion_name        = hash[:real_portion_name]
   124	      @real_portion_name_plural = hash[:real_portion_name_plural]
   125	      @pocket                   = hash[:pocket]           || 1
   126	      @price                    = hash[:price]            || 0
   127	      @sell_price               = hash[:sell_price]       || (@price / 2)
   128	      @bp_price                 = hash[:bp_price]         || 1
   129	      @field_use                = hash[:field_use]        || 0
   130	      @battle_use               = hash[:battle_use]       || 0
   131	      @flags                    = hash[:flags]            || []
   132	      @consumable               = hash[:consumable]
   133	      @consumable               = !is_important? if @consumable.nil?
   134	      @show_quantity            = hash[:show_quantity]
   135	      @move                     = hash[:move]
   136	      @real_description         = hash[:real_description] || "???"
   137	      @pbs_file_suffix          = hash[:pbs_file_suffix]  || ""
   138	    end
   139	
   140	    # @return [String] the translated name of this item
   141	    def name
   142	      return pbGetMessageFromHash(MessageTypes::ITEM_NAMES, @real_name)
   143	    end
   144	
   145	    # @return [String] the translated plural version of the name of this item
   146	    def name_plural
   147	      return pbGetMessageFromHash(MessageTypes::ITEM_NAME_PLURALS, @real_name_plural)
   148	    end
   149	
   150	    # @return [String] the translated portion name of this item
   151	    def portion_name
   152	      return pbGetMessageFromHash(MessageTypes::ITEM_PORTION_NAMES, @real_portion_name) if @real_portion_name
   153	      return name
   154	    end
   155	
   156	    # @return [String] the translated plural version of the portion name of this item
   157	    def portion_name_plural
   158	      return pbGetMessageFromHash(MessageTypes::ITEM_PORTION_NAME_PLURALS, @real_portion_name_plural) if @real_portion_name_plural
   159	      return name_plural
   160	    end
   161	
   162	    # @return [String] the translated description of this item
   163	    def description
   164	      return pbGetMessageFromHash(MessageTypes::ITEM_DESCRIPTIONS, @real_description)
   165	    end
   166	
   167	    def has_flag?(flag)
   168	      return @flags.any? { |f| f.downcase == flag.downcase }
   169	    end
   170	
   171	    def is_TM?;              return @field_use == 3; end
   172	    def is_HM?;              return @field_use == 4; end
   173	    def is_TR?;              return @field_use == 5; end
   174	    def is_machine?;         return is_TM? || is_HM? || is_TR?; end
   175	    def is_mail?;            return has_flag?("Mail") || has_flag?("IconMail"); end
   176	    def is_icon_mail?;       return has_flag?("IconMail"); end
   177	    def is_poke_ball?;       return has_flag?("PokeBall") || has_flag?("SnagBall"); end
   178	    def is_snag_ball?;       return has_flag?("SnagBall") || (is_poke_ball? && $player.has_snag_machine); end
   179	    def is_berry?;           return has_flag?("Berry"); end
   180	    def is_key_item?;        return has_flag?("KeyItem"); end
   181	    def is_evolution_stone?; return has_flag?("EvolutionStone"); end
   182	    def is_fossil?;          return has_flag?("Fossil"); end
   183	    def is_apricorn?;        return has_flag?("Apricorn"); end
   184	    def is_gem?;             return has_flag?("TypeGem"); end
   185	    def is_mulch?;           return has_flag?("Mulch"); end
   186	    def is_mega_stone?;      return has_flag?("MegaStone"); end   # Does NOT include Red Orb/Blue Orb
   187	    def is_scent?;           return has_flag?("Scent"); end
   188	
   189	    def is_important?
   190	      return true if is_key_item? || is_HM? || is_TM?
   191	      return false
   192	    end
   193	
   194	    def can_hold?; return !is_important?; end
   195	
   196	    def consumed_after_use?
   197	      return !is_important? && @consumable
   198	    end
   199	
   200	    def show_quantity?
   201	      return @show_quantity || !is_important?
   202	    end
   203	
