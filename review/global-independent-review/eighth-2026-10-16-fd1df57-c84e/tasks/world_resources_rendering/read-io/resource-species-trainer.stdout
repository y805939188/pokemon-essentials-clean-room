     1	module GameData
     2	  class Species
     3	    def self.check_graphic_file(path, species, form = 0, gender = 0, shiny = false, shadow = false, subfolder = "")
     4	      try_subfolder = sprintf("%s/", subfolder)
     5	      try_species = species
     6	      try_form    = (form > 0) ? sprintf("_%d", form) : ""
     7	      try_gender  = (gender == 1) ? "_female" : ""
     8	      try_shadow  = (shadow) ? "_shadow" : ""
     9	      factors = []
    10	      factors.push([4, sprintf("%s shiny/", subfolder), try_subfolder]) if shiny
    11	      factors.push([3, try_shadow, ""]) if shadow
    12	      factors.push([2, try_gender, ""]) if gender == 1
    13	      factors.push([1, try_form, ""]) if form > 0
    14	      factors.push([0, try_species, "000"])
    15	      # Go through each combination of parameters in turn to find an existing sprite
    16	      (2**factors.length).times do |i|
    17	        # Set try_ parameters for this combination
    18	        factors.each_with_index do |factor, index|
    19	          value = ((i / (2**index)).even?) ? factor[1] : factor[2]
    20	          case factor[0]
    21	          when 0 then try_species   = value
    22	          when 1 then try_form      = value
    23	          when 2 then try_gender    = value
    24	          when 3 then try_shadow    = value
    25	          when 4 then try_subfolder = value   # Shininess
    26	          end
    27	        end
    28	        # Look for a graphic matching this combination's parameters
    29	        try_species_text = try_species
    30	        ret = pbResolveBitmap(sprintf("%s%s%s%s%s%s", path, try_subfolder,
    31	                                      try_species_text, try_form, try_gender, try_shadow))
    32	        return ret if ret
    33	      end
    34	      return nil
    35	    end
    36	
    37	    def self.check_egg_graphic_file(path, species, form, suffix = "")
    38	      species_data = self.get_species_form(species, form)
    39	      return nil if species_data.nil?
    40	      if form > 0
    41	        ret = pbResolveBitmap(sprintf("%s%s_%d%s", path, species_data.species, form, suffix))
    42	        return ret if ret
    43	      end
    44	      return pbResolveBitmap(sprintf("%s%s%s", path, species_data.species, suffix))
    45	    end
    46	
    47	    def self.front_sprite_filename(species, form = 0, gender = 0, shiny = false, shadow = false)
    48	      return self.check_graphic_file("Graphics/Pokemon/", species, form, gender, shiny, shadow, "Front")
    49	    end
    50	
    51	    def self.back_sprite_filename(species, form = 0, gender = 0, shiny = false, shadow = false)
    52	      return self.check_graphic_file("Graphics/Pokemon/", species, form, gender, shiny, shadow, "Back")
    53	    end
    54	
    55	    def self.egg_sprite_filename(species, form)
    56	      ret = self.check_egg_graphic_file("Graphics/Pokemon/Eggs/", species, form)
    57	      return (ret) ? ret : pbResolveBitmap("Graphics/Pokemon/Eggs/000")
    58	    end
    59	
    60	    def self.egg_cracks_sprite_filename(species, form)
    61	      ret = self.check_egg_graphic_file("Graphics/Pokemon/Eggs/", species, form, "_cracks")
    62	      return (ret) ? ret : pbResolveBitmap("Graphics/Pokemon/Eggs/000_cracks")
    63	    end
    64	
    65	    def self.sprite_filename(species, form = 0, gender = 0, shiny = false, shadow = false, back = false, egg = false)
    66	      return self.egg_sprite_filename(species, form) if egg
    67	      return self.back_sprite_filename(species, form, gender, shiny, shadow) if back
    68	      return self.front_sprite_filename(species, form, gender, shiny, shadow)
    69	    end
    70	
    71	    def self.front_sprite_bitmap(species, form = 0, gender = 0, shiny = false, shadow = false)
    72	      filename = self.front_sprite_filename(species, form, gender, shiny, shadow)
    73	      return (filename) ? AnimatedBitmap.new(filename) : nil
    74	    end
    75	
    76	    def self.back_sprite_bitmap(species, form = 0, gender = 0, shiny = false, shadow = false)
    77	      filename = self.back_sprite_filename(species, form, gender, shiny, shadow)
    78	      return (filename) ? AnimatedBitmap.new(filename) : nil
    79	    end
    80	
    81	    def self.egg_sprite_bitmap(species, form = 0)
    82	      filename = self.egg_sprite_filename(species, form)
    83	      return (filename) ? AnimatedBitmap.new(filename) : nil
    84	    end
    85	
    86	    def self.sprite_bitmap(species, form = 0, gender = 0, shiny = false, shadow = false, back = false, egg = false)
    87	      return self.egg_sprite_bitmap(species, form) if egg
    88	      return self.back_sprite_bitmap(species, form, gender, shiny, shadow) if back
    89	      return self.front_sprite_bitmap(species, form, gender, shiny, shadow)
    90	    end
    91	
    92	    def self.sprite_bitmap_from_pokemon(pkmn, back = false, species = nil)
    93	      species = pkmn.species if !species
    94	      species = GameData::Species.get(species).species   # Just to be sure it's a symbol
    95	      return self.egg_sprite_bitmap(species, pkmn.form) if pkmn.egg?
    96	      if back
    97	        ret = self.back_sprite_bitmap(species, pkmn.form, pkmn.gender, pkmn.shiny?, pkmn.shadowPokemon?)
    98	      else
    99	        ret = self.front_sprite_bitmap(species, pkmn.form, pkmn.gender, pkmn.shiny?, pkmn.shadowPokemon?)
   100	      end
   101	      alter_bitmap_function = MultipleForms.getFunction(species, "alterBitmap")
   102	      if ret && alter_bitmap_function
   103	        new_ret = ret.copy
   104	        ret.dispose
   105	        new_ret.each { |bitmap| alter_bitmap_function.call(pkmn, bitmap) }
   106	        ret = new_ret
   107	      end
   108	      return ret
   109	    end
   110	
   111	    #===========================================================================
   112	
   113	    def self.egg_icon_filename(species, form)
   114	      ret = self.check_egg_graphic_file("Graphics/Pokemon/Eggs/", species, form, "_icon")
   115	      return (ret) ? ret : pbResolveBitmap("Graphics/Pokemon/Eggs/000_icon")
   116	    end
   117	
   118	    def self.icon_filename(species, form = 0, gender = 0, shiny = false, shadow = false, egg = false)
   119	      return self.egg_icon_filename(species, form) if egg
   120	      return self.check_graphic_file("Graphics/Pokemon/", species, form, gender, shiny, shadow, "Icons")
   121	    end
   122	
   123	    def self.icon_filename_from_pokemon(pkmn)
   124	      return self.icon_filename(pkmn.species, pkmn.form, pkmn.gender, pkmn.shiny?, pkmn.shadowPokemon?, pkmn.egg?)
   125	    end
   126	
   127	    def self.egg_icon_bitmap(species, form)
   128	      filename = self.egg_icon_filename(species, form)
   129	      return (filename) ? AnimatedBitmap.new(filename).deanimate : nil
   130	    end
   131	
   132	    def self.icon_bitmap(species, form = 0, gender = 0, shiny = false, shadow = false, egg = false)
   133	      return self.egg_icon_bitmap(species, form) if egg
   134	      filename = self.icon_filename(species, form, gender, shiny, shadow)
   135	      return (filename) ? AnimatedBitmap.new(filename).deanimate : nil
   136	    end
   137	
   138	    def self.icon_bitmap_from_pokemon(pkmn)
   139	      return self.icon_bitmap(pkmn.species, pkmn.form, pkmn.gender, pkmn.shiny?, pkmn.shadowPokemon?, pkmn.egg?)
   140	    end
   141	
   142	    #===========================================================================
   143	
   144	    def self.footprint_filename(species, form = 0)
   145	      species_data = self.get_species_form(species, form)
   146	      return nil if species_data.nil?
   147	      if form > 0
   148	        ret = pbResolveBitmap(sprintf("Graphics/Pokemon/Footprints/%s_%d", species_data.species, form))
   149	        return ret if ret
   150	      end
   151	      return pbResolveBitmap(sprintf("Graphics/Pokemon/Footprints/%s", species_data.species))
   152	    end
   153	
   154	    #===========================================================================
   155	
   156	    def self.shadow_filename(species, form = 0)
   157	      species_data = self.get_species_form(species, form)
   158	      return nil if species_data.nil?
   159	      # Look for species-specific shadow graphic
   160	      if form > 0
   161	        ret = pbResolveBitmap(sprintf("Graphics/Pokemon/Shadow/%s_%d", species_data.species, form))
   162	        return ret if ret
   163	      end
   164	      ret = pbResolveBitmap(sprintf("Graphics/Pokemon/Shadow/%s", species_data.species))
   165	      return ret if ret
   166	      # Use general shadow graphic
   167	      metrics_data = GameData::SpeciesMetrics.get_species_form(species_data.species, form)
   168	      return pbResolveBitmap(sprintf("Graphics/Pokemon/Shadow/%d", metrics_data.shadow_size))
   169	    end
   170	
   171	    def self.shadow_bitmap(species, form = 0)
   172	      filename = self.shadow_filename(species, form)
   173	      return (filename) ? AnimatedBitmap.new(filename) : nil
   174	    end
   175	
   176	    def self.shadow_bitmap_from_pokemon(pkmn)
   177	      filename = self.shadow_filename(pkmn.species, pkmn.form)
   178	      return (filename) ? AnimatedBitmap.new(filename) : nil
   179	    end
   180	
   181	    #===========================================================================
   182	
   183	    def self.check_cry_file(species, form, suffix = "")
   184	      species_data = self.get_species_form(species, form)
   185	      return nil if species_data.nil?
   186	      if form > 0
   187	        ret = sprintf("Cries/%s_%d%s", species_data.species, form, suffix)
   188	        return ret if pbResolveAudioSE(ret)
   189	      end
   190	      ret = sprintf("Cries/%s%s", species_data.species, suffix)
   191	      return (pbResolveAudioSE(ret)) ? ret : nil
   192	    end
   193	
   194	    def self.cry_filename(species, form = 0, suffix = "")
   195	      return self.check_cry_file(species, form || 0, suffix)
   196	    end
   197	
   198	    def self.cry_filename_from_pokemon(pkmn, suffix = "")
   199	      return self.check_cry_file(pkmn.species, pkmn.form, suffix)
   200	    end
   201	
   202	    def self.play_cry_from_species(species, form = 0, volume = 90, pitch = 100)
   203	      filename = self.cry_filename(species, form)
   204	      return if !filename
   205	      pbSEPlay(RPG::AudioFile.new(filename, volume, pitch)) rescue nil
   206	    end
   207	
   208	    def self.play_cry_from_pokemon(pkmn, volume = 90, pitch = 100)
   209	      return if !pkmn || pkmn.egg?
   210	      filename = self.cry_filename_from_pokemon(pkmn)
   211	      return if !filename
   212	      pitch ||= 100
   213	      pbSEPlay(RPG::AudioFile.new(filename, volume, pitch)) rescue nil
   214	    end
   215	
   216	    def self.play_cry(pkmn, volume = 90, pitch = 100)
   217	      if pkmn.is_a?(Pokemon)
   218	        self.play_cry_from_pokemon(pkmn, volume, pitch)
   219	      else
   220	        self.play_cry_from_species(pkmn, 0, volume, pitch)
   221	      end
   222	    end
   223	
   224	    def self.cry_length(species, form = 0, pitch = 100, suffix = "")
   225	      pitch ||= 100
   226	      return 0 if !species || pitch <= 0
   227	      pitch = pitch.to_f / 100
   228	      ret = 0.0
   229	      if species.is_a?(Pokemon)
   230	        if !species.egg?
   231	          filename = self.cry_filename_from_pokemon(species, suffix)
   232	          filename = self.cry_filename_from_pokemon(species) if !filename && !nil_or_empty?(suffix)
   233	          filename = pbResolveAudioSE(filename)
   234	          ret = getPlayTime(filename) if filename
   235	        end
   236	      else
   237	        filename = self.cry_filename(species, form, suffix)
   238	        filename = self.cry_filename(species, form) if !filename && !nil_or_empty?(suffix)
   239	        filename = pbResolveAudioSE(filename)
   240	        ret = getPlayTime(filename) if filename
   241	      end
   242	      ret /= pitch   # Sound played at a lower pitch lasts longer
   243	      return ret
   244	    end
   245	  end
   246	end
     1	module GameData
     2	  class TrainerType
     3	    attr_reader :id
     4	    attr_reader :real_name
     5	    attr_reader :gender
     6	    attr_reader :base_money
     7	    attr_reader :skill_level
     8	    attr_reader :flags
     9	    attr_reader :intro_BGM
    10	    attr_reader :battle_BGM
    11	    attr_reader :victory_BGM
    12	    attr_reader :pbs_file_suffix
    13	
    14	    DATA = {}
    15	    DATA_FILENAME = "trainer_types.dat"
    16	    PBS_BASE_FILENAME = "trainer_types"
    17	
    18	    SCHEMA = {
    19	      "SectionName" => [:id,          "m"],
    20	      "Name"        => [:real_name,   "s"],
    21	      "Gender"      => [:gender,      "e", {"Male" => 0, "male" => 0, "M" => 0, "m" => 0, "0" => 0,
    22	                                            "Female" => 1, "female" => 1, "F" => 1, "f" => 1, "1" => 1,
    23	                                            "Unknown" => 2, "unknown" => 2, "Other" => 2, "other" => 2,
    24	                                            "Mixed" => 2, "mixed" => 2, "X" => 2, "x" => 2, "2" => 2}],
    25	      "BaseMoney"   => [:base_money,  "u"],
    26	      "SkillLevel"  => [:skill_level, "u"],
    27	      "Flags"       => [:flags,       "*s"],
    28	      "IntroBGM"    => [:intro_BGM,   "s"],
    29	      "BattleBGM"   => [:battle_BGM,  "s"],
    30	      "VictoryBGM"  => [:victory_BGM, "s"]
    31	    }
    32	
    33	    extend ClassMethodsSymbols
    34	    include InstanceMethods
    35	
    36	    def self.editor_properties
    37	      gender_array = []
    38	      self.schema["Gender"][2].each { |key, value| gender_array[value] = key if !gender_array[value] }
    39	      return [
    40	        ["ID",         ReadOnlyProperty,               _INTL("ID of this Trainer Type (used as a symbol like :XXX).")],
    41	        ["Name",       StringProperty,                 _INTL("Name of this Trainer Type as displayed by the game.")],
    42	        ["Gender",     EnumProperty.new(gender_array), _INTL("Gender of this Trainer Type.")],
    43	        ["BaseMoney",  LimitProperty.new(9999),        _INTL("Player earns this much money times the highest level among the trainer's Pokémon.")],
    44	        ["SkillLevel", LimitProperty2.new(9999),       _INTL("Skill level of this Trainer Type.")],
    45	        ["Flags",      StringListProperty,             _INTL("Words/phrases that can be used to make trainers of this type behave differently to others.")],
    46	        ["IntroBGM",   BGMProperty,                    _INTL("BGM played before battles against trainers of this type.")],
    47	        ["BattleBGM",  BGMProperty,                    _INTL("BGM played in battles against trainers of this type.")],
    48	        ["VictoryBGM", BGMProperty,                    _INTL("BGM played when player wins battles against trainers of this type.")]
    49	      ]
    50	    end
    51	
    52	    def self.check_file(tr_type, path, optional_suffix = "", suffix = "")
    53	      tr_type_data = self.try_get(tr_type)
    54	      return nil if tr_type_data.nil?
    55	      # Check for files
    56	      if optional_suffix && !optional_suffix.empty?
    57	        ret = path + tr_type_data.id.to_s + optional_suffix + suffix
    58	        return ret if pbResolveBitmap(ret)
    59	      end
    60	      ret = path + tr_type_data.id.to_s + suffix
    61	      return (pbResolveBitmap(ret)) ? ret : nil
    62	    end
    63	
    64	    def self.charset_filename(tr_type)
    65	      return self.check_file(tr_type, "Graphics/Characters/trainer_")
    66	    end
    67	
    68	    def self.charset_filename_brief(tr_type)
    69	      ret = self.charset_filename(tr_type)
    70	      ret&.slice!("Graphics/Characters/")
    71	      return ret
    72	    end
    73	
    74	    def self.front_sprite_filename(tr_type)
    75	      return self.check_file(tr_type, "Graphics/Trainers/")
    76	    end
    77	
    78	    def self.player_front_sprite_filename(tr_type)
    79	      outfit = ($player) ? $player.outfit : 0
    80	      return self.check_file(tr_type, "Graphics/Trainers/", sprintf("_%d", outfit))
    81	    end
    82	
    83	    def self.back_sprite_filename(tr_type)
    84	      return self.check_file(tr_type, "Graphics/Trainers/", "", "_back")
    85	    end
    86	
    87	    def self.player_back_sprite_filename(tr_type)
    88	      outfit = ($player) ? $player.outfit : 0
    89	      return self.check_file(tr_type, "Graphics/Trainers/", sprintf("_%d", outfit), "_back")
    90	    end
    91	
    92	    def self.map_icon_filename(tr_type)
    93	      return self.check_file(tr_type, "Graphics/UI/Town Map/player_")
    94	    end
    95	
    96	    def self.player_map_icon_filename(tr_type)
    97	      outfit = ($player) ? $player.outfit : 0
    98	      return self.check_file(tr_type, "Graphics/UI/Town Map/player_", sprintf("_%d", outfit))
    99	    end
   100	
   101	    def initialize(hash)
   102	      @id              = hash[:id]
   103	      @real_name       = hash[:real_name]       || "Unnamed"
   104	      @gender          = hash[:gender]          || 2
   105	      @base_money      = hash[:base_money]      || 30
   106	      @skill_level     = hash[:skill_level]     || @base_money
   107	      @flags           = hash[:flags]           || []
   108	      @intro_BGM       = hash[:intro_BGM]
   109	      @battle_BGM      = hash[:battle_BGM]
   110	      @victory_BGM     = hash[:victory_BGM]
   111	      @pbs_file_suffix = hash[:pbs_file_suffix] || ""
   112	    end
   113	
   114	    # @return [String] the translated name of this trainer type
   115	    def name
   116	      return pbGetMessageFromHash(MessageTypes::TRAINER_TYPE_NAMES, @real_name)
   117	    end
   118	
   119	    def male?;   return @gender == 0; end
   120	    def female?; return @gender == 1; end
   121	
   122	    def has_flag?(flag)
   123	      return @flags.any? { |f| f.downcase == flag.downcase }
   124	    end
   125	
   126	    alias __orig__get_property_for_PBS get_property_for_PBS unless method_defined?(:__orig__get_property_for_PBS)
   127	    def get_property_for_PBS(key)
   128	      key = "SectionName" if key == "ID"
   129	      ret = __orig__get_property_for_PBS(key)
   130	      ret = nil if key == "SkillLevel" && ret == @base_money
   131	      return ret
   132	    end
   133	  end
   134	end
     1	module GameData
     2	  class Item
     3	    attr_reader :id
     4	    attr_reader :real_name
     5	    attr_reader :real_name_plural
     6	    attr_reader :real_portion_name
     7	    attr_reader :real_portion_name_plural
     8	    attr_reader :pocket
     9	    attr_reader :price
    10	    attr_reader :sell_price
    11	    attr_reader :bp_price
    12	    attr_reader :field_use
    13	    attr_reader :battle_use
    14	    attr_reader :flags
    15	    attr_reader :consumable
    16	    attr_reader :show_quantity
    17	    attr_reader :move
    18	    attr_reader :real_description
    19	    attr_reader :pbs_file_suffix
    20	
    21	    DATA = {}
    22	    DATA_FILENAME = "items.dat"
    23	    PBS_BASE_FILENAME = "items"
    24	
    25	    SCHEMA = {
    26	      "SectionName"       => [:id,                       "m"],
    27	      "Name"              => [:real_name,                "s"],
    28	      "NamePlural"        => [:real_name_plural,         "s"],
    29	      "PortionName"       => [:real_portion_name,        "s"],
    30	      "PortionNamePlural" => [:real_portion_name_plural, "s"],
    31	      "Pocket"            => [:pocket,                   "v"],
    32	      "Price"             => [:price,                    "u"],
    33	      "SellPrice"         => [:sell_price,               "u"],
    34	      "BPPrice"           => [:bp_price,                 "u"],
    35	      "FieldUse"          => [:field_use,                "e", {"OnPokemon" => 1, "Direct" => 2,
    36	                                                               "TM" => 3, "HM" => 4, "TR" => 5}],
    37	      "BattleUse"         => [:battle_use,               "e", {"OnPokemon" => 1, "OnMove" => 2,
    38	                                                               "OnBattler" => 3, "OnFoe" => 4, "Direct" => 5}],
    39	      "Flags"             => [:flags,                    "*s"],
    40	      "Consumable"        => [:consumable,               "b"],
    41	      "ShowQuantity"      => [:show_quantity,            "b"],
    42	      "Move"              => [:move,                     "e", :Move],
