    78	  def switchIsOn?(id)
    79	    switchname = $data_system.switches[id]
    80	    return false if !switchname
    81	    if switchname[/^s\:/]
    82	      return eval($~.post_match)
    83	    else
    84	      return $game_switches[id]
    85	    end
    86	  end
