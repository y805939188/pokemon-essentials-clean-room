    88	  def variable
    89	    return nil if !$PokemonGlobal.eventvars
    90	    return $PokemonGlobal.eventvars[[@map_id, @event.id]]
    91	  end
    92	
    93	  def setVariable(variable)
    94	    $PokemonGlobal.eventvars[[@map_id, @event.id]] = variable
