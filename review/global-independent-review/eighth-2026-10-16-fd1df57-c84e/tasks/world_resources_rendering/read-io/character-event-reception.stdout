    56	  def tsOn?(c)
    57	    return @tempSwitches && @tempSwitches[c] == true
    58	  end
    59	
    60	  def tsOff?(c)
    61	    return !@tempSwitches || !@tempSwitches[c]
    62	  end
    63	
    64	  def setTempSwitchOn(c)
