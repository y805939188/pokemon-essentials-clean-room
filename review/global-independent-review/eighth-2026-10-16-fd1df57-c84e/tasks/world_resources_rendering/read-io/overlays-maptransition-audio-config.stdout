     1	#===============================================================================
     2	# Location signpost
     3	#===============================================================================
     4	class LocationWindow
     5	  APPEAR_TIME = 0.4   # In seconds; is also the disappear time
     6	  LINGER_TIME = 1.6   # In seconds; time during which self is fully visible
     7	
     8	  def initialize(name)
     9	    @window = Window_AdvancedTextPokemon.new(name)
    10	    @window.resizeToFit(name, Graphics.width)
    11	    @window.x        = 0
    12	    @window.y        = -@window.height
    13	    @window.viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
    14	    @window.viewport.z = 99999
    15	    @currentmap = $game_map.map_id
    16	    @timer_start = System.uptime
    17	    @delayed = !$game_temp.fly_destination.nil?
    18	  end
    19	
    20	  def disposed?
    21	    return @window.disposed?
    22	  end
    23	
    24	  def dispose
    25	    @window.dispose
    26	  end
    27	
    28	  def update
    29	    return if @window.disposed? || $game_temp.fly_destination
    30	    if @delayed
    31	      @timer_start = System.uptime
    32	      @delayed = false
    33	    end
    34	    @window.update
    35	    if $game_temp.message_window_showing || @currentmap != $game_map.map_id
    36	      @window.dispose
    37	      return
    38	    end
    39	    if System.uptime - @timer_start >= APPEAR_TIME + LINGER_TIME
    40	      @window.y = lerp(0, -@window.height, APPEAR_TIME, @timer_start + APPEAR_TIME + LINGER_TIME, System.uptime)
    41	      @window.dispose if @window.y + @window.height <= 0
    42	    else
    43	      @window.y = lerp(-@window.height, 0, APPEAR_TIME, @timer_start, System.uptime)
    44	    end
    45	  end
    46	end
