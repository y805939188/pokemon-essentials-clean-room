    80	# Can be a Player, NPCTrainer or an array of them.
    81	def pbGetTrainerBattleBGM(trainer)
    82	  return $PokemonGlobal.nextBattleBGM.clone if $PokemonGlobal.nextBattleBGM
    83	  ret = nil
    84	  music = nil
    85	  trainerarray = (trainer.is_a?(Array)) ? trainer : [trainer]
    86	  trainerarray.each do |t|
    87	    trainer_type_data = GameData::TrainerType.get(t.trainer_type)
    88	    music = trainer_type_data.battle_BGM if trainer_type_data.battle_BGM
    89	  end
    90	  ret = pbStringToAudioFile(music) if music && music != ""
    91	  if !ret
    92	    # Check map metadata
    93	    music = $game_map.metadata&.trainer_battle_BGM
    94	    ret = pbStringToAudioFile(music) if music && music != ""
    95	  end
    96	  if !ret
    97	    # Check global metadata
    98	    music = GameData::Metadata.get.trainer_battle_BGM
    99	    ret = pbStringToAudioFile(music) if music && music != ""
   100	  end
   101	  ret = pbStringToAudioFile("Battle trainer") if !ret
   102	  return ret
   103	end
