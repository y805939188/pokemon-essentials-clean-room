    48	#===============================================================================
    49	# Visibility circle in dark maps
    50	#===============================================================================
    51	class DarknessSprite < Sprite
    52	  attr_reader :radius
    53	
    54	  def initialize(viewport = nil)
    55	    super(viewport)
    56	    @darkness = Bitmap.new(Graphics.width, Graphics.height)
    57	    @radius = radiusMin
    58	    self.bitmap = @darkness
    59	    self.z      = 99998
    60	    refresh
    61	  end
    62	
    63	  def dispose
    64	    @darkness.dispose
    65	    super
    66	  end
    67	
    68	  def radiusMin; return 64;  end   # Before using Flash
    69	  def radiusMax; return 176; end   # After using Flash
    70	
    71	  def radius=(value)
    72	    @radius = value.round
    73	    refresh
    74	  end
    75	
    76	  def refresh
    77	    @darkness.fill_rect(0, 0, Graphics.width, Graphics.height, Color.black)
    78	    cx = Graphics.width / 2
    79	    cy = Graphics.height / 2
    80	    cradius = @radius
    81	    numfades = 5
    82	    (1..numfades).each do |i|
    83	      (cx - cradius..cx + cradius).each do |j|
    84	        diff2 = (cradius * cradius) - ((j - cx) * (j - cx))
    85	        diff = Math.sqrt(diff2)
    86	        @darkness.fill_rect(j, cy - diff, 1, diff * 2, Color.new(0, 0, 0, 255.0 * (numfades - i) / numfades))
    87	      end
    88	      cradius = (cradius * 0.9).floor
    89	    end
    90	  end
    91	end
