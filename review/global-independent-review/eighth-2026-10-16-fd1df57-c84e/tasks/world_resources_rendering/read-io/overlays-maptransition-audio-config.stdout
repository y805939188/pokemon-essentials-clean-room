    77	#===============================================================================
    78	# Blacking out animation
    79	#===============================================================================
    80	def pbStartOver(gameover = false)
    81	  if pbInBugContest?
    82	    pbBugContestStartOver
    83	    return
    84	  end
    85	  $stats.blacked_out_count += 1
    86	  $player.heal_party
    87	  if $PokemonGlobal.pokecenterMapId && $PokemonGlobal.pokecenterMapId >= 0
    88	    if gameover
    89	      pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
    90	                _INTL("After the unfortunate defeat, you scurry back to a Pokémon Center."))
    91	    else
    92	      pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
    93	                _INTL("You scurry back to a Pokémon Center, protecting your exhausted Pokémon from any further harm..."))
    94	    end
    95	    pbCancelVehicles
    96	    Followers.clear
    97	    $game_switches[Settings::STARTING_OVER_SWITCH] = true
    98	    $game_temp.player_new_map_id    = $PokemonGlobal.pokecenterMapId
    99	    $game_temp.player_new_x         = $PokemonGlobal.pokecenterX
   100	    $game_temp.player_new_y         = $PokemonGlobal.pokecenterY
   101	    $game_temp.player_new_direction = $PokemonGlobal.pokecenterDirection
   102	    pbDismountBike
   103	    $scene.transfer_player if $scene.is_a?(Scene_Map)
   104	    $game_map.refresh
   105	  else
   106	    homedata = GameData::PlayerMetadata.get($player.character_ID)&.home
   107	    homedata = GameData::Metadata.get.home if !homedata
   108	    if homedata && !pbRgssExists?(sprintf("Data/Map%03d.rxdata", homedata[0]))
   109	      if $DEBUG
   110	        pbMessage(_ISPRINTF("Can't find the map 'Map{1:03d}' in the Data folder. The game will resume at the player's position.", homedata[0]))
   111	      end
   112	      $player.heal_party
   113	      return
   114	    end
   115	    if gameover
   116	      pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
   117	                _INTL("After the unfortunate defeat, you scurry back home."))
   118	    else
   119	      pbMessage("\\w[]\\wm\\c[8]\\l[3]" +
   120	                _INTL("You scurry back home, protecting your exhausted Pokémon from any further harm..."))
   121	    end
   122	    if homedata
   123	      pbCancelVehicles
   124	      Followers.clear
   125	      $game_switches[Settings::STARTING_OVER_SWITCH] = true
   126	      $game_temp.player_new_map_id    = homedata[0]
   127	      $game_temp.player_new_x         = homedata[1]
   128	      $game_temp.player_new_y         = homedata[2]
   129	      $game_temp.player_new_direction = homedata[3]
   130	      pbDismountBike
   131	      $scene.transfer_player if $scene.is_a?(Scene_Map)
   132	      $game_map.refresh
   133	    else
   134	      $player.heal_party
   135	    end
   136	  end
   137	  pbEraseEscapePoint
   138	end
     1	#===============================================================================
     2	# Load various wild battle music
     3	#===============================================================================
     4	# wildParty is an array of Pokémon objects.
     5	def pbGetWildBattleBGM(_wildParty)
     6	  return $PokemonGlobal.nextBattleBGM.clone if $PokemonGlobal.nextBattleBGM
     7	  ret = nil
     8	  if !ret
     9	    # Check map metadata
    10	    music = $game_map.metadata&.wild_battle_BGM
    11	    ret = pbStringToAudioFile(music) if music && music != ""
    12	  end
    13	  if !ret
    14	    # Check global metadata
    15	    music = GameData::Metadata.get.wild_battle_BGM
    16	    ret = pbStringToAudioFile(music) if music && music != ""
    17	  end
    18	  ret = pbStringToAudioFile("Battle wild") if !ret
    19	  return ret
    20	end
    21	
