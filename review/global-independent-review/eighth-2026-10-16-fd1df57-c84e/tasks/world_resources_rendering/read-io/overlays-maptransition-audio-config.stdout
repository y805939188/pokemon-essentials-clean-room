    93	#===============================================================================
    94	# Light effects
    95	#===============================================================================
    96	class LightEffect
    97	  def initialize(event, viewport = nil, map = nil, filename = nil)
    98	    @light = IconSprite.new(0, 0, viewport)
    99	    if !nil_or_empty?(filename) && pbResolveBitmap("Graphics/Pictures/" + filename)
   100	      @light.setBitmap("Graphics/Pictures/" + filename)
   101	    else
   102	      @light.setBitmap("Graphics/Pictures/LE")
   103	    end
   104	    @light.z = 1000
   105	    @event = event
   106	    @map = (map) ? map : $game_map
   107	    @disposed = false
   108	  end
   109	
   110	  def disposed?
   111	    return @disposed
   112	  end
   113	
   114	  def dispose
   115	    @light.dispose
   116	    @map = nil
   117	    @event = nil
   118	    @disposed = true
   119	  end
   120	
   121	  def update
   122	    @light.update
   123	  end
   124	end
   125	
   126	#===============================================================================
   127	#
   128	#===============================================================================
   129	class LightEffect_Lamp < LightEffect
   130	  def initialize(event, viewport = nil, map = nil)
   131	    lamp = AnimatedBitmap.new("Graphics/Pictures/LE")
   132	    @light = Sprite.new(viewport)
   133	    @light.bitmap = Bitmap.new(128, 64)
   134	    src_rect = Rect.new(0, 0, 64, 64)
   135	    @light.bitmap.blt(0, 0, lamp.bitmap, src_rect)
   136	    @light.bitmap.blt(20, 0, lamp.bitmap, src_rect)
   137	    @light.visible = true
   138	    @light.z       = 1000
   139	    lamp.dispose
   140	    @map = (map) ? map : $game_map
   141	    @event = event
   142	  end
   143	end
