   146	  ret = pbStringToAudioFile("Battle victory") if !ret
   147	  ret.name = "../../Audio/BGM/" + ret.name
   148	  return ret
   149	end
     1	//==============================================================================
     2	// Since this is a JSON file, comments are written with // instead of a #. Any
     3	// backslashes in file paths written in here need to be escaped (i.e. a single
     4	// backslash becomes a double backslash). If that's too much hassle, you can use
     5	// a single forward slash instead (even on Windows).
     6	//==============================================================================
     7	{
     8	    //==========================================================================
     9	    // Things you may want to/should change.
    10	    //==========================================================================
    11	
    12	    // The name shown in the game window's title. Is the game's display name.
    13	    // Note that the "Game Title" defined in RPG Maker XP should not have
    14	    // accented characters in it, which is why this property is useful.
    15	    //
    16	    "windowTitle": "Pokémon Essentials v21.1",
    17	
    18	    // The game window's width and height, in pixels.
    19	    //
    20	    "defScreenW": 512,
    21	    "defScreenH": 384,
    22	
    23	    // The path to the game window's icon. For Linux only. (Default: none)
    24	    //
    25	    // "iconPath": "/path/to/icon.png",
    26	
    27	    // Enable F12 to make the game soft reset.
    28	    //
    29	    // "enableReset": true,
    30	
    31	    // Enable F1 to open the keybinding menu.
    32	    //
    33	    // "enableSettings": true,
    34	
    35	    // The names of each input, as seen in the F1 keybinding menu. The names
    36	    // have no other use.
    37	    //
    38	    "bindingNames": {
    39	      "c": "Use",
    40	      "b": "Back",
    41	      "a": "Action",
    42	      "x": "JumpUp",
    43	      "y": "JumpDown",
    44	      "z": "Special",
    45	      "l": "(unused)",
    46	      "r": "(unused)"
    47	    },
    48	
    49	    // The name of this game's save folder. If undefined, the save folder's name
    50	    // will be the "Game Title" as defined in RPG Maker XP. It should not
    51	    // contain any accented characters.
    52	    //
    53	    // "dataPathApp": "Pokemon Essentials v21",
    54	
    55	    // If defined, the game's save folder goes into a folder with this name (in
    56	    // C:\Users\USERNAME\AppData\Roaming). If undefined, the game's save folder
    57	    // goes directly into C:\Users\USERNAME\AppData\Roaming. It should not
    58	    // contain any accented characters.
    59	    // This acts as a company/creator name, and this folder could contain save
    60	    // folders for multiple games made by the same company/creator.
    61	    //
    62	    // "dataPathOrg": "PKMN Essentials",
    63	
    64	    // SoundFont to use for midi playback (via fluidsynth).
    65	    //
    66	    "midiSoundFont": "soundfont.sf2",
    67	
    68	    // Number of streams to open for BGM tracks. If the game needs multi-track
    69	    // audio, this should be set to as many available tracks as the game needs.
    70	    // Maximum: 16.
    71	    //
    72	    // "BGMTrackCount": 1,
    73	
    74	    // Number of OpenAL sources to allocate for SE playback. If there are a lot
    75	    // of sounds playing at the same time and audibly cutting each other off,
    76	    // try increasing this number. Maximum: 64.
    77	    //
    78	    // "SESourceCount": 6,
    79	
    80	    // Index all accessible assets via their lower case path (emulates Windows
    81	    // case insensitivity).
    82	    //
    83	    "pathCache": false,
    84	
    85	    //==========================================================================
    86	    // Window size, scaling, rendering and frame rate.
    87	    // You shouldn't need to change any of these.
    88	    //==========================================================================
    89	
    90	    // Whether the game starts in full-screen mode (this can always be toggled
    91	    // with Alt-Enter during runtime).
    92	    //
    93	    // "fullscreen": false,
    94	
    95	    // Whether you can toggle full-screen mode by pressing Alt + Enter with
    96	    // either the left or right Alt key.
    97	    //
    98	    // "anyAltToggleFS": false,
    99	
   100	    // Whether the game window is freely resizable.
   101	    //
   102	    // "winResizable": true,
   103	
   104	    // Whether the game screen's aspect ratio is preserved when resizing the
   105	    // window. If false, the game screen will stretch and distort to fill the
   106	    // entire window.
   107	    //
   108	    // "fixedAspectRatio": true,
   109	
   110	    // When resizing the game screen to fit the window, whether to scale up the
   111	    // game screen by an integer amount (as large as the current window size
   112	    // allows) before doing any last additional scalings to fill part/all of the
   113	    // remaining window space (or none at all if integerScalingLastMile is
   114	    // disabled).
   115	    // If fixedAspectRatio is disabled, the integer scale factors in horizontal
   116	    // and vertical direction can differ depending on how much space is
   117	    // available; otherwise they are forced to the smaller of the two.
   118	    //
   119	    // "integerScalingActive": false,
   120	
   121	    // When integerScalingActive is enabled, this option controls whether the
   122	    // scaled game screen is further scaled (with linear interpolation when
   123	    // smoothScaling is enabled) to fill the rest of the game window.
   124	    // Note that this option still respects fixedAspectRatio.
   125	    //
   126	    // "integerScalingLastMile": true,
   127	
   128	    // Whether to apply linear interpolation when the game screen is upscaled.
   129	    //
   130	    // "smoothScaling": false,
   131	
   132	    // Whether to apply Lanczos3 interpolation when the game screen is upscaled
   133	    // (typically higher quality than the linear smoothScaling).
   134	    //
   135	    // "lanczos3Scaling": false,
   136	
   137	    // Workaround for buggy graphics drivers that don't properly synchronize
   138	    // texture access. This is most apparent when text doesn't show up or the
   139	    // map tileset doesn't render at all.
   140	    //
   141	    "subImageFix": true,
   142	
   143	    // Sync screen redraws to the monitor refresh rate, to reduce screen
   144	    // tearing.
   145	    //
   146	    "vsync": true,
   147	
   148	    // Use a fixed framerate that is approx. equal to the native screen refresh
   149	    // rate. This is different from "fixedFramerate" because the actual frame
   150	    // rate is reported back to the game, ensuring correct timers. If the screen
   151	    // refresh rate cannot be determined, this option is force-disabled. This
   152	    // option may be force-disabled at build time.
   153	    //
   154	    "syncToRefreshrate": true,
   155	
   156	    // The game's frame rate, if "syncToRefreshrate" is false.
   157	    //
   158	    // "fixedFramerate": 60,
   159	}
