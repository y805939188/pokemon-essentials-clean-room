   226	# Unused
   227	def pbGetPlayerGraphic
   228	  id = $player.character_ID
   229	  return "" if id < 1
   230	  meta = GameData::PlayerMetadata.get(id)
   231	  return "" if !meta
   232	  return GameData::TrainerType.player_front_sprite_filename(meta.trainer_type)
   233	end
   234	
   235	def pbGetTrainerTypeGender(trainer_type)
   236	  return GameData::TrainerType.get(trainer_type).gender
   237	end
   238	
   239	def pbChangePlayer(id)
   240	  return false if id < 1
   241	  meta = GameData::PlayerMetadata.get(id)
   242	  return false if !meta
   243	  $player.character_ID = id
   244	  return true
   245	end
   246	
   247	def pbTrainerName(name = nil, outfit = 0)
   248	  pbChangePlayer(1) if $player.character_ID < 1
   249	  if name.nil?
   250	    name = pbEnterPlayerName(_INTL("Your name?"), 0, Settings::MAX_PLAYER_NAME_SIZE)
   251	    if name.nil? || name.empty?
   252	      player_metadata = GameData::PlayerMetadata.get($player.character_ID)
   253	      trainer_type = (player_metadata) ? player_metadata.trainer_type : nil
   254	      gender = pbGetTrainerTypeGender(trainer_type)
   255	      name = pbSuggestTrainerName(gender)
   256	    end
   257	  end
   258	  $player.name   = name
   259	  $player.outfit = outfit
   260	end
   261	
   262	def pbSuggestTrainerName(gender)
   263	  userName = pbGetUserName
   264	  userName = userName.gsub(/\s+.*$/, "")
   265	  if userName.length > 0 && userName.length < Settings::MAX_PLAYER_NAME_SIZE
