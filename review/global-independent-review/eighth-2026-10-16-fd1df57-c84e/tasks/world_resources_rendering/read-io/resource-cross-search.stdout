   100	#===============================================================================
   101	# Constants utilities
   102	#===============================================================================
   103	# Unused
   104	def isConst?(val, mod, constant)
   105	  begin
   106	    return false if !mod.const_defined?(constant.to_sym)
   107	  rescue
   108	    return false
   109	  end
   110	  return (val == mod.const_get(constant.to_sym))
   111	end
   112	
   113	# Unused
   114	def hasConst?(mod, constant)
   115	  return false if !mod || constant.nil?
   116	  return mod.const_defined?(constant.to_sym) rescue false
   117	end
   118	
   119	# Unused
   120	def getConst(mod, constant)
   121	  return nil if !mod || constant.nil?
   122	  return mod.const_get(constant.to_sym) rescue nil
   123	end
   124	
   125	# Unused
   126	def getID(mod, constant)
   127	  return nil if !mod || constant.nil?
   128	  if constant.is_a?(Symbol) || constant.is_a?(String)
   129	    if (mod.const_defined?(constant.to_sym) rescue false)
   130	      return mod.const_get(constant.to_sym) rescue 0
   131	    end
   132	    return 0
   133	  end
   134	  return constant
   135	end
   136	
   137	def getConstantName(mod, value, raise_if_none = true)
   138	  mod = Object.const_get(mod) if mod.is_a?(Symbol)
   139	  mod.constants.each do |c|
   140	    return c.to_s if mod.const_get(c.to_sym) == value
   141	  end
   142	  raise _INTL("Value {1} not defined by a constant in {2}", value, mod.name) if raise_if_none
   143	  return nil
   144	end
   145	
   146	def getConstantNameOrValue(mod, value)
   147	  mod = Object.const_get(mod) if mod.is_a?(Symbol)
   148	  mod.constants.each do |c|
   149	    return c.to_s if mod.const_get(c.to_sym) == value
   150	  end
   151	  return value.inspect
   152	end
