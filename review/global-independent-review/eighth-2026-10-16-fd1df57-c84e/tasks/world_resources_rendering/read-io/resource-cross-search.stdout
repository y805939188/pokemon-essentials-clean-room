    63	# Converts a Celsius temperature to Fahrenheit.
    64	def toFahrenheit(celsius)
    65	  return (celsius * 9.0 / 5.0).round + 32
    66	end
    67	
    68	# Converts a Fahrenheit temperature to Celsius.
    69	def toCelsius(fahrenheit)
    70	  return ((fahrenheit - 32) * 5.0 / 9.0).round
    71	end
