    49	# Returns a language ID
    50	def pbGetLanguage
    51	  case System.user_language[0..1]
    52	  when "ja" then return 1   # Japanese
    53	  when "en" then return 2   # English
    54	  when "fr" then return 3   # French
    55	  when "it" then return 4   # Italian
    56	  when "de" then return 5   # German
    57	  when "es" then return 7   # Spanish
    58	  when "ko" then return 8   # Korean
    59	  end
    60	  return 2 # Use 'English' by default
    61	end
