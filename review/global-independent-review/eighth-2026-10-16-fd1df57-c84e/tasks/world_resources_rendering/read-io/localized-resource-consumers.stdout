     1	#==============================================================================
     2	# * Scene_Controls
     3	#------------------------------------------------------------------------------
     4	# Shows a help screen listing the keyboard controls.
     5	# Display with:
     6	#      pbEventScreen(ButtonEventScene)
     7	#==============================================================================
     8	class ButtonEventScene < EventScene
     9	  def initialize(viewport = nil)
    10	    super
    11	    Graphics.freeze
    12	    @current_screen = 1
    13	    addImage(0, 0, "Graphics/UI/Controls help/bg")
    14	    @labels = []
    15	    @label_screens = []
    16	    @keys = []
    17	    @key_screens = []
    18	
    19	    addImageForScreen(1, 44, 122, _INTL("Graphics/UI/Controls help/help_f1"))
    20	    addImageForScreen(1, 44, 252, _INTL("Graphics/UI/Controls help/help_f8"))
    21	    addLabelForScreen(1, 134, 84, 352, _INTL("Opens the Key Bindings window, where you can choose which keyboard keys to use for each control."))
    22	    addLabelForScreen(1, 134, 244, 352, _INTL("Take a screenshot. It is put in the same folder as the save file."))
    23	
    24	    addImageForScreen(2, 16, 158, _INTL("Graphics/UI/Controls help/help_arrows"))
    25	    addLabelForScreen(2, 134, 100, 352, _INTL("Use the Arrow keys to move the main character.\n\nYou can also use the Arrow keys to select entries and navigate menus."))
    26	
    27	    addImageForScreen(3, 16, 90, _INTL("Graphics/UI/Controls help/help_usekey"))
    28	    addImageForScreen(3, 16, 236, _INTL("Graphics/UI/Controls help/help_backkey"))
    29	    addLabelForScreen(3, 134, 68, 352, _INTL("Used to confirm a choice, interact with people and things, and move through text. (Default: C)"))
    30	    addLabelForScreen(3, 134, 196, 352, _INTL("Used to exit, cancel a choice, and cancel a mode. While moving around, hold to move at a different speed. (Default: X)"))
    31	
    32	    addImageForScreen(4, 16, 90, _INTL("Graphics/UI/Controls help/help_actionkey"))
    33	    addImageForScreen(4, 16, 236, _INTL("Graphics/UI/Controls help/help_specialkey"))
    34	    addLabelForScreen(4, 134, 68, 352, _INTL("Used to open the Pause Menu. Also has various functions depending on context. (Default: Z)"))
    35	    addLabelForScreen(4, 134, 196, 352, _INTL("Press to open the Ready Menu, where registered items and available field moves can be used. (Default: D)"))
    36	
    37	    set_up_screen(@current_screen)
    38	    Graphics.transition
    39	    # Go to next screen when user presses USE
    40	    onCTrigger.set(method(:pbOnScreenEnd))
    41	  end
    42	
    43	  def addLabelForScreen(number, x, y, width, text)
    44	    @labels.push(addLabel(x, y, width, text))
    45	    @label_screens.push(number)
    46	    @picturesprites[@picturesprites.length - 1].opacity = 0
    47	  end
    48	
    49	  def addImageForScreen(number, x, y, filename)
    50	    @keys.push(addImage(x, y, filename))
    51	    @key_screens.push(number)
    52	    @picturesprites[@picturesprites.length - 1].opacity = 0
    53	  end
    54	
    55	  def set_up_screen(number)
    56	    @label_screens.each_with_index do |screen, i|
    57	      @labels[i].moveOpacity((screen == number) ? 10 : 0, 10, (screen == number) ? 255 : 0)
    58	    end
    59	    @key_screens.each_with_index do |screen, i|
    60	      @keys[i].moveOpacity((screen == number) ? 10 : 0, 10, (screen == number) ? 255 : 0)
    61	    end
    62	    pictureWait   # Update event scene with the changes
    63	  end
    64	
    65	  def pbOnScreenEnd(scene, *args)
    66	    last_screen = [@label_screens.max, @key_screens.max].max
    67	    if @current_screen >= last_screen
    68	      # End scene
    69	      $game_temp.background_bitmap = Graphics.snap_to_bitmap
    70	      Graphics.freeze
    71	      @viewport.color = Color.black   # Ensure screen is black
    72	      Graphics.transition(8, "fadetoblack")
    73	      $game_temp.background_bitmap.dispose
    74	      scene.dispose
    75	    else
    76	      # Next screen
    77	      @current_screen += 1
    78	      onCTrigger.clear
    79	      set_up_screen(@current_screen)
    80	      onCTrigger.set(method(:pbOnScreenEnd))
    81	    end
    82	  end
    83	end
     1	#===============================================================================
     2	#
     3	#===============================================================================
     4	class PokemonTrainerCard_Scene
     5	  def pbUpdate
     6	    pbUpdateSpriteHash(@sprites)
     7	  end
     8	
     9	  def pbStartScene
    10	    @viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
    11	    @viewport.z = 99999
    12	    @sprites = {}
    13	    background = pbResolveBitmap("Graphics/UI/Trainer Card/bg_f")
    14	    if $player.female? && background
    15	      addBackgroundPlane(@sprites, "bg", "Trainer Card/bg_f", @viewport)
    16	    else
    17	      addBackgroundPlane(@sprites, "bg", "Trainer Card/bg", @viewport)
    18	    end
    19	    cardexists = pbResolveBitmap(_INTL("Graphics/UI/Trainer Card/card_f"))
    20	    @sprites["card"] = IconSprite.new(0, 0, @viewport)
    21	    if $player.female? && cardexists
    22	      @sprites["card"].setBitmap(_INTL("Graphics/UI/Trainer Card/card_f"))
    23	    else
    24	      @sprites["card"].setBitmap(_INTL("Graphics/UI/Trainer Card/card"))
    25	    end
    26	    @sprites["overlay"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
    27	    pbSetSystemFont(@sprites["overlay"].bitmap)
    28	    @sprites["trainer"] = IconSprite.new(336, 112, @viewport)
    29	    @sprites["trainer"].setBitmap(GameData::TrainerType.player_front_sprite_filename($player.trainer_type))
    30	    @sprites["trainer"].x -= (@sprites["trainer"].bitmap.width - 128) / 2
    31	    @sprites["trainer"].y -= (@sprites["trainer"].bitmap.height - 128)
    32	    @sprites["trainer"].z = 2
    33	    pbDrawTrainerCardFront
    34	    pbFadeInAndShow(@sprites) { pbUpdate }
    35	  end
    36	
    37	  def pbDrawTrainerCardFront
    38	    overlay = @sprites["overlay"].bitmap
    39	    overlay.clear
    40	    baseColor   = Color.new(72, 72, 72)
    41	    shadowColor = Color.new(160, 160, 160)
    42	    totalsec = $stats.play_time.to_i
    43	    hour = totalsec / 60 / 60
    44	    min = totalsec / 60 % 60
    45	    time = (hour > 0) ? _INTL("{1}h {2}m", hour, min) : _INTL("{1}m", min)
    46	    $PokemonGlobal.startTime = Time.now if !$PokemonGlobal.startTime
    47	    starttime = _INTL("{1} {2}, {3}",
    48	                      pbGetAbbrevMonthName($PokemonGlobal.startTime.mon),
    49	                      $PokemonGlobal.startTime.day,
    50	                      $PokemonGlobal.startTime.year)
    51	    textPositions = [
    52	      [_INTL("Name"), 34, 70, :left, baseColor, shadowColor],
    53	      [$player.name, 302, 70, :right, baseColor, shadowColor],
    54	      [_INTL("ID No."), 332, 70, :left, baseColor, shadowColor],
    55	      [sprintf("%05d", $player.public_ID), 468, 70, :right, baseColor, shadowColor],
    56	      [_INTL("Money"), 34, 118, :left, baseColor, shadowColor],
    57	      [_INTL("${1}", $player.money.to_s_formatted), 302, 118, :right, baseColor, shadowColor],
    58	      [_INTL("Pokédex"), 34, 166, :left, baseColor, shadowColor],
    59	      [sprintf("%d/%d", $player.pokedex.owned_count, $player.pokedex.seen_count), 302, 166, :right, baseColor, shadowColor],
    60	      [_INTL("Time"), 34, 214, :left, baseColor, shadowColor],
    61	      [time, 302, 214, :right, baseColor, shadowColor],
    62	      [_INTL("Started"), 34, 262, :left, baseColor, shadowColor],
    63	      [starttime, 302, 262, :right, baseColor, shadowColor]
    64	    ]
    65	    pbDrawTextPositions(overlay, textPositions)
    66	    x = 72
    67	    region = pbGetCurrentRegion(0) # Get the current region
    68	    imagePositions = []
    69	    8.times do |i|
    70	      if $player.badges[i + (region * 8)]
    71	        imagePositions.push(["Graphics/UI/Trainer Card/icon_badges", x, 310, i * 32, region * 32, 32, 32])
    72	      end
    73	      x += 48
    74	    end
    75	    pbDrawImagePositions(overlay, imagePositions)
    76	  end
    77	
    78	  def pbTrainerCard
    79	    pbSEPlay("GUI trainer card open")
    80	    loop do
    81	      Graphics.update
    82	      Input.update
    83	      pbUpdate
    84	      if Input.trigger?(Input::BACK)
    85	        pbPlayCloseMenuSE
    86	        break
    87	      end
    88	    end
    89	  end
    90	
    91	  def pbEndScene
    92	    pbFadeOutAndHide(@sprites) { pbUpdate }
    93	    pbDisposeSpriteHash(@sprites)
    94	    @viewport.dispose
    95	  end
    96	end
    97	
    98	#===============================================================================
    99	#
   100	#===============================================================================
   101	class PokemonTrainerCardScreen
   102	  def initialize(scene)
   103	    @scene = scene
   104	  end
   105	
   106	  def pbStartScreen
   107	    @scene.pbStartScene
   108	    @scene.pbTrainerCard
   109	    @scene.pbEndScene
   110	  end
   111	end
     1	#===============================================================================
     2	# Base class for all three menu classes below
     3	#===============================================================================
     4	class Battle::Scene::MenuBase
     5	  attr_accessor :x
     6	  attr_accessor :y
     7	  attr_reader   :z
     8	  attr_reader   :visible
     9	  attr_reader   :color
    10	  attr_reader   :index
    11	  attr_reader   :mode
    12	
    13	  # NOTE: Button width is half the width of the graphic containing them all.
    14	  BUTTON_HEIGHT = 46
    15	  TEXT_BASE_COLOR   = Battle::Scene::MESSAGE_BASE_COLOR
    16	  TEXT_SHADOW_COLOR = Battle::Scene::MESSAGE_SHADOW_COLOR
    17	
    18	  def initialize(viewport = nil)
    19	    @x          = 0
    20	    @y          = 0
    21	    @z          = 0
    22	    @visible    = false
    23	    @color      = Color.new(0, 0, 0, 0)
    24	    @index      = 0
    25	    @mode       = 0
    26	    @disposed   = false
    27	    @sprites    = {}
    28	    @visibility = {}
    29	  end
    30	
    31	  def dispose
    32	    return if disposed?
    33	    pbDisposeSpriteHash(@sprites)
    34	    @disposed = true
    35	  end
    36	
    37	  def disposed?; return @disposed; end
    38	
    39	  def z=(value)
    40	    @z = value
    41	    @sprites.each do |i|
    42	      i[1].z = value if !i[1].disposed?
    43	    end
    44	  end
    45	
    46	  def visible=(value)
    47	    @visible = value
    48	    @sprites.each do |i|
    49	      i[1].visible = (value && @visibility[i[0]]) if !i[1].disposed?
    50	    end
    51	  end
    52	
    53	  def color=(value)
    54	    @color = value
    55	    @sprites.each do |i|
    56	      i[1].color = value if !i[1].disposed?
    57	    end
    58	  end
    59	
    60	  def index=(value)
    61	    oldValue = @index
    62	    @index = value
    63	    @cmdWindow.index = @index if @cmdWindow
    64	    refresh if @index != oldValue
    65	  end
    66	
    67	  def mode=(value)
    68	    oldValue = @mode
    69	    @mode = value
    70	    refresh if @mode != oldValue
    71	  end
    72	
    73	  def addSprite(key, sprite)
    74	    @sprites[key]    = sprite
    75	    @visibility[key] = true
    76	  end
    77	
    78	  def setIndexAndMode(index, mode)
    79	    oldIndex = @index
    80	    oldMode  = @mode
    81	    @index = index
    82	    @mode  = mode
    83	    @cmdWindow.index = @index if @cmdWindow
    84	    refresh if @index != oldIndex || @mode != oldMode
    85	  end
    86	
    87	  def refresh; end
    88	
    89	  def update
    90	    pbUpdateSpriteHash(@sprites)
    91	  end
    92	end
    93	
    94	#===============================================================================
    95	# Command menu (Fight/Pokémon/Bag/Run)
    96	#===============================================================================
    97	class Battle::Scene::CommandMenu < Battle::Scene::MenuBase
    98	  # If true, displays graphics from Graphics/UI/Battle/overlay_command.png
    99	  #     and Graphics/UI/Battle/cursor_command.png.
   100	  # If false, just displays text and the command window over the graphic
   101	  #     Graphics/UI/Battle/overlay_message.png. You will need to edit def
   102	  #     pbShowWindow to make the graphic appear while the command menu is being
   103	  #     displayed.
   104	  USE_GRAPHICS = true
   105	  # Lists of which button graphics to use in different situations/types of battle.
   106	  MODES = [
   107	    [0, 2, 1, 3],   # 0 = Regular battle
   108	    [0, 2, 1, 9],   # 1 = Regular battle with "Cancel" instead of "Run"
   109	    [0, 2, 1, 4],   # 2 = Regular battle with "Call" instead of "Run"
   110	    [5, 7, 6, 3],   # 3 = Safari Zone
   111	    [0, 8, 1, 3]    # 4 = Bug-Catching Contest
   112	  ]
   113	
   114	  def initialize(viewport, z)
   115	    super(viewport)
   116	    self.x = 0
   117	    self.y = Graphics.height - 96
   118	    # Create message box (shows "What will X do?")
   119	    @msgBox = Window_UnformattedTextPokemon.newWithSize(
   120	      "", self.x + 16, self.y + 2, 220, Graphics.height - self.y, viewport
   121	    )
   122	    @msgBox.baseColor   = TEXT_BASE_COLOR
   123	    @msgBox.shadowColor = TEXT_SHADOW_COLOR
   124	    @msgBox.windowskin  = nil
   125	    addSprite("msgBox", @msgBox)
   126	    if USE_GRAPHICS
   127	      # Create background graphic
   128	      background = IconSprite.new(self.x, self.y, viewport)
   129	      background.setBitmap("Graphics/UI/Battle/overlay_command")
   130	      addSprite("background", background)
   131	      # Create bitmaps
   132	      @buttonBitmap = AnimatedBitmap.new(_INTL("Graphics/UI/Battle/cursor_command"))
   133	      # Create action buttons
   134	      @buttons = Array.new(4) do |i|   # 4 command options, therefore 4 buttons
   135	        button = Sprite.new(viewport)
   136	        button.bitmap = @buttonBitmap.bitmap
   137	        button.x = self.x + Graphics.width - 260
   138	        button.x += (i.even? ? 0 : (@buttonBitmap.width / 2) - 4)
   139	        button.y = self.y + 6
   140	        button.y += (((i / 2) == 0) ? 0 : BUTTON_HEIGHT - 4)
   141	        button.src_rect.width  = @buttonBitmap.width / 2
   142	        button.src_rect.height = BUTTON_HEIGHT
   143	        addSprite("button_#{i}", button)
   144	        next button
   145	      end
   146	    else
   147	      # Create command window (shows Fight/Bag/Pokémon/Run)
   148	      @cmdWindow = Window_CommandPokemon.newWithSize(
   149	        [], self.x + Graphics.width - 240, self.y, 240, Graphics.height - self.y, viewport
   150	      )
   151	      @cmdWindow.columns       = 2
   152	      @cmdWindow.columnSpacing = 4
   153	      @cmdWindow.ignore_input  = true
   154	      addSprite("cmdWindow", @cmdWindow)
   155	    end
   156	    self.z = z
   157	    refresh
   158	  end
   159	
   198	class Battle::Scene::FightMenu < Battle::Scene::MenuBase
   199	  attr_reader :battler
   200	  attr_reader :shiftMode
   201	
   202	  GET_MOVE_TEXT_COLOR_FROM_MOVE_BUTTON = true
   203	
   204	  # If true, displays graphics from Graphics/UI/Battle/overlay_fight.png
   205	  #     and Graphics/UI/Battle/cursor_fight.png.
   206	  # If false, just displays text and the command window over the graphic
   207	  #     Graphics/UI/Battle/overlay_message.png. You will need to edit def
   208	  #     pbShowWindow to make the graphic appear while the command menu is being
   209	  #     displayed.
   210	  USE_GRAPHICS     = true
   211	  TYPE_ICON_HEIGHT = 28
   212	  # Text colours of PP of selected move
   213	  PP_COLORS = [
   214	    Color.new(248, 72, 72), Color.new(136, 48, 48),    # Red, zero PP
   215	    Color.new(248, 136, 32), Color.new(144, 72, 24),   # Orange, 1/4 of total PP or less
   216	    Color.new(248, 192, 0), Color.new(144, 104, 0),    # Yellow, 1/2 of total PP or less
   217	    TEXT_BASE_COLOR, TEXT_SHADOW_COLOR                 # Black, more than 1/2 of total PP
   218	  ]
   219	
   220	  def initialize(viewport, z)
   221	    super(viewport)
   222	    self.x = 0
   223	    self.y = Graphics.height - 96
   224	    @battler   = nil
   225	    @shiftMode = 0
   226	    # NOTE: @mode is for the display of the Mega Evolution button.
   227	    #       0=don't show, 1=show unpressed, 2=show pressed
   228	    if USE_GRAPHICS
   229	      # Create bitmaps
   230	      @buttonBitmap  = AnimatedBitmap.new(_INTL("Graphics/UI/Battle/cursor_fight"))
   231	      @typeBitmap    = AnimatedBitmap.new(_INTL("Graphics/UI/types"))
   232	      @megaEvoBitmap = AnimatedBitmap.new(_INTL("Graphics/UI/Battle/cursor_mega"))
   233	      @shiftBitmap   = AnimatedBitmap.new(_INTL("Graphics/UI/Battle/cursor_shift"))
   234	      # Create background graphic
   235	      background = IconSprite.new(0, Graphics.height - 96, viewport)
   236	      background.setBitmap("Graphics/UI/Battle/overlay_fight")
   237	      addSprite("background", background)
   238	      # Create move buttons
   239	      @buttons = Array.new(Pokemon::MAX_MOVES) do |i|
   240	        button = Sprite.new(viewport)
   241	        button.bitmap = @buttonBitmap.bitmap
   242	        button.x = self.x + 4
   243	        button.x += (i.even? ? 0 : (@buttonBitmap.width / 2) - 4)
   244	        button.y = self.y + 6
   245	        button.y += (((i / 2) == 0) ? 0 : BUTTON_HEIGHT - 4)
   246	        button.src_rect.width  = @buttonBitmap.width / 2
   247	        button.src_rect.height = BUTTON_HEIGHT
   248	        addSprite("button_#{i}", button)
   249	        next button
   250	      end
   251	      # Create overlay for buttons (shows move names)
   252	      @overlay = BitmapSprite.new(Graphics.width, Graphics.height - self.y, viewport)
   253	      @overlay.x = self.x
   254	      @overlay.y = self.y
   255	      pbSetNarrowFont(@overlay.bitmap)
   256	      addSprite("overlay", @overlay)
   257	      # Create overlay for selected move's info (shows move's PP)
   258	      @infoOverlay = BitmapSprite.new(Graphics.width, Graphics.height - self.y, viewport)
   259	      @infoOverlay.x = self.x
   260	      @infoOverlay.y = self.y
   261	      pbSetNarrowFont(@infoOverlay.bitmap)
   262	      addSprite("infoOverlay", @infoOverlay)
   263	      # Create type icon
   264	      @typeIcon = Sprite.new(viewport)
   265	      @typeIcon.bitmap = @typeBitmap.bitmap
   266	      @typeIcon.x      = self.x + 416
   267	      @typeIcon.y      = self.y + 20
   268	      @typeIcon.src_rect.height = TYPE_ICON_HEIGHT
   269	      addSprite("typeIcon", @typeIcon)
   270	      # Create Mega Evolution button
   271	      @megaButton = Sprite.new(viewport)
   272	      @megaButton.bitmap = @megaEvoBitmap.bitmap
   273	      @megaButton.x      = self.x + 120
   274	      @megaButton.y      = self.y - (@megaEvoBitmap.height / 2)
   275	      @megaButton.src_rect.height = @megaEvoBitmap.height / 2
   276	      addSprite("megaButton", @megaButton)
   277	      # Create Shift button
   278	      @shiftButton = Sprite.new(viewport)
   279	      @shiftButton.bitmap = @shiftBitmap.bitmap
   280	      @shiftButton.x      = self.x + 4
   281	      @shiftButton.y      = self.y - @shiftBitmap.height
   282	      addSprite("shiftButton", @shiftButton)
   283	    else
   284	      # Create message box (shows type and PP of selected move)
   285	      @msgBox = Window_AdvancedTextPokemon.newWithSize(
   286	        "", self.x + 320, self.y, Graphics.width - 320, Graphics.height - self.y, viewport
   287	      )
   288	      @msgBox.baseColor   = TEXT_BASE_COLOR
   289	      @msgBox.shadowColor = TEXT_SHADOW_COLOR
   290	      pbSetNarrowFont(@msgBox.contents)
   291	      addSprite("msgBox", @msgBox)
   292	      # Create command window (shows moves)
   293	      @cmdWindow = Window_CommandPokemon.newWithSize(
   294	        [], self.x, self.y, 320, Graphics.height - self.y, viewport
   295	      )
   296	      @cmdWindow.columns       = 2
   297	      @cmdWindow.columnSpacing = 4
   298	      @cmdWindow.ignore_input  = true
   299	      pbSetNarrowFont(@cmdWindow.contents)
   300	      addSprite("cmdWindow", @cmdWindow)
   301	    end
   302	    self.z = z
   303	  end
   304	
     1	#===============================================================================
     2	# "Voltorb Flip" mini-game
     3	# By KitsuneKouta
     4	#-------------------------------------------------------------------------------
     5	# Run with:      pbVoltorbFlip
     6	#===============================================================================
     7	class VoltorbFlip
     8	  GRAPHICS_DIRECTORY = "Graphics/UI/Voltorb Flip/"
     9	  NUM_ROWS           = 5
    10	  NUM_COLUMNS        = 5
    11	  NUM_TILES          = NUM_ROWS * NUM_COLUMNS
    12	  TILE_DISTRIBUTIONS = [   # Voltorbs, Twos, Threes, MaxFreePerRowOrCol, MaxFreeTotal
    13	    # NOTE: The MaxFree values are not inclusive. The board will only be valid
    14	    #       if the corresponding counts are strictly less than these values.
    15	    # Level 1
    16	    [
    17	      [6, 3, 1, 3, 3],
    18	      [6, 0, 3, 2, 2],
    19	      [6, 5, 0, 3, 4],
    20	      [6, 2, 2, 3, 3],
    21	      [6, 4, 1, 3, 4]
    22	    ],
   257	  def pbCreateSprites
   258	    @viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
   259	    @viewport.z = 99999
   260	    @sprites["bg"] = Sprite.new(@viewport)
   261	    @sprites["bg"].bitmap = RPG::Cache.load_bitmap(GRAPHICS_DIRECTORY, _INTL("Voltorb Flip bg"))
   262	    @sprites["text"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   263	    pbSetSystemFont(@sprites["text"].bitmap)
   264	    @sprites["level"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   265	    pbSetSystemFont(@sprites["level"].bitmap)
   266	    @sprites["curtain"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   267	    @sprites["curtain"].z = 99999
   268	    @sprites["curtain"].bitmap.fill_rect(0, 0, Graphics.width, Graphics.height, Color.black)
   269	    @sprites["curtain"].opacity = 0
   270	    @sprites["curtainL"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   271	    @sprites["curtainL"].z = 99999
   272	    @sprites["curtainL"].x = Graphics.width / 2
   273	    @sprites["curtainL"].angle = -90
   274	    @sprites["curtainL"].bitmap.fill_rect(0, 0, Graphics.width, Graphics.height, Color.black)
   275	    @sprites["curtainR"] = BitmapSprite.new(Graphics.width, Graphics.height * 2, @viewport)
   276	    @sprites["curtainR"].z = 99999
   277	    @sprites["curtainR"].x = Graphics.width / 2
   278	    @sprites["curtainR"].bitmap.fill_rect(0, 0, Graphics.width, Graphics.height * 2, Color.black)
   279	    @sprites["cursor"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   280	    @sprites["cursor"].z = 99998
   281	    @sprites["icon"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   282	    @sprites["icon"].z = 99997
   283	    @sprites["mark"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   284	    @sprites["memo"] = Sprite.new(@viewport)
   285	    @sprites["memo"].bitmap = RPG::Cache.load_bitmap(GRAPHICS_DIRECTORY, _INTL("memo"))
   286	    @sprites["memo"].x = 10
   287	    @sprites["memo"].y = 244
   288	    @sprites["memo"].visible = false
   289	    @sprites["numbers"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   290	    @sprites["totalCoins"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   291	    @sprites["currentCoins"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   292	    @sprites["animation"] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   293	    @sprites["animation"].z = 99999
   294	    6.times do |i|
   295	      @sprites[i] = BitmapSprite.new(Graphics.width, Graphics.height, @viewport)
   296	      @sprites[i].z = 99996
   297	      @sprites[i].visible = false
   298	    end
   299	    # Creates images ahead of time for the display-all animation (reduces lag)
   300	    icons = []
   301	    points = 0
   302	    3.times do |i|
   303	      NUM_TILES.times do |j|
   304	        points = @squares[j][2] if i == 2
   305	        icons[j] = [GRAPHICS_DIRECTORY + "tiles", @squares[j][0], @squares[j][1], 320 + (i * 64) + (points * 64), 0, 64, 64]
   306	      end
   307	      icons.compact!
   308	      pbDrawImagePositions(@sprites[i].bitmap, icons)
   309	    end
   310	    icons = []
   311	    NUM_TILES.times do |i|
   312	      icons[i] = [GRAPHICS_DIRECTORY + "tiles", @squares[i][0], @squares[i][1], @squares[i][2] * 64, 0, 64, 64]
   313	    end
   314	    pbDrawImagePositions(@sprites[5].bitmap, icons)
   315	    # Default cursor image
   316	    @cursor[0] = [GRAPHICS_DIRECTORY + "cursor", 0 + 128, 0, 0, 0, 64, 64]
   317	  end
   318	
   478	class Translation
   479	  attr_reader :core_messages, :game_messages
   480	
   481	  def self.stringToKey(str)
   482	    if str && str[/[\r\n\t\1]|^\s+|\s+$|\s{2,}/]
   483	      key = str.clone
   484	      key.gsub!(/^\s+/, "")
   485	      key.gsub!(/\s+$/, "")
   486	      key.gsub!(/\s{2,}/, " ")
   487	      return key
   488	    end
   489	    return str
   490	  end
   491	
   492	  def initialize(filename = nil, delay_load = false)
   493	    @default_core_messages = nil
   494	    @default_game_messages = nil
   495	    @core_messages = nil   # A translation file
   496	    @game_messages = nil   # A translation file
   497	    @filename = filename
   498	    load_message_files(@filename) if @filename && !delay_load
   499	  end
   500	
   501	  def default_core_messages
   502	    load_default_messages
   503	    return @default_core_messages
   504	  end
   505	
   506	  def default_game_messages
   507	    load_default_messages
   508	    return @default_game_messages
   509	  end
   510	
   511	  def load_message_files(filename)
   512	    @core_messages = nil
   513	    @game_messages = nil
   514	    begin
   515	      core_filename = sprintf("Data/messages_%s_core.dat", filename)
   516	      if FileTest.exist?(core_filename)
   517	        @core_messages = load_data(core_filename)
   518	        @core_messages = nil if !@core_messages.is_a?(Array)
   519	      end
   520	      game_filename = sprintf("Data/messages_%s_game.dat", filename)
   521	      if FileTest.exist?(game_filename)
   522	        @game_messages = load_data(game_filename)
   523	        @game_messages = nil if !@game_messages.is_a?(Array)
   524	      end
   525	    rescue
   526	      @core_messages = nil
   527	      @game_messages = nil
   528	    end
   529	  end
   530	
   531	  def load_default_messages
   532	    return if @default_core_messages
   533	    begin
   534	      if FileTest.exist?("Data/messages_core.dat")
   535	        pbRgssOpen("Data/messages_core.dat", "rb") { |f| @default_core_messages = Marshal.load(f) }
   536	      end
   537	      @default_core_messages = [] if !@default_core_messages.is_a?(Array)
   538	      if FileTest.exist?("Data/messages_game.dat")
   539	        pbRgssOpen("Data/messages_game.dat", "rb") { |f| @default_game_messages = Marshal.load(f) }
   540	      end
   541	      @default_game_messages = [] if !@default_game_messages.is_a?(Array)
   542	    rescue
   543	      @default_core_messages = []
   544	      @default_game_messages = []
   545	    end
   546	  end
   547	
   548	  def save_default_messages
   549	    File.open("Data/messages_core.dat", "wb") { |f| Marshal.dump(@default_core_messages, f) }
   550	    File.open("Data/messages_game.dat", "wb") { |f| Marshal.dump(@default_game_messages, f) }
   551	  end
   552	
   589	  def get(type, id)
   590	    delayed_load_message_files
   591	    if @game_messages && @game_messages[type] && @game_messages[type][id]
   592	      return @game_messages[type][id]
   593	    end
   594	    if @core_messages && @core_messages[type] && @core_messages[type][id]
   595	      return @core_messages[type][id]
   596	    end
   597	    return ""
   598	  end
   599	
   600	  def getFromHash(type, text)
   601	    delayed_load_message_files
   602	    key = Translation.stringToKey(text)
   603	    return text if nil_or_empty?(key)
   604	    if @game_messages && @game_messages[type] && @game_messages[type][key]
   605	      return @game_messages[type][key]
   606	    end
   607	    if @core_messages && @core_messages[type] && @core_messages[type][key]
   608	      return @core_messages[type][key]
   609	    end
   610	    return text
   611	  end
   612	
   613	  def getFromMapHash(map_id, text)
   614	    delayed_load_message_files
   615	    key = Translation.stringToKey(text)
   616	    return text if nil_or_empty?(key)
   617	    if @game_messages && @game_messages[MessageTypes::EVENT_TEXTS]
   618	      if @game_messages[MessageTypes::EVENT_TEXTS][map_id] && @game_messages[MessageTypes::EVENT_TEXTS][map_id][key]
   619	        return @game_messages[MessageTypes::EVENT_TEXTS][map_id][key]
   620	      elsif @game_messages[MessageTypes::EVENT_TEXTS][0] && @game_messages[MessageTypes::EVENT_TEXTS][0][key]
   621	        return @game_messages[MessageTypes::EVENT_TEXTS][0][key]
   622	      end
   623	    end
   624	    if @core_messages && @core_messages[MessageTypes::EVENT_TEXTS]
   625	      if @core_messages[MessageTypes::EVENT_TEXTS][map_id] && @core_messages[MessageTypes::EVENT_TEXTS][map_id][key]
   626	        return @core_messages[MessageTypes::EVENT_TEXTS][map_id][key]
   627	      elsif @core_messages[MessageTypes::EVENT_TEXTS][0] && @core_messages[MessageTypes::EVENT_TEXTS][0][key]
   628	        return @core_messages[MessageTypes::EVENT_TEXTS][0][key]
   629	      end
   630	    end
   631	    return text
   632	  end
   633	
   634	  #-----------------------------------------------------------------------------
   635	
   636	  private
   637	
   638	  def delayed_load_message_files
   639	    return if !@filename || @core_messages
   640	    load_message_files(@filename)
   641	    @filename = nil
   642	  end
   643	
   675	module MessageTypes
   676	  # NOTE: These constants aren't numbered in any particular order, but these
   677	  #       numbers are retained for backwards compatibility with older extracted
   678	  #       text files.
   679	  EVENT_TEXTS                  = 0   # Used for text in both common events and map events
   680	  SPECIES_NAMES                = 1
   681	  SPECIES_CATEGORIES           = 2
   682	  POKEDEX_ENTRIES              = 3
   683	  SPECIES_FORM_NAMES           = 4
   684	  MOVE_NAMES                   = 5
   685	  MOVE_DESCRIPTIONS            = 6
   686	  ITEM_NAMES                   = 7
   687	  ITEM_NAME_PLURALS            = 8
   688	  ITEM_DESCRIPTIONS            = 9
   689	  ABILITY_NAMES                = 10
   690	  ABILITY_DESCRIPTIONS         = 11
   691	  TYPE_NAMES                   = 12
   692	  TRAINER_TYPE_NAMES           = 13
   693	  TRAINER_NAMES                = 14
   694	  FRONTIER_INTRO_SPEECHES      = 15
   695	  FRONTIER_END_SPEECHES_WIN    = 16
   696	  FRONTIER_END_SPEECHES_LOSE   = 17
   697	  REGION_NAMES                 = 18
   698	  REGION_LOCATION_NAMES        = 19
   699	  REGION_LOCATION_DESCRIPTIONS = 20
   700	  MAP_NAMES                    = 21
   701	  PHONE_MESSAGES               = 22
   702	  TRAINER_SPEECHES_LOSE        = 23
   703	  SCRIPT_TEXTS                 = 24
   704	  RIBBON_NAMES                 = 25
   705	  RIBBON_DESCRIPTIONS          = 26
   706	  STORAGE_CREATOR_NAME         = 27
   707	  ITEM_PORTION_NAMES           = 28
   708	  ITEM_PORTION_NAME_PLURALS    = 29
   709	  POKEMON_NICKNAMES            = 30
   710	  @@messages = Translation.new
   711	
   712	  def self.load_default_messages
   713	    @@messages.load_default_messages
   714	  end
   715	
   716	  def self.load_message_files(filename)
   717	    @@messages.load_message_files(filename)
