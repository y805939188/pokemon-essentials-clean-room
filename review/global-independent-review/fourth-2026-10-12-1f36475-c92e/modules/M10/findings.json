          "fact": "分别覆盖单键、光标命名、物品数量，不覆盖普通命令和逐位数字竞争。"
        }
      ],
      "expected_reference_behavior": "命令/带帮助命令：允许取消时同轮BACK+USE返回取消编码；取消项0时BACK无效但本轮USE仍返回当前索引。逐位数字：先编辑方向再USE；合法值当轮确认，USE与BACK同时成立仍确认；越界USE只蜂鸣继续，BACK不被处理。",
      "current_spec_behavior": "命令与数字各有确认/取消条款，但未给竞争裁决。已有明确同轮表的“共享数量”是按件数增减窗口，不能泛用于逐位数字；命名的优先序同样是另一入口。",
      "gap": "缺少两个实际默认消费者的同轮返回/继续判据；从单键规则无法唯一推出确认还是取消，以及方向能否与确认同轮发生。",
      "preconditions": [
        "无插件，窗口已正常进入循环；列出的输入查询同采样轮为真，其余假。",
        "命令为两项、默认索引0；取消项分别2与0。数字范围[0,9]、初值1、显式取消值−1。",
        "方向值由正常组件更新产生；数字越界对照采用范围[3,3]初值3同轮UP。"
      ],
      "minimal_counterexample": {
        "input": "普通命令取消项2/索引0，USE+BACK；独立数字范围[0,9]/当前1/取消−1，USE+BACK。",
        "reference_output": "前者返回1；后者返回1作为确认，绝非取消−1。",
        "distinguishing_alternative": "全局“取消优先”会使数字返回−1；全局“确认优先”会使命令返回0。"
      },
      "normal_case": "两项命令单独USE返回0、单独BACK在取消项2时返回1；数字单独USE返回1、单独BACK返回−1。",
      "failure_or_boundary_case": [
        "数字当前1，UP+USE→先变2再立即返回2；它不遵守物品数量一轮只执行首个动作。",
        "数字范围[3,3]初值3，UP+USE+BACK→先变4，确认越界蜂鸣，留循环；同轮BACK不会救出。",
        "命令取消项0，USE+BACK→BACK无效后仍返回当前索引0；带帮助入口相同。"
      ],
      "impact_on_independent_implementation": "独立实现若采用统一按钮裁决会产生不同的选择/事件变量值，或在参考仍等待的越界场景提前取消。",
