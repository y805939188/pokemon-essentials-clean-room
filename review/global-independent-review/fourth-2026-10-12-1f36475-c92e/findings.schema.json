{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "Fourth independent review findings",
  "type": "object",
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "module",
          "severity",
          "disposition",
          "status",
          "reviewer",
          "category",
          "source_baseline",
          "source_anchors",
          "specification_baseline",
          "spec_anchors",
          "expected_reference_behavior",
          "current_spec_behavior",
          "gap",
          "preconditions",
          "minimal_counterexample",
          "normal_case",
          "failure_or_boundary_case",
          "impact_on_independent_implementation",
          "negative_evidence_search",
          "proposed_spec_change",
          "acceptance_criteria",
          "affected_files",
          "shared_contracts",
          "dependencies",
          "related_capabilities",
          "related_findings",
          "root_cause_group",
          "history_links",
          "evidence_level",
          "execution_status",
          "confidence",
          "unknowns",
          "excluded_claims",
          "user_decision_needed",
          "review_resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GR4-[A-Z][A-Z0-9]*-[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "disposition": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "UNRESOLVED",
              "NO_REQUIRED_REVISION"
            ]
          },
          "category": {
            "enum": [
              "缺能力",
              "事实错误",
              "数学错误",
              "状态或时序错误",
              "交界矛盾",
              "数据或资源契约缺口",
              "实现信息不足",
              "净室问题",
              "其他"
            ]
          },
          "source_anchors": {
            "type": "array"
          },
          "spec_anchors": {
            "type": "array"
          },
          "affected_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_level": {
            "type": "array",
            "items": {
              "enum": [
                "SOURCE_STATIC",
                "SPEC_STATIC",
                "DERIVED_VECTOR",
                "TOOL_VALIDATION",
                "EXECUTED_MODEL",
                "EXECUTED_REFERENCE",
                "EXECUTED_HOST_OR_DEMO"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
