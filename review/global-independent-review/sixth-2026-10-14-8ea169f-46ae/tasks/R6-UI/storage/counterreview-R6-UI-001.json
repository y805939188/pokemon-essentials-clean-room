  "active_refutation_attempts": [
    {
      "hypothesis": "送盒实际消费者可能先删队伍，所以暂停前删除不能据局部源推导。",
      "result": "不成立：基础pbStoreCaught只赋盒格/必要时改当前盒；选择A调用它时A仍在玩家满队，返回后CatchAndStore44才delete。虽然删除位置可以重归属，消息前队伍已删这一观测不变。"
    },
    {
      "hypothesis": "队伍满会让选中旧成员入盒被拒，普通默认链不可达。",
      "result": "不成立于提案前提：球菜单只在队伍满且全部盒满时拒。默认替换配置按世代≥7启用，选项初始化手动0，再注入battle；满队6且一盒空位、普通野生1v1、球其它门成立并捕获成功可静态到达该链。未证明实际Demo/宿主运行。"
    },
    {
      "hypothesis": "选人取消或选Send to a Box也会触发旧成员删除，反例把两个入口混在一起。",
      "result": "反证这些推广：选人返回负值立即回去向菜单，尚无本次离场/送盒/删除；Send to a Box/档0菜单BACK跳出后只常规存新成员，不删旧队伍。提案最小反例限定有效Add to party目标，仍成立。"
    },
    {
      "hypothesis": "暂停消息以普通不阻塞方式展示，因此队伍与记忆分开时点不存在。",
      "result": "不成立：pbDisplayPaused经场景同步循环返回。哪怕最终自动关闭，也存在调用内、后续重排尚未执行的逻辑观察时点；实体显示能否观察取决宿主依赖。"
    },
    {
      "hypothesis": "WP38或K32/K33给了明确相反的消息序，足以替WP67-A解歧义。",
      "result": "未找到：WP38只列业务送盒/移出/记忆左移；K32/K33没有旧成员送盒消息的在途状态。WP67-A228自身箭头次序把暂停放在移除前，无法由已读邻近条款消除。"
    },
    {
      "hypothesis": "异常前缀应包括任意储存失败后的玩家删除，故提案范围过宽。",
      "result": "部分反证推广：实际存储全满时pbStoreCaught返回-1，默认Peer的兜底调用其未定义暂停方法失败（源及WP38具名）；该失败早于CatchAndStore44删除。提案已以存盒成功且返回为前提，须保持这一限定。若错误发生在之后的送盒暂停调用内，盒存储与队伍删除前缀才已提交。"
    }
  ],
