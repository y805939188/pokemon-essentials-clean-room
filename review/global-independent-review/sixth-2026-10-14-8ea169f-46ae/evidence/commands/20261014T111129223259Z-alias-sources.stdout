tasks/R6-C/accepted-facts.json list [{'fact_id': 'R6-C-AF001', 'title': 'Default no-target Spikes reflection is a new-user general-effect call', 'source': [{'path': 'reference/pokemon-essentials/PBS/moves.txt', 'start': 4298, 'end': 4306}, {'path': 'reference/pokemon-essentials/Data/Scripts/010_Data/001_Hardcoded data/017_Target.rb', 'start': 26, 'end': 33}, {'path': 'reference/pokemon-essentials/Data/Scripts/010_Data/001_Hardcoded data/017_Target.rb', 'start': 174, 'end': 179}, {'path': 'reference/pokemon-essentials/Data/Scripts/011_Battle/003_Move/005_MoveEffects_Misc.rb', 'start': 375, 'end': 391}, {'path': 'reference/pokemon-essentials/Data/Scripts/011_Battle/002_Battler/007_Battler_UseMove.rb', 'start': 386, 'end': 438}, {'path': 'reference/pokemon-essentials/Data/Scripts/011_Battle/002_Battler/007_Battler_UseMove.rb', 'start': 482, 'end': 516}, {'path': 'reference/pokemon-essentials/Data/Scripts/011_Battle/002_Battler/007_Battler_UseMove.rb', 'start': 703, 'end': 711}], 'preconditions': '普通存活单打U席0，默认合法SPIKES槽PP20及所有普通前置通过；T席1本轮有效魔法外衣，非半无敌，双方侧Spikes0，无其它动作/能力/物品/条款改写；假设提示/演出正常完成；不声称真实运行。', 'derived_result': 'U普通PP20→19，FoeSide构造targets空；发现T魔法外衣后清该标记，外层multi-hit循环未调用/realNumHits0；反射branch以T作为新U、targets仍空，不重构目标/重定向/逐目标成功检查；整招门按T对侧（原玩家侧）层数0允许；一击通用效果让原玩家侧Spikes0→1、原敌侧保持0，不是T个体被施加位置状态。正常一击还到前/后的裁判与general-effect相关流程；随后外层clearMold/Exp/skills/endTurn继续。', 'ordinary_control': '无魔法外衣/反弹者时原U通用效果让敌侧0→1、原玩家侧0。反射者对侧已满3时内层自有失败门拒，不提交+1；原U对侧已满3则更早整招失败，不到反射扫描。', 'formal': 'WP47-A169–171并读，WP40:323中文短句可解释为以反弹者执行而非其为受招目标；未据歧义定错。WP45:130对侧撒菱从实际U看正确。', 'additional_consumer': 'SuccessState original U useState=2 is written before no-target bounce eventhough original U lastMoveFailed then true andrealNumHits0. Since targets empty, its normaltype remains, ordinaryupdateSkill gives+1 while bouncer state mayremain0. WP56:92成功机“真正完成且成功”简写需要F/root审该例是否已被界定；不在此自裁required。', 'evidence_levels': {'SOURCE_STATIC': 'Fullrelevant units newlyread', 'DERIVED_VECTOR': 'BoundeddefaultSpikes trace', 'REFERENCE_OBSERVATION': 'NOT_EXECUTED', 'independent_model': 'NOT_EXECUTED', 'complete_host': 'NOT_EXECUTED'}, 'status': 'ACCEPTED_STATIC_FACT_NOT_FINAL_REQUIREMENT_OR_RUNTIME_PASS'}]
tasks/R6-C/dismissed-hypotheses.json list [{'id': 'R6-C-D01', 'title': 'Remembered ExpShare object/symbol mismatch', 'disposition': 'DISPROVED', 'source': 'ExpAndMoveLearning28; GameData220–233 identity-aware equality supports symbols', 'formal': 'WP42 §4.1 correct', 'evidence': 'SOURCE_STATIC'}, {'id': 'R6-C-D02', 'title': 'Direct opposing living-only break/fallback', 'disposition': 'DISMISSED_SCOPED_NO_MATERIAL_FORMAL_CONTRADICTION', 'source': 'Battler001764–775; capture118–123; fulltargeting1–203', 'formal': 'WP38:25 explicitly checks fainted selected opposite then first live ally; WP47-A full source-based default pools match; WP39:190 summary is not guaranteed living result', 'consumers': 'Only explicit true caller in fixed script search is capture; normal menu enemy-index path bypasses it', 'execution': 'NOT_EXECUTED'}]
tasks/R6-C/potential-findings.json list [{'id': 'R6-C-P01', 'status': 'NO_DEFAULT_OBSERVABLE_COUNTEREXAMPLE_NONREQUIRED_PROPOSED', 'topic': 'No-target reflection invocation', 'source': '002_Battler/007_Battler_UseMove.rb:386–402,482–498,583–762', 'formal': 'WP47-A:169–171;WP40:323', 'fact': 'No-target branch selectsmc newuser then invokesmovefailed(mc,[]) andonehit(mc,[]), no pbFindTargets/reconstruction; general effect receivesmc. Targetedbounce usesoriginalUprechosen andrebuilttargets.', 'risk': 'Generalparagraph171 could be readasallbounce reconstruction;WP40shortsentencecouldmeanfornewuser ratherthanattackingthatuser, so no final contradiction yet.', 'pending': ['ReceiveCMfullformal interpretation', 'F/rootreviewSuccessState initial originalU score after no-targetbounce'], 'evidence': 'SOURCE_STATIC', 'execution': 'NOT_EXECUTED', 'default_binding_confirmed': 'accepted-facts.json R6-C-AF001', 'cm_independent_counter': 'R6-CM/counter-C-P01.json', 'resolution': '默认FoeSide四危害目标重构仍空，实际效果反射者对侧相同；仅结构调用差别不支持行为缺陷。Arena完成状态另归F004，不另立C根因。'}, {'potential_id': 'R6-C-P02', 'status': 'STATIC_PROPERTY_WORDING_UI_JOIN_PENDING_NOT_REQUIRED_PROPOSED', 'source': {'path': 'reference/pokemon-essentials/Data/Scripts/011_Battle/004_Scene/006_Battle_Scene_Objects.rb', 'start': 350, 'end': 387}, 'formal': {'path': 'deliverables/final-specification-set/user-interface/wp67-a-battle-interaction-and-presentation.md', 'start': 196, 'end': 196}, 'fact': '满EXP flash参数RGBA64/200/248/192，而正文用闪白；仍需UI主审具体合同词义与宿主scope接合。', 'evidence': ['SOURCE_STATIC'], 'observations': 0, 'root_notified': True}]
tasks/R6-D/counter-review.json dict {'reviewer_role': 'R6-D parent; not the child proposal authors', 'authority': 'Independent counter-evidence and recommendation only. Global root adjudicates final classification.', 'reviews': [{'proposal': 'R6-D-FONT-C01', 'author': 'font_resources child', 'counter_hypotheses': [{'hypothesis': 'The formal clause promises automatic replacement among all eight bundled fonts.', 'result': 'REFUTED: WP17:105 only says Power Green family, sizes and candidate fallback chain; it does not explicitly promise scanning eight files or inter-role substitution.'}, {'hypothesis': 'The already documented Arial rule makes a missing message-configuration default select Arial.', 'result': 'REFUTED: DrawText:410–414 applies at a different layout stage. MessageConfig:116–171 returns an empty selected name when its sole supplied default is unavailable.'}, {'hypothesis': 'Bundled font bytes prove the default must be reported available.', 'result': 'UNPROVEN: static family-name/cmap evidence does not establish native discovery/registration.'}], 'reread': ['MessageConfig:13–21,116–172', 'DrawText:395–415', 'WP17 messages:102–106', 'WP17 draw text:46–57'], 'recommendation': 'OPTIONAL_LOW_PRECISION_GAP; no demonstrated false existing clause, do not count as confirmed contradiction or block finite static review on it.', 'retained_limits': 'Native font availability, glyph fallback, rendering and pixels remain UNKNOWN. No actual host or independent behavioral model executed.'}, {'proposal': 'R6-D-LZ-001', 'author': 'localization_serialized child', 'counter_hypotheses': [{'hypothesis': 'Key normalization makes backslash+LF equivalent to backslash+n.', 'result': 'REFUTED: Intl:481–489 only trims/folds whitespace. Neither operation changes the letter n into LF; the single internal LF after a backslash and before text remains.'}, {'hypothesis': 'The message renderer converts slash+n before translation lookup, repairing the mismatch.', 'result': 'REFUTED: Overworld:681–682 evaluates _INTL before calling the window message consumer. Intl:774–784 performs hash lookup first; Messages:419–432 performs later control conversion.'}, {'hypothesis': 'The supplied default binary contains the corresponding r
