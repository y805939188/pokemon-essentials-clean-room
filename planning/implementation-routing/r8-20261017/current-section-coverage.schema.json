{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-clean-room:routing-current-section-coverage:v1",
  "title": "当前接受源的完整章节定位与现有功能/元数据导航",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "source_baseline_commit",
    "sections",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": "routing-current-section-coverage.v1"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "formal_tree",
        "upstream_calibration"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "formal_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_calibration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "path",
          "level",
          "title",
          "anchor",
          "line_start",
          "line_end",
          "heading_sha256",
          "feature_refs",
          "metadata_refs",
          "coverage_scope",
          "metadata_reason",
          "mapping_basis",
          "accepted_events"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{4}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "heading_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "feature_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FR-[0-9]{6}$"
            }
          },
          "metadata_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^META-[0-9]{6}$"
            }
          },
          "coverage_scope": {
            "type": "string",
            "minLength": 1
          },
          "metadata_reason": {
            "type": "string",
            "minLength": 1
          },
          "mapping_basis": {
            "type": "string",
            "minLength": 1
          },
          "accepted_events": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    }
  }
}
