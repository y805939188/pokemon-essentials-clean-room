{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-clean-room:implementation-routing:v1",
  "title": "正式规格章节级去向清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_baseline", "current_snapshot", "count_policy", "decisions", "prototypes", "documents", "features"],
  "properties": {
    "schema_version": {"const": "implementation-routing.v1"},
    "status": {"enum": ["BASELINE_COARSE_CANDIDATE", "CALIBRATED_CANDIDATE", "INDEPENDENT_REVIEW_PENDING", "ACCEPTED_SCOPED"]},
    "source_baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "formal_tree", "delivery_commit", "index", "wp_index"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"}, "formal_tree": {"$ref": "#/$defs/sha1"},
        "delivery_commit": {"$ref": "#/$defs/sha1"},
        "index": {"$ref": "#/$defs/identity"}, "wp_index": {"$ref": "#/$defs/identity"}
      }
    },
    "current_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "formal_tree", "upstream_calibration"],
      "properties": {"commit": {"$ref": "#/$defs/sha1"}, "formal_tree": {"$ref": "#/$defs/sha1"}, "upstream_calibration": {"type": "string", "minLength": 1}}
    },
    "count_policy": {"type": "string", "minLength": 1},
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "status", "question", "authority"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "question": {"type": "string"}, "authority": {"type": "string"}}}},
    "prototypes": {"type": "array", "items": {"type": "object", "required": ["id", "status", "checks"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "checks": {"$ref": "#/$defs/strings"}}}},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["commit", "path", "bytes", "sha256", "git_blob"],
      "properties": {"commit": {"$ref": "#/$defs/sha1"}, "path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "git_blob": {"$ref": "#/$defs/sha1"}}
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_basis", "batches", "required_ids", "status", "authority", "accepted_events"],
      "properties": {
        "binding_basis": {"enum": ["DOCUMENT_WRITE_SET_CONSERVATIVE", "ACCEPTED_SECTION_DIFF"]},
        "batches": {"$ref": "#/$defs/strings"}, "required_ids": {"$ref": "#/$defs/strings"},
        "status": {"type": "string", "minLength": 1},
        "authority": {"type": "object", "required": ["commit", "path"], "properties": {"commit": {"$ref": "#/$defs/sha1"}, "path": {"type": "string", "minLength": 1}}},
        "accepted_events": {"$ref": "#/$defs/strings"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "source", "document_role", "source_classification", "wp_refs", "dependency_wp_refs", "profile", "upstream", "feature_ids", "current_applicability", "semantic_reading"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^DOC-[0-9]{4}$"}, "source": {"$ref": "#/$defs/identity"},
        "document_role": {"enum": ["shared-governance", "test-design", "behavior-or-data"]},
        "source_classification": {"type": "string", "minLength": 1}, "wp_refs": {"$ref": "#/$defs/strings"},
        "dependency_wp_refs": {"$ref": "#/$defs/strings"}, "profile": {"type": ["string", "null"]},
        "upstream": {"$ref": "#/$defs/upstream"}, "feature_ids": {"$ref": "#/$defs/strings"},
        "current_applicability": {"type": "object", "additionalProperties": false, "required": ["snapshot_commit", "path", "identity", "source_equivalence", "status"], "properties": {"snapshot_commit": {"$ref": "#/$defs/sha1"}, "path": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "source_equivalence": {"type": "string"}, "status": {"type": "string"}}},
        "semantic_reading": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "document", "heading", "anchor", "heading_level", "heading_sha256", "line_ranges", "unit_sha256", "file_sha256", "file_git_blob", "fact_excerpt", "evidence_type"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"}, "document": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1}, "anchor": {"type": "string", "minLength": 1},
        "heading_level": {"type": "integer", "minimum": 1, "maximum": 6}, "heading_sha256": {"$ref": "#/$defs/sha256"},
        "line_ranges": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
        "unit_sha256": {"$ref": "#/$defs/sha256"}, "file_sha256": {"$ref": "#/$defs/sha256"}, "file_git_blob": {"$ref": "#/$defs/sha1"},
        "fact_excerpt": {"type": "string", "minLength": 1}, "evidence_type": {"const": "SOURCE_SPECIFICATION_ONLY"}
      }
    },
    "evidence": {
      "type": "array", "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"type": "string", "minLength": 1}, "ref": {"type": "string", "minLength": 1}}}
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "name", "document_id", "source", "current_applicability", "future_plan", "destination_verification", "implementation", "dependencies", "differences", "decision_refs", "upstream"],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^FR-[0-9]{6}$"}, "name": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "pattern": "^DOC-[0-9]{4}$"}, "source": {"$ref": "#/$defs/source"},
        "current_applicability": {
          "type": "object", "additionalProperties": false,
          "required": ["snapshot_commit", "document", "source_state", "status", "target_scope", "source_classification"],
          "properties": {"snapshot_commit": {"$ref": "#/$defs/sha1"}, "document": {"type": "string"}, "source_state": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "target_scope": {"enum": ["待确认", "待决策", "用户已确认", "用户明确不纳入"]}, "source_classification": {"type": "string", "minLength": 1}}
        },
        "future_plan": {
          "type": "object", "additionalProperties": false,
          "required": ["destination", "partners", "proposal_status", "rationale", "questions", "prototype_refs", "stage", "stage_approval", "exclusion_decision"],
          "properties": {
            "destination": {"enum": ["框架实现", "Showdown承担", "框架与Showdown协作", "MZ接入与表现重建", "不纳入目标"]},
            "partners": {"$ref": "#/$defs/strings"}, "proposal_status": {"enum": ["建议待验证", "经验证建议", "用户已批准", "已否决"]},
            "rationale": {"type": "string", "minLength": 1}, "questions": {"$ref": "#/$defs/strings"}, "prototype_refs": {"$ref": "#/$defs/strings"},
            "stage": {"enum": ["首版", "后续", "待定", "明确不纳入"]}, "stage_approval": {"enum": ["未批准", "建议", "用户已批准"]},
            "exclusion_decision": {"type": ["object", "null"], "properties": {"user_decision_ref": {"type": "string"}, "exact_scope": {"type": "string"}, "decision_quote": {"type": "string"}}}
          }
        },
        "destination_verification": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "evidence", "source_only_is_compatibility_evidence"],
          "properties": {"status": {"enum": ["待验证", "已验证", "已否决"]}, "evidence": {"$ref": "#/$defs/evidence"}, "source_only_is_compatibility_evidence": {"const": false}}
        },
        "implementation": {
          "type": "object", "additionalProperties": false, "required": ["status", "acceptance_status", "evidence"],
          "properties": {"status": {"enum": ["未实现", "进行中", "实现完成"]}, "acceptance_status": {"enum": ["未验收", "验收中", "已验收", "验收不通过"]}, "evidence": {"$ref": "#/$defs/evidence"}}
        },
        "dependencies": {"type": "object", "additionalProperties": false, "required": ["wp_refs", "document_wp_refs", "feature_refs"], "properties": {"wp_refs": {"$ref": "#/$defs/strings"}, "document_wp_refs": {"$ref": "#/$defs/strings"}, "feature_refs": {"$ref": "#/$defs/strings"}}},
        "differences": {"$ref": "#/$defs/strings"}, "decision_refs": {"$ref": "#/$defs/strings"}, "upstream": {"$ref": "#/$defs/upstream"}
      }
    }
  }
}
