  "premises_and_counterexample": {
    "input_domain": "集合选中槽0原成员A有效且默认焦点4、画布持A；列表Delete确认把该槽替换为新B，随后列表BACK，不重新Load。A有可用图样位图，允许正常新增单元。",
    "ordinary_control": "画布与集合选中槽仍为同一A时，Cel Focus选择Target使A默认1，后续新增单元焦点1。取消焦点选择不写。",
    "minimal_counterexample": "已替换成B但画布仍A时，选择Target：B默认焦点变1，A仍4；在画布新增单元仍用4。保存/单项导出取B，故焦点变1落入这些产物；A的新单元仍不进入集合保存。",
    "failure_cancel_partial_commit": {
      "cancel_exception_partial_commit": "列表Delete取消保持同一对象；Focus取消保持A/B各值。无异常即产生分裂的内存改动；BACK不保存并退出清缓存仍不回滚已发出的A/B引用。缩容形成空选中槽时同一Focus读取还有未保护空值失败，不能承诺安全刷新。"
    },
    "impact": "正文现有画布脱离说明不足以唯一预测此控件；“该默认用于新建单元”仅在集合成员与画布对象一致时成立。",
    "evidence_levels_and_execution": {
      "evidence_level": "STATIC_SOURCE_REASONING_NOT_EXECUTED",
      "negative_evidence_scope": "五个编辑器文件全文及缓存/集合定义全文已读；分别追读Cel Focus、addSprite、属性焦点默认、batch焦点默认、import/export/save目标。没有Focus操作后把canvas绑回成员的步骤。",
      "non_proposer_counterevidence": {
        "artifact": "counter-animation.json",
        "reviewer": "R6-DX/editor",
        "result": "SUPPORT_P2_SCOPED",
        "global_final_decision": "PENDING"
      }
    }
  },
