rb", "ranges": [[1226, 1237]], "facts": "菜单正常打开指标编辑器，无外部取消预览修复步骤。"}], "premises": ["固定参考 R，无插件或外部重写，合法物种与正常窗口/输入。", "该物种/形态没有自有阴影图；通用阴影1与2均可解析/加载且为不同图，3缺失（合法资源夹具，未创建）。", "初始登记 shadow_size=1、预览绑定1；本会话先前没有确认指标改动。", "只在指定观察点检查登记值、预览资源身份、改动标记及文件调用；不宣称屏幕像素。"], "minimal_counterexample": {"steps": ["打开 Set Shadow Size，浏览2，观察登记2/预览绑定2。", "按 BACK 返回主菜单且不再次选择物种或进入尺寸页。"], "expected_by_overbroad_spec": "登记恢复1且预览也恢复1。", "derived_reference": "登记恢复1、已确认改动标记仍假；预览仍绑定2。主菜单的普通刷新不把它重新绑定1。"}, "ordinary_control": ["不浏览直接BACK：登记1，预览1。", "浏览2再USE：登记2、预览2、改动标记真；总退出保存仍按原门。", "浏览2再ACTION：确认2并前进，改动标记真。", "浏览2再BACK后重新进入尺寸页：入口重新选择图形，预览才回到登记1。"], "normal_cancel_failure_partial_commit": {"normal": "浏览即更新登记和预览；USE/ACTION确认依原合同。", "cancel": "BACK恢复尺寸数据，不恢复绑定图；无已确认改动则退出不询问保存并重载档案。", "failure": "反例不依赖异常；资源/宿主失败不保证同一路径正常返回，不扩张成异常回滚。", "partial_commit": "观察点仅登记临时改值与图形绑定；无档案/PBS写入，取消后登记已恢复但显示资源仍保留浏览结果。"}, "necessary_consumers": "源列表所列阴影选择、指标应用、图形绑定/逐帧更新及主菜单调用链；正式普通战斗已有布局合同不受此修正影响。", "negative_evidence": {"completed_read_scope": ["WP73-B全文1-219", "共享测试目录全文1-390", "SpritePositioning全文1-411", "Species_files全文1-246", "SpeciesMetrics全文1-101", "IconSprite完整定义141-207"], "search_receipts": ["logs/051-locate-shadow-and-critical.json", "logs/052-negative-preview-scope.json", "logs/058-negative-shadow-all-formal-and-effective.json", "logs/059-negative-shadow-callers.json"], "remaining": "全131正式与9个有效补充身份集合完成关键词检索；只将已实读WP73-B/共享目录/所列消费者作语义负证据。历史根因去重仍由主会话/非作者复核，不用检索替代阅读。"}, "not_executed": ["参考程序、编辑器、媒体加载、真实文件写出、真实存档、独立模型及数值向量"], "minimum_correction": "将§7.5的BACK刷新承诺限定为背面/正面/阴影横移定位；§7.3明确尺寸BACK只恢复登记值，已绑定预览可保留刚浏览图，直到显式重载；WE-M17加资源身份观察与重新进入对照。", "must_preserve": ["尺寸列表首缺停止、自有阴影拒绝", "BACK恢复旧尺寸且不新增/清除既有已改标记", "USE/ACTION按变化设置标记及ACTION前进", "总保存/重载、指标PBS路径、普通战斗不广播重定位", "素材、宿主像素及Demo均未验证"], "recommended_read_set": ["本finding所列全部source/spec范围", "全正式相关预览条款、有效补充及历史去重（尚待）"], "recommended_write_set": ["deliverables/final-specification-set/demo-dx/wp73-b-world-editors.md §7.3/§7.5", "deliverables/final-specification-set/test-catal