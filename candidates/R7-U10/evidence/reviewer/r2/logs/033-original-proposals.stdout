ROOT RECORD 19 {"id": "GR7-M15-001", "status": "PROPOSED", "independent_validation": "PENDING_MAIN_SESSION_OR_NON_AUTHOR; proposer cannot be sole refuter", "title": "阴影尺寸 BACK 仅恢复登记值，不重绑旧阴影预览，WP73-B 的通用预览恢复承诺过宽", "classification": ["Demo / Developer Experience", "User Interface"], "severity": "P2", "severity_reason": "正常可达的取消路径与实现独立的预览合同不同，可导致后续验收要求错误的取消回显；数据恢复及保存门本身正确，影响限作者预览。", "evidence_level": "SOURCE_STATIC + DERIVED_VECTOR; NOT_EXECUTED", "spec": [{"path": "deliverables/final-specification-set/demo-dx/wp73-b-world-editors.md", "lines": [164, 164], "clause": "§7.5 消费者分开：BACK 恢复所编辑参数后也刷新预览", "issue": "未区分坐标定位与阴影尺寸取消；后者无位图回绑。"}, {"path": "deliverables/final-specification-set/demo-dx/wp73-b-world-editors.md", "lines": [136, 139], "clause": "§7.3 阴影尺寸", "issue": "数据恢复描述正确，应补预览残留边界。"}, {"path": "deliverables/final-specification-set/test-catalog/demo-dx-wp72-73-74-75-76-77.md", "lines": [139, 139], "clause": "WE-M17", "issue": "已有登记值/改动标记对照正确，但没有取消后预览图身份观察点。"}], "source": [{"path": "Data/Scripts/020_Debug/001_Editor screens/004_EditorScreens_SpritePositioning.rb", "ranges": [[91, 106], [108, 136], [157, 222], [307, 335], [389, 411]], "facts": "浏览调用物种/图形重载与刷新；BACK 只赋回旧尺寸；返回主菜单的刷新只处理位置，不重载图形；无确认改动时总退出重载档案。"}, {"path": "Data/Scripts/010_Data/002_PBS data/009_Species_files.rb", "ranges": [[156, 169]], "facts": "没有自有阴影时按当前登记尺寸选择通用阴影资源。"}, {"path": "Data/Scripts/010_Data/002_PBS data/010_SpeciesMetrics.rb", "ranges": [[71, 87]], "facts": "指标应用只偏移坐标，不依据 shadow_size 换图。"}, {"path": "Data/Scripts/007_Objects and windows/007_BitmapSprite.rb", "ranges": [[141, 207]], "facts": "图形绑定须显式设置；普通更新只推进已绑定图形。"}], "premises": ["固定参考 R，无插件或外部重写，合法物种与正常窗口/输入。", "该物种/形态没有自有阴影图；通用阴影1与2均可解析/加载且为不同图，3缺失（合法资源夹具，未创建）。", "初始登记 shadow_size=1、预览绑定1；本会话先前没有确认指标改动。", "只在指定观察点检查登记值、预览资源身份、改动标记及文件调用；不宣称屏幕像素。"], "minimal_counterexample": {"steps": ["打开 Set Shadow Size，浏览2，观察登记2/预览绑定2。", "按 BACK 返回主菜单且不再次选择物种或进入尺寸页。"], "expected_by_overbroad_spec": "登记恢复1且预览也恢复1。", "derived_reference": "登记恢复1、已确认改动标记仍假；预览仍绑定2。主菜单的普通刷新不把它重新绑定1。"}, "ordinary_control": ["不浏览直接BACK：登记1，预览1。", "浏览2再USE：登记2、预览2、改动标记真；总退出保存仍按原门。", "浏览2再ACTION：确认2并前进，改动标记真。", "浏览2再BACK后重新进入尺寸页：入口重新选择图形，预览才回到登记1。"], "normal_cancel_failure_partial_commit": {"normal": "浏览即更新登记和预览；USE/ACTION确认依原合同。", "cancel": "BACK恢复尺寸数据，不恢复绑定图；无已确认改动则退出不询问保存并重载档案。", "failure": "反例不依赖异常；资源/宿主失败不保证同一路径正常返回，不扩张成异常回滚。", "partial_commit": "观察点仅登记临时改值与图形绑定；无档案/PBS写入，取消后登记已恢复但显示资源仍保留浏览结果。"}, "necessary_consumers": "源列表所列阴影选择、指标应用、图形绑定/逐帧更新及主菜单调用链；正式普通战斗已有布局合同不受此修正影响。", "negative_evidence": {"completed_read_scope": ["WP73-B全文1-219", "共享测试目录全文1-390", "SpritePositioning全文1-411", "Species_files全文1-246", "SpeciesMetrics全文1-101", "IconSprite完整定义141-207"], "search_receipts": ["logs/051-locate-shadow-and-critical.json", "logs/052-negative-preview-scope.json"], "remaining": "全正式131及历史/有效补充的去重搜索尚待继续；不以未读材料声称不存在其他限定。"}, "not_executed": ["参考程序、编辑器、媒体加载、真实文件写出、真实存档、独立模型及数值向量"], "minimum_correction": "将§7.5的BACK刷新承诺限定为背面/正面/阴影横移定位；§7.3明确尺寸BACK只恢复登记值，已绑定预览可保留刚浏览图，直到显式重载；WE-M17加资源身份观察与重新进入对照。", "must_preserve": ["尺寸列表首缺停止、自有阴影拒绝", "BACK恢复旧尺寸且不新增/清除既有已改标记", "USE/ACTION按变化设置标记及ACTION前进", "总保存/重载、指标PBS路径、普通战斗不广播重定位", "素材、宿主像素及Demo均未验证"], "recommended_read_set": ["本finding所列全部source/spec范围", "全正式相关预览条款、有效补充及历史去重（尚待）"], "recommended_write_set": ["deliverables/final-specification-set/demo-dx/wp73-b-world-editors.md §7.3/§7.5", "deliverables/final-specification-set/test-catalog/demo-dx-wp72-73-74-75-76-77.md WE-M17", "主会话按治理决定同步审计/规划原稿；本子任务不写这些路径"], "acceptance": ["非作者静态复核浏览/取消/主菜单调用链，决定接受或有证据反驳。", "修正仅缩小预览回绑承诺，不修改数据取消与保存行为。", "1→2→BACK：登记1/图2/改动假/无文件；再次进入尺寸页图1。", "1→2→USE及ACTION：登记2/图2/改动真，ACTION前进。", "1→BACK及坐标位置改后BACK：分别原图保持、定位预览正确恢复。", "先前改动真时尺寸取消仍真；文件失败不加回滚。"], "history_relation": "NEW_INDEPENDENT_OBSERVATION; historical relation UNVERIFIED until explicit dedup; no inherited PASS or coverage used", "root_cause_key": "wp73b-shadow-size-cancel-restores-data-without-preview-rebind", "dependencies": ["independent non-author validation", "complete negative/dedup search outstanding"], "logs": ["logs/046-read-F2-111-219.json", "logs/050-read-S4-001-411.json", "logs/053-read-C8-C9-C10-C11.json"]}
ROOT RECORD 27 {"id": "GR7-M15-002", "status": "PROPOSED", "independent_validation": "PENDING_MAIN_SESSION_OR_NON_AUTHOR; proposer is not sole refuter", "title": "AN-M09 缩容异常/尾部追加向量遗漏原游标越界前提", "classification": ["Demo / Developer Experience", "Test Catalog"], "severity": "P3", "severity_reason": "正文条件正确，错误仅在共享测试向量的输入前提；当前文本允许正常默认状态却预期失败/长度增加，会使后续自动测试不确定。", "evidence_level": "SOURCE_STATIC + DERIVED_VECTOR; NOT_EXECUTED", "spec": [{"path": "deliverables/final-specification-set/test-catalog/demo-dx-wp72-73-74-75-76-77.md", "lines": [168, 168], "clause": "AN-M09：3 项缩为 2 后立即载入/改名、同前 Delete", "issue": "未给原集合选中槽/列表游标；仅缩容本身不保证越界。"}, {"path": "deliverables/final-specification-set/demo-dx/wp74-battle-animation-authoring-and-exchange.md", "lines": [207, 211], "clause": "§7.1 动画列表", "issue": "正文已正确限定为游标越界、Delete恰等于新长度；必须保留，不应泛化修改。"}], "source": [{"path": "Data/Scripts/011_Battle/007_Other battle code/007_BattleAnimationPlayer.rb", "ranges": [[334, 390]], "facts": "默认选中0；缩容仅原选中>=新长度时把选中置新长度，否则保留。"}, {"path": "Data/Scripts/020_Debug/002_Animation editor/005_AnimEditor_Functions.rb", "ranges": [[91, 183]], "facts": "列表初值与重建索引取集合选中；Load/Rename读取该成员，Delete在该索引写新默认动画。"}, {"path": "Data/Scripts/007_Objects and windows/005_SpriteWindow_text.rb", "ranges": [[753, 976], [1044, 1248]], "facts": "索引赋值和列表命令重建不钳越界，导航可按项目数回绕。"}, {"path": "Data/Scripts/020_Debug/003_Editor_Listers.rb", "ranges": [[4, 11]], "facts": "普通列表初始索引0，动画列表再赋集合游标。"}], "premises": ["固定R、合法三项集合A0/A1/A2和正常资源/消息/控件，无插件、外部改写或同步导航。", "集合及画布有效，先独立设selected=0或selected=2；在列表把容量滑杆改为2并执行Resize。", "后续在各自独立复位样本立刻选Load、Rename或Delete确认；不将一次Load后的退出与另一次动作混在同一例。"], "minimal_counterexample": {"input": "3项有效集合，原selected=0（正常默认前提），Resize为2；不导航。", "derived_reference": ["Load取得A0并正常载入；Rename取得A0并正常打开改名。", "Delete确认替换0号成员；长度仍2，1号原样。"], "catalog_expected": "同一现有行只给3→2却预期越界失败或Delete长度3尾部追加。"}, "ordinary_control": ["原selected=1：缩容后仍1，Load/Rename正常，Delete只替换1、长度2。", "原selected=2：缩容后为2，恰等于长度；不导航Load/Rename取空导致所述未保护失败；Delete确认追加2号、长度3且0/1原样。", "原selected=2但先方向导航：恢复有效索引，按所选有效成员正常执行。"], "normal_cancel_failure_partial_commit": {"normal": "有效原游标小于新长度时保持，操作正常。", "cancel": "列表BACK不撤销已经执行的Resize；Delete取消不替换/追加。", "failure": "仅原游标变越界且不导航时Load/Rename进入空成员失败；不执行真实失败向量，宿主恢复未知。", "partial_commit": "Resize已先截尾进入内存；后续异常不保证恢复被截尾内容。Delete末尾追加仅该越界索引条件下成立。集合落盘仍受外层保存门。"}, "necessary_consumers": "集合缩容→列表重新赋索引→命令窗口索引保留→Load/Rename/Delete消费者。", "negative_evidence": {"completed_read_scope": ["WP74全文1-497", "共享测试目录全文1-390", "BattleAnimationPlayer全文1-844", "AnimEditor_Functions全文1-1170", "Editor_Listers全文1-647", "SpriteWindow_text 715-1252（含完整索引/派生链）"], "search_receipts": ["logs/135-search-an-m09-premise.json"], "result": "未见AN-M09行内或该AN节统一给出原selected=2；正文§7.1仅给条件式，并未把其前提自动设为本测试输入。", "remaining": "非作者需判断是否接受测试目录隐含条件继承；若有其它当前具名输入约束，应给精确证据再反驳。历史去重未关闭。"}, "not_executed": ["编辑器、控件、失败样本、真实写盘、独立行为模型"], "minimum_correction": "仅在AN-M09的3→2三个相关子例显式注明原集合选中槽2、列表游标随之且不导航；加原选中0/1的普通对照。", "must_preserve": ["WP74§7.1越界规则与正常有效游标规则", "恰等长Delete追加且无空洞", "有效索引Delete替换而不塌缩", "Resize即时内存副作用及外层保存门", "未运行与宿主失败未知"], "recommended_read_set": ["所列source/spec精确范围", "非作者核对当前测试目录全部AN前提及历史关系"], "recommended_write_set": ["deliverables/final-specification-set/test-catalog/demo-dx-wp72-73-74-75-76-77.md:168 AN-M09", "若治理要求，同步相应原稿测试行/审计记录；不改参考或WP74正确正文规则"], "acceptance": ["非作者复核前提缺失是否影响向量唯一性，PROPOSED不由提出者自行关闭。", "原0/1分别3→2：Load/Rename有效、Delete长度2替换对应槽。", "原2，3→2且不导航：Load/Rename所述失败，Delete长度3尾添2号、0/1原样。", "原2先导航恢复后动作正常；Delete取消不追加。", "Resize后BACK不撤销内存截尾；外层不保存退出仍按缓存失效门，宿主/像素未执行。"], "history_relation": "RELATES_TO_WP74_R02 documented shrink boundary; proposed residual catalog premise gap, not a new source behavior defect. Exact historical root dedup UNVERIFIED.", "root_cause_key": "an-m09-missing-pre-resize-selected-index-premise", "dependencies": ["independent catalog interpretation and validation", "main-session historical dedup"], "logs": ["logs/005-read-F3-111-220.json", "logs/015-read-S10-001-300.json", "logs/009-read-S0-001-300.json", "logs/010-read-S0-301-580.json", "logs/039-read-F6-141-210.json", "logs/131-read-window-index-consumer.json", "logs/132-read-window-and-battle-layout.json", "logs/135-search-an-m09-premise.json"]}
