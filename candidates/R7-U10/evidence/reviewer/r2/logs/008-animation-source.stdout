   91   def pbAnimName(animation, cmdwin)
   92     window = ControlWindow.new(320, 128, 320, 32 * 4)
   93     window.z = 99999
   94     window.addControl(TextField.new(_INTL("New Name:"), animation.name))
   95     Input.text_input = true
   96     okbutton = window.addButton(_INTL("OK"))
   97     cancelbutton = window.addButton(_INTL("Cancel"))
   98     window.opacity = 224
   99     loop do
  100       Graphics.update
  101       Input.update
  102       window.update
  103       if window.changed?(okbutton) || Input.triggerex?(:RETURN)
  104         cmdwin.commands[cmdwin.index] = _INTL("{1} {2}", cmdwin.index, window.controls[0].text)
  105         animation.name = window.controls[0].text
  106         break
  107       end
  108       if window.changed?(cancelbutton) || Input.triggerex?(:ESCAPE)
  109         break
  110       end
  111     end
  112     window.dispose
  113     Input.text_input = false
  114     return
  115   end
