revision {
  "minimum_revision_contract": "Add a bounded static-program subsection to WP74 §18. Distinguish already documented sheet geometry from XML tool-specific input gates, skipped slots, output size/save requests and phase/failure boundaries. Replace any unconditional claim of producing RMXP animation data/PNG with the supported image-save request; keep actual integration unknown.",
  "preserve_scope": [
    "≤96 is documentation, not found runtime upper-bound validation; x absent/empty selects whole-image branch and does not consume y/w/h",
    "source accepts zero in nonnegative numeric branch; do not rename it strictly positive",
    "alpha image path versus non-alpha top-left-color transparency requests; no pixel guarantee",
    "WP74 .anm type gate, disabled RMXP conversion, association/cache rules",
    "R6 L06/L07 actual library/API/encoding/rollback unknowns",
    "No claim that historic identity-only reading was dishonest; this review adds independently decoded evidence"
  ],
  "excluded_assertions": [
    {
      "value": {
        "no-required": "WP74 §2 L28 and §7.5 L231 already specify five columns of192px and zero-based pattern identity; §18 documents doubling and XML examples. Do not report those as globally absent.",
        "optional": "Consolidated tool math table is helpful even for already covered cell geometry.",
        "policy": "Whether a future tool must preserve missing-file continuation or accept oversized rectangles is a later compatibility choice; record observed reference behavior separately.",
        "limit": "R6 L06 already preserves actual image/XML library, encoding, file failure and output unknowns. These remain open and are not a static-reading excuse."
      },
      "origin_ref": {
        "verified_reference": "p02-33da3f93fd6480f9a050#/challenges/1/other_dispositions"
      }
    }
  ]
}
