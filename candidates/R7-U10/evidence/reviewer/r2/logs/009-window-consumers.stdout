  753 class SpriteWindow_Selectable < SpriteWindow_Base
  754   attr_reader :index
  755   attr_writer :ignore_input
  756 
  757   def initialize(x, y, width, height)
  758     super(x, y, width, height)
  759     @item_max = 1
  760     @column_max = 1
  761     @virtualOy = 2   # TEXT OFFSET
  762     @index = -1
  763     @row_height = 32
  764     @column_spacing = 32
  765     @ignore_input = false
  766   end
  767 
  768   def itemCount
  769     return @item_max || 0
  770   end
  771 
  772   def index=(index)
  773     if @index != index
  774       @index = index
  775       priv_update_cursor_rect(true)
  776     end
  777   end
  778 
  779   def rowHeight
  780     return @row_height || 32
  781   end
  782 
  783   def rowHeight=(value)
  784     if @row_height != value
  785       oldTopRow = self.top_row
  786       @row_height = [1, value].max
  787       self.top_row = oldTopRow
  788       update_cursor_rect
  789     end
  790   end
  791 
  792   def columns
  793     return @column_max || 1
  794   end
  795 
  796   def columns=(value)
  797     if @column_max != value
  798       @column_max = [1, value].max
  799       update_cursor_rect
  800     end
  801   end
  802 
  803   def columnSpacing
  804     return @column_spacing || 32
  805   end
  806 
  807   def columnSpacing=(value)
  808     if @column_spacing != value
  809       @column_spacing = [0, value].max
  810       update_cursor_rect
  811     end
  812   end
  813 
  814   def count
  815     return @item_max
  816   end
  817 
  818   def row_max
  819     return ((@item_max + @column_max - 1) / @column_max).to_i
  820   end
  821 
  822   def top_row
  823     return (@virtualOy / (@row_height || 32)).to_i
  824   end
  825 
  826   def top_row=(row)
  827     row = row_max - 1 if row > row_max - 1
  828     row = 0 if row < 0
  829     @virtualOy = (row * @row_height) + 2   # TEXT OFFSET (the + 2)
  830   end
  831 
  832   def top_item
  833     return top_row * @column_max
  834   end
  835 
  836   def page_row_max
  837     return priv_page_row_max.to_i
  838   end
  839 
  840   def page_item_max
  841     return priv_page_item_max.to_i
  842   end
  843 
  844   def itemRect(item)
  845     if item < 0 || item >= @item_max || item < self.top_item ||
  846        item > self.top_item + self.page_item_max
  847       return Rect.new(0, 0, 0, 0)
  848     else
  849       cursor_width = (self.width - self.borderX - ((@column_max - 1) * @column_spacing)) / @column_max
  850       x = item % @column_max * (cursor_width + @column_spacing)
  851       y = (item / @column_max * @row_height) - @virtualOy
  852       return Rect.new(x, y, cursor_width, @row_height)
  853     end
  854   end
  855 
  856   def refresh; end
  857 
  858   def update_cursor_rect
  859     priv_update_cursor_rect
  860   end
  861 
  862   def update
  863     super
  864     if self.active && @item_max > 0 && @index >= 0 && !@ignore_input
  865       if Input.repeat?(Input::UP)
  866         if @index >= @column_max ||
  867            (Input.trigger?(Input::UP) && (@item_max % @column_max) == 0)
  868           oldindex = @index
  869           @index = (@index - @column_max + @item_max) % @item_max
  870           if @index != oldindex
  871             pbPlayCursorSE
  872             update_cursor_rect
  873           end
  874         end
  875       elsif Input.repeat?(Input::DOWN)
  876         if @index < @item_max - @column_max ||
  877            (Input.trigger?(Input::DOWN) && (@item_max % @column_max) == 0)
  878           oldindex = @index
  879           @index = (@index + @column_max) % @item_max
  880           if @index != oldindex
  881             pbPlayCursorSE
  882             update_cursor_rect
  883           end
  884         end
  885       elsif Input.repeat?(Input::LEFT)
  886         if @column_max >= 2 && @index > 0
  887           oldindex = @index
  888           @index -= 1
  889           if @index != oldindex
  890             pbPlayCursorSE
  891             update_cursor_rect
  892           end
  893         end
  894       elsif Input.repeat?(Input::RIGHT)
  895         if @column_max >= 2 && @index < @item_max - 1
  896           oldindex = @index
  897           @index += 1
  898           if @index != oldindex
  899             pbPlayCursorSE
  900             update_cursor_rect
  901           end
  902         end
  903       elsif Input.repeat?(Input::JUMPUP)
  904         if @index > 0
  905           oldindex = @index
  906           @index = [self.index - self.page_item_max, 0].max
  907           if @index != oldindex
  908             pbPlayCursorSE
  909             self.top_row -= self.page_row_max
  910             update_cursor_rect
  911           end
  912         end
  913       elsif Input.repeat?(Input::JUMPDOWN)
  914         if @index < @item_max - 1
  915           oldindex = @index
  916           @index = [self.index + self.page_item_max, @item_max - 1].min
  917           if @index != oldindex
  918             pbPlayCursorSE
  919             self.top_row += self.page_row_max
  920             update_cursor_rect
  921           end
  922         end
  923       end
  924     end
  925   end
  926 
  927   #-----------------------------------------------------------------------------
  928 
  929   private
  930 
  931   def priv_page_row_max
  932     return (self.height - self.borderY) / @row_height
  933   end
  934 
  935   def priv_page_item_max
  936     return (self.height - self.borderY) / @row_height * @column_max
  937   end
  938 
  939   def priv_update_cursor_rect(force = false)
  940     if @index < 0
  941       self.cursor_rect.empty
  942       self.refresh
  943       return
  944     end
  945     dorefresh = false
  946     row = @index / @column_max
  947     # This code makes lists scroll only when the cursor hits the top and bottom
  948     # of the visible list.
  949 #    if row < self.top_row
  950 #      self.top_row = row
  951 #      dorefresh=true
  952 #    end
  953 #    if row > self.top_row + (self.page_row_max - 1)
  954 #      self.top_row = row - (self.page_row_max - 1)
  955 #      dorefresh=true
  956 #    end
  957 #    if oldindex-self.top_item>=((self.page_item_max - 1)/2)
  958 #      self.top_row+=1
  959 #    end
  960 #    self.top_row = [self.top_row, self.row_max - self.page_row_max].min
  961     # This code makes the cursor stay in the middle of the visible list as much
  962     # as possible.
  963     new_top_row = row - ((self.page_row_max - 1) / 2).floor
  964     new_top_row = [[new_top_row, self.row_max - self.page_row_max].min, 0].max
  965     if self.top_row != new_top_row
  966       self.top_row = new_top_row
  967 #      dorefresh = true
  968     end
  969     # End of code
  970     cursor_width = (self.width - self.borderX) / @column_max
  971     x = self.index % @column_max * (cursor_width + @column_spacing)
  972     y = (self.index / @column_max * @row_height) - @virtualOy
  973     self.cursor_rect.set(x, y, cursor_width, @row_height)
  974     self.refresh if dorefresh || force
  975   end
  976 end
