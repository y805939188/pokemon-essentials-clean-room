 1056 class Window_DrawableCommand < SpriteWindow_SelectableEx
 1057   attr_reader :baseColor
 1058   attr_reader :shadowColor
 1059 
 1060   def initialize(x, y, width, height, viewport = nil)
 1061     super(x, y, width, height)
 1062     self.viewport = viewport if viewport
 1063     if isDarkWindowskin(self.windowskin)
 1064       @selarrow = AnimatedBitmap.new("Graphics/UI/sel_arrow_white")
 1065       RPG::Cache.retain("Graphics/UI/sel_arrow_white")
 1066     else
 1067       @selarrow = AnimatedBitmap.new("Graphics/UI/sel_arrow")
 1068       RPG::Cache.retain("Graphics/UI/sel_arrow")
 1069     end
 1070     @index = 0
 1071     colors = getDefaultTextColors(self.windowskin)
 1072     @baseColor   = colors[0]
 1073     @shadowColor = colors[1]
 1074     refresh
 1075   end
 1076 
 1077   def dispose
 1078     @selarrow.dispose
 1079     super
 1080   end
 1081 
 1082   def baseColor=(value)
 1083     @baseColor = value
 1084     refresh
 1085   end
 1086 
 1087   def shadowColor=(value)
 1088     @shadowColor = value
 1089     refresh
 1090   end
 1091 
 1092   def textWidth(bitmap, text)
 1093     return bitmap.text_size(text).width
 1094   end
 1095 
 1096   def getAutoDims(commands, dims, width = nil)
 1097     rowMax = ((commands.length + self.columns - 1) / self.columns).to_i
 1098     windowheight = (rowMax * self.rowHeight)
 1099     windowheight += self.borderY
 1100     if !width || width < 0
 1101       width = 0
 1102       tmpbitmap = Bitmap.new(1, 1)
 1103       pbSetSystemFont(tmpbitmap)
 1104       commands.each do |i|
 1105         width = [width, tmpbitmap.text_size(i).width].max
 1106       end
 1107       # one 16 to allow cursor
 1108       width += 16 + 16 + SpriteWindow_Base::TEXT_PADDING
 1109       tmpbitmap.dispose
 1110     end
 1111     # Store suggested width and height of window
 1112     dims[0] = [self.borderX + 1,
 1113                (width * self.columns) + self.borderX + ((self.columns - 1) * self.columnSpacing)].max
 1114     dims[1] = [self.borderY + 1, windowheight].max
 1115     dims[1] = [dims[1], Graphics.height].min
 1116   end
 1117 
 1118   def setSkin(skin)
 1119     super(skin)
 1120     privRefresh(true)
 1121     colors = getDefaultTextColors(self.windowskin)
 1122     @baseColor   = colors[0]
 1123     @shadowColor = colors[1]
 1124   end
 1125 
 1126   def drawCursor(index, rect)
 1127     if self.index == index
 1128       pbCopyBitmap(self.contents, @selarrow.bitmap, rect.x, rect.y + 2)   # TEXT OFFSET (counters the offset above)
 1129     end
 1130     return Rect.new(rect.x + 16, rect.y, rect.width - 16, rect.height)
 1131   end
 1132 
 1133   # To be implemented by derived classes.
 1134   def itemCount
 1135     return 0
 1136   end
 1137 
 1138   # To be implemented by derived classes.
 1139   def drawItem(index, count, rect); end
 1140 
 1141   def refresh
 1142     @item_max = itemCount
 1143     dwidth  = self.width - self.borderX
 1144     dheight = self.height - self.borderY
 1145     self.contents = pbDoEnsureBitmap(self.contents, dwidth, dheight)
 1146     self.contents.clear
 1147     @item_max.times do |i|
 1148       next if i < self.top_item || i > self.top_item + self.page_item_max
 1149       drawItem(i, @item_max, itemRect(i))
 1150     end
 1151   end
 1152 
 1153   def update
 1154     oldindex = self.index
 1155     super
 1156     refresh if self.index != oldindex
 1157   end
 1158 end
