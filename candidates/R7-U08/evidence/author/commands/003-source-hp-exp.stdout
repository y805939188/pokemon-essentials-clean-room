FILE Data/Scripts/011_Battle/004_Scene/001_Battle_Scene.rb
79:   def pbUpdate(cw = nil)
80:     pbGraphicsUpdate
81:     pbInputUpdate
82:     pbFrameUpdate(cw)
83:   end
84: 
85:   def pbGraphicsUpdate
86:     # Update lineup animations
87:     if @animations.length > 0
88:       shouldCompact = false
89:       @animations.each_with_index do |a, i|
90:         a.update
91:         next if !a.animDone?
92:         a.dispose
93:         @animations[i] = nil
94:         shouldCompact = true
95:       end
96:       @animations.compact! if shouldCompact
97:     end
98:     # Update other graphics
99:     @sprites["battle_bg"].update if @sprites["battle_bg"].respond_to?("update")
100:     Graphics.update
101:   end
102: 
103:   def pbInputUpdate
104:     Input.update
105:     if Input.trigger?(Input::BACK) && @abortable && !@aborted
106:       @aborted = true
107:       @battle.pbAbort
108:     end
109:   end
110: 
111:   def pbFrameUpdate(cw = nil)
112:     cw&.update
113:     @battle.battlers.each_with_index do |b, i|
114:       next if !b
115:       @sprites["dataBox_#{i}"]&.update
116:       @sprites["pokemon_#{i}"]&.update
117:       @sprites["shadow_#{i}"]&.update
118:     end
119:   end

FILE Data/Scripts/011_Battle/002_Battler/003_Battler_ChangeSelf.rb
5:   def pbReduceHP(amt, anim = true, registerDamage = true, anyAnim = true)
6:     amt = amt.round
7:     amt = @hp if amt > @hp
8:     amt = 1 if amt < 1 && !fainted?
9:     oldHP = @hp
10:     self.hp -= amt
11:     PBDebug.log("[HP change] #{pbThis} lost #{amt} HP (#{oldHP} -> #{@hp})") if amt > 0
12:     raise _INTL("HP less than 0") if @hp < 0
13:     raise _INTL("HP greater than total HP") if @hp > @totalhp
14:     @battle.scene.pbHPChanged(self, oldHP, anim) if anyAnim && amt > 0
15:     if amt > 0 && registerDamage
16:       @droppedBelowHalfHP = true if @hp < @totalhp / 2 && @hp + amt >= @totalhp / 2
17:       @tookDamageThisRound = true
18:       @tookMoveDamageThisRound = true
19:     end
20:     return amt
21:   end
22: 
23:   def pbRecoverHP(amt, anim = true, anyAnim = true)
24:     amt = amt.round
25:     amt = @totalhp - @hp if amt > @totalhp - @hp
26:     amt = 1 if amt < 1 && @hp < @totalhp
27:     oldHP = @hp
28:     self.hp += amt
29:     PBDebug.log("[HP change] #{pbThis} gained #{amt} HP (#{oldHP} -> #{@hp})") if amt > 0
30:     raise _INTL("HP less than 0") if @hp < 0
31:     raise _INTL("HP greater than total HP") if @hp > @totalhp
32:     @battle.scene.pbHPChanged(self, oldHP, anim) if anyAnim && amt > 0
33:     @droppedBelowHalfHP = false if @hp >= @totalhp / 2
34:     return amt

FILE Data/Scripts/014_Pokemon/001_Pokemon.rb
1085:   # @return [Integer] the maximum HP of this Pokémon
1086:   def calcHP(base, level, iv, ev)
1087:     return 1 if base == 1   # For Shedinja
1088:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
1089:     return (((base * 2) + iv + (ev / 4)) * level / 100).floor + level + 10
1090:   end
1091: 
1092:   # @return [Integer] the specified stat of this Pokémon (not used for total HP)
1093:   def calcStat(base, level, iv, ev, nat)
1094:     iv = ev = 0 if Settings::DISABLE_IVS_AND_EVS
1095:     return (((((base * 2) + iv + (ev / 4)) * level / 100).floor + 5) * nat / 100).floor
1096:   end
1097: 
1098:   # Recalculates this Pokémon's stats.
1099:   def calc_stats
1100:     base_stats = self.baseStats
1101:     this_level = self.level
1102:     this_IV    = self.calcIV
1103:     # Format stat multipliers due to nature
1104:     nature_mod = {}
1105:     GameData::Stat.each_main { |s| nature_mod[s.id] = 100 }
1106:     this_nature = self.nature_for_stats
1107:     if this_nature
1108:       this_nature.stat_changes.each { |change| nature_mod[change[0]] += change[1] }
1109:     end
1110:     # Calculate stats
1111:     stats = {}
1112:     GameData::Stat.each_main do |s|
1113:       if s.id == :HP
1114:         stats[s.id] = calcHP(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id])
1115:       else
1116:         stats[s.id] = calcStat(base_stats[s.id], this_level, this_IV[s.id], @ev[s.id], nature_mod[s.id])
1117:       end
1118:     end
1119:     hp_difference = stats[:HP] - @totalhp
1120:     @totalhp = stats[:HP]
1121:     self.hp = [@hp + hp_difference, 1].max if @hp > 0 || hp_difference > 0
1122:     @attack  = stats[:ATTACK]
1123:     @defense = stats[:DEFENSE]
1124:     @spatk   = stats[:SPECIAL_ATTACK]
1125:     @spdef   = stats[:SPECIAL_DEFENSE]
1126:     @speed   = stats[:SPEED]
1127:   end

