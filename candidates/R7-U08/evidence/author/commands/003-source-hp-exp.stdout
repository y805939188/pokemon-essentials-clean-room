115:   def x=(value)
116:     super
117:     @hpBar.x     = value + @spriteBaseX + 102
118:     @expBar.x    = value + @spriteBaseX + 6
119:     @hpNumbers.x = value + @spriteBaseX + 80
120:   end
121: 
122:   def y=(value)
123:     super
124:     @hpBar.y     = value + 40
125:     @expBar.y    = value + 74
126:     @hpNumbers.y = value + 52
127:   end
128: 
129:   def z=(value)
130:     super
131:     @hpBar.z     = value + 1
132:     @expBar.z    = value + 1
133:     @hpNumbers.z = value + 2
134:   end
135: 
136:   def opacity=(value)
137:     super
138:     @sprites.each do |i|
139:       i[1].opacity = value if !i[1].disposed?
140:     end
141:   end
142: 
143:   def visible=(value)
144:     super
145:     @sprites.each do |i|
146:       i[1].visible = value if !i[1].disposed?
147:     end
148:     @expBar.visible = (value && @show_exp_bar)
149:   end
150: 
151:   def color=(value)
152:     super
153:     @sprites.each do |i|
154:       i[1].color = value if !i[1].disposed?
155:     end
156:   end
