158:   def battler=(b)
159:     @battler = b
160:     self.visible = (@battler && !@battler.fainted?)
161:   end
162: 
163:   def hp
164:     return (animating_hp?) ? @anim_hp_current : @battler.hp
165:   end
166: 
167:   def exp_fraction
168:     if animating_exp?
169:       return 0.0 if @anim_exp_range == 0
170:       return @anim_exp_current.to_f / @anim_exp_range
171:     end
172:     return @battler.pokemon.exp_fraction
173:   end
174: 
175:   # NOTE: A change in HP takes the same amount of time to animate, no matter how
176:   #       big a change it is.
177:   def animate_hp(old_val, new_val)
178:     return if old_val == new_val
179:     @anim_hp_start = old_val
180:     @anim_hp_end = new_val
181:     @anim_hp_current = old_val
182:     @anim_hp_timer_start = System.uptime
183:   end
184: 
185:   def animating_hp?
186:     return @anim_hp_timer_start != nil
187:   end
188: 
189:   # NOTE: Filling the Exp bar from empty to full takes EXP_BAR_FILL_TIME seconds
190:   #       no matter what. Filling half of it takes half as long, etc.
191:   def animate_exp(old_val, new_val, range)
192:     return if old_val == new_val || range == 0 || !@show_exp_bar
193:     @anim_exp_start = old_val
194:     @anim_exp_end = new_val
195:     @anim_exp_range = range
196:     @anim_exp_duration_mult = (new_val - old_val).abs / range.to_f
197:     @anim_exp_current = old_val
198:     @anim_exp_timer_start = System.uptime
199:     pbSEPlay("Pkmn exp gain") if @show_exp_bar
200:   end
201: 
202:   def animating_exp?
203:     return @anim_exp_timer_start != nil
204:   end
205: 
206:   def pbDrawNumber(number, btmp, startX, startY, align = :left)
207:     # -1 means draw the / character
208:     n = (number == -1) ? [10] : number.to_i.digits.reverse
209:     charWidth  = @numbersBitmap.width / 11
210:     charHeight = @numbersBitmap.height
211:     startX -= charWidth * n.length if align == :right
212:     n.each do |i|
213:       btmp.blt(startX, startY, @numbersBitmap.bitmap, Rect.new(i * charWidth, 0, charWidth, charHeight))
214:       startX += charWidth
215:     end
216:   end
217: 
218:   def draw_background
219:     self.bitmap.blt(0, 0, @databoxBitmap.bitmap, Rect.new(0, 0, @databoxBitmap.width, @databoxBitmap.height))
220:   end
221: 
222:   def draw_name
223:     nameWidth = self.bitmap.text_size(@battler.name).width
224:     nameOffset = 0
225:     nameOffset = nameWidth - 116 if nameWidth > 116
226:     pbDrawTextPositions(self.bitmap, [[@battler.name, @spriteBaseX + 8 - nameOffset, 12, :left,
227:                                        NAME_BASE_COLOR, NAME_SHADOW_COLOR]]
228:     )
229:   end
230: 
231:   def draw_level
232:     # "Lv" graphic
233:     pbDrawImagePositions(self.bitmap, [[_INTL("Graphics/UI/Battle/overlay_lv"), @spriteBaseX + 140, 16]])
234:     # Level number
235:     pbDrawNumber(@battler.level, self.bitmap, @spriteBaseX + 162, 16)
236:   end
237: 
238:   def draw_gender
239:     gender = @battler.displayGender
240:     return if ![0, 1].include?(gender)
241:     gender_text  = (gender == 0) ? _INTL("♂") : _INTL("♀")
242:     base_color   = (gender == 0) ? MALE_BASE_COLOR : FEMALE_BASE_COLOR
243:     shadow_color = (gender == 0) ? MALE_SHADOW_COLOR : FEMALE_SHADOW_COLOR
244:     pbDrawTextPositions(self.bitmap, [[gender_text, @spriteBaseX + 126, 12, :left, base_color, shadow_color]])
245:   end
246: 
247:   def draw_status
248:     return if @battler.status == :NONE
249:     if @battler.status == :POISON && @battler.statusCount > 0   # Badly poisoned
250:       s = GameData::Status.count - 1
251:     else
252:       s = GameData::Status.get(@battler.status).icon_position
253:     end
254:     return if s < 0
255:     pbDrawImagePositions(self.bitmap, [[_INTL("Graphics/UI/Battle/icon_statuses"), @spriteBaseX + 24, 36,
256:                                         0, s * STATUS_ICON_HEIGHT, -1, STATUS_ICON_HEIGHT]])
257:   end
258: 
259:   def draw_shiny_icon
260:     return if !@battler.shiny?
261:     shiny_x = (@battler.opposes?(0)) ? 206 : -6   # Foe's/player's
262:     pbDrawImagePositions(self.bitmap, [["Graphics/UI/shiny", @spriteBaseX + shiny_x, 36]])
263:   end
264: 
265:   def draw_special_form_icon
266:     # Mega Evolution/Primal Reversion icon
267:     if @battler.mega?
268:       pbDrawImagePositions(self.bitmap, [["Graphics/UI/Battle/icon_mega", @spriteBaseX + 8, 34]])
269:     elsif @battler.primal?
270:       filename = nil
271:       if @battler.isSpecies?(:GROUDON)
272:         filename = "Graphics/UI/Battle/icon_primal_Groudon"
273:       elsif @battler.isSpecies?(:KYOGRE)
274:         filename = "Graphics/UI/Battle/icon_primal_Kyogre"
275:       end
276:       primalX = (@battler.opposes?) ? 208 : -28   # Foe's/player's
277:       pbDrawImagePositions(self.bitmap, [[filename, @spriteBaseX + primalX, 4]]) if filename
278:     end
279:   end
280: 
281:   def draw_owned_icon
282:     return if !@battler.owned? || !@battler.opposes?(0)   # Draw for foe Pokémon only
283:     pbDrawImagePositions(self.bitmap, [["Graphics/UI/Battle/icon_own", @spriteBaseX + 8, 36]])
284:   end
285: 
286:   def refresh
287:     self.bitmap.clear
288:     return if !@battler.pokemon
289:     draw_background
290:     draw_name
291:     draw_level
292:     draw_gender
293:     draw_status
294:     draw_shiny_icon
295:     draw_special_form_icon
296:     draw_owned_icon
297:     refresh_hp
298:     refresh_exp
299:   end
300: 
301:   def refresh_hp
302:     @hpNumbers.bitmap.clear
303:     return if !@battler.pokemon
304:     # Show HP numbers
305:     if @show_hp_numbers
306:       pbDrawNumber(self.hp, @hpNumbers.bitmap, 54, 2, :right)
307:       pbDrawNumber(-1, @hpNumbers.bitmap, 54, 2)   # / char
308:       pbDrawNumber(@battler.totalhp, @hpNumbers.bitmap, 70, 2)
309:     end
310:     # Resize HP bar
311:     w = 0
312:     if self.hp > 0
313:       w = @hpBarBitmap.width.to_f * self.hp / @battler.totalhp
314:       w = 1 if w < 1
315:       # NOTE: The line below snaps the bar's width to the nearest 2 pixels, to
316:       #       fit in with the rest of the graphics which are doubled in size.
317:       w = ((w / 2.0).round) * 2
318:     end
319:     @hpBar.src_rect.width = w
320:     hpColor = 0                                      # Green bar
321:     hpColor = 1 if self.hp <= @battler.totalhp / 2   # Yellow bar
322:     hpColor = 2 if self.hp <= @battler.totalhp / 4   # Red bar
323:     @hpBar.src_rect.y = hpColor * @hpBarBitmap.height / 3
324:   end
325: 
326:   def refresh_exp
327:     return if !@show_exp_bar
328:     w = exp_fraction * @expBarBitmap.width
329:     # NOTE: The line below snaps the bar's width to the nearest 2 pixels, to
330:     #       fit in with the rest of the graphics which are doubled in size.
331:     w = ((w / 2).round) * 2
332:     @expBar.src_rect.width = w
333:   end
334: 
335:   def update_hp_animation
336:     return if !animating_hp?
337:     @anim_hp_current = lerp(@anim_hp_start, @anim_hp_end, HP_BAR_CHANGE_TIME,
338:                             @anim_hp_timer_start, System.uptime)
339:     # Refresh the HP bar/numbers
340:     refresh_hp
341:     # End the HP bar filling animation
342:     if @anim_hp_current == @anim_hp_end
343:       @anim_hp_start = nil
344:       @anim_hp_end = nil
345:       @anim_hp_timer_start = nil
346:       @anim_hp_current = nil
347:     end
348:   end
349: 
350:   def update_exp_animation
351:     return if !animating_exp?
352:     if !@show_exp_bar   # Not showing the Exp bar, no need to waste time animating it
353:       @anim_exp_timer_start = nil
354:       return
355:     end
356:     duration = EXP_BAR_FILL_TIME * @anim_exp_duration_mult
357:     @anim_exp_current = lerp(@anim_exp_start, @anim_exp_end, duration,
358:                              @anim_exp_timer_start, System.uptime)
359:     # Refresh the Exp bar
360:     refresh_exp
361:     return if @anim_exp_current != @anim_exp_end   # Exp bar still has more to animate
362:     # End the Exp bar filling animation
363:     if @anim_exp_current >= @anim_exp_range
364:       if @anim_exp_flash_timer_start
365:         # Waiting for Exp full flash to finish
366:         return if System.uptime - @anim_exp_flash_timer_start < EXP_FULL_FLASH_DURATION
367:       else
368:         # Show the Exp full flash
369:         @anim_exp_flash_timer_start = System.uptime
370:         pbSEStop
371:         pbSEPlay("Pkmn exp full")
372:         flash_duration = EXP_FULL_FLASH_DURATION * Graphics.frame_rate   # Must be in frames, not seconds
373:         self.flash(Color.new(64, 200, 248, 192), flash_duration)
374:         @sprites.each do |i|
375:           i[1].flash(Color.new(64, 200, 248, 192), flash_duration) if !i[1].disposed?
376:         end
377:         return
378:       end
379:     end
380:     pbSEStop if !@anim_exp_flash_timer_start
381:     @anim_exp_start = nil
382:     @anim_exp_end = nil
383:     @anim_exp_duration_mult = nil
384:     @anim_exp_current = nil
385:     @anim_exp_timer_start = nil
386:     @anim_exp_flash_timer_start = nil
387:   end
388: 
389:   def update_positions
390:     self.x = @spriteX
391:     self.y = @spriteY
392:     # Data box bobbing while Pokémon is selected
393:     if (@selected == 1 || @selected == 2) && BOBBING_DURATION   # Choosing commands/targeted
394:       bob_delta = System.uptime % BOBBING_DURATION   # 0-BOBBING_DURATION
395:       bob_frame = (4 * bob_delta / BOBBING_DURATION).floor
396:       case bob_frame
397:       when 1 then self.y = @spriteY - 2
398:       when 3 then self.y = @spriteY + 2
399:       end
400:     end
401:   end
402: 
403:   def update
404:     super
405:     # Animate HP bar
406:     update_hp_animation
407:     # Animate Exp bar
408:     update_exp_animation
409:     # Update coordinates of the data box
410:     update_positions
411:     pbUpdateSpriteHash(@sprites)
412:   end
413: end

FILE Data/Scripts/001_Technical/002_RubyUtilities.rb
394: #===============================================================================
395: # Linear interpolation between two values, given the duration of the change and
396: # either:
397: #   - the time passed since the start of the change (delta), or
398: #   - the start time of the change (delta) and the current time (now)
399: #===============================================================================
400: def lerp(start_val, end_val, duration, delta, now = nil)
401:   return end_val if duration <= 0
402:   delta = now - delta if now
403:   return start_val if delta <= 0
404:   return end_val if delta >= duration
405:   return start_val + ((end_val - start_val) * delta / duration.to_f)
406: end

FILE Data/Scripts/011_Battle/004_Scene/004_Scene_PlayAnimations.rb
219:   # Shows a HP-changing common animation and animates a data box's HP bar.
220:   # Called by def pbReduceHP, def pbRecoverHP.
221:   def pbHPChanged(battler, oldHP, showAnim = false)
222:     @briefMessage = false
223:     if battler.hp > oldHP
224:       pbCommonAnimation("HealthUp", battler) if showAnim && @battle.showAnims
225:     elsif battler.hp < oldHP
226:       pbCommonAnimation("HealthDown", battler) if showAnim && @battle.showAnims
227:     end
228:     @sprites["dataBox_#{battler.index}"].animate_hp(oldHP, battler.hp)
229:     while @sprites["dataBox_#{battler.index}"].animating_hp?
230:       pbUpdate
231:     end
232:   end
233: 
234:   def pbDamageAnimation(battler, effectiveness = 0)
235:     @briefMessage = false
236:     # Damage animation
237:     damageAnim = Animation::BattlerDamage.new(@sprites, @viewport, battler.index, effectiveness)
238:     loop do
239:       damageAnim.update
240:       pbUpdate
241:       break if damageAnim.animDone?
242:     end
243:     damageAnim.dispose
244:   end
245: 
246:   # Animates battlers flashing and data boxes' HP bars because of damage taken
247:   # by an attack. targets is an array, which are all animated simultaneously.
248:   # Each element in targets is also an array: [battler, old HP, effectiveness]
249:   def pbHitAndHPLossAnimation(targets)
250:     @briefMessage = false
251:     # Set up animations
252:     damageAnims = []
253:     targets.each do |t|
254:       anim = Animation::BattlerDamage.new(@sprites, @viewport, t[0].index, t[2])
273:       end
274:       next if !allDone
275:       break
276:     end
277:     damageAnims.each { |a| a.dispose }
278:   end
279: 
280:   #=============================================================================
281:   # Animates a data box's Exp bar
282:   #=============================================================================
283:   def pbEXPBar(battler, startExp, endExp, tempExp1, tempExp2)
284:     return if !battler || endExp == startExp
285:     startExpLevel = tempExp1 - startExp
286:     endExpLevel   = tempExp2 - startExp
287:     expRange      = endExp - startExp
288:     dataBox = @sprites["dataBox_#{battler.index}"]
289:     dataBox.animate_exp(startExpLevel, endExpLevel, expRange)
290:     while dataBox.animating_exp?
291:       pbUpdate
292:     end
293:   end
294: 
295:   #=============================================================================
296:   # Shows stats windows upon a Pokémon levelling up
297:   #=============================================================================
298:   def pbLevelUp(pkmn, _battler, oldTotalHP, oldAttack, oldDefense, oldSpAtk, oldSpDef, oldSpeed)
299:     pbTopRightWindow(
300:       _INTL("Max. HP<r>+{1}\nAttack<r>+{2}\nDefense<r>+{3}\nSp. Atk<r>+{4}\nSp. Def<r>+{5}\nSpeed<r>+{6}",
301:             pkmn.totalhp - oldTotalHP, pkmn.attack - oldAttack, pkmn.defense - oldDefense,
302:             pkmn.spatk - oldSpAtk, pkmn.spdef - oldSpDef, pkmn.speed - oldSpeed)
303:     )
304:     pbTopRightWindow(
305:       _INTL("Max. HP<r>{1}\nAttack<r>{2}\nDefense<r>{3}\nSp. Atk<r>{4}\nSp. Def<r>{5}\nSpeed<r>{6}",
306:             pkmn.totalhp, pkmn.attack, pkmn.defense, pkmn.spatk, pkmn.spdef, pkmn.speed)
307:     )
308:   end
