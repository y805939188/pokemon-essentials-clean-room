1287: def pbPurifyChamber
1288:   $player.seen_purify_chamber = true
1289:   pbFadeOutIn do
1290:     scene = PurifyChamberScene.new
1291:     screen = PurifyChamberScreen.new(scene)
1292:     screen.pbStartPurify
1293:   end
1294: end
