
FILE Data/Scripts/014_Pokemon/001_Pokemon-related/002_ShadowPokemon_Other.rb
1: # All types except Shadow have Shadow as a weakness.
2: # Shadow has Shadow as a resistance.
3: # On a side note, the Shadow moves in Colosseum will not be affected by
4: # Weaknesses or Resistances, while in XD the Shadow-type is Super-Effective
5: # against all other types.
6: # 2/5 - display nature
7: #
8: # XD - Shadow Rush -- 55, 100 - Deals damage.
9: # Colosseum - Shadow Rush -- 90, 100
10: # If this attack is successful, user loses half of HP lost by opponent due to
11: # this attack (recoil). If user is in Hyper Mode, this attack has a good chance
12: # for a critical hit.
13: 
14: #===============================================================================
15: # Purify a Shadow Pokémon.
16: #===============================================================================
17: def pbPurify(pkmn, scene)
18:   return if !pkmn.shadowPokemon? || pkmn.heart_gauge != 0
19:   $stats.shadow_pokemon_purified += 1
20:   pkmn.shadow = false
21:   pkmn.hyper_mode = false
22:   pkmn.giveRibbon(:NATIONAL)
23:   scene.pbDisplay(_INTL("{1} opened the door to its heart!", pkmn.name))
24:   old_moves = []
25:   pkmn.moves.each { |m| old_moves.push(m.id) }
26:   pkmn.update_shadow_moves
27:   pkmn.moves.each_with_index do |m, i|
28:     next if m.id == old_moves[i]
29:     scene.pbDisplay(_INTL("{1} regained the move {2}!", pkmn.name, m.name))
30:   end
31:   pkmn.record_first_moves
32:   if pkmn.saved_ev
33:     pkmn.add_evs(pkmn.saved_ev)
34:     pkmn.saved_ev = nil
35:   end
36:   if pkmn.saved_exp
37:     newexp = pkmn.growth_rate.add_exp(pkmn.exp, (pkmn.saved_exp * 4 / 5) || 0)
38:     pkmn.saved_exp = nil
39:     newlevel = pkmn.growth_rate.level_from_exp(newexp)
40:     curlevel = pkmn.level
41:     if newexp != pkmn.exp
42:       scene.pbDisplay(_INTL("{1} regained {2} Exp. Points!", pkmn.name, newexp - pkmn.exp))
43:     end
44:     if newlevel == curlevel
45:       pkmn.exp = newexp
46:       pkmn.calc_stats
47:     else
48:       pbChangeLevel(pkmn, newlevel, scene)   # for convenience
49:       pkmn.exp = newexp
50:     end
51:   end
52:   if $PokemonSystem.givenicknames == 0 &&
53:      scene.pbConfirm(_INTL("Would you like to give a nickname to {1}?", pkmn.speciesName))
54:     newname = pbEnterPokemonName(_INTL("{1}'s nickname?", pkmn.speciesName),
55:                                  0, Pokemon::MAX_NAME_SIZE, "", pkmn)
56:     pkmn.name = newname
57:   end
58: end
59: 
60: #===============================================================================
61: # Relic Stone scene.
62: #===============================================================================
63: class RelicStoneScene
64:   def pbPurify; end
65: 
66:   def pbUpdate
67:     pbUpdateSpriteHash(@sprites)
68:   end
69: 
70:   def pbEndScene
71:     pbFadeOutAndHide(@sprites) { pbUpdate }
72:     pbDisposeSpriteHash(@sprites)
73:     @viewport.dispose
74:   end
75: 
76:   def pbDisplay(msg, brief = false)
77:     UIHelper.pbDisplay(@sprites["msgwindow"], msg, brief) { pbUpdate }
78:   end
79: 
80:   def pbConfirm(msg)
81:     UIHelper.pbConfirm(@sprites["msgwindow"], msg) { pbUpdate }
82:   end
83: 
84:   def pbStartScene(pokemon)
85:     @sprites = {}
86:     @viewport = Viewport.new(0, 0, Graphics.width, Graphics.height)
87:     @viewport.z = 99999
88:     @pokemon = pokemon
89:     addBackgroundPlane(@sprites, "bg", "relicstonebg", @viewport)
90:     @sprites["msgwindow"] = Window_AdvancedTextPokemon.new("")
91:     @sprites["msgwindow"].viewport = @viewport
92:     @sprites["msgwindow"].x        = 0
93:     @sprites["msgwindow"].y        = Graphics.height - 96
94:     @sprites["msgwindow"].width    = Graphics.width
95:     @sprites["msgwindow"].height   = 96
96:     @sprites["msgwindow"].text     = ""
97:     @sprites["msgwindow"].visible  = true
98:     pbDeactivateWindows(@sprites)
99:     pbFadeInAndShow(@sprites) { pbUpdate }
100:   end
101: end
102: 
103: #===============================================================================
104: #
105: #===============================================================================
106: class RelicStoneScreen
107:   def initialize(scene)
108:     @scene = scene
109:   end
110: 
111:   def pbDisplay(x)
112:     @scene.pbDisplay(x)
113:   end
114: 
115:   def pbConfirm(x)
116:     @scene.pbConfirm(x)
117:   end
118: 
119:   def pbUpdate; end
120: 
121:   def pbRefresh; end
122: 
123:   def pbStartScreen(pokemon)
124:     @scene.pbStartScene(pokemon)
125:     @scene.pbPurify
126:     pbPurify(pokemon, self)
127:     @scene.pbEndScene
128:   end
129: end
130: 
131: #===============================================================================
132: #
133: #===============================================================================
134: def pbRelicStoneScreen(pkmn)
135:   retval = true
136:   pbFadeOutIn do
137:     scene = RelicStoneScene.new
138:     screen = RelicStoneScreen.new(scene)
139:     retval = screen.pbStartScreen(pkmn)
140:   end
141:   return retval
142: end
