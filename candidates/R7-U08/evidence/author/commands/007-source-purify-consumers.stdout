85:                    68921,  74088,  79507,  85184,  91125,  97336,  103823, 110592, 117649, 125000,
86:                    132651, 140608, 148877, 157464, 166375, 175616, 185193, 195112, 205379, 216000,
87:                    226981, 238328, 250047, 262144, 274625, 287496, 300763, 314432, 328509, 343000,
