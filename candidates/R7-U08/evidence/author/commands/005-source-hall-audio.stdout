466: class PokemonGlobalMetadata
467:   attr_writer :hallOfFame
468:   # Number necessary if hallOfFame array reach in its size limit
469:   attr_writer :hallOfFameLastNumber
470: 
471:   def hallOfFame
472:     @hallOfFame = [] if !@hallOfFame
473:     return @hallOfFame
474:   end
475: 
476:   def hallOfFameLastNumber
477:     return @hallOfFameLastNumber || 0
478:   end
479: end
