431: class HallOfFameScreen
432:   def initialize(scene)
433:     @scene = scene
434:   end
435: 
436:   def pbStartScreenEntry
437:     @scene.pbStartSceneEntry
438:     @scene.pbAnimationLoop
439:     @scene.pbEndScene
440:   end
441: 
442:   def pbStartScreenPC
443:     @scene.pbStartScenePC
444:     @scene.pbPCSelection
445:     @scene.pbEndScene
446:   end
447: end
