453:   "name"      => _INTL("Hall of Fame"),
454:   "order"     => 40,
455:   "condition" => proc { next $PokemonGlobal.hallOfFameLastNumber > 0 },
456:   "effect"    => proc { |menu|
457:     pbMessage("\\se[PC access]" + _INTL("Accessed the Hall of Fame."))
458:     pbHallOfFamePC
459:     next false
460:   }
461: })
